---
import Layout from '@layouts/Layout.astro';
const title = "Transport in China — Metro, High-Speed Rail & Ride-Hailing";
const description = "Complete transport guides for foreigners: metro, high-speed rail, taxis, ride-hailing apps, and getting from the airport to the city.";
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <!-- Header -->
    <header class="mb-16 text-center">
      <p class="text-sm text-gray-500 mb-3">🚄 Transport</p>
      <h1 class="text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
        Transport in China
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        From high-speed rail to ride-hailing apps — how to get around China as a foreigner. Updated June 2026.
      </p>
    </header>

    <!-- Quick Overview -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-16 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 Quick Overview</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        <strong>High-speed rail</strong> is the best way between cities — book via Trip.com. Within cities, the <strong>metro</strong> is fast and cheap. For door-to-door trips, use <strong>DiDi</strong> (ride-hailing). Pay for all of them with Alipay or WeChat Pay.
      </p>
    </div>

    <!-- Article Directory -->
    <div class="space-y-6 mb-16 not-prose">
      <!-- Article 1 -->
      <a href="/en/transport/transport-guide/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-blue-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl">🚄</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-blue-600">Guide</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition">How to Get Around China: The Complete Transport Guide</h2>
          <p class="text-gray-600 mt-1">High-speed rail, metro, ride-hailing, taxis, buses — how to choose the right option for every situation on your trip.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 6 min read</p>
        </div>
      </a>

      <!-- Article 2 -->
      <a href="/en/transport/airport-to-city/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-green-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-2xl">✈️</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-green-600">Guide</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-green-600 transition">From Airport to City in China: What Usually Works Best</h2>
          <p class="text-gray-600 mt-1">Metro, taxi, ride-hailing, or airport bus — how to choose and what to expect at Beijing, Shanghai, Guangzhou, and Shenzhen airports.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 5 min read</p>
        </div>
      </a>

      <!-- Article 3 -->
      <a href="/en/transport/high-speed-rail/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-purple-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-2xl">🚅</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-purple-600">Guide</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-purple-600 transition">How to Book and Ride China High-Speed Rail</h2>
          <p class="text-gray-600 mt-1">Step-by-step guide to booking tickets online, navigating the station, boarding procedures, and what to expect onboard. Covers Trip.com and 12306.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 7 min read</p>
        </div>
      </a>

      <!-- Article 4 -->
      <a href="/en/transport/metro-bus/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-orange-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center text-2xl">🚇</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-orange-600">Reference</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-orange-600 transition">Metro & Bus Guide for Major Chinese Cities</h2>
          <p class="text-gray-600 mt-1">How to use public transit in Chinese cities. Mobile payment, transit cards, bus tips, and general navigation advice for first-time visitors.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 5 min read</p>
        </div>
      </a>

      <!-- Article 5 -->
      <a href="/en/transport/didi/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-red-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center text-2xl">🚗</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-red-600">Tutorial</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-red-600 transition">How to Use Didi in China as a Foreigner</h2>
          <p class="text-gray-600 mt-1">Step-by-step guide to setting up and using DiDi without a Chinese phone number. Ride options, payment via Alipay/WeChat, and essential tips.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 5 min read</p>
        </div>
      </a>
    </div>

    <!-- Related Links -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/payment/payment-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">💳 How to Pay in China</p>
          <p class="text-sm text-gray-600">Alipay, WeChat Pay, and everything about money</p>
        </a>
        <a href="/en/tips/is-china-safe/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🛡️ Is it safe to travel to China?</p>
          <p class="text-sm text-gray-600">Honest safety guide from a local</p>
        </a>
      </div>
    </div>
  </section>
</Layout>