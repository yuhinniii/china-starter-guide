---
import Layout from '@layouts/Layout.astro';
const title = 'Contact — China Starter Hub';
const description = 'Contactez-nous pour vos questions, commentaires ou collaborations.';
---

<Layout title={title} description={description} lang="fr">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">CONTACT</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">Contactez-Nous</h1>
      <p class="text-gray-500  ">Des questions ou des commentaires ? Nous serions ravis de vous entendre.</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4">
        <p class="text-sm text-gray-500  ">L'email arrive bientôt. Pour l'instant, suivez nos mises à jour sur les réseaux sociaux.</p>
      </div>
    </div>
  </article>
</Layout>
