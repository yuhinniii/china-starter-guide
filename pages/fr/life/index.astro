---
import Layout from '@layouts/Layout.astro';
const title = 'Vie en Chine — Guide du Quotidien pour Étrangers';
const description = 'Applications, soins médicaux, sécurité, et tout ce qu\'il faut pour vivre ou voyager en Chine.';
---

<Layout title={title} description={description} lang="fr">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🏠 Vie en Chine</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Vie en Chine</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Applications, soins médicaux, sécurité, et tout ce qu'il faut pour vivre ou voyager en Chine.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-cyan-800">5</p>
        <p class="text-xs font-semibold text-cyan-800 uppercase tracking-wide mt-1">Vie Numérique</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">3</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Sécurité</p>
      </div>
      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-emerald-800">4</p>
        <p class="text-xs font-semibold text-emerald-800 uppercase tracking-wide mt-1">Santé</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">2</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">En Pratique</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-cyan-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-cyan-800">Vie Numérique</h2>
          <span class="text-xs font-medium text-cyan-800 opacity-60">5 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/life/essential-apps/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">📱 Apps</span>
            <p class="text-base font-bold text-gray-900 mt-1">Applications Essentielles pour la Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">WeChat, Alipay, Didi, Amap — ce dont vous avez vraiment besoin.</p>
          </a>
          <a href="/fr/life/sim-card-guide/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">📶 SIM</span>
            <p class="text-base font-bold text-gray-900 mt-1">Meilleure SIM & eSIM pour la Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">eSIM, cartes SIM d'aéroport, forfaits longue durée.</p>
          </a>
          <a href="/fr/life/vpn-guide/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🔒 VPN</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guide VPN pour la Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Meilleurs VPN, configuration, ce qui fonctionne vraiment.</p>
          </a>
          <a href="/fr/life/chinese-phrases/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">💬 Langue</span>
            <p class="text-base font-bold text-gray-900 mt-1">Phrases Chinoises Essentielles</p>
            <p class="text-sm text-gray-600 mt-0.5">Phrases de base pour le voyage — avec audio.</p>
          </a>
          <a href="/fr/life/survival-kit/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🎒 Checklist</span>
            <p class="text-base font-bold text-gray-900 mt-1">Kit de Survie pour la Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Checklist avant départ — documents, apps, bagages.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Sécurité & Urgences</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/life/is-china-safe/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🛡️ Sécurité</span>
            <p class="text-base font-bold text-gray-900 mt-1">La Chine est-elle Sûre pour les Touristes ?</p>
            <p class="text-sm text-gray-600 mt-0.5">Taux de criminalité, sécurité dans les rues, arnaques et conseils.</p>
          </a>
          <a href="/fr/life/emergency-numbers/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">📞 Urgences</span>
            <p class="text-base font-bold text-gray-900 mt-1">Numéros d'Urgence en Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">110, 120, 119 — et à qui s'adresser en cas de problème.</p>
          </a>
          <a href="/fr/life/common-scams/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">⚠️ Arnaques</span>
            <p class="text-base font-bold text-gray-900 mt-1">Arnaques à Connaître Absolument</p>
            <p class="text-sm text-gray-600 mt-0.5">Les arnaques les plus courantes visant les touristes en Chine.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">Santé</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">4 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/life/seeing-a-doctor/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🏥 Médecin</span>
            <p class="text-base font-bold text-gray-900 mt-1">Consulter un Médecin en Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Hôpitaux internationaux, procédures, coûts, et barrière linguistique.</p>
          </a>
          <a href="/fr/life/top-hospitals/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🏨 Hôpitaux</span>
            <p class="text-base font-bold text-gray-900 mt-1">Meilleurs Hôpitaux pour Étrangers</p>
            <p class="text-sm text-gray-600 mt-0.5">Hôpitaux internationaux et cliniques privées dans les grandes villes.</p>
          </a>
          <a href="/fr/life/travel-insurance/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🛡️ Assurance</span>
            <p class="text-base font-bold text-gray-900 mt-1">Assurance Voyage pour la Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Ce qu'elle doit couvrir et recommandations.</p>
          </a>
          <a href="/fr/life/packing-guide/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">💊 Trousse</span>
            <p class="text-base font-bold text-gray-900 mt-1">Trousse de Santé pour la Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Médicaments à emporter et pharmacies en Chine.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">En Pratique</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/life/medical-index/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🏥 Santé</span>
            <p class="text-base font-bold text-gray-900 mt-1">Santé & Médecine en Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Index complet des guides médicaux.</p>
          </a>
          <a href="/fr/life/tips-index/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">💡 Astuces</span>
            <p class="text-base font-bold text-gray-900 mt-1">Astuces & Conseils Pratiques</p>
            <p class="text-sm text-gray-600 mt-0.5">Conseils au quotidien pour les voyageurs en Chine.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Guides Connexes</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/fr/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Paiement en Chine</p>
          <p class="text-sm text-gray-500">Comment payer en Chine</p>
        </a>
        <a href="/fr/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Transport en Chine</p>
          <p class="text-sm text-gray-500">Se déplacer</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
