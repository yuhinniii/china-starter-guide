---
import Layout from '@layouts/Layout.astro';
const title = 'Transport en Chine — Guide Complet';
const description = 'Trains, métro, VTC, et comment se déplacer dans les grandes villes chinoises.';
---

<Layout title={title} description={description} lang="fr">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🚄 Transport</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Transport en Chine</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Trains, métro, VTC, et comment se déplacer dans les grandes villes chinoises.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Vue d'Ensemble</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">Train Grande Vitesse</p>
      </div>
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">1</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">Métro & Bus</p>
      </div>
      <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-orange-800">1</p>
        <p class="text-xs font-semibold text-orange-800 uppercase tracking-wide mt-1">Didi (VTC)</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Guide Complet</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/transport/transport-guide/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">📖 Aperçu</span>
            <p class="text-base font-bold text-gray-900 mt-1">Comment se Déplacer en Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">TGV, métro, bus, VTC et taxis — tous vos moyens de transport.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Train Grande Vitesse</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/transport/high-speed-rail/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🚄 Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Comment Réserver et Prendre le TGV en Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Réservation, types de billets, quais, astuces pour les voyageurs étrangers.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">Métro & Bus</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/transport/metro-bus/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🚇 Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Métro & Bus dans les Grandes Villes Chinoises</p>
            <p class="text-sm text-gray-600 mt-0.5">Plans de métro, cartes de transport, paiement, navigation.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-orange-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-orange-800">Didi (VTC)</h2>
          <span class="text-xs font-medium text-orange-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/transport/didi/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🚗 Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Comment Utiliser Didi en Chine en tant qu'Étranger</p>
            <p class="text-sm text-gray-600 mt-0.5">Configuration de l'app, réservation d'une course, communication avec le conducteur.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">Aéroport</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/transport/airport-to-city/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">✈️ Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">De l'Aéroport à la Ville — Guide par Ville</p>
            <p class="text-sm text-gray-600 mt-0.5">TGV, métro, navette ou taxi de l'aéroport vers les principaux quartiers.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Guides Connexes</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/fr/cities/city-select/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Planification d'Itinéraire</p>
          <p class="text-sm text-gray-500">Combien de jours pour chaque ville ?</p>
        </a>
        <a href="/fr/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Paiement en Chine</p>
          <p class="text-sm text-gray-500">Configurez vos moyens de paiement</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
