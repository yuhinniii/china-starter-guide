---
interface HowToStep {
  name: string;
  text: string;
}

interface Props {
  name: string;
  description?: string;
  steps: HowToStep[];
}

const { name, description, steps } = Astro.props;
---

{steps.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": name,
    ...(description ? { "description": description } : {}),
    "step": steps.map(step => ({
      "@type": "HowToStep",
      "name": step.name,
      "text": step.text
    }))
  })}></script>
)}
