---
const { title, description = 'Your ultimate guide to traveling, living and working in China', lang = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
const isZH = lang === 'zh';
const base = isZH ? '/zh' : '/en';
const navItems = isZH
  ? [
      { label: '首页', href: '/zh/' },
      { label: '签证', href: '/zh/prepare/' },
      { label: '支付', href: '/zh/payment/' },
      { label: '交通', href: '/zh/transport/' },
      { label: '在中国的生活', href: '/zh/life/' },
      { label: '城市', href: '/zh/cities/' },
      { label: '搜索', href: '/zh/search/' },
      { label: '关于', href: '/zh/about/' },
    ]
  : [
      { label: 'Home', href: '/en/' },
      { label: 'Visa', href: '/en/prepare/' },
      { label: 'Payment', href: '/en/payment/' },
      { label: 'Transport', href: '/en/transport/' },
      { label: 'Life in China', href: '/en/life/' },
      { label: 'Cities', href: '/en/cities/' },
      { label: 'Search', href: '/en/search/' },
      { label: 'About', href: '/en/about/' },
    ];

const isActive = (href) => {
  if (href === base + '/') return currentPath === base + '/' || currentPath === base + '/index/';
  return currentPath.startsWith(href);
};
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
    <style>
      /* Language switcher dropdown */
      .lang-select { font-size: 11px; padding: 2px 4px; border: 1px solid #e5e7eb; border-radius: 4px; color: #6b7280; background: transparent; cursor: pointer; outline: none; }
      .lang-select:hover { border-color: #d1d5db; }
      .lang-select option { font-size: 12px; }
    </style>
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <!-- Nav -->
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href={base} class="text-lg font-bold text-brand-600 no-underline">{isZH ? '中国入门指南' : 'China Starter Guide'}</a>
        <div class="hidden md:flex items-center gap-5 text-sm">
          {navItems.map(item => {
            const active = isActive(item.href);
            return (
              <a href={item.href}
                 class={`no-underline transition-colors${active ? ' text-brand-600 font-semibold' : ' text-gray-600 hover:text-brand-600'}`}>
                {item.label}
              </a>
            );
          })}
        </div>
        <div class="flex items-center gap-2">
          <!-- Translate selector -->
          <select id="translate-select" class="lang-select" aria-label="Translate page">
            <option value="">Translate</option>
            <option value="zh-CN">中文</option>
            <option value="ja">日本語</option>
            <option value="ko">한국어</option>
            <option value="ru">Русский</option>
            <option value="ar">العربية</option>
            <option value="fr">Français</option>
            <option value="th">ไทย</option>
            <option value="es">Español</option>
            <option value="original">Show Original</option>
          </select>
          <!-- Language Switcher -->
          <a href={isZH ? Astro.url.pathname.replace(/^\/zh/, '/en') : Astro.url.pathname.replace(/^\/en/, '/zh')}
             class="text-xs px-2 py-1 rounded border border-gray-200 text-gray-500 hover:text-brand-600 no-underline">
            {isZH ? 'EN' : '中文'}
          </a>
          <!-- Mobile menu -->
          <button id="mobile-menu-btn" class="md:hidden text-gray-500 text-xl" aria-label="Menu">☰</button>
        </div>
      </div>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden px-4 pb-4 flex flex-col gap-2 text-sm">
        {navItems.map(item => {
          const active = isActive(item.href);
          return (
            <a href={item.href}
               class={`no-underline py-1${active ? ' text-brand-600 font-semibold' : ' text-gray-600 hover:text-brand-600'}`}>
              {item.label}
            </a>
          );
        })}
      </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-100 mt-16">
      <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-gray-400">
        <span>© 2026 China Starter Guide</span>
        <div class="flex gap-4">
        <a href={isZH ? '/zh/about/' : '/en/about/'} class="hover:text-brand-600 no-underline">About</a>
          <a href={isZH ? '/zh/privacy/' : '/en/privacy/'} class="hover:text-brand-600 no-underline">Privacy</a>
          <a href={isZH ? '/zh/contact/' : '/en/contact/'} class="hover:text-brand-600 no-underline">Contact</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Mobile menu
      function initMobileMenu() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => { initMobileMenu(); });
      } else {
        initMobileMenu();
      }
    </script>

    <!-- Translate: Custom Google Translate trigger -->
    <div id="google_translate_element" style="display:none"></div>
    <script is:inline>
      let gtLoaded = false;

      function doTranslate(lang) {
        if (!gtLoaded) {
          window.gtCallback = function() {
            gtLoaded = true;
            const select = document.querySelector('.goog-te-combo');
            if (select) {
              select.value = lang;
              select.dispatchEvent(new Event('change'));
            }
          };
          const s = document.createElement('script');
          s.src = '//translate.google.com/translate_a/element.js?cb=gtCallback';
          document.body.appendChild(s);
        } else {
          const select = document.querySelector('.goog-te-combo');
          if (select) {
            select.value = lang;
            select.dispatchEvent(new Event('change'));
          }
        }
      }

      document.getElementById('translate-select').addEventListener('change', function() {
        if (this.value === 'original') {
          // Reset - reload page without translation
          const cookies = document.cookie.split(';');
          for (const c of cookies) {
            const name = c.trim().split('=')[0];
            if (name.includes('googtrans')) {
              document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
            }
          }
          location.reload();
        } else if (this.value) {
          doTranslate(this.value);
        }
        this.value = '';
      });
    </script>
    <style>
      /* Hide Google Translate's header bar */
      .goog-te-banner-frame.skiptranslate { display: none !important; }
      body { top: 0px !important; }
    </style>
  </body>
</html>
