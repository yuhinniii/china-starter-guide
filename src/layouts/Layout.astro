---
import { langs, langLabels, langDirections, getUI, isValidLang, defaultLocale } from '../i18n/ui';
import { siteAuthor, authorBio } from '../data/site-author';
import AuthorBio from '../components/AuthorBio.astro';

const { 
  title, 
  description = 'Your ultimate guide to traveling, living and working in China', 
  lang = 'en',
  breadcrumbs = [],
  type = 'WebPage',
  publishedDate = '',
  modifiedDate = '',
  ogImage = 'https://chinastarterhub.com/images/og-default.png'
} = Astro.props;

const currentLang = isValidLang(lang) ? lang : defaultLocale;
const dir = langDirections[currentLang];
const t = getUI(currentLang);
const base = `/${currentLang}`;

// 判断当前页面是否为内容文章页（导航页不显示作者行/作者卡）
// 导航页：首页、about/contact/privacy/search/apps + 各子目录 index（/en/cities/ 这类）
const NAV_PAGES = new Set(['', 'about', 'contact', 'privacy', 'search', 'apps']);
const pathSegments = Astro.url.pathname.split('/').filter(Boolean); // ['en','cities','beijing-guide']
const firstSegment = pathSegments[1] || '';
const isSubIndex = Astro.url.pathname.endsWith('/') && pathSegments.length === 2; // /en/cities/ 等
const isArticlePage = pathSegments.length >= 2 && !NAV_PAGES.has(firstSegment) && !isSubIndex;
const schemaType = isArticlePage ? 'Article' : type;

// Build alternate-language URLs for the current page
const currentPath = Astro.url.pathname;
const alternateUrls = langs.map(l => {
  const newPath = currentPath.replace(/^\/[a-z]{2}\//, `/${l}/`);
  return { lang: l, label: langLabels[l], href: newPath };
});
---

<html lang={currentLang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="China Starter Hub" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.svg" />

    <!-- hreflang tags for all language versions -->
    {alternateUrls.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={`https://chinastarterhub.com${alt.href}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`https://chinastarterhub.com${alternateUrls.find(a => a.lang === 'en')?.href || '/'}`} />

    <!-- Travelpayouts Drive -->
    <script nowprocket data-noptimize="1" data-cfasync="false" data-wpfc-render="false" seraph-accel-crit="1" data-no-defer="1">
      (function () {
          var script = document.createElement("script");
          script.async = 1;
          script.src = 'https://emrldco.com/NTU2NjE3.js?t=556617';
          document.head.appendChild(script);
      })();
    </script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5XBG2EKSCG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5XBG2EKSCG');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "China Starter Hub",
      "url": "https://chinastarterhub.com",
      "description": "Clear, current guidance for first-time foreigners visiting China.",
      "inLanguage": currentLang,
    })}></script>

    <!-- Person JSON-LD (author) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": siteAuthor.fullName,
      "description": siteAuthor.schemaDescription,
      "url": "https://chinastarterhub.com/en/about/",
      "jobTitle": "Travel Writer",
      "knowsAbout": ["Travel in China", "High-speed rail", "Mobile payments in China", "Chinese cities"]
    })}></script>

    <!-- BreadcrumbList JSON-LD -->
    {breadcrumbs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbs.map((crumb, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": crumb.name,
          "item": `https://chinastarterhub.com${crumb.path}`
        }))
      })}></script>
    )}

    <!-- Article / WebPage JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": schemaType,
      "headline": title,
      "description": description,
      "url": Astro.url.href,
      "inLanguage": currentLang,
      ...(schemaType === 'Article' && publishedDate ? { "datePublished": publishedDate } : {}),
      ...(schemaType === 'Article' ? { "dateModified": modifiedDate || publishedDate } : {}),
      ...(schemaType === 'Article' ? {
        "author": {
          "@type": "Person",
          "name": siteAuthor.fullName,
          "url": "https://chinastarterhub.com/en/about/"
        }
      } : {}),
      "publisher": {
        "@type": "Organization",
        "name": "China Starter Hub",
        "url": "https://chinastarterhub.com"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": Astro.url.href
      },
      "image": ogImage
    })}></script>
    <!-- System font stack — no external font downloads, instant render, 0 CLS -->
    <style is:global>
      /* Responsive tables — horizontal scroll on mobile, keep full format */
      .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin: 16px 0;
      }
      .table-responsive table {
        min-width: 480px;
      }
      @media (max-width: 640px) {
        .table-responsive table {
          font-size: 0.875rem;
        }
        .table-responsive table th,
        .table-responsive table td {
          padding-left: 0.75rem !important;
          padding-right: 0.75rem !important;
        }
      }

      /* Global image styles */
      .screenshot-wrapper {
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 16px;
        margin: 16px 0;
      }
      .screenshot-wrapper img {
        width: 100%;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        margin: 8px 0;
      }
      .screenshot-label {
        display: inline-block;
        background: #d1d5db;
        color: #374151;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 10px;
        border-radius: 5px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased">
    <!-- Nav -->
    <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href={base + '/'} class="flex items-center gap-2 no-underline group">
          <img src="/logo-icon.svg" alt="" class="h-8 w-8" />
          <span class="text-lg font-bold text-brand-600">{t.siteName}</span>
        </a>
        <div class="hidden md:flex items-center gap-5 text-sm">
          {t.nav.map(item => (
            <a href={item.href} class="text-gray-600 hover:text-brand-600 no-underline transition-colors">{item.label}</a>
          ))}
        </div>
        <div class="flex items-center gap-3">
          <!-- Language Switcher -->
          <div class="relative" id="lang-switcher">
            <button
              id="lang-btn"
              type="button"
              class="flex items-center gap-1 text-xs px-3 py-1.5 rounded border border-gray-200 text-gray-600 bg-white hover:border-brand-300 hover:text-brand-600 transition-colors cursor-pointer"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-label={t.language}
            >
              <span>{langLabels[currentLang]}</span>
              <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <ul
              id="lang-menu"
              class="hidden absolute end-0 top-full mt-1 w-40 max-h-72 overflow-auto rounded-lg border border-gray-100 bg-white shadow-lg py-1 text-sm z-50"
              role="listbox"
              aria-label={t.language}
            >
              {alternateUrls.map(item => (
                <li role="option" aria-selected={item.lang === currentLang}>
                  <a
                    href={item.href}
                    data-lang={item.lang}
                    class={`block px-4 py-2 no-underline transition-colors ${item.lang === currentLang ? 'bg-brand-50 text-brand-700 font-medium' : 'text-gray-700 hover:bg-gray-50 hover:text-brand-600'}`}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <!-- Mobile menu -->
          <button id="mobile-menu-btn" class="md:hidden text-gray-500 text-xl" aria-label="Menu">☰</button>
        </div>
      </div>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden px-4 pb-4 flex flex-col gap-2 text-sm">
        {t.nav.map(item => (
          <a href={item.href} class="text-gray-600 hover:text-brand-600 no-underline py-1">{item.label}</a>
        ))}
      </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 py-8">
      <slot />
      {isArticlePage && (
        <div class="max-w-3xl mx-auto">
          <AuthorBio lang={currentLang} />
        </div>
      )}
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-100 mt-16">
      <div class="max-w-5xl mx-auto px-4 py-8 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-gray-400">
        <span>© 2026 {t.siteName}</span>
        <div class="flex gap-4">
          <a href={`/${currentLang}/about/`} class="hover:text-brand-600 no-underline">{t.footer.about}</a>
          <a href={`/${currentLang}/privacy/`} class="hover:text-brand-600 no-underline">{t.footer.privacy}</a>
          <a href={`/${currentLang}/contact/`} class="hover:text-brand-600 no-underline">{t.footer.contact}</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Mobile menu
      function initMobileMenu() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }

      // Language dropdown
      function initLangSwitcher() {
        const switcher = document.getElementById('lang-switcher');
        const btn = document.getElementById('lang-btn');
        const menu = document.getElementById('lang-menu');
        if (!switcher || !btn || !menu) return;

        function toggle(open) {
          btn.setAttribute('aria-expanded', String(open));
          menu.classList.toggle('hidden', !open);
        }

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = btn.getAttribute('aria-expanded') === 'true';
          toggle(!isOpen);
        });

        menu.addEventListener('click', (e) => {
          const link = e.target.closest('a[data-lang]');
          if (!link) return;
          e.preventDefault();
          const targetLang = link.getAttribute('data-lang');
          const currentLang = document.documentElement.lang;
          if (targetLang === currentLang) {
            toggle(false);
            return;
          }
          const newPath = window.location.pathname.replace(/^\/[a-z]{2}\//, '/' + targetLang + '/');
          window.location.href = newPath;
        });

        document.addEventListener('click', (e) => {
          if (!switcher.contains(e.target)) toggle(false);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') toggle(false);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => { initMobileMenu(); initLangSwitcher(); });
      } else {
        initMobileMenu(); initLangSwitcher();
      }
    </script>
  </body>
</html>
