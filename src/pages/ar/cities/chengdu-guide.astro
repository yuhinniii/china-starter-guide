---
import Layout from '@layouts/Layout.astro';
const title = "دليل تشنغدو السياحي: الباندا، الطعام الحار، والحياة البطيئة";
const description = "زر تشنغدو — شاهد الباندا العملاقة، تناول أطعم العالم حرارة، واختبر أسلوب حياة سيتشوان المريح.";
---

<Layout title={title} description={description} lang="ar">
    <nav class="mb-8 not-prose">
      <a href="/ar/cities/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        العودة إلى أدلة المدن
      </a>
    </nav>
  <article class="max-w-4xl mx-auto px-6 py-12">
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🏙️ تشنغدو</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">دليل تشنغدو السياحي: الباندا، الطعام الحار، والحياة البطيئة</h1>
      <p class="text-xl text-gray-600 mb-6">زر تشنغدو — شاهد الباندا العملاقة، تناول أطعم العالم حرارة، واختبر أسلوب حياة سيتشوان المريح.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500"><span>📅 آخر تحديث: يونيو 2026</span><span>⏱️ 8 دقائق</span></div>
    </header>

    <div class="bg-gradient-to-r from-orange-50 to-red-50 border-l-4 border-orange-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-orange-900 mb-4">⚡ إجابة سريعة</h2>
      <p class="text-lg text-orange-800 leading-relaxed">تشنغدو هي <strong>أرض الباندا وفلفل سيتشوان</strong>. شاهد الباندا العملاقة وهي تتدحرج في غابات الخيزران في الصباح، تناول طعاماً حاراً لدرجة أنه يجعلك تطن أذناك في الغداء، واحتسِ الشاي في معبد عمره 1000 عام في فترة ما بعد الظهر. المدينة مشهورة بإيقاع حياتها المريح — يقول السكان المحليون إن تشنغدو هي "مدينة السعادة"، وستشعر بذلك منذ لحظة وصولك.</p>
    </div>

    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 في هذا الدليل</h3>
      <ul class="space-y-3">
        <li><a href="#why-visit" class="text-blue-600 hover:underline">🐼 لماذا زيارة تشنغدو؟</a></li>
        <li><a href="#how-many-days" class="text-blue-600 hover:underline">📅 كم يوماً تحتاج؟</a></li>
        <li><a href="#attractions" class="text-blue-600 hover:underline">🎯 أهم المعالم</a></li>
        <li><a href="#getting-around" class="text-blue-600 hover:underline">🚇 التنقل</a></li>
        <li><a href="#where-to-stay" class="text-blue-600 hover:underline">🏨 أماكن الإقامة</a></li>
        <li><a href="#what-to-eat" class="text-blue-600 hover:underline">🍜 ماذا تأكل</a></li>
      </ul>
    </nav>

    <h2 id="why-visit" class="text-3xl font-bold text-gray-900 mb-6 mt-12">🐼 لماذا زيارة تشنغدو؟</h2>
    <p class="text-lg leading-relaxed text-gray-700 mb-12">تشنغدو هي عاصمة مقاطعة سيتشوان وبوابة عجائب غرب الصين الطبيعية. إنها توازن بين التقاليد والحداثة بسهولة — المعابد القديمة تجلس بجانب أحياء الفنون العصرية، وأطعم العالم حرارة تُقدم في مطاعم ظلت مفتوحة لأجيال. وتيرة الحياة بطيئة بشكل مشهور: تشنغدو لديها بيوت شاي أكثر من أي مدينة أخرى في الصين، والناس يستخدمونها فعلاً.</p>

    <h2 id="how-many-days" class="text-3xl font-bold text-gray-900 mb-6 mt-12">📅 كم يوماً تحتاج؟</h2>
    <ul class="list-disc pl-6 space-y-2 text-lg text-gray-700 mb-4">
      <li><strong>3–4 أيام (قياسي):</strong> الباندا، جينلي، معبد ووهو، وأكل جاد</li>
      <li><strong>5–7 أيام (مريح):</strong> أضف تمثال بوذا العملاق في ليشيان (يوم واحد) أو جبل إيمي (يومان)</li>
      <li><strong>7+ أيام (غوص عميق):</strong> أضف حديقة جيوتشايغو الوطنية (3–4 أيام)</li>
    </ul>
    <p class="text-lg text-gray-700 mb-12">إذا كان لديك أيام إضافية، فإن مقاطعة سيتشوان تملك بعضاً من أروع المناظر الطبيعية في الصين. تمثال بوذا العملاق في ليشيان (حوالي 1.5 ساعة من تشنغدو) هو أكبر تمثال بوذا حجري في العالم بارتفاع 71 متراً. للمسافرين المغامرين، بحيرات جيوتشايغو الفيروزية وشلالاتها لا تُنسى لكنها تتطلب 3–4 أيام كحد أدنى.</p>

    <!-- ==================== ATTRACTIONS ==================== -->
    <h2 id="attractions" class="text-3xl font-bold text-gray-900 mb-6 mt-12">🎯 أهم المعالم</h2>

    <!-- Panda Base -->
    <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/chengdu/panda-base.webp" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h3 class="text-xl font-bold text-gray-900 mb-2">قاعدة أبحاث تربية الباندا العملاقة في تشنغدو (成都大熊猫繁育研究基地)</h3>
        <p class="text-gray-700">موطن لحوالي 120 باندا عملاقة — أكثر من أي مكان آخر على الكوكب. اذهب إليها بحلول الساعة 8 صباحاً لجلسة التغذية الصباحية (8-10 صباحاً)، عندما تكون الباندا في أكثر حالاتها نشاطاً ومرحاً. حوالي 30 دقيقة بسيارة الأجرة من وسط المدينة. تجنب الزيارة بعد الظهر — سيكونون في قيلولة خلال الحرارة.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

    <!-- Jinli -->
    <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/chengdu/jinli.webp" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h3 class="text-xl font-bold text-gray-900 mb-2">شارع جينلي القديم (锦里)</h3>
        <p class="text-gray-700">معظم شوارع السياحة تشبه مدينة الملاهي — جينلي تشعر أنها حية فعلاً. بُني على طراز عهد تشينغ، هذا الممر للمشاة يمتد بجانب ضريح ووهو ويمتلئ برائحة الأسياخ المشوية ولوحات السكر وعروض أوبرا سيتشوان المتدفقة من بيوت الشاي. تعال ليلاً عندما تضاء الفوانيس الحمراء وتخف الحشود قليلاً.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

    <!-- Wuhou Shrine -->
    <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/chengdu/wuhou-shrine.webp" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h3 class="text-xl font-bold text-gray-900 mb-2">ضريح ووهو (武侯祠)</h3>
        <p class="text-gray-700">مخصص لزهوغ ليانغ، الاستراتيجي الأسطوري الذي لا يزال اسمه يتردد عبر 1800 عام من تاريخ الممالك الثلاث. القطعة المركزية هي قبر زهوغ ليانغ نفسه، الواقع بين جدران حمراء ومسارات مصطفة بالخيزران تجعل المكان كله يبدو متجمداً في الزمن. لا تفوت الألواح الحجرية والتماثيل في القاعة الرئيسية. ادمجه مع جينلي المجاورة — يمكنك القيام بكليهما في فترة ما بعد ظهر واحدة.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

    <!-- Kuanzhai Alley -->
    <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/chengdu/wide-narrow-alley.webp" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h3 class="text-xl font-bold text-gray-900 mb-2">زقاق كوانتشاي (宽窄巷子)</h3>
        <p class="text-gray-700">ثلاثة أزقة، ثلاثة مزاجات مختلفة تماماً. كوان زاي (الزقاق الواسع) هو مغناطيس السياح — محلات، وجبات خفيفة، حشود بملابس متطابقة. زاي شيانغ (الزقاق الضيق) حيث يصبح جيداً: محلات بوتيك، صالات فنية، ومقاهي مخبأة في أفنية من عهد تشينغ. ثم هناك جينغ شيانغ (زقاق البئر)، الأكثر هدوءاً من بين الثلاثة، تصطف على جانبيه منازل سكنية وعدد أقل من الناس. ابدأ بالواسع، اشعر بالملل، واهرب إلى الضيق.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

    <!-- People's Park -->
    <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/chengdu/people-park.webp" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h3 class="text-xl font-bold text-gray-900 mb-2">حديقة الشعب (人民公园)</h3>
        <p class="text-gray-700">هنا يصبح كليشيه الحياة البطيئة في تشنغدو حقيقة. احصل على كرسي من الخيزران في أحد بيوت الشاي المكشوفة، اطلب كوباً من الياسمين، وشاهد فقط — رجالاً مسنين يلعبون الماه Jong، أزواجاً متقاعدين يرقصون، عمات يغنين الأوبرا. لا تفوت "ركن التوفيق" حيث ينشر الآباء إعلانات زواج لأطفالهم مع تفاصيل الراتب والطول والممتلكات مذكورة مثل مواصفات المنتج. تعال في عطلة نهاية الأسبوع للمشهد الكامل.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

    <!-- Mount Qingcheng -->
    <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-12 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/chengdu/qingcheng-mountain.webp" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h3 class="text-xl font-bold text-gray-900 mb-2">جبل تشينغتشنغ (青城山)</h3>
        <p class="text-gray-700">أحد أماكن ولادة الطاوية، بتاريخ يمتد لـ 1800 عام. الجبل يحمل نقشاً يصفه بأنه "الأكثر هدوءاً تحت السماء" — ويستحق الاسم. استخدم التلفريك إذا كنت ضيق الوقت، أو امشِ المسار المظلل بالخيزران للتجربة الكاملة. على أي حال، المعابد القديمة في القمة تستحق الرحلة. حوالي ساعة من تشنغدو بالقطار.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

        <!-- Leshan Giant Buddha -->
    <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-12 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/chengdu/leshan-buddha-v2.webp" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h3 class="text-xl font-bold text-gray-900 mb-2">Leshan Giant Buddha (乐山大佛)</h3>
        <p class="text-gray-700">أكبر تمثال بوذا حجري في العالم بارتفاع 71 متراً، منحوت مباشرة في جرف على ضفة النهر. استغرق بناؤه 90 عاماً واكتمل عام 803 م. موقع تراث عالمي لليونسكو.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

<!-- Dujiangyan -->
    <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-12 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/chengdu/dujiangyan.webp" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h3 class="text-xl font-bold text-gray-900 mb-2">نظام دوجيانغيان للري (都江堰)</h3>
        <p class="text-gray-700">أعجوبة هندسية عمرها 2300 عام لا تزال قيد الاستخدام حتى اليوم. بناها لي بينغ وابنه في عام 256 قبل الميلاد لترويض نهر مين، وهي تحول المياه بدون سد واحد — فقط ضفاف نهر مصممة بذكاء وجزيرة اصطناعية تقسم التدفق إلى قنوات ري. النتيجة: أصبح سهل تشنغدو واحداً من أكثر مناطق الصين خصوبة وبقي على هذا الحال لأكثر من ألفي عام. تتناسب مع جبل تشينغتشنغ بشكل مثالي — يبعدان 15 دقيقة فقط بالحافلة أو سيارة الأجرة، لذا يمكنك القيام بكليهما في يوم واحد. جسر أنلان المعلق عبر النهر يستحق المشي لإطلالة الجبال في الخلفية.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

    <h2 id="getting-around" class="text-3xl font-bold text-gray-900 mb-6 mt-12">🚇 التنقل</h2>
    <ul class="list-disc pl-6 space-y-3 text-lg text-gray-700 mb-12">
      <li><strong>المترو:</strong> 6 خطوط تغطي جميع المعالم الرئيسية وقاعدة الباندا. نظيف، حديث، ورخيص. راجع <a href="/ar/transport/metro-bus/" class="text-blue-600 hover:underline">دليل المترو والحافلات للمدن الصينية الكبرى</a> لنصائح عامة.</li>
      <li><strong>ديدي:</strong> ميسور التكلفة جداً — معظم الرحلات عبر وسط المدينة 20–40 يوان. قم بإعداده مسبقاً مع <a href="/ar/transport/didi/" class="text-blue-600 hover:underline">كيفية استخدام ديدي في الصين كأجنبي</a>.</li>
      <li><strong>ركوب الدراجات:</strong> تشنغدو مسطحة ولديها ممرات مخصصة للدراجات. الدراجات المشتركة في كل مكان.</li>
      <li><strong>القطار فائق السرعة:</strong> محطة تشنغدو الشرقية تربط بشيآن (3.5 ساعات) وتشونغتشينغ (1.5 ساعة). اقرأ <a href="/ar/transport/high-speed-rail/" class="text-blue-600 hover:underline">كيف تحجز وتركب القطار فائق السرعة في الصين</a> لتعليمات الحجز.</li>
    </ul>

    <h2 id="where-to-stay" class="text-3xl font-bold text-gray-900 mb-6 mt-12">🏨 أماكن الإقامة</h2>
    <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6"><h3 class="text-xl font-bold text-gray-900 mb-2">منطقة جينجيانغ (锦江区) — الأفضل للزوار الجدد</h3><p class="text-gray-700">المنطقة المركزية حول شارع تشونشي وتايكو لي. التسوق وتناول الطعام ووصلات المترو على مسافة قريبة سيراً.</p></div>
    <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6"><h3 class="text-xl font-bold text-gray-900 mb-2">منطقة تشينغيانغ (青羊区) — الأفضل لعشاق الثقافة</h3><p class="text-gray-700">قريبة من ضريح ووهو وجينلي وزقاق كوانتشاي. أجواء تقليدية مع الكثير من بيوت الشاي.</p></div>
    <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-12"><h3 class="text-xl font-bold text-gray-900 mb-2">منطقة ووهو (武侯区) — الأفضل لعشاق الطعام</h3><p class="text-gray-700">قلب مشهد الطعام. على مسافة قريبة سيراً من أفضل مطاعم تشنغدو والحياة الليلية.</p></div>

    <!-- ==================== WHAT TO EAT ==================== -->
    <h2 id="what-to-eat" class="text-3xl font-bold text-gray-900 mb-6 mt-12">🍜 ماذا تأكل</h2>
    <p class="text-lg leading-relaxed text-gray-700 mb-6">تشنغدو هي العاصمة بلا منازع لطعام سيتشوان — جريء، ناري، ولا يُنسى.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <!-- Mapo Tofu -->
      <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <div class="flex items-center justify-center bg-gray-50 p-3">
          <img src="/images/chengdu/mapo-tofu.webp" class="max-w-full max-h-56 object-contain" loading="lazy" />
        </div>
        <div class="p-4">
          <h3 class="text-lg font-bold text-gray-900 mb-1">مابو توفو (麻婆豆腐)</h3>
          <p class="text-gray-600 text-base">مكعبات توفو حريرية تسبح في صلصة قرمزية نارية ومخدرة في آن واحد. حبوب فلفل سيتشوان تترك وخزاً على لسانك يزداد مع كل قضمة — النوع الذي يجعلك تمد يدك لملعقة أخرى حتى مع تعرق جبهتك. التباين بين التوفو الطري الذي يذوب في الفم والصلصة الخشنة اللاذعة هو المغزى الكامل. موجود في كل مطعم سيتشواني تقريباً في المدينة.</p>
        </div>
      </div>

      <!-- Kung Pao Chicken -->
      <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <div class="flex items-center justify-center bg-gray-50 p-3">
          <img src="/images/chengdu/kung-pao-chicken.webp" class="max-w-full max-h-56 object-contain" loading="lazy" />
        </div>
        <div class="p-4">
          <h3 class="text-lg font-bold text-gray-900 mb-1">دجاج كونغ باو — غونغ باو جي دينغ (宫保鸡丁)</h3>
          <p class="text-gray-600 text-base">دجاج مقطع، فول سوداني مقرمش، وفلفل حار مجفف يبدو أشرس مما هو عليه. السر هو التوازن — ضربة حلوة-حامضة من صلصة الخل والسكر، تليها دفء بطيء من الفلفل الحار، كلها مرتكزة على crunch الفول السوداني. إنه الطبق الذي يعرفه الأجانب أكثر من غيره، ولسبب وجيه. ابحث عن نسخة مع فلفل حار مجفف كامل تنتقيه أثناء الأكل — الطريقة المحلية الصحيحة.</p>
        </div>
      </div>

      <!-- Dan Dan Noodles -->
      <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <div class="flex items-center justify-center bg-gray-50 p-3">
          <img src="/images/chengdu/dan-dan-noodles.webp" class="max-w-full max-h-56 object-contain" loading="lazy" />
        </div>
        <div class="p-4">
          <h3 class="text-lg font-bold text-gray-900 mb-1">نودلز دان دان (担担面)</h3>
          <p class="text-gray-600 text-base">نودلز طعام الشارع الأصلية. لحم خنزير مفروم، خضروات محفوظة، وطبقة من زيت الفلفل الحار في قاع الوعاء — تخلطها بنفسك، تغطي كل شعيرية بذلك الصلصة المالحة-الحارة-المخدرة. الخضروات المحفوظة تعطيها عمقاً ترابياً يقطع الحرارة. قلّب بسرعة وكل أسرع.</p>
        </div>
      </div>

      <!-- Hotpot -->
      <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <div class="flex items-center justify-center bg-gray-50 p-3">
          <img src="/images/chengdu/hotpot.webp" class="max-w-full max-h-56 object-contain" loading="lazy" />
        </div>
        <div class="p-4">
          <h3 class="text-lg font-bold text-gray-900 mb-1">الهوت بوت — هوو غوو (火锅)</h3>
          <p class="text-gray-600 text-base">هذه ليست وجبة — إنه نشاط جماعي لمدة ساعتين. قدر من المرق الفقاعي المليء بالفلفل الحار في وسط الطاولة بينما يطبخ الجميع مكوناتهم الخاصة: لحم بقري مقطع رقيق، كرشة، بطاطس، خضروات، جلد توفو. الحركة الحقيقية هي محطة صلصة التغميس — اخلط زيت السمسم والثوم والكزبرة والخل لتبريد الحرارة. اذهب مع ثلاثة أشخاص على الأقل لتتمكن من طلب المزيد. واحصل على "يوانيانغ" (قدر مقسم) إذا كنت لا تتحمل الحار الكامل.</p>
        </div>
      </div>

      <!-- Twice-Cooked Pork -->
      <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <div class="flex items-center justify-center bg-gray-50 p-3">
          <img src="/images/chengdu/twice-cooked-pork.webp" class="max-w-full max-h-56 object-contain" loading="lazy" />
        </div>
        <div class="p-4">
          <h3 class="text-lg font-bold text-gray-900 mb-1">لحم الخنزير المطبوخ مرتين — هوي غوو رو (回锅肉)</h3>
          <p class="text-gray-600 text-base">بطن خنزير يُسلق أولاً، ثم يُقطع رقيقاً، ثم يُقلى مع الكراث ودوبانجيانغ (معجون الفلفل الحار المخمر) حتى تكرمل الحواف. تقنية الطهي المزدوج تعطي اللحمة قواماً لا يمكنك الحصول عليه بأي طريقة أخرى — طري من الداخل، مقرمش ومطاطي قليلاً من الخارج. إنها النسخة السيتشوانية من طعام الراحة، النوع الذي تأكله على مائدة عشاء عائلية. ستجده في كل قائمة محلية تقريباً.</p>
        </div>
      </div>

      <!-- Fuqi Feipian -->
      <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <div class="flex items-center justify-center bg-gray-50 p-3">
          <img src="/images/chengdu/fuqi-feipian.webp" class="max-w-full max-h-56 object-contain" loading="lazy" />
        </div>
        <div class="p-4">
          <h3 class="text-lg font-bold text-gray-900 mb-1">فو تشي فاي بيان (夫妻肺片)</h3>
          <p class="text-gray-600 text-base">شرائح لحم بقري وأحشاء باردة مغمورة بصلصة زيت الفلفل الحار الثقيلة بفلفل سيتشوان والسمسم المحمص. على الرغم من أن الاسم يُترجم إلى "شريحة رئة الزوج والزوجة"، لا توجد رئة — إنها قصة عن زوجين كانا يبيعان هذا من عربة شارع في ثلاثينيات القرن الماضي. القوام هو ما يلفتك: شرائح رقيقة طرية مع زيت عطري لزج يلتصق بكل قطعة. احصل عليها من كونتر الأطباق الباردة في أي مطعم محلي.</p>
        </div>
      </div>

      <!-- Ice Jelly -->
      <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <div class="flex items-center justify-center bg-gray-50 p-3">
          <img src="/images/chengdu/bingfen.webp" class="max-w-full max-h-56 object-contain" loading="lazy" />
        </div>
        <div class="p-4">
          <h3 class="text-lg font-bold text-gray-900 mb-1">جيلي الثلج — بينغ فن (冰粉)</h3>
          <p class="text-gray-600 text-base">منظف الحنك السيتشواني المطلق. يُعصر يدوياً من بذور النبات، بينغ فن له قوام جيلي أنعم من Jell-O بمظهر دقيق شبه شفاف. يُغطى بشراب السكر البني والفول السوداني المطحون وأحياناً الفواكه المجففة — إنه حلو، بارد، وينزلق في حلقك بطريقة تعيد ضبط فمك بعد كل تلك الحرارة. لا تخط هذا — ستحتاجه.</p>
        </div>
      </div>
