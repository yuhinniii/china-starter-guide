---
import Layout from '@layouts/Layout.astro';
const title = 'دليل سور الصين العظيم: أي قسم تزور؟';
const description = 'كيف تقارن أقسام سور الصين العظيم الستة — بادالينغ، موتيانيو، جينشانلينغ، سيماتاي، هوانغهواچنغ وجويونغقوان — من حيث الازدحام والصعوبة والتذاكر والجولات الليلية.';
---

<Layout title={title} description={description} lang="ar">
  <article class="max-w-4xl mx-auto px-6 py-12">

    <!-- ============ BREADCRUMB ============ -->
    <nav class="mb-8 not-prose">
      <a href="/ar/cities/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        العودة إلى أدلة المدن
      </a>
    </nav>

    <!-- ============ HERO ============ -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🧱 سور الصين العظيم · بكين</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">سور الصين العظيم: أي قسم يجب أن تزور؟</h1>
      <p class="text-xl text-gray-600 mb-6">بادالينغ، موتيانيو، جينشانلينغ أو سيماتاي — ما الذي يميزها فعليًا، وأيها يناسب رحلتك التي تخطط لها.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 آخر تحديث: سبتمبر 2026</span>
        <span>⏱️ 12 دقيقة قراءة</span>
      </div>
    </header>

    <!-- ============ HERO IMAGE ============ -->
    <figure class="mb-12 not-prose">
      <img
        src="/images/great-wall/comparison-grid.webp"
        alt="ستة أقسام من سور الصين العظيم قرب بكين: بادالينغ بين أزهار الربيع، موتيانيو بألوان الخريف، جينشانلينغ فوق بحر السحاب، سيماتاي متوهج ليلًا فوق بلدة جوبي المائية، هوانغهواچنغ ينزل إلى بحيرة فيروزية، وممر حصن جويونغقوان"
        width="1200"
        height="534"
        loading="eager"
        fetchpriority="high"
        class="w-full h-auto object-cover rounded-2xl shadow-md"
      />
      <figcaption class="text-xs text-gray-500 text-center mt-2">نفس السور، ستة أيام مختلفة. من اليسار إلى اليمين، ومن الأعلى إلى الأسفل: بادالينغ، موتيانيو، جينشانلينغ، سيماتاي، هوانغهواچنغ، جويونغقوان.</figcaption>
    </figure>

    <!-- ============ QUICK ANSWER ============ -->
    <div class="bg-gradient-to-r from-red-50 to-orange-50 border-l-4 border-red-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-red-900 mb-4">⚡ إجابة سريعة</h2>
      <p class="text-lg text-red-800 leading-relaxed">
        <strong>موتيانيو</strong> هو الخيار الأفضل بشكل عام لمعظم الزوار لأول مرة — مُرمم بالكامل ودرامي، مع تلفريك للصعود وزلاجة للنزول، وبجزء بسيط من ازدحام بادالينغ. <strong>بادالينغ</strong> هو القسم المُعتَمَد — أول قسم فُتح للسياح، والامتداد الذي يزوره رؤساء الدول، وأعظم الأقسام المُرممة ضخامةً، صاعدًا إلى البرج الثامن الشمالي على ارتفاع 888 م، والموسوم بلوحة «من لم يبلغ سور الصين العظيم لم يكن رجلاً حقيقياً». <strong>جينشانلينغ</strong> هو خيار المشاة والمصورين — أكثر هدوءًا وأقل إعادة بناء، بـ67 برج مراقبة وفتح قبل الفجر لبحر السحاب. <strong>سيماتاي</strong> هو القسم ذو الأجواء — جولات ليلية طوال العام، مع بلدة جوبي المائية عند سفحه مباشرة. <strong>هوانغهواچنغ</strong> هو الغريب — القسم الوحيد الذي ينزل فيه السور إلى الماء المفتوح، مع قوارب وجسر زجاجي. <strong>جويونغقوان</strong> هو أقرب ممر وأهدأ — حلقة حصن لا صعود على حافة، وأفضل خيار لنصف يوم أو لفصل الشتاء.
      </p>
    </div>

    <!-- ============ IN THIS GUIDE ============ -->
    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 في هذا الدليل</h3>
      <ul class="space-y-3">
        <li><a href="#which-section" class="text-blue-600 hover:underline">🤔 أي قسم يجب أن تزور؟</a></li>
        <li><a href="#night" class="text-blue-600 hover:underline">🌙 هل يمكنك زيارة سور الصين العظيم ليلاً؟</a></li>
        <li><a href="#badaling" class="text-blue-600 hover:underline">🏔️ بادالينغ</a></li>
        <li><a href="#mutianyu" class="text-blue-600 hover:underline">🌳 موتيانيو</a></li>
        <li><a href="#jinshanling" class="text-blue-600 hover:underline">☁️ جينشانلينغ</a></li>
        <li><a href="#simatai" class="text-blue-600 hover:underline">🌃 سيماتاي</a></li>
        <li><a href="#huanghuacheng" class="text-blue-600 hover:underline">💧 هوانغهواچنغ</a></li>
        <li><a href="#juyongguan" class="text-blue-600 hover:underline">🏯 جويونغقوان</a></li>
        <li><a href="#tickets" class="text-blue-600 hover:underline">🎫 التذاكر والحجز</a></li>
        <li><a href="#best-time" class="text-blue-600 hover:underline">📅 أفضل وقت للزيارة</a></li>
        <li><a href="#practical-tips" class="text-blue-600 hover:underline">👟 ماذا يجب أن تحزم؟</a></li>
        <li><a href="#history" class="text-blue-600 hover:underline">📜 طوب مينغ، لا طوب تشين</a></li>
      </ul>
    </nav>

    <!-- ============ SECTION 1: WHICH SECTION ============ -->
    <hr class="border-gray-200 my-12" />
    <h2 id="which-section" class="text-3xl font-bold text-gray-900 mb-6 mt-12">🤔 أي قسم يجب أن تزور؟</h2>
    <p class="text-lg leading-relaxed text-gray-700 mb-8">كل قسم هو تقنيًا نفس السور. لكن لا قسمين يمنحانك نفس اليوم. الفروق التي تهم ليست المسافة أو سعر التذكرة — بل <strong>مدى الازدحام، ومدى الجهد الذي يجب أن تبذله، وما الذي يفعله السور فعليًا عند وصولك إليه</strong> (متسعًا فوق الحواف، أو نازلًا إلى بحيرة، أو متوهجًا أمام سماء الليل). الأقسام أدناه مرتبة حسب مدى ملاءمتها لزيارة أولى أو ثانية.</p>

    <h3 class="text-xl font-bold text-gray-900 mb-4">كيف تقارن أقسام سور الصين العظيم الستة</h3>

    <div class="overflow-x-auto mb-8 not-prose">
      <table class="w-full text-sm text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
        <thead>
          <tr class="bg-gray-900 text-white">
            <th class="px-3 py-3 font-bold align-bottom">القسم</th>
            <th class="px-3 py-3 font-bold align-bottom">البعد عن بكين</th>
            <th class="px-3 py-3 font-bold align-bottom">الازدحام</th>
            <th class="px-3 py-3 font-bold align-bottom">الصعوبة</th>
            <th class="px-3 py-3 font-bold align-bottom">الدخول</th>
            <th class="px-3 py-3 font-bold align-bottom">الوقت اللازم</th>
            <th class="px-3 py-3 font-bold align-bottom">مناسب للأطفال؟</th>
            <th class="px-3 py-3 font-bold align-bottom">اللحظة المميزة</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">بادالينغ</td>
            <td class="px-3 py-3">70 كم · قطار فائق السرعة ~35 دقيقة</td>
            <td class="px-3 py-3">شديد</td>
            <td class="px-3 py-3">سهل</td>
            <td class="px-3 py-3">¥40</td>
            <td class="px-3 py-3">3–4 ساعات</td>
            <td class="px-3 py-3">نعم (تلفريك)</td>
            <td class="px-3 py-3">الضخامة المطلقة — وأكبر عرض ليلي</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-3 py-3 font-semibold">موتيانيو</td>
            <td class="px-3 py-3">70 كم · ~1.5 ساعة بالسيارة</td>
            <td class="px-3 py-3">متوسط</td>
            <td class="px-3 py-3">سهل–متوسط</td>
            <td class="px-3 py-3">¥45</td>
            <td class="px-3 py-3">نصف يوم</td>
            <td class="px-3 py-3">نعم (تلفريك + زلاجة)</td>
            <td class="px-3 py-3">23 برجًا مرممًا، ثم الانزلاق للأسفل</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">جينشانلينغ</td>
            <td class="px-3 py-3">130 كم · ~2.5 ساعة بالسيارة</td>
            <td class="px-3 py-3">قليل</td>
            <td class="px-3 py-3">شاق</td>
            <td class="px-3 py-3">¥65</td>
            <td class="px-3 py-3">يوم كامل</td>
            <td class="px-3 py-3">لا</td>
            <td class="px-3 py-3">67 برجًا متلاصقة، وبحر سحاب عند الفجر</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-3 py-3 font-semibold">سيماتاي</td>
            <td class="px-3 py-3">120 كم · ~2.5 ساعة بالسيارة</td>
            <td class="px-3 py-3">قليل</td>
            <td class="px-3 py-3">شاق</td>
            <td class="px-3 py-3">¥40 نهارًا</td>
            <td class="px-3 py-3">نصف يوم–يوم كامل</td>
            <td class="px-3 py-3">أطفال أكبر سنًا</td>
            <td class="px-3 py-3">السور متوهج فوق بلدة جوبي المائية ليلاً</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">هوانغهواچنغ</td>
            <td class="px-3 py-3">60 كم · ~1.5 ساعة بالسيارة</td>
            <td class="px-3 py-3">قليل–متوسط</td>
            <td class="px-3 py-3">متوسط</td>
            <td class="px-3 py-3">¥58</td>
            <td class="px-3 py-3">نصف يوم</td>
            <td class="px-3 py-3">نعم</td>
            <td class="px-3 py-3">السور يمشي مباشرة نحو بحيرة</td>
          </tr>
          <tr>
            <td class="px-3 py-3 font-semibold">جويونغقوان</td>
            <td class="px-3 py-3">60 كم · ~1 ساعة بالسيارة</td>
            <td class="px-3 py-3">قليل</td>
            <td class="px-3 py-3">متوسط</td>
            <td class="px-3 py-3">¥45 (أبريل–أكتوبر)</td>
            <td class="px-3 py-3">نصف يوم</td>
            <td class="px-3 py-3">نعم</td>
            <td class="px-3 py-3">«الممر رقم 1 تحت السماء» — وقِطارات أزهار الربيع</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-lg leading-relaxed text-gray-700 mb-8">الأسعار هي تذاكر البالغين في موسم الذروة؛ عادةً يدفع الطلاب نصف المبلغ، ويذهب الأطفال دون 1.2 م مجانًا. تختلف الأسعار حسب الموسم والقسم — تحقق قبل ذهابك.</p>

    <!-- ============ SECTION 2: NIGHT ============ -->
    <hr class="border-gray-200 my-12" />
    <h2 id="night" class="text-3xl font-bold text-gray-900 mb-6 mt-12">🌙 هل يمكنك زيارة سور الصين العظيم ليلاً؟</h2>
    <p class="text-lg leading-relaxed text-gray-700 mb-8">يفصل بين هذه الأقسام المسافة والسعر أقل مما تفعله ثلاثة أسئلة عملية: <strong>هل يمكنك الصعود دون تسلق، هل توجد حافلة مكوكية من موقف السيارات، وهل يفتح بعد حلول الظلام؟</strong> إليك الصورة الكاملة.</p>

    <div class="overflow-x-auto mb-8 not-prose">
      <table class="w-full text-sm text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
        <thead>
          <tr class="bg-gray-900 text-white">
            <th class="px-3 py-3 font-bold align-bottom">القسم</th>
            <th class="px-3 py-3 font-bold align-bottom">جولة ليلية</th>
            <th class="px-3 py-3 font-bold align-bottom">الصعود</th>
            <th class="px-3 py-3 font-bold align-bottom">النقل المكوكي / المواصلات</th>
            <th class="px-3 py-3 font-bold align-bottom">النشاط المميز</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">بادالينغ</td>
            <td class="px-3 py-3">✅ كل ليلة، 30 أبريل–6 أكتوبر (الدخول 18:30–21:00)</td>
            <td class="px-3 py-3">تلفريك أو حبل أرضي، ¥100 اتجاه واحد</td>
            <td class="px-3 py-3">نقل مكوكي مجاني للمتنزه؛ «حافلة السور» ¥80 للعودة</td>
            <td class="px-3 py-3">السور مضاء من البرج الشمالي 4 إلى البرج الجنوبي 4</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-3 py-3 font-semibold">موتيانيو</td>
            <td class="px-3 py-3">✅ فترات موسمية (صيف؛ العيد الوطني)</td>
            <td class="px-3 py-3">تلفريك للصعود، زلاجة للنزول</td>
            <td class="px-3 py-3">نقل مكوكي ¥15 للعودة</td>
            <td class="px-3 py-3">مسار الزلاجة</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">جينشانلينغ</td>
            <td class="px-3 py-3">❌</td>
            <td class="px-3 py-3">تلفريك ¥40 اتجاه واحد / ¥60 للعودة</td>
            <td class="px-3 py-3">حافلة نقل ذهابًا ~¥80</td>
            <td class="px-3 py-3">بحر السحاب عند شروق الشمس</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-3 py-3 font-semibold">سيماتاي</td>
            <td class="px-3 py-3">✅ طوال العام (18:00–21:30)</td>
            <td class="px-3 py-3">تلفريك — إلزامي بعد حلول الظلام</td>
            <td class="px-3 py-3">—</td>
            <td class="px-3 py-3">بلدة جوبي المائية، عند السفح مباشرة</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">هوانغهواچنغ</td>
            <td class="px-3 py-3">❌</td>
            <td class="px-3 py-3"><strong>لا يوجد تلفريك</strong> — منزلق مغناطيسي نزولًا على الممشى</td>
            <td class="px-3 py-3">حافلة سياحية أو نقل خاص</td>
            <td class="px-3 py-3">قوارب على البحيرة، بالإضافة إلى جسر زجاجي</td>
          </tr>
          <tr>
            <td class="px-3 py-3 font-semibold">جويونغقوان</td>
            <td class="px-3 py-3">✅ ليل الجمعة والسبت والعطلات، حتى أوائل أكتوبر</td>
            <td class="px-3 py-3"><strong>لا يوجد تلفريك</strong> — تمشي صعودًا وهبوطًا</td>
            <td class="px-3 py-3">—</td>
            <td class="px-3 py-3">مهرجان ليلي من عهد مينغ داخل الممر</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-lg leading-relaxed text-gray-700 mb-8">تمييز يستحق أن يُفهم جيدًا: <strong>النقل المكوكي ليس نفسه سهولة الوصول.</strong> في كل قسم عدا بادالينغ، يغطي النقل المكوكي آخر مسافة فقط — من موقف السيارات إلى البوابة — ولا يزال عليك حافلة أو سيارة أو جولة للوصول إلى موقف السيارات ذاته أولًا. بادالينغ هو القسم الوحيد الذي له محطة قطار خاصة به: خط بكين–تشانغتشياكو فائق السرعة يصل إلى بادالينغ تشانغتشنغ، حوالي 30–40 دقيقة من بكين الشمالية، وتبعد المحطة نحو 800 م عن مدخل التسلق مع نقل مكوكي مجاني يغطي آخر مسافة. لهذا هو القسم الذي يمكنك زيارته بلا سيارة وبلا جولة — ولهذا أيضًا يجذب أكبر الحشود.</p>

    <p class="text-lg leading-relaxed text-gray-700 mb-8">تذاكر الجولات الليلية (2026): بادالينغ <strong>¥198</strong> أيام الأسبوع / <strong>¥298</strong> جمعة–أحد والعطلات، تُحجز عبر الإنترنت مسبقًا (لا توجد شباك تذاكر في الموقع)؛ موتيانيو <strong>¥200</strong> تشمل الدخول والنقل المكوكي والتلفريك؛ سيماتاي <strong>¥200</strong> للجولة الليلية مع رحلة التلفريك ذهابًا وإيابًا (<strong>تذكرة بلدة جوبي المائية غير مشمولة</strong>)؛ جويونغقوان من <strong>¥19.9</strong> مبكرًا. كل جلسة ليلية بدخول بموعد محدد ومحدودة العدد، لذا احجز مسبقًا — تمتلئ مواعيد عطلة نهاية الأسبوع في بادالينغ قبل يومين أو ثلاثة غالبًا.</p>

    <!-- ============ SECTION 3: BADALING ============ -->
    <hr class="border-gray-200 my-12" />
    <h2 id="badaling" class="text-3xl font-bold text-gray-900 mb-6 mt-12">🏔️ بادالينغ: أعظم امتداد — والأكثر ازدحامًا</h2>

    <img
      src="/images/great-wall/badaling.webp"
      alt="سور الصين العظيم في بادالينغ يتسلق التلال المكسوة بأزهار الربيع شمال بكين"
      width="1200"
      height="943"
      loading="lazy"
      class="w-full mb-6 md:float-left md:mr-6 md:mb-4 md:w-2/5 h-72 object-cover rounded-2xl"
    />

    <div class="space-y-8 mb-8">
      <p class="text-lg leading-relaxed text-gray-700"><span class="block text-xl font-bold text-brand-700 mb-2">لماذا يذهب الناس</span> بادالينغ هو أشهر قسم في الصين والقسم الذي يُصطحب إليه رؤساء الدول الأجانب. مُرمم بالكامل، وعريض، ودرامي، والسور يتسلق الحافة بحدة في كلا الاتجاهين — أوسع وأعظم الأقسام المُرممة ضخامةً، صاعدًا إلى <strong>البرج الثامن الشمالي على ارتفاع 888 م</strong>، والموسوم بلوحة <strong>«من لم يبلغ سور الصين العظيم لم يكن رجلاً حقيقياً»</strong>. تحصل على الإحساس الكامل «أنا واقف على سور الصين العظيم» — ولا قسم آخر يمنحك كل هذا السور بتخطيط بهذا القدر القليل.</p>
      <p class="text-lg leading-relaxed text-gray-700"><span class="block text-xl font-bold text-brand-700 mb-2">ما العقدة</span> الجميع يعرف هذا. في عطلة نهاية الأسبوع أو العطلات الرسمية، يصبح بادالينغ مزدحمًا جدًا، وقد تجرفك الحشود. الحيلة هي التوقيت: كن عند البوابة عند فتحها (حوالي 7 صباحًا)، وستكون الساعة الأولى لنفسك إلى حد كبير.</p>
      <p class="text-lg leading-relaxed text-gray-700"><span class="block text-xl font-bold text-brand-700 mb-2">الوصول إلى هناك</span> قطار فائق السرعة إلى محطة <strong>بادالينغ تشانغتشنغ</strong> — حوالي <strong>20–25 دقيقة من تشينغخه</strong> (¥16–25) أو <strong>30–40 دقيقة من بكين الشمالية</strong> (¥25–31)؛ وتبعد المحطة نحو <strong>800 م</strong> عن مدخل التسلق. الحافلة <strong>877</strong>، الآن من <strong>مترو توديتشنغ الشمالي (خطوط 8/10)</strong>، هي الخيار الاقتصادي بـ¥12. <strong>احجز القطار مبكرًا</strong> — تنفد المقاعد على خط بكين–تشانغتشياكو بسرعة في عطلة نهاية الأسبوع والعطلات، وتُفتح التذاكر <strong>قبل 15 يومًا</strong> على 12306 أو Trip.com. إذا فضلت تخطي القطار، فإن إعلان Trip.com أدناه يبيع أيضًا <strong>حافلة مكوكية ذهابًا وإيابًا</strong> مع مرشد على متنها — قابلة للحجز منفردة أو مع الدخول — وتكلف أقل من سيارة خاصة وتسير مباشرة، دون تحويلات الحافلات العامة.</p>
      <p class="text-lg leading-relaxed text-gray-700"><span class="block text-xl font-bold text-brand-700 mb-2">التكلفة</span> الدخول <strong>¥40</strong> موسم الذروة / ¥35 الموسم المنخفض. <strong>تلفريك الخط الشمالي أو الحبل الأرضي للخط الجنوبي</strong> بـ¥100 اتجاه واحد، ¥140 ذهابًا وإيابًا.</p>
      <p class="text-lg leading-relaxed text-gray-700"><span class="block text-xl font-bold text-brand-700 mb-2">السور ليلًا</span> من <strong>30 أبريل إلى 6 أكتوبر</strong>، يشغل بادالينغ جلسة ليلية كل مساء — الدخول 18:30–21:00، وتُضاء الأبراج من 19:20، وآخر خروج 22:00. يفتح ليلًا فقط الامتداد بين <strong>البرج الشمالي 4 والبرج الجنوبي 4</strong> (لا يفتح منحدر «الرجال الأشداء» عند N8). التذاكر بـ<strong>¥198</strong> أيام الأسبوع و<strong>¥298</strong> جمعة–أحد والعطلات الرسمية، ومحدودة بحوالي 3,000 شخص كل ليلة.</p>
      <p class="text-lg leading-relaxed text-gray-700"><span class="block text-xl font-bold text-brand-700 mb-2">الأفضل لـ</span> أي شخص يريد السور المعتَمد — امتداد الزيارات الرسمية، وأفضل عرض ليلي، والقسم الذي يمكنك الوصول إليه بلا سيارة — ويمكنه التعايش مع الحشود.</p>
