---
import Layout from '@layouts/Layout.astro';
const title = 'دليل هاينان السياحي 2026 — بدون تأشيرة لـ 59 دولة';
const description = 'خطط لرحلتك إلى هاينان، جزيرة الصين الاستوائية. 30 يوماً بدون تأشيرة لـ 59 دولة. شواطئ استوائية، مشي في الغابات المطيرة، طعام محلي، ونصائح سفر في دليل واحد.';
const lastUpdated = 'يونيو 2026';
const readTime = '7 دقائق';
---

<Layout title={title} description={description} lang="ar">
  <article class="max-w-4xl mx-auto px-6 py-12">

    <!-- Breadcrumb -->
    <nav class="mb-8 not-prose">
      <a href="/ar/cities/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        العودة إلى أدلة المدن
      </a>
    </nav>

    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🏝️ هاينان</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        دليل هاينان السياحي: جزيرة الصين الاستوائية — لا تأشيرة مطلوبة لـ 59 دولة
      </h1>
      <p class="text-xl text-gray-600 mb-6">شواطئ، غابات مطيرة، براكين، ومنتجعات عالمية — ومواطني 59 دولة يمكنهم الزيارة بدون تأشيرة لمدة تصل إلى 30 يوماً.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 آخر تحديث: {lastUpdated}</span>
        <span>⏱️ {readTime}</span>
      </div>
    </header>

    <!-- Quick Answer -->
    <div class="bg-gradient-to-r from-emerald-50 to-teal-50 border-l-4 border-emerald-500 rounded-r-2xl p-8 mb-6 not-prose">
      <h2 class="text-2xl font-bold text-emerald-900 mb-4">⚡ إجابة سريعة</h2>
      <p class="text-lg text-emerald-800 leading-relaxed"><strong>هاينان هي جنة الجزيرة الاستوائية في الصين — شواطئ، غابات مطيرة، براكين، ومنتجعات عالمية — ومواطني 59 دولة يمكنهم الزيارة بدون تأشيرة لمدة تصل إلى 30 يوماً.</strong> لا حاجة لمجموعة سياحية، لا حاجة لزيارة سفارة. سافر إلى هايكو أو سانيا بجواز سفرك وتذكرة عودة، وها أنت ذا.</p>
    </div>
    <p class="text-gray-700 mb-8">هذا أمر كبير إذا كنت من <strong>الولايات المتحدة، المكسيك، الفلبين، إندونيسيا، أو جمهورية التشيك</strong> — هذه الدول ليست في قائمة الإعفاء من التأشيرة لمدة 30 يوماً للصين القارية. (<a href="/ar/visa/visa-free/" class="text-blue-600 hover:underline">راجع قائمة الـ 59 دولة كاملة →</a>)</p>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-12">
      <div class="bg-white rounded-xl p-4 border border-gray-100 text-center">
        <p class="text-2xl mb-1">☀️</p>
        <p class="text-sm font-semibold text-gray-900">مناخ استوائي</p>
        <p class="text-xs text-gray-500">متوسط 24°م / 75°ف على مدار العام</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-100 text-center">
        <p class="text-2xl mb-1">🏖️</p>
        <p class="text-sm font-semibold text-gray-900">أفضل الشواطئ</p>
        <p class="text-xs text-gray-500">خليج يالونغ، دادونغهاي، خليج هايتانغ</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-100 text-center">
        <p class="text-2xl mb-1">🌋</p>
        <p class="text-sm font-semibold text-gray-900">منتزه بركاني</p>
        <p class="text-xs text-gray-500">جيولوجيا هايكو الفريدة</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-100 text-center">
        <p class="text-2xl mb-1">🌴</p>
        <p class="text-sm font-semibold text-gray-900">غابة مطيرة</p>
        <p class="text-xs text-gray-500">وتشيشيان، يانودا، باوانغلينغ</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-100 text-center">
        <p class="text-2xl mb-1">⛳</p>
        <p class="text-sm font-semibold text-gray-900">منتجعات غولف</p>
        <p class="text-xs text-gray-500">ملاعب عالمية المستوى</p>
      </div>
      <div class="bg-white rounded-xl p-4 border border-gray-100 text-center">
        <p class="text-2xl mb-1">🦞</p>
        <p class="text-sm font-semibold text-gray-900">مأكولات بحرية طازجة</p>
        <p class="text-xs text-gray-500">هاينان مشهورة بها</p>
      </div>
    </div>

    <!-- Which Countries Qualify -->
    <section class="mb-12">
      <h2 id="visa-free-countries" class="text-3xl font-bold text-gray-900 mb-4">ما هي الدول المؤهلة للإعفاء من تأشيرة هاينان؟</h2>
      <p class="text-gray-700 mb-4"><strong>59 دولة</strong> — معظمها نفس قائمة الإعفاء من التأشيرة للصين القارية، ولكن مع إضافات مهمة مثل <strong>الولايات المتحدة، المكسيك، الفلبين، وإندونيسيا</strong> التي ليست في قائمة الـ 30 يوماً للصين القارية.</p>
      <div class="bg-emerald-50 border-l-4 border-emerald-400 rounded-r-xl p-5 mb-4">
        <p class="text-sm text-emerald-800"><strong>💡 ملاحظة سريعة:</strong> على عكس سياسات الإعفاء من التأشيرة للصين القارية، قائمة هاينان تغطي نطاقاً أوسع (59 مقابل 50 دولة). إذا كانت دولتك ليست في <a href="/ar/visa/visa-free/" class="text-blue-600 hover:underline font-medium">قائمة الإعفاء من التأشيرة للصين القارية</a>، تحقق مما إذا كانت في قائمة هاينان — قد يكون خيارك الوحيد لدخول الصين بدون تأشيرة.</p>
      </div>
      <p class="text-sm text-gray-600">راجع <a href="/ar/visa/visa-free/" class="text-blue-600 hover:underline font-medium">تفاصيل الـ 59 دولة حسب المنطقة →</a></p>
    </section>

    <!-- When to Visit -->
    <section class="mb-12">
      <h2 id="when-to-visit" class="text-3xl font-bold text-gray-900 mb-4">متى تزور هاينان</h2>
      <div class="bg-white rounded-xl border border-gray-200 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="text-left px-5 py-3 font-semibold text-gray-700">الشهر</th>
              <th class="text-left px-5 py-3 font-semibold text-gray-700">درجة الحرارة</th>
              <th class="text-left px-5 py-3 font-semibold text-gray-700">الأمطار</th>
              <th class="text-left px-5 py-3 font-semibold text-gray-700">الحشود</th>
              <th class="text-left px-5 py-3 font-semibold text-gray-700">الحكم</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 font-medium">نوفمبر–مارس</td>
              <td class="px-5 py-3">20–28°م</td>
              <td class="px-5 py-3">منخفضة</td>
              <td class="px-5 py-3">عالية</td>
              <td class="px-5 py-3 font-semibold text-emerald-600">🌟 أفضل وقت — جاف، دافئ، طقس شاطئي مثالي</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 font-medium">أبريل–يونيو</td>
              <td class="px-5 py-3">25–32°م</td>
              <td class="px-5 py-3">متوسطة</td>
              <td class="px-5 py-3">منخفضة</td>
              <td class="px-5 py-3 text-amber-600">👍 جيد — أكثر حرارة لكن عدد أقل من السياح</td>
            </tr>
            <tr>
              <td class="px-5 py-3 font-medium">يوليو–أكتوبر</td>
              <td class="px-5 py-3">26–32°م</td>
              <td class="px-5 py-3">عالية (موسم الأعاصير)</td>
              <td class="px-5 py-3">منخفضة</td>
              <td class="px-5 py-3 text-red-600">⚠️ ممطر — رحلات رخيصة لكن تحقق من توقعات الأعاصير</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm text-gray-600"><strong>موسم الذروة السياحي:</strong> رأس السنة الصينية (يناير/فبراير) والأسبوع الذهبي للعيد الوطني (1–7 أكتوبر) — تجنب إذا استطعت.</p>
    </section>

    <!-- Why Visit -->
    <section class="mb-12">
      <h2 id="why-visit" class="text-3xl font-bold text-gray-900 mb-6">🏝️ لماذا زيارة هاينان؟</h2>
      <p class="text-lg leading-relaxed text-gray-700 mb-6">هاينان هي إجابة الصين على هاواي — جزيرة استوائية بشواطئ رملية بيضاء، غابات مطيرة خصبة، وأجواء مريحة لن تجدها في أي مكان آخر في الصين القارية. إنها الجزء الوحيد من الصين حيث يمكنك حقاً الهروب من المدينة والاسترخاء بجانب المحيط. بالإضافة إلى ذلك، مع الدخول بدون تأشيرة لـ 59 دولة، إنها أسهل نقطة دخول إلى الصين للعديد من المسافرين.</p>
    </section>

    <!-- How Many Days -->
    <section class="mb-12">
      <h2 id="how-many-days" class="text-3xl font-bold text-gray-900 mb-6">📅 كم يوماً تحتاج؟</h2>
      <ul class="list-disc pl-6 space-y-2 text-lg text-gray-700 mb-12">
        <li><strong>3–4 أيام (قياسي):</strong> شواطئ سانيا، مأكولات بحرية، ورحلة يومية إلى هايكو أو مشي في الغابة المطيرة</li>
        <li><strong>5–7 أيام (مريح):</strong> التوزيع بين سانيا وهايكو، أضف بوآو والمشي في وتشيشيان</li>
        <li><strong>7+ أيام (غوص عميق):</strong> جولة كاملة حول الجزيرة عبر القطار فائق السرعة — استكشف الساحل بأكمله</li>
      </ul>
    </section>

    <!-- Top Attractions -->
    <section class="mb-12">
      <h2 id="attractions" class="text-3xl font-bold text-gray-900 mb-6">🎯 أهم المعالم</h2>

      <h3 class="text-2xl font-bold text-gray-900 mb-4">🏖️ سانيا — حيث ينتهي المطاف بمعظم السياح</h3>
      <p class="text-gray-700 mb-6">سانيا هي عطلة الشاطئ الاستوائية الكلاسيكية — فكر في أشجار النخيل، ماء فيروزي، ومنتجعات تبدو وكأنها تستحق الإنفاق. لكن هناك أكثر من مجرد الاستلقاء بجانب المسبح.</p>

      <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/hainan/yalong-bay.webp" alt="خليج يالونغ في هاينان" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h4 class="text-xl font-bold text-gray-900 mb-2">خليج يالونغ</h4>
        <p class="text-gray-700">أفضل امتداد للشاطئ في الجزيرة — هذه ليست مبالغة، إنها مجرد حقيقة. الرمال من مسحوق المرجان الأبيض الناعم الذي تراه عادةً فقط في البطاقات البريدية، والمياه صافية بما يكفي لرؤية الأسماك من الشاطئ، والخليج بأكمله ينحني لمسافة 7 كيلومترات مع تلال خضراء في الخلفية. معظم المنتجعات تواجه الشاطئ مباشرة، لذا يمكنك الانتقال من غرفتك إلى الماء في حوالي 90 ثانية. إنه أغلى من شواطئ سانيا الأخرى، لكنك تحصل على ما تدفع مقابله.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

      <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/hainan/dadonghai-bay.webp" alt="خليج دادونغهاي في هاينان" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h4 class="text-xl font-bold text-gray-900 mb-2">خليج دادونغهاي</h4>
        <p class="text-gray-700">هنا تعيش الطاقة المحلية. دادونغهاي أقل صقلاً من يالونغ — فنادق أرخص، ضوضاء أكثر، مشاهدة ناس أفضل. الخليج ينحني بشكل هلال مع سباحة جيدة، والواجهة المائية بأكملها تصطف على جانبيها مطاعم المأكولات البحرية حيث تختار صيدك من الأحواض ويشوونها على الفور. المساء هو أفضل وقت هنا: تضاء الأضواء، تشتعل حانات الشاطئ، ويصبح المكان كله نابضاً بالحياة.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

      <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/hainan/haitang-bay.webp" alt="خليج هايتانغ في هاينان" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h4 class="text-xl font-bold text-gray-900 mb-2">خليج هايتانغ</h4>
        <p class="text-gray-700">ابن العم الأكثر هدوءاً ورقياً. خليج هايتانغ هو حيث يقع منتجع أتلانتس سانيا — فكر في حديقة مائية ضخمة، حوض أسماك يضم أكثر من 10,000 كائن بحري، ومسبح تفاعل مع الدلافين يبدو أكثر أناقة مما تتوقع. الشاطئ نفسه واسع وأقل ازدحاماً من يالونغ. إذا كنت مهتماً بالتسوق المعفي من الرسوم الجمركية، فهنا أيضاً يقع المتجر الكبير المعفي من الرسوم.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

      <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/hainan/wuzhizhou-island.webp" alt="جزيرة وتشيتشو في هاينان" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h4 class="text-xl font-bold text-gray-900 mb-2">جزيرة وتشيتشو</h4>
        <p class="text-gray-700">عبارة مدتها 20 دقيقة من الساحل توصل إلى هذه الجزيرة الصغيرة مع أفضل أماكن الغطس في هاينان. المياه حولها محمية، لذا الشعب المرجانية صحية والأسماك لا تتناثر بمجرد وضع قناعك. دخولاً وخروجاً بالقارب، يمكنك تغطية المكان بأكمله في نصف يوم. اذهب مبكراً لتسبق الحشود — العبارات تمتلئ بسرعة بحلول الساعة 10 صباحاً.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

      <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/hainan/nanshan-temple.webp" alt="معبد نانشان في هاينان" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h4 class="text-xl font-bold text-gray-900 mb-2">معبد نانشان</h4>
        <p class="text-gray-700">القطعة المركزية هي تمثال غوانيين البالغ ارتفاعه 108 أمتار واقفاً في البحر — ثلاثة أوجه، ثلاثة اتجاهات، أطول تمثال من نوعه في العالم. لكن ما يفاجئ معظم الزوار هو حجم المجمع بأكمله: قاعات، باغودا، حدائق تمتد على أفدنة من الأراضي المشذبة. إنه معبد نشط مع رهبان حقيقيين ودخان بخور حقيقي، وليس مجرد محطة سياحية متنكرة في هيئة معبد.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

      <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/hainan/yanoda-rainforest.webp" alt="يانودا الغابات المطيرة في هاينان" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h4 class="text-xl font-bold text-gray-900 mb-2">غابة يانودا المطيرة</h4>
        <p class="text-gray-700">غابة مع بعض التحسينات: جسر أرضي زجاجي معلق فوق المظلة، تيليفيري عبر الوادي، وبرك شلالات يمكنك الخوض فيها فعلاً. المشي نفسه يمكن إدارته (بضع ساعات) وهناك تنوع مدهش في الحياة النباتية — ابحث عن أشجار البانيان العملاقة. الجو يصبح رطباً بسرعة، لذا احضر ماء واذهب مبكراً.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

      <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/hainan/luhuitou-park.webp" alt="منتزه لوهويتو في هاينان" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
        <h4 class="text-xl font-bold text-gray-900 mb-2">منتزه لوهويتو</h4>
        <p class="text-gray-700">المنتزه على قمة التل مع أفضل إطلالة غروب شمس فوق سانيا. هناك أسطورة وراء الاسم: صياد طارد غزالاً إلى حافة جرف، والغزال تحول إلى امرأة جميلة (لوهويتو تعني حرفياً "الغزال يدير رأسه"). اصعد أو استقل الترام — في كلتا الحالتين تحصل على إطلالة بانورامية تجعلك تفهم لماذا كان هذا المكان مقدساً لهذه الفترة الطويلة.</p>
      </div>
      <div class="clear-both hidden md:block"></div>
    </div>

      <h3 class="text-2xl font-bold text-gray-900 mb-4">🏛️ هايكو — العاصمة المريحة</h3>
      <p class="text-gray-700 mb-6">هايكو ليست سانيا، وهذه هي النقطة. شواطئ أقل، ثقافة أكثر. سياح أقل، حياة حقيقية أكثر. إنها المكان الذي تذهب إليه عندما تريد فهم هاينان بعيداً عن كتيب المنتجع.</p>

      <div class="flex flex-col md:block bg-white border border-gray-200 rounded-2xl p-6 mb-6 overflow-hidden">
      <div class="order-2 md:float-left md:mr-8 md:mb-4 md:w-80 lg:w-96 rounded-2xl overflow-hidden">
        <img src="/images/hainan/volcanic-geopark.webp" alt="المنتزه البركاني في هاينان" class="w-full h-auto object-cover" loading="lazy" />
      </div>
      <div class="order-1">
