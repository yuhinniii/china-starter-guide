---
import Layout from '@layouts/Layout.astro';
const title = 'دليل المدن الصينية — وجهات السفر';
const description = 'اعثر على المدينة المناسبة لرحلتك إلى الصين.';
---

<Layout title={title} description={description} lang="ar">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🏙️ المدن</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">دليل المدن الصينية</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">اعثر على المدينة المناسبة لرحلتك إلى الصين.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">6</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">أدلة المدن</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">مخطط رحلات</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">3</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">مناطق مُغطاة</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">التخطيط لرحلتك</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">مقال واحد</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/cities/city-select/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🧭 تخطيط</span>
            <p class="text-base font-bold text-gray-900 mt-1">كم يوماً تحتاج في الصين؟</p>
            <p class="text-sm text-gray-600 mt-0.5">خطط لرحلتك المثالية — من 3 أيام سريعة إلى 3 أسابيع من المغامرة.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">التاريخ والثقافة</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">مقال واحد</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/cities/beijing-guide/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🏛️ بكين</span>
            <p class="text-base font-bold text-gray-900 mt-1">دليل بكين السياحي: ما تراه، ما تأكله، وما تحتاج معرفته</p>
            <p class="text-sm text-gray-600 mt-0.5">المدينة المحرمة، سور الصين العظيم، الأزقة القديمة، بط بكين، ونصائح أساسية.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">الحديث والحضري</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">مقالان</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/cities/shanghai-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🌆 شنغهاي</span>
            <p class="text-base font-bold text-gray-900 mt-1">دليل شنغهاي السياحي: المدينة الأكثر ترحيباً بالأجانب</p>
            <p class="text-sm text-gray-600 mt-0.5">الواجهة البحرية، برج شنغهاي، الحي الفرنسي، ومطاعم عالمية المستوى.</p>
          </a>
          <a href="/ar/cities/shenzhen-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🏙️ شنتشن</span>
            <p class="text-base font-bold text-gray-900 mt-1">دليل شنتشن السياحي: مركز التكنولوجيا بجوار هونغ كونغ</p>
            <p class="text-sm text-gray-600 mt-0.5">وادي السيليكون الصيني، ركوب الدراجات على الساحل، و15 دقيقة بالقطار إلى هونغ كونغ.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">الطبيعة والمناظر</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">مقال واحد</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/cities/hainan-visa-free/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🏝️ هاينان</span>
            <p class="text-base font-bold text-gray-900 mt-1">دليل هاينان السياحي — 30 يوماً بدون تأشيرة</p>
            <p class="text-sm text-gray-600 mt-0.5">شواطئ استوائية، غابات مطيرة، ودخول بدون تأشيرة لـ 59 دولة.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-orange-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-orange-800">الطعام وأسلوب الحياة</h2>
          <span class="text-xs font-medium text-orange-800 opacity-60">مقالان</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/cities/guangzhou-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🥟 قوانغتشو</span>
            <p class="text-base font-bold text-gray-900 mt-1">دليل قوانغتشو السياحي: عاصمة الطعام في الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">الديم سام، برج كانتون، جزيرة شاميان، وبوابة جنوب الصين.</p>
          </a>
          <a href="/ar/cities/chengdu-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🐼 تشنغدو</span>
            <p class="text-base font-bold text-gray-900 mt-1">دليل تشنغدو السياحي: الباندا، الطعام الحار، والحياة البطيئة</p>
            <p class="text-sm text-gray-600 mt-0.5">الباندا العملاقة، الهوت بوت السيتشواني، بيوت الشاي، وبوابة جيوتشايغو.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">أدلة ذات صلة</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/ar/transport/high-speed-rail/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">القطار فائق السرعة</p>
          <p class="text-sm text-gray-500">التنقل بين المدن</p>
        </a>
        <a href="/ar/transport/metro-bus/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">المترو والحافلات</p>
          <p class="text-sm text-gray-500">التجول في وسط المدن</p>
        </a>
      </div>
    </div>
  </section>
</Layout>