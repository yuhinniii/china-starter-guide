---
import Layout from '@layouts/Layout.astro';
const title = 'اتصل بنا — China Starter Hub';
const description = 'تخطط لرحلة إلى الصين أو وصلت بالفعل وعلقت في مشكلة؟ نساعد المسافرين المستقلين في كل خطوة — المسار والفنادق وغيرها.';
---

<Layout title={title} description={description} lang="ar">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">💬 اتصل بنا</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">اتصل بنا</h1>
      <p class="text-lg text-gray-500">تخطط لرحلة إلى الصين، أو وصلت بالفعل وعلقت في مشكلة؟ نحن مساعد شامل للمسافرين المستقلين.</p>
    </header>

    <div class="space-y-8 pb-16">
      <section class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">ما الذي يمكننا مساعدتك فيه</h2>
        <ul class="space-y-3 text-lg text-gray-700">
          <li>✅ تخطيط مسار رحلتك واختيار فنادق تناسب ميزانيتك</li>
          <li>✅ حل استفسارات التأشيرة والدفع والنقل وتذاكر المعالم</li>
          <li>✅ مساعدتك عن بُعد بعد وصولك إلى الصين</li>
          <li>✅ الإجابة عن أي سؤال عن السفر إلى الصين: الطعام والإنترنت والسلامة وآداب التعامل وغيرها</li>
        </ul>
      </section>

      <section class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-2">🎁 مطابقة فندقية مجانية</h2>
        <p class="text-lg text-gray-700 mb-3">أخبرنا بالمنطقة وميزانيتك الليلية — سنقارن لك <strong>فندقين</strong> مجانًا.</p>
        <ol class="text-sm text-gray-700 list-decimal pr-5 mb-4 space-y-1">
          <li>المدينة أو المنطقة</li>
          <li>الميزانية الليلية</li>
          <li>تاريخ الوصول</li>
          <li>عدد النزلاء</li>
        </ol>
        <a href="mailto:hello@chinastarterhub.com?subject=Hotel%20help&amp;body=%D9%85%D8%B1%D8%AD%D8%A8%D9%8B%D8%A7%20China%20Starter%20Hub%D8%8C%0A%0A%D8%A3%D8%B1%D8%BA%D8%A8%20%D9%81%D9%8A%20%D8%A7%D9%84%D8%AD%D8%B5%D9%88%D9%84%20%D8%B9%D9%84%D9%89%20%D9%85%D8%B7%D8%A7%D8%A8%D9%82%D8%A9%20%D9%81%D9%86%D8%AF%D9%82%D9%8A%D8%A9%20%D9%85%D8%AC%D8%A7%D9%86%D9%8A%D8%A9.%20%D9%87%D8%B0%D9%87%20%D8%A8%D9%8A%D8%A7%D9%86%D8%A7%D8%AA%D9%8A%3A%0A%0A1.%20%D8%A7%D9%84%D9%85%D8%AF%D9%8A%D9%86%D8%A9%20%D8%A3%D9%88%20%D8%A7%D9%84%D9%85%D9%86%D8%B7%D9%82%D8%A9%3A%0A2.%20%D8%A7%D9%84%D9%85%D9%8A%D8%B2%D8%A7%D9%86%D9%8A%D8%A9%20%D8%A7%D9%84%D9%84%D9%8A%D9%84%D9%8A%D8%A9%3A%0A3.%20%D8%AA%D8%A7%D8%B1%D9%8A%D8%AE%20%D8%A7%D9%84%D9%88%D8%B5%D9%88%D9%84%3A%0A4.%20%D8%B9%D8%AF%D8%AF%20%D8%A7%D9%84%D9%86%D8%B2%D9%84%D8%A7%D8%A1%3A%0A%0A%D8%B4%D9%83%D8%B1%D9%8B%D8%A7%20%D9%84%D9%83%D9%85%21" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-brand-600 text-white rounded-xl text-base font-semibold hover:opacity-90 transition no-underline">
          📧 راسلنا (الموضوع «Hotel help» جاهز)
        </a>
      </section>

      <section class="bg-gray-50 border border-gray-100 rounded-2xl p-6 md:p-8 text-center">
        <h2 class="text-xl font-bold text-gray-900 mb-4">تواصل معنا</h2>
        <p class="text-lg text-gray-700">راسلنا على <a href="mailto:hello@chinastarterhub.com" class="text-brand-600 font-medium hover:underline">hello@chinastarterhub.com</a></p>
        <p class="text-sm text-gray-500 mt-2">نرد عادة خلال 1–2 يوم عمل.</p>
      </section>

      <section class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">أسئلة سريعة</h2>
        <div class="space-y-4">
          <details class="group border border-gray-200 rounded-xl p-4">
            <summary class="font-semibold text-gray-900 cursor-pointer">هل يمكنكم المساعدة في تخطيط الطريق واختيار الفنادق؟</summary>
            <p class="text-gray-700 mt-2">نعم — أخبرنا بالتواريخ والوجهات والميزانية وسنضع الخطة.</p>
          </details>
          <details class="group border border-gray-200 rounded-xl p-4">
            <summary class="font-semibold text-gray-900 cursor-pointer">هل أنتم وكالة سفر؟</summary>
            <p class="text-gray-700 mt-2">لا — نحن مساعد للمسافرين المستقلين، نقدم المساعدة حسب الحاجة دون باقات جاهزة.</p>
          </details>
          <details class="group border border-gray-200 rounded-xl p-4">
            <summary class="font-semibold text-gray-900 cursor-pointer">أين مقركم؟</summary>
            <p class="text-gray-700 mt-2">نعمل عن بُعد، لذا يمكننا مساعدتك في أي مكان في الصين.</p>
          </details>
        </div>
      </section>
    </div>
  </article>
</Layout>
