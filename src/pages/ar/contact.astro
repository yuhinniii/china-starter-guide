---
import Layout from '@layouts/Layout.astro';
const title = 'اتصل بنا — China Starter Hub';
const description = 'هل لديك أسئلة أو ملاحظات؟ يسعدنا سماع رأيك.';
---

<Layout title={title} description={description} lang="ar">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">اتصل بنا</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">اتصل بنا</h1>
      <p class="text-gray-500  ">هل لديك أسئلة أو ملاحظات؟ يسعدنا سماع رأيك.</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4 text-center">
        <p class="text-gray-700 text-lg">راسلنا عبر البريد الإلكتروني: <a href="mailto:hello@chinastarterhub.com" class="text-brand-600 font-medium hover:underline">hello@chinastarterhub.com</a></p>
      </div>
    </div>
  </article>
</Layout>
