  <script is:inline>
    const countrySelect = document.getElementById('visa-country');
    const resultDiv = document.getElementById('visa-result');

    // Source: China gov.cn official list (2025)
    // Category 1: Unilateral visa-free (30 days) - 50 countries
    const visaFree = ['BN','FR','DE','IT','ES','NL','CH','IE','HU','AT','BE','LU','NZ','AU','PL','PT','GR','CY','SI','SK','NO','FI','DK','IS','AD','MC','LI','KR','BG','RO','HR','ME','MK','MT','EE','LV','JP','BR','AR','CL','PE','UY','SA','OM','KW','BH','CA','RU','GB','SE'];

    // Category 2: Mutual visa agreement (ordinary passport) - 29 countries
    const mutualFree = ['AL','AE','AG','BB','BS','BY','BA','DM','EC','FJ','GD','GE','KZ','QA','MV','MU','WS','RS','SC','SM','SR','SB','TH','TO','UZ','SG','AM','AZ','MY'];

    // Category 3: 240-hour transit - 55 countries
    const transit240 = ['AL','AT','BE','BG','BA','BR','CA','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LT','LU','MT','MC','ME','NL','MK','NO','PL','PT','RO','RU','RS','SK','SI','KR','ES','SE','CH','UA','GB','US','AU','NZ','JP','SG','BN','AE','QA','MX','AR','CL','ID','BY'];

    // Determine best visa status for each country
    function getVisaStatus(code) {
      if (visaFree.includes(code)) return 'visa-free-30';
      if (mutualFree.includes(code)) return 'mutual-free';
      if (transit240.includes(code)) return 'transit';
      return 'need-visa';
    }

    const countryNames = {
      'AL':'ألبانيا','AD':'أندورا','AG':'أنتيغوا وباربودا','AR':'الأرجنتين','AM':'أرمينيا',
      'AU':'أستراليا','AT':'النمسا','AZ':'أذربيجان','BS':'جزر البهاما','BH':'البحرين','BB':'بربادوس',
      'BY':'بيلاروسيا','BE':'بلجيكا','BA':'البوسنة والهرسك','BR':'البرازيل','BN':'بروناي','BG':'بلغاريا',
      'CA':'كندا','CL':'تشيلي','HR':'كرواتيا','CY':'قبرص','CZ':'جمهورية التشيك','DK':'الدنمارك',
      'DM':'دومينيكا','EC':'الإكوادور','EG':'مصر','EE':'إستونيا','FJ':'فيجي','FI':'فنلندا','FR':'فرنسا',
      'GE':'جورجيا','DE':'ألمانيا','GR':'اليونان','GD':'غرينادا','HU':'المجر',      'IS':'آيسلندا','IE':'أيرلندا','IN':'الهند','ID':'إندونيسيا','IT':'إيطاليا',
      'JP':'اليابان','KZ':'كازاخستان','KE':'كينيا','KW':'الكويت','LV':'لاتفيا','LI':'ليختنشتاين',
      'LT':'ليتوانيا','LU':'لوكسمبورغ','MY':'ماليزيا','MV':'جزر المالديف','MT':'مالطا','MU':'موريشيوس',
      'MX':'المكسيك',
      'MC':'موناكو','ME':'الجبل الأسود',      'NL':'هولندا','NZ':'نيوزيلندا','NG':'نيجيريا','MK':'مقدونيا الشمالية',
      'NO':'النرويج','OM':'عُمان','PK':'باكستان','PE':'بيرو','PH':'الفلبين','PL':'بولندا','PT':'البرتغال','QA':'قطر','RO':'رومانيا',
      'RU':'روسيا','WS':'ساموا','SM':'سان مارينو','SA':'المملكة العربية السعودية','RS':'صربيا','SC':'سيشل',
      'SG':'سنغافورة','SK':'سلوفاكيا','SI':'سلوفينيا','SB':'جزر سليمان','ZA':'جنوب إفريقيا','KR':'كوريا الجنوبية',
      'ES':'إسبانيا','SR':'سورينام','SE':'السويد','CH':'سويسرا','TH':'تايلاند','TO':'تونغا','TR':'تركيا',
      'UA':'أوكرانيا',
      'AE':'الإمارات العربية المتحدة','GB':'المملكة المتحدة','US':'الولايات المتحدة الأمريكية','UY':'الأوروغواي','UZ':'أوزبكستان','VN':'فيتنام'
    };

    countrySelect.addEventListener('change', function() {
      const val = this.value;
      if (!val) {
        resultDiv.innerHTML = '';
        return;
      }

      const name = countryNames[val] || 'بلدك';
      const status = getVisaStatus(val);

      if (status === 'visa-free-30') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">أخبار سارة! يمكن لمواطني ' + name + ' دخول الصين <span class="underline">بدون تأشيرة</span> لمدة تصل إلى 30 يوماً.</p><p class="text-green-700 text-sm mb-3">لا حاجة لتأشيرة للسياحة أو الأعمال أو العبور لأقل من 30 يوماً.</p><a href="/ar/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">اطلع على القائمة الكاملة للدول المعفاة ←</a></div>';
      } else if (status === 'mutual-free') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">يمكن لمواطني ' + name + ' دخول الصين <span class="underline">بدون تأشيرة</span> بموجب اتفاقية متبادلة.</p><p class="text-green-700 text-sm mb-3">تحقق من نوع جواز سفرك ومدة الإقامة المسموح بها قبل السفر.</p><a href="/ar/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">اطلع على قائمة الدول المعفاة ←</a></div>';
      } else if (status === 'transit') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-blue-50 border border-blue-200"><p class="text-blue-800 font-semibold mb-1">يمكنك استخدام سياسة <span class="underline">العبور 240 ساعة</span>.</p><p class="text-blue-700 text-sm mb-3">يمكن لمواطني ' + name + ' العبور عبر الصين لمدة تصل إلى 10 أيام بدون تأشيرة. للإقامات الأطول، ستحتاج إلى تأشيرة L.</p><div class="flex flex-wrap gap-3"><a href="/ar/visa/transit-240/" class="text-sm font-medium text-blue-700 underline hover:no-underline">كيف تعمل سياسة العبور ←</a><a href="/ar/visa/apply-l-visa/" class="text-sm font-medium text-blue-700 underline hover:no-underline">تقديم طلب تأشيرة L ←</a></div></div>';
      } else {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-orange-50 border border-orange-200"><p class="text-orange-800 font-semibold mb-1">ستحتاج إلى تأشيرة.</p><p class="text-orange-700 text-sm mb-3">يحتاج مواطنو ' + name + ' إلى تقديم طلب للحصول على تأشيرة سياحية (نوع L) قبل السفر إلى الصين.</p><a href="/ar/visa/apply-l-visa/" class="inline-block text-sm font-medium text-orange-700 underline hover:no-underline">كيفية التقديم على تأشيرة L ←</a></div>';
      }
    });
