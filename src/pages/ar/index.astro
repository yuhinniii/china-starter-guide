---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Hub — دليلك الكامل إلى الصين';
const description = 'كل ما تحتاج معرفته قبل السفر إلى الصين: الدفع، النقل، التطبيقات، المدن، ونصائح السفر.';
---

<Layout title={title} description={description} lang="ar">
  <!-- Trigger rebuild: 2026-06-12 17:30 -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900">
      سافر إلى الصين بثقة —<br/><span class="text-brand-600">أدلة خطوة بخطوة من التأشيرة إلى الدفع إلى التنقل</span>
    </h1>
    <div class="flex flex-wrap justify-center gap-4 mt-10">
      <a href="/ar/visa/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">ابدأ الآن</a>
      <a href="/ar/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">عن هذا الموقع</a>
    </div>
  </section>  <!-- Section: Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/ar/visa/', title: 'التأشيرة', desc: 'أنواع التأشيرات، الدول المعفاة، سياسة العبور.' },
        { href: '/ar/payment/', title: 'الدفع', desc: 'المحافظ الإلكترونية، البطاقات المصرفية، النقود الاحتياطية.' },
        { href: '/ar/transport/', title: 'النقل', desc: 'القطار فائق السرعة، المترو، طلب المركبات، والوصول من المطار إلى المدينة.' },
        { href: '/ar/life/', title: 'الحياة في الصين', desc: 'التطبيقات، الرعاية الطبية، نصائح السلامة، الحياة اليومية.' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  group-hover:text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

<!-- Interactive Pre-Departure Checklist -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">قائمة رحلتك إلى الصين</h2>
    <p class="text-gray-500 mb-4">من شهر قبل المغادرة إلى اليوم الأول — حدد كل عنصر وأنت تمضي.</p>

    <!-- Time Filter -->
    <div id="checklist-filter" class="flex flex-wrap gap-2 mb-5">
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-brand-50 text-brand-700 text-sm font-medium cursor-pointer transition hover:border-brand-300 active" data-show="all">جميع المراحل</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="1">قبل شهر</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="2">قبل أسبوعين</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="3">قبل أسبوع</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="4,5">عند الوصول</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="6">اليوم الأول</button>
    </div>

    <!-- Overall Progress -->
    <div id="checklist-progress" class="bg-gray-50 rounded-2xl p-5 mb-10">
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-sm font-semibold text-gray-700">التقدم العام</span>
        <span id="progress-text" data-suffix="مكتمل" class="text-base font-bold text-brand-600">0 من 23 مكتمل</span>
      </div>
      <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width:0%"></div>
      </div>
    </div>

    <div class="space-y-8">

      <!-- Stage 1: T-30 يوم · قبل شهر من المغادرة -->
      <div class="relative pl-12 stage-group" data-stage="1">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-xs font-bold text-green-700">1</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-green-700">T-30 يوم</span> · قبل شهر من السفر
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="1">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="1">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-passport">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">01</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">التحقق من صلاحية جواز السفر</p>
              <p class="text-sm text-gray-500 mt-0.5">تتطلب دول كثيرة أن تكون صلاحية الجواز 6 أشهر بعد تواريخ سفرك للحصول على التأشيرة الصينية. تحقق قبل المغادرة.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-visa">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">02</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">تأكيد نوع التأشيرة أو الإعفاء</p>
              <p class="text-sm text-gray-500 mt-0.5">هل تحتاج تأشيرة؟ هل أنت مؤهل لعبور 240 ساعة؟ أداة الفحص أعلاه تجيبك في 30 ثانية.</p>
            </div>
            <a href="/ar/visa/visa-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ دليل →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="travel-insurance">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">03</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">شراء تأمين سفر مع تغطية طبية</p>
              <p class="text-sm text-gray-500 mt-0.5">المستشفيات الصينية تتطلب الدفع المسبق. يُوصى بتأمين طبي لا يقل عن 100,000 دولار مع الإخلاء الطارئ.</p>
            </div>
            <a href="/ar/life/travel-insurance/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ دليل →</a>
          </div>
        </div>
      </div>

      <!-- Stage 2: T-15 يوم · قبل أسبوعين -->
      <div class="relative pl-12 stage-group" data-stage="2">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-xs font-bold text-blue-700">2</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-blue-700">T-15 يوم</span> · قبل أسبوعين
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="2">0/6 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="2">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="buy-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">04</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">شراء اشتراك VPN وتثبيته</p>
              <p class="text-sm text-gray-500 mt-0.5">لا يمكن تنزيل VPN من داخل الصين — المواقع محجوبة. ثبّته واختبره من المنزل قبل المغادرة.</p>
            </div>
            <a href="/ar/life/vpn-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ دليل →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="buy-esim">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">05</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">شراء eSIM</p>
              <p class="text-sm text-gray-500 mt-0.5">اختر eSIM يغطي الصين، الأفضل عبر هونغ كونغ. ثبّته قبل المغادرة.</p>
            </div>
            <a href="/ar/life/sim-card-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ دليل →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="setup-alipay">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">06</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">إعداد Alipay وربط بطاقاتك</p>
              <p class="text-sm text-gray-500 mt-0.5">اربط بطاقة ائتمان وخصم. رموز QR الشخصية لا تقبل الائتمان، لكن الخصم يعمل.</p>
            </div>
            <a href="/ar/payment/payment-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ دليل →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="setup-wechat">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">07</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">إعداد WeChat Pay (احتياطي اختياري)</p>
              <p class="text-sm text-gray-500 mt-0.5">Alipay يغطي 95%، لكن مطاعم صغيرة تستخدم WeChat فقط. اضبطه كاحتياطي.</p>
            </div>
            <a href="/ar/payment/setup-wechat/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ دليل →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="book-hotel">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">08</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">حجز فندق يمكنه تسجيل النزلاء الأجانب</p>
              <p class="text-sm text-gray-500 mt-0.5">ليست كل الفنادق تقبل جوازات الأجانب. احجز عبر Trip.com مع تقييمات إيجابية من الأجانب.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="notify-bank">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">09</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">إبلاغ بنكك أنك مسافر إلى الصين</p>
              <p class="text-sm text-gray-500 mt-0.5">بعض البنوك تحظر معاملات الصين كاحتيال. حدد إشعار السفر بالتطبيق أو اتصل — 5 دقائق توفر صداعاً.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 3: T-7 أيام · قبل المغادرة -->
      <div class="relative pl-12 stage-group" data-stage="3">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-xs font-bold text-indigo-700">3</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-indigo-700">T-7 أيام</span> · قبل المغادرة
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="3">0/4 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="3">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="test-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">10</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">اختبار VPN على كل جهاز</p>
              <p class="text-sm text-gray-500 mt-0.5">تأكد من الاتصال على هاتفك ولابتوبك وجهازك اللوحي. افعل ذلك من المنزل — داخل الصين مواقع VPN محجوبة أيضاً.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="install-apps">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">11</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">تثبيت التطبيقات الأساسية للسفر إلى الصين</p>
              <p class="text-sm text-gray-500 mt-0.5">Baidu Maps، Didi، Trip.com. حمّلها الآن قبل أن يتم تقييد متجر التطبيقات.</p>
            </div>
            <a href="/ar/life/essential-apps/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ دليل →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="learn-chinese">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">12</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">تعلم 10 عبارات صينية أساسية</p>
              <p class="text-sm text-gray-500 mt-0.5">قدرتك على قول "شكراً" و"كم السعر" تغير معاملة الناس لك. ابدأ بالأساسيات.</p>
            </div>
            <a href="/ar/life/chinese-phrases/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ دليل →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="backup-docs">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">13</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">حفظ نسخ رقمية من جواز السفر والتأشيرة والتأمين</p>
              <p class="text-sm text-gray-500 mt-0.5">احفظ صوراً أو مسحاً ضوئياً في هاتفك وسحابتك. إذا فقدت المستندات، النسخ الاحتياطية هي ملاذك الوحيد.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 4: T-24 ساعة · التحضير النهائي -->
      <div class="relative pl-12 stage-group" data-stage="4">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-xs font-bold text-amber-700">4</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-amber-700">T-24 ساعة</span> · التحضير النهائي
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="4">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="4">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-in">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">16</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">تسجيل الوصول عبر الإنترنت وتأكيد حالة الرحلة</p>
              <p class="text-sm text-gray-500 mt-0.5">اختر مقعدك مبكراً وتحقق من تغييرات البوابة أو التأخير. لا تتركه لآخر لحظة.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="withdraw-cash">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">15</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">سحب 500-1000 يوان نقداً</p>
              <p class="text-sm text-gray-500 mt-0.5">الصين 95% غير نقدية، لكن تطبيق الدفع سيفشل مرة على الأقل. النقود هي احتياطك للطوارئ لسائق التاكسي والباعة والأكواد المعطلة.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="power-bank">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">16</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">وضع باور بانك ومحول السفر في حقيبة اليد</p>
              <p class="text-sm text-gray-500 mt-0.5">ستحتاج هاتفك لكل شيء: الخرائط، الدفع، الترجمة. أبقِه مشحوناً أثناء الرحلة وبعد الوصول.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 5: عند الوصول · أول ساعتين -->
      <div class="relative pl-12 stage-group" data-stage="5">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-xs font-bold text-teal-700">5</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-teal-700">عند الوصول</span> · أول ساعتين
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="5">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="5">
