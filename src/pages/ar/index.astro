---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Hub — دليلك الكامل إلى الصين';
const description = 'كل ما تحتاج معرفته قبل السفر إلى الصين: الدفع، النقل، التطبيقات، المدن، ونصائح السفر.';
---

<Layout title={title} description={description} lang="ar">
  <!-- Trigger rebuild: 2026-06-12 17:30 -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900  ">
      إرشادات واضحة وحديثة<br/><span class="text-brand-600">للمسافرين الأجانب لأول مرة إلى الصين</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-500  ">
      ابدأ بالأساسيات، ثم اتبع الأدلة التي تناسب رحلتك.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/ar/visa/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">ابدأ الآن</a>
      <a href="/ar/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">عن هذا الموقع</a>
    </div>
  </section>

  <!-- Section: Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/ar/visa/', title: 'التأشيرة', desc: 'أنواع التأشيرات، الدول المعفاة، سياسة العبور.' },
        { href: '/ar/payment/', title: 'الدفع', desc: 'المحافظ الإلكترونية، البطاقات المصرفية، النقود الاحتياطية.' },
        { href: '/ar/transport/', title: 'النقل', desc: 'القطار فائق السرعة، المترو، طلب المركبات، والوصول من المطار إلى المدينة.' },
        { href: '/ar/life/', title: 'الحياة في الصين', desc: 'التطبيقات، الرعاية الطبية، نصائح السلامة، الحياة اليومية.' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  :text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Your Trip: Step by Step -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">رحلتك، خطوة بخطوة</h2>
    <p class="text-gray-500 mb-10">اتبع مرحلتك — كل منها يوصلك إلى الأدلة التي ستحتاجها فعلاً.</p>

    <div class="space-y-8">
      <!-- Stage 1 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-green-100 flex items-center justify-center text-sm font-bold text-green-700">1</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">قبل السفر</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/ar/visa/visa-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">تجهيز</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">ما التأشيرة التي تحتاجها؟</p>
          </a>
          <a href="/ar/payment/payment-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">الدفع</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">كيف تدفع في الصين</p>
          </a>
          <a href="/ar/life/survival-kit/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">الحياة</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">قائمة التجهيز قبل المغادرة</p>
          </a>
        </div>
      </div>

      <!-- Stage 2 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-sm font-bold text-blue-700">2</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">بمجرد الوصول</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/ar/transport/airport-to-city/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">النقل</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">الوصول من المطار إلى المدينة</p>
          </a>
          <a href="/ar/life/sim-card-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">الحياة</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">بطاقة SIM وإعداد الإنترنت</p>
          </a>
          <a href="/ar/life/vpn-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">الحياة</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">إعداد VPN</p>
          </a>
        </div>
      </div>

      <!-- Stage 3 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-purple-100 flex items-center justify-center text-sm font-bold text-purple-700">3</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">أثناء رحلتك</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/ar/transport/transport-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">النقل</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">التنقل في الصين</p>
          </a>
          <a href="/ar/life/essential-apps/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">الحياة</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">10 تطبيقات أساسية</p>
          </a>
          <a href="/ar/life/chinese-phrases/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">الحياة</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">عبارات صينية أساسية</p>
          </a>
        </div>
      </div>

      <!-- Stage 4 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-red-100 flex items-center justify-center text-sm font-bold text-red-700">4</div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">هل تحتاج مساعدة؟</h3>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <a href="/ar/life/seeing-a-doctor/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">الحياة</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">زيارة الطبيب</p>
          </a>
          <a href="/ar/life/common-scams/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">الحياة</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">تجنب الاحتيال الشائع</p>
          </a>
          <a href="/ar/life/emergency-numbers/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">الحياة</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">أرقام الطوارئ</p>
          </a>
          <a href="/ar/payment/payment-fails/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">الدفع</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">عند فشل الدفع</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visa Checker Tool -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="border-t border-gray-100 pt-12">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">التحقق من التأشيرة</h2>
        <p class="text-gray-500 text-center mb-8">لست متأكداً مما إذا كنت بحاجة إلى تأشيرة؟ اختر جنسيتك وسنخبرك.</p>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <label for="visa-country" class="block text-sm font-medium text-gray-700 mb-2">جنسيتك</label>
          <select id="visa-country" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 text-base appearance-none cursor-pointer">
