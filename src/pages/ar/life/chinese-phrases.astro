---
import Layout from '@layouts/Layout.astro';
const title = "عبارات صينية أساسية للمسافرين";
const description = "تعلم هذه العبارات الصينية الأساسية قبل رحلتك — النطق، متى تستخدمها، ونصائح لتكون مفهوماً.";
---

<Layout title={title} description={description} lang="ar">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/ar/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        العودة إلى الحياة
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🗣️ الحياة في الصين</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        عبارات صينية أساسية للمسافرين
      </h1>
      <p class="text-xl text-gray-600 mb-6">اثنتا عشرة عبارة ستغير طريقة تعامل الناس معك.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 آخر تحديث: يونيو 2026</span>
        <span>⏱️ 4 دقائق</span>
      </div>
    </header>

        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 إجابة سريعة</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        لست بحاجة للتحدث بالصينية للسفر في الصين. لكن تعلم اثنتي عشرة عبارة سيجعل رحلتك أفضل بكثير — السكان المحليون يقدرون المجهود حقاً، وستجد نفسك تحصل على خدمة أفضل، وابتسامات أدفأ، وحتى أسعاراً أفضل في الأسواق.
      </p>
    </div>

        <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 في هذا الدليل</h3>
      <ul class="space-y-3">
        <li><a href="#greetings" class="text-blue-600 hover:underline">👋 التحيات والمجاملة</a></li>
        <li><a href="#eating" class="text-blue-600 hover:underline">🍽️ الأكل والطلب</a></li>
        <li><a href="#shopping" class="text-blue-600 hover:underline">🛍️ التسوق والأسعار</a></li>
        <li><a href="#getting-around" class="text-blue-600 hover:underline">🚇 التنقل</a></li>
        <li><a href="#emergencies" class="text-blue-600 hover:underline">🆘 الطوارئ</a></li>
        <li><a href="#pronunciation" class="text-blue-600 hover:underline">🎵 نصائح النطق</a></li>
      </ul>
    </nav>

    <div class="prose prose-lg max-w-none">
      <hr class="border-gray-200 my-12" />

            <h2 id="greetings" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">👋</span> التحيات والمجاملة
      </h2>

      <div class="overflow-x-auto mb-6 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">الإنجليزية</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">Pinyin</th>
              <th class="px-6 py-4 font-bold">ملاحظات</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Hello</td><td class="px-6 py-4">你好</td><td class="px-6 py-4">Nǐ hǎo</td><td class="px-6 py-4">استخدم مع أي شخص، في أي وقت</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Thank you</td><td class="px-6 py-4">谢谢</td><td class="px-6 py-4">Xiè xiè</td><td class="px-6 py-4">قلها كثيراً — الناس يلاحظون</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Sorry / Excuse me</td><td class="px-6 py-4">对不起</td><td class="px-6 py-4">Duì bù qǐ</td><td class="px-6 py-4">إذا اصطدمت بشخص ما</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">It's okay</td><td class="px-6 py-4">没关系</td><td class="px-6 py-4">Méi guān xì</td><td class="px-6 py-4">رد على "آسف"</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Goodbye</td><td class="px-6 py-4">再见</td><td class="px-6 py-4">Zài jiàn</td><td class="px-6 py-4">وداع معتاد</td></tr>
          </tbody>
        </table>
      </div>

      <p class="text-lg leading-relaxed text-gray-700 mb-12"><strong>نصيحة:</strong> قل "شكراً" بعد كل معاملة — في المطاعم والمتاجر وسيارات الأجرة. لها أثر كبير في التفاعلات اليومية.</p>

      <hr class="border-gray-200 my-12" />

            <h2 id="eating" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🍽️</span> الأكل والطلب
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">الإنجليزية</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">Pinyin</th>
              <th class="px-6 py-4 font-bold">ملاحظات</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Check, please</td><td class="px-6 py-4">买单</td><td class="px-6 py-4">Mǎi dān</td><td class="px-6 py-4">أشر بيدك قليلاً</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Delicious!</td><td class="px-6 py-4">好吃！</td><td class="px-6 py-4">Hǎo chī!</td><td class="px-6 py-4">امدح الطباخ</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">No spicy</td><td class="px-6 py-4">不加辣</td><td class="px-6 py-4">Bù jiā là</td><td class="px-6 py-4">ضروري في سيشوان/هونان</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Water, please</td><td class="px-6 py-4">请给我水</td><td class="px-6 py-4">Qǐng gěi wǒ shuǐ</td><td class="px-6 py-4">لا تشرب ماء الصنبور</td></tr>
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="shopping" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🛍️</span> التسوق والأسعار
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">الإنجليزية</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">Pinyin</th>
              <th class="px-6 py-4 font-bold">ملاحظات</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">How much?</td><td class="px-6 py-4">多少钱？</td><td class="px-6 py-4">Duō shǎo qián?</td><td class="px-6 py-4">سؤال السعر العام</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Too expensive</td><td class="px-6 py-4">太贵了</td><td class="px-6 py-4">Tài guì le</td><td class="px-6 py-4">فقط في الأسواق</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Can you lower it?</td><td class="px-6 py-4">便宜一点？</td><td class="px-6 py-4">Pián yí yì diǎn?</td><td class="px-6 py-4">استخدم في الأسواق، ليس المتاجر</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">I'll take it</td><td class="px-6 py-4">我要这个</td><td class="px-6 py-4">Wǒ yào zhè ge</td><td class="px-6 py-4">عندما تقرر</td></tr>
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="getting-around" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🚇</span> التنقل
      </h2>

      <div class="overflow-x-auto mb-6 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">الإنجليزية</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">Pinyin</th>
              <th class="px-6 py-4 font-bold">ملاحظات</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Where is...?</td><td class="px-6 py-4">...在哪里？</td><td class="px-6 py-4">...zài nǎ lǐ?</td><td class="px-6 py-4">أظهر اسم المكان بالصينية</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">I'm going here</td><td class="px-6 py-4">去这里</td><td class="px-6 py-4">Qù zhè lǐ</td><td class="px-6 py-4">أظهر العنوان للسائق</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Stop here</td><td class="px-6 py-4">这里停</td><td class="px-6 py-4">Zhè lǐ tíng</td><td class="px-6 py-4">لسيارات الأجرة</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">How long?</td><td class="px-6 py-4">多久？</td><td class="px-6 py-4">Duō jiǔ?</td><td class="px-6 py-4">وقت السفر أو الانتظار</td></tr>
          </tbody>
        </table>
      </div>

      <p class="text-lg leading-relaxed text-gray-700 mb-12"><strong>نصيحة احترافية:</strong> أظهر وجهتك دائماً بالأحرف الصينية.</p>

      <hr class="border-gray-200 my-12" />

            <h2 id="emergencies" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🆘</span> الطوارئ
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">الإنجليزية</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">Pinyin</th>
              <th class="px-6 py-4 font-bold">ملاحظات</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Help!</td><td class="px-6 py-4">救命！</td><td class="px-6 py-4">Jiù mìng!</td><td class="px-6 py-4">فقط للطوارئ الحقيقية</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Call the police</td><td class="px-6 py-4">报警</td><td class="px-6 py-4">Bào jǐng</td><td class="px-6 py-4">رقم الطوارئ: 110</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">I need a doctor</td><td class="px-6 py-4">我需要医生</td><td class="px-6 py-4">Wǒ xū yào yī shēng</td><td class="px-6 py-4">رقم الطوارئ: 120</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">I'm lost</td><td class="px-6 py-4">我迷路了</td><td class="px-6 py-4">Wǒ mí lù le</td><td class="px-6 py-4">أظهر وجهتك بالصينية</td></tr>
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="pronunciation" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🎵</span> نصائح النطق
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">اللغة الصينية تستخدم <strong>النغمات</strong> — نفس المقطع بنطق مختلف يعني أشياء مختلفة. لكن لا تقلق كثيراً. السياق عادةً ما يوضح معناك، والسكان المحليون متسامحون مع السياح.</p>

      <p class="text-lg font-bold text-gray-900 mb-4">النغمات الأربع:</p>

      <div class="overflow-x-auto mb-6 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">النغمة</th>
              <th class="px-6 py-4 font-bold">مثال</th>
              <th class="px-6 py-4 font-bold">المعنى</th>
              <th class="px-6 py-4 font-bold">الوصف</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">1st</td><td class="px-6 py-4">mā (妈)</td><td class="px-6 py-4">أم</td><td class="px-6 py-4">نغمة مسطحة عالية</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">2nd</td><td class="px-6 py-4">má (麻)</td><td class="px-6 py-4">خدر</td><td class="px-6 py-4">نغمة صاعدة</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">3rd</td><td class="px-6 py-4">mǎ (马)</td><td class="px-6 py-4">حصان</td><td class="px-6 py-4">تهبط ثم ترتفع</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">4th</td><td class="px-6 py-4">mà (骂)</td><td class="px-6 py-4">يسب</td><td class="px-6 py-4">هبوط حاد</td></tr>
          </tbody>
        </table>
      </div>

      <p class="text-lg leading-relaxed text-gray-700 mb-12"><strong>أفضل نصيحة:</strong> تحدث ببطء ووضوح. معظم الصينيين معتادون على صعوبة الأجانب مع النغمات وسيحاولون فهمك.</p>
    </div>

        <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 أدلة ذات صلة</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/ar/life/survival-kit/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🎒 حقيبة البقاء لرحلتك إلى الصين</p>
          <p class="text-sm text-gray-600">قائمة التحقق الشاملة قبل السفر</p>
        </a>
        <a href="/ar/life/essential-apps/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">📱 10 تطبيقات تحتاجها للصين</p>
          <p class="text-sm text-gray-600">تطبيقات أساسية تشمل أدوات الترجمة</p>
        </a>
        <a href="/ar/life/cultural-taboos/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🏮 الأصول والأخلاقيات الثقافية</p>
          <p class="text-sm text-gray-600">تنقل في المواقف الاجتماعية بثقة</p>
        </a>
      </div>
    </div>
  
    <!-- Sources -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <h3 class="text-xl font-bold text-gray-900 mb-4">المصادر</h3>
      <ul class="space-y-2 text-sm text-gray-600">
        <li>مرجع لغوي — لا يوجد مصدر رسمي واحد.</li>
      </ul>
    </div>
  </article>
</Layout>