---
import Layout from '@layouts/Layout.astro';
const title = "الأصول والعادات الثقافية في الصين — دليل عملي";
const description = "دليل آداب الثقافة الصينية للأجانب: قواعد عيدان الطعام، تقديم الهدايا، حفظ ماء الوجه، قواعد التصوير، وما لا يجب فعله في الصين.";
---

<Layout title={title} description={description} lang="ar">
  <article class="max-w-4xl mx-auto px-6 py-12" dir="rtl">
    <nav class="mb-8 not-prose">
      <a href="/ar/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        العودة إلى الحياة
      </a>
    </nav>
    <!-- Header -->
  <header class="mb-12">
    <p class="text-sm text-gray-500 mb-3">🛡️ نصائح للسفر إلى الصين</p>
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
      الأصول والعادات الثقافية في الصين — دليل عملي
    </h1>
    <p class="text-xl text-gray-600 mb-6">اعرف بعض الأمور الأساسية، وستكون رحلتك أكثر سلاسة.</p>
    <div class="flex items-center gap-4 text-sm text-gray-500">
      <span>📅 آخر تحديث: يونيو 2026</span>
      <span>⏱️ قراءة 6 دقائق</span>
    </div>
  </header>

  <!-- Quick Answer Box -->
  <div class="bg-gradient-to-r from-purple-50 to-pink-50 border-l-4 border-purple-500 rounded-r-2xl p-8 mb-12 not-prose">
    <h2 class="text-2xl font-bold text-purple-900 mb-4">🎯 إجابة سريعة</h2>
    <p class="text-lg text-purple-800 leading-relaxed">
      الشعب الصيني <strong>متفهم جداً</strong> للزوار الأجانب الذين لا يعرفون العادات المحلية. لا أحد يتوقع منك أن تكون مثالياً. لكن معرفة بعض الأمور الأساسية ستجعل رحلتك أكثر سلاسة وتساعدك على التواصل بشكل أفضل مع السكان المحليين.
    </p>
  </div>

  <!-- Table of Contents -->
  <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
    <h3 class="text-lg font-bold text-gray-900 mb-4">📋 في هذا الدليل</h3>
    <ul class="space-y-3">
      <li><a href="#the-basics" class="text-blue-600 hover:underline">✅ الأساسيات</a></li>
      <li><a href="#impress-locals" class="text-blue-600 hover:underline">⭐ أمور ستثير إعجاب السكان المحليين</a></li>
      <li><a href="#things-that-matter" class="text-blue-600 hover:underline">⚠️ أمور تهم حقاً</a></li>
      <li><a href="#smoking" class="text-blue-600 hover:underline">🚬 ماذا عن التدخين؟</a></li>
      <li><a href="#golden-rule" class="text-blue-600 hover:underline">💎 القاعدة الذهبية</a></li>
    </ul>
  </nav>

  <!-- Main Content -->
  <div class="prose prose-lg max-w-none">
    <p class="text-lg leading-relaxed text-gray-700 mb-6">
      الشعب الصيني متفهم جداً للزوار الأجانب الذين لا يعرفون العادات المحلية. لا أحد يتوقع منك أن تكون مثالياً. لكن معرفة بعض الأمور الأساسية ستجعل رحلتك أكثر سلاسة وتساعدك على التواصل بشكل أفضل مع السكان المحليين.
    </p>

    <p class="text-lg leading-relaxed text-gray-700 mb-12">
      لقد قسمتُ هذا الدليل إلى ثلاثة مستويات: أمور يعرفها معظم الناس بالفعل، أمور ستثير إعجاب السكان المحليين حقاً، وأمور تهم حقاً.
    </p>

    <hr class="border-gray-200 my-12" />

    <!-- Section 1 -->
    <h2 id="the-basics" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">✅</span> الأساسيات
    </h2>

    <div class="space-y-6 mb-12">
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-amber-900 mb-3">🥢 قواعد عيدان الطعام</h3>
        <ul class="space-y-2 text-gray-800">
          <li>لا تضعها منتصبة في وعاء الأرز (يشبه البخور في الجنازات)</li>
          <li>لا تقرع بها على وعائك (هذا ما يفعله المتسولون)</li>
          <li>ضعها على حامل عيدان الطعام أو عبر طبقك</li>
        </ul>
      </div>

      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-blue-900 mb-3">🍵 اسكب المشروبات للآخرين</h3>
        <p class="text-gray-800 leading-relaxed">
          في الصين، تسكب المشروبات لمن حولك، وهم يسكبون لك. سكب مشروبك بنفسك يُعتبر أنانياً بعض الشيء.
        </p>
      </div>

      <div class="bg-red-50 border border-red-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-red-900 mb-3">🎁 تقديم الهدايا</h3>
        <ul class="space-y-2 text-gray-800">
          <li>لا تقدم الساعات (تشبه عبارة "حضور جنازة" في الصينية)</li>
          <li>اغلف الهدايا بالأحمر أو الذهبي، وليس الأبيض أو الأسود (ألوان الجنازات)</li>
          <li>لا تفتح الهدايا أمام مقدمها — من الأدب فتحها لاحقاً</li>
        </ul>
      </div>

      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-gray-900 mb-3">🚫 لا تُشر أو تلمس الرؤوس</h3>
        <ul class="space-y-2 text-gray-800">
          <li>الإشارة إلى الناس بأصبعك تعتبر وقحة. استخدم يداً مفتوحة أو أشر بذقنك بدلاً من ذلك.</li>
          <li>الرأس يُعتبر شخصياً/مقدساً في الثقافة الصينية. حتى التربيت على رأس طفل قد يكون غير مريح.</li>
          <li>الرقم 4 يشبه كلمة "موت" في الصينية. غالباً ما تتخطى المباني الطابق الرابع. تجنب تقديم هدايا في مجموعات من 4.</li>
        </ul>
      </div>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 2 -->
    <h2 id="impress-locals" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">⭐</span> أمور ستثير إعجاب السكان المحليين
    </h2>

    <p class="text-lg leading-relaxed text-gray-700 mb-8">هذه إيماءات صغيرة تُظهر أنك بذلت جهداً. سيقدرها الشعب الصيني حقاً:</p>

    <div class="space-y-6 mb-12">
      <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-green-900 mb-3">🍽️ آداب الطعام</h3>
        <ul class="space-y-2 text-gray-800">
          <li><strong>انتظر حتى يبدأ المضيف بتناول الطعام</strong> قبل أن تبدأ</li>
          <li><strong>جرب كل ما يُقدم لك</strong> — حتى لو لم تكن متأكداً مما هو. فهذا يظهر احترامك للمضيف</li>
          <li><strong>قل "أنا شبعان"</strong> (我饱了 / wǒ bǎo le) عندما تنتهي</li>
          <li><strong>عند استلام هدية أو بطاقة عمل</strong>، استخدم كلتا يديك</li>
          <li><strong>إذا عرض عليك أحدهم الشاي</strong>، اقبله. قد يشعر الرفض وكأنه رفض للضيافة</li>
        </ul>
      </div>

      <div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-indigo-900 mb-3">🍶 طقوس البايجيو</h3>
        <p class="text-gray-800 leading-relaxed mb-3">
          إذا قدم لك مضيف صيني البايجيو (المسكر الصيني)، فهو يُظهر لك الاحترام. لست مضطراً لشربه كله — رشفة صغيرة تكفي. لكن الرفض التام قد يشعرهم بعدم التقدير.
        </p>
        <p class="text-gray-800 leading-relaxed">
          عند تقديم نخب، اجعل كأسك أقل قليلاً من كأس الشخص الذي تشاركه النخب — فهي علامة تقليدية على الاحترام.
        </p>
      </div>

      <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-yellow-900 mb-3">👤 حفظ ماء الوجه</h3>
        <p class="text-gray-800 leading-relaxed">
          هذا هو المفهوم الأكثر أهمية في التفاعل الاجتماعي الصيني. "ماء الوجه" يعني الكرامة والسمعة والمكانة الاجتماعية. <strong>لا تنتقد أو تحرج أو تواجه أحداً علناً أمام الآخرين أبداً.</strong> إذا كان لديك شكوى أو خلاف، ناقشه على انفراد.
        </p>
      </div>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 3 -->
    <h2 id="things-that-matter" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">⚠️</span> أمور تهم حقاً
    </h2>

    <div class="space-y-6 mb-12">
      <div class="bg-red-50 border-r-4 border-red-400 p-6 rounded-l-xl not-prose">
        <h3 class="text-xl font-bold text-red-900 mb-3">📸 قواعد التصوير — هذا مهم</h3>
        <ul class="space-y-2 text-gray-800">
          <li><strong>لا تصور المواقع العسكرية أو نقاط التفتيش الشرطية أو المباني الحكومية</strong> — فقد يؤدي ذلك إلى احتجازك</li>
          <li>استأذن قبل تصوير الأشخاص، خاصة في المناطق الريفية أو مناطق الأقليات العرقية</li>
          <li>الطيران بالدرون مقيد في معظم المدن ويتطلب تسجيلاً</li>
        </ul>
      </div>

      <div class="bg-orange-50 border-r-4 border-orange-400 p-6 rounded-l-xl not-prose">
        <h3 class="text-xl font-bold text-orange-900 mb-3">📄 التعامل الصحيح مع الوثائق الرسمية</h3>
        <ul class="space-y-2 text-gray-800">
          <li>إذا دخلت من 中国香港 أو 中国澳门 أو 中国台湾، استخدم الممرات الخاصة بعبور الحدود</li>
          <li><strong>احمل جواز سفرك أو صورة واضحة منه دائماً</strong> — تقوم الشرطة بفحوصات عشوائية</li>
        </ul>
      </div>

      <div class="bg-purple-50 border-r-4 border-purple-400 p-6 rounded-l-xl not-prose">
        <h3 class="text-xl font-bold text-purple-900 mb-3">⚖️ احترام القوانين المحلية</h3>
        <ul class="space-y-2 text-gray-800">
          <li>الصين لديها قوانين صارمة بشأن الخطاب والمحتوى عبر الإنترنت والنقاش السياسي</li>
          <li>كزائر، النهج الأكثر أماناً هو <strong>تجنب المواضيع السياسية</strong> — أنت هنا كسائح، لا كمعلق</li>
          <li>الرقابة على الإنترنت حقيقية. لا تحاول الوصول إلى المواقع المحجوبة باستخدام WiFi الفندق أو الشبكات العامة دون فهم المخاطر</li>
          <li>هذه القواعد تنطبق على الجميع، بما في ذلك المواطنين الصينيين</li>
        </ul>
      </div>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 4 -->
    <h2 id="smoking" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🚬</span> ماذا عن التدخين؟
    </h2>

    <div class="bg-gray-100 border border-gray-200 rounded-2xl p-6 mb-12 not-prose">
      <ul class="space-y-2 text-gray-800">
        <li>🚭 الأماكن العامة المغلقة خالية من التدخين</li>
        <li>🚬 ستشاهد الكثير من التدخين في الأماكن المفتوحة — إنه جزء من الحياة اليومية</li>
        <li>📍 إذا كنت تدخن، ابحث عن مناطق التدخين المخصصة</li>
      </ul>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 5 -->
    <h2 id="golden-rule" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">💎</span> القاعدة الذهبية
    </h2>

    <div class="bg-gradient-to-r from-blue-50 to-purple-50 border border-blue-200 rounded-2xl p-8 mb-12 not-prose">
      <p class="text-xl text-gray-900 leading-relaxed mb-4">
        إليك الأمر: <strong>الشعب الصيني لا يتوقع منك أن تكون مثالياً.</strong> الأهم هو موقفك.
      </p>
      <p class="text-lg text-gray-800 leading-relaxed mb-4">
        <strong>ابتسم. قل 谢谢 (xièxie / شكراً لك). قل 对不起 (duìbuqǐ / آسف) عندما تخطئ.</strong>
      </p>
      <p class="text-lg text-gray-800 leading-relaxed">
        هذه الأمور الثلاثة ستساعدك في تجاوز 95% من المواقف المحرجة. لقد رأيت أجانب يرتكبون كل خطأ في آداب السلوك الوارد في هذا الدليل، ومع ذلك قضوا وقتاً رائعاً في الصين، فقط لأنهم كانوا ودودين ومحترمين.
      </p>
      <p class="text-lg text-gray-800 leading-relaxed mt-4 font-semibold">
        الصين بلد يضم 1.4 مليار نسمة. نحن معتادون على التنوع. نحن سعداء حقاً برؤية زوار فضوليين تجاه ثقافتنا. إذا أتيت بعقل منفتح، سيقابلك الناس بالدفء.
      </p>
    </div>

    <hr class="border-gray-200 my-12" />
  </div>

  <!-- Related Guides -->
  <div class="bg-gray-50 rounded-2xl p-8 not-prose">
    <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 أدلة ذات صلة</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/ar/life/is-china-safe/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
        <p class="font-bold text-gray-900 mb-1">هل السفر إلى الصين آمن؟</p>
        <p class="text-sm text-gray-600">إجابة صادقة من أحد السكان المحليين</p>
      </a>
      <a href="/ar/life/common-scams/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
        <p class="font-bold text-gray-900 mb-1">الاحتيالات الشائعة في الصين وكيفية تجنبها</p>
        <p class="text-sm text-gray-600">لا تدع المحتالين يفسدون رحلتك</p>
      </a>
      <a href="/ar/life/emergency-numbers/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
        <p class="font-bold text-gray-900 mb-1">أرقام الطوارئ وما يجب فعله</p>
        <p class="text-sm text-gray-600">احفظها قبل أن تحتاج إليها</p>
      </a>
    </div>
  </div>
</article>
</Layout>