---
import Layout from '@layouts/Layout.astro';
const title = "أرقام الطوارئ في الصين وماذا تفعل إذا احتجت مساعدة";
const description = "أرقام الطوارئ في الصين: 110 (الشرطة)، 120 (الإسعاف)، 119 (الإطفاء). بالإضافة إلى: جهات اتصال السفارات، خطوات فقدان جواز السفر، وعبارات الطوارئ.";
---

<Layout title={title} description={description} lang="ar">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/ar/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        العودة إلى النصائح
      </a>
    </nav>
    <!-- Header -->
  <header class="mb-12">
    <p class="text-sm text-gray-500 mb-3">🛡️ نصائح للسفر إلى الصين</p>
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
      أرقام الطوارئ في الصينوماذا تفعل إذا احتجت مساعدة
    </h1>
    <p class="text-xl text-gray-600 mb-6">إذا حدث خطأ ما أثناء زيارتك، إليك بالضبط ما يجب فعله.</p>
    <div class="flex items-center gap-4 text-sm text-gray-500">
      <span>📅 آخر تحديث: يونيو 2026</span>
      <span>⏱️ 7 دقائق</span>
    </div>
  </header>

  <!-- Quick Answer Box -->
  <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
    <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 إجابة سريعة</h2>
    <p class="text-lg text-blue-800 leading-relaxed">
      <strong>ثلاثة أرقام تنقذ الأرواح في الصين:</strong> <strong class="text-red-600">110</strong> (الشرطة)، <strong class="text-red-600">120</strong> (الإسعاف)، <strong class="text-red-600">119</strong> (الإطفاء). جميعها لديها مشغلون يتحدثون الإنجليزية. احفظ رقم سفارتك قبل الوصول.
    </p>
  </div>

  <!-- Table of Contents -->
  <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
    <h3 class="text-lg font-bold text-gray-900 mb-4">📋 في هذا الدليل</h3>
    <ul class="space-y-3">
      <li><a href="#three-numbers" class="text-blue-600 hover:underline">📞 الأرقام الثلاثة التي تحتاجها</a></li>
      <li><a href="#language-barrier" class="text-blue-600 hover:underline">🗣️ ماذا تفعل إذا كنت لا تتحدث الصينية</a></li>
      <li><a href="#embassy" class="text-blue-600 hover:underline">🏛️ سفارتك أو قنصليتك</a></li>
      <li><a href="#common-emergencies" class="text-blue-600 hover:underline">🆘 خطوات للحالات الطارئة الشائعة</a></li>
      <li><a href="#emergency-phrases" class="text-blue-600 hover:underline">📝 عبارات الطوارئ للاحتفاظ بها على هاتفك</a></li>
    </ul>
  </nav>

  <!-- Main Content -->
  <div class="prose prose-lg max-w-none">
    <hr class="border-gray-200 my-12" />

    <!-- Section 1 -->
    <h2 id="three-numbers" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">📞</span> الأرقام الثلاثة التي تحتاجها
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12 not-prose">
      <div class="bg-red-50 border border-red-200 rounded-2xl p-6 text-center">
        <div class="text-6xl font-extrabold text-red-600 mb-2">110</div>
        <h3 class="text-xl font-bold text-red-900 mb-3">🚔 الشرطة</h3>
        <p class="text-gray-700">لأي حالة طارئة — حتى لو كنت بحاجة لمساعدة طبية. يمكنهم توصيلك بضباط يتحدثون الإنجليزية.</p>
      </div>

      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 text-center">
        <div class="text-6xl font-extrabold text-blue-600 mb-2">120</div>
        <h3 class="text-xl font-bold text-blue-900 mb-3">🚑 الإسعاف</h3>
        <p class="text-gray-700">خط الطوارئ الطبي. يمكن للمشغلين ترتيب مساعدة ناطقة بالإنجليزية.</p>
      </div>

      <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6 text-center">
        <div class="text-6xl font-extrabold text-orange-600 mb-2">119</div>
        <h3 class="text-xl font-bold text-orange-900 mb-3">🚒 الإطفاء</h3>
        <p class="text-gray-700">طوارئ الحريق. استخدم لأي حالة تتعلق بالحريق.</p>
      </div>
    </div>

    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-12 not-prose">
      <p class="text-yellow-900 font-semibold">💡 <strong>نصيحة طارئة:</strong> إذا لم تتمكن من التحدث، أرسل موقعك عبر نص إلى <strong>12110</strong> (خدمة الرسائل النصية للطوارئ). المشغلون يراقبون هذا للأشخاص الذين لا يستطيعون إجراء مكالمات صوتية.</p>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 2 -->
    <h2 id="language-barrier" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🗣️</span> ماذا تفعل إذا كنت لا تتحدث الصينية
    </h2>

    <p class="text-lg leading-relaxed text-gray-700 mb-6">هذا هو التحدي الأكبر في حالة الطوارئ. قبل أن تحتاجه، احفظ هذه العبارة على هاتفك:</p>

    <div class="bg-gray-900 text-white rounded-2xl p-8 mb-12 not-prose">
      <p class="text-2xl text-center mb-4">📱 <strong>احفظ هذا في هاتفك:</strong></p>
      <div class="bg-white text-gray-900 rounded-xl p-6 text-center">
        <p class="text-2xl font-bold text-red-600 mb-3">请帮我报警，我是外国人，需要翻译。</p>
        <p class="text-lg text-gray-600 mb-2"><em>(Qǐng bāng wǒ bào jǐng, wǒ shì wàiguó rén, xūyào fānyì.)</em></p>
        <p class="text-lg text-gray-800 font-semibold">"من فضلك ساعدني في الاتصال بالشرطة. أنا أجنبي وأحتاج مترجماً."</p>
      </div>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 3 -->
    <h2 id="embassy" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🏛️</span> سفارتك أو قنصليتك
    </h2>

    <p class="text-lg leading-relaxed text-gray-700 mb-6">إذا فقدت جواز سفرك، أو وقعت في مشكلة قانونية، أو كان لديك حالة طارئة خطيرة، اتصل بسفارة أو قنصلية بلدك.</p>

    <div class="overflow-x-auto mb-12 not-prose">
      <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
        <thead>
          <tr class="bg-gray-900 text-white">
            <th class="px-6 py-4 font-bold">البلد</th>
            <th class="px-6 py-4 font-bold text-center">اتصال بكين</th>
            <th class="px-6 py-4 font-bold text-center">اتصال شنغهاي</th>
            <th class="px-6 py-4 font-bold text-center">اتصال قوانغتشو</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">🇺🇸 الولايات المتحدة</td>
            <td class="px-6 py-4 text-center">010-8531-3000</td>
            <td class="px-6 py-4 text-center">021-8011-2200</td>
            <td class="px-6 py-4 text-center">020-3814-5000</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">🇬🇧 المملكة المتحدة</td>
            <td class="px-6 py-4 text-center">010-5192-4000</td>
            <td class="px-6 py-4 text-center">021-3279-2000</td>
            <td class="px-6 py-4 text-center">020-8314-3000</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">🇨🇦 كندا</td>
            <td class="px-6 py-4 text-center">010-5139-4000</td>
            <td class="px-6 py-4 text-center">021-3279-2800</td>
            <td class="px-6 py-4 text-center">020-8611-6100</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">🇦🇺 أستراليا</td>
            <td class="px-6 py-4 text-center">010-5140-4111</td>
            <td class="px-6 py-4 text-center">021-2215-5200</td>
            <td class="px-6 py-4 text-center">020-3814-0111</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">🇩🇪 ألمانيا</td>
            <td class="px-6 py-4 text-center">010-8532-9000</td>
            <td class="px-6 py-4 text-center">021-3401-0106</td>
            <td class="px-6 py-4 text-center">020-8313-0121</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">🇫🇷 فرنسا</td>
            <td class="px-6 py-4 text-center">010-8531-2000</td>
            <td class="px-6 py-4 text-center">021-6103-6300</td>
            <td class="px-6 py-4 text-center">020-2829-2000</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">🇯🇵 اليابان</td>
            <td class="px-6 py-4 text-center">010-8531-9800</td>
            <td class="px-6 py-4 text-center">021-5257-4766</td>
            <td class="px-6 py-4 text-center">020-8334-3009</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">🇰🇷 كوريا الجنوبية</td>
            <td class="px-6 py-4 text-center">010-8531-0700</td>
            <td class="px-6 py-4 text-center">021-6295-5000</td>
            <td class="px-6 py-4 text-center">020-2919-2999</td>
          </tr>
          <tr>
            <td class="px-6 py-4 font-semibold">🇸🇬 سنغافورة</td>
            <td class="px-6 py-4 text-center">010-6505-9393</td>
            <td class="px-6 py-4 text-center">021-6278-5566</td>
            <td class="px-6 py-4 text-center">020-3891-2345</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-sm text-gray-500 mb-12"><em>⚠️ تفاصيل الاتصال بالسفارات قد تتغير وقد لا تكون بلدك مدرجة في الجدول. <strong>يرجى التحقق من موقع سفارة بلدك الرسمي قبل السفر.</strong></em></p>

    <hr class="border-gray-200 my-12" />

    <!-- Section 4 -->
    <h2 id="common-emergencies" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🆘</span> خطوات للحالات الطارئة الشائعة
    </h2>

    <div class="space-y-8 mb-12 not-prose">
      <div class="bg-red-50 border border-red-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-red-900 mb-4">📘 جواز سفر مفقود أو مسروق</h3>
        <ol class="space-y-2 text-gray-800">
          <li><strong>1.</strong> اتصل على <strong>110</strong> أو اذهب لأقرب مركز شرطة</li>
          <li><strong>2.</strong> احصل على <strong>محضر شرطة</strong> (报警回执 / bào jǐng huí zhí) — ستحتاجه للسفارة</li>
          <li><strong>3.</strong> اتصل بسفارتك للحصول على وثيقة سفر طارئة</li>
          <li><strong>4.</strong> اذهب لسفارتك شخصياً مع محضر الشرطة وصورة جواز سفر</li>
          <li><strong>5.</strong> معظم السفارات يمكنها إصدار جواز سفر طارئ خلال 1-5 أيام عمل</li>
        </ol>
      </div>

      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-blue-900 mb-4">🏥 حالة طبية طارئة</h3>
        <ol class="space-y-2 text-gray-800">
          <li><strong>1.</strong> اتصل على <strong>120</strong> لسيارة إسعاف، أو اذهب مباشرة لطوارئ المستشفى</li>
          <li><strong>2.</strong> المستشفيات العامة الكبرى لديها <strong>أقسام دولية</strong> بطاقم يتحدث الإنجليزية</li>
          <li><strong>3.</strong> اتصل بمزود تأمين السفر الخاص بك — يمكنهم المساعدة في تنسيق الدفع وإيجاد أطباء يتحدثون الإنجليزية</li>
          <li><strong>4.</strong> إذا لم تتمكن من التواصل، أظهر لموظفي المستشفى جواز سفرك وبطاقة التأمين</li>
        </ol>
      </div>

      <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-orange-900 mb-4">💰 محفظة مفقودة / لا مال</h3>
        <ol class="space-y-2 text-gray-800">
          <li><strong>1.</strong> اذهب لأقرب <strong>مركز شرطة</strong> — يمكنهم مساعدتك في الاتصال بسفارتك</li>
          <li><strong>2.</strong> اذهب لأي <strong>فندق</strong> — مكتب الاستقبال يمكنه مساعدتك في الاتصال بسفارتك</li>
          <li><strong>3.</strong> استخدم WeChat/Alipay — مقبولة في كل مكان تقريباً، حتى لو فقدت محفظتك</li>
        </ol>
      </div>

      <div class="bg-purple-50 border border-purple-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-purple-900 mb-4">📡 لا يوجد إنترنت</h3>
        <ol class="space-y-2 text-gray-800">
          <li><strong>1.</strong> ابحث عن <strong>بهو فندق</strong> — أي فندق سيسمح لك باستخدام WiFi الخاص به</li>
          <li><strong>2.</strong> <strong>Starbucks أو McDonald's</strong> — WiFi مجاني متاح (اسأل الموظفين عن كلمة المرور)</li>
          <li><strong>3.</strong> اذهب لمتجر <strong>China Unicom أو China Mobile أو China Telecom</strong> — يمكنهم المساعدة في مشاكل SIM</li>
        </ol>
      </div>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 5 -->
    <h2 id="emergency-phrases" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">📝</span> عبارات الطوارئ للاحتفاظ بها على هاتفك
    </h2>

    <div class="overflow-x-auto mb-12 not-prose">
      <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
        <thead>
          <tr class="bg-gray-900 text-white">
            <th class="px-6 py-4 font-bold">الموقف</th>
            <th class="px-6 py-4 font-bold">الصينية</th>
            <th class="px-6 py-4 font-bold">النطق</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">النجدة!</td>
            <td class="px-6 py-4 text-red-600 font-bold text-lg">救命！</td>
            <td class="px-6 py-4"><em>Jiù mìng!</em></td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">اتصل بالشرطة</td>
            <td class="px-6 py-4 text-red-600 font-bold text-lg">报警</td>
            <td class="px-6 py-4"><em>Bào jǐng</em></td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">أحتاج سيارة إسعاف</td>
            <td class="px-6 py-4 text-blue-600 font-bold text-lg">我需要救护车</td>
            <td class="px-6 py-4"><em>Wǒ xūyào jiùhù chē</em></td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">أنا تائه</td>
            <td class="px-6 py-4 text-orange-600 font-bold text-lg">我迷路了</td>
            <td class="px-6 py-4"><em>Wǒ mílù le</em></td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">أنا لست على ما يرام</td>
            <td class="px-6 py-4 text-purple-600 font-bold text-lg">我感觉不舒服</td>
            <td class="px-6 py-4"><em>Wǒ gǎnjué bù shūfu</em></td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">جواز سفري سُرق</td>
            <td class="px-6 py-4 text-red-600 font-bold text-lg">我的护照被偷了</td>
            <td class="px-6 py-4"><em>Wǒ de hùzhào bèi tōu le</em></td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">أين المستشفى؟</td>
            <td class="px-6 py-4 text-blue-600 font-bold text-lg">最近的医院在哪里？</td>
            <td class="px-6 py-4"><em>Zuìjìn de yīyuàn zài nǎlǐ?</em></td>
          </tr>
          <tr class="bg-gray-50">
            <td class="px-6 py-4 font-semibold">خذني إلى هنا</td>
            <td class="px-6 py-4 text-purple-600 font-bold text-lg">带我去这里</td>
            <td class="px-6 py-4"><em>Dài wǒ qù zhèlǐ</em></td>
          </tr>
        </tbody>
      </table>
    </div>

    <hr class="border-gray-200 my-12" />
  </div>

  <!-- Related Guides -->
  <div class="bg-gray-50 rounded-2xl p-8 not-prose">
    <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 أدلة ذات صلة</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/ar/life/is-china-safe/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
        <p class="font-bold text-gray-900 mb-1">هل السفر إلى الصين آمن؟</p>
        <p class="text-sm text-gray-600">الإجابة الصادقة من أحد السكان المحليين</p>
      </a>
      <a href="/ar/life/common-scams/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
        <p class="font-bold text-gray-900 mb-1">الاحتيالات الشائعة في الصين وكيفية تجنبها</p>
        <p class="text-sm text-gray-600">لا تدع المحتالين يفسدون رحلتك</p>
      </a>
      <a href="/ar/life/seeing-a-doctor/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
        <p class="font-bold text-gray-900 mb-1">زيارة الطبيب في الصين</p>
        <p class="text-sm text-gray-600">المستشفيات والتأمين وماذا تتوقع</p>
      </a>
    </div>
  </div>
</article>
</Layout>