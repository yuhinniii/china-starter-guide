---
import Layout from '@layouts/Layout.astro';
const title = 'الحياة في الصين — نصائح وأدلة السفر';
const description = 'ابقَ متصلاً، وآمناً، واستمتع برحلتك على أكمل وجه.';
---

<Layout title={title} description={description} lang="ar">
  <section class="max-w-5xl mx-auto px-6 py-12" dir="rtl">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">الحياة في الصين</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">ابقَ متصلاً، وآمناً، واستمتع برحلتك على أكمل وجه.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">3</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">الإنترنت والتطبيقات</p>
      </div>
      <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-cyan-800">3</p>
        <p class="text-xs font-semibold text-cyan-800 uppercase tracking-wide mt-1">الصحة والرعاية الطبية</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">3</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">السلامة والطوارئ</p>
      </div>
      <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-yellow-800">2</p>
        <p class="text-xs font-semibold text-yellow-800 uppercase tracking-wide mt-1">الثقافة والأساسيات</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">الاتصالات والإنترنت</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">3 مقالات</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/life/sim-card-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📶 الإنترنت</span>
            <p class="text-base font-bold text-gray-900 mt-1">أفضل بطاقة SIM و eSIM للسياح</p>
            <p class="text-sm text-gray-600 mt-0.5">قارن بين مزودي eSIM وبطاقات SIM في المطار وخطط البيانات.</p>
          </a>
          <a href="/ar/life/vpn-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🔒 VPN</span>
            <p class="text-base font-bold text-gray-900 mt-1">أفضل خدمات VPN للسفر في الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">ما الذي يعمل، وكيفية الإعداد، ولماذا يجب قبل وصولك.</p>
          </a>
          <a href="/ar/life/essential-apps/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📱 التطبيقات</span>
            <p class="text-base font-bold text-gray-900 mt-1">10 تطبيقات أساسية للسفر في الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">الدفع، النقل، الترجمة، والاستكشاف.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-cyan-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-cyan-800">الصحة والرعاية الطبية</h2>
          <span class="text-xs font-medium text-cyan-800 opacity-60">3 مقالات</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/life/seeing-a-doctor/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">⚕️ الرعاية الطبية</span>
            <p class="text-base font-bold text-gray-900 mt-1">زيارة الطبيب في الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">صيدلية، عيادة، أو مستشفى — كيف تختار.</p>
          </a>
          <a href="/ar/life/top-hospitals/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🏥 المستشفيات</span>
            <p class="text-base font-bold text-gray-900 mt-1">أفضل المستشفيات ذات الأقسام الدولية</p>
            <p class="text-sm text-gray-600 mt-0.5">أفضل المستشفيات التي تتحدث بالإنجليزية، حسب المدينة.</p>
          </a>
          <a href="/ar/life/travel-insurance/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🛡️ التأمين</span>
            <p class="text-base font-bold text-gray-900 mt-1">تأمين السفر للصين</p>
            <p class="text-sm text-gray-600 mt-0.5">ما تحتاج معرفته عن تأمين السفر.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">السلامة والطوارئ</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">3 مقالات</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/life/is-china-safe/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🛡️ الأمان</span>
            <p class="text-base font-bold text-gray-900 mt-1">هل السفر إلى الصين آمن؟</p>
            <p class="text-sm text-gray-600 mt-0.5">رأي صادق حول السلامة والجريمة وما يجب الانتباه له.</p>
          </a>
          <a href="/ar/life/common-scams/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">⚠️ الاحتيال</span>
            <p class="text-base font-bold text-gray-900 mt-1">الاحتيالات الشائعة في الصين وكيفية تجنبها</p>
            <p class="text-sm text-gray-600 mt-0.5">اكتشف أشهر فخاخ السياح وتجنبها.</p>
          </a>
          <a href="/ar/life/emergency-numbers/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🆘 الطوارئ</span>
            <p class="text-base font-bold text-gray-900 mt-1">أرقام الطوارئ وماذا تفعل</p>
            <p class="text-sm text-gray-600 mt-0.5">جهات اتصال أساسية وخطوات الاستجابة للطوارئ.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-yellow-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-yellow-800">الثقافة والأساسيات</h2>
          <span class="text-xs font-medium text-yellow-800 opacity-60">4 مقالات</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/life/packing-guide/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🧳 التعبئة</span>
            <p class="text-base font-bold text-gray-900 mt-1">ماذا تأخذ معك إلى الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">قائمة تعبئة عملية لكل فصل.</p>
          </a>
          <a href="/ar/life/cultural-taboos/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🙏 الإتيكيت</span>
            <p class="text-base font-bold text-gray-900 mt-1">الأمور المسموح والممنوع في الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">دليل الإتيكيت للزوار الأجانب.</p>
          </a>
          <a href="/ar/life/chinese-phrases/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🈶 اللغة</span>
            <p class="text-base font-bold text-gray-900 mt-1">عبارات صينية أساسية للسياح</p>
            <p class="text-sm text-gray-600 mt-0.5">لغة صينية للبقاء للمسافرين.</p>
          </a>
        </div>
      </div>
    </div>

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">الخطوة التالية</p>
            <h3 class="text-xl font-bold text-gray-900">خطط لرحلتك</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">أنت مستعد للحياة اليومية في الصين. الآن: رتّب تأشيرتك وتعلم كيفية التنقل.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/ar/visa/visa-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🛂 دليل التأشيرة
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/ar/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 دليل النقل
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>