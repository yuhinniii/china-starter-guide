---
import Layout from '@layouts/Layout.astro';
const title = "ماذا تأخذ معك إلى الصين — دليل الفصول والمناخ";
const description = "ماذا تأخذ معك إلى الصين حسب الفصول والمدن — من شتاء بكين إلى صيف قوانغتشو.";
---

<Layout title={title} description={description} lang="ar">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/ar/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        العودة إلى الحياة
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🎒 الحياة في الصين</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        ماذا تأخذ معك إلى الصين<br class="hidden md:block" />: دليل الفصول والمناخ
      </h1>
      <p class="text-xl text-gray-600 mb-6">التعبئة للصين مختلفة — إليك ما تحتاجه حقاً.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 آخر تحديث: يونيو 2026</span>
        <span>⏱️ 6 دقائق</span>
      </div>
    </header>

        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 إجابة سريعة</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        <strong>الصين لديها تباين موسمي شديد.</strong> بكين في الشتاء متجمدة (-10 درجة مئوية)، بينما قوانغتشو في الصيف حارة ورطبة (35 درجة مئوية+ مع رطوبة). المفتاح هو التعبئة بالطبقات والاستعداد للمدن والفصول المحددة التي ستزورها. بشكل عام: أحذية مشي مريحة، باور بانك، ورق تواليت، وزجاجة ماء قابلة لإعادة الاستخدام أساسيات بغض النظر عن الفصل.
      </p>
    </div>

        <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 في هذا الدليل</h3>
      <ul class="space-y-3">
        <li><a href="#year-round" class="text-blue-600 hover:underline">🎒 أساسيات على مدار العام</a></li>
        <li><a href="#spring" class="text-blue-600 hover:underline">🌸 الربيع (مارس–مايو)</a></li>
        <li><a href="#summer" class="text-blue-600 hover:underline">☀️ الصيف (يونيو–أغسطس)</a></li>
        <li><a href="#autumn" class="text-blue-600 hover:underline">🍂 الخريف (سبتمبر–نوفمبر)</a></li>
        <li><a href="#winter" class="text-blue-600 hover:underline">❄️ الشتاء (ديسمبر–فبراير)</a></li>
        <li><a href="#city-guide" class="text-blue-600 hover:underline">🏙️ دليل سريع لكل مدينة</a></li>
      </ul>
    </nav>

    <div class="prose prose-lg max-w-none">
      <hr class="border-gray-200 my-12" />

            <h2 id="year-round" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🎒</span> أساسيات على مدار العام
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-8">هذه العناصر يجب أن تكون في حقيبتك بغض النظر عن موعد أو مكان زيارتك:</p>

      <div class="overflow-x-auto mb-6 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">العنصر</th>
              <th class="px-6 py-4 font-bold">لماذا</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4"><strong>باور بانك</strong></td><td class="px-6 py-4">بطارية الهاتف تنفد بسرعة مع الملاحة + الترجمة + الدفع</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4"><strong>محول سفر عالمي</strong></td><td class="px-6 py-4">الصين تستخدم مقابس Type A/I (220V)</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4"><strong>ورق تواليت / مناديل محمولة</strong></td><td class="px-6 py-4">كثير من المراحيض العامة لا توفر ورقاً</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4"><strong>معقم يدين</strong></td><td class="px-6 py-4">ليس كل الأماكن لديها صابون</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4"><strong>زجاجة ماء قابلة لإعادة الاستخدام</strong></td><td class="px-6 py-4">الفنادق والمحطات بها موزعات ماء ساخن</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4"><strong>أحذية مشي مريحة</strong></td><td class="px-6 py-4">ستمشي أكثر من 15,000 خطوة يومياً في المتوسط</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4"><strong>حقيبة ظهر صغيرة</strong></td><td class="px-6 py-4">ليس كل المعالم تسمح بالحقائب الكبيرة</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4"><strong>نسخ جواز السفر والتأشيرة</strong></td><td class="px-6 py-4">احتفظ بنسخ رقمية أيضاً</td></tr>
          </tbody>
        </table>
      </div>

      <div class="bg-yellow-50 border border-yellow-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>هام:</strong> بالنسبة للرحلات الداخلية وتفتيش الأمن في السكك الحديدية عالية السرعة، يجب أن تحمل الباور بانكات علامة اعتماد 3C وألا تزيد سعتها عن 20,000 مللي أمبير. إذا كنت تخطط لزيارة عدة مدن في الصين، يُنصح بشراء باور بانك معتمد في أول مدينة تصل إليها.</p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="spring" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🌸</span> الربيع (مارس–مايو)
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>درجات الحرارة:</strong> 10°م–25°م (بكين أبرد، قوانغتشو أدفأ)</p>
      <p class="text-lg leading-relaxed text-gray-700 mb-8"><strong>الظروف:</strong> معتدل لكن غير متوقع. أمطار محتملة في أبريل–مايو، خاصة في الجنوب.</p>

      <p class="text-lg font-bold text-gray-900 mb-4">احزم:</p>
      <ul class="space-y-3 mb-12">
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> سترة خفيفة أو هودي (ضروري — أمسيات الربيع قد تكون باردة)</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> بناطيل طويلة وقمصان بأكمام طويلة</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> مظلة أو سترة مطر خفيفة</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> وشاح (مفيد للرياح والغبار)</li>
      </ul>

      <hr class="border-gray-200 my-12" />

            <h2 id="summer" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">☀️</span> الصيف (يونيو–أغسطس)
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>درجات الحرارة:</strong> 25°م–40°م (بكين حرارة جافة، قوانغتشو/شنغهاي رطبة)</p>
      <p class="text-lg leading-relaxed text-gray-700 mb-8"><strong>الظروف:</strong> حار في كل مكان. المدن الجنوبية رطبة بشكل خاص. أمطار موسمية شائعة.</p>

      <p class="text-lg font-bold text-gray-900 mb-4">احزم:</p>
      <ul class="space-y-3 mb-12">
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> ملابس خفيفة قابلة للتنفس (قطن، كتان)</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> واقي شمس (SPF 50+)</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> نظارة شمسية وقبعة</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> مظلة (للشمس والمطر)</li>
        <li class="flex items-start gap-3"><span class="text-red-500">⚠️</span> العديد من المعالم (المدينة المحرمة، سور الصين العظيم) لديها ظل محدود — خطط وفقاً لذلك</li>
      </ul>

      <hr class="border-gray-200 my-12" />

            <h2 id="autumn" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🍂</span> الخريف (سبتمبر–نوفمبر)
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>درجات الحرارة:</strong> 5°م–22°م (يبرد، لطيف)</p>
      <p class="text-lg leading-relaxed text-gray-700 mb-8"><strong>الظروف:</strong> أفضل فصل. سماء صافية، هواء بارد، رطوبة منخفضة.</p>

      <p class="text-lg font-bold text-gray-900 mb-4">احزم:</p>
      <ul class="space-y-3 mb-12">
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> طبقات: تي شيرت + سترة خفيفة أو كنزة</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> جينز أو بنطال مريح</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> سترة متوسطة الوزن للمساء</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> هذا هو الفصل المثالي للأنشطة الخارجية</li>
      </ul>

      <hr class="border-gray-200 my-12" />

            <h2 id="winter" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">❄️</span> الشتاء (ديسمبر–فبراير)
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>درجات الحرارة:</strong> -15°م (بكين/هاربين) إلى 15°م (قوانغتشو/شنتشن)</p>
      <p class="text-lg leading-relaxed text-gray-700 mb-8"><strong>الظروف:</strong> متجمد في الشمال، معتدل في الجنوب. هواء جاف مع رطوبة منخفضة.</p>

      <p class="text-lg font-bold text-gray-900 mb-4">احزم (للشمال؛ الجنوب مثل الخريف):</p>
      <ul class="space-y-3 mb-12">
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> معطف شتوي ثقيل / جاكيت زغب (ضروري لبكين، شيآن، أو أي مكان شمالي)</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> ملابس داخلية حرارية (إذا كنت تزور الشمال)</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> قبعة، قفازات، وشاح — غير قابل للتفاوض في الشتاء</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> مرطب شفاه ومرطب للبشرة (التدفئة المركزية تجفف الجلد)</li>
        <li class="flex items-start gap-3"><span class="text-red-500">⚠️</span> هاربين قد تصل لـ -30°م — احزم معدات الطقس القاسي إذا كنت متوجهاً لتلك المنطقة</li>
      </ul>

      <hr class="border-gray-200 my-12" />

            <h2 id="city-guide" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🏙️</span> دليل سريع لكل مدينة
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">المدينة</th>
              <th class="px-6 py-4 font-bold">الصيف (°م)</th>
              <th class="px-6 py-4 font-bold">الشتاء (°م)</th>
              <th class="px-6 py-4 font-bold">نصيحة تعبئة رئيسية</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">بكين</td><td class="px-6 py-4">25–35</td><td class="px-6 py-4">-10 إلى 5</td><td class="px-6 py-4">معطف ثقيل في الشتاء، حماية من الشمس في الصيف</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">شنغهاي</td><td class="px-6 py-4">25–37</td><td class="px-6 py-4">0–10</td><td class="px-6 py-4">رطبة طوال العام؛ سترة مطر ضرورية</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">قوانغتشو</td><td class="px-6 py-4">28–38</td><td class="px-6 py-4">10–18</td><td class="px-6 py-4">دافئة طوال العام؛ ملابس خفيفة + معدات مطر</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">شنتشن</td><td class="px-6 py-4">28–35</td><td class="px-6 py-4">12–20</td><td class="px-6 py-4">مشابهة لقوانغتشو؛ ملابس شاطئ في الصيف</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">تشنغدو</td><td class="px-6 py-4">22–32</td><td class="px-6 py-4">2–10</td><td class="px-6 py-4">غائمة غالباً؛ طبقات مريحة طوال العام</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">شيآن</td><td class="px-6 py-4">23–35</td><td class="px-6 py-4">-5 إلى 8</td><td class="px-6 py-4">مشابهة لبكين لكن أكثر دفئاً قليلاً</td></tr>
          </tbody>
        </table>
      </div>
    </div>

        <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 أدلة ذات صلة</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/ar/life/survival-kit/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🎒 حقيبة البقاء لرحلتك إلى الصين</p>
          <p class="text-sm text-gray-600">قائمة التحقق الشاملة قبل السفر</p>
        </a>
        <a href="/ar/life/essential-apps/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">📱 10 تطبيقات تحتاجها للصين</p>
          <p class="text-sm text-gray-600">تطبيقات أساسية للملاحة والمزيد</p>
        </a>
        <a href="/ar/transport/transport-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🚄 كيف تتنقل في الصين</p>
          <p class="text-sm text-gray-600">تنقل بين المدن بسهولة</p>
        </a>
      </div>
    </div>
  
    <!-- Sources -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <h3 class="text-xl font-bold text-gray-900 mb-4">المصادر</h3>
      <ul class="space-y-2 text-sm text-gray-600">
        <li>نصائح عملية — لا يوجد مصدر رسمي واحد.</li>
      </ul>
    </div>
  </article>
</Layout>