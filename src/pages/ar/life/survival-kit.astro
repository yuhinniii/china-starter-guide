---
import Layout from '@layouts/Layout.astro';
const title = "حقيبة البقاء لرحلتك إلى الصين: كل ما تحتاج قبل المغادرة";
const description = "من التطبيقات وبطاقات SIM إلى VPN والتعبئة — إليك قائمة التحقق الشاملة قبل السفر إلى الصين.";
---

<Layout title={title} description={description} lang="ar">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/ar/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        العودة إلى الحياة
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🎒 الحياة في الصين</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        حقيبة البقاء لرحلتك إلى الصين: كل ما تحتاج قبل المغادرة
      </h1>
      <p class="text-xl text-gray-600 mb-6">خمسة أشياء يجب ترتيبها قبل رحلتك — ليست صعبة، لكن كل منها مهم.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 آخر تحديث: يونيو 2026</span>
        <span>⏱️ 6 دقائق</span>
      </div>
    </header>

        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 إجابة سريعة</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        <strong>هناك خمسة أشياء تحتاج لترتيبها قبل رحلتك إلى الصين: هاتفك، اتصالك بالإنترنت، VPN الخاص بك، بعض العبارات الصينية الأساسية، وأمتعتك.</strong> ليست أي منها صعبة، لكن كل منها يمكن أن يصنع أو يفسد رحلتك إذا تم إهمالها. إليك دليل سريع لتعرف ما تحتاجه بالفعل — ثم تعمق في المقالات التفصيلية لكل موضوع.
      </p>
    </div>

        <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 في هذا الدليل</h3>
      <ul class="space-y-3">
        <li><a href="#phone-apps" class="text-blue-600 hover:underline">📱 هاتفك: هل لديك التطبيقات الصحيحة؟</a></li>
        <li><a href="#connection" class="text-blue-600 hover:underline">📶 اتصالك: eSIM، بطاقة SIM، أم تجوال؟</a></li>
        <li><a href="#vpn" class="text-blue-600 hover:underline">🔒 VPN الخاص بك: الوصول للإنترنت بحرية في الصين</a></li>
        <li><a href="#language" class="text-blue-600 hover:underline">🗣️ مهاراتك اللغوية: كم تحتاج من الصينية؟</a></li>
        <li><a href="#luggage" class="text-blue-600 hover:underline">🎒 أمتعتك: ما المختلف في السفر إلى الصين؟</a></li>
        <li><a href="#checklist" class="text-blue-600 hover:underline">✅ قائمة التحقق النهائية قبل المغادرة</a></li>
      </ul>
    </nav>

    <div class="prose prose-lg max-w-none">
      <hr class="border-gray-200 my-12" />

            <h2 id="phone-apps" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">📱</span> هاتفك: هل لديك التطبيقات الصحيحة؟
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">إليك الأمر بخصوص الصين: <strong>التطبيقات التي تستخدمها يومياً في المنزل لن تعمل هنا غالباً.</strong> خرائط Google تظهر اتجاهات خاطئة. WhatsApp لا يرسل رسائل. Uber غير موجود. ولا يمكنك الدفع ببطاقتك الائتمانية الأجنبية في معظم الأماكن.</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">ستحتاج لتحميل مجموعة جديدة من التطبيقات قبل وصولك — WeChat و Alipay للدفع، Didi للتنقل، Amap للملاحة، وغيرها.</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-12">لست متأكداً أيها تحتاج فعلاً؟ الدليل الكامل يشرح كل فئة ويخبرك بمهمة كل تطبيق.</p>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>📖 الدليل الكامل:</strong> <a href="/ar/life/essential-apps/" class="text-blue-600 hover:underline">10 تطبيقات تحتاجها قبل السفر إلى الصين</a></p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="connection" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">📶</span> اتصالك: eSIM، بطاقة SIM، أم تجوال؟
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">ستحتاج للإنترنت فور هبوطك — للخرائط، الترجمة، طلب السيارات، والمراسلة. السؤال هو: أي خيار يناسب هاتفك ومدة رحلتك.</p>

      <p class="text-lg font-bold text-gray-900 mb-4">ثلاث طرق للاتصال بالإنترنت في الصين:</p>

      <ul class="space-y-4 mb-12">
        <li class="flex items-start gap-3 bg-gray-50 rounded-xl p-4">
          <span class="text-blue-500 text-xl mt-0.5">📱</span>
          <div>
            <strong class="text-gray-900">eSIM</strong>
            <p class="text-gray-700 mt-1">اشتر عبر الإنترنت قبل السفر، فعّل عند الهبوط، لا حاجة لبطاقة فيزيائية. الأفضل إذا كان هاتفك يدعمه وتريد بدون عناء. هذا النوع من البطاقات عادةً يوفر بيانات فقط ويسمح باستخدام التطبيقات الخارجية مثل WhatsApp و YouTube. لكنه لا يمنحك رقماً صينياً. إذا كنت تخطط لاستخدام Didi أو طلب الطعام وغيرها من الخدمات التي تتطلب استقبال مكالمات، يُنصح بشراء بطاقة SIM فيزيائية.</p>
          </div>
        </li>
        <li class="flex items-start gap-3 bg-gray-50 rounded-xl p-4">
          <span class="text-green-500 text-xl mt-0.5">🆔</span>
          <div>
            <strong class="text-gray-900">بطاقة SIM سياحية</strong>
            <p class="text-gray-700 mt-1">اشترِ من كاونتر المطار بعد الهبوط. يتطلب جواز سفرك. يمنحك رقماً صينياً. ولكن بسبب قيود الشبكة المحلية، العديد من التطبيقات الأجنبية لن تعمل — ستحتاج لإعداد VPN <strong>قبل</strong> المغادرة.</p>
          </div>
        </li>
        <li class="flex items-start gap-3 bg-gray-50 rounded-xl p-4">
          <span class="text-purple-500 text-xl mt-0.5">🌍</span>
          <div>
            <strong class="text-gray-900">التجوال الدولي</strong>
            <p class="text-gray-700 mt-1">الأغلى ثمناً، لكن بدون أي إعداد. تحقق مع شركة الاتصالات أولاً.</p>
          </div>
        </li>
      </ul>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>📖 الدليل الكامل:</strong> <a href="/ar/life/sim-card-guide/" class="text-blue-600 hover:underline">أفضل بطاقة SIM و eSIM للسياح في الصين</a></p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="vpn" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🔒</span> VPN الخاص بك: الوصول للإنترنت بحرية في الصين
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">إليك حقيقة الأمر: <strong>Google، Instagram، WhatsApp، Facebook، YouTube — لا يعمل أي منها على الإنترنت المحلي الصيني.</strong> إذا كنت تعتمد على أي منها للتواصل أو العمل أو الترفيه، فأنت بحاجة لـ VPN يتم إعداده قبل وصولك.</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-12">الكلمة المفتاحية هي <strong>قبل</strong> — مواقع وتطبيقات VPN محجوبة داخل الصين، لذا لا يمكنك تحميلها بعد الهبوط.</p>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>📖 الدليل الكامل:</strong> <a href="/ar/life/vpn-guide/" class="text-blue-600 hover:underline">أفضل VPN للسفر في الصين</a></p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="language" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🗣️</span> مهاراتك اللغوية: كم تحتاج من الصينية؟
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">يمكنك بالتأكيد السفر في الصين دون التحدث بالصينية. لكنك ستستمتع أكثر — خدمة أفضل، أسعار أفضل، تفاعلات أفضل — إذا تعلمت حتى اثنتي عشرة عبارة.</p>

      <p class="text-lg font-bold text-gray-900 mb-4">التقسيم الصادق:</p>

      <ul class="space-y-4 mb-12">
        <li class="flex items-start gap-3 p-4 bg-orange-50 rounded-xl">
          <span class="text-orange-500 text-xl">😅</span>
          <div>
            <strong>صفر صينية:</strong> ستنجو. الإنجليزية شائعة في الفنادق والأماكن السياحية، لكن توقع الإحباط في المطاعم والمتاجر المحلية.
          </div>
        </li>
        <li class="flex items-start gap-3 p-4 bg-green-50 rounded-xl">
          <span class="text-green-500 text-xl">👍</span>
          <div>
            <strong>10–15 عبارة:</strong> ستكون بخير. القدرة على قول "شكراً"، "كم السعر؟"، و"الفاتورة من فضلك" تغير طريقة تعامل الناس معك.
          </div>
        </li>
        <li class="flex items-start gap-3 p-4 bg-blue-50 rounded-xl">
          <span class="text-blue-500 text-xl">🚀</span>
          <div>
            <strong>50+ عبارة:</strong> أنت متقدم على معظم المسافرين وستتنقل باستقلالية.
          </div>
        </li>
      </ul>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>📖 الدليل الكامل:</strong> <a href="/ar/life/chinese-phrases/" class="text-blue-600 hover:underline">عبارات صينية أساسية للمسافرين</a></p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="luggage" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🎒</span> أمتعتك: ما المختلف في السفر إلى الصين؟
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">التعبئة للصين لا تختلف كثيراً عن أي رحلة أخرى — لكن هناك بعض الأشياء التي تفاجئ الزوار الجدد:</p>

      <ul class="space-y-3 mb-12">
        <li class="flex items-start gap-3">
          <span class="text-red-500 text-xl">🚻</span>
          <span class="text-gray-700">المراحيض العامة غالباً لا تحتوي على ورق تواليت (احضر معك)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-500 text-xl">🗺️</span>
          <span class="text-gray-700">خرائط Google لن تعمل في الصين (حمّل خرائط محلية)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-500 text-xl">🌡️</span>
          <span class="text-gray-700">المناخ يختلف بشكل كبير بين الشمال والجنوب</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-500 text-xl">👟</span>
          <span class="text-gray-700">ستمشي أكثر مما تتوقع بكثير</span>
        </li>
      </ul>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>📖 الدليل الكامل:</strong> <a href="/ar/life/packing-guide/" class="text-blue-600 hover:underline">ماذا تأخذ معك إلى الصين — دليل الفصول والمناخ</a></p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="checklist" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">✅</span> قائمة التحقق النهائية قبل المغادرة
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">تم؟</th>
              <th class="px-6 py-4 font-bold">المهمة</th>
              <th class="px-6 py-4 font-bold">يساعد في</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">☐</td><td class="px-6 py-4">تحميل WeChat و Alipay، إعداد الدفع</td><td class="px-6 py-4">الدفع لكل شيء</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">☐</td><td class="px-6 py-4">تثبيت Didi، Amap، Trip.com</td><td class="px-6 py-4">التنقل</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">☐</td><td class="px-6 py-4">شراء eSIM أو التحقق من خطة التجوال</td><td class="px-6 py-4">البقاء متصلاً</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">☐</td><td class="px-6 py-4"><a href="/ar/life/vpn-guide/" class="text-blue-600 hover:underline">إعداد VPN</a></td><td class="px-6 py-4">الوصول للمواقع المحجوبة</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">☐</td><td class="px-6 py-4">تحميل حزمة Google Translate للاستخدام دون اتصال أو Pleco</td><td class="px-6 py-4">التواصل</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">☐</td><td class="px-6 py-4">تعلم 10 عبارات صينية أساسية</td><td class="px-6 py-4">التفاعلات اليومية</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">☐</td><td class="px-6 py-4">تعبئة باور بانك، مناديل، محول كهرباء</td><td class="px-6 py-4">تجنب المشاكل الشائعة</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">☐</td><td class="px-6 py-4">حفظ نسخ رقمية من جواز السفر + التأشيرة</td><td class="px-6 py-4">نسخ احتياطي للطوارئ</td></tr>
          </tbody>
        </table>
      </div>
    </div>

        <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 أدلة ذات صلة</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/ar/life/essential-apps/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">📱 10 تطبيقات تحتاجها قبل السفر إلى الصين</p>
          <p class="text-sm text-gray-600">مجموعة التطبيقات الأساسية للسفر في الصين</p>
        </a>
        <a href="/ar/life/sim-card-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">📶 أفضل بطاقة SIM و eSIM للسياح</p>
          <p class="text-sm text-gray-600">قارن بين جميع خيارات الاتصال</p>
        </a>
        <a href="/ar/life/vpn-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🔒 أفضل VPN للسفر في الصين</p>
          <p class="text-sm text-gray-600">ابقَ متصلاً بالتطبيقات التي تحتاجها</p>
        </a>
        <a href="/ar/life/packing-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🎒 ماذا تأخذ معك إلى الصين</p>
          <p class="text-sm text-gray-600">نصائح التعبئة حسب الفصل</p>
        </a>
      </div>
    </div>
  
    <!-- Sources -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <h3 class="text-xl font-bold text-gray-900 mb-4">المصادر</h3>
      <ul class="space-y-2 text-sm text-gray-600">
        <li>دليل تجميعي — المصادر موزعة عبر المقالات الفردية في هذا الموقع.</li>
      </ul>
    </div>
  </article>
</Layout>