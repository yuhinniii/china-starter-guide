---
import Layout from '@layouts/Layout.astro';
import FAQPage from '../../../components/FAQPage.astro';

const title = "ماذا تشتري في الصين 2026: دليل التسوق مع استرداد الضريبة";
const description = "ما الذي يستحق حقاً شراءه في الصين في 2026 — مستحضرات التجميل والعناية بالبشرة الصينية، وعلامات guochao، والإلكترونيات، والشاي، والحرير، والخزف، واليشم — بالإضافة إلى أين تتسوق وكيف تطالب بنحو 9% استرداد ضريبة عند المغادرة.";

const faqs = [
  {
    question: "ما الذي يعد فعلاً أرخص في الشراء من الصين؟",
    answer: "مستحضرات التجميل والعناية بالبشرة الصينية، والأجهزة الإلكترونية ذات العلامات الصينية (Huawei وXiaomi وDJI)، ونظارات الذكاء الاصطناعي والأجهزة القابلة للارتداء الذكية، وعلامات guochao المصممة، بالإضافة إلى الشاي، والحرير، والخزف، واليشم، والكلويسونيه. أما الأزياء العالمية، والعطور، والكاميرات، فهي بنفس السعر أو أعلى مما في بلدك."
  },
  {
    question: "هل يشمل التسوق في الصين استرداد الضريبة؟",
    answer: "نعم، في المتاجر التي تعرض لافتة Tax Free (退税商店). أنفق ما لا يقل عن ¥200 في متجر واحد في يوم واحد، واحتفظ بفاتورة ضريبة القيمة المضافة، واستردّ نحو 9% عند المطار عند المغادرة."
  },
  {
    question: "بماذا أنصحك بعدم الشراء من الصين؟",
    answer: "هواتف Apple iPhones وأجهزة MacBooks هي المثال الأوضح — سعر الصين أعلى وبعض الميزات محذوفة، لذا فإن استرداد الضريبة لا يسد الفجوة. أي شيء يمكنك إيجاده في بلدك بنفس المال هو عملية شراء مهدرة."
  }
];
---

<Layout title={title} description={description} lang="ar" type="Article">
  <nav class="mb-8 not-prose">
    <a href="/ar/payment/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
      <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      العودة إلى الدفع
    </a>
  </nav>

  <article class="max-w-4xl mx-auto px-6 py-12">
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🛍️ التسوق</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">التسوق في الصين: ما الذي يستحق الشراء في 2026</h1>
      <p class="text-xl text-gray-600 mb-6">الفئات التي تتفوق فيها الصين حقاً من حيث السعر، وتلك التي لا تتفوق، وكيفية استرداد نحو 9% عند المغادرة.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 آخر تحديث: أكتوبر 2026</span>
        <span>⏱️ 11 دقائق</span>
      </div>
    </header>

    <img
      src="/images/china-shopping/tax-free-sticker.webp"
      alt="لافتة زرقاء باللغة الصينية Tax Free (退税商店) موضوعة على منضدة متجر بجانب جهاز بطاقات"
      width="1080"
      height="809"
      class="w-full rounded-2xl mb-10 not-prose"
    />

    <div class="bg-gradient-to-r from-red-50 to-orange-50 border-l-4 border-red-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-red-900 mb-4">⚡ ما الذي يستحق الشراء في الصين؟</h2>
      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>إجابة سريعة:</strong> التزم بالفئات التي تكون أرخص فعلاً في الصين أو يصعب العثور عليها في بلدك — مستحضرات التجميل والعناية بالبشرة الصينية، والأجهزة الإلكترونية ذات العلامات الصينية (Huawei وXiaomi وDJI)، ونظارات الذكاء الاصطناعي والأجهزة القابلة للارتداء الذكية، والشاي، والحرير، والخزف، واليشم، وعلامات guochao المصممة، والحرف التقليدية. وتجنّب أي شيء يمكنك شراؤه في بلدك بنفس السعر — بما في ذلك منتجات Apple، التي ليست أرخص في الصين. تسوّق في المتاجر التي تعرض لافتة <strong>Tax Free (退税商店)</strong> واطلب فاتورة ضريبة القيمة المضافة (增值税发票)، ويمكنك استرداد نحو <strong>9% عائداً</strong> عند عودتك بالطائرة — راجع <a href="/ar/payment/tax-refund/" class="text-red-700 underline">دليل استرداد الضريبة عند المغادرة</a> للاطلاع على القواعد الحالية.</p>
      <p class="text-lg leading-relaxed text-gray-700">النسخة المختصرة من خطة التسوق أثناء الرحلة: اختر بضعة فئات مميزة حقاً هنا، اشترها من متاجر استرداد الضريبة، واقتطع نحو 9% عند المغادرة. إليك ما يستحق الشراء فعلاً — وأين تجده.</p>
    </div>

    <div class="bg-yellow-50 border-l-4 border-yellow-400 rounded-r-2xl p-6 mb-12 not-prose">
      <p class="text-lg leading-relaxed text-yellow-900"><strong>النسخة الصريحة:</strong> التسوق في الصين يؤتي ثماره فقط في مسارات ضيقة. فمعظم ما يشتريه السياح هنا — الأزياء العالمية، والعطور، والكاميرات — له نفس السعر أو أعلى مما في بلدانهم، ونادراً ما يغلق الاسترداد البالغ ~9% الفجوة. والفئات التي تتفوق فيها الصين فعلاً هي التي تحمل علامات صينية، لا مستوردة. وهناك احتكاكان آخران يجب توقعهما: الاسترداد يتطلب فاتورة ضريبة قيمة مضافة رسمية (增值税发票) لا تستطيع الأكشاك الصغيرة إصدارها، وأسواق السياح تبيع مقلدات مقنعة. اشترِ من متاجر العلامات التجارية والكوات المصرحة، لا من الباعة المتجولين الذين يعدونك بصفقة.</p>
    </div>

    <h2 id="whats-worth-buying" class="text-3xl font-bold text-gray-900 mb-6 mt-14">ما الذي يستحق الشراء في الصين؟</h2>
    <p class="text-lg leading-relaxed text-gray-700 mb-8">هناك أساساً خمس فئات تتفوق فيها الصين فعلاً من حيث السعر والتشكيلة معاً، حيث تكون متاجر استرداد الضريبة كثيفة بما يكفي لجعل الاسترداد يستحق عناء الأوراق. التزم بهذه الفئات وستعود إلى بلدك بحصيلة ممتازة.</p>

    <h3 id="cosmetics-skincare" class="text-2xl font-bold text-gray-900 mb-5 mt-10">مستحضرات التجميل والعناية بالبشرة</h3>

    <img
      src="/images/china-shopping/maogeping-counter.webp"
      alt="كاونتر مستحضرات تجميل MAOGEPING داخل متجر صيني كبير، محاط بعلامات تجميل أخرى"
      width="1080"
      height="810"
      loading="lazy"
      class="w-full mb-6 md:float-left md:mr-6 md:mb-4 md:w-2/5 h-72 object-cover rounded-2xl"
    />

    <p class="text-lg leading-relaxed text-gray-700 mb-6">إليك الجزء الذي تخطئ معظم أدلة التسوق في فهمه. <strong>تكمن ميزة السعر في الصين للعلامات الصينية، لا لـ Chanel.</strong> فعبوة سيروم من Lancôme على كاونتر متجر صيني كبير تحمل رسوم الاستيراد، وضريبة الاستهلاك بنسبة 15% على مستحضرات التجميل الفاخرة، وضريبة القيمة المضافة 13% — وكلها مكدّسة في السعر المعلن. ولهذا السبب تكلف عادة أكثر هنا مما في باريس، لا أقل. والمكان الوحيد الذي تصبح فيه العلامات الدولية رخيصة فعلاً هو المعفاة من الرسوم: بدل الإعفاء البحري في هاينان (¥100,000 في السنة، 30 صنفاً من مستحضرات التجميل لكل رحلة) ومتاجر الإعفاء من الرسوم في المطار، التي تزيل الضرائب الثلاث جميعها.</p>

    <p class="text-lg leading-relaxed text-gray-700 mb-4"><strong>مستحضرات التجميل والعناية بالبشرة الصينية — حيث يذهب مالك أبعد فعلاً</strong></p>
    <p class="text-lg leading-relaxed text-gray-700 mb-4">تحدّد العلامات المحلية أسعارها للسوق المحلي، فلا تحمل ضريبة استيراد، وتخفض الأسعار بقوة خلال 618 وDouble 11. وعدة علامات منها باتت جيدة فعلاً الآن، لا رخيصة فحسب:</p>
    <ul class="list-disc pl-6 space-y-2 text-lg leading-relaxed text-gray-700 mb-6">
      <li><strong>Proya (珀莱雅)</strong> — جوهر مكافحة الشيخوخة المزدوجة (双抗精华) وسيروم الياقوت هما الاثنان اللذان يشتريهما الجميع؛ بنحو ¥200–400 للزجاجة.</li>
      <li><strong>Winona (薇诺娜)</strong> — مصممة للبشرة الحساسة سريعة التفاعل. وكريم الترطيب هو ما تأخذه معك إلى بلدك إذا كانت بشرتك تكره الطائرات.</li>
      <li><strong>Comfy (可复美)</strong> وخطا <strong>Bio-MESO (润百颜) / QUADI (夸迪)</strong> من Bloomage — خطوط الكولاجين المُعاد تركيبها وحمض الهيالورونيك، وهي فئة تتصدرها الصين حالياً.</li>
      <li><strong>Florasis (花西子)</strong> — علب أحمر الشفاه المنقوشة والبودرة المضغوطة. والتغليف هو التذكار.</li>
      <li><strong>MAOGEPING (毛戈平)</strong> — كريم الإبراز ولوحات التظليل؛ هذا ما يستخدمه خبراء التجميل الصينيون فعلاً على مواقع التصوير.</li>
      <li><strong>To Summer (观夏)</strong> — عطر صيني الرائحة ومعطرات المنزل، بأزهار الأوسمانthus والشاي والأرز. لا يُباع شيء شبيهاً به في الخارج.</li>
    </ul>
    <p class="text-lg leading-relaxed text-gray-700 mb-6">تحفظان اثنتان. فدرجات اللون مصممة لدرجات البشرة الشرق آسيوية، لذا غالباً ما تغيب أعمق درجات كريم الأساس. وتنتشر ادعاءات التفتيح على هذه الفئة بأكملها — اقرأ قائمة المكونات، لا واجهة العلبة.</p>

    <p class="text-lg leading-relaxed text-gray-700 mb-4 clear-both"><strong>العلامات الدولية — اشترِ أحجام وإصدارات آسيا الحصرية والهدايا، لا السعر المعلن</strong></p>
    <p class="text-lg leading-relaxed text-gray-700 mb-4">إذا أردت La Mer أو SK-II، فالمعادلة لا تعمل إلا في المعفاة من الرسوم. ومما يستحق الصيد على الكاونتر العادي شيء آخر:</p>
    <ul class="list-disc pl-6 space-y-2 text-lg leading-relaxed text-gray-700 mb-6">
      <li><strong>أحجام ومجموعات حصرية لآسيا.</strong> إصدارات أعلى من 100مل من الأكثر مبيعاً، ومجموعات السفر، وحزم المزدوج التي لا تُشحن أبداً إلى أوروبا أو الولايات المتحدة.</li>
      <li><strong>إصدارات رأس السنة القمرية و520 المحدودة.</strong> تطرح Chanel وDior وEstée Lauder جميعها تغليفاً خاصاً بسوق الصين كل يناير وحول 20 مايو. نفس المنتج، وقارورة مختلفة، ولا يُعاد طرحها.</li>
      <li><strong>الهدايا مع الشراء السخية فعلاً.</strong> توزّع قاعات التجميل في المتاجر الكبرى عينات صغيرة وتجريبية بعتبات أقل بكثير مما في أوروبا، وكثيراً ما يضيف موظفو الكاونتر المزيد إذا اشتريت صنفين وسألت. وSephora الصين تعمل بنفس المنطق.</li>
    </ul>

    <p class="text-lg leading-relaxed text-gray-700 mb-4"><strong>أين تتسوق:</strong></p>
    <ul class="list-disc pl-6 space-y-2 text-lg leading-relaxed text-gray-700 mb-6">
      <li><strong>العلامات الصينية:</strong> متاجرها الخاصة ومتاجر Tmall الرسمية، بالإضافة إلى كاونترات المولات في المدن الكبرى.</li>
      <li><strong>قاعات التجميل في المتاجر الكبرى</strong> — Wangfujing (王府井) وShin Kong Place (新光天地) وPlaza 66 (恒隆广场) وMixC (万象城). الأفضل للعينات بحجمها الكامل، والهدايا مع الشراء، وكتابة فاتورة ضريبة القيمة المضافة (增值税发票) عند الطلب.</li>
      <li><strong>Sephora (丝芙兰)</strong> — التشكيلة الدولية بالإضافة إلى جدار متنامٍ من العلامات الصينية.</li>
      <li><strong>المعفاة من الرسوم:</strong> متاجر الإعفاء البحرية في هاينان ومتاجر الإعفاء من الرسوم في المطار عند المغادرة. المكان الوحيد الذي يهزم فيه سعر العلامة الدولية سعر البلد الأم.</li>
    </ul>

    <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>حساب الضريبة، لتتحقق بنفسك:</strong> تقع مستحضرات التجميل في الشريحة القياسية لضريبة القيمة المضافة 13%، ويُرجع الاسترداد عند المغادرة نحو 9% من السعر المعلن بعد الرسوم — فعملية شراء بـ ¥1,000 تعطيك نحو ¥90 عائداً، لا ¥130. وعلى حدة، فأي سلعة يبلغ سعرها ¥10/ml فأعلى تحمل أيضاً ضريبة الاستهلاك على مستحضرات التجميل الفاخرة بنسبة 15% في مرحلة الاستيراد. وهذه الرسوم الإضافية هي سبب ارتفاع سعر الكاونتر، وسبب تفوق المعفاة من الرسوم عليه.</p>

    <hr class="border-gray-200 my-12" />

    <h3 id="guochao" class="text-2xl font-bold text-gray-900 mb-5 mt-10">Guochao والعلامات المحلية ذات التصميم الرائد</h3>

    <img
      src="/images/china-shopping/pop-mart-store.webp"
      alt="واجهة متجر Pop Mart في مول صيني، يتوسطها جذعان شجريان منحوتان بتماثيل قابلة للجمع"
      width="940"
      height="625"
      loading="lazy"
      class="w-full mb-6 md:float-left md:mr-6 md:mb-4 md:w-2/5 h-72 object-cover rounded-2xl"
    />

    <p class="text-lg leading-relaxed text-gray-700 mb-6">"Guochao" (国潮، موجة العلامات المحلية) هي أحدث إضافة لقوائم "يجب شراؤها" الرسمية: في مؤتمرها الصحفي في سبتمبر 2026 ذكرت وزارة التجارة المنتجات الذكية ذات العلامات المحلية والعلامات ذات التصميم الرائد كسبب رئيسي لما يتسوق به الزوار الأجانب الآن في الصين. افكر في علامات الملابس الرياضية والشارعية الرائدة، وأدوات وتجهيزات المنزل المصممة، ولعب المصممين القابلة للجمع — وتماثيل بأسلوب Pop Mart هي المثال الأشهر لعلامة صينية المنشأ بسوق إعادة بيع خارجي قوي.</p>
    <p class="text-lg leading-relaxed text-gray-700 mb-6">أين تتسوق: متاجر العلامات في الأحياء التجارية الرئيسية (طريق Nanjing East Road (南京东路) في شنغهاي وJing'an (静安)، وWangfujing (王府井) في بكين، وما إلى ذلك) ومتاجر المفهوم الرائدة في المولات الكبرى. نفس قواعد الاسترداد كبقية السلع — اطلب فاتورة ضريبة القيمة المضافة (增值税发票) عند الصندوق. وفحصان عمليان قبل الشراء: المقاسات أصغر من القصات الغربية في كثير من العلامات المحلية، وأي إلكترونيات داخل المنتج (مواصفات الشحن، مناطق التطبيق) قد تختلف عن سوق بلدك.</p>

    <hr class="border-gray-200 my-12" />

    <h3 id="electronics" class="text-2xl font-bold text-gray-900 mb-5 mt-10">الإلكترونيات الصينية (لكن تخطَّ Apple)</h3>

    <img
      src="/images/china-shopping/dji-store.webp"
      alt="داخل متجر DJI الرائد بطائرات مسيرة معروضة على طاولات خشب فاتح تحت سقف زجاجي كبير"
      width="1200"
      height="800"
      loading="lazy"
      class="w-full mb-6 md:float-left md:mr-6 md:mb-4 md:w-2/5 h-72 object-cover rounded-2xl"
    />

    <p class="text-lg leading-relaxed text-gray-700 mb-6">الفوز الحقيقي هنا هو في رؤوس العلامات الصينية — Huawei (Mate XT وMate X وPura 70 Ultra) وXiaomi (15 Ultra و14 series) وOPPO Find X8 Ultra وسلسلة Vivo X100 وطائرات DJI المسيرة والجيمبال وسلسلة Honor Magic. وكثير منها لا يُباع في الخارج أو يُسعَّر بوضوح أقل محلياً. وتتأهل أيضاً العلامات الدولية مثل Sony وBose وGoPro وأجهزة Nintendo Switch لاسترداد الضريبة غالباً، وأرخص قليلاً من الخارج في أغلب الأحيان.</p>
    <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>النجوم الصاعدة لعام 2026:</strong> نظارات الذكاء الاصطناعي، والأجهزة القابلة للارتداء الذكية، والهواتف القابلة للطي، هي الفئات التي تبرزها وزارة التجارة الآن صراحةً كـ"مشتريات يجب" للأجانب. وتُباع رؤوس الطي (Huawei Mate XT وXiaomi MIX) أرخص محلياً في أغلب الأحيان من أي مكان آخر، وكثيراً ما لا تكون نظارات الذكاء الاصطناعي والأساور الذكية من العلامات الصينية قد أُطلقت في سوق بلدك أصلاً. وتبقى التحفظات ذاتها: تحقق من أن مواصفات النطاق/الاتصال تعمل في بلدك، وأكّد ضماناً دولياً لكل SKU قبل الشراء.</p>
    <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>تخطَّ Apple.</strong> هاتف iPhone للسوق الصيني أغلى عادةً قليلاً من الولايات المتحدة، والنسخة الصينية تفتقر أيضاً إلى مكالمات FaceTime الصوتية. ولا توجد ميزة استرداد الضريبة للتعويض عن ذلك. والأمر نفسه ينطبق على أجهزة MacBooks ومعظم كاميرات Canon/Nikon.</p>
    <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>أين تتسوق:</strong> متاجر العلامات الرائدة في كل مول كبير — تديرها Huawei وXiaomi وOPPO وDJI وDyson جميعها، وهي الخيار المتكامل للزوار الأجانب: يتحدث الموظفون عادةً بعض الإنجليزية، وتُصدر فاتورة ضريبة القيمة المضافة (增值税发票) في الموقع، وتحمل الطرز الفاخرة ضماناً دولياً (تحقق من SKU المحدد إذا كان ذلك يهمك). اسأل دائماً عن الفاتورة — فبدونها لا يمكنك المطالبة باسترداد الضريبة.</p>
    <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>مدينة واحدة يكون فيها سوق الإلكترونيات بحد ذاته هو الجذب: Huaqiangbei (华强北) في شنتشن.</strong> أعاد أكبر حي إلكترونيات في العالم اختراع نفسه كمحطة للمتسوقين الأجانب — فقد كان يجتذب آلاف الزوار الدوليين يومياً طوال 2025، وتحتفظ العلامات الكبرى الآن بمتاجر رائدة داخل السوق نفسه (بما فيها DJI). وهو سوق إلكترونيات نادر يعمل فعلاً للمسافرين الذين لا يتحدثون الصينية: لافتات متعددة اللغات، وعدادات صرف العملة، ودعم استرداد الضريبة كلها متوفرة. وإذا كانت شنتشن قريبة من مسارك بأي حال، فوحده التناقض — مدينة بنيت من العدم في أربعين عاماً، ولا تزال ت humming عند منتصف الليل — يستحق نظرة. <a href="/ar/cities/shenzhen-guide/" class="text-brand-600 hover:underline">راجع دليل السفر في شنتشن</a> لمعرفة كيفية إدراجها في جدولك.</p>
    <p class="text-lg leading-relaxed text-gray-700 mb-4"><strong>فحص سريع قبل دفع ثمن أي جهاز</strong></p>
    <ul class="list-disc pl-6 space-y-2 text-lg leading-relaxed text-gray-700 mb-6">
      <li><strong>نطاقات الشبكة</strong> — قد لا يحمل هاتف مباع للسوق الصيني نطاقات 4G/5G التي يستخدمها مشغلك في بلدك. افتح ورقة مواصفات الطراز وقارن قبل الالتزام.</li>
      <li><strong>التطبيقات والنظام البيئي</strong> — غالباً ما تعمل هواتف السوق الصيني دون خدمات Google. وإذا كنت تعيش على تطبيقات Google، فتأكد من أن الجهاز يأتي بالنظام البيئي الذي تحتاجه، أو اشتر نسخة دولية/عالمية.</li>
      <li><strong>الضمان</strong> — التغطية الدولية لكل SKU، لا لكل علامة، لذا اسأل عن الأسواق التي يغطيها الضمان فعلاً.</li>
    </ul>
    <p class="text-lg leading-relaxed text-gray-700 mb-6">لا شيء من هذا عائقاً حقيقياً في العلامات الكبرى — إنه فقط الفرق بين شراء ممتاز وآخر لا يساوي شيئاً عند عودتك إلى بلدك.</p>

