---
import Layout from '@layouts/Layout.astro';
const title = 'دليل الدفع — كيفية الدفع في الصين';
const description = 'قم بإعداد Alipay قبل السفر — فهو يغطي 95% من المدفوعات.';
---

<Layout title={title} description={description} lang="ar">
  <section class="max-w-4xl mx-auto px-6 py-12" dir="rtl">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">💳 الدفع</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">الدفع في الصين</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">قم بإعداد Alipay قبل السفر — فهو يغطي 95% من المدفوعات.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">2</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">تطبيقات الدفع عبر الجوال</p>
      </div>
      <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-indigo-800">2</p>
        <p class="text-xs font-semibold text-indigo-800 uppercase tracking-wide mt-1">أدلة الإعداد</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">دليل البطاقات الائتمانية</p>
      </div>
      <div class="bg-pink-50 border border-pink-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-pink-800">1</p>
        <p class="text-xs font-semibold text-pink-800 uppercase tracking-wide mt-1">دليل الإكراميات</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">البدء</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 مقال</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/payment/setup-alipay/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💰 دليل</span>
            <p class="text-base font-bold text-gray-900 mt-1">كيفية إعداد Alipay للأجانب</p>
            <p class="text-sm text-gray-600 mt-0.5">قم بالتحميل والتسجيل برقمك الدولي واربط بطاقتك الائتمانية الأجنبية.</p>
          </a>
          <a href="/ar/payment/setup-wechat/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💬 دليل</span>
            <p class="text-base font-bold text-gray-900 mt-1">كيفية إعداد WeChat Pay للأجانب</p>
            <p class="text-sm text-gray-600 mt-0.5">قم بتحميل WeChat، وسجل، وتحقق من هويتك، واربط بطاقتك الدولية.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-indigo-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-indigo-800">استخدام البطاقات الدولية</h2>
          <span class="text-xs font-medium text-indigo-800 opacity-60">1 مقال</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/payment/foreign-cards/" class="block bg-indigo-50 border border-indigo-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-indigo-800">💳 دليل</span>
            <p class="text-base font-bold text-gray-900 mt-1">هل يمكن استخدام البطاقات الائتمانية الأجنبية في الصين؟</p>
            <p class="text-sm text-gray-600 mt-0.5">أين تعمل بطاقة Visa أو Mastercard فعلياً، وتكاليف السحب من الصراف الآلي.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">المشكلات الشائعة</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 مقال</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/payment/payment-fails/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🔧 حل المشكلات</span>
            <p class="text-base font-bold text-gray-900 mt-1">ماذا تفعل عندما تفشل عملية الدفع</p>
            <p class="text-sm text-gray-600 mt-0.5">أسباب فشل الدفع الشائعة وحلول خطوة بخطوة.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-pink-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-pink-800">الإكراميات والثقافة</h2>
          <span class="text-xs font-medium text-pink-800 opacity-60">1 مقال</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/payment/tipping/" class="block bg-pink-50 border border-pink-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-pink-800">🎭 ثقافة</span>
            <p class="text-base font-bold text-gray-900 mt-1">ثقافة الإكراميات في الصين: هل تحتاج إلى البقشيش؟</p>
            <p class="text-sm text-gray-600 mt-0.5">لا، الإكراميات ليست متوقعة في الصين. دليل سريع لما يجب فعله.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">الدليل الكامل</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 مقال</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/payment/payment-guide/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">📖 نظرة عامة</span>
            <p class="text-base font-bold text-gray-900 mt-1">كيفية الدفع في الصين: الدليل الكامل</p>
            <p class="text-sm text-gray-600 mt-0.5">Alipay، WeChat Pay، النقد، أو البطاقات الائتمانية — نظرة عامة شاملة.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">أدلة ذات صلة</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/ar/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">النقل في الصين</p>
          <p class="text-sm text-gray-500">القطارات، المترو، سيارات الأجرة، واستئجار الركوب</p>
        </a>
        <a href="/ar/life/essential-apps/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">التطبيقات الأساسية للصين</p>
          <p class="text-sm text-gray-500">تطبيقات لا غنى عنها للسفر في الصين</p>
        </a>
      </div>
    </div>
  </section>
</Layout>