---
import Layout from '@layouts/Layout.astro';
const title = 'دليل النقل — التجول في الصين';
const description = 'القطارات، الطائرات، المترو، واستئجار الركوب — كل ما تحتاجه.';
---

<Layout title={title} description={description} lang="ar">
  <section class="max-w-5xl mx-auto px-6 py-12" dir="rtl">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">النقل في الصين</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">القطارات، الطائرات، المترو، واستئجار الركوب — كل ما تحتاجه.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-sky-50 border border-sky-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-sky-800">1</p>
        <p class="text-xs font-semibold text-sky-800 uppercase tracking-wide mt-1">دليل القطار فائق السرعة</p>
      </div>
      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-emerald-800">1</p>
        <p class="text-xs font-semibold text-emerald-800 uppercase tracking-wide mt-1">الانتقال من المطار</p>
      </div>
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">3</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">النقل داخل المدينة</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-gray-800">1</p>
        <p class="text-xs font-semibold text-gray-800 uppercase tracking-wide mt-1">دليل استئجار الركوب</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-sky-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-sky-800">التجول في الصين</h2>
          <span class="text-xs font-medium text-sky-800 opacity-60">1 مقال</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/transport/transport-guide/" class="block bg-sky-50 border border-sky-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-sky-800">📖 نظرة عامة</span>
            <p class="text-base font-bold text-gray-900 mt-1">كيفية التجول في الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">نظرة عامة كاملة عن جميع خيارات النقل — القطارات، الطائرات، المترو، والمزيد.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">الوصول إلى الصين</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 مقال</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/transport/airport-to-city/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🛬 دليل</span>
            <p class="text-base font-bold text-gray-900 mt-1">من المطار إلى المدينة</p>
            <p class="text-sm text-gray-600 mt-0.5">خيارات النقل في المطارات الرئيسية — بكين، شنغهاي، قوانغتشو، والمزيد.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">النقل في المدينة</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">3 مقال</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/transport/high-speed-rail/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚄 دليل</span>
            <p class="text-base font-bold text-gray-900 mt-1">كيفية حجز وركوب القطار فائق السرعة في الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">كل شيء عن حجز وركوب أكبر شبكة قطارات فائقة السرعة في العالم.</p>
          </a>
          <a href="/ar/transport/flights-vs-rail/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">✈️ دليل</span>
            <p class="text-base font-bold text-gray-900 mt-1">الطائرات مقابل القطار فائق السرعة</p>
            <p class="text-sm text-gray-600 mt-0.5">قطار أم طائرة لرحلتك في الصين؟ مقارنة مدعومة بالأرقام.</p>
          </a>
          <a href="/ar/transport/metro-bus/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚇 دليل</span>
            <p class="text-base font-bold text-gray-900 mt-1">دليل المترو والحافلات للمدن الكبرى</p>
            <p class="text-sm text-gray-600 mt-0.5">التنقل في وسائل النقل العام في بكين، شنغهاي، قوانغتشو، وشنتشن.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">استئجار الركوب</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 مقال</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/transport/didi/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">🚕 دليل</span>
            <p class="text-base font-bold text-gray-900 mt-1">كيفية استخدام Didi في الصين كأجنبي</p>
            <p class="text-sm text-gray-600 mt-0.5">دليل خطوة بخطوة لاستخدام DiDi، أوبر الصين — مع لقطات شاشة.</p>
          </a>
        </div>
      </div>
    </div>

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">الخطوة التالية</p>
            <h3 class="text-xl font-bold text-gray-900">اكتشف المدن الصينية</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">تعرف على كيفية التنقل. الآن اختر وجهتك — ابدأ بدليل مقارنة المدن.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/ar/cities/city-select/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🗺️ مقارنة المدن
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/ar/cities/shenzhen-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              📍 دليل شنتشن
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>