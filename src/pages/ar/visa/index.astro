---
import Layout from '@layouts/Layout.astro';
const title = 'الاستعداد للصين — دليل الدخول والإعداد';
const description = 'كل ما يجب تحضيره قبل رحلتك إلى الصين.';
---

<Layout title={title} description={description} lang="ar">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">✅ استعد</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">الاستعداد لرحلتك إلى الصين</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">كل ما يجب تحضيره قبل رحلتك إلى الصين.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">5</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">التأشيرة والدخول</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">الإعداد الرقمي</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">4</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">قبل الطيران</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">التأشيرة والدخول</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">5 مقالات</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/visa/visa-guide/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📖 نظرة عامة</span>
            <p class="text-base font-bold text-gray-900 mt-1">الدليل الكامل لأنواع تأشيرات الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">جميع خيارات التأشيرات موضحة — قارن بين الإعفاء والعبور وتأشيرة L.</p>
          </a>
          <a href="/ar/visa/visa-free/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📋 قائمة</span>
            <p class="text-base font-bold text-gray-900 mt-1">قائمة الدول المعفاة من تأشيرة الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">50 دولة يمكنها الدخول بدون تأشيرة لمدة تصل إلى 30 يوماً.</p>
          </a>
          <a href="/ar/visa/transit-240/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">✈️ عبور</span>
            <p class="text-base font-bold text-gray-900 mt-1">العبور بدون تأشيرة لمدة 240 ساعة</p>
            <p class="text-sm text-gray-600 mt-0.5">55 دولة مؤهلة — أقم لمدة تصل إلى 10 أيام بدون تأشيرة.</p>
          </a>
          <a href="/ar/visa/mutual-agreement/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🤝 متبادل</span>
            <p class="text-base font-bold text-gray-900 mt-1">اتفاقيات الإعفاء المتبادل من التأشيرة</p>
            <p class="text-sm text-gray-600 mt-0.5">29 دولة لديها اتفاقيات إعفاء متبادل مع الصين.</p>
          </a>
          <a href="/ar/visa/apply-l-visa/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📝 طلب</span>
            <p class="text-base font-bold text-gray-900 mt-1">كيفية التقديم على تأشيرة سياحية للصين</p>
            <p class="text-sm text-gray-600 mt-0.5">دليل خطوة بخطوة — المستندات، نموذج COVA، الرسوم، والنصائح.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">الإعداد الرقمي</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1 مقالة</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/life/sim-card-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">📶 إنترنت</span>
            <p class="text-base font-bold text-gray-900 mt-1">أفضل بطاقة SIM و eSIM للسياح</p>
            <p class="text-sm text-gray-600 mt-0.5">قارن بين مزودي eSIM وبطاقات SIM في المطار وخطط البيانات.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">قبل الطيران</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">4 مقالات</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ar/visa/customs-guide/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🛃 اللوائح</span>
            <p class="text-base font-bold text-gray-900 mt-1">لوائح الجمارك الصينية</p>
            <p class="text-sm text-gray-600 mt-0.5">حدود الإعفاء الجمركي، العناصر المحظورة، وما يجب التصريح به.</p>
          </a>
          <a href="/ar/visa/arrival-card/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">📄 بطاقة الوصول</span>
            <p class="text-base font-bold text-gray-900 mt-1">تقديم بطاقة الوصول عبر الإنترنت</p>
            <p class="text-sm text-gray-600 mt-0.5">املأ بطاقة وصول NIA قبل الطيران — خطوة بخطوة مع لقطات شاشة.</p>
          </a>
          <a href="/ar/life/survival-kit/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🎒 قائمة التجهيز</span>
            <p class="text-base font-bold text-gray-900 mt-1">حقيبة النجاة لرحلتك إلى الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">قائمة تجهيز كاملة قبل المغادرة — المستندات والتطبيقات وما يجب حزمه.</p>
          </a>
          <a href="/ar/visa/first-time-china/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🌟 أول مرة</span>
            <p class="text-base font-bold text-gray-900 mt-1">أول مرة في الصين</p>
            <p class="text-sm text-gray-600 mt-0.5">جدول زمني كامل — التأشيرة، الإعداد الرقمي، التجهيز، الوصول، أول 24 ساعة.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">أدلة ذات صلة</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/ar/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">الدفع في الصين</p>
          <p class="text-sm text-gray-500">إعداد Alipay والمزيد</p>
        </a>
        <a href="/ar/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">النقل في الصين</p>
          <p class="text-sm text-gray-500">التنقل في البلاد</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
