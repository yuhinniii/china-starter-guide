---
import Layout from '@layouts/Layout.astro';
const title = 'شرح العبور بدون تأشيرة في الصين لمدة 240 ساعة (2026) — China Starter Hub';
const description = 'كل ما تحتاج معرفته عن سياسة العبور بدون تأشيرة لمدة 240 ساعة في الصين.';
---

<Layout title={title} description={description} lang="ar">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/ar/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        العودة إلى الاستعداد
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">📋 الدخول والتأشيرة</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        شرح العبور بدون تأشيرة في الصين لمدة 240 ساعة
      </h1>
      <p class="text-xl text-gray-600 mb-6">هل يمكنك زيارة الصين لمدة تصل إلى 10 أيام بدون تأشيرة؟</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 آخر تحديث: يونيو 2026</span>
        <span>⏱️ 7 دقائق قراءة</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 إجابة سريعة</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        <strong>نعم — في كثير من الحالات.</strong> سياسة العبور بدون تأشيرة لمدة 240 ساعة في الصين تتيح للمسافرين المؤهلين البقاء في المناطق المسموح بها لمدة تصل إلى 10 أيام أثناء السفر إلى دولة أو منطقة ثالثة.你需要 جواز سفر من إحدى 55 دولة مؤهلة وتذكرة سفر مؤكدة للوجهة التالية.
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 في هذا الدليل</h3>
      <ul class="space-y-3">
        <li><a href="#requirements" class="text-blue-600 hover:underline">✅ للتأهل، يجب أن تستوفي جميع هذه المتطلبات</a></li>
        <li><a href="#routes" class="text-blue-600 hover:underline">🔄 المسارات المؤهلة مقابل غير المؤهلة</a></li>
        <li><a href="#countries" class="text-blue-600 hover:underline">🌍 ما الدول المؤهلة؟</a></li>
        <li><a href="#ports" class="text-blue-600 hover:underline">✈️ أين يمكنك الدخول والخروج من الصين؟</a></li>
        <li><a href="#documents" class="text-blue-600 hover:underline">📄 ما المستندات التي تحتاجها؟</a></li>
      </ul>
    </nav>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">
      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        <strong>نعم — في كثير من الحالات.</strong>
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        سياسة العبور بدون تأشيرة لمدة 240 ساعة في الصين تتيح للمسافرين المؤهلين البقاء في المناطق المسموح بها من الصين لمدة تصل إلى 10 أيام أثناء السفر إلى دولة أو منطقة ثالثة. بالنسبة للعديد من الزوار، هذه إحدى أسهل الطرق لرؤية الصين دون التقديم على تأشيرة تقليدية.
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 id="requirements" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">✅</span> للتأهل، يجب أن تستوفي جميع هذه المتطلبات
      </h2>

      <div class="space-y-4 mb-8 not-prose">
        <div class="flex items-start gap-3 p-5 bg-green-50 border border-green-200 rounded-xl">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-green-200 text-green-700 text-sm flex items-center justify-center font-bold">✓</span>
          <div>
            <p class="font-medium text-gray-900">جواز سفر عادي ساري المفعول</p>
            <p class="text-sm text-gray-600">من إحدى 55 دولة مؤهلة؛ يجب أن تكون صلاحية الجواز 3 أشهر على الأقل من تاريخ وصولك</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-5 bg-blue-50 border border-blue-200 rounded-xl">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-200 text-blue-700 text-sm flex items-center justify-center font-bold">✓</span>
          <div>
            <p class="font-medium text-gray-900">خط سير مؤهل</p>
            <p class="text-sm text-gray-600">الدولة أ → mainland الصين → دولة/منطقة مختلفة (لا يمكنك العودة مباشرة إلى بلدك الأصلي)</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-5 bg-purple-50 border border-purple-200 rounded-xl">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-purple-200 text-purple-700 text-sm flex items-center justify-center font-bold">✓</span>
          <div>
            <p class="font-medium text-gray-900">تذكرة سفر مؤكدة للوجهة التالية</p>
            <p class="text-sm text-gray-600">تاريخ مغادرة ومقعد محددين، والمغادرة خلال 240 ساعة</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-5 bg-orange-50 border border-orange-200 rounded-xl">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-orange-200 text-orange-700 text-sm flex items-center justify-center font-bold">✓</span>
          <div>
            <p class="font-medium text-gray-900">منافذ الدخول/الخروج المعتمدة</p>
            <p class="text-sm text-gray-600">الدخول والخروج عبر منافذ العبور المعتمدة رسمياً خلال الحد الزمني المسموح به</p>
          </div>
        </div>
      </div>

      <div class="bg-yellow-50 border-r-4 border-yellow-400 p-5 rounded-l-xl mb-8 not-prose">
        <p class="text-yellow-900 m-0"><strong>مهم:</strong> هذه سياسة عبور بحتة، وليست دخولاً سياحياً عاماً بدون تأشيرة.</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="routes" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🔄</span> المسارات المؤهلة مقابل غير المؤهلة
      </h2>

      <div class="grid md:grid-cols-2 gap-4 mb-8 not-prose">
        <div class="bg-green-50 border border-green-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-green-700 mb-3">✅ مؤهل (عبور صالح)</p>
          <ul class="space-y-1 text-sm text-gray-700 pr-4 list-disc">
            <li>المملكة المتحدة → شنغهاي → اليابان</li>
            <li>الولايات المتحدة → بكين → كوريا الجنوبية</li>
            <li>أستراليا → غوانغتشو → تايلاند</li>
          </ul>
        </div>
        <div class="bg-red-50 border border-red-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-red-600 mb-3">❌ غير مؤهل (ذهاب وعودة)</p>
          <ul class="space-y-1 text-sm text-gray-700 pr-4 list-disc">
            <li>المملكة المتحدة → شنغهاي → المملكة المتحدة</li>
            <li>الولايات المتحدة → بكين → الولايات المتحدة</li>
            <li>اليابان → شنغهاي → اليابان</li>
          </ul>
        </div>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🏛️</span> هل هونغ كونغ / ماكاو / تايوان تُعتبر منطقة ثالثة؟
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        <strong>نعم.</strong> وفقاً للقواعد الرسمية للهجرة، تُعتبر هونغ كونغ وماكاو وتايوان وجهات ثالثة منفصلة لأهلية العبور.
      </p>

      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-5 mb-8 not-prose">
        <p class="text-gray-700"><strong>مثال:</strong> المملكة المتحدة → شنغهاي → هونغ كونغ = مسار عبور صالح.</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">⏱️</span> كم يمكنك البقاء؟
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-2">
        <strong>أقصى إقامة:</strong> 240 ساعة (10 أيام).
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        <strong>متى يبدأ العد؟</strong> يبدأ العد التنازلي عند منتصف ليل اليوم التقويمي التالي لدخولك (بتوقيت الصين، GMT+8) — وليس عندما تهبط طائرتك فعلياً.
      </p>

      <div class="bg-yellow-50 border-r-4 border-yellow-400 p-5 rounded-l-xl mb-8 not-prose">
        <p class="text-yellow-900"><strong>نصيحة:</strong> إذا وصلت في وقت متأخر من المساء، ستحصل على بعض الوقت الإضافي الفعلي يتجاوز الـ 10 أيام التقويمية الكاملة.</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="countries" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🌍</span> ما الدول المؤهلة؟
      </h2>

      <p class="text-gray-700 mb-6">الإجمالي: <strong>55 دولة</strong>.</p>

      <div class="space-y-4 mb-8 not-prose">
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-blue-800 mb-2">أوروبا (40 دولة)</p>
          <p class="text-sm text-gray-600">ألبانيا، النمسا، بيلاروسيا، بلجيكا، البوسنة والهرسك، بلغاريا، كرواتيا، قبرص، جمهورية التشيك، الدنمارك، إستونيا، فنلندا، فرنسا، ألمانيا، اليونان، المجر، آيسلندا، أيرلندا، إيطاليا، لاتفيا، ليتوانيا، لوكسمبورغ، مالطا، موناكو، الجبل الأسود، هولندا، مقدونيا الشمالية، النرويج، بولندا، البرتغال، رومانيا، روسيا، صربيا، سلوفاكيا، سلوفينيا، إسبانيا، السويد، سويسرا، أوكرانيا، المملكة المتحدة</p>
        </div>
        <div class="bg-green-50 border border-green-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-green-800 mb-2">أمريكا الشمالية (3 دول)</p>
          <p class="text-sm text-gray-600">كندا، المكسيك، الولايات المتحدة</p>
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-orange-800 mb-2">أمريكا الجنوبية (3 دول)</p>
          <p class="text-sm text-gray-600">الأرجنتين، البرازيل، تشيلي</p>
        </div>
        <div class="bg-purple-50 border border-purple-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-purple-800 mb-2">أوقيانوسيا (دولتان)</p>
          <p class="text-sm text-gray-600">أستراليا، نيوزيلندا</p>
        </div>
        <div class="bg-teal-50 border border-teal-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-teal-800 mb-2">آسيا (7 دول)</p>
          <p class="text-sm text-gray-600">بروناي، إندونيسيا، اليابان، قطر، سنغافورة، كوريا الجنوبية، الإمارات العربية المتحدة</p>
        </div>
      </div>

      <div class="bg-yellow-50 border-r-4 border-yellow-400 p-5 rounded-l-xl mb-8 not-prose">
        <p class="text-yellow-900"><strong>ملاحظة:</strong> يتم تحديث قائمة الدول الرسمية من وقت لآخر. تحقق دائماً من أحدث المعلومات عبر المصادر الحكومية الرسمية قبل حجز الرحلات.</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="ports" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">✈️</span> أين يمكنك الدخول والخروج من الصين؟
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        يمكنك الدخول والخروج من أي من <strong>65 منفذاً مخصصاً</strong> في <strong>24 مقاطعة (بما في ذلك البلديات والمناطق ذاتية الحكم)</strong>. السفر بين المقاطعات <strong>مسموح به</strong> — يمكنك الدخول عبر شنغهاي، واستقلال القطار فائق السرعة إلى بكين، والعودة من بكين. يجب أن يبقى خط السير بالكامل ضمن 24 مقاطعة/منطقة مخصصة.
      </p>

      <div class="overflow-x-auto mb-8 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm text-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">مقارنة سياسات العبور بدون تأشيرة (TWOV)</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-4 py-3 font-bold">المقاطعة/المدينة</th>
              <th class="px-4 py-3 font-bold">المنافذ الرئيسية</th>
              <th class="px-4 py-3 font-bold">منطقة الإقامة</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">بكين</td><td class="px-4 py-2">مطار العاصمة الدولي (PEK), مطار داشينغ الدولي (PKX)</td><td class="px-4 py-2">بكين</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">شنغهاي</td><td class="px-4 py-2">بودونغ (PVG), هونغتشياو (SHA), ميناء بحري</td><td class="px-4 py-2">شنغهاي</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">غوانغدونغ</td><td class="px-4 py-2">غوانغتشو (CAN), شنتشن (SZX), جييانغ (SWA) + ميناء بحري</td><td class="px-4 py-2">مقاطعة غوانغدونغ</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">جيانغسو</td><td class="px-4 py-2">نانجينغ (NKG), ووشي (WUX), يانغتشو (YTY), ميناء ليانيونغانغ البحري</td><td class="px-4 py-2">جيانغسو</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">تشجيانغ</td><td class="px-4 py-2">هانغتشو (HGH), نينغبو (NGB), ونزهو (WNZ) وغيرها</td><td class="px-4 py-2">تشجيانغ</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">سيتشوان</td><td class="px-4 py-2">تشنغدو شوانغليو (CTU), تشنغدو تيانفو (TFU)</td><td class="px-4 py-2">تشنغدو + 10 مدن أخرى</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">يونان</td><td class="px-4 py-2">كونمينغ (KMG)</td><td class="px-4 py-2">كونمينغ + 8 مدن/مناطق</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">قوانغشي</td><td class="px-4 py-2">ناننينغ (NNG), غويلين (KWL), بيهاي (BHY)</td><td class="px-4 py-2">ناننينغ + 11 مدينة أخرى</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">فوجيان</td><td class="px-4 py-2">فوتشو (FOC), شيامن (XMN), تشيوانتشو (JJN)</td><td class="px-4 py-2">فوجيان</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">هاينان</td><td class="px-4 py-2">هايكو (HAK), سانيا (SYX)</td><td class="px-4 py-2">جزيرة هاينان</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">شنشي</td><td class="px-4 py-2">شيآن (XIY)</td><td class="px-4 py-2">شنشي</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">تشونغتشينغ</td><td class="px-4 py-2">تشونغتشينغ (CKG)</td><td class="px-4 py-2">تشونغتشينغ</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">تيانجين</td><td class="px-4 py-2">تيانجين (TSN), ميناء تيانجين البحري</td><td class="px-4 py-2">تيانجين</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">+ 11 مقاطعة أخرى</td><td class="px-4 py-2" colspan="2">خبي، لياونينغ، شاندونغ، خنان، هوبي، هونان، آنهوي، قويتشو، شانشي، هيلونغجيانغ، جيانغشي — كل منها بمطارات/موانئ بحرية مخصصة</td></tr>
          </tbody>
        </table>
      </div>

      <div class="bg-yellow-50 border-r-4 border-yellow-400 p-5 rounded-l-xl mb-8 not-prose">
        <p class="text-yellow-900"><strong>مهم:</strong> يمكنك السفر بحرية داخل 24 مقاطعة/منطقة مخصصة خلال إقامتك البالغة 240 ساعة. على سبيل المثال، ادخل عبر شنغهاي، واستقل القطار فائق السرعة إلى بكين، ثم عد من بكين — كل هذا مسموح به طالما تغادر في غضون 10 أيام. القاعدة الأساسية هي أنه يجب عليك مغادرة الصين في غضون 240 ساعة؛ يمكن أن تكون منافذ الدخول والخروج مختلفة.</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="documents" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">📄</span> ما المستندات التي تحتاجها؟
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        جهز هذه المستندات لتسجيل الوصول في شركة الطيران وتفتيش الهجرة على الحدود:
      </p>

      <div class="space-y-4 mb-8 not-prose">
        <div class="flex items-start gap-3 p-5 bg-green-50 border border-green-200 rounded-xl">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-green-200 text-green-700 text-sm flex items-center justify-center font-bold">✓</span>
          <div>
            <p class="font-medium text-gray-900">جواز سفر أصلي ساري المفعول</p>
            <p class="text-sm text-gray-600">صلاحية متبقية لا تقل عن 3 أشهر</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-5 bg-blue-50 border border-blue-200 rounded-xl">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-200 text-blue-700 text-sm flex items-center justify-center font-bold">✓</span>
          <div>
            <p class="font-medium text-gray-900">تذكرة سفر مؤكدة للوجهة التالية</p>
            <p class="text-sm text-gray-600">تاريخ مغادرة ومقعد محددين مطلوبان قبل الصعود؛ التذاكر المفتوحة غير مقبولة</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-5 bg-purple-50 border border-purple-200 rounded-xl">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-purple-200 text-purple-700 text-sm flex items-center justify-center font-bold">✓</span>
          <div>
            <p class="font-medium text-gray-900">خط سير مفصل</p>
            <p class="text-sm text-gray-600">يظهر أنشطتك المخطط لها في الصين</p>
