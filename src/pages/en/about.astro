---
import Layout from '../../layouts/Layout.astro';
const title = 'About — China Starter Guide';
const description = 'Why we built this guide and who it is for.';
---

<Layout title={title} description={description} lang="en">
  <article class="max-w-3xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">ABOUT</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">About This Guide</h1>
    </header>
    <div class="prose prose-gray dark:prose-invert max-w-none">
      <p>China Starter Guide is a practical, no-nonsense resource for foreigners planning to visit, live, or work in China.</p>
      <h2>What Makes This Different</h2>
      <ul>
        <li>Written from a foreigner's perspective — not a tourism board</li>
        <li>Constantly updated — China changes fast</li>
        <li>Actionable steps — not just vague advice</li>
        <li>Covers real problems — payment, apps, transport</li>
      </ul>
      <h2>Who This Is For</h2>
      <ul>
        <li>First-time tourists</li>
        <li>Business travelers</li>
        <li>Expats moving to China</li>
        <li>Digital nomads</li>
      </ul>
      <h2>Stay Updated</h2>
      <p>China's tech and policy landscape changes rapidly. We update our guides regularly to keep information accurate and useful.</p>
    </div>
  </article>
</Layout>
