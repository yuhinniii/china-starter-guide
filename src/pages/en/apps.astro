---
import Layout from '../../layouts/Layout.astro';
const title = 'Essential Apps for China';
const description = 'The apps you actually need in China — with setup guides for non-Chinese speakers.';
---

<Layout title={title} description={description} lang="en">
  <article class="max-w-3xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">CATEGORY</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">Essential Apps</h1>
      <p class="text-gray-500 dark:text-gray-400">The apps you actually need in China.</p>
    </header>
    <div class="prose prose-gray dark:prose-invert max-w-none">
      <div class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900 rounded-xl p-4 mb-8">
        <p class="text-amber-800 dark:text-amber-200 text-sm m-0">
          <strong>Note:</strong> Detailed app guides coming soon.
        </p>
      </div>
      <h2>Must-Have Apps</h2>
      <ul>
        <li><strong>WeChat (微信)</strong> — Messaging, payments, everything</li>
        <li><strong>Alipay (支付宝)</strong> — Payments and services</li>
        <li><strong>Didi (滴滴)</strong> — Ride hailing</li>
        <li><strong>Amap / Baidu Maps</strong> — Navigation (Google Maps doesn't work well)</li>
        <li><strong>Meituan</strong> — Food delivery</li>
        <li><strong>Dianping</strong> — Restaurant reviews</li>
      </ul>
    </div>
  </article>
</Layout>
