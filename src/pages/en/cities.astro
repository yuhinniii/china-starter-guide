---
import Layout from '@layouts/Layout.astro';
---

<Layout title="City Guides - China Starter Guide" lang="en">
  <div class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-4">City Guides</h1>
    <p class="text-lg text-gray-600  ">
      Detailed guides for major Chinese cities — what to see, where to stay, and how to get around.
    </p>

    <div class="space-y-8">
      <div class="p-6 rounded-2xl bg-gray-50  ">
        <h2 class="text-2xl font-semibold mb-2">Beijing</h2>
        <p class="text-gray-600  ">
          The capital city with 3,000 years of history. Home to the Great Wall, Forbidden City, and vibrant hutong alleys.
        </p>
        <span class="text-sm text-brand-600 font-medium">Coming soon</span>
      </div>

      <div class="p-6 rounded-2xl bg-gray-50  ">
        <h2 class="text-2xl font-semibold mb-2">Shanghai</h2>
        <p class="text-gray-600  ">
          China's financial hub blending futuristic skyline with historic Bund waterfront and charming French Concession.
        </p>
        <span class="text-sm text-brand-600 font-medium">Coming soon</span>
      </div>

      <div class="p-6 rounded-2xl bg-gray-50  ">
        <h2 class="text-2xl font-semibold mb-2">Guangzhou</h2>
        <p class="text-gray-600  ">
          The culinary capital of China with world-famous dim sum, Cantonese cuisine, and a relaxed lifestyle.
        </p>
        <span class="text-sm text-brand-600 font-medium">Coming soon</span>
      </div>

      <div class="p-6 rounded-2xl bg-gray-50  ">
        <h2 class="text-2xl font-semibold mb-2">Shenzhen</h2>
        <p class="text-gray-600  ">
          A tech megacity built in 40 years. Modern, efficient, and the gateway to Hong Kong.
        </p>
        <span class="text-sm text-brand-600 font-medium">Coming soon</span>
      </div>
    </div>
  </div>
</Layout>