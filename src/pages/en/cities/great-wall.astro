            <td class="px-3 py-3">Low</td>
            <td class="px-3 py-3">Strenuous</td>
            <td class="px-3 py-3">¥40 day</td>
            <td class="px-3 py-3">Half–full day</td>
            <td class="px-3 py-3">Older kids</td>
            <td class="px-3 py-3">The wall glowing above Gubei Water Town at night</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">Huanghuacheng</td>
            <td class="px-3 py-3">60 km · ~1.5 h drive</td>
            <td class="px-3 py-3">Low–moderate</td>
            <td class="px-3 py-3">Moderate</td>
            <td class="px-3 py-3">¥58</td>
            <td class="px-3 py-3">Half day</td>
            <td class="px-3 py-3">Yes</td>
            <td class="px-3 py-3">The wall walking straight into a lake</td>
