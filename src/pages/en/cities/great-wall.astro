            <td class="px-3 py-3 font-semibold">Jinshanling</td>
            <td class="px-3 py-3">130 km · ~2.5 h drive</td>
            <td class="px-3 py-3">Low</td>
            <td class="px-3 py-3">Strenuous</td>
            <td class="px-3 py-3">¥65</td>
            <td class="px-3 py-3">Full day</td>
            <td class="px-3 py-3">No</td>
            <td class="px-3 py-3">67 towers packed close, sea of clouds at dawn</td>
