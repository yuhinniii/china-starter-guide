            <th class="px-3 py-3 font-bold align-bottom">Difficulty</th>
            <th class="px-3 py-3 font-bold align-bottom">Entry</th>
            <th class="px-3 py-3 font-bold align-bottom">Time needed</th>
            <th class="px-3 py-3 font-bold align-bottom">Good for kids?</th>
            <th class="px-3 py-3 font-bold align-bottom">The standout moment</th>
          </tr>
        </thead>
        <tbody>
