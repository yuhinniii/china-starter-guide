            <td class="px-3 py-3">Easy</td>
            <td class="px-3 py-3">¥40</td>
            <td class="px-3 py-3">3–4 h</td>
            <td class="px-3 py-3">Yes (ropeway)</td>
            <td class="px-3 py-3">The sheer scale — and the biggest night show</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-3 py-3 font-semibold">Mutianyu</td>
            <td class="px-3 py-3">70 km · ~1.5 h drive</td>
            <td class="px-3 py-3">Moderate</td>
            <td class="px-3 py-3">Easy–moderate</td>
            <td class="px-3 py-3">¥45</td>
            <td class="px-3 py-3">Half day</td>
            <td class="px-3 py-3">Yes (cable car + toboggan)</td>
