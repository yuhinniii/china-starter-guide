---
import Layout from '@layouts/Layout.astro';
const title = 'China City Guides — Travel Destinations';
const description = 'Find the right city for your China trip.';
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">China City Guides</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Find the right city for your China trip.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">7</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">City Guides</p>
      </div>
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">2</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">Planning Tools</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">Planning Your Trip</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/cities/city-select/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🧭 Planning</span>
            <p class="text-base font-bold text-gray-900 mt-1">How Many Days Do You Need in China?</p>
            <p class="text-sm text-gray-600 mt-0.5">Plan the perfect itinerary — from a 3-day whirlwind to a 3-week adventure.</p>
          </a>
          <a href="/en/cities/beijing-vs-shanghai/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">⚖️ Beijing vs Shanghai</span>
            <p class="text-base font-bold text-gray-900 mt-1">Beijing vs Shanghai: Which City Should You Visit First?</p>
            <p class="text-sm text-gray-600 mt-0.5">Dynasties or skylines? The honest comparison to pick your first Chinese city.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">History & Culture</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/cities/beijing-guide/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🏛️ Beijing</span>
            <p class="text-base font-bold text-gray-900 mt-1">Beijing Travel Guide: What to See, Eat, and Know</p>
            <p class="text-sm text-gray-600 mt-0.5">Forbidden City, Great Wall, hutongs, Peking duck, and essential tips.</p>
          </a>
          <a href="/en/cities/xi-an-guide/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🐎 Xi'an</span>
            <p class="text-base font-bold text-gray-900 mt-1">Xi'an Travel Guide: What to See, Eat, and Know</p>
            <p class="text-sm text-gray-600 mt-0.5">Terracotta Warriors, the best-preserved city wall in China, and a Silk Road Muslim Quarter.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Modern & Urban</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/cities/shanghai-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🌆 Shanghai</span>
            <p class="text-base font-bold text-gray-900 mt-1">Shanghai Travel Guide: The Most Foreigner-Friendly City</p>
            <p class="text-sm text-gray-600 mt-0.5">The Bund, Shanghai Tower, Wukang Road–Anfu Road area, and world-class dining.</p>
          </a>
          <a href="/en/cities/shenzhen-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🏙️ Shenzhen</span>
            <p class="text-base font-bold text-gray-900 mt-1">Shenzhen Travel Guide: Tech Hub Next to Hong Kong</p>
            <p class="text-sm text-gray-600 mt-0.5">China's Silicon Valley, coastal cycling, and a 15-minute train to Hong Kong.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">Nature & Scenery</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/cities/hainan-visa-free/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🏝️ Hainan</span>
            <p class="text-base font-bold text-gray-900 mt-1">Hainan Travel Guide — 30-Day Visa-Free</p>
            <p class="text-sm text-gray-600 mt-0.5">Tropical beaches, rainforest, and visa-free entry for 59 countries.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-orange-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-orange-800">Food & Lifestyle</h2>
          <span class="text-xs font-medium text-orange-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/cities/guangzhou-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🥟 Guangzhou</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guangzhou Travel Guide: Food Capital of China</p>
            <p class="text-sm text-gray-600 mt-0.5">Dim sum, Canton Tower, Shamian Island, and gateway to southern China.</p>
          </a>
          <a href="/en/cities/chengdu-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🐼 Chengdu</span>
            <p class="text-base font-bold text-gray-900 mt-1">Chengdu Travel Guide: Pandas, Spicy Food & Slow Life</p>
            <p class="text-sm text-gray-600 mt-0.5">Giant pandas, Sichuan hotpot, tea houses, and gateway to Jiuzhaigou.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">Next Step</p>
            <h3 class="text-xl font-bold text-gray-900">Plan your trip</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">Picked a city? Sort out your visa and book your ride before you go.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/en/visa/visa-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🛂 Visa guide
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/en/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚄 Transport guide
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>