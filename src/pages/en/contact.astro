---
import Layout from '../../layouts/Layout.astro';
const title = 'Contact — China Starter Guide';
const description = 'Get in touch with us for questions, feedback, or collaboration.';
---

<Layout title={title} description={description} lang="en">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">CONTACT</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">Contact Us</h1>
      <p class="text-gray-500 dark:text-gray-400">Have questions or feedback? We'd love to hear from you.</p>
    </header>
    <div class="bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-8">
      <div class="space-y-4">
        <p class="text-sm text-gray-500 dark:text-gray-400">Email coming soon. For now, follow our updates on social media.</p>
      </div>
    </div>
  </article>
</Layout>
