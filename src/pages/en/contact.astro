---
import Layout from '@layouts/Layout.astro';
const title = 'Contact Us — China Starter Hub';
const description = 'Planning a trip to China or already here and stuck? We help independent travelers with every step — itinerary, hotels, and more.';
---

<Layout title={title} description={description} lang="en">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">💬 CONTACT</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Contact Us</h1>
      <p class="text-lg text-gray-500">Planning a trip to China, or already here and stuck? We're a one-stop helper for independent travelers.</p>
    </header>

    <div class="space-y-8 pb-16">
      <section class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">What we can help with</h2>
        <ul class="space-y-3 text-lg text-gray-700">
          <li>✅ Plan your itinerary and pick hotels that fit your budget</li>
          <li>✅ Sort out visas, payments, transport, and attraction tickets</li>
          <li>✅ Lend a hand remotely once you've landed</li>
          <li>✅ Answer any China travel question — food, internet, safety, etiquette, and more</li>
        </ul>
      </section>

      <section class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-2">🎁 Free Hotel Match</h2>
        <p class="text-lg text-gray-700 mb-3">Tell us your area and nightly budget — we'll compare <strong>2 hotels</strong> for you, free.</p>
        <p class="text-sm text-gray-800 font-medium">Email us with the subject line <strong>"Hotel help"</strong> and include:</p>
        <ol class="text-sm text-gray-700 list-decimal pl-5 mt-1 space-y-1">
          <li>City or area</li>
          <li>Nightly budget</li>
          <li>Check-in date</li>
          <li>Number of guests</li>
        </ol>
      </section>

      <section class="bg-gray-50 border border-gray-100 rounded-2xl p-6 md:p-8 text-center">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Get in touch</h2>
        <p class="text-lg text-gray-700">Email us at <a href="mailto:hello@chinastarterhub.com" class="text-brand-600 font-medium hover:underline">hello@chinastarterhub.com</a></p>
        <p class="text-sm text-gray-500 mt-2">We usually reply within 1–2 business days.</p>
      </section>

      <section class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Quick questions</h2>
        <div class="space-y-4">
          <details class="group border border-gray-200 rounded-xl p-4">
            <summary class="font-semibold text-gray-900 cursor-pointer">Can you help plan my route and pick hotels?</summary>
            <p class="text-gray-700 mt-2">Yes — share your dates, destinations, and budget, and we'll put together a plan.</p>
          </details>
          <details class="group border border-gray-200 rounded-xl p-4">
            <summary class="font-semibold text-gray-900 cursor-pointer">Are you a travel agency?</summary>
            <p class="text-gray-700 mt-2">No — we're an independent-travel assistant. We help with specific needs, not packaged tours.</p>
          </details>
          <details class="group border border-gray-200 rounded-xl p-4">
            <summary class="font-semibold text-gray-900 cursor-pointer">Where are you based?</summary>
            <p class="text-gray-700 mt-2">We work remotely, so we can help you anywhere in China.</p>
          </details>
        </div>
      </section>
    </div>
  </article>
</Layout>
