---
import Layout from '@layouts/Layout.astro';
const title = 'Contact Us — China Starter Hub';
const description = 'Have questions or feedback? Contact us — we reply within 24 hours.';
---

<Layout title={title} description={description} lang="en">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">CONTACT</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">Contact Us</h1>
      <p class="text-gray-500  ">Have questions or feedback? We'd love to hear from you.</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4 text-center">
        <p class="text-gray-700 text-lg">Email us at <a href="mailto:hello@chinastarterhub.com" class="text-brand-600 font-medium hover:underline">hello@chinastarterhub.com</a></p>
      </div>
    </div>
  </article>
</Layout>
