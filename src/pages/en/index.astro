---
import Layout from '../../layouts/Layout.astro';
const title = 'China Starter Guide — Your Ultimate Guide to China';
const description = 'Everything you need to know before coming to China: payment, transport, apps, cities, and travel tips.';
---

<Layout title={title} description={description} lang="en">
  <!-- Hero -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900 dark:text-gray-50 mb-6">
      Your Ultimate<br/><span class="text-brand-600">China Starter Guide</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto mb-8 leading-relaxed">
      Everything you need to know before coming to China — payment, transport, apps, cities, and travel tips. Practical, up-to-date, and beginner-friendly.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/en/payment/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">Get Started</a>
      <a href="/en/about/" class="border border-gray-300 dark:border-gray-700 px-6 py-3 rounded-lg font-medium hover:border-brand-600 hover:text-brand-600 transition no-underline">Learn More</a>
    </div>
  </section>

  <!-- Features -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-6 py-16">
    {[
      { emoji: '💳', title: 'Payment', desc: 'How to use Alipay & WeChat Pay as a foreigner — step by step.' },
      { emoji: '🚄', title: 'Transport', desc: 'Trains, subways, Didi, and how to get around Chinese cities easily.' },
      { emoji: '📱', title: 'Essential Apps', desc: 'The apps you actually need — with setup guides for non-Chinese speakers.' },
      { emoji: '🏙️', title: 'Cities', desc: 'Honest guides to Beijing, Shanghai, Shenzhen, Chengdu and more.' },
      { emoji: '🧳', title: 'Travel Tips', desc: 'SIM cards, VPNs, hotels, and things no one tells you before you go.' },
      { emoji: '🤝', title: 'Culture & Etiquette', desc: 'What to expect, how to be respectful, and avoid awkward moments.' },
    ].map(item => (
      <div class="bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-6 hover:shadow-medium hover:-translate-y-1 transition-all duration-200">
        <div class="text-3xl mb-3">{item.emoji}</div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">{item.title}</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{item.desc}</p>
      </div>
    ))}
  </section>

  <!-- Latest Articles Placeholder -->
  <section class="py-12 border-t border-gray-100 dark:border-gray-900">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Latest Articles</h2>
    <p class="text-gray-400 text-sm">Articles coming soon. Check back as we build out the guide!</p>
  </section>
</Layout>
