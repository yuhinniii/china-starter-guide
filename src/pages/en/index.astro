---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Guide — Your Ultimate Guide to China';
const description = 'Everything you need to know before coming to China: payment, transport, apps, cities, and travel tips.';
---

<Layout title={title} description={description} lang="en">
  <!-- Trigger rebuild: 2026-06-12 17:30 -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900  ">
      Clear, Current Guidance for<br/><span class="text-brand-600">First-Time Foreigners Visiting China</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-500  ">
      Start with the essentials, then follow the guides that match your trip.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/en/prepare/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">Get Started</a>
      <a href="/en/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">About This Site</a>
    </div>
  </section>

  <!-- Section: Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/en/prepare/', title: 'Prepare', desc: 'Visa, documents, essential setup before you fly.' },
        { href: '/en/payment/', title: 'Payment', desc: 'Wallets, bank cards, cash backup.' },
        { href: '/en/transport/', title: 'Transport', desc: 'High-speed rail, metro, ride-hailing, and getting from the airport to the city.' },
        { href: '/en/medical/', title: 'Medical', desc: 'Clinics, hospitals, emergency care.' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  :text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Your Trip: Step by Step -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Your Trip, Step by Step</h2>
    <p class="text-gray-500 mb-10">Follow your stage — each one links to the guides you'll actually need.</p>

    <div class="space-y-8">
      <!-- Stage 1 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-green-100 flex items-center justify-center text-sm font-bold text-green-700">1</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Before You Fly</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/en/prepare/visa/visa-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Prepare</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Which visa do you need?</p>
          </a>
          <a href="/en/payment/payment-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Payment</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">How to pay in China</p>
          </a>
          <a href="/en/life/survival-kit/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Life</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Your pre-departure checklist</p>
          </a>
        </div>
      </div>

      <!-- Stage 2 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-sm font-bold text-blue-700">2</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Just Landed</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/en/transport/airport-to-city/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Transport</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Getting from airport to city</p>
          </a>
          <a href="/en/life/sim-card-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Life</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">SIM card & internet setup</p>
          </a>
          <a href="/en/life/vpn-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Life</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Setting up your VPN</p>
          </a>
        </div>
      </div>

      <!-- Stage 3 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-purple-100 flex items-center justify-center text-sm font-bold text-purple-700">3</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">During Your Trip</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/en/transport/transport-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Transport</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Getting around China</p>
          </a>
          <a href="/en/life/essential-apps/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Life</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">10 essential apps</p>
          </a>
          <a href="/en/life/chinese-phrases/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Life</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Basic Chinese phrases</p>
          </a>
        </div>
      </div>

      <!-- Stage 4 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-red-100 flex items-center justify-center text-sm font-bold text-red-700">4</div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Need Help?</h3>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <a href="/en/medical/seeing-a-doctor/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Medical</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Seeing a doctor</p>
          </a>
          <a href="/en/tips/common-scams/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Tips</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Avoiding common scams</p>
          </a>
          <a href="/en/tips/emergency-numbers/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Tips</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Emergency contacts</p>
          </a>
          <a href="/en/payment/payment-fails/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Payment</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">When payment fails</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visa Checker Tool -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="border-t border-gray-100 pt-12">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">Visa Checker</h2>
        <p class="text-gray-500 text-center mb-8">Not sure if you need a visa? Pick your nationality — we'll tell you.</p>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <label for="visa-country" class="block text-sm font-medium text-gray-700 mb-2">Your nationality</label>
          <select id="visa-country" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 text-base appearance-none cursor-pointer">
            <option value="">— Select your country —</option>
            <option value="AL">Albania</option>
            <option value="AD">Andorra</option>
            <option value="AG">Antigua and Barbuda</option>
            <option value="AR">Argentina</option>
            <option value="AM">Armenia</option>
            <option value="AU">Australia</option>
            <option value="AT">Austria</option>
            <option value="AZ">Azerbaijan</option>
            <option value="BS">Bahamas</option>
            <option value="BH">Bahrain</option>
            <option value="BB">Barbados</option>
            <option value="BY">Belarus</option>
            <option value="BE">Belgium</option>
            <option value="BA">Bosnia and Herzegovina</option>
            <option value="BR">Brazil</option>
            <option value="BN">Brunei</option>
            <option value="BG">Bulgaria</option>
            <option value="CA">Canada</option>
            <option value="CL">Chile</option>
            <option value="HR">Croatia</option>
            <option value="CY">Cyprus</option>
            <option value="CZ">Czech Republic</option>
            <option value="DK">Denmark</option>
            <option value="DM">Dominica</option>
            <option value="EC">Ecuador</option>
            <option value="EE">Estonia</option>
            <option value="FJ">Fiji</option>
            <option value="FI">Finland</option>
            <option value="FR">France</option>
            <option value="GE">Georgia</option>
            <option value="DE">Germany</option>
            <option value="GR">Greece</option>
            <option value="GD">Grenada</option>
            <option value="HU">Hungary</option>
            <option value="IS">Iceland</option>
            <option value="IE">Ireland</option>
            <option value="IT">Italy</option>
            <option value="JP">Japan</option>
            <option value="KZ">Kazakhstan</option>
            <option value="KW">Kuwait</option>
            <option value="LV">Latvia</option>
            <option value="LI">Liechtenstein</option>
            <option value="LT">Lithuania</option>
            <option value="LU">Luxembourg</option>
            <option value="MY">Malaysia</option>
            <option value="MV">Maldives</option>
            <option value="MT">Malta</option>
            <option value="MU">Mauritius</option>
            <option value="MC">Monaco</option>
            <option value="ME">Montenegro</option>
            <option value="NL">Netherlands</option>
            <option value="NZ">New Zealand</option>
            <option value="MK">North Macedonia</option>
            <option value="NO">Norway</option>
            <option value="OM">Oman</option>
            <option value="PE">Peru</option>
            <option value="PL">Poland</option>
            <option value="PT">Portugal</option>
            <option value="QA">Qatar</option>
            <option value="RO">Romania</option>
            <option value="RU">Russia</option>
            <option value="WS">Samoa</option>
            <option value="SM">San Marino</option>
            <option value="SA">Saudi Arabia</option>
            <option value="RS">Serbia</option>
            <option value="SC">Seychelles</option>
            <option value="SG">Singapore</option>
            <option value="SK">Slovakia</option>
            <option value="SI">Slovenia</option>
            <option value="SB">Solomon Islands</option>
            <option value="KR">South Korea</option>
            <option value="ES">Spain</option>
            <option value="SR">Suriname</option>
            <option value="SE">Sweden</option>
            <option value="CH">Switzerland</option>
            <option value="TH">Thailand</option>
            <option value="TO">Tonga</option>
            <option value="AE">United Arab Emirates</option>
            <option value="GB">United Kingdom</option>
            <option value="US">United States</option>
            <option value="UY">Uruguay</option>
            <option value="UZ">Uzbekistan</option>
            <option value="OTHER">Other country</option>
          </select>

          <div id="visa-result" class="mt-6"></div>
        </div>

        <p class="text-xs text-gray-400 text-center mt-4">Visa policies change. Always verify with your local Chinese embassy before booking.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const countrySelect = document.getElementById('visa-country');
    const resultDiv = document.getElementById('visa-result');

    // Source: China gov.cn official list (2025)
    // Category 1: Unilateral visa-free (30 days) - 46 countries
    const visaFree = ['BN','FR','DE','IT','ES','NL','CH','IE','HU','AT','BE','LU','NZ','AU','PL','PT','GR','CY','SI','SK','NO','FI','DK','IS','AD','MC','LI','KR','BG','RO','HR','ME','MK','MT','EE','LV','JP','BR','AR','CL','PE','UY','SA','OM','KW','BH'];

    // Category 2: Mutual visa agreement (ordinary passport) - 29 countries
    const mutualFree = ['AL','AE','AG','BB','BS','BY','BA','DM','EC','FJ','GD','GE','KZ','QA','MV','MU','WS','RS','SC','SM','SR','SB','TH','TO','UZ','SG','AM','AZ','MY'];

    // Category 3: 240-hour transit - 55 countries
    const transit240 = ['AL','AT','BE','BG','BA','BR','CA','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LT','LU','MT','MC','ME','NL','MK','NO','PL','PT','RO','RU','RS','SK','SI','KR','ES','SE','CH','UA','GB','US','AU','NZ','JP','SG','BN','AE','QA','MX','AR','CL','ID'];

    // Determine best visa status for each country
    function getVisaStatus(code) {
      if (visaFree.includes(code)) return 'visa-free-30';
      if (mutualFree.includes(code)) return 'mutual-free';
      if (transit240.includes(code)) return 'transit';
      return 'need-visa';
    }

    const countryNames = {
      'AL':'Albania','AD':'Andorra','AG':'Antigua and Barbuda','AR':'Argentina','AM':'Armenia',
      'AU':'Australia','AT':'Austria','AZ':'Azerbaijan','BS':'Bahamas','BH':'Bahrain','BB':'Barbados',
      'BY':'Belarus','BE':'Belgium','BA':'Bosnia and Herzegovina','BR':'Brazil','BN':'Brunei','BG':'Bulgaria',
      'CA':'Canada','CL':'Chile','HR':'Croatia','CY':'Cyprus','CZ':'Czech Republic','DK':'Denmark',
      'DM':'Dominica','EC':'Ecuador','EE':'Estonia','FJ':'Fiji','FI':'Finland','FR':'France',
      'GE':'Georgia','DE':'Germany','GR':'Greece','GD':'Grenada','HU':'Hungary','IS':'Iceland','IE':'Ireland',
      'IT':'Italy','JP':'Japan','KZ':'Kazakhstan','KW':'Kuwait','LV':'Latvia','LI':'Liechtenstein',
      'LT':'Lithuania','LU':'Luxembourg','MY':'Malaysia','MV':'Maldives','MT':'Malta','MU':'Mauritius',
      'MC':'Monaco','ME':'Montenegro','NL':'Netherlands','NZ':'New Zealand','MK':'North Macedonia',
      'NO':'Norway','OM':'Oman','PE':'Peru','PL':'Poland','PT':'Portugal','QA':'Qatar','RO':'Romania',
      'RU':'Russia','WS':'Samoa','SM':'San Marino','SA':'Saudi Arabia','RS':'Serbia','SC':'Seychelles',
      'SG':'Singapore','SK':'Slovakia','SI':'Slovenia','SB':'Solomon Islands','KR':'South Korea',
      'ES':'Spain','SR':'Suriname','SE':'Sweden','CH':'Switzerland','TH':'Thailand','TO':'Tonga',
      'AE':'the United Arab Emirates','GB':'the United Kingdom','US':'the United States','UY':'Uruguay','UZ':'Uzbekistan'
    };

    countrySelect.addEventListener('change', function() {
      const val = this.value;
      if (!val) {
        resultDiv.innerHTML = '';
        return;
      }

      const name = countryNames[val] || 'your country';
      const status = getVisaStatus(val);

      if (status === 'visa-free-30') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">Good news! Citizens of ' + name + ' can enter China <span class="underline">visa-free</span> for up to 30 days.</p><p class="text-green-700 text-sm mb-3">No visa needed for tourism, business, or transit stays under 30 days.</p><a href="/en/prepare/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">See the full visa-free list \u2192</a></div>';
      } else if (status === 'mutual-free') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">Citizens of ' + name + ' can enter China <span class="underline">visa-free</span> under a mutual agreement.</p><p class="text-green-700 text-sm mb-3">Check your passport type and allowed duration before traveling.</p><a href="/en/prepare/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">See the visa-free countries list \u2192</a></div>';
      } else if (status === 'transit') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-blue-50 border border-blue-200"><p class="text-blue-800 font-semibold mb-1">You can use the <span class="underline">240-hour transit</span> policy.</p><p class="text-blue-700 text-sm mb-3">Citizens of ' + name + ' can transit through China for up to 10 days without a visa. For longer stays, you\u2019ll need an L visa.</p><div class="flex flex-wrap gap-3"><a href="/en/prepare/visa/transit-240/" class="text-sm font-medium text-blue-700 underline hover:no-underline">How transit works \u2192</a><a href="/en/prepare/visa/apply-l-visa/" class="text-sm font-medium text-blue-700 underline hover:no-underline">Apply for an L visa \u2192</a></div></div>';
      } else {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-orange-50 border border-orange-200"><p class="text-orange-800 font-semibold mb-1">You\u2019ll need a visa.</p><p class="text-orange-700 text-sm mb-3">Citizens of ' + name + ' need to apply for a tourist visa (L-type) before traveling to China.</p><a href="/en/prepare/visa/apply-l-visa/" class="inline-block text-sm font-medium text-orange-700 underline hover:no-underline">How to apply for an L visa \u2192</a></div>';
      }
    });
  </script>
</Layout>
