---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Hub — Your Ultimate Guide to China';
const description = 'Everything you need to know before coming to China: payment, transport, apps, cities, and travel tips.';
---

<Layout title={title} description={description} lang="en">
  <!-- Trigger rebuild: 2026-06-12 17:30 -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900  ">
      Travel China with confidence —<br/><span class="text-brand-600">step-by-step guides from visa to payment to getting around</span>
    </h1>
    <div class="flex flex-wrap justify-center gap-4 mt-10">
      <a href="/en/visa/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">Get Started</a>
      <a href="/en/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">About This Site</a>
    </div>
  </section>

  <!-- Section: Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/en/visa/', title: 'Visa', desc: 'Visa types, free countries, transit policy.' },
        { href: '/en/payment/', title: 'Payment', desc: 'Wallets, bank cards, cash backup.' },
        { href: '/en/transport/', title: 'Transport', desc: 'High-speed rail, metro, ride-hailing, and getting from the airport to the city.' },
        { href: '/en/life/', title: 'Life in China', desc: 'Apps, medical care, safety tips, daily living.' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  group-hover:text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Interactive Pre-Departure Checklist -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Your China Trip Checklist</h2>
    <p class="text-gray-500 mb-4">One month out to day one — check off each item as you go.</p>

    <!-- Time Filter -->
    <div id="checklist-filter" class="flex flex-wrap gap-2 mb-5">
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-brand-50 text-brand-700 text-sm font-medium cursor-pointer transition hover:border-brand-300 active" data-show="all">All stages</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="1">1 month before</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="2">2 weeks before</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="3">1 week before</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="4,5">Landing</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="6">Day 1</button>
    </div>

    <!-- Overall Progress -->
    <div id="checklist-progress" class="bg-gray-50 rounded-2xl p-5 mb-10">
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-sm font-semibold text-gray-700">Overall progress</span>
        <span id="progress-text" data-suffix="completed" class="text-base font-bold text-brand-600">0 of 23 completed</span>
      </div>
      <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width:0%"></div>
      </div>
    </div>

    <div class="space-y-8">

      <!-- Stage 1: T-30 Days · A Month Before You Fly -->
      <div class="relative pl-12 stage-group" data-stage="1">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-xs font-bold text-green-700">1</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-green-700">T-30 Days</span> · A Month Before You Fly
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="1">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="1">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-passport">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">01</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Check passport expiry</p>
              <p class="text-sm text-gray-500 mt-0.5">Many countries require 6 months validity beyond your travel dates for a Chinese visa.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-visa">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">02</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Confirm visa type or visa-free eligibility</p>
              <p class="text-sm text-gray-500 mt-0.5">Do you need a visa, qualify for 240-hour transit, or fall under a bilateral exemption? 30 seconds to check.</p>
            </div>
            <a href="/en/visa/visa-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="travel-insurance">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">03</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Buy travel insurance with medical cover</p>
              <p class="text-sm text-gray-500 mt-0.5">Chinese hospitals expect upfront payment. Insurance with minimum $100k medical cover and emergency evacuation is recommended.</p>
            </div>
            <a href="/en/life/travel-insurance/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
        </div>
      </div>

      <!-- Stage 2: T-15 Days · Two Weeks Out -->
      <div class="relative pl-12 stage-group" data-stage="2">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-xs font-bold text-blue-700">2</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-blue-700">T-15 Days</span> · Two Weeks Out
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="2">0/6 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="2">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="buy-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">04</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Buy a VPN subscription and install it</p>
              <p class="text-sm text-gray-500 mt-0.5">You cannot download VPN apps from inside China — the websites are blocked. Subscribe, install on every device, and test it from home before you leave.</p>
            </div>
            <a href="/en/life/vpn-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="buy-esim">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">05</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Buy your eSIM</p>
              <p class="text-sm text-gray-500 mt-0.5">Pick an eSIM with China coverage — ideally one routing through Hong Kong to bypass the firewall. Install it before you go.</p>
            </div>
            <a href="/en/life/sim-card-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="setup-alipay">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">06</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Set up Alipay and link your cards</p>
              <p class="text-sm text-gray-500 mt-0.5">Link one credit card and one debit card as backup — small shops' personal QR codes don't accept credit cards, so the debit card will work when credit doesn't.</p>
            </div>
            <a href="/en/payment/payment-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="setup-wechat">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">07</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Set up WeChat Pay (optional backup)</p>
              <p class="text-sm text-gray-500 mt-0.5">Alipay covers 95% of payments, but some small restaurants use WeChat-only ordering. Set it up as a backup — the app is useful for messaging anyway.</p>
            </div>
            <a href="/en/payment/setup-wechat/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="book-hotel">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">08</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Book a hotel that can check in foreign guests</p>
              <p class="text-sm text-gray-500 mt-0.5">Not every hotel in China can accept foreign passports. Book through platforms like Trip.com and filter for positive foreigner reviews.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="notify-bank">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">09</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Notify your bank you're traveling to China</p>
              <p class="text-sm text-gray-500 mt-0.5">Some banks auto-block China transactions as suspected fraud. Set a travel notice in the app or call them — a 5-minute call now saves a headache later.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 3: T-7 Days · Before You Leave -->
      <div class="relative pl-12 stage-group" data-stage="3">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-xs font-bold text-indigo-700">3</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-indigo-700">T-7 Days</span> · Before You Leave
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="3">0/4 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="3">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="test-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">10</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Test your VPN on every device</p>
              <p class="text-sm text-gray-500 mt-0.5">Confirm it connects on your phone, laptop, and tablet. Do this from home — once you're in China, VPN provider sites are blocked too.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="install-apps">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">11</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Install essential apps for China travel</p>
              <p class="text-sm text-gray-500 mt-0.5">Baidu Maps (replaces Google Maps), Didi (ride-hailing), Trip.com (trains & hotels). Download them now while the App Store isn't restricted.</p>
            </div>
            <a href="/en/life/essential-apps/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="learn-chinese">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">12</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Learn 10 basic Chinese phrases</p>
              <p class="text-sm text-gray-500 mt-0.5">Being able to say "thank you" and "how much" changes how people treat you. Start with the essentials.</p>
            </div>
            <a href="/en/life/chinese-phrases/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="backup-docs">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">13</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Save digital copies of passport, visa, insurance</p>
              <p class="text-sm text-gray-500 mt-0.5">Keep photos or scans in your phone and a cloud drive. If your documents are lost or stolen, backups are your only fallback.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 4: T-24h · Final Prep -->
      <div class="relative pl-12 stage-group" data-stage="4">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-xs font-bold text-amber-700">4</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-amber-700">T-24h</span> · Final Prep
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="4">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="4">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-in">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">16</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Check in online and confirm flight status</p>
              <p class="text-sm text-gray-500 mt-0.5">Select your seat early and check for any gate changes or delays. No need to leave this to the last minute.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="withdraw-cash">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">15</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Withdraw ¥500–1000 in cash</p>
              <p class="text-sm text-gray-500 mt-0.5">China is 95% cashless, but your payment app will fail at least once. Cash is your emergency backup for taxis, stalls, and broken QR codes.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="power-bank">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">16</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Put power bank and travel adapter in carry-on</p>
              <p class="text-sm text-gray-500 mt-0.5">You'll need your phone for everything: maps, payments, translation. Keep it charged during the flight and upon arrival.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 5: Landing · First 2 Hours -->
      <div class="relative pl-12 stage-group" data-stage="5">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-xs font-bold text-teal-700">5</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-teal-700">Landing</span> · First 2 Hours
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="5">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="5">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="activate-esim">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">17</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Activate eSIM and turn on mobile data</p>
              <p class="text-sm text-gray-500 mt-0.5">First thing after clearing immigration. Everything that follows — maps, Didi, translation, payment — depends on having internet.</p>
            </div>
            <a href="/en/life/sim-card-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="connect-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">18</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Connect your VPN</p>
              <p class="text-sm text-gray-500 mt-0.5">Turn on your VPN before opening any app. Without it, WhatsApp messages pile up silently and Google Maps gives you nothing.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="airport-to-city">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">19</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Get from the airport to your hotel</p>
              <p class="text-sm text-gray-500 mt-0.5">Metro is the cheapest and easiest for most airports. Didi (China's Uber) is a good backup — just make sure you know which terminal you're at.</p>
            </div>
            <a href="/en/transport/airport-to-city/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
        </div>
      </div>

      <!-- Stage 6: Day 1 · Get Settled -->
      <div class="relative pl-12 stage-group" data-stage="6">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-violet-100 flex items-center justify-center text-xs font-bold text-violet-700">6</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-violet-700">Day 1</span> · Get Settled
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="6">0/4 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="6">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="test-payment">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">20</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Test Alipay on a small purchase</p>
              <p class="text-sm text-gray-500 mt-0.5">Buy a bottle of water at a convenience store. If the QR scan works, you're set. If it fails, you have time to fix it — not when you're at dinner.</p>
            </div>
            <a href="/en/payment/payment-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="police-registration">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">21</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Confirm hotel handles police registration</p>
              <p class="text-sm text-gray-500 mt-0.5">Hotels must register foreign guests with local police within 24 hours. Most do it automatically, but ask to be sure. Skipping this can cause problems later.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="try-transport">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">22</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Try the metro or call a Didi</p>
              <p class="text-sm text-gray-500 mt-0.5">Take the metro one stop or order a Didi to a nearby cafe. Learn the transport system today so you're not figuring it out when you're late for something.</p>
            </div>
            <a href="/en/transport/transport-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="emergency-numbers">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">23</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Save emergency numbers to your phone</p>
              <p class="text-sm text-gray-500 mt-0.5">110 (police), 120 (ambulance), 119 (fire). Also save your embassy's consular hotline. You won't remember them when you need them.</p>
            </div>
            <a href="/en/life/emergency-numbers/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">Read guide →</a>
          </div>
        </div>
      </div>

    </div>

    <p class="text-xs text-gray-400 text-center mt-10">Your progress is saved in your browser. Clear your browser data and it resets.</p>
  </section>

  <script is:inline>
    const STORAGE_KEY = 'chinastarterhub-checklist-home';
    const checkboxes = document.querySelectorAll('.checklist-item input[type="checkbox"]');
    const progressBar = document.getElementById('progress-bar');
    const progressText = document.getElementById('progress-text');

    function updateOverall() {
      const checked = document.querySelectorAll('.checklist-item input[type="checkbox"]:checked').length;
      const total = checkboxes.length;
      const pct = total > 0 ? Math.round((checked / total) * 100) : 0;
      progressBar.style.width = pct + '%';
      const __suffix = progressText.dataset.suffix || 'completed'; progressText.textContent = checked + ' / ' + total + ' ' + __suffix;

      // Update per-stage progress
      document.querySelectorAll('.checklist-stage').forEach(function(stage) {
        const stageKey = stage.dataset.stage;
        const cbs = stage.querySelectorAll('input[type="checkbox"]');
        const checkedInStage = stage.querySelectorAll('input[type="checkbox"]:checked').length;
        const totalInStage = cbs.length;
        const label = document.querySelector('.stage-progress[data-stage="' + stageKey + '"]');
        if (label) label.textContent = checkedInStage + '/' + totalInStage + ' \u2713';
      });
    }

    const FILTER_KEY = STORAGE_KEY + '-filter';
    const filterChips = document.querySelectorAll('.filter-chip');
    const stages = document.querySelectorAll('.stage-group');

    function applyFilter(show, skipScroll) {
      filterChips.forEach(function(chip) {
        if (chip.dataset.show === show) {
          chip.classList.remove('bg-white', 'text-gray-600', 'border-gray-200');
          chip.classList.add('bg-brand-50', 'text-brand-700', 'border-brand-300');
        } else {
          chip.classList.remove('bg-brand-50', 'text-brand-700', 'border-brand-300');
          chip.classList.add('bg-white', 'text-gray-600', 'border-gray-200');
        }
      });
      if (show === 'all') {
        stages.forEach(function(s) { s.classList.remove('hidden'); });
        // Scroll to checklist section header, not page top
        if (!skipScroll) {
          var sectionTitle = document.querySelector('#checklist-filter');
          if (sectionTitle) {
            var targetY = sectionTitle.getBoundingClientRect().top + window.scrollY - 80;
            window.scrollTo({ top: targetY, behavior: 'smooth' });
          }
        }
      } else {
        var showList = show.split(',');
        stages.forEach(function(s) {
          if (showList.indexOf(s.dataset.stage) !== -1) {
            s.classList.remove('hidden');
          } else {
            s.classList.add('hidden');
          }
        });
        // Scroll to the first visible stage with offset (so progress/chips stay visible above)
        if (!skipScroll) {
          var firstStage = document.querySelector('.stage-group:not(.hidden)');
          if (firstStage) {
            var targetY = firstStage.getBoundingClientRect().top + window.scrollY - 120;
            window.scrollTo({ top: targetY, behavior: 'smooth' });
          }
        }
      }
      try { localStorage.setItem(FILTER_KEY, show); } catch(e) {}
    }

    filterChips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        applyFilter(this.dataset.show);
      });
    });

    function saveState() {
      const state = {};
      checkboxes.forEach(function(cb) {
        state[cb.closest('.checklist-item').dataset.key] = cb.checked;
      });
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch(e) {}
    }

    function loadState() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
        if (!saved) return;
        checkboxes.forEach(function(cb) {
          const key = cb.closest('.checklist-item').dataset.key;
          if (saved[key]) {
            cb.checked = true;
            cb.closest('.checklist-item').classList.add('opacity-50', 'line-through');
          }
        });
      } catch(e) {}
      updateOverall();
      // Restore last filter
      try {
        var savedFilter = localStorage.getItem(FILTER_KEY);
        if (savedFilter) applyFilter(savedFilter, true);
      } catch(e) {}
    }

    checkboxes.forEach(function(cb) {
      cb.addEventListener('change', function() {
        const item = this.closest('.checklist-item');
        if (this.checked) {
          item.classList.add('opacity-50', 'line-through');
        } else {
          item.classList.remove('opacity-50', 'line-through');
        }
        saveState();
        updateOverall();
      });
    });

    loadState();
  </script>

    <p class="text-xs text-gray-400 text-center mt-8">Last updated: July 2026</p>
</Layout>