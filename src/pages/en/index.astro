---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Guide — Your Ultimate Guide to China';
const description = 'Everything you need to know before coming to China: payment, transport, apps, cities, and travel tips.';
---

<Layout title={title} description={description} lang="en">
  <!-- Hero -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900  ">
      Clear, Current Guidance for<br/><span class="text-brand-600">First-Time Foreigners Visiting China</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-500  ">
      Start with the essentials, then follow the guides that match your trip.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/en/prepare/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">Get Started</a>
      <a href="/en/about/" class="border border-gray-300  :border-brand-600 hover:text-brand-600 transition no-underline">About This Site</a>
    </div>
  </section>

  <!-- Core Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/en/prepare/', title: 'Prepare', desc: 'Visa, documents, essential setup before you fly.' },
        { href: '/en/payment/', title: 'Payment', desc: 'Wallets, bank cards, cash backup.' },
        { href: '/en/transport/', title: 'Transport', desc: 'High-speed rail, metro, local travel basics.' },
        { href: '/en/medical/', title: 'Medical', desc: 'Clinics, hospitals, emergency care.' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  :text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Scenario-Based Quick Links -->
  <section class="max-w-5xl mx-auto px-4 py-12 border-t border-gray-100  ">
    <h2 class="text-2xl font-bold text-gray-900  ">Pick Your Situation</h2>
    <p class="text-gray-500  ">Jump to the guides that match where you are right now.</p>
    <div class="flex flex-wrap gap-3">
      {[
        'Check visa & entry rules', 'Set up payments in advance', 'Set up phone & internet', 'Set up transport', 'Prepare hotel stay', 'Plan your first 72 hours', 'Prepare safety & emergency steps', 'Handle food & daily survival', 'Plan train travel', 'Choose the right medical path',
      ].map(label => (
        <span class="text-sm px-4 py-2 rounded-full bg-gray-100  :text-gray-300 border border-gray-200  ">Coming soon</span>
      ))}
    </div>
  </section>

  <!-- Latest Verified Guides -->
  <section class="max-w-5xl mx-auto px-4 py-12 border-t border-gray-100  ">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-gray-900  ">Recently Updated Guides</h2>
        <p class="text-gray-500  ">Last verified: June 2026</p>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {[
        { title: 'Beijing for First-Time Visitors', tag: 'City' },
        { title: 'Best Cities for First-Time Visitors to China', tag: 'City' },
        { title: 'Guangzhou & Shenzhen for First-Time Visitors', tag: 'City' },
        { title: 'How Many Cities Should You Visit in China?', tag: 'Planning' },
      ].map(g => (
        <a href="#" class="block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  ">
          <span class="text-xs font-medium text-brand-600  ">{g.tag}</span>
          <h3 class="text-base font-semibold text-gray-900  ">{g.title}</h3>
          <p class="text-xs text-gray-400 mt-2">Coming soon</p>
        </a>
      ))}
    </div>
  </section>
</Layout>