---
import Layout from '@layouts/Layout.astro';
const title = "Life in China as a Traveler — Apps, SIM, Medical & Safety";
const description = "Everything you need to know about daily life in China: essential apps, SIM cards, VPN, medical care, safety tips, Chinese phrases, and what to pack.";
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-4xl mx-auto px-6 py-12">
    <header class="mb-12 text-center">
      <p class="text-sm text-gray-500 mb-2">🌏 Daily Life</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        Life in China
      </h1>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Everything you need to know about daily life as a traveler.
      </p>
    </header>

    <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-5 mb-10 not-prose">
      <h2 class="text-lg font-bold text-green-900 mb-2">Quick Overview</h2>
      <p class="text-sm text-green-800 leading-relaxed">
        <strong>Traveling in China is easier with the right preparation.</strong> Set up a SIM card and VPN before you arrive. Download essential apps for payment, transport, and translation. Know where to go for medical help, and understand local safety and customs.
      </p>
    </div>

    <div class="space-y-3 mb-16 not-prose">

      <!-- Communication & Internet -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-gray-900">Communication & Internet</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">3</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/life/sim-card-guide/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-purple-600">Internet</span>
              <p class="text-base font-semibold text-gray-900">Best SIM Card & eSIM for Tourists in China</p>
              <p class="text-sm text-gray-500 mt-0.5">Compare eSIM providers, airport SIM cards, and data plans for every budget.</p>
            </div>
          </a>
          <a href="/en/life/vpn-guide/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-red-600">VPN</span>
              <p class="text-base font-semibold text-gray-900">Best VPNs for Traveling in China</p>
              <p class="text-sm text-gray-500 mt-0.5">What works, how to set it up, and why you must do it before you arrive.</p>
            </div>
          </a>
          <a href="/en/life/essential-apps/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-blue-600">Apps</span>
              <p class="text-base font-semibold text-gray-900">10 Essential Apps for Traveling in China</p>
              <p class="text-sm text-gray-500 mt-0.5">Payment, transport, translation, and discovery — the apps that make China work.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Health & Medical -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-gray-900">Health & Medical</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">3</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/life/seeing-a-doctor/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-teal-600">Medical</span>
              <p class="text-base font-semibold text-gray-900">Seeing a Doctor in China: Clinics, Hospitals & Insurance</p>
              <p class="text-sm text-gray-500 mt-0.5">Pharmacy, clinic, or hospital — how to choose and what to expect.</p>
            </div>
          </a>
          <a href="/en/life/top-hospitals/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-teal-600">Medical</span>
              <p class="text-base font-semibold text-gray-900">Top Hospitals with International Departments</p>
              <p class="text-sm text-gray-500 mt-0.5">Best hospitals with English-speaking staff, sorted by city.</p>
            </div>
          </a>
          <a href="/en/life/travel-insurance/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-teal-600">Insurance</span>
              <p class="text-base font-semibold text-gray-900">Travel Insurance for China: What You Need to Know</p>
              <p class="text-sm text-gray-500 mt-0.5">Do you need travel insurance for China? What to look for.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Safety & Emergencies -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-gray-900">Safety & Emergencies</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">3</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/life/is-china-safe/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-red-600">Safety</span>
              <p class="text-base font-semibold text-gray-900">Is it safe to travel to China?</p>
              <p class="text-sm text-gray-500 mt-0.5">An honest take on safety, crime, and what to watch for.</p>
            </div>
          </a>
          <a href="/en/life/common-scams/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-red-600">Scams</span>
              <p class="text-base font-semibold text-gray-900">Common Scams in China & How to Avoid Them</p>
              <p class="text-sm text-gray-500 mt-0.5">Spot and avoid the most common tourist traps.</p>
            </div>
          </a>
          <a href="/en/life/emergency-numbers/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-red-600">Emergency</span>
              <p class="text-base font-semibold text-gray-900">Emergency Numbers & Help</p>
              <p class="text-sm text-gray-500 mt-0.5">110, 120, 119 — plus embassy contacts and emergency phrases.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Culture & Language -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-gray-900">Culture & Language</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">2</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/life/chinese-phrases/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-yellow-600">Language</span>
              <p class="text-base font-semibold text-gray-900">Essential Chinese Phrases for Travelers</p>
              <p class="text-sm text-gray-500 mt-0.5">20 must-know phrases with pronunciation tips.</p>
            </div>
          </a>
          <a href="/en/life/cultural-taboos/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-yellow-600">Culture</span>
              <p class="text-base font-semibold text-gray-900">Cultural Dos and Don'ts in China</p>
              <p class="text-sm text-gray-500 mt-0.5">Chopstick rules, gift giving, saving face, and photography tips.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Packing & Preparation -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-gray-900">Packing & Preparation</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">2</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/life/survival-kit/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-green-600">Checklist</span>
              <p class="text-base font-semibold text-gray-900">Your China Trip Survival Kit</p>
              <p class="text-sm text-gray-500 mt-0.5">The master checklist — apps, connection, VPN, language, and packing, all in one place.</p>
            </div>
          </a>
          <a href="/en/life/packing-guide/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-orange-600">Packing</span>
              <p class="text-base font-semibold text-gray-900">What to Pack for China — Seasons & Climate Guide</p>
              <p class="text-sm text-gray-500 mt-0.5">City-by-city, season-by-season packing recommendations.</p>
            </div>
          </a>
        </div>
      </div>

    </div>

    <script is:inline>
      function toggleHub(btn) {
        const content = btn.nextElementSibling;
        const icon = btn.querySelector('svg');
        content.classList.toggle('hidden');
        icon.classList.toggle('rotate-180');
      }
    </script>

    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/payment/payment-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-1">Payment in China</p>
          <p class="text-sm text-gray-600">Alipay, WeChat Pay, and cash</p>
        </a>
        <a href="/en/transport/transport-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-1">Transport in China</p>
          <p class="text-sm text-gray-600">Trains, metro, and ride-hailing</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
