---
import Layout from '@layouts/Layout.astro';
const title = 'Life in China — Travel Tips & Guides';
const description = 'Stay connected, stay safe, and make the most of your trip.';
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Life in China</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Stay connected, stay safe, and make the most of your trip.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">3</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">Internet & Apps</p>
      </div>
      <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-cyan-800">3</p>
        <p class="text-xs font-semibold text-cyan-800 uppercase tracking-wide mt-1">Health & Medical</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">3</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Safety & Emergencies</p>
      </div>
      <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-yellow-800">3</p>
        <p class="text-xs font-semibold text-yellow-800 uppercase tracking-wide mt-1">Culture & Essentials</p>
      </div>
      <div class="bg-teal-50 border border-teal-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-teal-800">1</p>
        <p class="text-xs font-semibold text-teal-800 uppercase tracking-wide mt-1">Accommodation</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">Communication & Internet</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/life/sim-card-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📶 Internet</span>
            <p class="text-base font-bold text-gray-900 mt-1">Best SIM Card & eSIM for Tourists</p>
            <p class="text-sm text-gray-600 mt-0.5">Compare eSIM providers, airport SIM cards, and data plans.</p>
          </a>
          <a href="/en/life/vpn-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🔒 VPN</span>
            <p class="text-base font-bold text-gray-900 mt-1">Best VPNs for Traveling in China</p>
            <p class="text-sm text-gray-600 mt-0.5">What works, how to set it up, and why before you arrive.</p>
          </a>
          <a href="/en/life/essential-apps/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📱 Apps</span>
            <p class="text-base font-bold text-gray-900 mt-1">10 Essential Apps for Traveling in China</p>
            <p class="text-sm text-gray-600 mt-0.5">Payment, transport, translation, and discovery.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-cyan-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-cyan-800">Health & Medical</h2>
          <span class="text-xs font-medium text-cyan-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/life/seeing-a-doctor/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">⚕️ Medical</span>
            <p class="text-base font-bold text-gray-900 mt-1">Seeing a Doctor in China</p>
            <p class="text-sm text-gray-600 mt-0.5">Pharmacy, clinic, or hospital — how to choose.</p>
          </a>
          <a href="/en/life/top-hospitals/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🏥 Hospitals</span>
            <p class="text-base font-bold text-gray-900 mt-1">Top Hospitals with International Departments</p>
            <p class="text-sm text-gray-600 mt-0.5">Best hospitals with English-speaking staff, by city.</p>
          </a>
          <a href="/en/life/travel-insurance/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🛡️ Insurance</span>
            <p class="text-base font-bold text-gray-900 mt-1">Travel Insurance for China</p>
            <p class="text-sm text-gray-600 mt-0.5">What you need to know about travel insurance.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Safety & Emergencies</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/life/is-china-safe/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🛡️ Safety</span>
            <p class="text-base font-bold text-gray-900 mt-1">Is It Safe to Travel to China?</p>
            <p class="text-sm text-gray-600 mt-0.5">An honest take on safety, crime, and what to watch for.</p>
          </a>
          <a href="/en/life/common-scams/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">⚠️ Scams</span>
            <p class="text-base font-bold text-gray-900 mt-1">Common Scams in China & How to Avoid Them</p>
            <p class="text-sm text-gray-600 mt-0.5">Spot and avoid the most common tourist traps.</p>
          </a>
          <a href="/en/life/emergency-numbers/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🆘 Emergency</span>
            <p class="text-base font-bold text-gray-900 mt-1">Emergency Numbers & What to Do</p>
            <p class="text-sm text-gray-600 mt-0.5">Essential contacts and step-by-step emergency response.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-yellow-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-yellow-800">Culture & Essentials</h2>
          <span class="text-xs font-medium text-yellow-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/life/packing-guide/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🧳 Packing</span>
            <p class="text-base font-bold text-gray-900 mt-1">What to Pack for China</p>
            <p class="text-sm text-gray-600 mt-0.5">Practical packing list for every season.</p>
          </a>
          <a href="/en/life/cultural-taboos/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🙏 Etiquette</span>
            <p class="text-base font-bold text-gray-900 mt-1">Cultural Dos and Don'ts in China</p>
            <p class="text-sm text-gray-600 mt-0.5">Etiquette guide for foreign visitors.</p>
          </a>
          <a href="/en/life/chinese-phrases/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🈶 Language</span>
            <p class="text-base font-bold text-gray-900 mt-1">Essential Chinese Phrases for Tourists</p>
            <p class="text-sm text-gray-600 mt-0.5">Survival Chinese for travelers.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-teal-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-teal-800">Accommodation</h2>
          <span class="text-xs font-medium text-teal-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/life/china-hotels-guide/" class="block bg-teal-50 border border-teal-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-teal-800">🏨 Hotels</span>
            <p class="text-base font-bold text-gray-900 mt-1">How to Book Hotels in China for Foreigners</p>
            <p class="text-sm text-gray-600 mt-0.5">Book hotels in China as a foreigner — Trip.com, hotel prices, foreign-guest policies, check-in, and where to stay.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">Next Step</p>
            <h3 class="text-xl font-bold text-gray-900">Plan your trip</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">You're ready for daily life in China. Now: get your visa sorted and learn how to get around.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/en/visa/visa-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🛂 Visa guide
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/en/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 Transport guide
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>