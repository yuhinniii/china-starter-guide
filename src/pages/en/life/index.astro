---
import Layout from '@layouts/Layout.astro';
const title = "Life in China as a Traveler — Apps, SIM, VPN & Packing";
const description = "Everything you need to know about daily life in China: essential apps, SIM cards, VPN, Chinese phrases, and what to pack.";
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <header class="mb-16 text-center">
      <p class="text-sm text-gray-500 mb-3">🌏 Daily Life</p>
      <h1 class="text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
        Life in China as a Traveler
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        From apps and internet access to packing and basic Chinese — here's everything you need to settle in.
      </p>
    </header>

    <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-16 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 Quick Overview</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        Traveling in China is a lot easier when you have the right tools and preparation. This section covers the <strong>essential apps</strong>, <strong>SIM card & eSIM options</strong>, <strong>VPN setup</strong>, <strong>basic Chinese phrases</strong>, and <strong>what to pack</strong> — everything you need to feel ready before you step off the plane.
      </p>
    </div>

    <div class="space-y-6 mb-16 not-prose">
      <a href="/en/life/survival-kit/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-green-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-2xl">🎒</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-green-600">Overview</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-green-600 transition">Your China Trip Survival Kit</h2>
          <p class="text-gray-600 mt-1">The master checklist — apps, connection, VPN, language, and packing, all in one place.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 6 min read</p>
        </div>
      </a>

      <a href="/en/life/essential-apps/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-blue-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl">📱</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-blue-600">Apps</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition">10 Apps You Need Before Traveling to China</h2>
          <p class="text-gray-600 mt-1">Payment, transport, translation, and discovery — the apps that make China work.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 5 min read</p>
        </div>
      </a>

      <a href="/en/life/sim-card-guide/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-purple-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-2xl">📶</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-purple-600">Internet</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-purple-600 transition">Best SIM Card & eSIM for Tourists in China</h2>
          <p class="text-gray-600 mt-1">Compare eSIM providers, airport SIM cards, and data plans for every budget.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 5 min read</p>
        </div>
      </a>

      <a href="/en/life/vpn-guide/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-red-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center text-2xl">🔒</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-red-600">VPN</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-red-600 transition">Best VPNs for Traveling in China</h2>
          <p class="text-gray-600 mt-1">What works, how to set it up, and why you must do it before you arrive.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 5 min read</p>
        </div>
      </a>

      <a href="/en/life/chinese-phrases/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-yellow-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-yellow-100 flex items-center justify-center text-2xl">🗣️</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-yellow-600">Language</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-yellow-600 transition">Essential Chinese Phrases for Travelers</h2>
          <p class="text-gray-600 mt-1">20 must-know phrases with pronunciation tips — plus cultural notes.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 4 min read</p>
        </div>
      </a>

      <a href="/en/life/packing-guide/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-orange-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center text-2xl">🎒</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-orange-600">Packing</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-orange-600 transition">What to Pack for China — Seasons & Climate Guide</h2>
          <p class="text-gray-600 mt-1">City-by-city, season-by-season — pack right for every destination.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 6 min read</p>
        </div>
      </a>
    </div>

    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/payment/setup-alipay/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">💳 How to Set Up Alipay</p>
          <p class="text-sm text-gray-600">Connect your foreign card and start paying like a local</p>
        </a>
        <a href="/en/payment/setup-wechat/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">💬 How to Set Up WeChat Pay</p>
          <p class="text-sm text-gray-600">WeChat is essential — set it up before you go</p>
        </a>
        <a href="/en/transport/didi/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🚗 How to Use Didi in China</p>
          <p class="text-sm text-gray-600">China's Uber — safe, cheap, and easy to use</p>
        </a>
        <a href="/en/transport/high-speed-rail/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🚄 How to Book High-Speed Rail</p>
          <p class="text-sm text-gray-600">The best way to travel between Chinese cities</p>
        </a>
      </div>
    </div>
  </section>
</Layout>