---
import Layout from '@layouts/Layout.astro';
const title = "Medical Care in China — Clinics, Hospitals & Insurance";
const description = "Guide to medical care in China for foreign visitors: seeing a doctor, top hospitals with international departments, and travel insurance.";
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-4xl mx-auto px-6 py-12">
    <!-- Header -->
    <header class="mb-12 text-center">
      <p class="text-sm text-gray-500 mb-3">🏥 Medical Care</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        Medical Care in China
      </h1>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        What to do if you get sick or injured in China — from pharmacies to top hospitals with international departments.
      </p>
    </header>

    <!-- Quick Overview -->
    <div class="bg-gradient-to-r from-teal-50 to-emerald-50 border-l-4 border-teal-500 rounded-r-2xl p-5 mb-10 not-prose">
      <h2 class="text-lg font-bold text-teal-900 mb-4">🎯 Quick Overview</h2>
      <p class="text-sm text-teal-800 leading-relaxed">
        <strong>China has excellent medical facilities in major cities.</strong> International hospitals with English-speaking staff are available in Beijing, Shanghai, and Guangzhou. Pharmacies are everywhere for minor issues. Travel insurance is recommended — make sure it covers China.
      </p>
    </div>

    <!-- Article Directory -->
    <div class="space-y-3 mb-16 not-prose">

      <!-- Medical Care -->
      <div class="bg-teal-50 border border-teal-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-teal-100 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-teal-900">Medical Care</span>
            <span class="text-xs font-medium text-teal-600 bg-teal-100 px-2 py-0.5 rounded-full">2</span>
          </div>
          <svg class="w-4 h-4 text-teal-600 transition-transform duration-200 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content border-t border-teal-100">
          <a href="/en/life/seeing-a-doctor/" class="flex items-center gap-3 px-5 py-4 hover:bg-teal-50 transition border-b border-teal-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-teal-600">Medical</span>
              <p class="text-base font-semibold text-gray-900">Seeing a Doctor in China: Clinics, Hospitals & Insurance</p>
              <p class="text-sm text-gray-500 mt-0.5">Pharmacy, clinic, or hospital — how to choose and what to expect.</p>
            </div>
          </a>
          <a href="/en/life/top-hospitals/" class="flex items-center gap-3 px-5 py-4 hover:bg-teal-50 transition border-b border-teal-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-teal-600">Medical</span>
              <p class="text-base font-semibold text-gray-900">Top Hospitals with International Departments</p>
              <p class="text-sm text-gray-500 mt-0.5">Best hospitals with English-speaking staff, sorted by city.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Insurance -->
      <div class="bg-blue-50 border border-blue-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-blue-100 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-blue-900">Insurance</span>
            <span class="text-xs font-medium text-blue-600 bg-blue-100 px-2 py-0.5 rounded-full">1</span>
          </div>
          <svg class="w-4 h-4 text-blue-600 transition-transform duration-200 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content border-t border-blue-100">
          <a href="/en/life/travel-insurance/" class="flex items-center gap-3 px-5 py-4 hover:bg-blue-50 transition border-b border-blue-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-blue-600">Insurance</span>
              <p class="text-base font-semibold text-gray-900">Travel Insurance for China: What You Need to Know</p>
              <p class="text-sm text-gray-500 mt-0.5">Do you need travel insurance for China? What to look for.</p>
            </div>
          </a>
        </div>
      </div>

    </div>

    <script is:inline>
      function toggleHub(btn) {
        const content = btn.nextElementSibling;
        const icon = btn.querySelector('svg');
        content.classList.toggle('hidden');
        icon.classList.toggle('rotate-180');
      }
    </script>

    <!-- Related Links -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/life/sim-card-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-1">📶 SIM Card & eSIM Guide</p>
          <p class="text-sm text-gray-600">Stay connected while traveling</p>
        </a>
        <a href="/en/tips/emergency-numbers/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-1">📞 Emergency Numbers</p>
          <p class="text-sm text-gray-600">What to do if you need help</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
