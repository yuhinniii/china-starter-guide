---
import Layout from '@layouts/Layout.astro';
const title = 'Medical Guide for China — Hospitals & Insurance';
const description = 'Healthcare in China for foreign visitors.';
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🏥 Medical</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Medical Guide for China</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Healthcare in China for foreign visitors.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-cyan-800">1</p>
        <p class="text-xs font-semibold text-cyan-800 uppercase tracking-wide mt-1">Hospital Guide</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">Insurance Guide</p>
      </div>
      <div class="bg-teal-50 border border-teal-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-teal-800">1</p>
        <p class="text-xs font-semibold text-teal-800 uppercase tracking-wide mt-1">Doctor Visit Guide</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-cyan-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-cyan-800">Medical Services</h2>
          <span class="text-xs font-medium text-cyan-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/medical/top-hospitals/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🏥 Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Top Hospitals with International Departments</p>
            <p class="text-sm text-gray-600 mt-0.5">Best hospitals for English-speaking travelers in major Chinese cities.</p>
          </a>
          <a href="/en/medical/seeing-a-doctor/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">⚕️ Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Seeing a Doctor in China as a Foreigner</p>
            <p class="text-sm text-gray-600 mt-0.5">How clinics and hospitals work — appointments, costs, and language help.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Insurance</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/medical/travel-insurance/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🛡️ Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Travel Insurance for China</p>
            <p class="text-sm text-gray-600 mt-0.5">Do you need it? What to look for in a policy — explained simply.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/en/life/survival-kit/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Survival Kit</p>
          <p class="text-sm text-gray-500">Pre-departure checklist</p>
        </a>
        <a href="/en/tips/emergency-numbers/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Emergency Numbers</p>
          <p class="text-sm text-gray-500">What to do if you need help</p>
        </a>
      </div>
    </div>
  </section>
</Layout>