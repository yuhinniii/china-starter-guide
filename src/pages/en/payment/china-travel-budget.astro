        <tbody><tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">Flights (US West Coast or Europe, shoulder season)</td><td class="px-6 py-4">¥5,800</td><td class="px-6 py-4">$800</td></tr><tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">3-4 star hotel (10 nights, mid-tier chain)</td><td class="px-6 py-4">¥5,400</td><td class="px-6 py-4">$750</td></tr><tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">Food (10 days, mix of casual and mid-range)</td><td class="px-6 py-4">¥1,440</td><td class="px-6 py-4">$200</td></tr><tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">High-speed rail between cities (3 legs)</td><td class="px-6 py-4">¥2,200</td><td class="px-6 py-4">$300</td></tr><tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">Within-city transport (metro + Didi)</td><td class="px-6 py-4">¥500</td><td class="px-6 py-4">$70</td></tr><tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">Attractions + one guided experience</td><td class="px-6 py-4">¥720</td><td class="px-6 py-4">$100</td></tr><tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">Visa + insurance + SIM</td><td class="px-6 py-4">¥720</td><td class="px-6 py-4">$100</td></tr></tbody>
