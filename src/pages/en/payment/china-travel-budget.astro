const description = "How much does a trip to China cost in 2026? A complete budget guide covering flights, hotels, food, transport, and attractions, with a 10-day total budget breakdown.";
---

<Layout title={title} description={description} lang="en" type="Article">
  <nav class="mb-8 not-prose">
