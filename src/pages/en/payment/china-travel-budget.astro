        <tbody><tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">Flights (US East Coast or peak season)</td><td class="px-6 py-4">¥12,600</td><td class="px-6 py-4">$1,750</td></tr><tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">4-5 star hotel (10 nights, international chains)</td><td class="px-6 py-4">¥12,000</td><td class="px-6 py-4">$1,650</td></tr><tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">Food (10 days, mid-range + a few high-end)</td><td class="px-6 py-4">¥2,900</td><td class="px-6 py-4">$400</td></tr><tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">Private transfers + domestic flights between cities</td><td class="px-6 py-4">¥4,300</td><td class="px-6 py-4">$600</td></tr><tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">Within-city transport (private car or taxi)</td><td class="px-6 py-4">¥720</td><td class="px-6 py-4">$100</td></tr><tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">Guided tours + premium experiences</td><td class="px-6 py-4">¥2,200</td><td class="px-6 py-4">$300</td></tr><tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">Visa + insurance + SIM</td><td class="px-6 py-4">¥1,440</td><td class="px-6 py-4">$200</td></tr></tbody>
