---
import Layout from '@layouts/Layout.astro';
const title = "Payment Guide — How to Pay in China";
const description = "Step-by-step guides for foreigners to set up Alipay, WeChat Pay, and use credit cards in China.";
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <!-- Header -->
    <header class="mb-16 text-center">
      <p class="text-sm text-gray-500 mb-3">💳 Payment</p>
      <h1 class="text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
        Payment Guide
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        How to set up Alipay, WeChat Pay, use credit cards, and handle payments in China — step-by-step guides for foreign visitors.
      </p>
    </header>

    <!-- Quick Overview -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-16 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 Quick Overview</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        <strong>Set up Alipay before you fly.</strong> Link your Visa or Mastercard to it — that covers 95% of your payments in China. WeChat Pay is a good backup. Cash works everywhere but is less convenient. Physical credit cards only work at international hotels and airports.
      </p>
    </div>

    <!-- Article Directory -->
    <div class="space-y-6 mb-16 not-prose">
      <!-- Article 1 -->
      <a href="/en/payment/payment-guide/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-blue-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl">💳</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-blue-600">Overview</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition">How to Pay in China: The Complete Payment Guide</h2>
          <p class="text-gray-600 mt-1">Alipay, WeChat Pay, cash, or credit cards — a complete overview of payment options in China for foreign visitors.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 5 min read</p>
        </div>
      </a>

      <!-- Article 2 -->
      <a href="/en/payment/setup-alipay/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-green-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-2xl">📱</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-green-600">Tutorial</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-green-600 transition">How to Set Up Alipay as a Foreigner (2026)</h2>
          <p class="text-gray-600 mt-1">Download, register with your international number, verify your identity with your passport, and link your foreign credit card.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 5 min read</p>
        </div>
      </a>

      <!-- Article 3 -->
      <a href="/en/payment/setup-wechat/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-purple-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-2xl">💬</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-purple-600">Tutorial</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-purple-600 transition">How to Set Up WeChat Pay as a Foreigner (2026)</h2>
          <p class="text-gray-600 mt-1">Download WeChat, register, verify your identity, and bind your international card. Having both Alipay and WeChat Pay is the gold standard.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 5 min read</p>
        </div>
      </a>

      <!-- Article 4 -->
      <a href="/en/payment/foreign-cards/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-orange-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center text-2xl">💳</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-orange-600">Guide</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-orange-600 transition">Can You Use Foreign Credit Cards in China?</h2>
          <p class="text-gray-600 mt-1">Where your Visa or Mastercard actually works, ATM withdrawal costs, and why mobile payments are the way to go.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 4 min read</p>
        </div>
      </a>

      <!-- Article 5 -->
      <a href="/en/payment/tipping/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-pink-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-pink-100 flex items-center justify-center text-2xl">🤷</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-pink-600">Culture</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-pink-600 transition">China Tipping Culture: Do You Need to Tip?</h2>
          <p class="text-gray-600 mt-1">No, tipping is not expected in China. A quick guide for foreign visitors on what to do (and what not to do).</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 3 min read</p>
        </div>
      </a>

      <!-- Article 6 -->
      <a href="/en/payment/payment-fails/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-red-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center text-2xl">⚠️</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-red-600">Troubleshoot</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-red-600 transition">What to Do When Your Payment Fails in China</h2>
          <p class="text-gray-600 mt-1">Common payment failure reasons for foreign users and step-by-step troubleshooting when your QR code payment won't go through.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 4 min read</p>
        </div>
      </a>
    </div>

    <!-- Related Links -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/transport/transport-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🚄 How to Get Around China</p>
          <p class="text-sm text-gray-600">Transport options for travelers</p>
        </a>
        <a href="/en/medical/seeing-a-doctor/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🏥 Seeing a Doctor in China</p>
          <p class="text-sm text-gray-600">Clinics, hospitals, and what to expect</p>
        </a>
      </div>
    </div>
  </section>
</Layout>