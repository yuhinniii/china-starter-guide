---
import Layout from '@layouts/Layout.astro';
const title = "Payment Guide — How to Pay in China";
const description = "Step-by-step guides for foreigners to set up Alipay, WeChat Pay, and use credit cards in China.";
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-4xl mx-auto px-6 py-12">
    <!-- Header -->
    <header class="mb-12 text-center">
      <p class="text-sm text-gray-500 mb-2">💳 Payment</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        Payment in China
      </h1>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Everything you need to know about using money in China.
      </p>
    </header>

    <!-- Quick Overview -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-5 mb-10 not-prose">
      <h2 class="text-lg font-bold text-blue-900 mb-2">Quick Overview</h2>
      <p class="text-sm text-blue-800 leading-relaxed">
        <strong>Set up Alipay before you fly.</strong> Link your Visa or Mastercard to it — that covers 95% of your payments in China. WeChat Pay is a good backup. Cash works everywhere but is less convenient. Physical credit cards only work at international hotels and airports.
      </p>
    </div>

    <!-- Category Sections -->
    <div class="space-y-3 mb-16 not-prose">

      <!-- Getting Started -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-gray-900">Getting Started</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">2</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/payment/setup-alipay/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-green-600">Tutorial</span>
              <p class="text-base font-semibold text-gray-900">How to Set Up Alipay as a Foreigner</p>
              <p class="text-sm text-gray-500 mt-0.5">Download, register with your international number, and link your foreign credit card.</p>
            </div>
          </a>
          <a href="/en/payment/setup-wechat/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-purple-600">Tutorial</span>
              <p class="text-base font-semibold text-gray-900">How to Set Up WeChat Pay as a Foreigner</p>
              <p class="text-sm text-gray-500 mt-0.5">Download WeChat, register, verify your identity, and bind your international card.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Using International Cards -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-gray-900">Using International Cards</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">1</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/payment/foreign-cards/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-orange-600">Guide</span>
              <p class="text-base font-semibold text-gray-900">Can You Use Foreign Credit Cards in China?</p>
              <p class="text-sm text-gray-500 mt-0.5">Where your Visa or Mastercard actually works, ATM withdrawal costs, and why mobile payments are the way to go.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Common Problems -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-gray-900">Common Problems</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">1</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/payment/payment-fails/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-red-600">Troubleshoot</span>
              <p class="text-base font-semibold text-gray-900">What to Do When Your Payment Fails in China</p>
              <p class="text-sm text-gray-500 mt-0.5">Common payment failure reasons and step-by-step troubleshooting when your QR code payment won't go through.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Tipping & Culture -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-gray-900">Tipping & Culture</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">1</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/payment/tipping/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-pink-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-pink-600">Culture</span>
              <p class="text-base font-semibold text-gray-900">China Tipping Culture: Do You Need to Tip?</p>
              <p class="text-sm text-gray-500 mt-0.5">No, tipping is not expected in China. A quick guide on what to do (and what not to do).</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Complete Guide -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-gray-900">Complete Guide</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">1</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/payment/payment-guide/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-blue-600">Overview</span>
              <p class="text-base font-semibold text-gray-900">How to Pay in China: Complete Guide for Foreign Visitors</p>
              <p class="text-sm text-gray-500 mt-0.5">Alipay, WeChat Pay, cash, or credit cards — a complete overview of payment options in China.</p>
            </div>
          </a>
        </div>
      </div>

    </div>

    <script is:inline>
      function toggleHub(btn) {
        const content = btn.nextElementSibling;
        const icon = btn.querySelector('svg');
        content.classList.toggle('hidden');
        icon.classList.toggle('rotate-180');
      }
    </script>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/transport/transport-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-1">Transport in China</p>
          <p class="text-sm text-gray-600">Trains, metro, taxis, and ride-hailing</p>
        </a>
        <a href="/en/life/essential-apps/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-1">Essential Apps for China</p>
          <p class="text-sm text-gray-600">Must-have apps for traveling in China</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
