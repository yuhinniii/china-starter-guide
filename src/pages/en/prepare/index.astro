---
import Layout from '@layouts/Layout.astro';
const title = "Prepare Before You Arrive — Visa, Documents & Essential Setup";
const description = "Everything you need to prepare before flying to China: visa options, documents, and essential first steps.";
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-4xl mx-auto px-6 py-12">
    <!-- Header -->
    <header class="mb-12 text-center">
      <p class="text-sm text-gray-500 mb-3">📋 Prepare</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        Prepare Before You Arrive
      </h1>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Essential steps to complete before landing in China — visa, documents, and first-72-hours planning.
      </p>
    </header>

    <!-- Quick Overview -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-5 mb-10 not-prose">
      <h2 class="text-lg font-bold text-blue-900 mb-4">🎯 Quick Overview</h2>
      <p class="text-sm text-blue-800 leading-relaxed">
        <strong>Preparation is the key to a smooth trip.</strong> Get your visa sorted first, then set up your digital tools — SIM card, VPN, payment apps — before you fly. This section walks you through everything you need before stepping on the plane.
      </p>
    </div>

    <!-- Article Directory -->
    <div class="space-y-3 mb-16 not-prose">

      <!-- Visa & Entry -->
      <div class="bg-green-50 border border-green-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-green-100 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-green-900">Visa & Entry</span>
            <span class="text-xs font-medium text-green-600 bg-green-100 px-2 py-0.5 rounded-full">2</span>
          </div>
          <svg class="w-4 h-4 text-green-600 transition-transform duration-200 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content border-t border-green-100">
          <a href="/en/visa/visa-guide/" class="flex items-center gap-3 px-5 py-4 hover:bg-green-50 transition border-b border-green-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-green-600">Overview</span>
              <p class="text-base font-semibold text-gray-900">China Visa Types Complete Guide</p>
              <p class="text-sm text-gray-500 mt-0.5">All visa options explained — compare visa-free, transit, and L visa.</p>
            </div>
          </a>
          <a href="/en/visa/visa-free/" class="flex items-center gap-3 px-5 py-4 hover:bg-green-50 transition border-b border-green-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-green-600">List</span>
              <p class="text-base font-semibold text-gray-900">China Visa-Free Countries List</p>
              <p class="text-sm text-gray-500 mt-0.5">50 countries can enter without a visa for up to 30 days.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Digital Setup -->
      <div class="bg-blue-50 border border-blue-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-blue-100 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-blue-900">Digital Setup</span>
            <span class="text-xs font-medium text-blue-600 bg-blue-100 px-2 py-0.5 rounded-full">1</span>
          </div>
          <svg class="w-4 h-4 text-blue-600 transition-transform duration-200 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content border-t border-blue-100">
          <a href="/en/life/sim-card-guide/" class="flex items-center gap-3 px-5 py-4 hover:bg-blue-50 transition border-b border-blue-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-blue-600">Internet</span>
              <p class="text-base font-semibold text-gray-900">Best SIM Card & eSIM for Tourists in China</p>
              <p class="text-sm text-gray-500 mt-0.5">Compare eSIM providers, airport SIM cards, and data plans for every budget.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Before You Fly -->
      <div class="bg-amber-50 border border-amber-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-amber-100 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-xl font-bold text-amber-900">Before You Fly</span>
            <span class="text-xs font-medium text-amber-600 bg-amber-100 px-2 py-0.5 rounded-full">2</span>
          </div>
          <svg class="w-4 h-4 text-amber-600 transition-transform duration-200 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content border-t border-amber-100">
          <a href="/en/visa/customs-guide/" class="flex items-center gap-3 px-5 py-4 hover:bg-amber-50 transition border-b border-amber-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-amber-600">Regulations</span>
              <p class="text-base font-semibold text-gray-900">China Customs Regulations</p>
              <p class="text-sm text-gray-500 mt-0.5">Duty-free limits, prohibited items, and what to declare.</p>
            </div>
          </a>
          <a href="/en/life/survival-kit/" class="flex items-center gap-3 px-5 py-4 hover:bg-amber-50 transition border-b border-amber-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-amber-600">Checklist</span>
              <p class="text-base font-semibold text-gray-900">Your China Trip Survival Kit</p>
              <p class="text-sm text-gray-500 mt-0.5">The master checklist — apps, connection, VPN, language, and packing, all in one place.</p>
            </div>
          </a>
        </div>
      </div>

    </div>

    <script is:inline>
      function toggleHub(btn) {
        const content = btn.nextElementSibling;
        const icon = btn.querySelector('svg');
        content.classList.toggle('hidden');
        icon.classList.toggle('rotate-180');
      }
    </script>

    <!-- Related Links -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/payment/payment-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-1">💳 Payment in China</p>
          <p class="text-sm text-gray-600">Alipay, WeChat Pay, and cash</p>
        </a>
        <a href="/en/transport/transport-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-1">🚄 Transport in China</p>
          <p class="text-sm text-gray-600">Trains, metro, and ride-hailing</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
