---
import Layout from '@layouts/Layout.astro';
const title = 'Visa & Entry Rules — China Starter Guide';
const description = 'Visa-free entry, 240-hour transit, and tourist visa guides for visiting China in 2026. Updated June 2026.';
---

<Layout title={title} description={description} lang="en">
  <div class="max-w-3xl mx-auto py-12">
    <!-- Header -->
    <header class="mb-12">
      <a href="/en/prepare/" class="text-sm text-brand-600 hover:underline inline-flex items-center gap-1 mb-4">← Prepare</a>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-4">
        Visa & Entry Rules
      </h1>
      <p class="text-lg text-gray-500">
        Everything you need to know about entering China legally and smoothly in 2026.
      </p>
    </header>

    <!-- Article List -->
    <div class="space-y-6">
      <!-- Article 1 -->
      <a href="/en/prepare/visa/visa-guide/" class="block group">
        <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:border-brand-200 hover:shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded">GUIDE</span>
            <span class="text-xs text-gray-400">6 min read</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
            How Easy Is It to Get a Chinese Visa in 2026?
          </h2>
          <p class="text-gray-600 leading-relaxed mb-3">
            Getting into China is easier than it was a few years ago. Compare visa-free entry, 240-hour transit, and tourist visa options to find what fits your trip.
          </p>
          <p class="text-sm text-brand-600 font-medium">Read more →</p>
        </div>
      </a>

      <!-- Article 2 -->
      <a href="/en/prepare/visa/visa-free/" class="block group">
        <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:border-brand-200 hover:shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded">REFERENCE</span>
            <span class="text-xs text-gray-400">5 min read</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
            China Visa-Free Countries List (2026)
          </h2>
          <p class="text-gray-600 leading-relaxed mb-3">
            Check if your country is eligible for visa-free entry to China. Includes all 55+ countries, stay limits, and entry requirements.
          </p>
          <p class="text-sm text-brand-600 font-medium">Read more →</p>
        </div>
      </a>

      <!-- Article 3 -->
      <a href="/en/prepare/visa/transit-240/" class="block group">
        <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:border-brand-200 hover:shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded">GUIDE</span>
            <span class="text-xs text-gray-400">7 min read</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
            China 240-Hour Visa-Free Transit Explained
          </h2>
          <p class="text-gray-600 leading-relaxed mb-3">
            Stay in China up to 10 days without a visa while transiting to a third country. Eligibility, ports, and allowed activities.
          </p>
          <p class="text-sm text-brand-600 font-medium">Read more →</p>
        </div>
      </a>
    </div>

    <!-- Quick Answer Box -->
    <div class="mt-12 bg-brand-50 border border-brand-100 rounded-2xl p-6 not-prose">
      <h3 class="font-bold text-gray-900 mb-3">Quick Answer</h3>
      <p class="text-gray-700 mb-4">
        Most travelers can now enter China without a visa (30 days), use the 240-hour transit policy, or apply for a standard tourist visa. Check the articles above to find which option fits your situation.
      </p>
      <a href="/en/prepare/visa/visa-guide/" class="inline-flex items-center gap-1 text-sm text-brand-600 font-medium hover:underline">
        Start with the visa guide →
      </a>
    </div>
  </div>
</Layout>
