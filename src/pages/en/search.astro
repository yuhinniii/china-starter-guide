---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Search - China Starter Guide" lang="en">
  <div class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Search</h1>
    <div class="mb-8">
      <input
        type="text"
        id="search-input"
        placeholder="Search guides, tips, city info..."
        class="w-full px-5 py-3 rounded-2xl border border-gray-200  :bg-gray-900 text-gray-900  :outline-none focus:ring-2 focus:ring-brand-500 text-base"
      />
    </div>
    <div id="search-results" class="space-y-4">
      <p class="text-gray-500  ">Enter a keyword above to search our guides.</p>
    </div>
  </div>

  <script is:inline>
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const pages = [
      { title: 'Payment Guide', url: '/en/payment/', desc: 'How to pay in China — Alipay, WeChat Pay, cash, and card.' },
      { title: 'Transport Guide', url: '/en/transport/', desc: 'Trains, metro, taxis, and ride-hailing apps.' },
      { title: 'Essential Apps', url: '/en/apps/', desc: 'Must-have apps for living and traveling in China.' },
      { title: 'City Guides', url: '/en/cities/', desc: 'Beijing, Shanghai, Guangzhou, Shenzhen and more.' },
      { title: 'Travel Tips', url: '/en/tips/', desc: 'Practical advice for a smoother trip.' },
      { title: 'Prepare Before Arrival', url: '/en/prepare/', desc: 'Visa, documents, and first-72-hours planning.' },
      { title: 'Medical Care', url: '/en/medical/', desc: 'How to see a doctor and what it costs.' },
      { title: 'About', url: '/en/about/', desc: 'About this site and contact information.' },
    ];

    input.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      if (!q) {
        results.innerHTML = '<p class="text-gray-500  ">Enter a keyword above to search our guides.</p>';
        return;
      }
      const matched = pages.filter(p =>
        p.title.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q)
      );
      if (matched.length === 0) {
        results.innerHTML = '<p class="text-gray-500  ">No results found. Try a different keyword.</p>';
        return;
      }
      results.innerHTML = matched.map(p =>
        `<a href="${p.url}" class="block p-5 rounded-2xl bg-gray-50  :bg-gray-100 dark:hover:bg-gray-800 no-underline transition-colors">
          <h3 class="text-lg font-semibold text-brand-600  ">${p.title}</h3>
          <p class="text-gray-600  ">${p.desc}</p>
        </a>`
      ).join('');
    });
  </script>
</Layout>