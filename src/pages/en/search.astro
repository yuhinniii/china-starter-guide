---
import Layout from '@layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

const pagesDir = path.resolve('src/pages/en');

function scanPages(dir) {
  const results = [];
  const items = fs.readdirSync(dir, { withFileTypes: true });
  for (const item of items) {
    const full = path.join(dir, item.name);
    if (item.isDirectory()) {
      results.push(...scanPages(full));
    } else if (item.name.endsWith('.astro') && item.name !== 'search.astro') {
      const content = fs.readFileSync(full, 'utf8');
      const titleMatch = content.match(/const title = '([^']+)'/);
      const descMatch = content.match(/const description = '([^']+)'/);
      if (!titleMatch) continue;

      // Generate URL from file path
      let url = path.relative(pagesDir, full).replace(/\\/g, '/');
      url = url.replace(/\.astro$/, '');
      // index.astro → section root (e.g., /en/payment/)
      url = url.replace(/\/index$/, '');
      // Homepage
      if (url === 'index') url = '';
      url = '/en/' + url + '/';
      // Fix double slashes
      url = url.replace(/\/\/+/g, '/');

      // Generate tags from title + description
      const desc = descMatch ? descMatch[1] : '';
      const tagWords = (titleMatch[1] + ' ' + desc)
        .toLowerCase()
        .replace(/['"]/g, '')
        .replace(/[^a-z0-9\s]/g, ' ')
        .split(/\s+/)
        .filter(w => w.length > 2 && !['the','and','for','you','your','what','how','are','not','with','that','this','from','china'].includes(w))
        .filter((w,i,a) => a.indexOf(w) === i) // unique
        .slice(0, 15)
        .join(' ');

      results.push({
        title: titleMatch[1].replace(/&amp;/g, '&'),
        url,
        desc: desc.replace(/&amp;/g, '&'),
        tags: tagWords
      });
    }
  }
  return results;
}

const pages = scanPages(pagesDir);
// Sort by section: group by URL path
pages.sort((a, b) => a.url.localeCompare(b.url));
---

<Layout title="Search — China Starter Hub" lang="en">
  <div class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Search</h1>
    <div class="mb-4">
      <input
        type="text"
        id="search-input"
        placeholder="Search guides, tips, city info..."
        class="w-full px-5 py-3 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500 text-base"
      />
    </div>
    <p class="text-xs text-gray-400 mb-6" id="result-count">{pages.length} guides indexed</p>
    <div id="search-results" class="space-y-4">
      <p class="text-gray-500">Enter a keyword above to search our guides.</p>
    </div>
  </div>

  <!-- Embed search data as JSON -->
  <div id="search-data" style="display:none">{JSON.stringify(pages)}</div>

  <script is:inline>
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const count = document.getElementById('result-count');
    const pages = JSON.parse(document.getElementById('search-data').textContent);

    input.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      if (!q) {
        results.innerHTML = '<p class="text-gray-500">Enter a keyword above to search our guides.</p>';
        count.textContent = pages.length + ' guides indexed';
        return;
      }
      const matched = pages.filter(p =>
        p.title.toLowerCase().includes(q) ||
        p.desc.toLowerCase().includes(q) ||
        p.tags.includes(q)
      );
      if (matched.length === 0) {
        results.innerHTML = '<p class="text-gray-500">No results found. Try a different keyword.</p>';
        count.textContent = '0 results';
        return;
      }
      count.textContent = matched.length + ' result' + (matched.length > 1 ? 's' : '');
      results.innerHTML = matched.map(p =>
        `<a href="${p.url}" class="block p-5 rounded-2xl bg-gray-50 hover:bg-gray-100 transition-colors no-underline">
          <h3 class="text-lg font-semibold text-brand-600">${p.title}</h3>
          <p class="text-gray-600">${p.desc}</p>
        </a>`
      ).join('');
    });
  </script>
</Layout>
