<script type="application/ld+json">{"@context": "https://schema.org", "@type": "HowTo", "name": "How to Use Didi in China as a Foreigner", "step": [{"@type": "HowToStep", "name": "Open Alipay or WeChat", "text": "Open Alipay or WeChat"}, {"@type": "HowToStep", "name": "Scroll down to \"Mini Programs\" (or search for \"DiD", "text": "Scroll down to \"Mini Programs\" (or search for \"DiDi\")"}, {"@type": "HowToStep", "name": "Tap the DiDi mini-program", "text": "Tap the DiDi mini-program"}, {"@type": "HowToStep", "name": "Allow location access", "text": "Allow location access"}, {"@type": "HowToStep", "name": "Set your pickup and destination, choose a ride typ", "text": "Set your pickup and destination, choose a ride type, and confirm."}]}</script>
