<script type="application/ld+json">{"@context": "https://schema.org", "@type": "HowTo", "name": "How to Book and Ride China High-Speed Rail: Step-by-Step Guide", "step": [{"@type": "HowToStep", "name": "Book your ticket", "text": "Book on Trip.com (foreign-card friendly) or the official 12306 English site with your passport. No Chinese ID or phone number is required."}, {"@type": "HowToStep", "name": "Verify your passport (12306 only)", "text": "On 12306, register, add yourself as a passenger, and complete the one-time identity verification — automatic, by uploading your passport photo, or at a station counter."}, {"@type": "HowToStep", "name": "Arrive early", "text": "Reach the station 30–40 minutes before departure."}, {"@type": "HowToStep", "name": "Pass security", "text": "Put bags through the X-ray machine. No need to remove liquids or laptops."}, {"@type": "HowToStep", "name": "Show your passport at the gate", "text": "Use the manual counter lane (far left or right of the gate bank). Hand your passport to staff — automated gates read Chinese ID only."}, {"@type": "HowToStep", "name": "Find your carriage and board", "text": "Match the color code on the platform screens to the floor markers, then board and keep your passport handy for onboard checks."}]}</script>
