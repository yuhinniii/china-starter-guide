---
import Layout from '@layouts/Layout.astro';
const title = 'Transport Guide — Getting Around China';
const description = 'Trains, planes, metro, and ride-hailing — everything you need.';
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Transport in China</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Trains, planes, metro, and ride-hailing — everything you need.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-sky-50 border border-sky-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-sky-800">1</p>
        <p class="text-xs font-semibold text-sky-800 uppercase tracking-wide mt-1">High-Speed Rail Guide</p>
      </div>
      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-emerald-800">1</p>
        <p class="text-xs font-semibold text-emerald-800 uppercase tracking-wide mt-1">Airport Transfers</p>
      </div>
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">3</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">City Transport</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-gray-800">1</p>
        <p class="text-xs font-semibold text-gray-800 uppercase tracking-wide mt-1">Ride-Hailing Guide</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-sky-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-sky-800">Getting Around China</h2>
          <span class="text-xs font-medium text-sky-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/transport/transport-guide/" class="block bg-sky-50 border border-sky-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-sky-800">📖 Overview</span>
            <p class="text-base font-bold text-gray-900 mt-1">How to Get Around China</p>
            <p class="text-sm text-gray-600 mt-0.5">Complete overview of all transport options — trains, planes, metro, and more.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">Arriving in China</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/transport/airport-to-city/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🛬 Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">From Airport to City</p>
            <p class="text-sm text-gray-600 mt-0.5">Transport options at major airports — Beijing, Shanghai, Guangzhou, and more.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">City Transport</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/transport/high-speed-rail/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚄 Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">How to Book and Ride China High-Speed Rail</p>
            <p class="text-sm text-gray-600 mt-0.5">Everything about booking and riding the world's largest HSR network.</p>
          </a>
          <a href="/en/transport/metro-bus/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚇 Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Metro & Bus Guide for Major Cities</p>
            <p class="text-sm text-gray-600 mt-0.5">Navigate public transit in Beijing, Shanghai, Guangzhou, and Shenzhen.</p>
          </a>
          <a href="/en/transport/flights-vs-rail/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">✈️ Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Flights vs High-Speed Rail</p>
            <p class="text-sm text-gray-600 mt-0.5">Train or plane for your China trip? A numbers-backed comparison.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">Ride-Hailing</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/en/transport/didi/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">🚕 Tutorial</span>
            <p class="text-base font-bold text-gray-900 mt-1">How to Use Didi in China as a Foreigner</p>
            <p class="text-sm text-gray-600 mt-0.5">Step-by-step guide to using DiDi, China's Uber — with screenshots.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">Next Step</p>
            <h3 class="text-xl font-bold text-gray-900">Discover the cities</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">You know how to get around. Now pick where to go — Start with our city comparison guide.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/en/cities/city-select/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🗺️ City comparison
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/en/cities/shenzhen-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              📍 Shenzhen guide
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>