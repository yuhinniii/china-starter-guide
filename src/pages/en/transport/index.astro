---
import Layout from '@layouts/Layout.astro';
const title = 'Transport in China — Complete Travel Guide';
const description = 'Complete guide to getting around China: airport transfers, high-speed rail, metro, buses, and ride-hailing.';
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <header class="mb-16 text-center">
      <p class="text-sm text-gray-500 mb-3">🚄 Transport</p>
      <h1 class="text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
        Transport in China
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Everything you need to know about getting around China.
      </p>
    </header>

    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-16 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">Quick Overview</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        <strong>China's public transport is world-class.</strong> High-speed rail connects most major cities. Metro systems are clean and affordable in every big city. Didi (China's Uber) works well with an English interface. Start with the complete transport guide, then dive into specific topics.
      </p>
    </div>

    <div class="space-y-3 mb-16 not-prose">

      <!-- Getting to Your City -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-lg font-bold text-gray-900">Getting to Your City</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">1</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/transport/airport-to-city/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-blue-600">Arrival</span>
              <p class="text-sm font-semibold text-gray-900">From Airport to City in China</p>
              <p class="text-xs text-gray-500 mt-0.5">Metro, Didi, taxi, or bus — how to choose and what to expect at major airports.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Traveling Between Cities -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-lg font-bold text-gray-900">Traveling Between Cities</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">1</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/transport/high-speed-rail/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-green-600">Train</span>
              <p class="text-sm font-semibold text-gray-900">How to Book and Ride China High-Speed Rail</p>
              <p class="text-xs text-gray-500 mt-0.5">Complete guide to booking tickets, navigating stations, and choosing seat classes.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Getting Around Cities -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-lg font-bold text-gray-900">Getting Around Cities</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">2</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/transport/metro-bus/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-purple-600">Public</span>
              <p class="text-sm font-semibold text-gray-900">Metro & Bus Guide for Major Chinese Cities</p>
              <p class="text-xs text-gray-500 mt-0.5">Subway and bus systems in Beijing, Shanghai, Guangzhou, and Shenzhen.</p>
            </div>
          </a>
          <a href="/en/transport/didi/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-orange-600">Ride</span>
              <p class="text-sm font-semibold text-gray-900">How to Use Didi in China as a Foreigner</p>
              <p class="text-xs text-gray-500 mt-0.5">Set up and use China's Uber — works with an English interface.</p>
            </div>
          </a>
        </div>
      </div>

      <!-- Complete Guide -->
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
        <button onclick="toggleHub(this)" class="w-full flex items-center justify-between p-5 hover:bg-gray-50 transition no-underline text-left">
          <div class="flex items-center gap-3">
            <span class="text-lg font-bold text-gray-900">Complete Guide</span>
            <span class="text-xs font-medium text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">1</span>
          </div>
          <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hub-content hidden border-t border-gray-100">
          <a href="/en/transport/transport-guide/" class="flex items-center gap-3 px-5 py-4 hover:bg-gray-50 transition border-b border-gray-50 no-underline">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-500 flex-shrink-0"></span>
            <div>
              <span class="text-xs font-medium text-blue-600">Overview</span>
              <p class="text-sm font-semibold text-gray-900">How to Get Around China: Complete Transport Guide</p>
              <p class="text-xs text-gray-500 mt-0.5">Overview of all transport options in China — trains, metro, taxis, and ride-hailing.</p>
            </div>
          </a>
        </div>
      </div>

    </div>

    <script is:inline>
      function toggleHub(btn) {
        const content = btn.nextElementSibling;
        const icon = btn.querySelector('svg');
        content.classList.toggle('hidden');
        icon.classList.toggle('rotate-180');
      }
    </script>

    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/life/sim-card-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-1">SIM Card & eSIM for Tourists</p>
          <p class="text-sm text-gray-600">Stay connected while traveling</p>
        </a>
        <a href="/en/cities/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-1">City Guides</p>
          <p class="text-sm text-gray-600">Which Chinese city should you visit?</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
