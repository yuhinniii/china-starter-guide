---
import Layout from '@layouts/Layout.astro';
const title = 'Transport — Getting Around China';
const description = 'Complete transport guides for foreigners: metro, high-speed rail, taxis, ride-hailing apps, and getting from the airport to the city.';
---

<Layout title={title} description={description} lang="en">
  <div class="max-w-3xl mx-auto py-12">
    <header class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-4">
        Transport in China
      </h1>
      <p class="text-lg text-gray-500">
        From high-speed rail to ride-hailing apps — how to get around China as a foreigner. Updated June 2026.
      </p>
    </header>

    <div class="space-y-6">

      <!-- Main guide -->
      <a href="/en/transport/transport-guide/" class="block group">
        <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:border-brand-200 hover:shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded">GUIDE</span>
            <span class="text-xs text-gray-400">6 min read</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
            How to Get Around China: The Complete Transport Guide
          </h2>
          <p class="text-gray-600 leading-relaxed mb-3">
            Everything you need to know about transportation in China — high-speed rail, metro, taxis, ride-hailing, buses, and how to choose the right option for your trip.
          </p>
          <p class="text-sm text-brand-600 font-medium">Read more →</p>
        </div>
      </a>

      <!-- 2 -->
      <a href="/en/transport/airport-to-city/" class="block group">
        <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:border-brand-200 hover:shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded">GUIDE</span>
            <span class="text-xs text-gray-400">5 min read</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
            From Airport to City in China: What Usually Works Best
          </h2>
          <p class="text-gray-600 leading-relaxed mb-3">
            Metro, taxi, ride-hailing, or airport bus — how to choose and avoid bad decisions on arrival at Beijing, Shanghai, Guangzhou, and Shenzhen airports.
          </p>
          <p class="text-sm text-brand-600 font-medium">Read more →</p>
        </div>
      </a>

      <!-- 3 -->
      <a href="/en/transport/high-speed-rail/" class="block group">
        <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:border-brand-200 hover:shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded">GUIDE</span>
            <span class="text-xs text-gray-400">7 min read</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
            How to Book and Ride China High-Speed Rail
          </h2>
          <p class="text-gray-600 leading-relaxed mb-3">
            Step-by-step guide to booking high-speed train tickets, using the station, boarding, and what to expect onboard. Covers 12306, Trip.com, and ticket counters.
          </p>
          <p class="text-sm text-brand-600 font-medium">Read more →</p>
        </div>
      </a>

      <!-- 4 -->
      <a href="/en/transport/metro-bus/" class="block group">
        <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:border-brand-200 hover:shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded">REFERENCE</span>
            <span class="text-xs text-gray-400">5 min read</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
            Metro & Bus Guide for Major Chinese Cities
          </h2>
          <p class="text-gray-600 leading-relaxed mb-3">
            How to use the metro and bus systems in Beijing, Shanghai, Guangzhou, and Shenzhen. Tickets, cards, mobile payment, and station navigation tips.
          </p>
          <p class="text-sm text-brand-600 font-medium">Read more →</p>
        </div>
      </a>

      <!-- 5 -->
      <a href="/en/transport/didi/" class="block group">
        <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:border-brand-200 hover:shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded">TUTORIAL</span>
            <span class="text-xs text-gray-400">5 min read</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
            How to Use Didi in China as a Foreigner
          </h2>
          <p class="text-gray-600 leading-relaxed mb-3">
            Step-by-step guide to setting up and using Didi (China's Uber) without a Chinese phone number. Ride options, payment, and essential tips for first-time users.
          </p>
          <p class="text-sm text-brand-600 font-medium">Read more →</p>
        </div>
      </a>

    </div>

    <!-- Quick Answer Box -->
    <div class="mt-12 bg-brand-50 border border-brand-100 rounded-2xl p-6 not-prose">
      <h3 class="font-bold text-gray-900 mb-3">Quick Answer</h3>
      <p class="text-gray-700 mb-4">
        High-speed rail is the best way to travel between cities — book via Trip.com. Within cities, the metro is fast and cheap. For the last mile, use Didi (ride-hailing) or a taxi. Download Alipay or WeChat Pay to pay for all of them.
      </p>
      <a href="/en/transport/transport-guide/" class="inline-flex items-center gap-1 text-sm text-brand-600 font-medium hover:underline">
        Start with the transport guide →
      </a>
    </div>
  </div>
</Layout>