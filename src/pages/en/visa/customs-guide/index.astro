---
import Layout from '@layouts/Layout.astro';
const title = 'China Customs Regulations: What You Can and Cannot Bring into China';
const description = 'Complete guide to China customs for tourists — duty-free limits, prohibited items, what to declare, and which channel to pick.';
---

<Layout title={title} description={description} lang="en">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/en/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Visa & Entry
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🛂 Entry & Visa</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        China Customs Regulations: What You Can and Cannot Bring into China
      </h1>
      <p class="text-xl text-gray-600 mb-6">A practical guide to customs rules for tourists entering China.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 Last updated: June 2026</span>
        <span>⏱️ 5 min read</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 Quick Answer</h2>
      <p class="text-lg text-blue-800 leading-relaxed mb-4">
        Here's the short version for a typical tourist:
      </p>
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm bg-white rounded-xl overflow-hidden shadow-sm">
          <caption class="text-sm text-gray-500 italic mb-2">Items prohibited from entering China</caption>
          <thead>
            <tr class="bg-blue-600 text-white">
              <th class="px-4 py-2 text-left">✅ Fine to bring</th>
              <th class="px-4 py-2 text-left">⚠️ Check the details below</th>
              <th class="px-4 py-2 text-left">❌ Don't bring</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-4 py-2">Clothes, toiletries, phone, laptop, camera</td>
              <td class="px-4 py-2">Alcohol, cigarettes, gifts worth &gt; 2,000 RMB, cash &gt; $5,000</td>
              <td class="px-4 py-2">Meat, fruit, vegetables, drugs, weapons</td>
            </tr>
          </tbody>
        </table>
      </div>
      <ul class="list-disc pl-5 text-blue-800 text-sm space-y-1">
        <li><strong>Gifts/consumables left in China:</strong> keep under <strong>2,000 RMB</strong></li>
        <li><strong>Cigarettes:</strong> max <strong>400</strong> (200 if from HK/Macau)</li>
        <li><strong>Alcohol:</strong> up to <strong>1.5L</strong> (0.75L if from HK/Macau)</li>
        <li><strong>Foreign cash:</strong> declare if over <strong>$5,000 USD</strong></li>
        <li><strong>RMB cash:</strong> max <strong>20,000 yuan</strong> (no exceptions)</li>
      </ul>
    </div>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">

      <h2 class="text-3xl font-bold text-gray-900 mb-6">❌ Don't Bring These into China</h2>

      <div class="bg-red-50 border border-red-200 rounded-2xl p-6 mb-6 not-prose">
        <p class="font-bold text-gray-900 mb-2">Non-negotiable (will be confiscated):</p>
        <ul class="list-disc pl-5 text-gray-700 space-y-1">
          <li>🚫 Drugs, weapons, counterfeit goods</li>
          <li>🚫 Fresh fruit, vegetables, raw meat, eggs, dairy, live plants</li>
          <li>🚫 Endangered species products (ivory, tiger bone, rhino horn)</li>
        </ul>
      </div>

      <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-6 mb-8 not-prose">
        <p class="font-bold text-gray-900 mb-2">Watch out for these surprises:</p>
        <ul class="list-disc pl-5 text-gray-700 space-y-1">
          <li><strong>Meat snacks</strong> (beef jerky, sausages, bacon) — also banned, even if packaged</li>
          <li><strong>Fruit you forgot in your bag</strong> — the quarantine beagles will find it</li>
          <li><strong>Traditional Chinese medicine</strong> — some contain endangered species. Stick to packaged ones with clear labels</li>
          <li><strong>Power bank</strong> — must have a 3C mark, carry-on only, max 160Wh</li>
        </ul>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-6">💰 What Most Tourists Need to Know</h2>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Gifts & Things You Leave Behind</h3>
      <p class="text-gray-700 mb-4">
        The 2,000 RMB allowance applies to items you give away or consume in China (gifts, souvenirs you hand to a friend, chocolate you eat during your stay). Items you brought for yourself and take home don't count.
      </p>

      <div class="overflow-x-auto mb-8 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <caption class="text-sm text-gray-500 italic mb-2">Items restricted for entry to China</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-5 py-3 font-bold">You are...</th>
              <th class="px-5 py-3 font-bold">Duty-free allowance for stuff left in China</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 font-semibold">Foreign tourist</td>
              <td class="px-5 py-3"><strong>2,000 RMB</strong></td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3 font-semibold">Chinese resident returning</td>
              <td class="px-5 py-3">5,000 RMB</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Cigarettes & Alcohol</h3>
      <p class="text-gray-700 mb-4">
        The customs declaration form sets these duty-free limits. If you exceed them, check the box and use the Red Channel.
      </p>

      <div class="overflow-x-auto mb-4 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <caption class="text-sm text-gray-500 italic mb-2">Duty-free allowance for travelers</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-5 py-3 font-bold">Item</th>
              <th class="px-5 py-3 font-bold text-center">Inbound Travelers</th>
              <th class="px-5 py-3 font-bold text-center">HK/Macau Arrivals</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3">Cigarettes (including heated tobacco)</td>
              <td class="px-5 py-3 text-center"><strong>400</strong></td>
              <td class="px-5 py-3 text-center">200</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3">Cigars</td>
              <td class="px-5 py-3 text-center"><strong>20</strong></td>
              <td class="px-5 py-3 text-center">10</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3">Loose tobacco</td>
              <td class="px-5 py-3 text-center"><strong>500 g</strong></td>
              <td class="px-5 py-3 text-center">250 g</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3">E-cigarette devices</td>
              <td class="px-5 py-3 text-center"><strong>2</strong></td>
              <td class="px-5 py-3 text-center">1</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3">E-cigarette pods</td>
              <td class="px-5 py-3 text-center"><strong>6</strong> (≤ 12 ml total liquid)</td>
              <td class="px-5 py-3 text-center">3 (≤ 6 ml)</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3">Alcohol (≥12%)</td>
              <td class="px-5 py-3 text-center"><strong>1,500 ml</strong></td>
              <td class="px-5 py-3 text-center">750 ml</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm text-gray-500 mb-8">Note: For frequent travelers (crossing the border daily/weekly), much stricter limits apply — 40 cigarettes, 2 cigars, 40g tobacco, 1 e-cigarette device. Most tourists won't fall into this category.</p>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Cash</h3>
      <div class="overflow-x-auto mb-8 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <caption class="text-sm text-gray-500 italic mb-2">Prohibited export items from China</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-5 py-3 font-bold">Currency</th>
              <th class="px-5 py-3 font-bold text-center">Limit</th>
              <th class="px-5 py-3 font-bold">What to do</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3">RMB</td>
              <td class="px-5 py-3 text-center">Max <strong>20,000 yuan</strong></td>
              <td class="px-5 py-3">Over this = prohibited</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3">USD or other foreign currency</td>
              <td class="px-5 py-3 text-center">Declare if <strong>over $5,000</strong></td>
              <td class="px-5 py-3">Get a stamped form, keep it for departure</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Medication</h3>
      <p class="text-gray-700 mb-4">
        <strong>Prescription meds:</strong> 7-day supply is fine without paperwork. For longer stays, bring a doctor's note. Keep pills in original bottles — customs officers don't trust pill organizers.
      </p>
      <p class="text-gray-700 mb-8">
        <strong>Cold medicine warning:</strong> Medicines containing <strong>pseudoephedrine</strong> (Sudafed, NyQuil, many generic cold tablets) are restricted in China. One box is fine; bringing several boxes can be treated as carrying drug precursors. Don't overpack cold meds.
      </p>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Electronics You'll Take Home</h3>
      <p class="text-gray-700 mb-8">
        Your laptop, phone, camera, and tablet are fine in the Green Channel — they're personal items you brought and will take home. If you're carrying very expensive gear (pro camera rig, multiple laptops), you can voluntarily declare them as "temporary imports" at the Red Channel to avoid departure questions, but most tourists don't bother and have no issues.
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-6">🚦 Which Channel to Pick</h2>
      <p class="text-gray-700 mb-4">
        The customs declaration form has 7 boxes. <strong>If any apply to you → Red Channel. If none apply → Green Channel.</strong>
      </p>

      <div class="overflow-x-auto mb-8 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <caption class="text-sm text-gray-500 italic mb-2">Medication import regulations for China</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-5 py-3 font-bold text-center">#</th>
              <th class="px-5 py-3 font-bold">Check this box if you're carrying...</th>
              <th class="px-5 py-3 font-bold text-center">Go to</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 text-center font-bold">1</td>
              <td class="px-5 py-3">Animals, plants, fresh food, meat, microbes, biological products</td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3 text-center font-bold">2</td>
              <td class="px-5 py-3">(Chinese resident returning) Items over 5,000 RMB</td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 text-center font-bold">3</td>
              <td class="px-5 py-3">(Foreign tourist) Gifts or items <strong>worth over 2,000 RMB</strong> being <strong>left in China</strong></td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3 text-center font-bold">4</td>
              <td class="px-5 py-3">Over <strong>1,500 ml</strong> alcohol / <strong>400</strong> cigarettes / <strong>20</strong> cigars / <strong>500 g</strong> tobacco / over 2 e-cigarette devices or 6 pods</td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 text-center font-bold">5</td>
              <td class="px-5 py-3">Over <strong>20,000 RMB</strong> cash or <strong>$5,000 USD</strong> foreign cash</td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3 text-center font-bold">6</td>
              <td class="px-5 py-3">Separate shipment baggage, goods for business</td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 text-center font-bold">7</td>
              <td class="px-5 py-3">Anything else you're unsure about</td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-gray-700 font-semibold mb-8">No boxes checked? → 🟢 Green Channel. Just walk through.</p>

      <h2 class="text-3xl font-bold text-gray-900 mb-6">Real Tourist Scenarios</h2>

      <!-- Scenario 1 -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-4 not-prose">
        <p class="font-bold text-gray-900 mb-2">Scenario 1: You're bringing gifts for Chinese friends</p>
        <p class="text-gray-700 text-sm mb-3">You packed a bottle of single malt Scotch ($150), a box of artisanal chocolates ($40), and a branded leather wallet ($120) — all gifts to give to your friend in Shanghai. Total value: ~$310 USD (~2,200 RMB).</p>
        <div class="bg-yellow-50 rounded-xl p-4">
          <p class="text-sm text-yellow-900"><strong>Analysis:</strong> These items are staying in China (gifts) and exceed 2,000 RMB total. On the form, box 3 is checked.</p>
          <p class="text-sm text-red-700 font-semibold mt-1">→ 🔴 Red Channel. Declare them as "gifts left in China" and be prepared to pay duty on the excess 200 RMB.</p>
        </div>
      </div>

      <!-- Scenario 2 -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-4 not-prose">
        <p class="font-bold text-gray-900 mb-2">Scenario 2: You brought $5,500 USD cash</p>
        <p class="text-gray-700 text-sm mb-3">You exchanged cash before your trip and have $5,500 USD in your wallet to use for the trip.</p>
        <div class="bg-yellow-50 rounded-xl p-4">
          <p class="text-sm text-yellow-900"><strong>Analysis:</strong> Foreign cash over $5,000 USD triggers box 5.</p>
          <p class="text-sm text-red-700 font-semibold mt-1">→ 🔴 Red Channel. Declare the $5,500 USD, fill out a Cash Declaration Form, and get a stamped copy. Keep that form to take any leftover cash back out when you leave.</p>
        </div>
      </div>

      <!-- Scenario 3 -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-4 not-prose">
        <p class="font-bold text-gray-900 mb-2">Scenario 3: Just a normal travel luggage</p>
        <p class="text-gray-700 text-sm mb-3">You packed clothes, toiletries, a laptop, a phone, a Kindle, and a camera — all personal items you're taking back home with you. Total value in the thousands, but none are staying in China.</p>
        <div class="bg-green-50 rounded-xl p-4">
          <p class="text-sm text-green-800"><strong>Analysis:</strong> No box on the form applies. These are "temporary imports" — personal belongings you'll take home.</p>
          <p class="text-sm text-green-700 font-semibold mt-1">→ 🟢 Green Channel. This is the reality for 95% of tourists. Walk through.</p>
        </div>
      </div>

      <!-- Scenario 4 -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-4 not-prose">
        <p class="font-bold text-gray-900 mb-2">Scenario 4: You packed cold medicine for the trip</p>
        <p class="text-gray-700 text-sm mb-3">You have a box of cold and flu tablets (containing pseudoephedrine), some allergy pills, and a small tube of antibiotic cream — standard stuff for any traveler.</p>
        <div class="bg-yellow-50 rounded-xl p-4">
          <p class="text-sm text-yellow-900"><strong>Analysis:</strong> Regular OTC meds for personal use are fine. Pseudoephedrine is restricted in China, but a single box (7-day supply) is usually not an issue.</p>
          <p class="text-sm text-green-700 font-semibold mt-1">→ 🟢 Green Channel for a normal amount. But if you brought several boxes, it's a different story.</p>
        </div>
      </div>

      <!-- Scenario 5 -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-4 not-prose">
        <p class="font-bold text-gray-900 mb-2">Scenario 5: An apple and a chicken sandwich from the flight</p>
        <p class="text-gray-700 text-sm mb-3">You grabbed a fresh apple and a sandwich from the breakfast service and forgot they were in your backpack.</p>
        <div class="bg-red-50 rounded-xl p-4">
          <p class="text-sm text-red-800"><strong>Analysis:</strong> Fresh fruit = box 1. Meat products = box 1.</p>
          <p class="text-sm text-red-700 font-semibold mt-1">→ 🔴 Red Channel. Declare them — they'll be confiscated and destroyed. Always check your bag before picking a channel.</p>
        </div>
      </div>

      <div class="bg-red-50 border-l-4 border-red-400 p-5 rounded-r-xl mb-8 not-prose">
        <p class="text-red-900 text-sm"><strong>When in doubt, pick Red Channel.</strong> Voluntary declaration is a minor form. Hiding things gets them confiscated and you fined.</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-6">📝 How to Declare</h2>
      <p class="text-gray-700 mb-4">
        <strong>Pick up a paper form at customs</strong> — grab a "Declaration Form for Baggage" (中英文对照, available at the counter before the inspection channels) and fill it out on the spot. Tick any box that applies, then hand it to the officer at the Red Channel.
      </p>
      <p class="text-gray-700 mb-8">
        <strong>Penalties for hiding things:</strong> Confiscation + fines up to 100,000 RMB. Tax evasion over 10,000 RMB can lead to criminal charges.
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-6">💡 Quick Tips</h2>
      <ol class="list-decimal pl-6 space-y-2 text-gray-700 mb-8">
        <li><strong>Pack meds in original bottles</strong> — customs officers don't trust pill organizers</li>
        <li><strong>No fruit, meat, or dairy in your bag</strong> — quarantine beagles are very good at their job</li>
        <li><strong>No photos at customs</strong> — recording is prohibited in inspection areas</li>
        <li><strong>Check your bag before picking a channel</strong> — that apple from the flight counts</li>
        <li><strong>Keep receipts</strong> for branded goods and gifts</li>
      </ol>

    </div>

        <!-- Sources -->
    <div class="not-prose mt-12 pt-8 border-t border-gray-200">
      <h3 class="text-base font-bold text-gray-900 mb-4 flex items-center gap-2">
        <span class="text-lg">📚</span> Sources
      </h3>
      <ul class="space-y-2">
        <li>
          <a href="http://english.customs.gov.cn/Statics/88707c1e-aa4e-40ca-a968-bdbdbb565e4f.html" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
            <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
            <span class="border-b border-transparent group-hover:border-brand-700">China Customs Official — Passenger Baggage Declaration</span>
            <svg class="w-3 h-3 text-gray-300 ml-auto shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </li>
      </ul>
    </div>

                <div class="border-t border-gray-100 pt-6 mt-8">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-xl p-5 not-prose">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <h3 class="text-sm font-bold text-gray-900">📚 Next Reads</h3>
          <div class="flex flex-wrap gap-2">
            <a href="/en/visa/arrival-card/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              How to Submit Your Arrival Card Online
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

<script type="application/ld+json">{"@context": "https://schema.org", "@type": "HowTo", "name": "China Customs Regulations: What You Can and Cannot Bring into China", "step": [{"@type": "HowToStep", "name": "Pack meds in original bottles", "text": "— customs officers don't trust pill organizers"}, {"@type": "HowToStep", "name": "No fruit, meat, or dairy in your bag", "text": "— quarantine beagles are very good at their job"}, {"@type": "HowToStep", "name": "No photos at customs", "text": "— recording is prohibited in inspection areas"}, {"@type": "HowToStep", "name": "Check your bag before picking a channel", "text": "— that apple from the flight counts"}, {"@type": "HowToStep", "name": "Keep receipts", "text": "for branded goods and gifts"}]}</script>
