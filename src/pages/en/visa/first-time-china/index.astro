---
import Layout from '@layouts/Layout.astro';
const title = 'First Time in China: Step-by-Step Preparation Guide';
const description = 'A complete timeline for first-time travelers to China — visa, digital setup, packing, arrival, and your first 24 hours.';
---

<Layout title={title} description={description} lang="en">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/en/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Visa & Entry
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🛂 Entry & Visa</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        First Time in China: Step-by-Step Preparation Guide
      </h1>
      <p class="text-xl text-gray-600 mb-6">Everything you need to do before your first trip to China, organized by timeline.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 Last updated: June 2026</span>
        <span>⏱️ 8 min read</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 Quick Answer</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        <strong>Start preparing 2-3 months before your trip.</strong> <a href="/en/visa/visa-guide/" class="text-brand-600 underline">Check if you need a visa</a> first. Buy travel insurance. Set up VPN, Alipay, and WeChat Pay at least a week before departure. Pack a power adapter, cash (just in case), and prescription meds. Once you land, activate your SIM, connect to airport WiFi, and you're good to go.
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 In This Guide</h3>
      <ul class="space-y-3">
        <li><a href="#visa-documents" class="text-blue-600 hover:underline">🛂 2-3 Months Before: Visa & Documents</a></li>
        <li><a href="#insurance" class="text-blue-600 hover:underline">🏥 1 Month Before: Insurance & Accommodation</a></li>
        <li><a href="#digital-setup" class="text-blue-600 hover:underline">📱 2 Weeks Before: Digital Setup</a></li>
        <li><a href="#packing" class="text-blue-600 hover:underline">🧳 1 Week Before: Packing & Final Checks</a></li>
        <li><a href="#arrival" class="text-blue-600 hover:underline">🛬 Arrival Day: First Steps</a></li>
        <li><a href="#first-24" class="text-blue-600 hover:underline">⏱️ First 24 Hours in China</a></li>
      </ul>
    </nav>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">

      <h2 id="visa-documents" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🛂</span> 2-3 Months Before: Visa & Documents
      </h2>

      <p class="text-gray-700 mb-4"><strong>First, <a href="/en/visa/visa-guide/" class="text-brand-600 underline">check if you need a visa</a>:</strong></p>
      <ul class="list-disc pl-6 space-y-1 text-gray-700 mb-4">
        <li><strong>50 countries</strong> get <a href="/en/visa/visa-free/" class="text-brand-600 underline">30-day visa-free travel</a></li>
        <li><strong>~27 countries</strong> have <a href="/en/visa/mutual-agreement/" class="text-brand-600 underline">mutual visa-free agreements</a> with China</li>
        <li><strong>55 countries</strong> qualify for <a href="/en/visa/transit-240/" class="text-brand-600 underline">240-hour (10-day) transit</a> visa-free</li>
        <li>Everyone else needs an <a href="/en/visa/apply-l-visa/" class="text-brand-600 underline">L tourist visa</a></li>
      </ul>

      <div class="bg-white border border-gray-200 rounded-2xl p-5 mb-8 not-prose">
        <p class="font-semibold text-gray-900 mb-2">What you need:</p>
        <ul class="list-disc pl-5 text-gray-700 text-sm space-y-1">
          <li>✅ Passport valid for at least 6 months (with 2+ blank pages)</li>
          <li>✅ Visa (if required) — apply 4-6 weeks before trip</li>
          <li>✅ Hotel bookings and flight itinerary</li>
        </ul>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="insurance" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🏥</span> 1 Month Before: Insurance & Accommodation
      </h2>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-8">
        <li><strong>Buy travel insurance</strong> — medical coverage is strongly recommended (hospitals in China may require upfront payment)</li>
        <li><strong>Book your hotels</strong> — use Trip.com, Booking.com, or Agoda</li>
        <li><strong>Book flights</strong> — use Skyscanner, Trip.com, or airline direct</li>
      </ul>

      <hr class="border-gray-200 my-12" />

      <h2 id="digital-setup" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">📱</span> 2 Weeks Before: Digital Setup (Most Important Step)
      </h2>

      <!-- VPN -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">🔒 VPN</h3>
        <p class="text-sm text-gray-600 mb-2"><strong>Do this BEFORE you arrive</strong> — cannot be done easily in China.</p>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li>Install and test your <a href="/en/life/vpn-guide/" class="text-brand-600 underline">VPN</a> on ALL devices (phone, laptop, tablet)</li>
          <li>Recommended options: NordVPN, ExpressVPN, Surfshark, etc.</li>
          <li>Download the app and subscribe BEFORE you leave</li>
          <li>Test that Google, WhatsApp, Instagram, and YouTube work through the VPN</li>
        </ul>
      </div>

      <!-- Payment Apps -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">💳 Payment Apps</h3>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li><a href="/en/payment/setup-alipay/" class="text-brand-600 underline"><strong>Alipay</strong></a> (required): Download, register with your international number, link your Visa/Mastercard</li>
          <li><a href="/en/payment/setup-wechat/" class="text-brand-600 underline"><strong>WeChat Pay</strong></a> (recommended): Download WeChat, register, verify identity, bind card</li>
        </ul>
      </div>

      <!-- SIM Card -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">📶 SIM Card / eSIM</h3>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li>Book an <a href="/en/life/sim-card-guide/" class="text-brand-600 underline">eSIM</a> online (airalo, Holafly) — activates when you land</li>
          <li>Or plan to buy a physical SIM at the airport upon arrival</li>
        </ul>
      </div>

      <!-- Essential Apps -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">📲 Essential Apps</h3>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li><strong>Maps:</strong> Apple Maps works, Google Maps is unreliable — Amap (高德地图) is the local standard</li>
          <li><strong>Translation:</strong> Google Translate (download offline Chinese), or Pleco (the go-to Chinese dictionary)</li>
          <li><strong>Transport:</strong> <a href="/en/transport/didi/" class="text-brand-600 underline">Didi</a> (China's Uber) — download and set up your profile</li>
          <li><strong>Communication:</strong> WeChat (required for many things — restaurant menus, QR code ordering, paying)</li>
        </ul>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="packing" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🧳</span> 1 Week Before: Packing & Final Checks
      </h2>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-4">
        <li>Convert plug adapters: China uses <strong>Type A, I, and C</strong> sockets (220V, 50Hz)</li>
        <li>Make digital copies of your passport, visa, and insurance documents</li>
        <li>Check your packing essentials — see our <a href="/en/life/packing-guide/" class="text-brand-600 underline">What to Pack for China</a> guide for a complete checklist</li>
      </ul>

      <hr class="border-gray-200 my-12" />

      <h2 id="arrival" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🛬</span> Arrival Day: First Steps
      </h2>

      <ol class="list-decimal pl-6 space-y-2 text-gray-700 mb-8">
        <li><strong>Connect to airport WiFi</strong> — most major airports offer free WiFi via SMS verification</li>
        <li><strong>Activate your eSIM or buy a physical SIM</strong> at the airport telecom counter</li>
        <li><strong>Exchange a small amount of cash</strong> — 500–1,000 RMB for taxis and street food</li>
        <li><strong>Take the airport express, metro, or call a Didi</strong> (avoid unofficial taxis)</li>
        <li><strong>Check into your hotel</strong> — they'll scan your passport for registration</li>
      </ol>

      <hr class="border-gray-200 my-12" />

      <h2 id="first-24" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">⏱️</span> First 24 Hours in China
      </h2>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-8">
        <li><strong>Pay with your phone</strong> — scan QR codes everywhere, most merchants prefer it. See our <a href="/en/payment/payment-guide/" class="text-brand-600 underline">How to Pay in China</a> guide</li>
        <li><strong>Test your VPN</strong> — connect the moment you leave airport WiFi to a trusted network</li>
        <li><strong>Get to know your neighborhood</strong> — find the closest convenience store (7-11, FamilyMart, or Lawson)</li>
        <li><strong>Download Amap</strong> if you haven't — it'll save you on navigation</li>
        <li><strong>Eat</strong> — street food, local restaurants. Tipping is not expected in China</li>
      </ul>

    </div>

        <!-- Sources -->
    <div class="not-prose mt-12 pt-8 border-t border-gray-200">
      <h3 class="text-base font-bold text-gray-900 mb-4 flex items-center gap-2">
        <span class="text-lg">📚</span> Sources
      </h3>
      <ul class="space-y-2">
        <li>
          <a href="https://en.nia.gov.cn/n147418/n147463/c183390/content.html" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
            <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
            <span class="border-b border-transparent group-hover:border-brand-700">National Immigration Administration — List of Countries Covered by Unilateral Visa Exemption Policies</span>
            <svg class="w-3 h-3 text-gray-300 ml-auto shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </li>        <li>
          <a href="https://www.gov.uk/foreign-travel-advice/china/entry-requirements" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
            <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
            <span class="border-b border-transparent group-hover:border-brand-700">UK Government — China Travel Advice: Entry Requirements</span>
            <svg class="w-3 h-3 text-gray-300 ml-auto shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </li>
      </ul>
    </div>

                <div class="border-t border-gray-100 pt-6 mt-8">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-xl p-5 not-prose">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <h3 class="text-sm font-bold text-gray-900">📚 Next Reads</h3>
          <div class="flex flex-wrap gap-2">
            <a href="/en/visa/customs-guide/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              China Customs Regulations
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/en/visa/arrival-card/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              How to Submit Your Arrival Card Online
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/en/payment/payment-guide/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              How to Pay in China
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/en/transport/airport-to-city/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              From Airport to City
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>