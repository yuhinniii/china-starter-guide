---
import Layout from '@layouts/Layout.astro';
const title = "Visa Before You Arrive — Visa, Documents & Essential Setup";
const description = "Everything you need to prepare before flying to China: visa options, documents, and essential first steps.";
---

<Layout title={title} description={description} lang="en">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <!-- Header -->
    <header class="mb-16 text-center">
      <p class="text-sm text-gray-500 mb-3">📋 Visa</p>
      <h1 class="text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
        Visa Before You Arrive
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Essential steps to complete before landing in China — visa, documents, and first-72-hours planning.
      </p>
    </header>

    <!-- Quick Overview -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-16 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 Quick Overview</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        Most travelers can now enter China <strong>without a visa</strong> (30 days for 50 countries), use the <strong>240-hour transit policy</strong>, or apply for a standard tourist visa. Start with the visa guide to find which option fits your trip.
      </p>
    </div>

    <!-- Article Directory -->
    <div class="space-y-6 mb-16 not-prose">
      <!-- Article 1 -->
      <a href="/en/visa/visa/visa-guide/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-blue-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl">🛂</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-blue-600">Guide</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition">China Visa Types Complete Guide 2026</h2>
          <p class="text-gray-600 mt-1">Compare visa-free entry, 240-hour transit, and tourist visa options to find what fits your trip.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 6 min read</p>
        </div>
      </a>

      <!-- Article 2 -->
      <a href="/en/visa/visa/visa-free/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-green-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-2xl">🌍</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-green-600">Reference</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-green-600 transition">China Visa-Free Countries List (2026)</h2>
          <p class="text-gray-600 mt-1">Check if your passport qualifies for visa-free entry to China. Includes 50+ countries, stay limits, and entry conditions.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 5 min read</p>
        </div>
      </a>

      <!-- Article 3 -->
      <a href="/en/visa/visa/transit-240/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-purple-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-2xl">🔄</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-purple-600">Guide</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-purple-600 transition">China 240-Hour Visa-Free Transit Explained</h2>
          <p class="text-gray-600 mt-1">Stay in China up to 10 days without a visa while transiting to a third country. Eligibility, ports, and allowed activities.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 7 min read</p>
        </div>
      </a>

      <!-- Article 4 -->
      <a href="/en/visa/visa/apply-l-visa/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-orange-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center text-2xl">📝</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-orange-600">Guide</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-orange-600 transition">How to Apply for China Tourist Visa (L-Type) 2026</h2>
          <p class="text-gray-600 mt-1">Complete walkthrough for L-type tourist visa: COVA form, required documents, appointment booking, and processing times.</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 8 min read</p>
        </div>
      </a>
    </div>

    <!-- Related Links -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/payment/payment-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">💳 How to Pay in China</p>
          <p class="text-sm text-gray-600">Alipay, WeChat Pay, and everything about money</p>
        </a>
        <a href="/en/transport/transport-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🚄 How to Get Around China</p>
          <p class="text-sm text-gray-600">Transport options for travelers</p>
        </a>
      </div>
    </div>
  </section>
</Layout>