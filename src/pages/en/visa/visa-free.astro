---
import Layout from '@layouts/Layout.astro';
const title = 'China Visa-Free Countries List (2026) — China Starter Hub';
const description = 'Official list of countries eligible for visa-free entry to China — unilateral (50 countries) and mutual agreements (29 countries).';
---

<Layout title={title} description={description} lang="en">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/en/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Prepare
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">📋 Entry & Visa</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        China Visa-Free Countries List (2026)
      </h1>
      <p class="text-xl text-gray-600 mb-6">Check if your country qualifies for visa-free entry to China.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 Last updated: June 2026</span>
        <span>⏱️ 5 min read</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 Quick Answer</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        <strong>There are two ways to enter China visa-free:</strong> China offers unilateral visa-free entry to citizens of <strong>50 countries</strong> (up to 30 days), and has mutual visa-free agreements with <strong>29 countries</strong>. If your country isn't on either list, check the 240-hour transit policy or apply for an L visa.
      </p>
    </div>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        Below are the complete lists based on the latest official data from the Chinese government (2025). Source: <a href="http://big5.www.gov.cn/gate/big5/www.gov.cn/yaowen/liebiao/202508/content_7035244.htm" class="text-brand-600 underline" target="_blank" rel="noopener">中国政府网</a>.
      </p>

      <hr class="border-gray-200 my-12" />

      <!-- Section 1: Unilateral -->
      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🟢</span> Unilateral Visa-Free (50 Countries)
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        Citizens of these countries can enter China <strong>without a visa</strong> for up to <strong>30 days</strong>. No advance application needed.
      </p>

      <div class="bg-green-50 border border-green-200 rounded-2xl p-6 mb-8 not-prose">
        <p class="text-gray-700 mb-4 font-medium">Valid for: Tourism, business, family visits, transit, cultural exchanges. Max 30 days.</p>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Europe (35)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>France</span><span>Germany</span><span>Italy</span>
          <span>Netherlands</span><span>Spain</span><span>Switzerland</span>
          <span>Ireland</span><span>Hungary</span><span>Austria</span>
          <span>Belgium</span><span>Luxembourg</span><span>Poland</span>
          <span>Portugal</span><span>Greece</span><span>Cyprus</span>
          <span>Slovenia</span><span>Slovakia</span><span>Norway</span>
          <span>Finland</span><span>Denmark</span><span>Iceland</span>
          <span>Andorra</span><span>Monaco</span><span>Liechtenstein</span>
          <span>Bulgaria</span><span>Romania</span><span>Croatia</span>
          <span>Montenegro</span><span>North Macedonia</span><span>Malta</span>
          <span>Estonia</span><span>Latvia</span><span>Russia</span>
          <span>Sweden</span><span>United Kingdom</span>
        </div>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Asia (7)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>Brunei</span><span>South Korea</span><span>Japan</span>
          <span>Saudi Arabia</span><span>Oman</span><span>Kuwait</span>
          <span>Bahrain</span>
        </div>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Americas (6)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>Brazil</span><span>Argentina</span><span>Chile</span>
          <span>Peru</span><span>Uruguay</span><span>Canada</span>
        </div>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Oceania (2)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-8 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>Australia</span><span>New Zealand</span>
        </div>
      </div>

    </div>

    <!-- Not sure which one applies to you? -->
    <div class="bg-gray-50 rounded-2xl p-6 not-prose mt-8 mb-12">
      <h3 class="text-lg font-bold text-gray-900 mb-4">🤔 Not sure which policy applies to your country?</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/en/visa/transit-240/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">✈️ 240-Hour Visa-Free Transit</p>
          <p class="text-sm text-gray-500">Up to 10 days in designated regions — covers 55 countries including the US.</p>
        </a>
        <a href="/en/visa/mutual-agreement/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">🤝 Mutual Visa-Free Agreements</p>
          <p class="text-sm text-gray-500">29 countries with bilateral visa-exemption deals — stay limits vary.</p>
        </a>
        <a href="/en/visa/apply-l-visa/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">📝 Apply for an L Tourist Visa</p>
          <p class="text-sm text-gray-500">If your country isn't on any visa-free list, apply for a standard tourist visa.</p>
        </a>
        <a href="/en/cities/hainan-visa-free/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">🏝️ Hainan 30-Day Visa-Free</p>
          <p class="text-sm text-gray-500">59 countries qualify — includes US, Mexico, Philippines, and others not on the mainland list.</p>
        </a>
      </div>
    </div>

        <!-- Sources -->
    <div class="not-prose mt-12 pt-8 border-t border-gray-200">
      <h3 class="text-base font-bold text-gray-900 mb-4 flex items-center gap-2">
        <span class="text-lg">📚</span> Sources
      </h3>
      <ul class="space-y-2">
        <li>
          <a href="https://en.nia.gov.cn/n147418/n147463/c183390/content.html" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
            <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
            <span class="border-b border-transparent group-hover:border-brand-700">National Immigration Administration — List of Countries Covered by Unilateral Visa Exemption</span>
            <svg class="w-3 h-3 text-gray-300 ml-auto shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </li>        <li>
          <a href="https://www.gov.cn/yaowen/liebiao/202508/content_7035244.htm" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
            <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
            <span class="border-b border-transparent group-hover:border-brand-700">gov.cn — Which countries can visit China visa-free? A comprehensive list!</span>
            <svg class="w-3 h-3 text-gray-300 ml-auto shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </li>        <li>
          <a href="https://cs.mfa.gov.cn/wgrlh/lhqz/lhqzjjs/202510/t20251023_11739051.shtml" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
            <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
            <span class="border-b border-transparent group-hover:border-brand-700">Ministry of Foreign Affairs — Mutual Visa Exemption Agreements</span>
            <svg class="w-3 h-3 text-gray-300 ml-auto shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </li>
      </ul>
    </div>

                <div class="border-t border-gray-100 pt-6 mt-8">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-xl p-5 not-prose">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <h3 class="text-sm font-bold text-gray-900">📚 Next Reads</h3>
          <div class="flex flex-wrap gap-2">
            <a href="/en/visa/visa-guide/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              China Visa Types Complete Guide
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/en/visa/transit-240/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              240-Hour Visa-Free Transit Explained
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>