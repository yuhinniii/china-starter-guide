---
import Layout from '@layouts/Layout.astro';
const title = 'Guías de Ciudades de China — Destinos de Viaje';
const description = 'Encuentra la ciudad ideal para tu viaje a China.';
---

<Layout title={title} description={description} lang="es">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Guías de Ciudades de China</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Encuentra la ciudad ideal para tu viaje a China.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">7</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">Guías de Ciudades</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Planificador de Itinerario</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">Planificando tu Viaje</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">1 artículo</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/cities/city-select/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🧭 Planificación</span>
            <p class="text-base font-bold text-gray-900 mt-1">¿Cuántos Días Necesitas en China?</p>
            <p class="text-sm text-gray-600 mt-0.5">Planifica el itinerario perfecto — desde 3 días intensos hasta una aventura de 3 semanas.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Historia y Cultura</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">2 artículos</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/cities/beijing-guide/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🏛️ Pekín</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guía de Viaje de Pekín: Qué Ver, Comer y Saber</p>
            <p class="text-sm text-gray-600 mt-0.5">Ciudad Prohibida, Gran Muralla, hutongs, pato laqueado y consejos esenciales.</p>
          </a>
          <a href="/es/cities/xi-an-guide/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🐎 Xi'an</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guía de Viaje de Xi'an: Qué Ver, Comer y Saber</p>
            <p class="text-sm text-gray-600 mt-0.5">Guerreros de Terracota, la muralla mejor conservada de China y un barrio musulmán de la Ruta de la Seda.</p>
          </a>

        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Moderno y Urbano</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 artículos</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/cities/shanghai-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🌆 Shanghái</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guía de Viaje de Shanghái: La Ciudad Más Amigable para Extranjeros</p>
            <p class="text-sm text-gray-600 mt-0.5">El Bund, Shanghai Tower, Wukang Road-Anfu Road y gastronomía de clase mundial.</p>
          </a>
          <a href="/es/cities/shenzhen-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🏙️ Shenzhen</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guía de Viaje de Shenzhen: Centro Tecnológico Junto a Hong Kong</p>
            <p class="text-sm text-gray-600 mt-0.5">El Silicon Valley de China, ciclismo costero y un tren de 15 minutos a Hong Kong.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">Naturaleza y Paisajes</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 artículo</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/cities/hainan-visa-free/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🏝️ Hainan</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guía de Viaje de Hainan — 30 Días Sin Visa</p>
            <p class="text-sm text-gray-600 mt-0.5">Playas tropicales, selva tropical y entrada sin visa para 59 países.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-orange-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-orange-800">Comida y Estilo de Vida</h2>
          <span class="text-xs font-medium text-orange-800 opacity-60">2 artículos</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/cities/guangzhou-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🥟 Cantón</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guía de Viaje de Cantón: La Capital Gastronómica de China</p>
            <p class="text-sm text-gray-600 mt-0.5">Dim sum, Canton Tower, Isla Shamian y puerta de entrada al sur de China.</p>
          </a>
          <a href="/es/cities/chengdu-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🐼 Chengdú</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guía de Viaje de Chengdú: Pandas, Comida Picante y Vida Tranquila</p>
            <p class="text-sm text-gray-600 mt-0.5">Pandas gigantes, hotpot sichuanés, casas de té y puerta de entrada a Jiuzhaigou.</p>
          </a>
        </div>
      </div>
    </div>

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">Siguiente paso</p>
            <h3 class="text-xl font-bold text-gray-900">Planifica tu viaje</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">¿Elegiste ciudad? Resuelve visa y transporte antes de ir.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/es/visa/visa-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🛂 Guía de visa
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/es/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚄 Guía de transporte
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>