---
import Layout from '@layouts/Layout.astro';
const title = 'Contacto — China Starter Hub';
const description = 'Ponte en contacto con nosotros para preguntas, comentarios o colaboración.';
---

<Layout title={title} description={description} lang="es">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">CONTACTO</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">Contáctanos</h1>
      <p class="text-gray-500  ">¿Tienes preguntas o comentarios? Nos encantaría saber de ti.</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4">
        <p class="text-sm text-gray-500  "">El correo electrónico estará disponible pronto. Por ahora, sigue nuestras novedades en redes sociales.</p>
      </div>
    </div>
  </article>
</Layout>
