---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Hub — Tu Guía Definitiva para China';
const description = 'Todo lo que necesitas saber antes de venir a China: pagos, transporte, apps, ciudades y consejos de viaje.';
---

<Layout title={title} description={description} lang="es">
  <!-- Trigger rebuild: 2026-06-12 17:30 -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900  ">
      Orientación Clara y Actualizada para<br/><span class="text-brand-600">Extranjeros que Visitan China por Primera Vez</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-500  ">
      Empieza con lo esencial, luego sigue las guías que se ajusten a tu viaje.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/es/visa/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">Empezar</a>
      <a href="/es/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">Acerca de este sitio</a>
    </div>
  </section>

  <!-- Section: Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/es/visa/', title: 'Visa', desc: 'Tipos de visa, países exentos, política de tránsito.' },
        { href: '/es/payment/', title: 'Pago', desc: 'Monederos digitales, tarjetas bancarias, efectivo de respaldo.' },
        { href: '/es/transport/', title: 'Transporte', desc: 'Tren de alta velocidad, metro, ride-hailing y cómo llegar del aeropuerto a la ciudad.' },
        { href: '/es/life/', title: 'Vida en China', desc: 'Apps, atención médica, consejos de seguridad, vida diaria.' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  :text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Your Trip: Step by Step -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Tu Viaje, Paso a Paso</h2>
    <p class="text-gray-500 mb-10">Sigue tu etapa — cada una enlaza a las guías que realmente necesitarás.</p>

    <div class="space-y-8">
      <!-- Stage 1 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-green-100 flex items-center justify-center text-sm font-bold text-green-700">1</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Antes de Volar</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/es/visa/visa-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Preparar</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">¿Qué visa necesitas?</p>
          </a>
          <a href="/es/payment/payment-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Pago</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Cómo pagar en China</p>
          </a>
          <a href="/es/life/survival-kit/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Vida</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Tu lista de verificación previa</p>
          </a>
        </div>
      </div>

      <!-- Stage 2 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-sm font-bold text-blue-700">2</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Recién Aterrizado</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/es/transport/airport-to-city/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Transporte</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Del aeropuerto a la ciudad</p>
          </a>
          <a href="/es/life/sim-card-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Vida</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Tarjeta SIM y configuración de internet</p>
          </a>
          <a href="/es/life/vpn-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Vida</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Configurar tu VPN</p>
          </a>
        </div>
      </div>

      <!-- Stage 3 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-purple-100 flex items-center justify-center text-sm font-bold text-purple-700">3</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Durante Tu Viaje</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/es/transport/transport-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Transporte</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Moverse por China</p>
          </a>
          <a href="/es/life/essential-apps/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Vida</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">10 apps esenciales</p>
          </a>
          <a href="/es/life/chinese-phrases/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Vida</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Frases básicas en chino</p>
          </a>
        </div>
      </div>

      <!-- Stage 4 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-red-100 flex items-center justify-center text-sm font-bold text-red-700">4</div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">¿Necesitas Ayuda?</h3>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <a href="/es/life/seeing-a-doctor/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Vida</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Ir al médico</p>
          </a>
          <a href="/es/life/common-scams/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Vida</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Evitar estafas comunes</p>
          </a>
          <a href="/es/life/emergency-numbers/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Vida</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Contactos de emergencia</p>
          </a>
          <a href="/es/payment/payment-fails/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Pago</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Cuando falla el pago</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visa Checker Tool -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="border-t border-gray-100 pt-12">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">Verificador de Visa</h2>
        <p class="text-gray-500 text-center mb-8">¿No sabes si necesitas visa? Elige tu nacionalidad y te lo decimos.</p>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <label for="visa-country" class="block text-sm font-medium text-gray-700 mb-2">Tu nacionalidad</label>
          <select id="visa-country" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 text-base appearance-none cursor-pointer">
            <option value="">— Selecciona tu país —</option>
            <option value="AL">Albania</option>
            <option value="AD">Andorra</option>
            <option value="AG">Antigua y Barbuda</option>
            <option value="AR">Argentina</option>
            <option value="AM">Armenia</option>
            <option value="AU">Australia</option>
            <option value="AT">Austria</option>
            <option value="AZ">Azerbaiyán</option>
            <option value="BS">Bahamas</option>
            <option value="BH">Baréin</option>
            <option value="BD">Bangladés</option>
            <option value="BB">Barbados</option>
            <option value="BY">Bielorrusia</option>
            <option value="BE">Bélgica</option>
            <option value="BA">Bosnia y Herzegovina</option>
            <option value="BR">Brasil</option>
            <option value="BN">Brunéi</option>
            <option value="BG">Bulgaria</option>
            <option value="CA">Canadá</option>
            <option value="CL">Chile</option>
            <option value="HR">Croacia</option>
            <option value="CY">Chipre</option>
            <option value="CZ">República Checa</option>
            <option value="DK">Dinamarca</option>
            <option value="DM">Dominica</option>
            <option value="EC">Ecuador</option>
            <option value="EG">Egipto</option>
            <option value="EE">Estonia</option>
            <option value="FJ">Fiyi</option>
            <option value="FI">Finlandia</option>
            <option value="FR">Francia</option>
            <option value="GE">Georgia</option>
            <option value="DE">Alemania</option>
            <option value="GR">Grecia</option>
            <option value="GD">Granada</option>
            <option value="HU">Hungría</option>
            <option value="IS">Islandia</option>
            <option value="IN">India</option>
            <option value="ID">Indonesia</option>
            <option value="IE">Irlanda</option>
            <option value="IT">Italia</option>
            <option value="JP">Japón</option>
            <option value="KZ">Kazajistán</option>
            <option value="KE">Kenia</option>
            <option value="KW">Kuwait</option>
            <option value="LV">Letonia</option>
            <option value="LI">Liechtenstein</option>
            <option value="LT">Lituania</option>
            <option value="LU">Luxemburgo</option>
            <option value="MY">Malasia</option>
            <option value="MV">Maldivas</option>
            <option value="MT">Malta</option>
            <option value="MU">Mauricio</option>
            <option value="MX">México</option>
            <option value="MC">Mónaco</option>
            <option value="ME">Montenegro</option>
            <option value="NL">Países Bajos</option>
            <option value="NZ">Nueva Zelanda</option>
            <option value="NG">Nigeria</option>
            <option value="MK">Macedonia del Norte</option>
            <option value="NO">Noruega</option>
            <option value="OM">Omán</option>
            <option value="PK">Pakistán</option>
            <option value="PE">Perú</option>
            <option value="PH">Filipinas</option>
            <option value="PL">Polonia</option>
            <option value="PT">Portugal</option>
            <option value="QA">Catar</option>
            <option value="RO">Rumania</option>
            <option value="RU">Rusia</option>
            <option value="WS">Samoa</option>
            <option value="SM">San Marino</option>
            <option value="SA">Arabia Saudita</option>
            <option value="RS">Serbia</option>
            <option value="SC">Seychelles</option>
            <option value="SG">Singapur</option>
            <option value="SK">Eslovaquia</option>
            <option value="SI">Eslovenia</option>
            <option value="SB">Islas Salomón</option>
            <option value="ZA">Sudáfrica</option>
            <option value="KR">Corea del Sur</option>
            <option value="ES">España</option>
            <option value="SR">Surinam</option>
            <option value="SE">Suecia</option>
            <option value="CH">Suiza</option>
            <option value="TH">Tailandia</option>
            <option value="TO">Tonga</option>
            <option value="TR">Turquía</option>
            <option value="UA">Ucrania</option>
            <option value="AE">Emiratos Árabes Unidos</option>
            <option value="GB">Reino Unido</option>
            <option value="US">Estados Unidos</option>
            <option value="UY">Uruguay</option>
            <option value="UZ">Uzbekistán</option>
            <option value="VN">Vietnam</option>
            <option value="OTHER">Otro país</option>
          </select>

          <div id="visa-result" class="mt-6"></div>
        </div>

        <p class="text-xs text-gray-400 text-center mt-4">Las políticas de visa cambian. Verifica siempre con tu embajada china local antes de reservar.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const countrySelect = document.getElementById('visa-country');
    const resultDiv = document.getElementById('visa-result');

    // Source: China gov.cn official list (2025)
    // Category 1: Unilateral visa-free (30 days) - 50 countries
    const visaFree = ['BN','FR','DE','IT','ES','NL','CH','IE','HU','AT','BE','LU','NZ','AU','PL','PT','GR','CY','SI','SK','NO','FI','DK','IS','AD','MC','LI','KR','BG','RO','HR','ME','MK','MT','EE','LV','JP','BR','AR','CL','PE','UY','SA','OM','KW','BH','CA','RU','GB','SE'];

    // Category 2: Mutual visa agreement (ordinary passport) - 29 countries
    const mutualFree = ['AL','AE','AG','BB','BS','BY','BA','DM','EC','FJ','GD','GE','KZ','QA','MV','MU','WS','RS','SC','SM','SR','SB','TH','TO','UZ','SG','AM','AZ','MY'];

    // Category 3: 240-hour transit - 55 countries
    const transit240 = ['AL','AT','BE','BG','BA','BR','CA','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LT','LU','MT','MC','ME','NL','MK','NO','PL','PT','RO','RU','RS','SK','SI','KR','ES','SE','CH','UA','GB','US','AU','NZ','JP','SG','BN','AE','QA','MX','AR','CL','ID','BY'];

    // Determine best visa status for each country
    function getVisaStatus(code) {
      if (visaFree.includes(code)) return 'visa-free-30';
      if (mutualFree.includes(code)) return 'mutual-free';
      if (transit240.includes(code)) return 'transit';
      return 'need-visa';
    }

    const countryNames = {
      'AL':'Albania','AD':'Andorra','AG':'Antigua y Barbuda','AR':'Argentina','AM':'Armenia',
      'AU':'Australia','AT':'Austria','AZ':'Azerbaiyán','BS':'Bahamas','BH':'Baréin','BB':'Barbados',
      'BY':'Bielorrusia','BE':'Bélgica','BA':'Bosnia y Herzegovina','BR':'Brasil','BN':'Brunéi','BG':'Bulgaria',
      'CA':'Canadá','CL':'Chile','HR':'Croacia','CY':'Chipre','CZ':'República Checa','DK':'Dinamarca',
      'DM':'Dominica','EC':'Ecuador','EG':'Egipto','EE':'Estonia','FJ':'Fiyi','FI':'Finlandia','FR':'Francia',
      'GE':'Georgia','DE':'Alemania','GR':'Grecia','GD':'Granada','HU':'Hungría',      'IS':'Islandia','IE':'Irlanda','IN':'India','ID':'Indonesia','IT':'Italia',
      'JP':'Japón','KZ':'Kazajistán','KE':'Kenia','KW':'Kuwait','LV':'Letonia','LI':'Liechtenstein',
      'LT':'Lituania','LU':'Luxemburgo','MY':'Malasia','MV':'Maldivas','MT':'Malta','MU':'Mauricio',
      'MX':'México',
      'MC':'Mónaco','ME':'Montenegro',      'NL':'Países Bajos','NZ':'Nueva Zelanda','NG':'Nigeria','MK':'Macedonia del Norte',
      'NO':'Noruega','OM':'Omán','PK':'Pakistán','PE':'Perú','PH':'Filipinas','PL':'Polonia','PT':'Portugal','QA':'Catar','RO':'Rumania',
      'RU':'Rusia','WS':'Samoa','SM':'San Marino','SA':'Arabia Saudita','RS':'Serbia','SC':'Seychelles',
      'SG':'Singapur','SK':'Eslovaquia','SI':'Eslovenia','SB':'Islas Salomón','ZA':'Sudáfrica','KR':'Corea del Sur',
      'ES':'España','SR':'Surinam','SE':'Suecia','CH':'Suiza','TH':'Tailandia','TO':'Tonga','TR':'Turquía',
      'UA':'Ucrania',
      'AE':'Emiratos Árabes Unidos','GB':'el Reino Unido','US':'los Estados Unidos','UY':'Uruguay','UZ':'Uzbekistán','VN':'Vietnam'
    };

    countrySelect.addEventListener('change', function() {
      const val = this.value;
      if (!val) {
        resultDiv.innerHTML = '';
        return;
      }

      const name = countryNames[val] || 'tu país';
      const status = getVisaStatus(val);

      if (status === 'visa-free-30') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">¡Buenas noticias! Los ciudadanos de ' + name + ' pueden entrar a China <span class="underline">sin visa</span> por hasta 30 días.</p><p class="text-green-700 text-sm mb-3">No necesitas visa para turismo, negocios o tránsito de menos de 30 días.</p><a href="/es/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">Ver la lista completa de países sin visa →</a></div>';
      } else if (status === 'mutual-free') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">Los ciudadanos de ' + name + ' pueden entrar a China <span class="underline">sin visa</span> mediante un acuerdo mutuo.</p><p class="text-green-700 text-sm mb-3">Verifica tu tipo de pasaporte y la duración permitida antes de viajar.</p><a href="/es/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">Ver la lista de países sin visa →</a></div>';
      } else if (status === 'transit') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-blue-50 border border-blue-200"><p class="text-blue-800 font-semibold mb-1">Puedes usar la política de <span class="underline">tránsito de 240 horas</span>.</p><p class="text-blue-700 text-sm mb-3">Los ciudadanos de ' + name + ' pueden transitar por China hasta 10 días sin visa. Para estancias más largas, necesitarás una visa L.</p><div class="flex flex-wrap gap-3"><a href="/es/visa/transit-240/" class="text-sm font-medium text-blue-700 underline hover:no-underline">Cómo funciona el tránsito →</a><a href="/es/visa/apply-l-visa/" class="text-sm font-medium text-blue-700 underline hover:no-underline">Solicitar una visa L →</a></div></div>';
      } else {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-orange-50 border border-orange-200"><p class="text-orange-800 font-semibold mb-1">Necesitarás una visa.</p><p class="text-orange-700 text-sm mb-3">Los ciudadanos de ' + name + ' deben solicitar una visa de turista (tipo L) antes de viajar a China.</p><a href="/es/visa/apply-l-visa/" class="inline-block text-sm font-medium text-orange-700 underline hover:no-underline">Cómo solicitar una visa L →</a></div>';
      }
    });
  </script>
    <p class="text-xs text-gray-400 text-center mt-8">Última actualización: julio de 2026</p>
</Layout>
