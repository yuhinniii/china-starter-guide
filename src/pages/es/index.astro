---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Hub — Tu Guía Definitiva para China';
const description = 'Todo lo que necesitas saber antes de venir a China: pagos, transporte, apps, ciudades y consejos de viaje.';
---

<Layout title={title} description={description} lang="es">
  <!-- Trigger rebuild: 2026-06-12 17:30 -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900">
      Viaja por China con confianza —<br/><span class="text-brand-600">guías paso a paso desde el visado hasta los pagos y cómo moverte</span>
    </h1>
    <div class="flex flex-wrap justify-center gap-4 mt-10">
      <a href="/es/visa/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">Empezar</a>
      <a href="/es/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">Acerca de este sitio</a>
    </div>
  </section>  <!-- Section: Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/es/visa/', title: 'Visa', desc: 'Tipos de visa, países exentos, política de tránsito.' },
        { href: '/es/payment/', title: 'Pago', desc: 'Monederos digitales, tarjetas bancarias, efectivo de respaldo.' },
        { href: '/es/transport/', title: 'Transporte', desc: 'Tren de alta velocidad, metro, ride-hailing y cómo llegar del aeropuerto a la ciudad.' },
        { href: '/es/life/', title: 'Vida en China', desc: 'Apps, atención médica, consejos de seguridad, vida diaria.' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  group-hover:text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

<!-- Interactive Pre-Departure Checklist -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Tu Lista de Viaje a China</h2>
    <p class="text-gray-500 mb-4">Desde un mes antes hasta el primer día — marca cada tarea al completarla.</p>

    <!-- Time Filter -->
    <div id="checklist-filter" class="flex flex-wrap gap-2 mb-5">
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-brand-50 text-brand-700 text-sm font-medium cursor-pointer transition hover:border-brand-300 active" data-show="all">Todas las etapas</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="1">1 mes antes</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="2">2 semanas antes</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="3">1 semana antes</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="4,5">Llegada</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="6">Día 1</button>
    </div>

    <!-- Overall Progress -->
    <div id="checklist-progress" class="bg-gray-50 rounded-2xl p-5 mb-10">
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-sm font-semibold text-gray-700">Progreso general</span>
        <span id="progress-text" data-suffix="completados" class="text-base font-bold text-brand-600">0 de 23 completado</span>
      </div>
      <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width:0%"></div>
      </div>
    </div>

    <div class="space-y-8">

      <!-- Stage 1: T-30 Días · Un Mes Antes de Volar -->
      <div class="relative pl-12 stage-group" data-stage="1">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-xs font-bold text-green-700">1</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-green-700">T-30 Días</span> · Un mes antes de volar
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="1">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="1">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-passport">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">01</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Verificar vigencia del pasaporte</p>
              <p class="text-sm text-gray-500 mt-0.5">Muchos países exigen 6 meses de validez del pasaporte tras el viaje para el visado chino. Verifica esto antes de salir.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-visa">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">02</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Confirmar tipo de visado o exención</p>
              <p class="text-sm text-gray-500 mt-0.5">¿Necesitas visado? ¿Eres elegible para tránsito 240h? El comprobador arriba te responde en 30 segundos.</p>
            </div>
            <a href="/es/visa/visa-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ Guía →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="travel-insurance">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">03</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Comprar seguro de viaje con cobertura médica</p>
              <p class="text-sm text-gray-500 mt-0.5">Hospitales chinos requieren pago anticipado. Se recomienda seguro con cobertura médica desde $100,000 y evacuación de emergencia.</p>
            </div>
            <a href="/es/life/travel-insurance/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ Guía →</a>
          </div>
        </div>
      </div>

      <!-- Stage 2: T-15 Días · Dos Semanas Antes -->
      <div class="relative pl-12 stage-group" data-stage="2">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-xs font-bold text-blue-700">2</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-blue-700">T-15 Días</span> · Dos semanas antes
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="2">0/6 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="2">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="buy-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">04</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Comprar e instalar una suscripción VPN</p>
              <p class="text-sm text-gray-500 mt-0.5">No puedes descargar VPN desde China — sitios bloqueados. Instala y prueba en casa antes de salir.</p>
            </div>
            <a href="/es/life/vpn-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ Guía →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="buy-esim">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">05</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Comprar tu eSIM</p>
              <p class="text-sm text-gray-500 mt-0.5">Elige un eSIM con cobertura China, idealmente vía Hong Kong. Instálalo antes de irte.</p>
            </div>
            <a href="/es/life/sim-card-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ Guía →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="setup-alipay">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">06</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Configurar Alipay y vincular tus tarjetas</p>
              <p class="text-sm text-gray-500 mt-0.5">Vincula crédito y débito. Los QR personales de tiendas no aceptan crédito, pero el débito sí funciona.</p>
            </div>
            <a href="/es/payment/payment-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ Guía →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="setup-wechat">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">07</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Configurar WeChat Pay (respaldo opcional)</p>
              <p class="text-sm text-gray-500 mt-0.5">Alipay cubre 95%, pero restaurantes pequeños usan solo WeChat. Configúralo como respaldo.</p>
            </div>
            <a href="/es/payment/setup-wechat/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ Guía →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="book-hotel">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">08</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Reservar hotel que acepte huéspedes extranjeros</p>
              <p class="text-sm text-gray-500 mt-0.5">No todos los hoteles aceptan pasaportes extranjeros. Reserva en Trip.com filtrando reseñas de extranjeros.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="notify-bank">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">09</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Notificar a tu banco que viajas a China</p>
              <p class="text-sm text-gray-500 mt-0.5">Algunos bancos bloquean transacciones en China como fraude. Notifica en la app o llama — 5 minutos ahora ahorran dolores de cabeza.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 3: T-7 Días · Antes de Salir -->
      <div class="relative pl-12 stage-group" data-stage="3">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-xs font-bold text-indigo-700">3</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-indigo-700">T-7 Días</span> · Antes de salir
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="3">0/4 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="3">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="test-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">10</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Probar tu VPN en todos los dispositivos</p>
              <p class="text-sm text-gray-500 mt-0.5">Confirma que conecta en móvil, laptop y tablet. Hazlo en casa — dentro de China los sitios de VPN también están bloqueados.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="install-apps">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">11</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Instalar apps esenciales para viajar a China</p>
              <p class="text-sm text-gray-500 mt-0.5">Baidu Maps, Didi, Trip.com. Descárgalas ahora antes de que la App Store esté restringida.</p>
            </div>
            <a href="/es/life/essential-apps/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ Guía →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="learn-chinese">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">12</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Aprender 10 frases básicas en chino</p>
              <p class="text-sm text-gray-500 mt-0.5">Saber decir "gracias" y "cuánto cuesta" cambia cómo te trata la gente. Empieza con lo básico.</p>
            </div>
            <a href="/es/life/chinese-phrases/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ Guía →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="backup-docs">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">13</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Guardar copias digitales del pasaporte, visado y seguro</p>
              <p class="text-sm text-gray-500 mt-0.5">Guarda fotos o escaneos en el móvil y la nube. Si pierdes los originales, las copias son tu único recurso.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 4: T-24h · Preparación Final -->
      <div class="relative pl-12 stage-group" data-stage="4">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-xs font-bold text-amber-700">4</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-amber-700">T-24h</span> · Preparación final
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="4">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="4">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-in">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">16</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Hacer check-in online y confirmar el vuelo</p>
              <p class="text-sm text-gray-500 mt-0.5">Elige asiento pronto y revisa cambios de puerta o retrasos. No lo dejes para última hora.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="withdraw-cash">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">15</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Retirar 500-1000 yuanes en efectivo</p>
              <p class="text-sm text-gray-500 mt-0.5">China es 95% sin efectivo, pero tu app de pago fallará al menos una vez. El efectivo es tu respaldo en taxis, puestos y códigos QR rotos.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="power-bank">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">16</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Poner power bank y adaptador en el equipaje de mano</p>
              <p class="text-sm text-gray-500 mt-0.5">Necesitarás el móvil para todo: mapas, pagos, traducción. Mantenlo cargado en el vuelo y al llegar.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 5: Llegada · Primeras 2 Horas -->
      <div class="relative pl-12 stage-group" data-stage="5">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-xs font-bold text-teal-700">5</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-teal-700">Llegada</span> · Primeras 2 horas
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="5">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="5">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="activate-esim">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">17</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Activar eSIM y encender datos móviles</p>
              <p class="text-sm text-gray-500 mt-0.5">Lo primero tras inmigración. Mapas, Didi, traducción, pagos — todo depende de tener internet.</p>
            </div>
            <a href="/es/life/sim-card-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ Guía →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="connect-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">18</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Conectar tu VPN</p>
              <p class="text-sm text-gray-500 mt-0.5">Activa el VPN antes de abrir cualquier app. Sin él, los WhatsApp se acumulan y Google Maps no carga.</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="airport-to-city">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">19</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">Llegar del aeropuerto a tu hotel</p>
              <p class="text-sm text-gray-500 mt-0.5">El metro es lo más barato y fácil en la mayoría de aeropuertos. Didi (el Uber chino) es un buen respaldo.</p>
            </div>
