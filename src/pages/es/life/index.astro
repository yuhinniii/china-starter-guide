---
import Layout from '@layouts/Layout.astro';
const title = 'Vida en China — Consejos y Guías de Viaje';
const description = 'Mantente conectado, mantente seguro y aprovecha al máximo tu viaje.';
---

<Layout title={title} description={description} lang="es">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Vida en China</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Mantente conectado, mantente seguro y aprovecha al máximo tu viaje.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">3</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">Internet y Apps</p>
      </div>
      <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-cyan-800">3</p>
        <p class="text-xs font-semibold text-cyan-800 uppercase tracking-wide mt-1">Salud y Medicina</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">3</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Seguridad y Emergencias</p>
      </div>
      <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-yellow-800">3</p>
        <p class="text-xs font-semibold text-yellow-800 uppercase tracking-wide mt-1">Cultura y Esenciales</p>
      </div>
      <div class="bg-teal-50 border border-teal-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-teal-800">1</p>
        <p class="text-xs font-semibold text-teal-800 uppercase tracking-wide mt-1">Alojamiento</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">Comunicación e Internet</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">3 artículos</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/life/sim-card-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📶 Internet</span>
            <p class="text-base font-bold text-gray-900 mt-1">Mejor SIM y eSIM para Turistas</p>
            <p class="text-sm text-gray-600 mt-0.5">Compara proveedores de eSIM, tarjetas SIM del aeropuerto y planes de datos.</p>
          </a>
          <a href="/es/life/vpn-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🔒 VPN</span>
            <p class="text-base font-bold text-gray-900 mt-1">Mejores VPN para Viajar por China</p>
            <p class="text-sm text-gray-600 mt-0.5">Qué funciona, cómo configurarlo y por qué antes de llegar.</p>
          </a>
          <a href="/es/life/essential-apps/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📱 Apps</span>
            <p class="text-base font-bold text-gray-900 mt-1">10 Apps Esenciales para Viajar por China</p>
            <p class="text-sm text-gray-600 mt-0.5">Pagos, transporte, traducción y descubrimiento.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-cyan-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-cyan-800">Salud y Medicina</h2>
          <span class="text-xs font-medium text-cyan-800 opacity-60">3 artículos</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/life/seeing-a-doctor/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">⚕️ Médico</span>
            <p class="text-base font-bold text-gray-900 mt-1">Ir al Médico en China</p>
            <p class="text-sm text-gray-600 mt-0.5">Farmacia, clínica u hospital — cómo elegir.</p>
          </a>
          <a href="/es/life/top-hospitals/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🏥 Hospitales</span>
            <p class="text-base font-bold text-gray-900 mt-1">Mejores Hospitales con Departamentos Internacionales</p>
            <p class="text-sm text-gray-600 mt-0.5">Mejores hospitales con personal angloparlante, por ciudad.</p>
          </a>
          <a href="/es/life/travel-insurance/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🛡️ Seguro</span>
            <p class="text-base font-bold text-gray-900 mt-1">Seguro de Viaje para China</p>
            <p class="text-sm text-gray-600 mt-0.5">Lo que necesitas saber sobre el seguro de viaje.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Seguridad y Emergencias</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">3 artículos</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/life/is-china-safe/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🛡️ Seguridad</span>
            <p class="text-base font-bold text-gray-900 mt-1">¿Es Seguro Viajar a China?</p>
            <p class="text-sm text-gray-600 mt-0.5">Una opinión honesta sobre seguridad, delitos y qué tener en cuenta.</p>
          </a>
          <a href="/es/life/common-scams/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">⚠️ Estafas</span>
            <p class="text-base font-bold text-gray-900 mt-1">Estafas Comunes en China y Cómo Evitarlas</p>
            <p class="text-sm text-gray-600 mt-0.5">Identifica y evita las trampas turísticas más comunes.</p>
          </a>
          <a href="/es/life/emergency-numbers/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🆘 Emergencias</span>
            <p class="text-base font-bold text-gray-900 mt-1">Números de Emergencia y Qué Hacer</p>
            <p class="text-sm text-gray-600 mt-0.5">Contactos esenciales y respuesta ante emergencias paso a paso.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-yellow-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-yellow-800">Cultura y Esenciales</h2>
          <span class="text-xs font-medium text-yellow-800 opacity-60">4 artículos</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/life/packing-guide/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🧳 Equipaje</span>
            <p class="text-base font-bold text-gray-900 mt-1">Qué Empacar para China</p>
            <p class="text-sm text-gray-600 mt-0.5">Lista práctica de equipaje para cada temporada.</p>
          </a>
          <a href="/es/life/cultural-taboos/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🙏 Etiqueta</span>
            <p class="text-base font-bold text-gray-900 mt-1">Qué Hacer y No Hacer en la Cultura China</p>
            <p class="text-sm text-gray-600 mt-0.5">Guía de etiqueta para visitantes extranjeros.</p>
          </a>
          <a href="/es/life/chinese-phrases/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🈶 Idioma</span>
            <p class="text-base font-bold text-gray-900 mt-1">Frases Esenciales en Chino para Turistas</p>
            <p class="text-sm text-gray-600 mt-0.5">Chino de supervivencia para viajeros.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-teal-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-teal-800">Alojamiento</h2>
          <span class="text-xs font-medium text-teal-800 opacity-60">1 artículo</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/life/china-hotels-guide/" class="block bg-teal-50 border border-teal-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-teal-800">🏨 Hoteles</span>
            <p class="text-base font-bold text-gray-900 mt-1">Cómo Reservar Hoteles en China para Extranjeros</p>
            <p class="text-sm text-gray-600 mt-0.5">Reserva hoteles en China como extranjero — Trip.com, precios de hoteles, políticas de huéspedes extranjeros, check-in y dónde alojarte.</p>
          </a>
        </div>
      </div>
    </div>

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">Siguiente paso</p>
            <h3 class="text-xl font-bold text-gray-900">Planifica tu viaje</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">Estás listo para la vida diaria en China. Ahora: tramita tu visa y aprende a moverte.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/es/visa/visa-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🛂 Guía de visa
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/es/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 Guía de transporte
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>