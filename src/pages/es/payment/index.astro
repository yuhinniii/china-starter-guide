---
import Layout from '@layouts/Layout.astro';
const title = 'Guía de pagos — Cómo pagar en China';
const description = 'Configura Alipay antes de volar — cubre el 95% de los pagos.';
---

<Layout title={title} description={description} lang="es">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">💳 Pagos</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Pagos en China</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Configura Alipay antes de volar — cubre el 95% de los pagos.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">2</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">Apps de pago móvil</p>
      </div>
      <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-indigo-800">2</p>
        <p class="text-xs font-semibold text-indigo-800 uppercase tracking-wide mt-1">Tutoriales de configuración</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Guía de tarjetas</p>
      </div>
      <div class="bg-pink-50 border border-pink-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-pink-800">1</p>
        <p class="text-xs font-semibold text-pink-800 uppercase tracking-wide mt-1">Guía de propinas</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Primeros pasos</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 artículos</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/payment/setup-alipay/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💰 Tutorial</span>
            <p class="text-base font-bold text-gray-900 mt-1">Cómo configurar Alipay como extranjero</p>
            <p class="text-sm text-gray-600 mt-0.5">Descárgalo, regístrate con tu número internacional y vincula tu tarjeta de crédito extranjera.</p>
          </a>
          <a href="/es/payment/setup-wechat/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💬 Tutorial</span>
            <p class="text-base font-bold text-gray-900 mt-1">Cómo configurar WeChat Pay como extranjero</p>
            <p class="text-sm text-gray-600 mt-0.5">Descarga WeChat, regístrate, verifica tu identidad y vincula tu tarjeta internacional.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-indigo-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-indigo-800">Usar tarjetas internacionales</h2>
          <span class="text-xs font-medium text-indigo-800 opacity-60">1 artículo</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/payment/foreign-cards/" class="block bg-indigo-50 border border-indigo-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-indigo-800">💳 Guía</span>
            <p class="text-base font-bold text-gray-900 mt-1">¿Se pueden usar tarjetas de crédito extranjeras en China?</p>
            <p class="text-sm text-gray-600 mt-0.5">Dónde funcionan Visa o Mastercard y costos de retiro en cajeros.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Problemas comunes</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 artículo</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/payment/payment-fails/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🔧 Solución</span>
            <p class="text-base font-bold text-gray-900 mt-1">Qué hacer cuando falla el pago</p>
            <p class="text-sm text-gray-600 mt-0.5">Razones comunes de fallos de pago y solución paso a paso.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-pink-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-pink-800">Propinas y cultura</h2>
          <span class="text-xs font-medium text-pink-800 opacity-60">1 artículo</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/payment/tipping/" class="block bg-pink-50 border border-pink-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-pink-800">🎭 Cultura</span>
            <p class="text-base font-bold text-gray-900 mt-1">Cultura de propinas en China: ¿necesitas dejar propina?</p>
            <p class="text-sm text-gray-600 mt-0.5">No, no se espera propina en China. Una guía rápida sobre qué hacer.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">Guía completa</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 artículo</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/payment/payment-guide/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">📖 General</span>
            <p class="text-base font-bold text-gray-900 mt-1">Cómo pagar en China: guía completa</p>
            <p class="text-sm text-gray-600 mt-0.5">Alipay, WeChat Pay, efectivo o tarjetas de crédito: una visión general completa.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Guías relacionadas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/es/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Transporte en China</p>
          <p class="text-sm text-gray-500">Trenes, metro, taxis y viajes compartidos</p>
        </a>
        <a href="/es/life/essential-apps/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Apps esenciales para China</p>
          <p class="text-sm text-gray-500">Apps imprescindibles para viajar por China</p>
        </a>
      </div>
    </div>
  </section>
</Layout>