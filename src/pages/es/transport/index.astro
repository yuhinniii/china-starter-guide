---
import Layout from '@layouts/Layout.astro';
const title = 'Guía de transporte — Cómo moverse por China';
const description = 'Trenes, aviones, metro y viajes compartidos — todo lo que necesitas.';
---

<Layout title={title} description={description} lang="es">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Transporte en China</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Trenes, aviones, metro y viajes compartidos — todo lo que necesitas.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-sky-50 border border-sky-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-sky-800">1</p>
        <p class="text-xs font-semibold text-sky-800 uppercase tracking-wide mt-1">Guía de tren bala</p>
      </div>
      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-emerald-800">1</p>
        <p class="text-xs font-semibold text-emerald-800 uppercase tracking-wide mt-1">Traslados al aeropuerto</p>
      </div>
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">3</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">Transporte urbano</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-gray-800">1</p>
        <p class="text-xs font-semibold text-gray-800 uppercase tracking-wide mt-1">Viajes compartidos</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-sky-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-sky-800">Cómo moverse por China</h2>
          <span class="text-xs font-medium text-sky-800 opacity-60">1 artículo</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/transport/transport-guide/" class="block bg-sky-50 border border-sky-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-sky-800">📖 General</span>
            <p class="text-base font-bold text-gray-900 mt-1">Cómo moverse por China</p>
            <p class="text-sm text-gray-600 mt-0.5">Visión general completa de todas las opciones de transporte: trenes, aviones, metro y más.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">Llegar a China</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 artículo</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/transport/airport-to-city/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🛬 Guía</span>
            <p class="text-base font-bold text-gray-900 mt-1">Del aeropuerto a la ciudad</p>
            <p class="text-sm text-gray-600 mt-0.5">Opciones de transporte en los principales aeropuertos: Pekín, Shanghái, Cantón y más.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">Transporte urbano</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">3 artículos</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/transport/high-speed-rail/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚄 Guía</span>
            <p class="text-base font-bold text-gray-900 mt-1">Cómo reservar y usar el tren bala en China</p>
            <p class="text-sm text-gray-600 mt-0.5">Todo sobre la reserva y el uso de la red de tren de alta velocidad más grande del mundo.</p>
          </a>
          <a href="/es/transport/flights-vs-rail/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">✈️ Guía</span>
            <p class="text-base font-bold text-gray-900 mt-1">Vuelos vs tren de alta velocidad</p>
            <p class="text-sm text-gray-600 mt-0.5">¿Tren o avión para tu viaje a China? Una comparación basada en datos.</p>
          </a>
          <a href="/es/transport/metro-bus/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚇 Guía</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guía de metro y autobús para las principales ciudades</p>
            <p class="text-sm text-gray-600 mt-0.5">Navega por el transporte público en Pekín, Shanghái, Cantón y Shenzhen.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">Viajes compartidos</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 artículo</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/transport/didi/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">🚕 Tutorial</span>
            <p class="text-base font-bold text-gray-900 mt-1">Cómo usar DiDi en China como extranjero</p>
            <p class="text-sm text-gray-600 mt-0.5">Guía paso a paso para usar DiDi, el Uber chino — con capturas de pantalla.</p>
          </a>
        </div>
      </div>
    </div>

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">Siguiente paso</p>
            <h3 class="text-xl font-bold text-gray-900">Descubre las ciudades chinas</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">Sabes moverte. Ahora elige adónde ir — empieza con nuestra guía de comparación de ciudades.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/es/cities/city-select/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🗺️ Comparar ciudades
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/es/cities/shenzhen-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              📍 Guía de Shenzhen
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>