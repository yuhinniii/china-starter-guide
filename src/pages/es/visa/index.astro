---
import Layout from '@layouts/Layout.astro';
const title = 'Prepárate para China — Guía de Entrada y Configuración';
const description = 'Todo para preparar antes de tu viaje a China.';
---

<Layout title={title} description={description} lang="es">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">✅ Preparar</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Prepárate para Tu Viaje a China</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Todo para preparar antes de tu viaje a China.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">5</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">Visa y Entrada</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">Configuración Digital</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">4</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">Antes de Volar</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">Visa y Entrada</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">5 artículos</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/visa/visa-guide/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📖 Resumen</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guía Completa de Tipos de Visa China</p>
            <p class="text-sm text-gray-600 mt-0.5">Todas las opciones de visa explicadas — compara sin visa, tránsito y visa L.</p>
          </a>
          <a href="/es/visa/visa-free/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📋 Lista</span>
            <p class="text-base font-bold text-gray-900 mt-1">Lista de Países Sin Visa para China</p>
            <p class="text-sm text-gray-600 mt-0.5">50 países pueden entrar sin visa por hasta 30 días.</p>
          </a>
          <a href="/es/visa/transit-240/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">✈️ Tránsito</span>
            <p class="text-base font-bold text-gray-900 mt-1">Tránsito Sin Visa de 240 Horas</p>
            <p class="text-sm text-gray-600 mt-0.5">55 países elegibles — quédate hasta 10 días sin visa.</p>
          </a>
          <a href="/es/visa/mutual-agreement/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🤝 Mutuo</span>
            <p class="text-base font-bold text-gray-900 mt-1">Acuerdos Mutuos Sin Visa</p>
            <p class="text-sm text-gray-600 mt-0.5">29 países tienen acuerdos recíprocos sin visa con China.</p>
          </a>
          <a href="/es/visa/apply-l-visa/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📝 Solicitud</span>
            <p class="text-base font-bold text-gray-900 mt-1">Cómo Solicitar una Visa de Turista para China</p>
            <p class="text-sm text-gray-600 mt-0.5">Guía paso a paso — documentos, formulario COVA, tarifas y consejos.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Configuración Digital</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1 artículo</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/life/sim-card-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">📶 Internet</span>
            <p class="text-base font-bold text-gray-900 mt-1">Mejor SIM y eSIM para Turistas</p>
            <p class="text-sm text-gray-600 mt-0.5">Compara proveedores de eSIM, tarjetas SIM en aeropuertos y planes de datos.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">Antes de Volar</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">4 artículos</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/es/visa/customs-guide/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🛃 Regulaciones</span>
            <p class="text-base font-bold text-gray-900 mt-1">Regulaciones Aduaneras de China</p>
            <p class="text-sm text-gray-600 mt-0.5">Límites libres de impuestos, artículos prohibidos y qué declarar.</p>
          </a>
          <a href="/es/visa/arrival-card/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">📄 Tarjeta de Llegada</span>
            <p class="text-base font-bold text-gray-900 mt-1">Envía Tu Tarjeta de Llegada en Línea</p>
            <p class="text-sm text-gray-600 mt-0.5">Completa la tarjeta de llegada NIA antes de volar — paso a paso con capturas.</p>
          </a>
          <a href="/es/life/survival-kit/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🎒 Lista</span>
            <p class="text-base font-bold text-gray-900 mt-1">Kit de Supervivencia para Tu Viaje a China</p>
            <p class="text-sm text-gray-600 mt-0.5">Lista de verificación completa — documentos, apps y qué empacar.</p>
          </a>
          <a href="/es/visa/first-time-china/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🌟 Primera Vez</span>
            <p class="text-base font-bold text-gray-900 mt-1">Primera Vez en China</p>
            <p class="text-sm text-gray-600 mt-0.5">Cronograma completo — visa, configuración digital, equipaje, llegada, primeras 24 horas.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Guías Relacionadas</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/es/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Pagos en China</p>
          <p class="text-sm text-gray-500">Configura Alipay y más</p>
        </a>
        <a href="/es/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Transporte en China</p>
          <p class="text-sm text-gray-500">Cómo moverte</p>
        </a>
      </div>
    </div>
  </section>
</Layout>