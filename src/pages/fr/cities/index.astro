---
import Layout from '@layouts/Layout.astro';
const title = "Guides de Villes de Chine — Destinations de Voyage";
const description = "Trouvez la ville idéale pour votre voyage en Chine.";
---

<Layout title={title} description={description} lang="fr">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Guides de Villes de Chine</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Trouvez la ville idéale pour votre voyage en Chine.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">6</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">Guides de Villes</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Planificateur d&apos;Itinéraire</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">3</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">Régions Couvertes</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">Planifier Votre Voyage</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/cities/city-select/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🧭 Planification</span>
            <p class="text-base font-bold text-gray-900 mt-1">Combien de Jours en Chine ?</p>
            <p class="text-sm text-gray-600 mt-0.5">Planifiez l&apos;itinéraire parfait — d&apos;un tourbillon de 3 jours à une aventure de 3 semaines.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Histoire et Culture</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/cities/beijing-guide/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🏛️ Pékin</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guide de Voyage de Pékin : Que Voir, Manger et Savoir</p>
            <p class="text-sm text-gray-600 mt-0.5">Cité Interdite, Grande Muraille, hutongs, canard laqué et conseils essentiels.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Moderne et Urbain</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/cities/shanghai-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🌆 Shanghai</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guide de Voyage de Shanghai : La Ville la Plus Accueillante pour les Étrangers</p>
            <p class="text-sm text-gray-600 mt-0.5">Le Bund, Shanghai Tower, quartier Wukang Road-Anfu Road et gastronomie de classe mondiale.</p>
          </a>
          <a href="/fr/cities/shenzhen-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🏙️ Shenzhen</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guide de Voyage de Shenzhen : Centre Technologique aux Côtés de Hong Kong</p>
            <p class="text-sm text-gray-600 mt-0.5">La Silicon Valley de la Chine, le cyclisme côtier et un train de 15 minutes pour Hong Kong.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">Nature et Paysages</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/cities/hainan-visa-free/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🏝️ Hainan</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guide de Voyage de Hainan — 30 Jours Sans Visa</p>
            <p class="text-sm text-gray-600 mt-0.5">Plages tropicales, forêt tropicale et entrée sans visa pour 59 pays.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-orange-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-orange-800">Gastronomie et Art de Vivre</h2>
          <span class="text-xs font-medium text-orange-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/cities/guangzhou-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🥟 Guangzhou</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guide de Voyage de Guangzhou : Capitale Gastronomique de la Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Dim sum, Tour de Canton, Île de Shamian et porte d&apos;entrée vers le sud de la Chine.</p>
          </a>
          <a href="/fr/cities/chengdu-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🐼 Chengdu</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guide de Voyage de Chengdu : Pandas, Nourriture Épicée et Art de Vivre</p>
            <p class="text-sm text-gray-600 mt-0.5">Pandas géants, fondue sichuanaise, maisons de thé et porte d&apos;entrée vers Jiuzhaigou.</p>
          </a>
        </div>
      </div>
    </div>

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">Prochaine étape</p>
            <h3 class="text-xl font-bold text-gray-900">Planifiez votre voyage</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">Ville choisie ? Réglez visa et transport avant de partir.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/fr/visa/visa-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🛂 Guide visa
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/fr/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚄 Guide transport
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
