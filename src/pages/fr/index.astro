---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Hub — Votre Guide Complet pour la Chine';
const description = 'Tout ce que vous devez savoir avant de venir en Chine : paiement, transport, applications, villes et conseils de voyage.';
---

<Layout title={title} description={description} lang="fr">
  <!-- Trigger rebuild: 2026-06-12 17:30 -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900  ">
      Un Guide Clair et À Jour pour Votre Premier Voyage en Chine</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-500  ">
      Commencez par l'essentiel, puis suivez les guides adaptés à votre voyage.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/fr/visa/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">Commencer</a>
      <a href="/fr/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">À propos</a>
    </div>
  </section>

  <!-- Section: Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/fr/visa/', title: 'Visa', desc: 'Types de visa, pays exonérés, politique de transit.' },
        { href: '/fr/payment/', title: 'Paiement', desc: 'Portefeuilles numériques, cartes bancaires, espèces.' },
        { href: '/fr/transport/', title: 'Transport', desc: 'Train grande vitesse, métro, VTC, de l'aéroport à la ville.' },
        { href: '/fr/life/', title: 'Vie en Chine', desc: 'Applications, soins médicaux, conseils sécurité, vie quotidienne.' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  :text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Your Trip: Step by Step -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Votre Voyage, Étape par Étape</h2>
    <p class="text-gray-500 mb-10">Suivez votre étape — chaque lien mène au guide dont vous avez besoin.</p>

    <div class="space-y-8">
      <!-- Stage 1 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-green-100 flex items-center justify-center text-sm font-bold text-green-700">1</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Avant le Départ</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/fr/visa/visa-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Préparatifs</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Quel visa vous faut-il ?</p>
          </a>
          <a href="/fr/payment/payment-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Paiement</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Comment payer en Chine</p>
          </a>
          <a href="/fr/life/survival-kit/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Vie</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Liste de vérification pré-départ</p>
          </a>
        </div>
      </div>

      <!-- Stage 2 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-sm font-bold text-blue-700">2</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">À l'Arrivée</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/fr/transport/airport-to-city/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Transport</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">De l'aéroport à la ville</p>
          </a>
          <a href="/fr/life/sim-card-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Vie</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Carte SIM et configuration internet</p>
          </a>
          <a href="/fr/life/vpn-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Vie</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Configuration de votre VPN</p>
          </a>
        </div>
      </div>

      <!-- Stage 3 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-purple-100 flex items-center justify-center text-sm font-bold text-purple-700">3</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Pendant Votre Séjour</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/fr/transport/transport-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Transport</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Se déplacer en Chine</p>
          </a>
          <a href="/fr/life/essential-apps/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Vie</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">10 applications essentielles</p>
          </a>
          <a href="/fr/life/chinese-phrases/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Vie</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Phrases de base en chinois</p>
          </a>
        </div>
      </div>

      <!-- Stage 4 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-red-100 flex items-center justify-center text-sm font-bold text-red-700">4</div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Besoin d'Aide ?</h3>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <a href="/fr/life/seeing-a-doctor/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Vie</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Consulter un médecin</p>
          </a>
          <a href="/fr/life/common-scams/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Vie</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Éviter les arnaques courantes</p>
          </a>
          <a href="/fr/life/emergency-numbers/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Vie</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Numéros d'urgence</p>
          </a>
          <a href="/fr/payment/payment-fails/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Paiement</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">En cas de problème de paiement</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visa Checker Tool -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="border-t border-gray-100 pt-12">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">Vérificateur de Visa</h2>
        <p class="text-gray-500 text-center mb-8">Vous ne savez pas si vous avez besoin d'un visa ? Sélectionnez votre pays — nous vous indiquerons la marche à suivre.</p>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <label for="visa-country" class="block text-sm font-medium text-gray-700 mb-2">Votre nationalité</label>
          <select id="visa-country" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 text-base appearance-none cursor-pointer">
            <option value="">— Choisissez votre pays —</option>
            <option value="AL">Albanie</option>
            <option value="AD">Andorre</option>
            <option value="AG">Antigua-et-Barbuda</option>
            <option value="AR">Argentine</option>
            <option value="AM">Arménie</option>
            <option value="AU">Australie</option>
            <option value="AT">Autriche</option>
            <option value="AZ">Azerbaïdjan</option>
            <option value="BS">Bahamas</option>
            <option value="BH">Bahreïn</option>
            <option value="BD">Bangladesh</option>
            <option value="BB">Barbade</option>
            <option value="BY">Biélorussie</option>
            <option value="BE">Belgique</option>
            <option value="BA">Bosnie-Herzégovine</option>
            <option value="BR">Brésil</option>
            <option value="BN">Brunéi</option>
            <option value="BG">Bulgarie</option>
            <option value="CA">Canada</option>
            <option value="CL">Chili</option>
            <option value="HR">Croatie</option>
            <option value="CY">Chypre</option>
            <option value="CZ">République Tchèque</option>
            <option value="DK">Danemark</option>
            <option value="DM">Dominique</option>
            <option value="EC">Équateur</option>
            <option value="EG">Égypte</option>
            <option value="EE">Estonie</option>
            <option value="FJ">Fidji</option>
            <option value="FI">Finlande</option>
            <option value="FR">France</option>
            <option value="GE">Géorgie</option>
            <option value="DE">Allemagne</option>
            <option value="GR">Grèce</option>
            <option value="GD">Grenade</option>
            <option value="HU">Hongrie</option>
            <option value="IS">Islande</option>
            <option value="IN">Inde</option>
            <option value="ID">Indonésie</option>
            <option value="IE">Irlande</option>
            <option value="IT">Italie</option>
            <option value="JP">Japon</option>
            <option value="KZ">Kazakhstan</option>
            <option value="KE">Kenya</option>
            <option value="KW">Koweït</option>
            <option value="LV">Lettonie</option>
            <option value="LI">Liechtenstein</option>
            <option value="LT">Lituanie</option>
            <option value="LU">Luxembourg</option>
            <option value="MY">Malaisie</option>
            <option value="MV">Maldives</option>
            <option value="MT">Malte</option>
            <option value="MU">Maurice</option>
            <option value="MX">Mexique</option>
            <option value="MC">Monaco</option>
            <option value="ME">Monténégro</option>
            <option value="NL">Pays-Bas</option>
            <option value="NZ">Nouvelle-Zélande</option>
            <option value="NG">Nigeria</option>
            <option value="MK">Macédoine du Nord</option>
            <option value="NO">Norvège</option>
            <option value="OM">Oman</option>
            <option value="PK">Pakistan</option>
            <option value="PE">Pérou</option>
            <option value="PH">Philippines</option>
            <option value="PL">Pologne</option>
            <option value="PT">Portugal</option>
            <option value="QA">Qatar</option>
            <option value="RO">Roumanie</option>
            <option value="RU">Russie</option>
            <option value="WS">Samoa</option>
            <option value="SM">Saint-Marin</option>
            <option value="SA">Arabie Saoudite</option>
            <option value="RS">Serbie</option>
            <option value="SC">Seychelles</option>
            <option value="SG">Singapour</option>
            <option value="SK">Slovaquie</option>
            <option value="SI">Slovénie</option>
            <option value="SB">Îles Salomon</option>
            <option value="ZA">Afrique du Sud</option>
            <option value="KR">Corée du Sud</option>
            <option value="ES">Espagne</option>
            <option value="SR">Suriname</option>
            <option value="SE">Suède</option>
            <option value="CH">Suisse</option>
            <option value="TH">Thaïlande</option>
            <option value="TO">Tonga</option>
            <option value="TR">Turquie</option>
            <option value="UA">Ukraine</option>
            <option value="AE">Émirats Arabes Unis</option>
            <option value="GB">Royaume-Uni</option>
            <option value="US">États-Unis</option>
            <option value="UY">Uruguay</option>
            <option value="UZ">Ouzbékistan</option>
            <option value="VN">Viêt Nam</option>
            <option value="OTHER">Autre pays</option>
          </select>

          <div id="visa-result" class="mt-6"></div>
        </div>

        <p class="text-xs text-gray-400 text-center mt-4">La politique des visas peut changer. Vérifiez toujours auprès de l'ambassade de Chine avant de réserver.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const countrySelect = document.getElementById('visa-country');
    const resultDiv = document.getElementById('visa-result');

    // Source: China gov.cn official list (2025)
    // Category 1: Unilateral visa-free (30 days) - 50 countries
    const visaFree = ['BN','FR','DE','IT','ES','NL','CH','IE','HU','AT','BE','LU','NZ','AU','PL','PT','GR','CY','SI','SK','NO','FI','DK','IS','AD','MC','LI','KR','BG','RO','HR','ME','MK','MT','EE','LV','JP','BR','AR','CL','PE','UY','SA','OM','KW','BH','CA','RU','GB','SE'];

    // Category 2: Mutual visa agreement (ordinary passport) - 29 countries
    const mutualFree = ['AL','AE','AG','BB','BS','BY','BA','DM','EC','FJ','GD','GE','KZ','QA','MV','MU','WS','RS','SC','SM','SR','SB','TH','TO','UZ','SG','AM','AZ','MY'];

    // Category 3: 240-hour transit - 55 countries
    const transit240 = ['AL','AT','BE','BG','BA','BR','CA','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LT','LU','MT','MC','ME','NL','MK','NO','PL','PT','RO','RU','RS','SK','SI','KR','ES','SE','CH','UA','GB','US','AU','NZ','JP','SG','BN','AE','QA','MX','AR','CL','ID','BY'];

    // Determine best visa status for each country
    function getVisaStatus(code) {
      if (visaFree.includes(code)) return 'visa-free-30';
      if (mutualFree.includes(code)) return 'mutual-free';
      if (transit240.includes(code)) return 'transit';
      return 'need-visa';
    }

    const countryNames = {
      'AL':'Albanie','AD':'Andorre','AG':'Antigua-et-Barbuda','AR':'Argentine','AM':'Arménie',
      'AU':'Australie','AT':'Autriche','AZ':'Azerbaïdjan','BS':'Bahamas','BH':'Bahreïn','BB':'Barbade',
      'BY':'Biélorussie','BE':'Belgique','BA':'Bosnie-Herzégovine','BR':'Brésil','BN':'Brunéi','BG':'Bulgarie',
      'CA':'Canada','CL':'Chili','HR':'Croatie','CY':'Chypre','CZ':'République Tchèque','DK':'Danemark',
      'DM':'Dominique','EC':'Équateur','EG':'Égypte','EE':'Estonie','FJ':'Fidji','FI':'Finlande','FR':'France',
      'GE':'Géorgie','DE':'Allemagne','GR':'Grèce','GD':'Grenade','HU':'Hongrie',      'IS':'Islande','IE':'Irlande','IN':'Inde','ID':'Indonésie','IT':'Italie',
      'JP':'Japon','KZ':'Kazakhstan','KE':'Kenya','KW':'Koweït','LV':'Lettonie','LI':'Liechtenstein',
      'LT':'Lituanie','LU':'Luxembourg','MY':'Malaisie','MV':'Maldives','MT':'Malte','MU':'Maurice',
      'MX':'Mexique',
      'MC':'Monaco','ME':'Monténégro',      'NL':'Pays-Bas','NZ':'Nouvelle-Zélande','NG':'Nigeria','MK':'Macédoine du Nord',
      'NO':'Norvège','OM':'Oman','PK':'Pakistan','PE':'Pérou','PH':'Philippines','PL':'Pologne','PT':'Portugal','QA':'Qatar','RO':'Roumanie',
      'RU':'Russie','WS':'Samoa','SM':'Saint-Marin','SA':'Arabie Saoudite','RS':'Serbie','SC':'Seychelles',
      'SG':'Singapour','SK':'Slovaquie','SI':'Slovénie','SB':'Îles Salomon','ZA':'Afrique du Sud','KR':'Corée du Sud',
      'ES':'Espagne','SR':'Suriname','SE':'Suède','CH':'Suisse','TH':'Thaïlande','TO':'Tonga','TR':'Turquie',
      'UA':'Ukraine',
      'AE':'Émirats Arabes Unis','GB':'Royaume-Uni','US':'États-Unis','UY':'Uruguay','UZ':'Ouzbékistan','VN':'Viêt Nam'
    };

    countrySelect.addEventListener('change', function() {
      const val = this.value;
      if (!val) {
        resultDiv.innerHTML = '';
        return;
      }

      const name = countryNames[val] || 'votre pays';
      const status = getVisaStatus(val);

      if (status === 'visa-free-30') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">Bonne nouvelle ! Les citoyens de ' + name + ' peuvent entrer en Chine sans visa</span> pour un maximum de 30 jours.</p><p class="text-green-700 text-sm mb-3">Aucun visa nécessaire pour les séjours touristiques, d'affaires ou de transit de moins de 30 jours.</p><a href="/fr/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">Voir la liste complète des pays exonérés \u2192</a></div>';
      } else if (status === 'mutual-free') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">Citizens of ' + name + ' peuvent entrer en Chine sans visa</span> dans le cadre d'un accord mutuel.</p><p class="text-green-700 text-sm mb-3">Vérifiez votre type de passeport et la durée autorisée avant de voyager.</p><a href="/fr/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">Voir la liste des pays dispensés de visa \u2192</a></div>';
      } else if (status === 'transit') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-blue-50 border border-blue-200"><p class="text-blue-800 font-semibold mb-1">Vous pouvez utiliser le transit de 240 heures</span> policy.</p><p class="text-blue-700 text-sm mb-3">Citizens of ' + name + ' peuvent transiter par la Chine jusqu'à 10 jours sans visa. Pour les séjours plus longs, vous aurez besoin d'un visa touristique L.</p><div class="flex flex-wrap gap-3"><a href="/fr/visa/transit-240/" class="text-sm font-medium text-blue-700 underline hover:no-underline">Comment fonctionne le transit \u2192</a><a href="/fr/visa/apply-l-visa/" class="text-sm font-medium text-blue-700 underline hover:no-underline">Demander un visa L \u2192</a></div></div>';
      } else {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-orange-50 border border-orange-200"><p class="text-orange-800 font-semibold mb-1">Vous avez besoin d'un visa.</p><p class="text-orange-700 text-sm mb-3">Citizens of ' + name + ' doivent demander un visa touristique (type L) avant de voyager en Chine.</p><a href="/fr/visa/apply-l-visa/" class="inline-block text-sm font-medium text-orange-700 underline hover:no-underline">Comment demander un visa L \u2192</a></div>';
      }
    });
  </script>
</Layout>
