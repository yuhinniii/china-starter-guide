---
import Layout from '@layouts/Layout.astro';
const title = 'Vie en Chine — Conseils de voyage et guides';
const description = 'Restez connecté, restez en sécurité et profitez au maximum de votre voyage.';
---

<Layout title={title} description={description} lang="fr">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🌏 Vie</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Vie en Chine</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Restez connecté, restez en sécurité et profitez au maximum de votre voyage.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">3</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">Internet & Applications</p>
      </div>
      <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-cyan-800">3</p>
        <p class="text-xs font-semibold text-cyan-800 uppercase tracking-wide mt-1">Santé & Médical</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">3</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Sécurité & Urgences</p>
      </div>
      <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-yellow-800">2</p>
        <p class="text-xs font-semibold text-yellow-800 uppercase tracking-wide mt-1">Culture & Essentiels</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">Communication & Internet</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/life/sim-card-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📶 Internet</span>
            <p class="text-base font-bold text-gray-900 mt-1">Meilleure carte SIM et eSIM pour touristes</p>
            <p class="text-sm text-gray-600 mt-0.5">Comparez les fournisseurs d'eSIM, les cartes SIM d'aéroport et les forfaits data.</p>
          </a>
          <a href="/fr/life/vpn-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🔒 VPN</span>
            <p class="text-base font-bold text-gray-900 mt-1">Meilleurs VPN pour voyager en Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Ce qui fonctionne, comment les configurer et pourquoi avant votre arrivée.</p>
          </a>
          <a href="/fr/life/essential-apps/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📱 Applications</span>
            <p class="text-base font-bold text-gray-900 mt-1">10 applications essentielles pour voyager en Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Paiement, transport, traduction et découverte.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-cyan-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-cyan-800">Santé & Médical</h2>
          <span class="text-xs font-medium text-cyan-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/life/seeing-a-doctor/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">⚕️ Médical</span>
            <p class="text-base font-bold text-gray-900 mt-1">Consulter un médecin en Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Pharmacie, clinique ou hôpital — comment choisir.</p>
          </a>
          <a href="/fr/life/top-hospitals/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🏥 Hôpitaux</span>
            <p class="text-base font-bold text-gray-900 mt-1">Meilleurs hôpitaux avec services internationaux</p>
            <p class="text-sm text-gray-600 mt-0.5">Les meilleurs hôpitaux avec personnel anglophone, par ville.</p>
          </a>
          <a href="/fr/life/travel-insurance/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🛡️ Assurance</span>
            <p class="text-base font-bold text-gray-900 mt-1">Assurance voyage pour la Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Ce que vous devez savoir sur l'assurance voyage.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Sécurité & Urgences</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/life/is-china-safe/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🛡️ Sécurité</span>
            <p class="text-base font-bold text-gray-900 mt-1">Est-il sûr de voyager en Chine ?</p>
            <p class="text-sm text-gray-600 mt-0.5">Un avis honnête sur la sécurité, la criminalité et les précautions.</p>
          </a>
          <a href="/fr/life/common-scams/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">⚠️ Arnaques</span>
            <p class="text-base font-bold text-gray-900 mt-1">Arnaques courantes en Chine et comment les éviter</p>
            <p class="text-sm text-gray-600 mt-0.5">Repérez et évitez les pièges à touristes les plus fréquents.</p>
          </a>
          <a href="/fr/life/emergency-numbers/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🆘 Urgence</span>
            <p class="text-base font-bold text-gray-900 mt-1">Numéros d'urgence et conduite à tenir</p>
            <p class="text-sm text-gray-600 mt-0.5">Contacts essentiels et procédure d'urgence étape par étape.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-yellow-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-yellow-800">Culture & Essentiels</h2>
          <span class="text-xs font-medium text-yellow-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/life/survival-kit/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🎒 Checklist</span>
            <p class="text-base font-bold text-gray-900 mt-1">Kit de survie pour votre voyage en Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Checklist complète avant le départ.</p>
          </a>
          <a href="/fr/life/packing-guide/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🧳 Bagages</span>
            <p class="text-base font-bold text-gray-900 mt-1">Que mettre dans sa valise pour la Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Liste de bagages pratique pour chaque saison.</p>
          </a>
          <a href="/fr/life/chinese-phrases/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🈶 Langue</span>
            <p class="text-base font-bold text-gray-900 mt-1">Phrases chinoises essentielles pour les touristes</p>
            <p class="text-sm text-gray-600 mt-0.5">Chinois de survie pour voyageurs.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Guides associés</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/fr/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Paiement en Chine</p>
          <p class="text-sm text-gray-500">Configurer Alipay et WeChat Pay</p>
        </a>
        <a href="/fr/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Transport en Chine</p>
          <p class="text-sm text-gray-500">Se déplacer dans le pays</p>
        </a>
      </div>
    </div>
  </section>
</Layout>