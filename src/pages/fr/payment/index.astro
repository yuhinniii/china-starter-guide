---
import Layout from '@layouts/Layout.astro';
const title = 'Payment Guide — Comment Payer en Chine';
const description = 'Set up Alipay before you fly — that covers 95% of payments.';
---

<Layout title={title} description={description} lang="fr">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">💳 Payment</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Paiement en Chine</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Set up Alipay before you fly — that covers 95% of payments.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">2</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">Mobile Payment Apps</p>
      </div>
      <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-indigo-800">2</p>
        <p class="text-xs font-semibold text-indigo-800 uppercase tracking-wide mt-1">Setup Tutorials</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Credit Card Guide</p>
      </div>
      <div class="bg-pink-50 border border-pink-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-pink-800">1</p>
        <p class="text-xs font-semibold text-pink-800 uppercase tracking-wide mt-1">Tipping Guide</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Getting Started</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/payment/setup-alipay/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💰 Tutorial</span>
            <p class="text-base font-bold text-gray-900 mt-1">How to Set Up Alipay as a Foreigner</p>
            <p class="text-sm text-gray-600 mt-0.5">Download, register with your international number, and link your foreign credit card.</p>
          </a>
          <a href="/fr/payment/setup-wechat/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💬 Tutorial</span>
            <p class="text-base font-bold text-gray-900 mt-1">How to Configurer WeChat Pay as a Foreigner</p>
            <p class="text-sm text-gray-600 mt-0.5">Download WeChat, register, verify your identity, and bind your international card.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-indigo-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-indigo-800">Using International Cards</h2>
          <span class="text-xs font-medium text-indigo-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/payment/foreign-cards/" class="block bg-indigo-50 border border-indigo-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-indigo-800">💳 Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Can You Use Cartes de Crédit Étrangères in China?</p>
            <p class="text-sm text-gray-600 mt-0.5">Where your Visa or Mastercard actually works, ATM withdrawal costs.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Common Problems</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/payment/payment-fails/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🔧 Troubleshoot</span>
            <p class="text-base font-bold text-gray-900 mt-1">What to Do When Your Payment Fails</p>
            <p class="text-sm text-gray-600 mt-0.5">Common payment failure reasons and step-by-step troubleshooting.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-pink-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-pink-800">Tipping & Culture</h2>
          <span class="text-xs font-medium text-pink-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/payment/tipping/" class="block bg-pink-50 border border-pink-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-pink-800">🎭 Culture</span>
            <p class="text-base font-bold text-gray-900 mt-1">China Tipping Culture: Do You Need to Tip?</p>
            <p class="text-sm text-gray-600 mt-0.5">No, tipping is not expected in China. A quick guide on what to do.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">Complete Guide</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/payment/payment-guide/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">📖 Aperçu</span>
            <p class="text-base font-bold text-gray-900 mt-1">Comment Payer en Chine: Complete Guide</p>
            <p class="text-sm text-gray-600 mt-0.5">Alipay, WeChat Pay, cash, or credit cards — a complete overview.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/fr/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Transport in China</p>
          <p class="text-sm text-gray-500">Trains, metro, taxis, and ride-hailing</p>
        </a>
        <a href="/fr/life/essential-apps/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Essential Apps for China</p>
          <p class="text-sm text-gray-500">Must-have apps for traveling in China</p>
        </a>
      </div>
    </div>
  </section>
</Layout>