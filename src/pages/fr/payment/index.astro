---
import Layout from '@layouts/Layout.astro';
const title = 'Guide de paiement — Comment payer en Chine';
const description = 'Configurez Alipay avant de prendre l\'avion — cela couvre 95 % des paiements.';
---

<Layout title={title} description={description} lang="fr">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Payer en Chine</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Configurez Alipay avant de prendre l'avion — cela couvre 95 % des paiements.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">2</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">Apps de paiement mobile</p>
      </div>
      <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-indigo-800">2</p>
        <p class="text-xs font-semibold text-indigo-800 uppercase tracking-wide mt-1">Tutoriels de configuration</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Guide carte de crédit</p>
      </div>
      <div class="bg-pink-50 border border-pink-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-pink-800">1</p>
        <p class="text-xs font-semibold text-pink-800 uppercase tracking-wide mt-1">Guide pourboire</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Premiers pas</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/payment/setup-alipay/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💰 Tutoriel</span>
            <p class="text-base font-bold text-gray-900 mt-1">Comment configurer Alipay en tant qu'étranger</p>
            <p class="text-sm text-gray-600 mt-0.5">Téléchargez, inscrivez-vous avec votre numéro international et liez votre carte de crédit étrangère.</p>
          </a>
          <a href="/fr/payment/setup-wechat/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💬 Tutoriel</span>
            <p class="text-base font-bold text-gray-900 mt-1">Comment configurer WeChat Pay en tant qu'étranger</p>
            <p class="text-sm text-gray-600 mt-0.5">Téléchargez WeChat, inscrivez-vous, vérifiez votre identité et liez votre carte internationale.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-indigo-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-indigo-800">Utiliser les cartes internationales</h2>
          <span class="text-xs font-medium text-indigo-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/payment/foreign-cards/" class="block bg-indigo-50 border border-indigo-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-indigo-800">💳 Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Peut-on utiliser les cartes de crédit étrangères en Chine ?</p>
            <p class="text-sm text-gray-600 mt-0.5">Où votre Visa ou Mastercard fonctionne réellement, frais de retrait aux DAB.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Problèmes courants</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/payment/payment-fails/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🔧 Dépannage</span>
            <p class="text-base font-bold text-gray-900 mt-1">Que faire lorsque votre paiement échoue</p>
            <p class="text-sm text-gray-600 mt-0.5">Raisons courantes d'échec de paiement et dépannage étape par étape.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-pink-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-pink-800">Pourboire & culture</h2>
          <span class="text-xs font-medium text-pink-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/payment/tipping/" class="block bg-pink-50 border border-pink-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-pink-800">🎭 Culture</span>
            <p class="text-base font-bold text-gray-900 mt-1">Culture du pourboire en Chine : faut-il laisser un pourboire ?</p>
            <p class="text-sm text-gray-600 mt-0.5">Non, le pourboire n'est pas attendu en Chine. Un guide rapide sur la conduite à tenir.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">Guide complet</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/payment/payment-guide/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">📖 Aperçu</span>
            <p class="text-base font-bold text-gray-900 mt-1">Comment payer en Chine : guide complet</p>
            <p class="text-sm text-gray-600 mt-0.5">Alipay, WeChat Pay, espèces ou cartes de crédit — un aperçu complet.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">Budget et Coûts du Voyage</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/payment/china-travel-budget/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">💰 Budget</span>
            <p class="text-base font-bold text-gray-900 mt-1">Coût d</p>
            <p class="text-sm text-gray-600 mt-0.5">Combien coûte un voyage en Chine en 2026 ? Un guide complet de budget couvrant vols, hôtels, nourriture, transports et attractions, avec le détail d</p>
          </a>
        </div>
      </div>
    </div>

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">Prochaine étape</p>
            <h3 class="text-xl font-bold text-gray-900">Restez connecté et déplacez-vous</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">Paiements configurés. Maintenant : procurez-vous un eSIM et apprenez à vous déplacer.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/fr/life/sim-card-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              📶 Obtenir un eSIM
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/fr/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 Guide transport
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>