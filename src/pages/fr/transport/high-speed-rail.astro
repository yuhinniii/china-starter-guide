<script type="application/ld+json">{"@context": "https://schema.org", "@type": "HowTo", "name": "Comment réserver et prendre le TGV chinois : guide étape par étape", "step": [{"@type": "HowToStep", "name": "Réserver votre billet", "text": "Réservez sur Trip.com (compatible avec les cartes étrangères) ou sur le site officiel 12306 en anglais avec votre passeport. Aucune carte d'identité ni numéro de téléphone chinois n'est requis."}, {"@type": "HowToStep", "name": "Vérifier votre passeport (12306 uniquement)", "text": "Sur 12306, inscrivez-vous, ajoutez-vous comme passager et effectuez la vérification d'identité unique — automatiquement, en téléchargeant une photo de votre passeport, ou au guichet de la gare."}, {"@type": "HowToStep", "name": "Arriver en avance", "text": "Arrivez à la gare 30 à 40 minutes avant le départ."}, {"@type": "HowToStep", "name": "Passer le contrôle de sécurité", "text": "Faites passer vos sacs dans l'appareil à rayons X. Pas besoin de sortir les liquides ou les ordinateurs portables."}, {"@type": "HowToStep", "name": "Présenter votre passeport au portique", "text": "Utilisez la voie de contrôle manuel (tout à gauche ou tout à droite des portiques). Remettez votre passeport au personnel — les portiques automatiques lisent uniquement les cartes d'identité chinoises."}, {"@type": "HowToStep", "name": "Trouver votre voiture et monter à bord", "text": "Faites correspondre le code couleur des écrans du quai aux marquages au sol, puis montez à bord et gardez votre passeport à portée de main pour les contrôles à bord."}]}</script>
