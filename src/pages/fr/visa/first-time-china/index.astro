---
import Layout from '@layouts/Layout.astro';
const title = 'Première fois en Chine : Guide de préparation étape par étape';
const description = 'Un calendrier complet pour les voyageurs visitant la Chine pour la première fois — visa, configuration numérique, bagages, arrivée et premières 24 heures.';
---

<Layout title={title} description={description} lang="fr">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/fr/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Retour à Visa & Entrée
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🛂 Entrée & Visa</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        Première fois en Chine : Guide de préparation étape par étape
      </h1>
      <p class="text-xl text-gray-600 mb-6">Tout ce que vous devez faire avant votre premier voyage en Chine, organisé par calendrier.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 Dernière mise à jour : juin 2026</span>
        <span>⏱️ 8 min de lecture</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 Réponse rapide</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        <strong>Commencez à préparer 2 à 3 mois avant votre voyage.</strong> <a href="/fr/visa/visa-guide/" class="text-brand-600 underline">Vérifiez d'abord si vous avez besoin d'un visa</a>. Achetez une assurance voyage. Configurez VPN, Alipay et WeChat Pay au moins une semaine avant le départ. Emportez un adaptateur secteur, de l'argent liquide (au cas où) et des médicaments sur ordonnance. Une fois arrivé, activez votre SIM, connectez-vous au WiFi de l'aéroport, et vous êtes prêt.
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 Dans ce guide</h3>
      <ul class="space-y-3">
        <li><a href="#visa-documents" class="text-blue-600 hover:underline">🛂 2-3 mois avant : Visa et documents</a></li>
        <li><a href="#insurance" class="text-blue-600 hover:underline">🏥 1 mois avant : Assurance et hébergement</a></li>
        <li><a href="#digital-setup" class="text-blue-600 hover:underline">📱 2 semaines avant : Configuration numérique</a></li>
        <li><a href="#packing" class="text-blue-600 hover:underline">🧳 1 semaine avant : Bagages et vérifications finales</a></li>
        <li><a href="#arrival" class="text-blue-600 hover:underline">🛬 Jour d'arrivée : Premières étapes</a></li>
        <li><a href="#first-24" class="text-blue-600 hover:underline">⏱️ Premières 24 heures en Chine</a></li>
      </ul>
    </nav>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">

      <h2 id="visa-documents" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🛂</span> 2-3 mois avant : Visa et documents
      </h2>

      <p class="text-gray-700 mb-4"><strong>D'abord, <a href="/fr/visa/visa-guide/" class="text-brand-600 underline">vérifiez si vous avez besoin d'un visa</a> :</strong></p>
      <ul class="list-disc pl-6 space-y-1 text-gray-700 mb-4">
        <li><strong>50 pays</strong> bénéficient d'un <a href="/fr/visa/visa-free/" class="text-brand-600 underline">voyage sans visa de 30 jours</a></li>
        <li><strong>~27 pays</strong> ont des <a href="/fr/visa/mutual-agreement/" class="text-brand-600 underline">accords mutuels d'exonération de visa</a> avec la Chine</li>
        <li><strong>55 pays</strong> sont éligibles au <a href="/fr/visa/transit-240/" class="text-brand-600 underline">transit sans visa de 240 heures (10 jours)</a></li>
        <li>Tous les autres ont besoin d'un <a href="/fr/visa/apply-l-visa/" class="text-brand-600 underline">visa touristique L</a></li>
      </ul>

      <div class="bg-white border border-gray-200 rounded-2xl p-5 mb-8 not-prose">
        <p class="font-semibold text-gray-900 mb-2">Ce dont vous avez besoin :</p>
        <ul class="list-disc pl-5 text-gray-700 text-sm space-y-1">
          <li>✅ Passeport valide au moins 6 mois (avec 2+ pages vierges)</li>
          <li>✅ Visa (si nécessaire) — faites la demande 4 à 6 semaines avant le voyage</li>
          <li>✅ Réservations d'hôtel et itinéraire de vol</li>
        </ul>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="insurance" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🏥</span> 1 mois avant : Assurance et hébergement
      </h2>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-8">
        <li><strong>Achetez une assurance voyage</strong> — une couverture médicale est fortement recommandée (les hôpitaux en Chine peuvent exiger un paiement anticipé)</li>
        <li><strong>Réservez vos hôtels</strong> — utilisez Trip.com, Booking.com ou Agoda</li>
        <li><strong>Réservez vos vols</strong> — utilisez Skyscanner, Trip.com ou directement auprès de la compagnie aérienne</li>
      </ul>

      <hr class="border-gray-200 my-12" />

      <h2 id="digital-setup" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">📱</span> 2 semaines avant : Configuration numérique (étape la plus importante)
      </h2>

      <!-- VPN -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">🔒 VPN</h3>
        <p class="text-sm text-gray-600 mb-2"><strong>Faites-le AVANT votre arrivée</strong> — ne peut pas être fait facilement en Chine.</p>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li>Installez et testez votre <a href="/fr/life/vpn-guide/" class="text-brand-600 underline">VPN</a> sur TOUS vos appareils (téléphone, ordinateur portable, tablette)</li>
          <li>Options recommandées : NordVPN, ExpressVPN, Surfshark, etc.</li>
          <li>Téléchargez l'application et abonnez-vous AVANT de partir</li>
          <li>Testez que Google, WhatsApp, Instagram et YouTube fonctionnent via le VPN</li>
        </ul>
      </div>

      <!-- Payment Apps -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">💳 Applications de paiement</h3>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li><a href="/fr/payment/setup-alipay/" class="text-brand-600 underline"><strong>Alipay</strong></a> (obligatoire) : Téléchargez, inscrivez-vous avec votre numéro international, liez votre Visa/Mastercard</li>
          <li><a href="/fr/payment/setup-wechat/" class="text-brand-600 underline"><strong>WeChat Pay</strong></a> (recommandé) : Téléchargez WeChat, inscrivez-vous, vérifiez votre identité, liez votre carte</li>
        </ul>
      </div>

      <!-- SIM Card -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">📶 Carte SIM / eSIM</h3>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li>Réservez une <a href="/fr/life/sim-card-guide/" class="text-brand-600 underline">eSIM</a> en ligne (airalo, Holafly) — s'active à votre arrivée</li>
          <li>Ou prévoyez d'acheter une carte SIM physique à l'aéroport à votre arrivée</li>
        </ul>
      </div>

      <!-- Essential Apps -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">📲 Applications essentielles</h3>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li><strong>Cartes :</strong> Apple Maps fonctionne, Google Maps n'est pas fiable — Amap (高德地图) est la référence locale</li>
          <li><strong>Traduction :</strong> Google Traduction (téléchargez le chinois hors ligne), ou Pleco (le dictionnaire de chinois de référence)</li>
          <li><strong>Transport :</strong> <a href="/fr/transport/didi/" class="text-brand-600 underline">Didi</a> (l'Uber chinois) — téléchargez et configurez votre profil</li>
          <li><strong>Communication :</strong> WeChat (obligatoire pour beaucoup de choses — menus de restaurant, commande par QR code, paiement)</li>
        </ul>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="packing" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🧳</span> 1 semaine avant : Bagages et vérifications finales
      </h2>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-4">
        <li>Adaptateurs de prise : la Chine utilise des prises de <strong>type A, I et C</strong> (220V, 50Hz)</li>
        <li>Faites des copies numériques de votre passeport, visa et documents d'assurance</li>
        <li>Vérifiez vos essentiels de bagages — consultez notre guide <a href="/fr/life/packing-guide/" class="text-brand-600 underline">Que emporter pour la Chine</a> pour une liste complète</li>
      </ul>

      <hr class="border-gray-200 my-12" />

      <h2 id="arrival" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🛬</span> Jour d'arrivée : Premières étapes
      </h2>

      <ol class="list-decimal pl-6 space-y-2 text-gray-700 mb-8">
        <li><strong>Connectez-vous au WiFi de l'aéroport</strong> — la plupart des grands aéroports offrent un WiFi gratuit via vérification par SMS</li>
        <li><strong>Activez votre eSIM ou achetez une carte SIM physique</strong> au comptoir télécom de l'aéroport</li>
        <li><strong>Échangez une petite somme d'argent liquide</strong> — 500 à 1 000 RMB pour les taxis et la nourriture de rue</li>
        <li><strong>Prenez l'express aéroportuaire, le métro ou commandez un Didi</strong> (évitez les taxis non officiels)</li>
        <li><strong>Enregistrez-vous à votre hôtel</strong> — ils scanneront votre passeport pour l'enregistrement</li>
      </ol>

      <hr class="border-gray-200 my-12" />

      <h2 id="first-24" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">⏱️</span> Premières 24 heures en Chine
      </h2>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-8">
        <li><strong>Payez avec votre téléphone</strong> — scannez les QR codes partout, la plupart des commerçants préfèrent cela. Consultez notre guide <a href="/fr/payment/payment-guide/" class="text-brand-600 underline">Comment payer en Chine</a></li>
        <li><strong>Testez votre VPN</strong> — connectez-vous dès que vous quittez le WiFi de l'aéroport vers un réseau de confiance</li>
        <li><strong>Repérez votre quartier</strong> — trouvez le magasin de proximité le plus proche (7-11, FamilyMart ou Lawson)</li>
        <li><strong>Téléchargez Amap</strong> si vous ne l'avez pas déjà fait — cela vous sauvera pour la navigation</li>
        <li><strong>Mangez</strong> — nourriture de rue, restaurants locaux. Le pourboire n'est pas attendu en Chine</li>
      </ul>

    </div>

    <!-- Sources -->
    <div class="bg-gray-50 rounded-2xl p-6 not-prose mt-12">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📚 Sources</h3>
      <ul class="space-y-2">
        <li><a href="https://en.nia.gov.cn/n147418/n147463/c183390/content.html" class="text-brand-600 hover:underline text-sm" target="_blank" rel="noopener">Administration nationale de l'immigration — Liste des pays couverts par les politiques d'exemption unilatérale de visa</a></li>
        <li><a href="https://www.gov.uk/foreign-travel-advice/china/entry-requirements" class="text-brand-600 hover:underline text-sm" target="_blank" rel="noopener">Gouvernement britannique — Conseils aux voyageurs pour la Chine : conditions d'entrée</a></li>
      </ul>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose mt-6">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 Guides connexes</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/fr/visa/customs-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">Réglementations douanières chinoises</p>
          <p class="text-sm text-gray-600">Ce que vous pouvez et ne pouvez pas apporter en Chine</p>
        </a>
        <a href="/fr/visa/arrival-card/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">Comment soumettre votre carte d'arrivée en ligne</p>
          <p class="text-sm text-gray-600">Guide étape par étape avec captures d'écran</p>
        </a>
        <a href="/fr/payment/payment-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">Comment payer en Chine</p>
          <p class="text-sm text-gray-600">Aperçu complet des paiements</p>
        </a>
        <a href="/fr/transport/airport-to-city/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">De l'aéroport à la ville</p>
          <p class="text-sm text-gray-600">Options de transport dans les principaux aéroports</p>
        </a>
      </div>
    </div>
  </article>
</Layout>