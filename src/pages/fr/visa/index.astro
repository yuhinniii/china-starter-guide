---
import Layout from '@layouts/Layout.astro';
const title = 'Préparez votre voyage en Chine — Guide d\'entrée et de configuration';
const description = 'Tout ce qu\'il faut préparer avant votre voyage en Chine.';
---

<Layout title={title} description={description} lang="fr">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">✅ Préparer</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Préparez votre voyage en Chine</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Tout ce qu'il faut préparer avant votre voyage en Chine.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">5</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">Visa & Entrée</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">Configuration numérique</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">4</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">Avant le décollage</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">Visa & Entrée</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">5 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/visa/visa-guide/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📖 Aperçu</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guide complet des types de visa chinois</p>
            <p class="text-sm text-gray-600 mt-0.5">Toutes les options de visa expliquées — comparez l'exonération, le transit et le visa L.</p>
          </a>
          <a href="/fr/visa/visa-free/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📋 Liste</span>
            <p class="text-base font-bold text-gray-900 mt-1">Liste des pays exonérés de visa</p>
            <p class="text-sm text-gray-600 mt-0.5">50 pays peuvent entrer sans visa pour un séjour allant jusqu'à 30 jours.</p>
          </a>
          <a href="/fr/visa/transit-240/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">✈️ Transit</span>
            <p class="text-base font-bold text-gray-900 mt-1">Transit sans visa de 240 heures</p>
            <p class="text-sm text-gray-600 mt-0.5">55 pays éligibles — restez jusqu'à 10 jours sans visa.</p>
          </a>
          <a href="/fr/visa/mutual-agreement/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🤝 Accord mutuel</span>
            <p class="text-base font-bold text-gray-900 mt-1">Accords mutuels d'exonération de visa</p>
            <p class="text-sm text-gray-600 mt-0.5">29 pays ont des accords réciproques d'exonération avec la Chine.</p>
          </a>
          <a href="/fr/visa/apply-l-visa/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📝 Demande</span>
            <p class="text-base font-bold text-gray-900 mt-1">Comment demander un visa touristique chinois</p>
            <p class="text-sm text-gray-600 mt-0.5">Guide étape par étape — documents, formulaire COVA, frais et conseils.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Configuration numérique</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/life/sim-card-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">📶 Internet</span>
            <p class="text-base font-bold text-gray-900 mt-1">Meilleure carte SIM et eSIM pour touristes</p>
            <p class="text-sm text-gray-600 mt-0.5">Comparez les fournisseurs d'eSIM, les cartes SIM d'aéroport et les forfaits de données.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">Avant le décollage</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">4 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/visa/customs-guide/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🛃 Réglementation</span>
            <p class="text-base font-bold text-gray-900 mt-1">Réglementations douanières chinoises</p>
            <p class="text-sm text-gray-600 mt-0.5">Franchises en franchise, articles interdits et ce qu'il faut déclarer.</p>
          </a>
          <a href="/fr/visa/arrival-card/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">📄 Carte d'arrivée</span>
            <p class="text-base font-bold text-gray-900 mt-1">Soumettre votre carte d'arrivée en ligne</p>
            <p class="text-sm text-gray-600 mt-0.5">Remplissez la carte d'arrivée NIA avant votre vol — étape par étape avec captures d'écran.</p>
          </a>
          <a href="/fr/life/survival-kit/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🎒 Checklist</span>
            <p class="text-base font-bold text-gray-900 mt-1">Votre kit de survie pour la Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Liste de vérification complète avant départ — documents, applications et quoi emporter.</p>
          </a>
          <a href="/fr/visa/first-time-china/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🌟 Première fois</span>
            <p class="text-base font-bold text-gray-900 mt-1">Première fois en Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Calendrier complet — visa, configuration numérique, bagages, arrivée, premières 24 heures.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Guides connexes</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/fr/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Paiement en Chine</p>
          <p class="text-sm text-gray-500">Configurez Alipay et plus</p>
        </a>
        <a href="/fr/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Transport en Chine</p>
          <p class="text-sm text-gray-500">Se déplacer</p>
        </a>
      </div>
    </div>
  </section>
</Layout>