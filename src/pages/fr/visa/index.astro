---
import Layout from '@layouts/Layout.astro';
const title = 'Préparez votre voyage en Chine — Guide d\'entrée et de configuration';
const description = 'Tout ce qu\'il faut préparer avant votre voyage en Chine.';
---

<Layout title={title} description={description} lang="fr">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Préparez votre voyage en Chine</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Tout ce qu'il faut préparer avant votre voyage en Chine.</p>
    </header>

    <!-- Vérificateur de visa -->
    <div id="visa-checker" class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 mb-12 not-prose shadow-sm">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-2xl">🛂</span>
        <div>
          <h2 class="text-lg font-bold text-gray-900">Vérificateur de visa</h2>
          <p class="text-sm text-gray-500">Vous ne savez pas si vous avez besoin d'un visa ? Répondez à trois questions et nous vous le dirons.</p>
        </div>
      </div>

      <!-- Step 1: Country -->
      <div id="step-country" class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-brand-500 text-white text-xs font-bold flex items-center justify-center">1</span>
          <span class="text-base font-semibold text-gray-700">Votre passeport</span>
        </div>
        <div class="flex flex-wrap gap-2 mb-3 sm:justify-between">
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="US"><span class="mr-1">🇺🇸</span>United States</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="GB"><span class="mr-1">🇬🇧</span>United Kingdom</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="CA"><span class="mr-1">🇨🇦</span>Canada</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="AU"><span class="mr-1">🇦🇺</span>Australia</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="SG"><span class="mr-1">🇸🇬</span>Singapore</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="TH"><span class="mr-1">🇹🇭</span>Thailand</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="KR"><span class="mr-1">🇰🇷</span>South Korea</button>
        </div>
        <div class="relative">
          <input id="country-input" type="text" placeholder="Ou cherchez un pays..." class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-base">
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          <div id="country-dropdown" class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-xl shadow-lg max-h-60 overflow-y-auto"></div>
        </div>
        <p id="country-selected" class="hidden mt-2 text-base text-green-700 font-medium"></p>
      </div>

      <!-- Step 2: Purpose -->
      <div id="step-purpose" class="hidden mb-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-brand-500 text-white text-xs font-bold flex items-center justify-center">2</span>
          <span class="text-base font-semibold text-gray-700">Quel est le but de votre visite ?</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <button data-purpose="tourism-business" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">🏖️ Tourisme / Affaires / Famille</div>
            <div class="text-xs text-gray-500 mt-0.5">Visite générale</div>
          </button>
          <button data-purpose="work" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">💼 Travail</div>
            <div class="text-xs text-gray-500 mt-0.5">Nécessite un parrainage employeur</div>
          </button>
          <button data-purpose="study" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">📚 Études</div>
            <div class="text-xs text-gray-500 mt-0.5">Nécessite une admission universitaire</div>
          </button>
        </div>
      </div>

      <!-- Result -->
      <div id="visa-result" class="hidden"></div>

      <!-- Reset -->
      <button id="reset-checker" class="hidden mt-4 text-base text-gray-400 hover:text-gray-600 underline cursor-pointer">Recommencer</button>

      <p class="text-xs text-gray-400 mt-4">Basé sur la politique officielle de NIA. Mis à jour : juillet 2026. <span class="underline">Vérifiez auprès de votre ambassade avant de réserver.</span></p>
    </div>

    

<!-- Quick Stats -->
    <div class="grid grid-cols-2 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">5</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">Visa & Entrée</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">4</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">Avant le décollage</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">Visa & Entrée</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">5 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/visa/visa-guide/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📖 Aperçu</span>
            <p class="text-base font-bold text-gray-900 mt-1">Guide complet des types de visa chinois</p>
            <p class="text-sm text-gray-600 mt-0.5">Toutes les options de visa expliquées — comparez l'exonération, le transit et le visa L.</p>
          </a>
          <a href="/fr/visa/visa-free/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📋 Liste</span>
            <p class="text-base font-bold text-gray-900 mt-1">Liste des pays exonérés de visa</p>
            <p class="text-sm text-gray-600 mt-0.5">50 pays peuvent entrer sans visa pour un séjour allant jusqu'à 30 jours.</p>
          </a>
          <a href="/fr/visa/transit-240/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">✈️ Transit</span>
            <p class="text-base font-bold text-gray-900 mt-1">Transit sans visa de 240 heures</p>
            <p class="text-sm text-gray-600 mt-0.5">55 pays éligibles — restez jusqu'à 10 jours sans visa.</p>
          </a>
          <a href="/fr/visa/mutual-agreement/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🤝 Accord mutuel</span>
            <p class="text-base font-bold text-gray-900 mt-1">Accords mutuels d'exonération de visa</p>
            <p class="text-sm text-gray-600 mt-0.5">29 pays ont des accords réciproques d'exonération avec la Chine.</p>
          </a>
          <a href="/fr/visa/apply-l-visa/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📝 Demande</span>
            <p class="text-base font-bold text-gray-900 mt-1">Comment demander un visa touristique chinois</p>
            <p class="text-sm text-gray-600 mt-0.5">Guide étape par étape — documents, formulaire COVA, frais et conseils.</p>
          </a>
        </div>
      </div>
      
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">Avant le décollage</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/fr/visa/customs-guide/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🛃 Réglementation</span>
            <p class="text-base font-bold text-gray-900 mt-1">Réglementations douanières chinoises</p>
            <p class="text-sm text-gray-600 mt-0.5">Franchises en franchise, articles interdits et ce qu'il faut déclarer.</p>
          </a>
          <a href="/fr/visa/arrival-card/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">📄 Carte d'arrivée</span>
            <p class="text-base font-bold text-gray-900 mt-1">Soumettre votre carte d'arrivée en ligne</p>
            <p class="text-sm text-gray-600 mt-0.5">Remplissez la carte d'arrivée NIA avant votre vol — étape par étape avec captures d'écran.</p>
          </a>
          <a href="/fr/visa/first-time-china/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🌟 Première fois</span>
            <p class="text-base font-bold text-gray-900 mt-1">Première fois en Chine</p>
            <p class="text-sm text-gray-600 mt-0.5">Calendrier complet — visa, configuration numérique, bagages, arrivée, premières 24 heures.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Prochaine Étape -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">Prochaine Étape</p>
            <h3 class="text-xl font-bold text-gray-900">Configurez les paiements et apprenez à vous déplacer</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">Votre visa est réglé. Configurez maintenant Alipay et apprenez à vous déplacer dans les transports chinois.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/fr/payment/payment-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              💳 Guide de paiement
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/fr/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 Guide de transport
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
</section>

