      {code:'LC',name:'Saint Lucia',flag:'🇱🇨'},{code:'VC',name:'Saint Vincent and the Grenadines',flag:'🇻🇨'},{code:'WS',name:'Samoa',flag:'🇼🇸'},{code:'SM',name:'San Marino',flag:'🇸🇲'},
      {code:'ST',name:'Sao Tome and Principe',flag:'🇸🇹'},{code:'SA',name:'Saudi Arabia',flag:'🇸🇦'},{code:'SN',name:'Senegal',flag:'🇸🇳'},{code:'RS',name:'Serbia',flag:'🇷🇸'},
      {code:'SC',name:'Seychelles',flag:'🇸🇨'},{code:'SL',name:'Sierra Leone',flag:'🇸🇱'},{code:'SG',name:'Singapore',flag:'🇸🇬'},{code:'SK',name:'Slovakia',flag:'🇸🇰'},
      {code:'SI',name:'Slovenia',flag:'🇸🇮'},{code:'SB',name:'Solomon Islands',flag:'🇸🇧'},{code:'SO',name:'Somalia',flag:'🇸🇴'},{code:'ZA',name:'South Africa',flag:'🇿🇦'},
      {code:'KR',name:'South Korea',flag:'🇰🇷'},{code:'SS',name:'South Sudan',flag:'🇸🇸'},{code:'ES',name:'Spain',flag:'🇪🇸'},{code:'LK',name:'Sri Lanka',flag:'🇱🇰'},
      {code:'SD',name:'Sudan',flag:'🇸🇩'},{code:'SR',name:'Suriname',flag:'🇸🇷'},{code:'SE',name:'Sweden',flag:'🇸🇪'},{code:'CH',name:'Switzerland',flag:'🇨🇭'},
      {code:'SY',name:'Syria',flag:'🇸🇾'},{code:'TJ',name:'Tajikistan',flag:'🇹🇯'},{code:'TH',name:'Thailand',flag:'🇹🇭'},{code:'TL',name:'Timor-Leste',flag:'🇹🇱'},
      {code:'TG',name:'Togo',flag:'🇹🇬'},{code:'TO',name:'Tonga',flag:'🇹🇴'},{code:'TT',name:'Trinidad and Tobago',flag:'🇹🇹'},{code:'TN',name:'Tunisia',flag:'🇹🇳'},
      {code:'TR',name:'Turkey',flag:'🇹🇷'},{code:'TM',name:'Turkmenistan',flag:'🇹🇲'},{code:'TV',name:'Tuvalu',flag:'🇹🇻'},{code:'UG',name:'Uganda',flag:'🇺🇬'},
      {code:'UA',name:'Ukraine',flag:'🇺🇦'},{code:'AE',name:'United Arab Emirates',flag:'🇦🇪'},{code:'GB',name:'United Kingdom',flag:'🇬🇧'},{code:'US',name:'United States',flag:'🇺🇸'},
      {code:'UY',name:'Uruguay',flag:'🇺🇾'},{code:'UZ',name:'Uzbekistan',flag:'🇺🇿'},{code:'VU',name:'Vanuatu',flag:'🇻🇺'},{code:'VE',name:'Venezuela',flag:'🇻🇪'},
      {code:'VN',name:'Vietnam',flag:'🇻🇳'},{code:'YE',name:'Yemen',flag:'🇾🇪'},{code:'ZM',name:'Zambia',flag:'🇿🇲'},{code:'ZW',name:'Zimbabwe',flag:'🇿🇼'}
    ];

    let state = { country: null, purpose: null };
    const countryInput = document.getElementById('country-input');
    const countryDropdown = document.getElementById('country-dropdown');
    const countrySelected = document.getElementById('country-selected');
    const stepPurpose = document.getElementById('step-purpose');
    const resultDiv = document.getElementById('visa-result');
    const resetBtn = document.getElementById('reset-checker');
    const purposeBtns = document.querySelectorAll('.purpose-btn');

    function getVisaStatus(code) {
      if (visaFree30.includes(code)) return 'visa-free-30';
      if (mutualFree.includes(code)) return 'mutual-free';
      if (transit240.includes(code)) return 'transit';
      return 'need-visa';
    }

    countryInput.addEventListener('input', function() {
      renderDropdown(this.value.toLowerCase().trim());
    });
    countryInput.addEventListener('focus', function() {
      renderDropdown(this.value);
    });

    function renderDropdown(q) {
      const matches = q ? countryData.filter(c => c.name.toLowerCase().includes(q) || c.code.toLowerCase() === q) : countryData;
      if (matches.length === 0) { countryDropdown.classList.add('hidden'); return; }
      countryDropdown.innerHTML = matches.map(c =>
        '<div class="px-4 py-2.5 hover:bg-brand-50 cursor-pointer flex items-center gap-3 text-base border-b border-gray-100 last:border-0 ' + (state.country === c.code ? 'bg-brand-50 font-semibold' : '') + '" data-code="' + c.code + '"><span>' + c.flag + '</span><span>' + c.name + '</span></div>'
      ).join('');
      countryDropdown.classList.remove('hidden');
    }

    countryDropdown.addEventListener('click', function(e) {
      var item = e.target.closest('[data-code]');
      if (item) selectCountry(item.dataset.code);
    });
    document.querySelectorAll('.quick-country').forEach(function(btn) {
      btn.addEventListener('click', function() { selectCountry(this.dataset.code); });
    });

    function selectCountry(code) {
      var c = countryData.find(function(x) { return x.code === code; });
      if (!c) return;
      state.country = code;
      countryInput.value = '';
      countryDropdown.classList.add('hidden');
      countrySelected.classList.remove('hidden');
      countrySelected.innerHTML = c.flag + ' <span class="font-semibold">' + c.name + '</span>';
      document.querySelectorAll('.quick-country').forEach(function(btn) {
        if (btn.dataset.code === code) { btn.classList.add('bg-brand-500','text-white','border-brand-500'); btn.classList.remove('bg-white','border-gray-200'); }
        else { btn.classList.remove('bg-brand-500','text-white','border-brand-500'); btn.classList.add('bg-white','border-gray-200'); }
      });
      stepPurpose.classList.remove('hidden');
      resultDiv.classList.add('hidden');
      state.purpose = null;
      purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
    }

    purposeBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        state.purpose = this.dataset.purpose;
        purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
        this.classList.remove('bg-white','text-gray-700','border-gray-200');
        this.classList.add('bg-brand-500','text-white','border-brand-500');
        resetBtn.classList.remove('hidden');
        showResult();
      });
    });

    function detailRow(label, value) {
      return '<div class="flex gap-x-3 text-sm leading-relaxed mb-2 pb-2 border-b border-gray-100"><span class="w-28 shrink-0 text-right font-medium text-gray-500">' + label + '</span><span class="text-gray-700">' + value + '</span></div>';
    }

    function showResult() {
      var country = countryData.find(function(c) { return c.code === state.country; });
      var name = country ? country.name : 'votre pays';
      var status = getVisaStatus(state.country);
      var purpose = state.purpose;

      if (purpose === 'work') {
        resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">Visa Requis</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — le travail nécessite un visa Z</h3><p class="text-sm text-gray-600 leading-relaxed">Travailler en Chine nécessite toujours un visa Z préapprouvé, quel que soit votre passeport ou votre mode d'arrivée.</p></div><div class="bg-white px-5 py-4">' + detailRow('Type de visa', 'Z-visa (permis de travail)') + detailRow('Parrain', 'Votre employeur doit faire la demande pour vous') + detailRow('Traitement', '4 à 8 semaines en général') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">SITE OFFICIEL DE NIA →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/fr/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">Types de visa chinois →</a></div></div></div>';
      } else if (purpose === 'study') {
        resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">Visa Requis</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — les études nécessitent un visa X</h3><p class="text-sm text-gray-600 leading-relaxed">Étudier en Chine nécessite toujours un visa X préapprouvé, quel que soit votre passeport ou votre mode d'arrivée.</p></div><div class="bg-white px-5 py-4">' + detailRow('Type de visa', 'X1 (>180 jours) ou X2 (≤180 jours)') + detailRow('Documents', 'Formulaire JW202, lettre d'admission, examen médical') + detailRow('Traitement', '5-10 jours ouvrables') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">SITE OFFICIEL DE NIA →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/fr/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">Types de visa chinois →</a></div></div></div>';
      } else if (purpose === 'tourism-business') {
        if (status === 'visa-free-30' || status === 'mutual-free') {
          var policyText = status === 'visa-free-30' ? 'Entrée sans visa 30 jours' : 'Accord bilatéral mutuel';
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-green-500 overflow-hidden"><div class="bg-green-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-green-700 uppercase mb-1.5">Sans Visa</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — 30 jours, sans visa</h3><p class="text-sm text-gray-600 leading-relaxed">Vous pouvez entrer en Chine sans visa jusqu'à 30 jours.</p></div><div class="bg-white px-5 py-4">' + detailRow('Politique', policyText) + detailRow('Valable', 'jusqu'au 31 décembre 2026') + detailRow('Entrée', 'Tout port — aérien, frontière terrestre de Hong Kong ou mer') + detailRow('Autorisé pour', 'Tourisme, affaires, visites familiales, transit') + detailRow('Non autorisé', 'Travail, études, journalisme') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-green-600 hover:underline">SITE OFFICIEL DE NIA →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/fr/visa/visa-free/" class="text-sm font-medium text-brand-600 hover:underline">Liste complète sans visa →</a><a href="/fr/visa/first-time-china/" class="text-sm font-medium text-brand-600 hover:underline">Première fois en Chine →</a></div></div></div>';
        } else if (transit240.includes(state.country)) {
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-gray-400 overflow-hidden"><div class="bg-gray-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-gray-500 uppercase mb-1.5">Options de Visa</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — visa L ou transit 240h</h3><p class="text-sm text-gray-600 leading-relaxed">Deux options disponibles. Choisissez celle qui correspond à votre itinéraire.</p></div><div class="bg-white px-5 py-4 space-y-6"><div class="rounded-lg border-l-4 border-orange-400 overflow-hidden"><div class="bg-orange-50 px-3 py-2"><p class="text-base font-semibold text-orange-700 mb-0.5">📄 Option A : Faire une demande de visa</p><p class="text-sm text-gray-600 leading-relaxed">Pour les allers-retours directs entre ' + name + ' et la Chine. Vous faites la demande auprès de l'ambassade de Chine avant de partir.</p></div><div class="bg-white px-3 py-2">' + detailRow('Type de visa', 'Généralement visa L (tourisme) ou visa M (affaires)') + detailRow('Documents', 'Passeport, photo, itinéraire, finances, formulaire officiel') + detailRow('Traitement', '4-10 jours ouvrables') + '<a href="/fr/visa/apply-l-visa/" class="text-base text-orange-600 font-medium hover:underline">Comment demander un visa L →</a></div></div><div class="rounded-lg border-l-4 border-blue-400 overflow-hidden"><div class="bg-blue-50 px-3 py-2"><p class="text-base font-semibold text-blue-700 mb-0.5">🔄 Option B : Transit 240h (sans visa)</p><p class="text-sm text-gray-600 leading-relaxed">Pour les voyages incluant Hong Kong, Macao ou un autre pays. Séjour jusqu'à 10 jours sans visa.</p></div><div class="bg-white px-3 py-2">' + detailRow('Condition', 'Billet de correspondance confirmé vers un troisième pays ou région') + detailRow('Séjour maximum', '240 heures (10 jours)') + '<a href="/fr/visa/transit-240/" class="text-base text-blue-600 font-medium hover:underline">Détails du transit 240h →</a></div></div><div class="pt-2 border-t border-gray-100"><a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-gray-500 hover:text-gray-700">SITE OFFICIEL DE NIA →</a></div></div></div>';
        } else {
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">Visa Requis</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — faire la demande avant le voyage</h3><p class="text-sm text-gray-600 leading-relaxed">' + name + ' doivent demander un visa chinois avant d'arriver.</p></div><div class="bg-white px-5 py-4">' + detailRow('Type de visa', 'Généralement visa L (tourisme) ou visa M (affaires)') + detailRow('Où faire la demande', 'Ambassade ou consulat chinois dans votre pays') + detailRow('Documents', 'Passeport, photo, itinéraire, finances, formulaire officiel') + detailRow('Traitement', '4-10 jours ouvrables en général') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">SITE OFFICIEL DE NIA →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/fr/visa/apply-l-visa/" class="text-sm font-medium text-brand-600 hover:underline">Guide de demande de visa L →</a><a href="/fr/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">Aperçu des types de visa →</a></div></div></div>';
        }
      }
      resultDiv.classList.remove('hidden');
    }

    resetBtn.addEventListener('click', function() {
      state = { country: null, purpose: null };
      countryInput.value = '';
      countryDropdown.classList.add('hidden');
      countrySelected.classList.add('hidden');
      stepPurpose.classList.add('hidden');
      resultDiv.classList.add('hidden');
      resetBtn.classList.add('hidden');
      purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('#step-country')) countryDropdown.classList.add('hidden');
    });
  </script>

</Layout>