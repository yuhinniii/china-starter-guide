---
import Layout from '@layouts/Layout.astro';
const title = 'Pays Exonérés de Visa pour la Chine List (2026) — China Starter Hub';
const description = 'Official list of countries eligible for visa-free entry to China — unilateral (50 countries) and mutual agreements (29 countries).';
---

<Layout title={title} description={description} lang="fr">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/fr/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Prepare
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">📋 Entry & Visa</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        Pays Exonérés de Visa pour la Chine List (2026)
      </h1>
      <p class="text-xl text-gray-600 mb-6">Check if votre pays qualifies for visa-free entry to China.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 Last updated: June 2026</span>
        <span>⏱️ 5 min read</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 Quick Answer</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        <strong>There are two ways to enter China visa-free:</strong> China offers unilateral visa-free entry to citizens of <strong>50 countries</strong> (up to 30 days), and has mutual visa-free agreements with <strong>29 countries</strong>. If votre pays isn't on either list, check the 240-hour transit policy or apply for an L visa.
      </p>
    </div>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        Below are the complete lists based on the latest official data from the Chinese government (2025). Source: <a href="http://big5.www.gov.cn/gate/big5/www.gov.cn/yaowen/liebiao/202508/content_7035244.htm" class="text-brand-600 underline" target="_blank" rel="noopener">中国政府网</a>.
      </p>

      <hr class="border-gray-200 my-12" />

      <!-- Section 1: Unilateral -->
      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🟢</span> Unilateral Visa-Free (50 Countries)
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        Citizens of these countries can enter China <strong>without a visa</strong> for up to <strong>30 days</strong>. No advance application needed.
      </p>

      <div class="bg-green-50 border border-green-200 rounded-2xl p-6 mb-8 not-prose">
        <p class="text-gray-700 mb-4 font-medium">Valid for: Tourism, business, family visits, transit, cultural exchanges. Max 30 days.</p>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Europe (35)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>France</span><span>Allemagne</span><span>Italie</span>
          <span>Pays-Bas</span><span>Espagne</span><span>Suisse</span>
          <span>Irlande</span><span>Hongrie</span><span>Autriche</span>
          <span>Belgique</span><span>Luxembourg</span><span>Pologne</span>
          <span>Portugal</span><span>Grèce</span><span>Chypre</span>
          <span>Slovénie</span><span>Slovaquie</span><span>Norvège</span>
          <span>Finlande</span><span>Danemark</span><span>Islande</span>
          <span>Andorre</span><span>Monaco</span><span>Liechtenstein</span>
          <span>Bulgarie</span><span>Roumanie</span><span>Croatie</span>
          <span>Monténégro</span><span>Macédoine du Nord</span><span>Malte</span>
          <span>Estonie</span><span>Lettonie</span><span>Russie</span>
          <span>Suède</span><span>Royaume-Uni</span>
        </div>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Asia (7)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>Brunéi</span><span>Corée du Sud</span><span>Japon</span>
          <span>Arabie Saoudite</span><span>Oman</span><span>Koweït</span>
          <span>Bahreïn</span>
        </div>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Americas (6)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>Brésil</span><span>Argentine</span><span>Chili</span>
          <span>Pérou</span><span>Uruguay</span><span>Canada</span>
        </div>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">Oceania (2)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-8 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>Australie</span><span>Nouvelle-Zélande</span>
        </div>
      </div>

    </div>

    <!-- Not sure which one applies to you? -->
    <div class="bg-gray-50 rounded-2xl p-6 not-prose mt-8 mb-12">
      <h3 class="text-lg font-bold text-gray-900 mb-4">🤔 Not sure which policy applies to votre pays?</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/fr/visa/transit-240/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">✈️ 240-Hour Visa-Free Transit</p>
          <p class="text-sm text-gray-500">Up to 10 days in designated regions — covers 55 countries including the US.</p>
        </a>
        <a href="/fr/visa/mutual-agreement/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">🤝 Mutual Visa-Free Agreements</p>
          <p class="text-sm text-gray-500">29 countries with bilateral visa-exemption deals — stay limits vary.</p>
        </a>
        <a href="/fr/visa/apply-l-visa/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">📝 Apply for an L Tourist Visa</p>
          <p class="text-sm text-gray-500">If votre pays isn't on any visa-free list, apply for a standard tourist visa.</p>
        </a>
        <a href="/fr/cities/hainan-visa-free/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">🏝️ Hainan 30-Day Visa-Free</p>
          <p class="text-sm text-gray-500">59 countries qualify — includes US, Mexique, Philippines, and others not on the mainland list.</p>
        </a>
      </div>
    </div>

    <!-- Sources -->
    <div class="bg-gray-50 rounded-2xl p-6 not-prose mt-12">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📚 Sources</h3>
      <ul class="space-y-2">
        <li><a href="https://en.nia.gov.cn/n147418/n147463/c183390/content.html" class="text-brand-600 hover:underline text-sm" target="_blank" rel="noopener">National Immigration Administration — List of Countries Covered by Unilateral Visa Exemption</a></li>
        <li><a href="https://www.gov.cn/yaowen/liebiao/202508/content_7035244.htm" class="text-brand-600 hover:underline text-sm" target="_blank" rel="noopener">gov.cn — Which countries can visit China visa-free? A comprehensive list!</a></li>
        <li><a href="https://cs.mfa.gov.cn/wgrlh/lhqz/lhqzjjs/202510/t20251023_11739051.shtml" class="text-brand-600 hover:underline text-sm" target="_blank" rel="noopener">Ministry of Foreign Affairs — Exemption Mutuelle de Visa Agreements</a></li>
      </ul>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/fr/visa/visa-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">China Visa Types Complete Guide</p>
          <p class="text-sm text-gray-600">All visa options explained</p>
        </a>
        <a href="/fr/visa/transit-240/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">240-Hour Visa-Free Transit Explained</p>
          <p class="text-sm text-gray-600">10-day transit without a visa</p>
        </a>
      </div>
    </div>
  </article>
</Layout>