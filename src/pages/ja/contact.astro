---
import Layout from '@layouts/Layout.astro';
const title = 'お問い合わせ — China Starter Hub';
const description = 'ご質問、フィードバック、コラボレーションについてはこちらからご連絡ください。';
---

<Layout title={title} description={description} lang="ja">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">お問い合わせ</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">お問い合わせ</h1>
      <p class="text-gray-500  ">ご質問やフィードバックがございましたら、ぜひお聞かせください。</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4">
        <p class="text-sm text-gray-500  ">メール機能は準備中です。それまでは、SNSで最新情報をフォローしてください。</p>
      </div>
    </div>
  </article>
</Layout>
