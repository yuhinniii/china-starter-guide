---
import Layout from '@layouts/Layout.astro';
const title = '中国での生活 — 旅行のヒントとガイド';
const description = 'つながりを保ち、安全に過ごし、旅を最大限に楽しもう。';
---

<Layout title={title} description={description} lang="ja">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">中国での生活</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">つながりを保ち、安全に過ごし、旅を最大限に楽しもう。</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">3</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">インターネット・アプリ</p>
      </div>
      <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-cyan-800">3</p>
        <p class="text-xs font-semibold text-cyan-800 uppercase tracking-wide mt-1">健康・医療</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">3</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">安全・緊急時</p>
      </div>
      <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-yellow-800">4</p>
        <p class="text-xs font-semibold text-yellow-800 uppercase tracking-wide mt-1">文化・必需品</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">通信・インターネット</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">3記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/life/sim-card-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📶 インターネット</span>
            <p class="text-base font-bold text-gray-900 mt-1">観光客に最適なSIMカード・eSIM</p>
            <p class="text-sm text-gray-600 mt-0.5">eSIMプロバイダー、空港SIMカード、データプランを比較。</p>
          </a>
          <a href="/ja/life/vpn-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🔒 VPN</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅行に最適なVPN</p>
            <p class="text-sm text-gray-600 mt-0.5">使えるVPN、設定方法、到着前に準備すべき理由。</p>
          </a>
          <a href="/ja/life/essential-apps/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📱 アプリ</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅行に必須の10アプリ</p>
            <p class="text-sm text-gray-600 mt-0.5">支払い、交通、翻訳、情報収集。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-cyan-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-cyan-800">健康・医療</h2>
          <span class="text-xs font-medium text-cyan-800 opacity-60">3記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/life/seeing-a-doctor/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">⚕️ 医療</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国で医者にかかる</p>
            <p class="text-sm text-gray-600 mt-0.5">薬局、クリニック、病院 — 選び方。</p>
          </a>
          <a href="/ja/life/top-hospitals/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🏥 病院</span>
            <p class="text-base font-bold text-gray-900 mt-1">国際部がある主要病院</p>
            <p class="text-sm text-gray-600 mt-0.5">英語対応スタッフがいる病院を都市別に紹介。</p>
          </a>
          <a href="/ja/life/travel-insurance/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🛡️ 保険</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅行保険</p>
            <p class="text-sm text-gray-600 mt-0.5">旅行保険について知っておくべきこと。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">安全・緊急時</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">3記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/life/is-china-safe/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🛡️ 安全性</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅行は安全？</p>
            <p class="text-sm text-gray-600 mt-0.5">安全性、犯罪、注意点について正直な解説。</p>
          </a>
          <a href="/ja/life/common-scams/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">⚠️ 詐欺</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国でよくある詐欺とその回避方法</p>
            <p class="text-sm text-gray-600 mt-0.5">よくある観光客向け詐欺を見抜き、回避する方法。</p>
          </a>
          <a href="/ja/life/emergency-numbers/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🆘 緊急</span>
            <p class="text-base font-bold text-gray-900 mt-1">緊急連絡先と対応方法</p>
            <p class="text-sm text-gray-600 mt-0.5">重要な連絡先と緊急時の対応手順。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-yellow-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-yellow-800">文化・必需品</h2>
          <span class="text-xs font-medium text-yellow-800 opacity-60">3記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/life/packing-guide/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🧳 荷造り</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国に持っていくべきもの</p>
            <p class="text-sm text-gray-600 mt-0.5">季節ごとの実用的な荷造りリスト。</p>
          </a>
          <a href="/ja/life/cultural-taboos/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🙏 エチケット</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国での文化的なDo's and Don'ts</p>
            <p class="text-sm text-gray-600 mt-0.5">観光客のためのエチケットガイド。</p>
          </a>
          <a href="/ja/life/chinese-phrases/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🈶 言語</span>
            <p class="text-base font-bold text-gray-900 mt-1">観光客のための必須中国語フレーズ</p>
            <p class="text-sm text-gray-600 mt-0.5">旅行者のためのサバイバル中国語。</p>
          </a>
        </div>
      </div>
    </div>

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">次のステップ</p>
            <h3 class="text-xl font-bold text-gray-900">旅行を計画する</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">中国での日常生活の準備はOK。次は：ビザを取得し、交通手段を学びましょう。</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/ja/visa/visa-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🛂 ビザガイド
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/ja/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 交通ガイド
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>