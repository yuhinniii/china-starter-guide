---
import Layout from '@layouts/Layout.astro';
const title = '交通ガイド — 中国での移動方法';
const description = '鉄道、飛行機、地下鉄、配車サービス — 必要な情報すべて。';
---

<Layout title={title} description={description} lang="ja">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🚄 交通</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">中国の交通</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">鉄道、飛行機、地下鉄、配車サービス — 必要な情報すべて。</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-sky-50 border border-sky-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-sky-800">1</p>
        <p class="text-xs font-semibold text-sky-800 uppercase tracking-wide mt-1">高速鉄道ガイド</p>
      </div>
      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-emerald-800">1</p>
        <p class="text-xs font-semibold text-emerald-800 uppercase tracking-wide mt-1">空港アクセス</p>
      </div>
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">2</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">都市交通</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-gray-800">1</p>
        <p class="text-xs font-semibold text-gray-800 uppercase tracking-wide mt-1">配車サービスガイド</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-sky-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-sky-800">中国国内の移動</h2>
          <span class="text-xs font-medium text-sky-800 opacity-60">1記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/transport/transport-guide/" class="block bg-sky-50 border border-sky-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-sky-800">📖 概要</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国での移動方法</p>
            <p class="text-sm text-gray-600 mt-0.5">すべての交通手段の完全概要 — 鉄道、飛行機、地下鉄など。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">中国への到着</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/transport/airport-to-city/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🛬 ガイド</span>
            <p class="text-base font-bold text-gray-900 mt-1">空港から市内へ</p>
            <p class="text-sm text-gray-600 mt-0.5">主要空港の交通手段 — 北京、上海、広州など。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">都市交通</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">2記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/transport/high-speed-rail/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚄 ガイド</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国高速鉄道の予約と乗り方</p>
            <p class="text-sm text-gray-600 mt-0.5">世界最大の高速鉄道網の予約と利用方法のすべて。</p>
          </a>
          <a href="/ja/transport/metro-bus/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚇 ガイド</span>
            <p class="text-base font-bold text-gray-900 mt-1">主要都市の地下鉄・バスガイド</p>
            <p class="text-sm text-gray-600 mt-0.5">北京、上海、広州、深圳の公共交通機関を利用しよう。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">配車サービス</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/transport/didi/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">🚕 チュートリアル</span>
            <p class="text-base font-bold text-gray-900 mt-1">外国人が中国でDiDiを使う方法</p>
            <p class="text-sm text-gray-600 mt-0.5">中国版Uber、DiDiの使い方をスクリーンショット付きで解説。</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">関連ガイド</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/ja/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">中国の支払い</p>
          <p class="text-sm text-gray-500">交通機関の支払い方法</p>
        </a>
        <a href="/ja/visa/visa-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">ビザ・入国</p>
          <p class="text-sm text-gray-500">中国への入国</p>
        </a>
      </div>
    </div>
  </section>
</Layout>