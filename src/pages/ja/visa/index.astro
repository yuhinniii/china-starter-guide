---
import Layout from '@layouts/Layout.astro';
const title = '中国渡航準備 — 入国・準備ガイド';
const description = '中国旅行の前に準備すべきことすべて。';
---

<Layout title={title} description={description} lang="ja">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">✅ 準備</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">中国旅行の準備をしよう</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">中国旅行の前に準備すべきことすべて。</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">5</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">ビザ・入国</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">デジタル準備</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">4</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">搭乗前</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">ビザ・入国</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">5記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/visa/visa-guide/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📖 概要</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国ビザ種類完全ガイド</p>
            <p class="text-sm text-gray-600 mt-0.5">すべてのビザオプションを解説 — ビザ免除、トランジット、Lビザを比較。</p>
          </a>
          <a href="/ja/visa/visa-free/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📋 リスト</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国ビザ免除国リスト</p>
            <p class="text-sm text-gray-600 mt-0.5">50ヶ国が最長30日間ビザなしで入国可能。</p>
          </a>
          <a href="/ja/visa/transit-240/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">✈️ トランジット</span>
            <p class="text-base font-bold text-gray-900 mt-1">240時間トランジットビザ免除</p>
            <p class="text-sm text-gray-600 mt-0.5">55ヶ国対象 — ビザなしで最長10日間滞在可能。</p>
          </a>
          <a href="/ja/visa/mutual-agreement/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🤝 相互協定</span>
            <p class="text-base font-bold text-gray-900 mt-1">相互ビザ免除協定</p>
            <p class="text-sm text-gray-600 mt-0.5">29ヶ国が中国と相互ビザ免除協定を結んでいる。</p>
          </a>
          <a href="/ja/visa/apply-l-visa/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📝 申請</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国観光ビザの申請方法</p>
            <p class="text-sm text-gray-600 mt-0.5">ステップバイステップガイド — 書類、COVAフォーム、料金、コツ。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">デジタル準備</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/life/sim-card-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">📶 インターネット</span>
            <p class="text-base font-bold text-gray-900 mt-1">観光客に最適なSIMカード・eSIM</p>
            <p class="text-sm text-gray-600 mt-0.5">eSIMプロバイダー、空港SIMカード、データプランを比較。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">搭乗前</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">4記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/visa/customs-guide/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🛃 規制</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国の税関規制</p>
            <p class="text-sm text-gray-600 mt-0.5">免税限度額、持ち込み禁止品、申告が必要なもの。</p>
          </a>
          <a href="/ja/visa/arrival-card/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">📄 入国カード</span>
            <p class="text-base font-bold text-gray-900 mt-1">入国カードをオンラインで提出</p>
            <p class="text-sm text-gray-600 mt-0.5">搭乗前にNIA入国カードを記入 — スクリーンショット付きで順を追って解説。</p>
          </a>
          <a href="/ja/life/survival-kit/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🎒 チェックリスト</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅行サバイバルキット</p>
            <p class="text-sm text-gray-600 mt-0.5">出発前の完全チェックリスト — 書類、アプリ、持ち物。</p>
          </a>
          <a href="/ja/visa/first-time-china/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🌟 初めての方</span>
            <p class="text-base font-bold text-gray-900 mt-1">初めての中国渡航</p>
            <p class="text-sm text-gray-600 mt-0.5">完全タイムライン — ビザ、デジタル準備、荷造り、到着、最初の24時間。</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">関連ガイド</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/ja/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">中国の支払い</p>
          <p class="text-sm text-gray-500">Alipayなどを設定</p>
        </a>
        <a href="/ja/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">中国の交通</p>
          <p class="text-sm text-gray-500">移動手段</p>
        </a>
      </div>
    </div>
  </section>
</Layout>