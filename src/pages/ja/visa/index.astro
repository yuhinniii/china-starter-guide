      {code:'NO',name:'Norway',flag:'🇳🇴'},{code:'OM',name:'Oman',flag:'🇴🇲'},{code:'PK',name:'Pakistan',flag:'🇵🇰'},{code:'PW',name:'Palau',flag:'🇵🇼'},
      {code:'PA',name:'Panama',flag:'🇵🇦'},{code:'PG',name:'Papua New Guinea',flag:'🇵🇬'},{code:'PY',name:'Paraguay',flag:'🇵🇾'},{code:'PE',name:'Peru',flag:'🇵🇪'},
      {code:'PH',name:'Philippines',flag:'🇵🇭'},{code:'PL',name:'Poland',flag:'🇵🇱'},{code:'PT',name:'Portugal',flag:'🇵🇹'},{code:'QA',name:'Qatar',flag:'🇶🇦'},
      {code:'RO',name:'Romania',flag:'🇷🇴'},{code:'RU',name:'Russia',flag:'🇷🇺'},{code:'RW',name:'Rwanda',flag:'🇷🇼'},{code:'KN',name:'Saint Kitts and Nevis',flag:'🇰🇳'},
      {code:'LC',name:'Saint Lucia',flag:'🇱🇨'},{code:'VC',name:'Saint Vincent and the Grenadines',flag:'🇻🇨'},{code:'WS',name:'Samoa',flag:'🇼🇸'},{code:'SM',name:'San Marino',flag:'🇸🇲'},
      {code:'ST',name:'Sao Tome and Principe',flag:'🇸🇹'},{code:'SA',name:'Saudi Arabia',flag:'🇸🇦'},{code:'SN',name:'Senegal',flag:'🇸🇳'},{code:'RS',name:'Serbia',flag:'🇷🇸'},
      {code:'SC',name:'Seychelles',flag:'🇸🇨'},{code:'SL',name:'Sierra Leone',flag:'🇸🇱'},{code:'SG',name:'Singapore',flag:'🇸🇬'},{code:'SK',name:'Slovakia',flag:'🇸🇰'},
      {code:'SI',name:'Slovenia',flag:'🇸🇮'},{code:'SB',name:'Solomon Islands',flag:'🇸🇧'},{code:'SO',name:'Somalia',flag:'🇸🇴'},{code:'ZA',name:'South Africa',flag:'🇿🇦'},
      {code:'KR',name:'South Korea',flag:'🇰🇷'},{code:'SS',name:'South Sudan',flag:'🇸🇸'},{code:'ES',name:'Spain',flag:'🇪🇸'},{code:'LK',name:'Sri Lanka',flag:'🇱🇰'},
      {code:'SD',name:'Sudan',flag:'🇸🇩'},{code:'SR',name:'Suriname',flag:'🇸🇷'},{code:'SE',name:'Sweden',flag:'🇸🇪'},{code:'CH',name:'Switzerland',flag:'🇨🇭'},
      {code:'SY',name:'Syria',flag:'🇸🇾'},{code:'TJ',name:'Tajikistan',flag:'🇹🇯'},{code:'TH',name:'Thailand',flag:'🇹🇭'},{code:'TL',name:'Timor-Leste',flag:'🇹🇱'},
      {code:'TG',name:'Togo',flag:'🇹🇬'},{code:'TO',name:'Tonga',flag:'🇹🇴'},{code:'TT',name:'Trinidad and Tobago',flag:'🇹🇹'},{code:'TN',name:'Tunisia',flag:'🇹🇳'},
      {code:'TR',name:'Turkey',flag:'🇹🇷'},{code:'TM',name:'Turkmenistan',flag:'🇹🇲'},{code:'TV',name:'Tuvalu',flag:'🇹🇻'},{code:'UG',name:'Uganda',flag:'🇺🇬'},
      {code:'UA',name:'Ukraine',flag:'🇺🇦'},{code:'AE',name:'United Arab Emirates',flag:'🇦🇪'},{code:'GB',name:'United Kingdom',flag:'🇬🇧'},{code:'US',name:'United States',flag:'🇺🇸'},
      {code:'UY',name:'Uruguay',flag:'🇺🇾'},{code:'UZ',name:'Uzbekistan',flag:'🇺🇿'},{code:'VU',name:'Vanuatu',flag:'🇻🇺'},{code:'VE',name:'Venezuela',flag:'🇻🇪'},
      {code:'VN',name:'Vietnam',flag:'🇻🇳'},{code:'YE',name:'Yemen',flag:'🇾🇪'},{code:'ZM',name:'Zambia',flag:'🇿🇲'},{code:'ZW',name:'Zimbabwe',flag:'🇿🇼'}
    ];

    let state = { country: null, purpose: null };
    const countryInput = document.getElementById('country-input');
    const countryDropdown = document.getElementById('country-dropdown');
    const countrySelected = document.getElementById('country-selected');
    const stepPurpose = document.getElementById('step-purpose');
    const resultDiv = document.getElementById('visa-result');
    const resetBtn = document.getElementById('reset-checker');
    const purposeBtns = document.querySelectorAll('.purpose-btn');

    function getVisaStatus(code) {
      if (visaFree30.includes(code)) return 'visa-free-30';
      if (mutualFree.includes(code)) return 'mutual-free';
      if (transit240.includes(code)) return 'transit';
      return 'need-visa';
    }

    countryInput.addEventListener('input', function() {
      renderDropdown(this.value.toLowerCase().trim());
    });
    countryInput.addEventListener('focus', function() {
      renderDropdown(this.value);
    });

    function renderDropdown(q) {
      const matches = q ? countryData.filter(c => c.name.toLowerCase().includes(q) || c.code.toLowerCase() === q) : countryData;
      if (matches.length === 0) { countryDropdown.classList.add('hidden'); return; }
      countryDropdown.innerHTML = matches.map(c =>
        '<div class="px-4 py-2.5 hover:bg-brand-50 cursor-pointer flex items-center gap-3 text-base border-b border-gray-100 last:border-0 ' + (state.country === c.code ? 'bg-brand-50 font-semibold' : '') + '" data-code="' + c.code + '"><span>' + c.flag + '</span><span>' + c.name + '</span></div>'
      ).join('');
      countryDropdown.classList.remove('hidden');
    }

    countryDropdown.addEventListener('click', function(e) {
      var item = e.target.closest('[data-code]');
      if (item) selectCountry(item.dataset.code);
    });
    document.querySelectorAll('.quick-country').forEach(function(btn) {
      btn.addEventListener('click', function() { selectCountry(this.dataset.code); });
    });

    function selectCountry(code) {
      var c = countryData.find(function(x) { return x.code === code; });
      if (!c) return;
      state.country = code;
      countryInput.value = '';
      countryDropdown.classList.add('hidden');
      countrySelected.classList.remove('hidden');
      countrySelected.innerHTML = c.flag + ' <span class="font-semibold">' + c.name + '</span>';
      document.querySelectorAll('.quick-country').forEach(function(btn) {
        if (btn.dataset.code === code) { btn.classList.add('bg-brand-500','text-white','border-brand-500'); btn.classList.remove('bg-white','border-gray-200'); }
        else { btn.classList.remove('bg-brand-500','text-white','border-brand-500'); btn.classList.add('bg-white','border-gray-200'); }
      });
      stepPurpose.classList.remove('hidden');
      resultDiv.classList.add('hidden');
      state.purpose = null;
      purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
    }

    purposeBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        state.purpose = this.dataset.purpose;
        purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
        this.classList.remove('bg-white','text-gray-700','border-gray-200');
        this.classList.add('bg-brand-500','text-white','border-brand-500');
        resetBtn.classList.remove('hidden');
        showResult();
      });
    });

    function detailRow(label, value) {
      return '<div class="flex gap-x-3 text-sm leading-relaxed mb-2 pb-2 border-b border-gray-100"><span class="w-28 shrink-0 text-right font-medium text-gray-500">' + label + '</span><span class="text-gray-700">' + value + '</span></div>';
    }

    function showResult() {
      var country = countryData.find(function(c) { return c.code === state.country; });
      var name = country ? country.name : 'あなたの国';
      var status = getVisaStatus(state.country);
      var purpose = state.purpose;

      if (purpose === 'work') {
        resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">ビザ必要</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — 就労にはZビザが必要</h3><p class="text-sm text-gray-600 leading-relaxed">中国での労働には、ビザや到着方法に関わらず、必ず事前承認されたZビザが必要です。</p></div><div class="bg-white px-5 py-4">' + detailRow('ビザ種類', 'Zビザ（就労許可）') + detailRow('スポンサー', '雇用主が代理で申請') + detailRow('所要期間', '通常4〜8週間') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">公式NIAサイトを開く →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/ja/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">中国ビザの種類 →</a></div></div></div>';
      } else if (purpose === 'study') {
        resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">ビザ必要</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — 留学にはXビザが必要</h3><p class="text-sm text-gray-600 leading-relaxed">中国での留学には、ビザや到着方法に関わらず、必ず事前承認されたXビザが必要です。</p></div><div class="bg-white px-5 py-4">' + detailRow('ビザ種類', 'X1（180日超）またはX2（180日以下）') + detailRow('必要書類', 'JW202フォーム、入学許可書、健康診断') + detailRow('所要期間', '5〜10営業日') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">公式NIAサイトを開く →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/ja/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">中国ビザの種類 →</a></div></div></div>';
      } else if (purpose === 'tourism-business') {
        if (status === 'visa-free-30' || status === 'mutual-free') {
          var policyText = status === 'visa-free-30' ? '30日間ビザなし入国' : '二国間相互協定';
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-green-500 overflow-hidden"><div class="bg-green-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-green-700 uppercase mb-1.5">ビザ不要</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — 30日間、ビザ不要</h3><p class="text-sm text-gray-600 leading-relaxed">ビザなしで中国に入国でき、最大30日間滞在できます。</p></div><div class="bg-white px-5 py-4">' + detailRow('対象方針', policyText) + detailRow('有効期限', '2026年12月31日まで') + detailRow('入国方法', 'どの港でも — 空路、香港陸路国境、または海路') + detailRow('滞在目的', '観光、ビジネス、家族訪問、トランジット') + detailRow('不可', '就労、留学、ジャーナリズム') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-green-600 hover:underline">公式NIAサイトを開く →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/ja/visa/visa-free/" class="text-sm font-medium text-brand-600 hover:underline">ビザなし対象国の一覧 →</a><a href="/ja/visa/first-time-china/" class="text-sm font-medium text-brand-600 hover:underline">初めての中国ガイド →</a></div></div></div>';
        } else if (transit240.includes(state.country)) {
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-gray-400 overflow-hidden"><div class="bg-gray-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-gray-500 uppercase mb-1.5">ビザの選択肢</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — Lビザまたは240時間トランジット</h3><p class="text-sm text-gray-600 leading-relaxed">2つの選択肢があります。旅程に合うものを選んでください。</p></div><div class="bg-white px-5 py-4 space-y-6"><div class="rounded-lg border-l-4 border-orange-400 overflow-hidden"><div class="bg-orange-50 px-3 py-2"><p class="text-base font-semibold text-orange-700 mb-0.5">📄 選択肢A：ビザを申請</p><p class="text-sm text-gray-600 leading-relaxed">「' + name + '」と中国間の往復直行便では、渡航前に在中国大使館で申請します。</p></div><div class="bg-white px-3 py-2">' + detailRow('ビザ種類', '通常Lビザ（観光）またはMビザ（商用）') + detailRow('必要書類', 'パスポート、写真、旅程表、財力証明、公式フォーム') + detailRow('所要期間', '4〜10 営業日') + '<a href="/ja/visa/apply-l-visa/" class="text-base text-orange-600 font-medium hover:underline">Lビザの申請方法 →</a></div></div><div class="rounded-lg border-l-4 border-blue-400 overflow-hidden"><div class="bg-blue-50 px-3 py-2"><p class="text-base font-semibold text-blue-700 mb-0.5">🔄 選択肢B：240時間トランジット（ビザ不要）</p><p class="text-sm text-gray-600 leading-relaxed">香港・マカオ・他国を含む旅程では、ビザなしで最大10日間滞在可能です。</p></div><div class="bg-white px-3 py-2">' + detailRow('条件', '第三国または地域への確定済みの乗続チケット') + detailRow('最大滞在期間', '240 時間（10 日間）') + '<a href="/ja/visa/transit-240/" class="text-base text-blue-600 font-medium hover:underline">240時間トランジットの詳細 →</a></div></div><div class="pt-2 border-t border-gray-100"><a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-gray-500 hover:text-gray-700">公式NIAサイトを開く →</a></div></div></div>';
        } else {
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">ビザ必要</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — 渡航前に申請</h3><p class="text-sm text-gray-600 leading-relaxed">' + name + 'のパスポート保持者は、到着前に中国ビザの申請が必要です。</p></div><div class="bg-white px-5 py-4">' + detailRow('ビザ種類', '通常Lビザ（観光）またはMビザ（商用）') + detailRow('申請先', '母国の中国大使館または領事館') + detailRow('必要書類', 'パスポート、写真、旅程表、財力証明、公式フォーム') + detailRow('所要期間', '通常4〜10営業日') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">公式NIAサイトを開く →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/ja/visa/apply-l-visa/" class="text-sm font-medium text-brand-600 hover:underline">Lビザ申請ガイド →</a><a href="/ja/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">中国ビザ種類の概要 →</a></div></div></div>';
        }
      }
      resultDiv.classList.remove('hidden');
    }

    resetBtn.addEventListener('click', function() {
      state = { country: null, purpose: null };
      countryInput.value = '';
      countryDropdown.classList.add('hidden');
      countrySelected.classList.add('hidden');
      stepPurpose.classList.add('hidden');
      resultDiv.classList.add('hidden');
      resetBtn.classList.add('hidden');
      purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('#step-country')) countryDropdown.classList.add('hidden');
    });
  </script>

</Layout>