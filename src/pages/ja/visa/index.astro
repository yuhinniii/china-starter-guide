---
import Layout from '@layouts/Layout.astro';
const title = '中国渡航準備 — 入国・準備ガイド';
const description = '中国旅行の前に準備すべきことすべて。';
---

<Layout title={title} description={description} lang="ja">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">中国旅行の準備をしよう</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">中国旅行の前に準備すべきことすべて。</p>
    </header>

    <!-- ビザチェッカー -->
    <div id="visa-checker" class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 mb-12 not-prose shadow-sm">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-2xl">🛂</span>
        <div>
          <h2 class="text-lg font-bold text-gray-900">ビザチェッカー</h2>
          <p class="text-sm text-gray-500">ビザが必要かどうかわからない？3つの質問に答えればお知らせします。</p>
        </div>
      </div>

      <!-- Step 1: Country -->
      <div id="step-country" class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-brand-500 text-white text-xs font-bold flex items-center justify-center">1</span>
          <span class="text-base font-semibold text-gray-700">あなたのパスポート</span>
        </div>
        <div class="flex flex-wrap gap-2 mb-3 sm:justify-between">
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="US"><span class="mr-1">🇺🇸</span>United States</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="GB"><span class="mr-1">🇬🇧</span>United Kingdom</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="CA"><span class="mr-1">🇨🇦</span>Canada</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="AU"><span class="mr-1">🇦🇺</span>Australia</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="SG"><span class="mr-1">🇸🇬</span>Singapore</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="TH"><span class="mr-1">🇹🇭</span>Thailand</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="KR"><span class="mr-1">🇰🇷</span>South Korea</button>
        </div>
        <div class="relative">
          <input id="country-input" type="text" placeholder="または国を検索..." class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-base">
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          <div id="country-dropdown" class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-xl shadow-lg max-h-60 overflow-y-auto"></div>
        </div>
        <p id="country-selected" class="hidden mt-2 text-base text-green-700 font-medium"></p>
      </div>

      <!-- Step 2: Purpose -->
      <div id="step-purpose" class="hidden mb-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-brand-500 text-white text-xs font-bold flex items-center justify-center">2</span>
          <span class="text-base font-semibold text-gray-700">渡航の目的は何ですか？</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <button data-purpose="tourism-business" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">🏖️ 観光 / ビジネス / 家族訪問</div>
            <div class="text-xs text-gray-500 mt-0.5">一般的な訪問</div>
          </button>
          <button data-purpose="work" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">💼 就労</div>
            <div class="text-xs text-gray-500 mt-0.5">雇用主のスポンサーシップが必要</div>
          </button>
          <button data-purpose="study" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">📚 留学</div>
            <div class="text-xs text-gray-500 mt-0.5">大学の入学許可が必要</div>
          </button>
        </div>
      </div>

      <!-- Result -->
      <div id="visa-result" class="hidden"></div>

      <!-- Reset -->
      <button id="reset-checker" class="hidden mt-4 text-base text-gray-400 hover:text-gray-600 underline cursor-pointer">最初からやり直す</button>

      <p class="text-xs text-gray-400 mt-4">公式NIA方針に基づく。最終更新：2026年7月。<span class="underline">予約前に大使館でご確認ください。</span></p>
    </div>

    

<!-- Quick Stats -->
    <div class="grid grid-cols-2 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">5</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">ビザ・入国</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">4</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">搭乗前</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">ビザ・入国</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">5記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/visa/visa-guide/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📖 概要</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国ビザ種類完全ガイド</p>
            <p class="text-sm text-gray-600 mt-0.5">すべてのビザオプションを解説 — ビザ免除、トランジット、Lビザを比較。</p>
          </a>
          <a href="/ja/visa/visa-free/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📋 リスト</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国ビザ免除国リスト</p>
            <p class="text-sm text-gray-600 mt-0.5">50ヶ国が最長30日間ビザなしで入国可能。</p>
          </a>
          <a href="/ja/visa/transit-240/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">✈️ トランジット</span>
            <p class="text-base font-bold text-gray-900 mt-1">240時間トランジットビザ免除</p>
            <p class="text-sm text-gray-600 mt-0.5">55ヶ国対象 — ビザなしで最長10日間滞在可能。</p>
          </a>
          <a href="/ja/visa/mutual-agreement/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🤝 相互協定</span>
            <p class="text-base font-bold text-gray-900 mt-1">相互ビザ免除協定</p>
            <p class="text-sm text-gray-600 mt-0.5">29ヶ国が中国と相互ビザ免除協定を結んでいる。</p>
          </a>
          <a href="/ja/visa/apply-l-visa/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📝 申請</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国観光ビザの申請方法</p>
            <p class="text-sm text-gray-600 mt-0.5">ステップバイステップガイド — 書類、COVAフォーム、料金、コツ。</p>
          </a>
        </div>
      </div>
      
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">搭乗前</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">3記事</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ja/visa/customs-guide/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🛃 規制</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国の税関規制</p>
            <p class="text-sm text-gray-600 mt-0.5">免税限度額、持ち込み禁止品、申告が必要なもの。</p>
          </a>
          <a href="/ja/visa/arrival-card/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">📄 入国カード</span>
            <p class="text-base font-bold text-gray-900 mt-1">入国カードをオンラインで提出</p>
            <p class="text-sm text-gray-600 mt-0.5">搭乗前にNIA入国カードを記入 — スクリーンショット付きで順を追って解説。</p>
          </a>
          <a href="/ja/life/survival-kit/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🎒 チェックリスト</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅行サバイバルキット</p>
            <p class="text-sm text-gray-600 mt-0.5">出発前の完全チェックリスト — 書類、アプリ、持ち物。</p>
          </a>
          <a href="/ja/visa/first-time-china/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🌟 初めての方</span>
            <p class="text-base font-bold text-gray-900 mt-1">初めての中国渡航</p>
            <p class="text-sm text-gray-600 mt-0.5">完全タイムライン — ビザ、デジタル準備、荷造り、到着、最初の24時間。</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">次のステップ</p>
            <h3 class="text-xl font-bold text-gray-900">決済の準備と移動手段</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">ビザの準備は完了しました。次はAlipayの設定と、中国の交通システムの利用方法を学びましょう。</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/ja/payment/payment-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              💳 決済ガイド
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/ja/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 交通ガイド
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
</section>

