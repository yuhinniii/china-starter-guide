---
import Layout from '@layouts/Layout.astro';
const title = '문의 — China Starter Hub';
const description = '질문, 피드백 또는 협업을 위해 저희에게 연락하세요.';
---

<Layout title={title} description={description} lang="ko">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">문의</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">문의하기</h1>
      <p class="text-gray-500  ">질문이나 피드백이 있으신가요? 여러분의 의견을 듣고 싶습니다.</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4">
        <p class="text-sm text-gray-500  "">이메일 기능은 곧 제공될 예정입니다. 지금은 소셜 미디어에서 업데이트를 팔로우해 주세요.</p>
      </div>
    </div>
  </article>
</Layout>
