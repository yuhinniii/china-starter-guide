---
import Layout from '@layouts/Layout.astro';
const title = '중국 여행 준비 — 입국 & 설정 가이드';
const description = '중국 여행 전 준비해야 할 모든 것.';
---

<Layout title={title} description={description} lang="ko">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">중국 여행 준비하기</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">중국 여행 전 준비해야 할 모든 것.</p>
    </header>

    <!-- 비자 체커 -->
    <div id="visa-checker" class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 mb-12 not-prose shadow-sm">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-2xl">🛂</span>
        <div>
          <h2 class="text-lg font-bold text-gray-900">비자 체커</h2>
          <p class="text-sm text-gray-500">비자가 필요한지 잘 모르시나요? 질문 3개에 답하면 알려드립니다.</p>
        </div>
      </div>

      <!-- Step 1: Country -->
      <div id="step-country" class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-brand-500 text-white text-xs font-bold flex items-center justify-center">1</span>
          <span class="text-base font-semibold text-gray-700">여권</span>
        </div>
        <div class="flex flex-wrap gap-2 mb-3 sm:justify-between">
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="US"><span class="mr-1">🇺🇸</span>United States</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="GB"><span class="mr-1">🇬🇧</span>United Kingdom</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="CA"><span class="mr-1">🇨🇦</span>Canada</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="AU"><span class="mr-1">🇦🇺</span>Australia</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="SG"><span class="mr-1">🇸🇬</span>Singapore</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="TH"><span class="mr-1">🇹🇭</span>Thailand</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="KR"><span class="mr-1">🇰🇷</span>South Korea</button>
        </div>
        <div class="relative">
          <input id="country-input" type="text" placeholder="또는 국가 검색..." class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-base">
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          <div id="country-dropdown" class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-xl shadow-lg max-h-60 overflow-y-auto"></div>
        </div>
        <p id="country-selected" class="hidden mt-2 text-base text-green-700 font-medium"></p>
      </div>

      <!-- Step 2: Purpose -->
      <div id="step-purpose" class="hidden mb-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-brand-500 text-white text-xs font-bold flex items-center justify-center">2</span>
          <span class="text-base font-semibold text-gray-700">방문 목적은 무엇인가요?</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <button data-purpose="tourism-business" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">🏖️ 관광 / 출장 / 가족</div>
            <div class="text-xs text-gray-500 mt-0.5">일반 방문</div>
          </button>
          <button data-purpose="work" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">💼 취업</div>
            <div class="text-xs text-gray-500 mt-0.5">고용주 스폰서 필요</div>
          </button>
          <button data-purpose="study" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">📚 유학</div>
            <div class="text-xs text-gray-500 mt-0.5">대학 입학 필요</div>
          </button>
        </div>
      </div>

      <!-- Result -->
      <div id="visa-result" class="hidden"></div>

      <!-- Reset -->
      <button id="reset-checker" class="hidden mt-4 text-base text-gray-400 hover:text-gray-600 underline cursor-pointer">다시 시작</button>

      <p class="text-xs text-gray-400 mt-4">NIA 공식 정책 기준. 최종 업데이트: 2026년 7월. <span class="underline">예약 전 대사관에 확인하세요.</span></p>
    </div>

    

<!-- Quick Stats -->
    <div class="grid grid-cols-2 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">5</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">비자 및 입국</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">4</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">출국 전</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">비자 및 입국</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">5개 문서</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ko/visa/visa-guide/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📖 개요</span>
            <p class="text-base font-bold text-gray-900 mt-1">중국 비자 종류 완벽 가이드</p>
            <p class="text-sm text-gray-600 mt-0.5">모든 비자 옵션 설명 — 무비자, 환승, L비자 비교.</p>
          </a>
          <a href="/ko/visa/visa-free/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📋 목록</span>
            <p class="text-base font-bold text-gray-900 mt-1">중국 무비자 국가 목록</p>
            <p class="text-sm text-gray-600 mt-0.5">50개국이 최대 30일간 비자 없이 입국 가능합니다.</p>
          </a>
          <a href="/ko/visa/transit-240/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">✈️ 환승</span>
            <p class="text-base font-bold text-gray-900 mt-1">240시간 무비자 환승</p>
            <p class="text-sm text-gray-600 mt-0.5">55개국 대상 — 비자 없이 최대 10일 체류 가능.</p>
          </a>
          <a href="/ko/visa/mutual-agreement/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🤝 상호 협정</span>
            <p class="text-base font-bold text-gray-900 mt-1">상호 무비자 협정</p>
            <p class="text-sm text-gray-600 mt-0.5">29개국이 중국과 상호 비자 면제 협정을 체결했습니다.</p>
          </a>
          <a href="/ko/visa/apply-l-visa/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📝 신청</span>
            <p class="text-base font-bold text-gray-900 mt-1">중국 관광 비자 신청 방법</p>
            <p class="text-sm text-gray-600 mt-0.5">단계별 가이드 — 서류, COVA 신청서, 수수료, 팁.</p>
          </a>
        </div>
      </div>
      
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">출국 전</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">4개 문서</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ko/visa/customs-guide/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🛃 규정</span>
            <p class="text-base font-bold text-gray-900 mt-1">중국 세관 규정</p>
            <p class="text-sm text-gray-600 mt-0.5">면세 한도, 금지 품목, 신고해야 할 물품.</p>
          </a>
          <a href="/ko/visa/arrival-card/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">📄 입국 카드</span>
            <p class="text-base font-bold text-gray-900 mt-1">온라인 입국 카드 제출하기</p>
            <p class="text-sm text-gray-600 mt-0.5">출국 전 NIA 입국 카드 작성 방법 — 스크린샷과 함께 단계별 안내.</p>
          </a>
          <a href="/ko/visa/first-time-china/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🌟 첫 방문</span>
            <p class="text-base font-bold text-gray-900 mt-1">첫 중국 방문</p>
            <p class="text-sm text-gray-600 mt-0.5">전체 타임라인 — 비자, 디지털 설정, 준비물, 도착, 첫 24시간.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- 다음 단계 -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">다음 단계</p>
            <h3 class="text-xl font-bold text-gray-900">결제를 설정하고 이동 방법을 배우세요</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">비자가 해결되었습니다. 이제 Alipay를 설정하고 중국 교통편 이용 방법을 알아보세요.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/ko/payment/payment-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              💳 결제 가이드
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/ko/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 교통 가이드
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
</section>

<script is:inline>
    const visaFree30 = ['BN','FR','DE','IT','ES','NL','CH','IE','HU','AT','BE','LU','NZ','AU','PL','PT','GR','CY','SI','SK','NO','FI','DK','IS','AD','MC','LI','KR','BG','RO','HR','ME','MK','MT','EE','LV','JP','BR','AR','CL','PE','UY','SA','OM','KW','BH','CA','RU','GB','SE'];
