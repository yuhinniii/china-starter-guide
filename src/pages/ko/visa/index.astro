      {code:'MA',name:'Morocco',flag:'🇲🇦'},{code:'MZ',name:'Mozambique',flag:'🇲🇿'},{code:'MM',name:'Myanmar',flag:'🇲🇲'},{code:'NA',name:'Namibia',flag:'🇳🇦'},
      {code:'NR',name:'Nauru',flag:'🇳🇷'},{code:'NP',name:'Nepal',flag:'🇳🇵'},{code:'NL',name:'Netherlands',flag:'🇳🇱'},{code:'NZ',name:'New Zealand',flag:'🇳🇿'},
      {code:'NI',name:'Nicaragua',flag:'🇳🇮'},{code:'NE',name:'Niger',flag:'🇳🇪'},{code:'NG',name:'Nigeria',flag:'🇳🇬'},{code:'MK',name:'North Macedonia',flag:'🇲🇰'},
      {code:'NO',name:'Norway',flag:'🇳🇴'},{code:'OM',name:'Oman',flag:'🇴🇲'},{code:'PK',name:'Pakistan',flag:'🇵🇰'},{code:'PW',name:'Palau',flag:'🇵🇼'},
      {code:'PA',name:'Panama',flag:'🇵🇦'},{code:'PG',name:'Papua New Guinea',flag:'🇵🇬'},{code:'PY',name:'Paraguay',flag:'🇵🇾'},{code:'PE',name:'Peru',flag:'🇵🇪'},
      {code:'PH',name:'Philippines',flag:'🇵🇭'},{code:'PL',name:'Poland',flag:'🇵🇱'},{code:'PT',name:'Portugal',flag:'🇵🇹'},{code:'QA',name:'Qatar',flag:'🇶🇦'},
      {code:'RO',name:'Romania',flag:'🇷🇴'},{code:'RU',name:'Russia',flag:'🇷🇺'},{code:'RW',name:'Rwanda',flag:'🇷🇼'},{code:'KN',name:'Saint Kitts and Nevis',flag:'🇰🇳'},
      {code:'LC',name:'Saint Lucia',flag:'🇱🇨'},{code:'VC',name:'Saint Vincent and the Grenadines',flag:'🇻🇨'},{code:'WS',name:'Samoa',flag:'🇼🇸'},{code:'SM',name:'San Marino',flag:'🇸🇲'},
      {code:'ST',name:'Sao Tome and Principe',flag:'🇸🇹'},{code:'SA',name:'Saudi Arabia',flag:'🇸🇦'},{code:'SN',name:'Senegal',flag:'🇸🇳'},{code:'RS',name:'Serbia',flag:'🇷🇸'},
      {code:'SC',name:'Seychelles',flag:'🇸🇨'},{code:'SL',name:'Sierra Leone',flag:'🇸🇱'},{code:'SG',name:'Singapore',flag:'🇸🇬'},{code:'SK',name:'Slovakia',flag:'🇸🇰'},
      {code:'SI',name:'Slovenia',flag:'🇸🇮'},{code:'SB',name:'Solomon Islands',flag:'🇸🇧'},{code:'SO',name:'Somalia',flag:'🇸🇴'},{code:'ZA',name:'South Africa',flag:'🇿🇦'},
      {code:'KR',name:'South Korea',flag:'🇰🇷'},{code:'SS',name:'South Sudan',flag:'🇸🇸'},{code:'ES',name:'Spain',flag:'🇪🇸'},{code:'LK',name:'Sri Lanka',flag:'🇱🇰'},
      {code:'SD',name:'Sudan',flag:'🇸🇩'},{code:'SR',name:'Suriname',flag:'🇸🇷'},{code:'SE',name:'Sweden',flag:'🇸🇪'},{code:'CH',name:'Switzerland',flag:'🇨🇭'},
      {code:'SY',name:'Syria',flag:'🇸🇾'},{code:'TJ',name:'Tajikistan',flag:'🇹🇯'},{code:'TH',name:'Thailand',flag:'🇹🇭'},{code:'TL',name:'Timor-Leste',flag:'🇹🇱'},
      {code:'TG',name:'Togo',flag:'🇹🇬'},{code:'TO',name:'Tonga',flag:'🇹🇴'},{code:'TT',name:'Trinidad and Tobago',flag:'🇹🇹'},{code:'TN',name:'Tunisia',flag:'🇹🇳'},
      {code:'TR',name:'Turkey',flag:'🇹🇷'},{code:'TM',name:'Turkmenistan',flag:'🇹🇲'},{code:'TV',name:'Tuvalu',flag:'🇹🇻'},{code:'UG',name:'Uganda',flag:'🇺🇬'},
      {code:'UA',name:'Ukraine',flag:'🇺🇦'},{code:'AE',name:'United Arab Emirates',flag:'🇦🇪'},{code:'GB',name:'United Kingdom',flag:'🇬🇧'},{code:'US',name:'United States',flag:'🇺🇸'},
      {code:'UY',name:'Uruguay',flag:'🇺🇾'},{code:'UZ',name:'Uzbekistan',flag:'🇺🇿'},{code:'VU',name:'Vanuatu',flag:'🇻🇺'},{code:'VE',name:'Venezuela',flag:'🇻🇪'},
      {code:'VN',name:'Vietnam',flag:'🇻🇳'},{code:'YE',name:'Yemen',flag:'🇾🇪'},{code:'ZM',name:'Zambia',flag:'🇿🇲'},{code:'ZW',name:'Zimbabwe',flag:'🇿🇼'}
    ];

    let state = { country: null, purpose: null };
    const countryInput = document.getElementById('country-input');
    const countryDropdown = document.getElementById('country-dropdown');
    const countrySelected = document.getElementById('country-selected');
    const stepPurpose = document.getElementById('step-purpose');
    const resultDiv = document.getElementById('visa-result');
    const resetBtn = document.getElementById('reset-checker');
    const purposeBtns = document.querySelectorAll('.purpose-btn');

    function getVisaStatus(code) {
      if (visaFree30.includes(code)) return 'visa-free-30';
      if (mutualFree.includes(code)) return 'mutual-free';
      if (transit240.includes(code)) return 'transit';
      return 'need-visa';
    }

    countryInput.addEventListener('input', function() {
      renderDropdown(this.value.toLowerCase().trim());
    });
    countryInput.addEventListener('focus', function() {
      renderDropdown(this.value);
    });

    function renderDropdown(q) {
      const matches = q ? countryData.filter(c => c.name.toLowerCase().includes(q) || c.code.toLowerCase() === q) : countryData;
      if (matches.length === 0) { countryDropdown.classList.add('hidden'); return; }
      countryDropdown.innerHTML = matches.map(c =>
        '<div class="px-4 py-2.5 hover:bg-brand-50 cursor-pointer flex items-center gap-3 text-base border-b border-gray-100 last:border-0 ' + (state.country === c.code ? 'bg-brand-50 font-semibold' : '') + '" data-code="' + c.code + '"><span>' + c.flag + '</span><span>' + c.name + '</span></div>'
      ).join('');
      countryDropdown.classList.remove('hidden');
    }

    countryDropdown.addEventListener('click', function(e) {
      var item = e.target.closest('[data-code]');
      if (item) selectCountry(item.dataset.code);
    });
    document.querySelectorAll('.quick-country').forEach(function(btn) {
      btn.addEventListener('click', function() { selectCountry(this.dataset.code); });
    });

    function selectCountry(code) {
      var c = countryData.find(function(x) { return x.code === code; });
      if (!c) return;
      state.country = code;
      countryInput.value = '';
      countryDropdown.classList.add('hidden');
      countrySelected.classList.remove('hidden');
      countrySelected.innerHTML = c.flag + ' <span class="font-semibold">' + c.name + '</span>';
      document.querySelectorAll('.quick-country').forEach(function(btn) {
        if (btn.dataset.code === code) { btn.classList.add('bg-brand-500','text-white','border-brand-500'); btn.classList.remove('bg-white','border-gray-200'); }
        else { btn.classList.remove('bg-brand-500','text-white','border-brand-500'); btn.classList.add('bg-white','border-gray-200'); }
      });
      stepPurpose.classList.remove('hidden');
      resultDiv.classList.add('hidden');
      state.purpose = null;
      purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
    }

    purposeBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        state.purpose = this.dataset.purpose;
        purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
        this.classList.remove('bg-white','text-gray-700','border-gray-200');
        this.classList.add('bg-brand-500','text-white','border-brand-500');
        resetBtn.classList.remove('hidden');
        showResult();
      });
    });

    function detailRow(label, value) {
      return '<div class="flex gap-x-3 text-sm leading-relaxed mb-2 pb-2 border-b border-gray-100"><span class="w-28 shrink-0 text-right font-medium text-gray-500">' + label + '</span><span class="text-gray-700">' + value + '</span></div>';
    }

    function showResult() {
      var country = countryData.find(function(c) { return c.code === state.country; });
      var name = country ? country.name : '귀하의 국가';
      var status = getVisaStatus(state.country);
      var purpose = state.purpose;

      if (purpose === 'work') {
        resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">비자 필요</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — 취업은 Z비자 필요</h3><p class="text-sm text-gray-600 leading-relaxed">중국에서 일하려면 여권이나 입국 방식과 관계없이 항상 사전 승인된 Z 비자가 필요합니다.</p></div><div class="bg-white px-5 py-4">' + detailRow('비자 유형', 'Z비자 (취업 허가)') + detailRow('스폰서', '고용주가 대신 신청') + detailRow('처리 기간', '보통 4-8주') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">NIA 공식 사이트 →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/ko/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">중국 비자 유형 →</a></div></div></div>';
      } else if (purpose === 'study') {
        resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">비자 필요</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — 유학은 X비자 필요</h3><p class="text-sm text-gray-600 leading-relaxed">중국에서 유학하려면 여권이나 입국 방식과 관계없이 항상 사전 승인된 X 비자가 필요합니다.</p></div><div class="bg-white px-5 py-4">' + detailRow('비자 유형', 'X1 (180일 초과) 또는 X2 (180일 이하)') + detailRow('서류', 'JW202 양식, 입학 허가서, 건강검진') + detailRow('처리 기간', '5-10 영업일') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">NIA 공식 사이트 →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/ko/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">중국 비자 유형 →</a></div></div></div>';
      } else if (purpose === 'tourism-business') {
        if (status === 'visa-free-30' || status === 'mutual-free') {
          var policyText = status === 'visa-free-30' ? '30일 무비자 입국' : '양자 상호 협정';
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-green-500 overflow-hidden"><div class="bg-green-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-green-700 uppercase mb-1.5">무비자</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — 30일, 무비자</h3><p class="text-sm text-gray-600 leading-relaxed">비자 없이 최대 30일까지 중국에 입국할 수 있습니다.</p></div><div class="bg-white px-5 py-4">' + detailRow('정책', policyText) + detailRow('유효 기간', '2026년 12월 31일까지') + detailRow('입국', '모든 항구 — 항공, 홍콩 육로 국경 또는 해상') + detailRow('허용 용도', '관광, 출장, 가족 방문, 환승') + detailRow('불허', '취업, 유학, 언론') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-green-600 hover:underline">NIA 공식 사이트 →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/ko/visa/visa-free/" class="text-sm font-medium text-brand-600 hover:underline">무비자 전체 목록 →</a><a href="/ko/visa/first-time-china/" class="text-sm font-medium text-brand-600 hover:underline">중국 첫 방문 →</a></div></div></div>';
        } else if (transit240.includes(state.country)) {
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-gray-400 overflow-hidden"><div class="bg-gray-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-gray-500 uppercase mb-1.5">비자 옵션</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — L비자 또는 240시간 환승</h3><p class="text-sm text-gray-600 leading-relaxed">두 가지 옵션이 있습니다. 여행 일정에 맞는 것을 선택하세요.</p></div><div class="bg-white px-5 py-4 space-y-6"><div class="rounded-lg border-l-4 border-orange-400 overflow-hidden"><div class="bg-orange-50 px-3 py-2"><p class="text-base font-semibold text-orange-700 mb-0.5">📄 옵션 A: 비자 신청</p><p class="text-sm text-gray-600 leading-relaxed">직항 왕복 여행의 경우 ' + name + '과 중국 사이. 여행 전 중국 대사관에서 신청하세요.</p></div><div class="bg-white px-3 py-2">' + detailRow('비자 유형', '보통 L비자 (관광) 또는 M비자 (출장)') + detailRow('서류', '여권, 사진, 일정, 재정 증명, 공식 양식') + detailRow('처리 기간', '4~10 영업일') + '<a href="/ko/visa/apply-l-visa/" class="text-base text-orange-600 font-medium hover:underline">L비자 신청 방법 →</a></div></div><div class="rounded-lg border-l-4 border-blue-400 overflow-hidden"><div class="bg-blue-50 px-3 py-2"><p class="text-base font-semibold text-blue-700 mb-0.5">🔄 옵션 B: 240시간 환승 (비자 불필요)</p><p class="text-sm text-gray-600 leading-relaxed">홍콩, 마카오 또는 다른 국가를 포함하는 여행의 경우. 최대 10일간 무비자 체류.</p></div><div class="bg-white px-3 py-2">' + detailRow('조건', '제3국 또는 지역으로의 확정된 환승 항공권') + detailRow('최대 체류', '240시간 (10일)') + '<a href="/ko/visa/transit-240/" class="text-base text-blue-600 font-medium hover:underline">240시간 환승 상세 →</a></div></div><div class="pt-2 border-t border-gray-100"><a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-gray-500 hover:text-gray-700">NIA 공식 사이트 →</a></div></div></div>';
        } else {
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">비자 필요</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — 여행 전 신청</h3><p class="text-sm text-gray-600 leading-relaxed">' + name + ' 여권 소지자는 도착 전에 중국 비자를 신청해야 합니다.</p></div><div class="bg-white px-5 py-4">' + detailRow('비자 유형', '보통 L비자 (관광) 또는 M비자 (출장)') + detailRow('신청 장소', '본국의 중국 대사관 또는 영사관') + detailRow('서류', '여권, 사진, 일정, 재정 증명, 공식 양식') + detailRow('처리 기간', '보통 4-10 영업일') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">NIA 공식 사이트 →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/ko/visa/apply-l-visa/" class="text-sm font-medium text-brand-600 hover:underline">L비자 신청 가이드 →</a><a href="/ko/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">중국 비자 유형 개요 →</a></div></div></div>';
        }
      }
      resultDiv.classList.remove('hidden');
    }

    resetBtn.addEventListener('click', function() {
      state = { country: null, purpose: null };
      countryInput.value = '';
      countryDropdown.classList.add('hidden');
      countrySelected.classList.add('hidden');
      stepPurpose.classList.add('hidden');
      resultDiv.classList.add('hidden');
      resetBtn.classList.add('hidden');
      purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('#step-country')) countryDropdown.classList.add('hidden');
    });
  </script>

</Layout>