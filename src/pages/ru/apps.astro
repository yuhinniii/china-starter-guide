---
import Layout from '@layouts/Layout.astro';
const title = 'Нужные приложения для Китая';
const description = 'Приложения, которые реально понадобятся в Китае — с инструкциями для тех, кто не говорит по-китайски.';
---

<Layout title={title} description={description} lang="ru">
  <article class="max-w-3xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">КАТЕГОРИЯ</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">Нужные приложения</h1>
      <p class="text-gray-500  ">Приложения, которые реально понадобятся в Китае.</p>
    </header>
    <div class="prose prose-gray  ">
      <div class="bg-amber-50  :border-amber-900 rounded-xl p-4 mb-8">
        <p class="text-amber-800  ">
          <strong>Важно:</strong> Подробные гайды по приложениям скоро появятся.
        </p>
      </div>
      <h2>Обязательные приложения</h2>
      <ul>
        <li><strong>WeChat (微信)</strong> — Переписка, платежи, всё в одном</li>
        <li><strong>Alipay (支付宝)</strong> — Платежи и сервисы</li>
        <li><strong>Didi (滴滴)</strong> — Такси и поездки</li>
        <li><strong>Amap / Baidu Maps</strong> — Навигация (Google Maps работает плохо)</li>
        <li><strong>Meituan</strong> — Доставка еды</li>
        <li><strong>Dianping</strong> — Отзывы о ресторанах</li>
      </ul>
    </div>
  </article>
</Layout>
