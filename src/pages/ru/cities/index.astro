---
import Layout from '@layouts/Layout.astro';
const title = 'Путеводители по городам Китая — Направления для путешествий';
const description = 'Найди подходящий город для своей поездки в Китай.';
---

<Layout title={title} description={description} lang="ru">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🏙️ Города</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Путеводители по городам Китая</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Найди подходящий город для своей поездки в Китай.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">6</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">Путеводителей по городам</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Планировщик маршрутов</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">3</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">Охвачено регионов</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">Планирование поездки</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">1 статья</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/cities/city-select/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🧭 Планирование</span>
            <p class="text-base font-bold text-gray-900 mt-1">Сколько дней нужно в Китае?</p>
            <p class="text-sm text-gray-600 mt-0.5">Спланируй идеальный маршрут — от 3-дневного блица до 3-недельного приключения.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">История и культура</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 статья</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/cities/beijing-guide/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🏛️ Пекин</span>
            <p class="text-base font-bold text-gray-900 mt-1">Путеводитель по Пекину: что посмотреть, поесть и знать</p>
            <p class="text-sm text-gray-600 mt-0.5">Запретный город, Великая стена, хутуны, утка по-пекински и полезные советы.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Современное и городское</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 статьи</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/cities/shanghai-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🌆 Шанхай</span>
            <p class="text-base font-bold text-gray-900 mt-1">Путеводитель по Шанхаю: самый удобный для иностранцев город</p>
            <p class="text-sm text-gray-600 mt-0.5">Бунд, Шанхайская башня, Французская концессия и рестораны мирового уровня.</p>
          </a>
          <a href="/ru/cities/shenzhen-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🏙️ Шэньчжэнь</span>
            <p class="text-base font-bold text-gray-900 mt-1">Путеводитель по Шэньчжэню: технохаб рядом с Гонконгом</p>
            <p class="text-sm text-gray-600 mt-0.5">Кремниевая долина Китая, велопрогулки у побережья и 15 минут до Гонконга.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">Природа и пейзажи</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 статья</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/cities/hainan-visa-free/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🏝️ Хайнань</span>
            <p class="text-base font-bold text-gray-900 mt-1">Путеводитель по Хайнаню — 30 дней без визы</p>
            <p class="text-sm text-gray-600 mt-0.5">Тропические пляжи, джунгли и безвизовый въезд для 59 стран.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-orange-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-orange-800">Еда и образ жизни</h2>
          <span class="text-xs font-medium text-orange-800 opacity-60">2 статьи</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/cities/guangzhou-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🥟 Гуанчжоу</span>
            <p class="text-base font-bold text-gray-900 mt-1">Путеводитель по Гуанчжоу: гастрономическая столица Китая</p>
            <p class="text-sm text-gray-600 mt-0.5">Димсамы, Кантонская башня, остров Шамянь и ворота в южный Китай.</p>
          </a>
          <a href="/ru/cities/chengdu-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🐼 Чэнду</span>
            <p class="text-base font-bold text-gray-900 mt-1">Путеводитель по Чэнду: панды, острая еда и медленная жизнь</p>
            <p class="text-sm text-gray-600 mt-0.5">Большие панды, сычуаньский хого, чайные домики и ворота в Цзючжайгоу.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Связанные путеводители</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/ru/transport/high-speed-rail/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Высокоскоростные поезда</p>
          <p class="text-sm text-gray-500">Передвижение между городами</p>
        </a>
        <a href="/ru/transport/metro-bus/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Метро и автобусы</p>
          <p class="text-sm text-gray-500">Передвижение по центру города</p>
        </a>
      </div>
    </div>
  </section>
</Layout>