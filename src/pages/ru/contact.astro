---
import Layout from '@layouts/Layout.astro';
const title = 'Связаться с нами — China Starter Hub';
const description = 'Есть вопросы или предложения? Будем рады вас услышать.';
---

<Layout title={title} description={description} lang="ru">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">КОНТАКТЫ</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">Связаться с нами</h1>
      <p class="text-gray-500  ">Есть вопросы или предложения? Будем рады вас услышать.</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4 text-center">
        <p class="text-gray-700 text-lg">Напишите нам на <a href="mailto:hello@chinastarterhub.com" class="text-brand-600 font-medium hover:underline">hello@chinastarterhub.com</a></p>
      </div>
    </div>
  </article>
</Layout>
