---
import Layout from '@layouts/Layout.astro';
const title = 'Контакты — China Starter Hub';
const description = 'Свяжись с нами по вопросам, отзывам или сотрудничеству.';
---

<Layout title={title} description={description} lang="ru">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">КОНТАКТЫ</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">Свяжись с нами</h1>
      <p class="text-gray-500  ">Есть вопросы или предложения? Будем рады услышать тебя.</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4">
        <p class="text-sm text-gray-500  ">Почта скоро появится. А пока — следи за обновлениями в соцсетях.</p>
      </div>
    </div>
  </article>
</Layout>
