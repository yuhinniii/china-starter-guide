---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Hub — Твой главный гид по Китаю';
const description = 'Всё, что нужно знать перед поездкой в Китай: оплата, транспорт, приложения, города и советы для путешественников.';
---

<Layout title={title} description={description} lang="ru">
  <!-- Trigger rebuild: 2026-06-12 17:30 -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900  ">
      Чёткие и актуальные советы для<br/><span class="text-brand-600">тех, кто едет в Китай впервые</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-500  ">
      Начни с основ, а затем следуй гайдам под твою поездку.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/ru/visa/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">Начать</a>
      <a href="/ru/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">О проекте</a>
    </div>
  </section>

  <!-- Section: Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/ru/visa/', title: 'Виза', desc: 'Типы виз, безвизовые страны, транзит.' },
        { href: '/ru/payment/', title: 'Оплата', desc: 'Электронные кошельки, банковские карты, наличные.' },
        { href: '/ru/transport/', title: 'Транспорт', desc: 'Скоростные поезда, метро, такси и как добраться из аэропорта.' },
        { href: '/ru/life/', title: 'Жизнь в Китае', desc: 'Приложения, медицина, безопасность, бытовые советы.' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  :text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Your Trip: Step by Step -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Твоя поездка: шаг за шагом</h2>
    <p class="text-gray-500 mb-10">Выбери свой этап — каждый ведёт к гайдам, которые реально пригодятся.</p>

    <div class="space-y-8">
      <!-- Stage 1 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-green-100 flex items-center justify-center text-sm font-bold text-green-700">1</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">До вылета</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/ru/visa/visa-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Подготовка</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Какая виза тебе нужна?</p>
          </a>
          <a href="/ru/payment/payment-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Оплата</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Как платить в Китае</p>
          </a>
          <a href="/ru/life/survival-kit/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">Жизнь</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Чек-лист перед вылетом</p>
          </a>
        </div>
      </div>

      <!-- Stage 2 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-sm font-bold text-blue-700">2</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Только приземлился</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/ru/transport/airport-to-city/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Транспорт</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Из аэропорта в город</p>
          </a>
          <a href="/ru/life/sim-card-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Жизнь</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">SIM-карта и интернет</p>
          </a>
          <a href="/ru/life/vpn-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">Жизнь</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Настройка VPN</p>
          </a>
        </div>
      </div>

      <!-- Stage 3 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-purple-100 flex items-center justify-center text-sm font-bold text-purple-700">3</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Во время поездки</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/ru/transport/transport-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Транспорт</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Как передвигаться по Китаю</p>
          </a>
          <a href="/ru/life/essential-apps/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Жизнь</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">10 нужных приложений</p>
          </a>
          <a href="/ru/life/chinese-phrases/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">Жизнь</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Базовые фразы на китайском</p>
          </a>
        </div>
      </div>

      <!-- Stage 4 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-red-100 flex items-center justify-center text-sm font-bold text-red-700">4</div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">Нужна помощь?</h3>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <a href="/ru/life/seeing-a-doctor/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Жизнь</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Поход к врачу</p>
          </a>
          <a href="/ru/life/common-scams/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Жизнь</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Как не попасться на уловки</p>
          </a>
          <a href="/ru/life/emergency-numbers/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Жизнь</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Экстренные контакты</p>
          </a>
          <a href="/ru/payment/payment-fails/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">Оплата</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">Если оплата не прошла</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visa Checker Tool -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="border-t border-gray-100 pt-12">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">Проверка визы</h2>
        <p class="text-gray-500 text-center mb-8">Не уверен, нужна ли виза? Выбери своё гражданство — мы подскажем.</p>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <label for="visa-country" class="block text-sm font-medium text-gray-700 mb-2">Твоё гражданство</label>
          <select id="visa-country" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 text-base appearance-none cursor-pointer">
            <option value="">— Выбери страну —</option>
            <option value="AL">Албания</option>
            <option value="AD">Андорра</option>
            <option value="AG">Антигуа и Барбуда</option>
            <option value="AR">Аргентина</option>
            <option value="AM">Армения</option>
            <option value="AU">Австралия</option>
            <option value="AT">Австрия</option>
            <option value="AZ">Азербайджан</option>
            <option value="BS">Багамские Острова</option>
            <option value="BH">Бахрейн</option>
            <option value="BD">Бангладеш</option>
            <option value="BB">Барбадос</option>
            <option value="BY">Беларусь</option>
            <option value="BE">Бельгия</option>
            <option value="BA">Босния и Герцеговина</option>
            <option value="BR">Бразилия</option>
            <option value="BN">Бруней</option>
            <option value="BG">Болгария</option>
            <option value="CA">Канада</option>
            <option value="CL">Чили</option>
            <option value="HR">Хорватия</option>
            <option value="CY">Кипр</option>
            <option value="CZ">Чехия</option>
            <option value="DK">Дания</option>
            <option value="DM">Доминика</option>
            <option value="EC">Эквадор</option>
            <option value="EG">Египет</option>
            <option value="EE">Эстония</option>
            <option value="FJ">Фиджи</option>
            <option value="FI">Финляндия</option>
            <option value="FR">Франция</option>
            <option value="GE">Грузия</option>
            <option value="DE">Германия</option>
            <option value="GR">Греция</option>
            <option value="GD">Гренада</option>
            <option value="HU">Венгрия</option>
            <option value="IS">Исландия</option>
            <option value="IN">Индия</option>
            <option value="ID">Индонезия</option>
            <option value="IE">Ирландия</option>
            <option value="IT">Италия</option>
            <option value="JP">Япония</option>
            <option value="KZ">Казахстан</option>
            <option value="KE">Кения</option>
            <option value="KW">Кувейт</option>
            <option value="LV">Латвия</option>
            <option value="LI">Лихтенштейн</option>
            <option value="LT">Литва</option>
            <option value="LU">Люксембург</option>
            <option value="MY">Малайзия</option>
            <option value="MV">Мальдивы</option>
            <option value="MT">Мальта</option>
            <option value="MU">Маврикий</option>
            <option value="MX">Мексика</option>
            <option value="MC">Монако</option>
            <option value="ME">Черногория</option>
            <option value="NL">Нидерланды</option>
            <option value="NZ">Новая Зеландия</option>
            <option value="NG">Нигерия</option>
            <option value="MK">Северная Македония</option>
            <option value="NO">Норвегия</option>
            <option value="OM">Оман</option>
            <option value="PK">Пакистан</option>
            <option value="PE">Перу</option>
            <option value="PH">Филиппины</option>
            <option value="PL">Польша</option>
            <option value="PT">Португалия</option>
            <option value="QA">Катар</option>
            <option value="RO">Румыния</option>
            <option value="RU">Россия</option>
            <option value="WS">Самоа</option>
            <option value="SM">Сан-Марино</option>
            <option value="SA">Саудовская Аравия</option>
            <option value="RS">Сербия</option>
            <option value="SC">Сейшельские Острова</option>
            <option value="SG">Сингапур</option>
            <option value="SK">Словакия</option>
            <option value="SI">Словения</option>
            <option value="SB">Соломоновы Острова</option>
            <option value="ZA">ЮАР</option>
            <option value="KR">Южная Корея</option>
            <option value="ES">Испания</option>
            <option value="SR">Суринам</option>
            <option value="SE">Швеция</option>
            <option value="CH">Швейцария</option>
            <option value="TH">Таиланд</option>
            <option value="TO">Тонга</option>
            <option value="TR">Турция</option>
            <option value="UA">Украина</option>
            <option value="AE">ОАЭ</option>
            <option value="GB">Великобритания</option>
            <option value="US">США</option>
            <option value="UY">Уругвай</option>
            <option value="UZ">Узбекистан</option>
            <option value="VN">Вьетнам</option>
            <option value="OTHER">Другая страна</option>
          </select>

          <div id="visa-result" class="mt-6"></div>
        </div>

        <p class="text-xs text-gray-400 text-center mt-4">Визовые правила меняются. Перед бронированием всегда уточняй информацию в посольстве Китая.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const countrySelect = document.getElementById('visa-country');
    const resultDiv = document.getElementById('visa-result');

    // Source: China gov.cn official list (2025)
    // Category 1: Unilateral visa-free (30 days) - 50 countries
    const visaFree = ['BN','FR','DE','IT','ES','NL','CH','IE','HU','AT','BE','LU','NZ','AU','PL','PT','GR','CY','SI','SK','NO','FI','DK','IS','AD','MC','LI','KR','BG','RO','HR','ME','MK','MT','EE','LV','JP','BR','AR','CL','PE','UY','SA','OM','KW','BH','CA','RU','GB','SE'];

    // Category 2: Mutual visa agreement (ordinary passport) - 29 countries
    const mutualFree = ['AL','AE','AG','BB','BS','BY','BA','DM','EC','FJ','GD','GE','KZ','QA','MV','MU','WS','RS','SC','SM','SR','SB','TH','TO','UZ','SG','AM','AZ','MY'];

    // Category 3: 240-hour transit - 55 countries
    const transit240 = ['AL','AT','BE','BG','BA','BR','CA','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LT','LU','MT','MC','ME','NL','MK','NO','PL','PT','RO','RU','RS','SK','SI','KR','ES','SE','CH','UA','GB','US','AU','NZ','JP','SG','BN','AE','QA','MX','AR','CL','ID','BY'];

    // Determine best visa status for each country
    function getVisaStatus(code) {
      if (visaFree.includes(code)) return 'visa-free-30';
      if (mutualFree.includes(code)) return 'mutual-free';
      if (transit240.includes(code)) return 'transit';
      return 'need-visa';
    }

    const countryNames = {
      'AL':'Албания','AD':'Андорра','AG':'Антигуа и Барбуда','AR':'Аргентина','AM':'Армения',
      'AU':'Австралия','AT':'Австрия','AZ':'Азербайджан','BS':'Багамские Острова','BH':'Бахрейн','BB':'Барбадос',
      'BY':'Беларусь','BE':'Бельгия','BA':'Босния и Герцеговина','BR':'Бразилия','BN':'Бруней','BG':'Болгария',
      'CA':'Канада','CL':'Чили','HR':'Хорватия','CY':'Кипр','CZ':'Чехия','DK':'Дания',
      'DM':'Доминика','EC':'Эквадор','EG':'Египет','EE':'Эстония','FJ':'Фиджи','FI':'Финляндия','FR':'Франция',
      'GE':'Грузия','DE':'Германия','GR':'Греция','GD':'Гренада','HU':'Венгрия',      'IS':'Исландия','IE':'Ирландия','IN':'Индия','ID':'Индонезия','IT':'Италия',
      'JP':'Япония','KZ':'Казахстан','KE':'Кения','KW':'Кувейт','LV':'Латвия','LI':'Лихтенштейн',
      'LT':'Литва','LU':'Люксембург','MY':'Малайзия','MV':'Мальдивы','MT':'Мальта','MU':'Маврикий',
      'MX':'Мексика',
      'MC':'Монако','ME':'Черногория',      'NL':'Нидерланды','NZ':'Новая Зеландия','NG':'Нигерия','MK':'Северная Македония',
      'NO':'Норвегия','OM':'Оман','PK':'Пакистан','PE':'Перу','PH':'Филиппины','PL':'Польша','PT':'Португалия','QA':'Катар','RO':'Румыния',
      'RU':'Россия','WS':'Самоа','SM':'Сан-Марино','SA':'Саудовская Аравия','RS':'Сербия','SC':'Сейшельские Острова',
      'SG':'Сингапур','SK':'Словакия','SI':'Словения','SB':'Соломоновы Острова','ZA':'ЮАР','KR':'Южная Корея',
      'ES':'Испания','SR':'Суринам','SE':'Швеция','CH':'Швейцария','TH':'Таиланд','TO':'Тонга','TR':'Турция',
      'UA':'Украина',
      'AE':'ОАЭ','GB':'Великобритания','US':'США','UY':'Уругвай','UZ':'Узбекистан','VN':'Вьетнам'
    };

    countrySelect.addEventListener('change', function() {
      const val = this.value;
      if (!val) {
        resultDiv.innerHTML = '';
        return;
      }

      const name = countryNames[val] || 'твоей страны';
      const status = getVisaStatus(val);

      if (status === 'visa-free-30') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">Отлично! Граждане ' + name + ' могут въезжать в Китай <span class="underline">без визы</span> на срок до 30 дней.</p><p class="text-green-700 text-sm mb-3">Виза не нужна для туризма, бизнеса или транзита до 30 дней.</p><a href="/ru/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">Посмотреть полный список безвизовых стран →</a></div>';
      } else if (status === 'mutual-free') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">Граждане ' + name + ' могут въезжать в Китай <span class="underline">без визы</span> по взаимному соглашению.</p><p class="text-green-700 text-sm mb-3">Перед поездкой уточни тип паспорта и разрешённый срок пребывания.</p><a href="/ru/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">Посмотреть список безвизовых стран →</a></div>';
      } else if (status === 'transit') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-blue-50 border border-blue-200"><p class="text-blue-800 font-semibold mb-1">Ты можешь воспользоваться правилом <span class="underline">240-часового транзита</span>.</p><p class="text-blue-700 text-sm mb-3">Граждане ' + name + ' могут находиться в Китае до 10 дней в транзите без визы. Для более долгой поездки понадобится виза L.</p><div class="flex flex-wrap gap-3"><a href="/ru/visa/transit-240/" class="text-sm font-medium text-blue-700 underline hover:no-underline">Как работает транзит →</a><a href="/ru/visa/apply-l-visa/" class="text-sm font-medium text-blue-700 underline hover:no-underline">Оформить визу L →</a></div></div>';
      } else {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-orange-50 border border-orange-200"><p class="text-orange-800 font-semibold mb-1">Тебе понадобится виза.</p><p class="text-orange-700 text-sm mb-3">Гражданам ' + name + ' нужно оформить туристическую визу (L) перед поездкой в Китай.</p><a href="/ru/visa/apply-l-visa/" class="inline-block text-sm font-medium text-orange-700 underline hover:no-underline">Как оформить визу L →</a></div>';
      }
    });
  </script>
    <p class="text-xs text-gray-400 text-center mt-8">Последнее обновление: июль 2026</p>
</Layout>
