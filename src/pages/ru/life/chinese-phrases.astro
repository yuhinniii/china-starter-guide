---
import Layout from '@layouts/Layout.astro';
const title = "Основные китайские фразы для путешественников";
const description = "Выучи эти базовые китайские фразы до поездки — произношение, когда использовать и советы, как быть понятым.";
---

<Layout title={title} description={description} lang="ru">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/ru/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Назад к «Жизни в Китае»
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🗣️ Жизнь в Китае</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        Основные китайские фразы для путешественников
      </h1>
      <p class="text-xl text-gray-600 mb-6">Десяток фраз изменит отношение к тебе.</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 Последнее обновление: июнь 2026</span>
        <span>⏱️ 4 мин. чтения</span>
      </div>
    </header>

        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 Краткий ответ</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        Тебе не нужно говорить по-китайски, чтобы путешествовать по Китаю. Но знание десятка фраз сделает поездку намного лучше — местные жители искренне ценят усилия, и ты заметишь, что получаешь лучшее обслуживание, более тёплые улыбки и даже лучшие цены на рынках.
      </p>
    </div>

        <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 В этом гайде</h3>
      <ul class="space-y-3">
        <li><a href="#greetings" class="text-blue-600 hover:underline">👋 Приветствия и вежливость</a></li>
        <li><a href="#eating" class="text-blue-600 hover:underline">🍽️ Еда и заказ</a></li>
        <li><a href="#shopping" class="text-blue-600 hover:underline">🛍️ Покупки и цены</a></li>
        <li><a href="#getting-around" class="text-blue-600 hover:underline">🚇 Передвижение</a></li>
        <li><a href="#emergencies" class="text-blue-600 hover:underline">🆘 Экстренные ситуации</a></li>
        <li><a href="#pronunciation" class="text-blue-600 hover:underline">🎵 Советы по произношению</a></li>
      </ul>
    </nav>

    <div class="prose prose-lg max-w-none">
      <hr class="border-gray-200 my-12" />

            <h2 id="greetings" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">👋</span> Приветствия и вежливость
      </h2>

      <div class="overflow-x-auto mb-6 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">Базовые китайские фразы для путешественников</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">Английский</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">Пиньинь</th>
              <th class="px-6 py-4 font-bold">Примечания</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Hello</td><td class="px-6 py-4">你好</td><td class="px-6 py-4">Nǐ hǎo</td><td class="px-6 py-4">Используй с любым, в любое время</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Thank you</td><td class="px-6 py-4">谢谢</td><td class="px-6 py-4">Xiè xiè</td><td class="px-6 py-4">Говори часто — люди замечают</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Sorry / Excuse me</td><td class="px-6 py-4">对不起</td><td class="px-6 py-4">Duì bù qǐ</td><td class="px-6 py-4">Если кого-то задел</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">It's okay</td><td class="px-6 py-4">没关系</td><td class="px-6 py-4">Méi guān xì</td><td class="px-6 py-4">Ответ на «извините»</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Goodbye</td><td class="px-6 py-4">再见</td><td class="px-6 py-4">Zài jiàn</td><td class="px-6 py-4">Стандартное прощание</td></tr>
          </tbody>
        </table>
      </div>

      <p class="text-lg leading-relaxed text-gray-700 mb-12"><strong>Совет:</strong> Говори «Спасибо» после каждой покупки — в ресторанах, магазинах, такси. Это очень помогает в повседневном общении.</p>

      <hr class="border-gray-200 my-12" />

            <h2 id="eating" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🍽️</span> Еда и заказ
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">Базовые китайские фразы для путешественников</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">Английский</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">Пиньинь</th>
              <th class="px-6 py-4 font-bold">Примечания</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Check, please</td><td class="px-6 py-4">买单</td><td class="px-6 py-4">Mǎi dān</td><td class="px-6 py-4">Слегка подними руку</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Delicious!</td><td class="px-6 py-4">好吃！</td><td class="px-6 py-4">Hǎo chī!</td><td class="px-6 py-4">Похвали повара</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">No spicy</td><td class="px-6 py-4">不加辣</td><td class="px-6 py-4">Bù jiā là</td><td class="px-6 py-4">Обязательно в Сычуане/Хунани</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Water, please</td><td class="px-6 py-4">请给我水</td><td class="px-6 py-4">Qǐng gěi wǒ shuǐ</td><td class="px-6 py-4">Не пей воду из-под крана</td></tr>
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="shopping" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🛍️</span> Покупки и цены
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">Базовые китайские фразы для путешественников</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">Английский</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">Пиньинь</th>
              <th class="px-6 py-4 font-bold">Примечания</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">How much?</td><td class="px-6 py-4">多少钱？</td><td class="px-6 py-4">Duō shǎo qián?</td><td class="px-6 py-4">Универсальный вопрос о цене</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Too expensive</td><td class="px-6 py-4">太贵了</td><td class="px-6 py-4">Tài guì le</td><td class="px-6 py-4">Только на рынках</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Can you lower it?</td><td class="px-6 py-4">便宜一点？</td><td class="px-6 py-4">Pián yí yì diǎn?</td><td class="px-6 py-4">Используй на рынках, не в магазинах</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">I'll take it</td><td class="px-6 py-4">我要这个</td><td class="px-6 py-4">Wǒ yào zhè ge</td><td class="px-6 py-4">Когда решился</td></tr>
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="getting-around" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🚇</span> Передвижение
      </h2>

      <div class="overflow-x-auto mb-6 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">Базовые китайские фразы для путешественников</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">Английский</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">Пиньинь</th>
              <th class="px-6 py-4 font-bold">Примечания</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Where is...?</td><td class="px-6 py-4">...在哪里？</td><td class="px-6 py-4">...zài nǎ lǐ?</td><td class="px-6 py-4">Покажи название места на китайском</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">I'm going here</td><td class="px-6 py-4">去这里</td><td class="px-6 py-4">Qù zhè lǐ</td><td class="px-6 py-4">Покажи адрес водителю</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Stop here</td><td class="px-6 py-4">这里停</td><td class="px-6 py-4">Zhè lǐ tíng</td><td class="px-6 py-4">Для такси</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">How long?</td><td class="px-6 py-4">多久？</td><td class="px-6 py-4">Duō jiǔ?</td><td class="px-6 py-4">Время в пути или ожидания</td></tr>
          </tbody>
        </table>
      </div>

      <p class="text-lg leading-relaxed text-gray-700 mb-12"><strong>Про-совет:</strong> Всегда показывай пункт назначения иероглифами.</p>

      <hr class="border-gray-200 my-12" />

            <h2 id="emergencies" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🆘</span> Экстренные ситуации
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">Базовые китайские фразы для путешественников</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">Английский</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">Пиньинь</th>
              <th class="px-6 py-4 font-bold">Примечания</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Help!</td><td class="px-6 py-4">救命！</td><td class="px-6 py-4">Jiù mìng!</td><td class="px-6 py-4">Только в реальной опасности</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Call the police</td><td class="px-6 py-4">报警</td><td class="px-6 py-4">Bào jǐng</td><td class="px-6 py-4">Экстренный номер: 110</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">I need a doctor</td><td class="px-6 py-4">我需要医生</td><td class="px-6 py-4">Wǒ xū yào yī shēng</td><td class="px-6 py-4">Экстренный номер: 120</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">I'm lost</td><td class="px-6 py-4">我迷路了</td><td class="px-6 py-4">Wǒ mí lù le</td><td class="px-6 py-4">Покажи адрес иероглифами</td></tr>
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="pronunciation" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🎵</span> Советы по произношению
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">В китайском языке используются <strong>тона</strong> — один и тот же слог, произнесённый с разной интонацией, означает разные вещи. Но не переживай слишком сильно. Контекст обычно проясняет смысл, а местные жители снисходительны к туристам.</p>

      <p class="text-lg font-bold text-gray-900 mb-4">Четыре тона:</p>

      <div class="overflow-x-auto mb-6 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">Базовые китайские фразы для путешественников</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">Тон</th>
              <th class="px-6 py-4 font-bold">Пример</th>
              <th class="px-6 py-4 font-bold">Значение</th>
              <th class="px-6 py-4 font-bold">Описание</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">1-й</td><td class="px-6 py-4">mā (妈)</td><td class="px-6 py-4">мама</td><td class="px-6 py-4">Ровный, высокий тон</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">2-й</td><td class="px-6 py-4">má (麻)</td><td class="px-6 py-4">конопля</td><td class="px-6 py-4">Восходящий тон</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">3-й</td><td class="px-6 py-4">mǎ (马)</td><td class="px-6 py-4">лошадь</td><td class="px-6 py-4">Сначала вниз, потом вверх</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">4-й</td><td class="px-6 py-4">mà (骂)</td><td class="px-6 py-4">ругать</td><td class="px-6 py-4">Резкое падение</td></tr>
          </tbody>
        </table>
      </div>

      <p class="text-lg leading-relaxed text-gray-700 mb-12"><strong>Лучший совет:</strong> Говори медленно и чётко. Большинство китайцев привыкли к тому, что иностранцы путаются в тонах, и будут стараться понять.</p>
    </div>

        <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 Похожие гайды</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/ru/life/essential-apps/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">📱 10 приложений для Китая</p>
          <p class="text-sm text-gray-600">Обязательные приложения, включая переводчики</p>
        </a>
        <a href="/ru/life/cultural-taboos/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🏮 Культурные «можно» и «нельзя»</p>
          <p class="text-sm text-gray-600">Уверенно ориентируйся в социальных ситуациях</p>
        </a>
      </div>
    </div>
  
  </article>
</Layout>