---
import Layout from '@layouts/Layout.astro';
const title = 'Платежи в Китае — Как платить в Китае';
const description = 'Настрой Alipay до вылета — этого хватит для 95% платежей.';
---

<Layout title={title} description={description} lang="ru">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">💳 Платежи</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Платежи в Китае</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Настрой Alipay до вылета — этого хватит для 95% платежей.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">2</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">Мобильных платёжных приложений</p>
      </div>
      <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-indigo-800">2</p>
        <p class="text-xs font-semibold text-indigo-800 uppercase tracking-wide mt-1">Инструкции по настройке</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Гайд по кредитным картам</p>
      </div>
      <div class="bg-pink-50 border border-pink-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-pink-800">1</p>
        <p class="text-xs font-semibold text-pink-800 uppercase tracking-wide mt-1">Чаевые в Китае</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Начало работы</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 статьи</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/payment/setup-alipay/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💰 Инструкция</span>
            <p class="text-base font-bold text-gray-900 mt-1">Как иностранцу настроить Alipay</p>
            <p class="text-sm text-gray-600 mt-0.5">Скачай, зарегистрируйся по международному номеру и привяжи иностранную карту.</p>
          </a>
          <a href="/ru/payment/setup-wechat/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💬 Инструкция</span>
            <p class="text-base font-bold text-gray-900 mt-1">Как иностранцу настроить WeChat Pay</p>
            <p class="text-sm text-gray-600 mt-0.5">Скачай WeChat, зарегистрируйся, подтверди личность и привяжи международную карту.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-indigo-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-indigo-800">Использование международных карт</h2>
          <span class="text-xs font-medium text-indigo-800 opacity-60">1 статья</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/payment/foreign-cards/" class="block bg-indigo-50 border border-indigo-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-indigo-800">💳 Гайд</span>
            <p class="text-base font-bold text-gray-900 mt-1">Работают ли иностранные карты в Китае?</p>
            <p class="text-sm text-gray-600 mt-0.5">Где на самом деле принимают Visa и Mastercard, сколько стоят снятия в банкоматах.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Частые проблемы</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 статья</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/payment/payment-fails/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🔧 Решение проблем</span>
            <p class="text-base font-bold text-gray-900 mt-1">Что делать, если платёж не проходит</p>
            <p class="text-sm text-gray-600 mt-0.5">Частые причины ошибок и пошаговое решение.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-pink-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-pink-800">Чаевые и культура</h2>
          <span class="text-xs font-medium text-pink-800 opacity-60">1 статья</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/payment/tipping/" class="block bg-pink-50 border border-pink-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-pink-800">🎭 Культура</span>
            <p class="text-base font-bold text-gray-900 mt-1">Нужно ли оставлять чаевые в Китае?</p>
            <p class="text-sm text-gray-600 mt-0.5">Нет, чаевые в Китае не ожидаются. Краткий гайд о том, что делать.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">Полный гайд</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 статья</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/payment/payment-guide/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">📖 Обзор</span>
            <p class="text-base font-bold text-gray-900 mt-1">Как платить в Китае: полный гайд</p>
            <p class="text-sm text-gray-600 mt-0.5">Alipay, WeChat Pay, наличные или кредитные карты — полный обзор.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Похожие гайды</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/ru/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Транспорт в Китае</p>
          <p class="text-sm text-gray-500">Поезда, метро, такси и каршеринг</p>
        </a>
        <a href="/ru/life/essential-apps/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Приложения для поездки в Китай</p>
          <p class="text-sm text-gray-500">Must-have приложения для путешествия</p>
        </a>
      </div>
    </div>
  </section>
</Layout>