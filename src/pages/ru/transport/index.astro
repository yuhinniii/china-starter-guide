---
import Layout from '@layouts/Layout.astro';
const title = 'Транспорт в Китае — Как передвигаться по стране';
const description = 'Поезда, самолёты, метро и каршеринг — всё, что нужно знать.';
---

<Layout title={title} description={description} lang="ru">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Транспорт в Китае</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Поезда, самолёты, метро и каршеринг — всё, что нужно знать.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-sky-50 border border-sky-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-sky-800">1</p>
        <p class="text-xs font-semibold text-sky-800 uppercase tracking-wide mt-1">Гайд по скоростным поездам</p>
      </div>
      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-emerald-800">1</p>
        <p class="text-xs font-semibold text-emerald-800 uppercase tracking-wide mt-1">Трансфер из аэропорта</p>
      </div>
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">2</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">Городской транспорт</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-gray-800">1</p>
        <p class="text-xs font-semibold text-gray-800 uppercase tracking-wide mt-1">Каршеринг</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-sky-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-sky-800">Передвижение по Китаю</h2>
          <span class="text-xs font-medium text-sky-800 opacity-60">1 статья</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/transport/transport-guide/" class="block bg-sky-50 border border-sky-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-sky-800">📖 Обзор</span>
            <p class="text-base font-bold text-gray-900 mt-1">Как передвигаться по Китаю</p>
            <p class="text-sm text-gray-600 mt-0.5">Полный обзор всех видов транспорта — поезда, самолёты, метро и другое.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">Прибытие в Китай</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 статья</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/transport/airport-to-city/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🛬 Гайд</span>
            <p class="text-base font-bold text-gray-900 mt-1">Из аэропорта в город</p>
            <p class="text-sm text-gray-600 mt-0.5">Варианты транспорта в крупных аэропортах — Пекин, Шанхай, Гуанчжоу и другие.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">Городской транспорт</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">2 статьи</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/transport/high-speed-rail/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚄 Гайд</span>
            <p class="text-base font-bold text-gray-900 mt-1">Как купить билет и поехать на скоростном поезде</p>
            <p class="text-sm text-gray-600 mt-0.5">Всё о покупке билетов и поездках по крупнейшей в мире сети ВСМ.</p>
          </a>
          <a href="/ru/transport/metro-bus/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚇 Гайд</span>
            <p class="text-base font-bold text-gray-900 mt-1">Метро и автобусы в крупных городах</p>
            <p class="text-sm text-gray-600 mt-0.5">Как пользоваться общественным транспортом в Пекине, Шанхае, Гуанчжоу и Шэньчжэне.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">Каршеринг</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 статья</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/ru/transport/didi/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">🚕 Инструкция</span>
            <p class="text-base font-bold text-gray-900 mt-1">Как иностранцу пользоваться DiDi в Китае</p>
            <p class="text-sm text-gray-600 mt-0.5">Пошаговая инструкция по использованию DiDi, китайского Uber — со скриншотами.</p>
          </a>
        </div>
      </div>
    </div>

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">Следующий шаг</p>
            <h3 class="text-xl font-bold text-gray-900">Откройте города Китая</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">Вы знаете, как передвигаться. Теперь выберите, куда поехать — начните с гида по городам.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/ru/cities/city-select/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🗺️ Сравнить города
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/ru/cities/shenzhen-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              📍 Гид по Шэньчжэню
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>