---
import Layout from '@layouts/Layout.astro';
import { authorAbout } from '../../data/site-author';
const title = 'เกี่ยวกับ — China Starter Hub';
const description = 'เหตุผลที่เราสร้างคู่มือนี้และเหมาะสำหรับใคร';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-3xl mx-auto py-12">
    <!-- Header -->
    <header class="text-center mb-16">
      <div class="text-sm text-brand-600 font-medium tracking-wide uppercase mb-3">เกี่ยวกับ</div>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-6">
        เกี่ยวกับ China Starter Hub
      </h1>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        แหล่งข้อมูลอิสระที่ช่วยให้นักท่องเที่ยวต่างชาติเตรียมตัวและเดินทางในจีนได้อย่างราบรื่น
      </p>
    </header>

<!-- Meet the Author -->
    <section class="mb-16 not-prose">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">ทำความรู้จักกับผู้เขียน</h2>
      <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100">
        <p class="text-sm font-semibold text-gray-900 m-0 mb-3">Lynn</p>
        <p class="text-base leading-relaxed text-gray-700 m-0">{authorAbout('th')}</p>
      </div>
    </section>


    <!-- Main Content -->
    <div class="prose prose-gray max-w-none">
      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        China Starter Hub คือแหล่งข้อมูลอิสระที่ช่วยให้นักท่องเที่ยวต่างชาติเตรียมตัวและเดินทางในประเทศจีนได้อย่างสะดวกสบาย
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        ไม่ว่าคุณจะมาเที่ยว ทำธุรกิจ เรียน หรือพักระยะสั้น การหาข้อมูลที่เชื่อถือได้เกี่ยวกับจีนอาจเป็นเรื่องยาก กฎระเบียบ แอปพลิเคชัน การชำระเงิน การเดินทาง และบริการทั่วไปในชีวิตประจำวันมักแตกต่างจากสิ่งที่นักเดินทางหลายคนคาดหวัง
      </p>

      <div class="border-l-2 border-brand-300 pl-5 py-3 my-8">
        <p class="text-lg font-medium text-gray-600 italic m-0">
          เป้าหมายของเราคือเรื่องง่าย ๆ: ทำให้จีนเข้าใจง่ายขึ้นและเดินทางสะดวกขึ้น
        </p>
      </div>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        เราสร้างคู่มือที่ใช้งานได้จริงและเครื่องมือที่มีประโยชน์จากคำถามจริงของนักเดินทางและผู้มาเยือนครั้งแรก ทุกทรัพยากรถูกออกแบบมาเพื่อประหยัดเวลา ลดความสับสน และช่วยให้ผู้คนเดินทางอย่างมั่นใจ
      </p>

      <hr class="my-12 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-6">สิ่งที่คุณจะได้พบ</h2>

      <div class="grid md:grid-cols-3 gap-6 not-prose mb-12">
        <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100">
          <div class="text-brand-600 text-2xl mb-3">📙</div>
          <h3 class="font-semibold text-gray-900 mb-2">ไม่มีโฆษณาการท่องเที่ยว</h3>
          <p class="text-sm text-gray-500 leading-relaxed m-0">แค่ข้อมูลที่ชัดเจนและมีประโยชน์ที่คุณสามารถเชื่อถือได้</p>
        </div>
        <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100">
          <div class="text-brand-600 text-2xl mb-3">⚡</div>
          <h3 class="font-semibold text-gray-900 mb-2">ไม่ซับซ้อนโดยไม่จำเป็น</h3>
          <p class="text-sm text-gray-500 leading-relaxed m-0">คำตอบตรงประเด็นสำหรับคำถามจริง โดยไม่มีศัพท์เทคนิค</p>
        </div>
        <div class="p-6 rounded-2xl bg-gray-50 border border-gray-100">
          <div class="text-brand-600 text-2xl mb-3">✅</div>
          <h3 class="font-semibold text-gray-900 mb-2">ใช้งานได้จริง</h3>
          <p class="text-sm text-gray-500 leading-relaxed m-0">ทุกคู่มือถูกออกแบบให้คุณนำไปใช้ได้จริงเมื่ออยู่ที่จีน</p>
        </div>
      </div>

      <hr class="my-12 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-6">คู่มือนี้เหมาะสำหรับใคร</h2>
      <div class="grid md:grid-cols-2 gap-4 not-prose mb-12">
        <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50">
          <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-brand-100 text-brand-700 text-sm font-bold flex items-center justify-center">1</span>
          <div>
            <p class="font-medium text-gray-900 m-0">นักท่องเที่ยวครั้งแรก</p>
            <p class="text-sm text-gray-500 m-0">มาเที่ยวจีนครั้งแรกและต้องการข้อมูลพื้นฐาน</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50">
          <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-brand-100 text-brand-700 text-sm font-bold flex items-center justify-center">2</span>
          <div>
            <p class="font-medium text-gray-900 m-0">นักธุรกิจ</p>
            <p class="text-sm text-gray-500 m-0">เดินทางระยะสั้นที่มีเวลาจำกัดในการเตรียมตัว</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50">
          <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-brand-100 text-brand-700 text-sm font-bold flex items-center justify-center">3</span>
          <div>
            <p class="font-medium text-gray-900 m-0">นักเรียนและนักวิจัย</p>
            <p class="text-sm text-gray-500 m-0">พักอยู่หนึ่งภาคเรียนหรือนานกว่านั้นและต้องปรับตัว</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50">
          <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-brand-100 text-brand-700 text-sm font-bold flex items-center justify-center">4</span>
          <div>
            <p class="font-medium text-gray-900 m-0">ผู้มาเยือนระยะสั้น</p>
            <p class="text-sm text-gray-500 m-0">ต่อเครื่อง พักค้างคืน หรือเดินทางด่วนที่มีความต้องการเฉพาะ</p>
          </div>
        </div>
      </div>

      <hr class="my-12 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">ติดตามข้อมูลล่าสุด</h2>
      <p class="text-lg leading-relaxed text-gray-700">
        เทคโนโลยีและนโยบายของจีนเปลี่ยนแปลงอย่างรวดเร็ว เราอัปเดตคู่มือของเราเป็นประจำเพื่อให้ข้อมูลถูกต้องและเป็นประโยชน์ ติดตามเราหรือกลับมาตรวจสอบบ่อย ๆ เพื่อรับข้อมูลอัปเดตล่าสุด
      </p>
    </div>
  </article>
</Layout>
