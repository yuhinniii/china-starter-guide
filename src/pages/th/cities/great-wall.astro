---
import Layout from '@layouts/Layout.astro';
const title = 'คู่มือกำแพงเมืองจีน: ควรไปด่านไหน';
const description = 'เทียบกำแพงเมืองจีนทั้งหกด่าน — ปาต๋าหลิง มู่เถียนยวี่ จินซานหลิง ซือหมาถาย หวงฮวาเฉิง และจูยงกวน — ทั้งความแออัด ความยาก ค่าตั๋ว และทัวร์กลางคืน';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">

    <!-- ============ BREADCRUMB ============ -->
    <nav class="mb-8 not-prose">
      <a href="/th/cities/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปยังคู่มือเมือง
      </a>
    </nav>

    <!-- ============ HERO ============ -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🧱 กำแพงเมืองจีน · ปักกิ่ง</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">กำแพงเมืองจีน: ควรไปด่านไหน?</h1>
      <p class="text-xl text-gray-600 mb-6">ปาต๋าหลิง มู่เถียนยวี่ จินซานหลิง หรือซือหมาถาย — อะไรที่ทำให้ต่างกันจริง ๆ และด่านไหนเหมาะกับทริปที่คุณกำลังวางแผนอยู่</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: กันยายน 2026</span>
        <span>⏱️ อ่าน 12 นาที</span>
      </div>
    </header>

    <!-- ============ HERO IMAGE ============ -->
    <figure class="mb-12 not-prose">
      <img
        src="/images/great-wall/comparison-grid.webp"
        alt="ภาพรวมกำแพงเมืองจีนหกด่านใกล้ปักกิ่ง: ปาต๋าหลิงในดอกไม้ฤดูใบไม้ผลิ มู่เถียนยวี่ในสีสันฤดูใบไม้ร่วง จินซานหลิงเหนือทะเลหมอก ซือหมาถายที่เปิดไฟกลางคืนเหนือกู่เป่ยสุ่ยเจิ้น หวงฮวาเฉิงที่ทอดลงสู่ทะเลสาบสีมรกต และด่านจูยงกวน"
        width="1200"
        height="534"
        loading="eager"
        fetchpriority="high"
        class="w-full h-auto object-cover rounded-2xl shadow-md"
      />
      <figcaption class="text-xs text-gray-500 text-center mt-2">กำแพงเดียวกัน หกวันที่ต่างกัน จากซ้ายไปขวา บนลงล่าง: ปาต๋าหลิง มู่เถียนยวี่ จินซานหลิง ซือหมาถาย หวงฮวาเฉิง จูยงกวน</figcaption>
    </figure>

    <!-- ============ QUICK ANSWER ============ -->
    <div class="bg-gradient-to-r from-red-50 to-orange-50 border-l-4 border-red-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-red-900 mb-4">⚡ คำตอบสั้นๆ</h2>
      <p class="text-lg text-red-800 leading-relaxed">
        <strong>มู่เถียนยวี่</strong> เป็นตัวเลือกที่ลงตัวที่สุดสำหรับคนส่วนใหญ่ที่มาเที่ยวครั้งแรก — บูรณะครบถ้วนและอลังการ ขึ้นด้วยกระเช้า ลงด้วยรางเลื่อน แต่คนน้อยกว่าปาต๋าหลิงหลายเท่า <strong>ปาต๋าหลิง</strong> คือด่านที่ใช่ที่สุด — ด่านแรกที่เปิดให้นักท่องเที่ยว ย่านที่ประมุขรัฐต่าง ๆ มาเยือน และยิ่งใหญ่ที่สุดในบรรดาด่านที่บูรณะแล้ว ไต่ขึ้นถึงหอเหนือ 8 ที่ความสูง 888 ม. แต่ก็แออัดที่สุดเช่นกัน <strong>จินซานหลิง</strong> คือตัวเลือกของนักเดินป่าและช่างภาพ — เงียบกว่า บูรณะน้อยกว่า มีหอคอย 67 หอ และเปิดก่อนรุ่งสางเพื่อล่าทะเลหมอก <strong>ซือหมาถาย</strong> คือด่านที่บรรยากาศดีที่สุด — เปิดทัวร์กลางคืนตลอดปี และมีกู่เป่ยสุ่ยเจิ้นอยู่ที่เชิงกำแพง <strong>หวงฮวาเฉิง</strong> คือด่านที่แปลกที่สุด — ด่านเดียวที่กำแพงจมลงในน้ำ มีเรือและสะพานกระจก <strong>จูยงกวน</strong> คือด่านที่ใกล้และเงียบที่สุด — เป็นวงรอบในด่าน ไม่ใช่การไต่สันเขา และเป็นตัวเลือกที่ดีที่สุดสำหรับครึ่งวันหรือฤดูหนาว
      </p>
    </div>

    <!-- ============ IN THIS GUIDE ============ -->
    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#which-section" class="text-blue-600 hover:underline">🤔 ควรไปด่านไหน?</a></li>
        <li><a href="#night" class="text-blue-600 hover:underline">🌙 ขึ้นกำแพงตอนกลางคืนได้ไหม?</a></li>
        <li><a href="#badaling" class="text-blue-600 hover:underline">🏔️ ปาต๋าหลิง</a></li>
        <li><a href="#mutianyu" class="text-blue-600 hover:underline">🌳 มู่เถียนยวี่</a></li>
        <li><a href="#jinshanling" class="text-blue-600 hover:underline">☁️ จินซานหลิง</a></li>
        <li><a href="#simatai" class="text-blue-600 hover:underline">🌃 ซือหมาถาย</a></li>
        <li><a href="#huanghuacheng" class="text-blue-600 hover:underline">💧 หวงฮวาเฉิง</a></li>
        <li><a href="#juyongguan" class="text-blue-600 hover:underline">🏯 จูยงกวน</a></li>
        <li><a href="#tickets" class="text-blue-600 hover:underline">🎫 ตั๋วและการจอง</a></li>
        <li><a href="#best-time" class="text-blue-600 hover:underline">📅 ช่วงเวลาที่ดีที่สุด</a></li>
        <li><a href="#practical-tips" class="text-blue-600 hover:underline">👟 ต้องเตรียมอะไร?</a></li>
        <li><a href="#history" class="text-blue-600 hover:underline">📜 อิฐราชวงศ์หมิง ไม่ใช่ฉิน</a></li>
      </ul>
    </nav>

    <!-- ============ SECTION 1: WHICH SECTION ============ -->
    <hr class="border-gray-200 my-12" />
    <h2 id="which-section" class="text-3xl font-bold text-gray-900 mb-6 mt-12">🤔 ควรไปด่านไหน?</h2>
    <p class="text-lg leading-relaxed text-gray-700 mb-8">จริง ๆ แล้วทุกด่านคือกำแพงเดียวกัน แต่ไม่มีสองด่านที่ให้วันเดียวกันกับคุณ สิ่งที่ต่างกันจริง ๆ ไม่ใช่ระยะทางหรือราคาตั๋ว แต่เป็น <strong>คนเยอะแค่ไหน ต้องออกแรงมากแค่ไหน และกำแพงกำลังทำอะไรอยู่ตอนที่คุณไปถึง</strong> — ทอดข้ามสันเขา จมลงในทะเลสาบ หรือส่องสว่างอยู่บนท้องฟ้ายามค่ำคืน ด่านด้านล่างเรียงตามโอกาสที่จะเหมาะกับการมาเที่ยวครั้งแรกหรือครั้งที่สอง</p>

    <h3 class="text-xl font-bold text-gray-900 mb-4">เทียบกำแพงเมืองจีนทั้งหกด่าน</h3>

    <div class="overflow-x-auto mb-8 not-prose">
      <table class="w-full text-sm text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
        <thead>
          <tr class="bg-gray-900 text-white">
            <th class="px-3 py-3 font-bold align-bottom">ด่าน</th>
            <th class="px-3 py-3 font-bold align-bottom">ระยะจากปักกิ่ง</th>
            <th class="px-3 py-3 font-bold align-bottom">ความแออัด</th>
            <th class="px-3 py-3 font-bold align-bottom">ความยาก</th>
            <th class="px-3 py-3 font-bold align-bottom">ค่าเข้า</th>
            <th class="px-3 py-3 font-bold align-bottom">เวลาที่ใช้</th>
            <th class="px-3 py-3 font-bold align-bottom">เหมาะกับเด็ก?</th>
            <th class="px-3 py-3 font-bold align-bottom">จุดเด่น</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">ปาต๋าหลิง</td>
            <td class="px-3 py-3">70 กม. · รถไฟความเร็วสูง ~35 นาที</td>
            <td class="px-3 py-3">มากสุด ๆ</td>
            <td class="px-3 py-3">ง่าย</td>
            <td class="px-3 py-3">¥40</td>
            <td class="px-3 py-3">3–4 ชม.</td>
            <td class="px-3 py-3">ได้ (กระเช้า)</td>
            <td class="px-3 py-3">ความยิ่งใหญ่ — และโชว์ไฟกลางคืนที่ใหญ่ที่สุด</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-3 py-3 font-semibold">มู่เถียนยวี่</td>
            <td class="px-3 py-3">70 กม. · ขับรถ ~1.5 ชม.</td>
            <td class="px-3 py-3">ปานกลาง</td>
            <td class="px-3 py-3">ง่าย–ปานกลาง</td>
            <td class="px-3 py-3">¥45</td>
            <td class="px-3 py-3">ครึ่งวัน</td>
            <td class="px-3 py-3">ได้ (กระเช้า + รางเลื่อน)</td>
            <td class="px-3 py-3">หอคอยที่บูรณะแล้ว 23 หอ แล้วนั่งรางเลื่อนลง</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">จินซานหลิง</td>
            <td class="px-3 py-3">130 กม. · ขับรถ ~2.5 ชม.</td>
            <td class="px-3 py-3">น้อย</td>
            <td class="px-3 py-3">หนัก</td>
            <td class="px-3 py-3">¥65</td>
            <td class="px-3 py-3">ทั้งวัน</td>
            <td class="px-3 py-3">ไม่เหมาะ</td>
            <td class="px-3 py-3">หอคอย 67 หอเรียงชิด ทะเลหมอกยามรุ่งอรุณ</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-3 py-3 font-semibold">ซือหมาถาย</td>
            <td class="px-3 py-3">120 กม. · ขับรถ ~2.5 ชม.</td>
            <td class="px-3 py-3">น้อย</td>
            <td class="px-3 py-3">หนัก</td>
            <td class="px-3 py-3">กลางวัน ¥40</td>
            <td class="px-3 py-3">ครึ่งวัน–ทั้งวัน</td>
            <td class="px-3 py-3">เด็กโต</td>
            <td class="px-3 py-3">กำแพงที่ส่องไฟเหนือกู่เป่ยสุ่ยเจิ้นยามค่ำ</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">หวงฮวาเฉิง</td>
            <td class="px-3 py-3">60 กม. · ขับรถ ~1.5 ชม.</td>
            <td class="px-3 py-3">น้อย–ปานกลาง</td>
            <td class="px-3 py-3">ปานกลาง</td>
            <td class="px-3 py-3">¥58</td>
            <td class="px-3 py-3">ครึ่งวัน</td>
            <td class="px-3 py-3">ได้</td>
            <td class="px-3 py-3">กำแพงที่เดินลงไปในทะเลสาบตรง ๆ</td>
          </tr>
          <tr>
            <td class="px-3 py-3 font-semibold">จูยงกวน</td>
            <td class="px-3 py-3">60 กม. · ขับรถ ~1 ชม.</td>
            <td class="px-3 py-3">น้อย</td>
            <td class="px-3 py-3">ปานกลาง</td>
            <td class="px-3 py-3">¥45 (เม.ย.–ต.ค.)</td>
            <td class="px-3 py-3">ครึ่งวัน</td>
            <td class="px-3 py-3">ได้</td>
            <td class="px-3 py-3">「ด่านที่ 1 ใต้หล้า」 — และรถไฟทะเลดอกไม้</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-lg leading-relaxed text-gray-700 mb-8">ราคาข้างต้นเป็นตั๋วผู้ใหญ่ในฤดูท่องเที่ยว นักเรียนมักจ่ายครึ่งราคา และเด็กที่สูงต่ำกว่า 1.2 ม. โดยทั่วไปเข้าฟรี ราคาเปลี่ยนตามฤดูและด่าน — โปรดตรวจสอบก่อนออกเดินทาง</p>

    <!-- ============ SECTION 2: NIGHT ============ -->
    <hr class="border-gray-200 my-12" />
    <h2 id="night" class="text-3xl font-bold text-gray-900 mb-6 mt-12">🌙 ขึ้นกำแพงตอนกลางคืนได้ไหม?</h2>
    <p class="text-lg leading-relaxed text-gray-700 mb-8">สิ่งที่แยกด่านเหล่านี้ออกจากกันไม่ใช่ระยะทางหรือราคา แต่เป็นคำถามจริง ๆ สามข้อ: <strong>ขึ้นได้โดยไม่ต้องปีนไหม มีรถรับส่งจากลานจอดไหม และเปิดหลังมืดไหม</strong> นี่คือภาพทั้งหมด</p>

    <div class="overflow-x-auto mb-8 not-prose">
      <table class="w-full text-sm text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
        <thead>
          <tr class="bg-gray-900 text-white">
            <th class="px-3 py-3 font-bold align-bottom">ด่าน</th>
            <th class="px-3 py-3 font-bold align-bottom">ทัวร์กลางคืน</th>
            <th class="px-3 py-3 font-bold align-bottom">วิธีขึ้น</th>
            <th class="px-3 py-3 font-bold align-bottom">รถรับส่ง / ต่อรถ</th>
            <th class="px-3 py-3 font-bold align-bottom">ไฮไลต์พิเศษ</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">ปาต๋าหลิง</td>
            <td class="px-3 py-3">✅ ทุกคืน 30 เม.ย.–6 ต.ค. (เข้า 18:30–21:00)</td>
            <td class="px-3 py-3">กระเช้าหรือกระเช้าพื้นดิน ¥100 ต่อเที่ยว</td>
            <td class="px-3 py-3">รถรับส่งในพื้นที่ฟรี; 「รถบัสกำแพงเมืองจีน」 ไป-กลับ ¥80</td>
            <td class="px-3 py-3">ไฟส่องกำแพงจากหอเหนือ 4 ถึงหอใต้ 4</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-3 py-3 font-semibold">มู่เถียนยวี่</td>
            <td class="px-3 py-3">✅ เปิดตามฤดู (ฤดูร้อน; วันชาติ)</td>
            <td class="px-3 py-3">ขึ้นกระเช้า ลงรางเลื่อน</td>
            <td class="px-3 py-3">รถรับส่งไป-กลับ ¥15</td>
            <td class="px-3 py-3">ล่องรางเลื่อน</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">จินซานหลิง</td>
            <td class="px-3 py-3">❌</td>
            <td class="px-3 py-3">กระเช้า ¥40 ต่อเที่ยว / ¥60 ไป-กลับ</td>
            <td class="px-3 py-3">รถรับส่งเที่ยวเดียว ~¥80</td>
            <td class="px-3 py-3">ทะเลหมอกยามพระอาทิตย์ขึ้น</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-3 py-3 font-semibold">ซือหมาถาย</td>
            <td class="px-3 py-3">✅ ตลอดปี (18:00–21:30)</td>
            <td class="px-3 py-3">กระเช้า — บังคับหลังมืด</td>
            <td class="px-3 py-3">—</td>
            <td class="px-3 py-3">กู่เป่ยสุ่ยเจิ้นที่เชิงกำแพง</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-3 py-3 font-semibold">หวงฮวาเฉิง</td>
            <td class="px-3 py-3">❌</td>
            <td class="px-3 py-3"><strong>ไม่มีกระเช้า</strong> — ลงด้วยรางสไลด์แม่เหล็กตามทางเดินไม้</td>
            <td class="px-3 py-3">รถบัสหรือรถส่วนตัว</td>
            <td class="px-3 py-3">ล่องเรือในทะเลสาบ และสะพานกระจก</td>
          </tr>
          <tr>
            <td class="px-3 py-3 font-semibold">จูยงกวน</td>
            <td class="px-3 py-3">✅ คืนศุกร์–เสาร์ + วันหยุด ถึงต้น ต.ค.</td>
            <td class="px-3 py-3"><strong>ไม่มีกระเช้า</strong> — ขึ้นและลงด้วยการเดิน</td>
            <td class="px-3 py-3">—</td>
            <td class="px-3 py-3">เทศกาลกลางคืนธีมหมิงในด่าน</td>
          </tr>
        </tbody>
      </table>
    </div>

