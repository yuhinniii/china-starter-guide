---
import Layout from '@layouts/Layout.astro';
const title = 'คู่มือเมืองจีน — จุดหมายปลายทาง';
const description = 'ค้นหาเมืองที่เหมาะสำหรับทริปจีนของคุณ';
---

<Layout title={title} description={description} lang="th">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🏙️ Cities</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">ซิลิคอนแวลลีย์ของจีน ปั่นจักรยานเลียบชายฝั่ง และรถไฟ 15 นาทีถึงฮ่องกง</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">ธรรมชาติและทิวทัศน์</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/cities/hainan-visa-free/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🏝️ Hainan</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือท่องเที่ยวไห่หนาน — ยกเว้นวีซ่า 30 วัน</p>
            <p class="text-sm text-gray-600 mt-0.5">ชายหาดเขตร้อน ป่าฝน และเข้าประเทศโดยไม่ต้องขอวีซ่าสำหรับ 59 ประเทศ</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-orange-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-orange-800">อาหารและวิถีชีวิต</h2>
          <span class="text-xs font-medium text-orange-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/cities/guangzhou-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🥟 Guangzhou</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือท่องเที่ยวกวางโจว — เมืองหลวงแห่งอาหารของจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">ติ่มซำ หอคอยกวางตุ้ง เกาะชาเมียนและประตูสู่จีนตอนใต้</p>
          </a>
          <a href="/th/cities/chengdu-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🐼 Chengdu</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือท่องเที่ยวเฉิงตู — หมีแพนด้า อาหารเผ็ดและชีวิตช้า</p>
            <p class="text-sm text-gray-600 mt-0.5">หมีแพนด้ายักษ์ หม้อไฟเสฉวน ร้านน้ำชาและประตูสู่จิ่วจ้ายโกว</p>
          </a>
        </div>
      </div>
    </div>

    <!-- คู่มือที่เกี่ยวข้อง -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/th/transport/high-speed-rail/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">รถไฟความเร็วสูง</p>
          <p class="text-sm text-gray-500">Getting between cities</p>
        </a>
        <a href="/th/transport/metro-bus/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">รถไฟใต้ดินและรถเมล์</p>
          <p class="text-sm text-gray-500">Getting around city centers</p>
        </a>
      </div>
    </div>
  </section>
</Layout>