---
import Layout from '@layouts/Layout.astro';
const title = 'คู่มือเมืองจีน — จุดหมายปลายทางท่องเที่ยว';
const description = 'ค้นหาเมืองที่ใช่สำหรับทริปจีนของคุณ';
---

<Layout title={title} description={description} lang="th">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🏙️ เมือง</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">คู่มือเมืองจีน</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">ค้นหาเมืองที่ใช่สำหรับทริปจีนของคุณ</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">6</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">คู่มือเมือง</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">ตัววางแผน itineraries</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">3</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">ภูมิภาคที่ครอบคลุม</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">วางแผนทริปของคุณ</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">1 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/cities/city-select/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🧭 วางแผน</span>
            <p class="text-base font-bold text-gray-900 mt-1">ควรเที่ยวจีนกี่วัน?</p>
            <p class="text-sm text-gray-600 mt-0.5">วางแผน itineraries ที่สมบูรณ์แบบ — จาก 3 วันเร่งด่วนถึง 3 สัปดาห์ผจญภัย</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">ประวัติศาสตร์และวัฒนธรรม</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/cities/beijing-guide/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🏛️ ปักกิ่ง</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือเที่ยวปักกิ่ง: สถานที่เที่ยว อาหาร และสิ่งที่ต้องรู้</p>
            <p class="text-sm text-gray-600 mt-0.5">พระราชวังต้องห้าม, กำแพงเมืองจีน, หูถง, เป็ดปักกิ่ง, และเคล็ดลับสำคัญ</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">ทันสมัยและเมือง</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/cities/shanghai-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🌆 เซี่ยงไฮ้</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือเที่ยวเซี่ยงไฮ้: เมืองที่เป็นมิตรกับชาวต่างชาติที่สุด</p>
            <p class="text-sm text-gray-600 mt-0.5">เดอะบันด์, เซี่ยงไฮ้ทาวเวอร์, เขตฝรั่งเศส, และร้านอาหารระดับโลก</p>
          </a>
          <a href="/th/cities/shenzhen-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🏙️ เซินเจิ้น</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือเที่ยวเซินเจิ้น: ศูนย์กลางเทคโนโลยีติดกับฮ่องกง</p>
            <p class="text-sm text-gray-600 mt-0.5">ซิลิคอนวัลเลย์ของจีน, ปั่นจักรยานเลียบทะเล, และรถไฟ 15 นาทีถึงฮ่องกง</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">ธรรมชาติและทิวทัศน์</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/cities/hainan-visa-free/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🏝️ ไหหลำ</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือเที่ยวไหหลำ — ยกเว้นวีซ่า 30 วัน</p>
            <p class="text-sm text-gray-600 mt-0.5">ชายหาดเขตร้อน, ป่าฝน, และยกเว้นวีซ่าสำหรับ 59 ประเทศ</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-orange-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-orange-800">อาหารและวิถีชีวิต</h2>
          <span class="text-xs font-medium text-orange-800 opacity-60">2 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/cities/guangzhou-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🥟 กวางโจว</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือเที่ยวกวางโจว: เมืองหลวงอาหารของจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">ติ่มซำ, หอคอยกวางโจว, เกาะซาเมี่ยน, และประตูสู่จีนตอนใต้</p>
          </a>
          <a href="/th/cities/chengdu-guide/" class="block bg-orange-50 border border-orange-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-orange-800">🐼 เฉิงตู</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือเที่ยวเฉิงตู: หมีแพนด้า อาหารเผ็ด และชีวิตชิลล์</p>
            <p class="text-sm text-gray-600 mt-0.5">หมีแพนด้ายักษ์, หม้อไฟเสฉวน, ร้านน้ำชา, และประตูสู่จิ่วจ้ายโกว</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/th/transport/high-speed-rail/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">รถไฟความเร็วสูง</p>
          <p class="text-sm text-gray-500">การเดินทางระหว่างเมือง</p>
        </a>
        <a href="/th/transport/metro-bus/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">รถไฟใต้ดินและรถบัส</p>
          <p class="text-sm text-gray-500">การเดินทางในใจกลางเมือง</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
