---
import Layout from '@layouts/Layout.astro';
const title = 'ติดต่อเรา — China Starter Hub';
const description = 'ติดต่อเราได้หากมีคำถาม ข้อเสนอแนะ หรือต้องการร่วมงาน';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">ติดต่อ</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">ติดต่อเรา</h1>
      <p class="text-gray-500  ">มีคำถามหรือข้อเสนอแนะ? เรายินดีรับฟังความคิดเห็นจากคุณ</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4">
        <p class="text-sm text-gray-500  ">อีเมลกำลังจะมาเร็ว ๆ นี้ สำหรับตอนนี้ ติดตามข้อมูลอัปเดตของเราบนโซเชียลมีเดีย</p>
      </div>
    </div>
  </article>
</Layout>
