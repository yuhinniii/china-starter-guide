---
import Layout from '@layouts/Layout.astro';
const title = 'ติดต่อเรา — China Starter Hub';
const description = 'มีคำถามหรือข้อเสนอแนะ เรายินดีรับฟังความคิดเห็นของคุณ';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">ติดต่อ</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">ติดต่อเรา</h1>
      <p class="text-gray-500  ">มีคำถามหรือข้อเสนอแนะ เรายินดีรับฟังความคิดเห็นของคุณ</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4 text-center">
        <p class="text-gray-700 text-lg">ส่งอีเมลถึงเราที่ <a href="mailto:hello@chinastarterhub.com" class="text-brand-600 font-medium hover:underline">hello@chinastarterhub.com</a></p>
      </div>
    </div>
  </article>
</Layout>
