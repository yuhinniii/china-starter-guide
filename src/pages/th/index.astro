      'GE':'จอร์เจีย','DE':'เยอรมนี','GR':'กรีซ','GD':'เกรเนดา','HU':'ฮังการี',      'IS':'ไอซ์แลนด์','IE':'ไอร์แลนด์','IN':'อินเดีย','ID':'อินโดนีเซีย','IT':'อิตาลี',
      'JP':'ญี่ปุ่น','KZ':'คาซัคสถาน','KE':'เคนยา','KW':'คูเวต','LV':'ลัตเวีย','LI':'ลิกเตนสไตน์',
      'LT':'ลิทัวเนีย','LU':'ลักเซมเบิร์ก','MY':'มาเลเซีย','MV':'มัลดีฟส์','MT':'มอลตา','MU':'มอริเชียส',
      'MX':'เม็กซิโก',
      'MC':'โมนาโก','ME':'มอนเตเนโกร',      'NL':'เนเธอร์แลนด์','NZ':'นิวซีแลนด์','NG':'ไนจีเรีย','MK':'นอร์ทมาซิโดเนีย',
      'NO':'นอร์เวย์','OM':'โอมาน','PK':'ปากีสถาน','PE':'เปรู','PH':'ฟิลิปปินส์','PL':'โปแลนด์','PT':'โปรตุเกส','QA':'กาตาร์','RO':'โรมาเนีย',
      'RU':'รัสเซีย','WS':'ซามัว','SM':'ซานมารีโน','SA':'ซาอุดีอาระเบีย','RS':'เซอร์เบีย','SC':'เซเชลส์',
      'SG':'สิงคโปร์','SK':'สโลวาเกีย','SI':'สโลวีเนีย','SB':'หมู่เกาะโซโลมอน','ZA':'แอฟริกาใต้','KR':'เกาหลีใต้',
      'ES':'สเปน','SR':'ซูรินาม','SE':'สวีเดน','CH':'สวิตเซอร์แลนด์','TH':'ไทย','TO':'ตองกา','TR':'ตุรกี',
      'UA':'ยูเครน',
      'AE':'สหรัฐอาหรับเอมิเรตส์','GB':'สหราชอาณาจักร','US':'สหรัฐอเมริกา','UY':'อุรุกวัย','UZ':'อุซเบกิสถาน','VN':'เวียดนาม'
    };

    countrySelect.addEventListener('change', function() {
      const val = this.value;
      if (!val) {
        resultDiv.innerHTML = '';
        return;
      }

      const name = countryNames[val] || 'ประเทศของคุณ';
      const status = getVisaStatus(val);

      if (status === 'visa-free-30') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">ข่าวดี! พลเมืองของ ' + name + ' สามารถเข้าจีนแบบ <span class="underline">ไม่ต้องใช้วีซ่า</span> ได้สูงสุด 30 วัน</p><p class="text-green-700 text-sm mb-3">ไม่ต้องใช้วีซ่าสำหรับการท่องเที่ยว ธุรกิจ หรือการต่อเครื่องที่น้อยกว่า 30 วัน</p><a href="/th/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">ดูรายชื่อประเทศที่ยกเว้นวีซ่าทั้งหมด \u2192</a></div>';
      } else if (status === 'mutual-free') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">พลเมืองของ ' + name + ' สามารถเข้าจีนแบบ <span class="underline">ไม่ต้องใช้วีซ่า</span> ภายใต้ข้อตกลงร่วม</p><p class="text-green-700 text-sm mb-3">ตรวจสอบประเภทพาสปอร์ตและระยะเวลาที่อนุญาตก่อนเดินทาง</p><a href="/th/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">ดูรายชื่อประเทศที่ยกเว้นวีซ่า \u2192</a></div>';
      } else if (status === 'transit') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-blue-50 border border-blue-200"><p class="text-blue-800 font-semibold mb-1">คุณสามารถใช้ <span class="underline">นโยบายการต่อเครื่อง 240 ชั่วโมง</span> ได้</p><p class="text-blue-700 text-sm mb-3">พลเมืองของ ' + name + ' สามารถเปลี่ยนเครื่องผ่านจีนได้สูงสุด 10 วันโดยไม่ต้องใช้วีซ่า สำหรับการพัก longer คุณจะต้องใช้วีซ่า L</p><div class="flex flex-wrap gap-3"><a href="/th/visa/transit-240/" class="text-sm font-medium text-blue-700 underline hover:no-underline">วิธีการต่อเครื่อง \u2192</a><a href="/th/visa/apply-l-visa/" class="text-sm font-medium text-blue-700 underline hover:no-underline">ยื่นขอวีซ่า L \u2192</a></div></div>';
      } else {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-orange-50 border border-orange-200"><p class="text-orange-800 font-semibold mb-1">คุณจำเป็นต้องใช้วีซ่า</p><p class="text-orange-700 text-sm mb-3">พลเมืองของ ' + name + ' ต้องยื่นขอวีซ่าท่องเที่ยว (ประเภท L) ก่อนเดินทางไปจีน</p><a href="/th/visa/apply-l-visa/" class="inline-block text-sm font-medium text-orange-700 underline hover:no-underline">วิธีการยื่นขอวีซ่า L \u2192</a></div>';
      }
    });
  </script>
    <p class="text-xs text-gray-400 text-center mt-8">อัปเดตล่าสุด: กรกฎาคม 2026</p>
</Layout>
