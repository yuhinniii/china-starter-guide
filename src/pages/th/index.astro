---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Hub — คู่มือการเดินทางจีนที่ดีที่สุด';
const description = 'ทุกสิ่งที่คุณต้องรู้ก่อนมาเที่ยวจีน: การชำระเงิน การเดินทาง แอปพลิเคชัน เมือง และเคล็ดลับการท่องเที่ยว';
---

<Layout title={title} description={description} lang="th">
  <!-- Trigger rebuild: 2026-06-12 17:30 -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900  ">
      คำแนะนำที่ชัดเจน ทันสมัย สำหรับ<br/><span class="text-brand-600">นักท่องเที่ยวต่างชาติครั้งแรกที่มาเยือนจีน</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-500  ">
      เริ่มต้นด้วยสิ่งจำเป็น แล้วตามคู่มือที่เหมาะกับการเดินทางของคุณ
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/th/visa/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">เริ่มต้น</a>
      <a href="/th/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">เกี่ยวกับเว็บไซต์นี้</a>
    </div>
  </section>

  <!-- Section: Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/th/visa/', title: 'วีซ่า', desc: 'ประเภทวีซ่า ประเทศที่ยกเว้น และนโยบายการต่อเครื่อง' },
        { href: '/th/payment/', title: 'การชำระเงิน', desc: 'กระเป๋าเงินดิจิทัล บัตรธนาคาร และเงินสดสำรอง' },
        { href: '/th/transport/', title: 'การเดินทาง', desc: 'รถไฟความเร็วสูง รถไฟใต้ดิน เรียกแท็กซี่ และจากสนามบินสู่เมือง' },
        { href: '/th/life/', title: 'ชีวิตในจีน', desc: 'แอปพลิเคชัน การรักษาพยาบาล เคล็ดลับความปลอดภัย การใช้ชีวิตประจำวัน' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  :text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Your Trip: Step by Step -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">การเดินทางของคุณ ทีละขั้นตอน</h2>
    <p class="text-gray-500 mb-10">ทำตามขั้นตอนของคุณ — แต่ละขั้นเชื่อมโยงไปยังคู่มือที่คุณต้องการจริง ๆ</p>

    <div class="space-y-8">
      <!-- Stage 1 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-green-100 flex items-center justify-center text-sm font-bold text-green-700">1</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">ก่อนออกเดินทาง</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/th/visa/visa-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">เตรียมการ</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">คุณต้องใช้วีซ่าประเภทไหน?</p>
          </a>
          <a href="/th/payment/payment-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">การชำระเงิน</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">วิธีชำระเงินในจีน</p>
          </a>
          <a href="/th/life/survival-kit/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">ชีวิต</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">รายการตรวจสอบก่อนเดินทาง</p>
          </a>
        </div>
      </div>

      <!-- Stage 2 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-sm font-bold text-blue-700">2</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">เพิ่งถึง</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/th/transport/airport-to-city/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">การเดินทาง</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">จากสนามบินสู่เมือง</p>
          </a>
          <a href="/th/life/sim-card-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">ชีวิต</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">ซิมการ์ดและอินเทอร์เน็ต</p>
          </a>
          <a href="/th/life/vpn-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">ชีวิต</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">ตั้งค่า VPN</p>
          </a>
        </div>
      </div>

      <!-- Stage 3 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-purple-100 flex items-center justify-center text-sm font-bold text-purple-700">3</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">ระหว่างทริป</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/th/transport/transport-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">การเดินทาง</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">การเดินทางภายในจีน</p>
          </a>
          <a href="/th/life/essential-apps/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">ชีวิต</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">10 แอปจำเป็น</p>
          </a>
          <a href="/th/life/chinese-phrases/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">ชีวิต</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">ประโยคภาษาจีนพื้นฐาน</p>
          </a>
        </div>
      </div>

      <!-- Stage 4 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-red-100 flex items-center justify-center text-sm font-bold text-red-700">4</div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">ต้องการความช่วยเหลือ?</h3>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
