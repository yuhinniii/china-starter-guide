            <span class="text-xs font-medium text-red-600">ชีวิต</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">การพบแพทย์</p>
          </a>
          <a href="/th/life/common-scams/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">ชีวิต</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">หลีกเลี่ยงกลลวงทั่วไป</p>
          </a>
          <a href="/th/life/emergency-numbers/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">ชีวิต</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">เบอร์ติดต่อฉุกเฉิน</p>
          </a>
          <a href="/th/payment/payment-fails/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">การชำระเงิน</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">เมื่อการชำระเงินล้มเหลว</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visa Checker Tool -->
