---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Hub — คู่มือการเดินทางจีนที่ดีที่สุด';
const description = 'ทุกสิ่งที่คุณต้องรู้ก่อนมาเที่ยวจีน: การชำระเงิน การเดินทาง แอปพลิเคชัน เมือง และเคล็ดลับการท่องเที่ยว';
---

<Layout title={title} description={description} lang="th">
  <!-- Trigger rebuild: 2026-06-12 17:30 -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900">
      เดินทางจีนอย่างมั่นใจ —<br/><span class="text-brand-600">คำแนะนำทีละขั้นตอนจากวีซ่าสู่การชำระเงินและการเดินทาง</span>
    </h1>
    <div class="flex flex-wrap justify-center gap-4 mt-10">
      <a href="/th/visa/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">เริ่มต้น</a>
      <a href="/th/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">เกี่ยวกับเว็บไซต์นี้</a>
    </div>
  </section>  <!-- Section: Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/th/visa/', title: 'วีซ่า', desc: 'ประเภทวีซ่า ประเทศที่ยกเว้น และนโยบายการต่อเครื่อง' },
        { href: '/th/payment/', title: 'การชำระเงิน', desc: 'กระเป๋าเงินดิจิทัล บัตรธนาคาร และเงินสดสำรอง' },
        { href: '/th/transport/', title: 'การเดินทาง', desc: 'รถไฟความเร็วสูง รถไฟใต้ดิน เรียกแท็กซี่ และจากสนามบินสู่เมือง' },
        { href: '/th/life/', title: 'ชีวิตในจีน', desc: 'แอปพลิเคชัน การรักษาพยาบาล เคล็ดลับความปลอดภัย การใช้ชีวิตประจำวัน' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  group-hover:text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

<!-- Interactive Pre-Departure Checklist -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">รายการตรวจสอบการเดินทางจีน</h2>
    <p class="text-gray-500 mb-4">ตั้งแต่หนึ่งเดือนก่อนถึงวันแรก — ทำเครื่องหมายแต่ละรายการเมื่อทำเสร็จ</p>

    <!-- Time Filter -->
    <div id="checklist-filter" class="flex flex-wrap gap-2 mb-5">
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-brand-50 text-brand-700 text-sm font-medium cursor-pointer transition hover:border-brand-300 active" data-show="all">ทุกขั้นตอน</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="1">1 เดือนก่อน</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="2">2 สัปดาห์ก่อน</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="3">1 สัปดาห์ก่อน</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="4,5">ถึงแล้ว</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="6">วันที่ 1</button>
    </div>

    <!-- Overall Progress -->
    <div id="checklist-progress" class="bg-gray-50 rounded-2xl p-5 mb-10">
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-sm font-semibold text-gray-700">ความคืบหน้าโดยรวม</span>
        <span id="progress-text" data-suffix="เสร็จแล้ว" class="text-base font-bold text-brand-600">0 จาก 23 เสร็จแล้ว</span>
      </div>
      <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width:0%"></div>
      </div>
    </div>

    <div class="space-y-8">

      <!-- Stage 1: T-30 วัน · หนึ่งเดือนก่อนบิน -->
      <div class="relative pl-12 stage-group" data-stage="1">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-xs font-bold text-green-700">1</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-green-700">T-30 วัน</span> · หนึ่งเดือนก่อนบิน
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="1">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="1">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-passport">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">01</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">ตรวจสอบอายุหนังสือเดินทาง</p>
              <p class="text-sm text-gray-500 mt-0.5">หลายประเทศกำหนดให้พาสปอร์ตมีอายุเหลืออย่างน้อย 6 เดือนนับจากวันเดินทางเพื่อขอวีซ่าจีน ตรวจสอบก่อนเดินทาง</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-visa">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">02</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">ยืนยันประเภทวีซ่าหรือการยกเว้นวีซ่า</p>
              <p class="text-sm text-gray-500 mt-0.5">ต้องใช้วีซ่าหรือไม่? เข้าข่ายการผ่านเมือง 240 ชม.? ตรวจสอบด้วยเครื่องมือด้านบนใน 30 วินาที</p>
            </div>
            <a href="/th/visa/visa-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ คู่มือ →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="travel-insurance">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">03</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">ซื้อประกันการเดินทางที่มีความคุ้มครองทางการแพทย์</p>
              <p class="text-sm text-gray-500 mt-0.5">รพ.จีนต้องจ่ายล่วงหน้า แนะนำประกันการเดินทางที่มีความคุ้มครองการแพทย์ขั้นต่ำ 100,000 ดอลลาร์</p>
            </div>
            <a href="/th/life/travel-insurance/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ คู่มือ →</a>
          </div>
        </div>
      </div>

      <!-- Stage 2: T-15 วัน · สองสัปดาห์ก่อน -->
      <div class="relative pl-12 stage-group" data-stage="2">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-xs font-bold text-blue-700">2</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-blue-700">T-15 วัน</span> · สองสัปดาห์ก่อน
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="2">0/6 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="2">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="buy-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">04</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">ซื้อและติดตั้ง VPN</p>
              <p class="text-sm text-gray-500 mt-0.5">ไม่สามารถดาวน์โหลด VPN จากภายในจีนได้ — เว็บไซต์ถูกบล็อก ติดตั้งและทดสอบจากที่บ้านก่อนเดินทาง</p>
            </div>
            <a href="/th/life/vpn-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ คู่มือ →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="buy-esim">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">05</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">ซื้อ eSIM</p>
              <p class="text-sm text-gray-500 mt-0.5">เลือก eSIM ที่ครอบคลุมจีน  ideally one routing through Hong Kong ติดตั้งก่อนเดินทาง</p>
            </div>
            <a href="/th/life/sim-card-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ คู่มือ →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="setup-alipay">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">06</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">ตั้งค่า Alipay และเชื่อมต่อบัตร</p>
              <p class="text-sm text-gray-500 mt-0.5">เชื่อมต่อบัตรเครดิตและบัตรเดบิต รหัส QR ส่วนตัวไม่รับบัตรเครดิต แต่บัตรเดบิตใช้ได้</p>
            </div>
            <a href="/th/payment/payment-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ คู่มือ →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="setup-wechat">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">07</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">ตั้งค่า WeChat Pay (สำรองเสริม)</p>
              <p class="text-sm text-gray-500 mt-0.5">Alipay ครอบคลุม 95% แต่ร้านเล็กบางแห่งใช้ WeChat เท่านั้น ตั้งค่าเป็นตัวสำรอง</p>
            </div>
            <a href="/th/payment/setup-wechat/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ คู่มือ →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="book-hotel">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">08</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">จองโรงแรมที่รับผู้เข้าพักต่างชาติ</p>
              <p class="text-sm text-gray-500 mt-0.5">ไม่ใช่ทุกโรงแรมที่รับพาสปอร์ตต่างชาติ จองผ่าน Trip.com และกรองรีวิวจากชาวต่างชาติ</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="notify-bank">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">09</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">แจ้งธนาคารว่าคุณกำลังเดินทางไปจีน</p>
              <p class="text-sm text-gray-500 mt-0.5">ธนาคารบางแห่งบล็อกธุรกรรมในจีนว่าเป็นการฉ้อโกง ตั้งค่าการแจ้งเตือนในแอปฯ หรือโทรแจ้ง — โทร 5 นาทีช่วยลดปัญหา</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 3: T-7 วัน · ก่อนออกเดินทาง -->
      <div class="relative pl-12 stage-group" data-stage="3">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-xs font-bold text-indigo-700">3</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-indigo-700">T-7 วัน</span> · ก่อนออกเดินทาง
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="3">0/4 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="3">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="test-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">10</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">ทดสอบ VPN บนทุกอุปกรณ์</p>
              <p class="text-sm text-gray-500 mt-0.5">ยืนยันว่าเชื่อมต่อได้บนโทรศัพท์ โน้ตบุ๊ก และแท็บเล็ต ในจีนเว็บไซต์ผู้ให้บริการ VPN ก็ถูกบล็อกเช่นกัน</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="install-apps">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">11</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">ติดตั้งแอปจำเป็นสำหรับการเดินทางจีน</p>
              <p class="text-sm text-gray-500 mt-0.5">Baidu Maps, Didi, Trip.com. ดาวน์โหลดตอนนี้ก่อนที่ App Store จะถูกจำกัด</p>
            </div>
            <a href="/th/life/essential-apps/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ คู่มือ →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="learn-chinese">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">12</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">เรียนรู้วลีจีนพื้นฐาน 10 วลี</p>
              <p class="text-sm text-gray-500 mt-0.5">การพูด "ขอบคุณ" และ "เท่าไหร่" เปลี่ยนวิธีที่คนปฏิบัติต่อคุณ เริ่มจากพื้นฐาน</p>
            </div>
            <a href="/th/life/chinese-phrases/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">→ คู่มือ →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="backup-docs">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">13</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">บันทึกสำเนาดิจิทัลของพาสปอร์ต วีซ่า ประกัน</p>
              <p class="text-sm text-gray-500 mt-0.5">เก็บรูปถ่ายหรือสแกนไว้ในโทรศัพท์และคลาวด์ หากเอกสารสูญหาย สำเนาคือทางเลือกสุดท้าย</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 4: T-24 ชม. · เตรียมตัวสุดท้าย -->
      <div class="relative pl-12 stage-group" data-stage="4">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-xs font-bold text-amber-700">4</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-amber-700">T-24 ชม.</span> · เตรียมตัวสุดท้าย
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="4">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="4">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-in">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">16</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
