---
import Layout from '@layouts/Layout.astro';
const title = "วลีภาษาจีนที่จำเป็นสำหรับนักเดินทาง";
const description = "เรียนรู้วลีภาษาจีนพื้นฐานเหล่านี้ก่อนการเดินทาง — การออกเสียง เมื่อไรควรใช้ และเคล็ดลับการสื่อสาร";
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปชีวิตในจีน
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🗣️ ชีวิตในจีน</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        วลีภาษาจีนที่จำเป็นสำหรับนักเดินทาง
      </h1>
      <p class="text-xl text-gray-600 mb-6">สิบกว่าประโยคจะเปลี่ยนวิธีที่ผู้คนปฏิบัติต่อคุณ</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 4 นาที</span>
      </div>
    </header>

        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 คำตอบด่วน</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        คุณไม่จำเป็นต้องพูดภาษาจีนเพื่อเที่ยวจีน แต่การเรียนรู้สักสิบกว่าประโยคจะทำให้ทริปของคุณดีขึ้นอย่างมาก — คนท้องถิ่นชื่นชมความพยายามจริง ๆ และคุณจะพบว่าตัวเองได้รับบริการที่ดีกว่า รอยยิ้มที่อบอุ่นกว่า และแม้กระทั่งราคาที่ดีกว่าที่ตลาด
      </p>
    </div>

        <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#greetings" class="text-blue-600 hover:underline">👋 การทักทายและความสุภาพ</a></li>
        <li><a href="#eating" class="text-blue-600 hover:underline">🍽️ การกินและการสั่งอาหาร</a></li>
        <li><a href="#shopping" class="text-blue-600 hover:underline">🛍️ การช้อปปิ้งและราคา</a></li>
        <li><a href="#getting-around" class="text-blue-600 hover:underline">🚇 การเดินทาง</a></li>
        <li><a href="#emergencies" class="text-blue-600 hover:underline">🆘 เหตุฉุกเฉิน</a></li>
        <li><a href="#pronunciation" class="text-blue-600 hover:underline">🎵 เคล็ดลับการออกเสียง</a></li>
      </ul>
    </nav>

    <div class="prose prose-lg max-w-none">
      <hr class="border-gray-200 my-12" />

            <h2 id="greetings" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">👋</span> การทักทายและความสุภาพ
      </h2>

      <div class="overflow-x-auto mb-6 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">วลีจีนพื้นฐานสำหรับนักเดินทาง</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">ภาษาอังกฤษ</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">พินอิน</th>
              <th class="px-6 py-4 font-bold">หมายเหตุ</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Hello</td><td class="px-6 py-4">你好</td><td class="px-6 py-4">Nǐ hǎo</td><td class="px-6 py-4">ใช้กับใครก็ได้ ทุกเวลา</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Thank you</td><td class="px-6 py-4">谢谢</td><td class="px-6 py-4">Xiè xiè</td><td class="px-6 py-4">พูดบ่อย ๆ — คนสังเกตเห็น</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Sorry / Excuse me</td><td class="px-6 py-4">对不起</td><td class="px-6 py-4">Duì bù qǐ</td><td class="px-6 py-4">ถ้าคุณชนใคร</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">It's okay</td><td class="px-6 py-4">没关系</td><td class="px-6 py-4">Méi guān xì</td><td class="px-6 py-4">ตอบกลับ "sorry"</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Goodbye</td><td class="px-6 py-4">再见</td><td class="px-6 py-4">Zài jiàn</td><td class="px-6 py-4">การลามาตรฐาน</td></tr>
          </tbody>
        </table>
      </div>

      <p class="text-lg leading-relaxed text-gray-700 mb-12"><strong>เคล็ดลับ:</strong> พูด "ขอบคุณ" หลังทุกการทำธุรกรรม — ที่ร้านอาหาร ร้านค้า แท็กซี่ มันช่วยได้มากในการปฏิสัมพันธ์ประจำวัน</p>

      <hr class="border-gray-200 my-12" />

            <h2 id="eating" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🍽️</span> การกินและการสั่งอาหาร
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">วลีจีนพื้นฐานสำหรับนักเดินทาง</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">ภาษาอังกฤษ</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">พินอิน</th>
              <th class="px-6 py-4 font-bold">หมายเหตุ</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Check, please</td><td class="px-6 py-4">买单</td><td class="px-6 py-4">Mǎi dān</td><td class="px-6 py-4">โบกมือเล็กน้อย</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Delicious!</td><td class="px-6 py-4">好吃！</td><td class="px-6 py-4">Hǎo chī!</td><td class="px-6 py-4">ชมเชยพ่อครัว</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">No spicy</td><td class="px-6 py-4">不加辣</td><td class="px-6 py-4">Bù jiā là</td><td class="px-6 py-4">จำเป็นในเสฉวน/หูหนาน</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Water, please</td><td class="px-6 py-4">请给我水</td><td class="px-6 py-4">Qǐng gěi wǒ shuǐ</td><td class="px-6 py-4">อย่าดื่มน้ำประปา</td></tr>
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="shopping" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🛍️</span> การช้อปปิ้งและราคา
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">วลีจีนพื้นฐานสำหรับนักเดินทาง</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">ภาษาอังกฤษ</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">พินอิน</th>
              <th class="px-6 py-4 font-bold">หมายเหตุ</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">How much?</td><td class="px-6 py-4">多少钱？</td><td class="px-6 py-4">Duō shǎo qián?</td><td class="px-6 py-4">คำถามราคาสากล</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Too expensive</td><td class="px-6 py-4">太贵了</td><td class="px-6 py-4">Tài guì le</td><td class="px-6 py-4">ใช้ที่ตลาดเท่านั้น</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Can you lower it?</td><td class="px-6 py-4">便宜一点？</td><td class="px-6 py-4">Pián yí yì diǎn?</td><td class="px-6 py-4">ใช้ที่ตลาด ไม่ใช่ร้านค้า</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">I'll take it</td><td class="px-6 py-4">我要这个</td><td class="px-6 py-4">Wǒ yào zhè ge</td><td class="px-6 py-4">เมื่อตัดสินใจแล้ว</td></tr>
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="getting-around" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🚇</span> การเดินทาง
      </h2>

      <div class="overflow-x-auto mb-6 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">วลีจีนพื้นฐานสำหรับนักเดินทาง</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">ภาษาอังกฤษ</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">พินอิน</th>
              <th class="px-6 py-4 font-bold">หมายเหตุ</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Where is...?</td><td class="px-6 py-4">...在哪里？</td><td class="px-6 py-4">...zài nǎ lǐ?</td><td class="px-6 py-4">แสดงชื่อสถานที่เป็นภาษาจีน</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">I'm going here</td><td class="px-6 py-4">去这里</td><td class="px-6 py-4">Qù zhè lǐ</td><td class="px-6 py-4">แสดงที่อยู่ให้คนขับ</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Stop here</td><td class="px-6 py-4">这里停</td><td class="px-6 py-4">Zhè lǐ tíng</td><td class="px-6 py-4">สำหรับแท็กซี่</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">How long?</td><td class="px-6 py-4">多久？</td><td class="px-6 py-4">Duō jiǔ?</td><td class="px-6 py-4">เวลาเดินทางหรือรอ</td></tr>
          </tbody>
        </table>
      </div>

      <p class="text-lg leading-relaxed text-gray-700 mb-12"><strong>เคล็ดลับมือโปร:</strong> แสดงปลายทางเป็นตัวอักษรจีนเสมอ</p>

      <hr class="border-gray-200 my-12" />

            <h2 id="emergencies" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🆘</span> เหตุฉุกเฉิน
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">วลีจีนพื้นฐานสำหรับนักเดินทาง</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">ภาษาอังกฤษ</th>
              <th class="px-6 py-4 font-bold">中文</th>
              <th class="px-6 py-4 font-bold">พินอิน</th>
              <th class="px-6 py-4 font-bold">หมายเหตุ</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">Help!</td><td class="px-6 py-4">救命！</td><td class="px-6 py-4">Jiù mìng!</td><td class="px-6 py-4">สำหรับเหตุฉุกเฉินจริงเท่านั้น</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">Call the police</td><td class="px-6 py-4">报警</td><td class="px-6 py-4">Bào jǐng</td><td class="px-6 py-4">เบอร์ฉุกเฉิน: 110</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">I need a doctor</td><td class="px-6 py-4">我需要医生</td><td class="px-6 py-4">Wǒ xū yào yī shēng</td><td class="px-6 py-4">เบอร์ฉุกเฉิน: 120</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">I'm lost</td><td class="px-6 py-4">我迷路了</td><td class="px-6 py-4">Wǒ mí lù le</td><td class="px-6 py-4">แสดงปลายทางเป็นภาษาจีน</td></tr>
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="pronunciation" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🎵</span> เคล็ดลับการออกเสียง
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">ภาษาจีนใช้ <strong>วรรณยุกต์</strong> — พยางค์เดียวกันที่ออกเสียงต่างระดับมีความหมายต่างกัน แต่อย่าเครียดเกินไป ปกติบริบททำให้ความหมายชัดเจน และคนท้องถิ่นให้อภัยนักท่องเที่ยว</p>

      <p class="text-lg font-bold text-gray-900 mb-4">สี่วรรณยุกต์:</p>

      <div class="overflow-x-auto mb-6 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">วลีจีนพื้นฐานสำหรับนักเดินทาง</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">วรรณยุกต์</th>
              <th class="px-6 py-4 font-bold">ตัวอย่าง</th>
              <th class="px-6 py-4 font-bold">ความหมาย</th>
              <th class="px-6 py-4 font-bold">คำอธิบาย</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">ที่ 1</td><td class="px-6 py-4">mā (妈)</td><td class="px-6 py-4">แม่</td><td class="px-6 py-4">เสียงสูงราบ</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">ที่ 2</td><td class="px-6 py-4">má (麻)</td><td class="px-6 py-4">ชา</td><td class="px-6 py-4">เสียงขึ้น</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">ที่ 3</td><td class="px-6 py-4">mǎ (马)</td><td class="px-6 py-4">ม้า</td><td class="px-6 py-4">ลงแล้วขึ้น</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">ที่ 4</td><td class="px-6 py-4">mà (骂)</td><td class="px-6 py-4">ด่า</td><td class="px-6 py-4">ตกsharp</td></tr>
          </tbody>
        </table>
      </div>

      <p class="text-lg leading-relaxed text-gray-700 mb-12"><strong>เคล็ดลับที่ดีที่สุด:</strong> พูดช้า ๆ และชัดเจน คนจีนส่วนใหญ่ชินกับชาวต่างชาติที่ struggling กับวรรณยุกต์และจะพยายามเข้าใจ</p>
    </div>

        <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/th/life/essential-apps/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">📱 10 แอปที่ต้องใช้ในจีน</p>
          <p class="text-sm text-gray-600">แอป essentials รวมถึงเครื่องมือแปลภาษา</p>
        </a>
        <a href="/th/life/cultural-taboos/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🏮 ข้อควรปฏิบัติและข้อห้ามทางวัฒนธรรม</p>
          <p class="text-sm text-gray-600">นำทางสถานการณ์ทางสังคมอย่างมั่นใจ</p>
        </a>
      </div>
    </div>
  
  </article>
</Layout>