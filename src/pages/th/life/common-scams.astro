---
import Layout from '@layouts/Layout.astro';
const title = "กลลวงทั่วไปในจีนและวิธีหลีกเลี่ยง";
const description = "อย่าให้มิจฉาชีพทำลายทริปจีนของคุณ นี่คือกลลวงนักท่องเที่ยวที่พบบ่อยที่สุดในจีนและวิธีหลีกเลี่ยง";
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปเคล็ดลับ
      </a>
    </nav>
    <!-- Header -->
  <header class="mb-12">
    <p class="text-sm text-gray-500 mb-3">🛡️ เคล็ดลับเที่ยวจีน</p>
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
      กลลวงทั่วไปในจีน และวิธีหลีกเลี่ยง
    </h1>
    <p class="text-xl text-gray-600 mb-6">อย่าให้มิจฉาชีพทำลายทริปของคุณ นี่คือสิ่งที่ควรระวัง</p>
    <div class="flex items-center gap-4 text-sm text-gray-500">
      <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
      <span>⏱️ 6 นาที</span>
    </div>
  </header>

  <!-- Quick Answer Box -->
  <div class="bg-gradient-to-r from-red-50 to-orange-50 border-l-4 border-red-500 rounded-r-2xl p-8 mb-12 not-prose">
    <h2 class="text-2xl font-bold text-red-900 mb-4">🎯 คำตอบด่วน</h2>
    <p class="text-lg text-red-800 leading-relaxed">
      <strong>คนจีนส่วนใหญ่เป็นคนซื่อสัตย์และช่วยเหลือดี</strong> แต่เช่นเดียวกับที่ที่มีนักท่องเที่ยวทุกที่ บางคนก็มุ่งเป้าไปที่นักท่องเที่ยว กลลวงที่นี่มุ่งเป้าไปที่ <strong>ความไว้ใจและความเป็นมิตร</strong> ของคุณ ไม่ใช่ความกลัว ถ้าคนแปลกหน้าเป็นมิตร <em>เกินไป</em> และอยากพาคุณไปที่ไหนสักแห่ง — นั่นคือสัญญาณเตือนของคุณ
    </p>
  </div>

  <!-- Table of Contents -->
  <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
    <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
    <ul class="space-y-3">
      <li><a href="#tea-house" class="text-blue-600 hover:underline">🍵 1. การชวนไปร้านน้ำชาหรือสตูดิโอศิลปะ</a></li>
      <li><a href="#fake-taxi" class="text-blue-600 hover:underline">🚕 2. แท็กซี่ปลอมและมิเตอร์เถื่อน</a></li>
      <li><a href="#free-gift" class="text-blue-600 hover:underline">🎁 3. "ของแถมฟรี" แล้วเรียกเก็บเงิน</a></li>
      <li><a href="#shop-tour" class="text-blue-600 hover:underline">🛍️ 4. ทัวร์ "เพื่อนมีร้าน"</a></li>
      <li><a href="#what-to-do" class="text-blue-600 hover:underline">🆘 วิธีปฏิบัติถ้ามีอะไรเกิดขึ้น</a></li>
    </ul>
  </nav>

  <!-- Main Content -->
  <div class="prose prose-lg max-w-none">
    <p class="text-lg leading-relaxed text-gray-700 mb-6">
      ให้ฉันเริ่มด้วยการพูดตามตรง: <strong>คนจีนส่วนใหญ่เป็นคนซื่อสัตย์ อบอุ่น และจะเต็มใจช่วยเหลือนักท่องเที่ยวต่างชาติ</strong>
    </p>

    <p class="text-lg leading-relaxed text-gray-700 mb-12">
      แต่เช่นเดียวกับทุกประเทศที่มีนักท่องเที่ยว บางคนก็มุ่งเป้าไปที่นักท่องเที่ยว กลลวงที่นี่มุ่งเป้าไปที่ <strong>ความไว้ใจและความเป็นมิตร</strong> ของคุณ ไม่ใช่ความกลัว นี่คือสิ่งที่ควรระวัง
    </p>

    <hr class="border-gray-200 my-12" />

    <!-- Scam 1 -->
    <h2 id="tea-house" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🍵</span> 1. การชวนไปร้านน้ำชาหรือสตูดิโอศิลปะ
    </h2>

    <div class="bg-red-50 border border-red-200 rounded-2xl p-6 mb-8 not-prose">
      <h3 class="text-xl font-bold text-red-900 mb-3">⚠️ วิธีการ</h3>
      <p class="text-gray-800 leading-relaxed">
        คนหนุ่มสาวที่เป็นมิตรเข้ามาหาคุณใกล้สถานที่สำคัญ พวกเขาบอกว่าเป็นนักเรียนฝึกภาษาอังกฤษ หรือนักศึกษาศิลปะที่อยากพาคุณไปดู "พิธีกรรมดั้งเดิม" หลังจากคุยกัน พวกเขาพาคุณไปร้านน้ำชาหรือ "สตูดิโอ" ใกล้ ๆ พนักงานเสิร์ฟชาหรือสาธิตการเขียนพู่กัน จากนั้นยื่นใบเรียกเก็บเงินให้คุณ <strong>หลายร้อยหรือหลายพันหยวน</strong> — และบรรยากาศก็เปลี่ยนเป็นไม่เป็นมิตรทันที
      </p>
    </div>

    <div class="bg-green-50 border border-green-200 rounded-2xl p-6 mb-12 not-prose">
      <h3 class="text-xl font-bold text-green-900 mb-3">✅ วิธีหลีกเลี่ยง</h3>
      <ul class="space-y-2 text-gray-800">
        <li>สุภาพแต่หนักแน่น: "ขอโทษครับ/คะ ฉันไม่สนใจ" — แล้วเดินออกไป</li>
        <li>ถึงพวกเขาจะดูจริงใจ อย่าตามคนแปลกหน้าไปยังสถานที่อื่น</li>
        <li>ถ้าคุณไปอยู่ในร้านนั้นแล้ว ให้โทรหาตำรวจ (110) — ร้านเหล่านี้พึ่งพาการข่มขู่ ไม่ใช่อำนาจตามกฎหมาย</li>
      </ul>
    </div>

    <div class="bg-blue-50 border-l-4 border-blue-400 p-5 rounded-r-xl mb-12 not-prose">
      <p class="text-blue-900 font-semibold mb-2">💡 เคล็ดลับท้องถิ่น</p>
      <p class="text-blue-800 leading-relaxed">
        นักเรียนที่อยากฝึกภาษาอังกฤษจริง ๆ จะคุยกับคุณแบบ casual ๆ ตรงนั้นเท่านั้น พวกเขาจะไม่ลากคุณไปยังสถานที่ที่ไม่คุ้นเคย และจะไม่ขอข้อมูลติดต่อเพื่อติดต่อกลับ แทบไม่เกิดขึ้นตามธรรมชาติ <strong>ถ้ามีคนเข้ามาหาคุณและอยากเป็นเพื่อน 9 ใน 10 ครั้ง มันคือกับดัก</strong>
      </p>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Scam 2 -->
    <h2 id="fake-taxi" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🚕</span> 2. แท็กซี่ปลอมและมิเตอร์เถื่อน
    </h2>

    <div class="bg-red-50 border border-red-200 rounded-2xl p-6 mb-8 not-prose">
      <h3 class="text-xl font-bold text-red-900 mb-3">⚠️ วิธีการ</h3>
      <p class="text-gray-800 leading-relaxed">
        ที่สนามบินและสถานีรถไฟ คนขับเข้ามาเสนอให้คุณโดยสาร รถส่วนตัวที่ไม่ได้รับอนุญาตเหล่านี้ หรือที่รู้จักกันในชื่อ "แท็กซี่ผี" มักปลอมตัวเป็นแท็กซี่ คนขับมักคิดค่าโดยสารเป็นอัตราต่อคน ซึ่งแพงกว่ารถที่ได้รับอนุญาตอย่างเป็นทางการมาก ยิ่งไปกว่านั้น การนั่งรถเหล่านี้ไม่มีการรับประกันความปลอดภัย
      </p>
      <p class="text-gray-800 leading-relaxed mt-3">
        <strong>ที่พบบ่อย:</strong> สนามบินใหญ่ สถานีรถไฟความเร็วสูง
      </p>
    </div>

    <div class="bg-green-50 border border-green-200 rounded-2xl p-6 mb-12 not-prose">
      <h3 class="text-xl font-bold text-green-900 mb-3">✅ วิธีหลีกเลี่ยง</h3>
      <ul class="space-y-2 text-gray-800">
        <li><strong>ใช้ DiDi</strong> (เทียบเท่า Uber ของจีน) — ราคาแสดงล่วงหน้า ติดตามได้ และแชร์การเดินทางกับเพื่อนได้</li>
        <li>ถ้าต้องนั่งแท็กซี่ <strong>ใช้คิวแท็กซี่ทางการ</strong> ที่สนามบิน — ไม่สนใจคนขับที่รออยู่ด้านนอก</li>
        <li>ถ้าคนขับไม่ยอมใช้มิเตอร์หรือคิดราคาที่ดูแพงเกินไป ให้ลงรถ</li>
      </ul>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Scam 3 -->
    <h2 id="free-gift" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🎁</span> 3. "ของแถมฟรี" แล้วเรียกเก็บเงิน
    </h2>

    <div class="bg-red-50 border border-red-200 rounded-2xl p-6 mb-8 not-prose">
      <h3 class="text-xl font-bold text-red-900 mb-3">⚠️ วิธีการ</h3>
      <p class="text-gray-800 leading-relaxed">
        มีคนเสนอของ "ฟรี" ให้คุณ — กำไลข้อมือ ม้วนพู่กันที่มีชื่อคุณ เครื่องรางพุทธศาสนา ทันทีที่คุณรับหรือปล่อยให้พวกเขาสวมให้คุณ พวกเขาเรียกเก็บเงิน กลลวง "พระอวยพร" เป็นเวอร์ชันที่พบบ่อยที่สุด
      </p>
      <p class="text-gray-800 leading-relaxed mt-3">
        <strong>ที่พบบ่อย:</strong> หน้าวัด ตลาดนักท่องเที่ยว ใกล้สถานีรถไฟ
      </p>
    </div>

    <div class="bg-green-50 border border-green-200 rounded-2xl p-6 mb-12 not-prose">
      <h3 class="text-xl font-bold text-green-900 mb-3">✅ วิธีหลีกเลี่ยง</h3>
      <ul class="space-y-2 text-gray-800">
        <li>อย่ารับอะไรจากคนแปลกหน้าบนถนน แม้จะบอกว่า "ฟรี"</li>
        <li>ถ้ามีคนใส่กำไลข้อมือให้คุณโดยไม่ถาม ให้ถอดออกและคืนทันที</li>
        <li>พระพุทธศาสนาจริง ๆ ไม่ขายเครื่องรางหรืออวยพรบนถนน</li>
        <li>พูด "ไม่ ขอบคุณ" หนักแน่นแล้วเดินออกไป — พวกเขาจะไม่ตามคุณ</li>
      </ul>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Scam 4 -->
    <h2 id="shop-tour" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🛍️</span> 4. ทัวร์ "เพื่อนมีร้าน"
    </h2>

    <div class="bg-red-50 border border-red-200 rounded-2xl p-6 mb-8 not-prose">
      <h3 class="text-xl font-bold text-red-900 mb-3">⚠️ วิธีการ</h3>
      <p class="text-gray-800 leading-relaxed">
        เรื่องเดียวกันกับกลลวงร้านน้ำชา — คนแปลกหน้าที่เป็นมิตรเข้ามาคุยและเสนอพาคุณไป "ร้านเพื่อน" ที่คุณจะได้ "ราคาพิเศษ" สำหรับชา หยก หรือผ้าไหม ร้านขายเครื่องเงินและหยกตามแหล่งท่องเที่ยวก็ตกอยู่ในกับดักเดียวกัน: สินค้าของพวกเขามีราคาสูงกว่าร้านในย่านการค้าทั่วไปมาก และไม่สามารถรับประกันความแท้ได้
      </p>
      <p class="text-gray-800 leading-relaxed mt-3">
        <strong>ที่พบบ่อย:</strong> ใกล้ทุกสถานที่ท่องเที่ยวสำคัญ
      </p>
    </div>

    <div class="bg-green-50 border border-green-200 rounded-2xl p-6 mb-12 not-prose">
      <h3 class="text-xl font-bold text-green-900 mb-3">✅ วิธีหลีกเลี่ยง</h3>
      <ul class="space-y-2 text-gray-800">
        <li>กติกาเดียวกัน: อย่าตามคนแปลกหน้าไปร้านที่เขาแนะนำ</li>
        <li>ซื้อของที่ระลึกจากร้านทั่วไปในย่านการค้า ไม่ใช่จากคนที่เข้ามาหาคุณบนถนน</li>
        <li>ถ้าอยากได้ชาหรือหยกคุณภาพดี ไปตลาดที่น่าเชื่อถือ</li>
      </ul>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- What to Do -->
    <h2 id="what-to-do" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🆘</span> วิธีปฏิบัติถ้ามีอะไรเกิดขึ้น
    </h2>

    <div class="bg-gray-900 text-white rounded-2xl p-8 mb-12 not-prose">
      <ol class="space-y-4">
        <li class="flex items-start gap-4">
          <span class="bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold flex-shrink-0">1</span>
          <div><strong>โทร 110</strong> — สายด่วนตำรวจ ในเมืองใหญ่ พวกเขาสามารถเชื่อมต่อคุณกับเจ้าหน้าที่ที่พูดภาษาอังกฤษได้</div>
        </li>
        <li class="flex items-start gap-4">
          <span class="bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold flex-shrink-0">2</span>
          <div><strong>ถ่ายรูป</strong> คน ร้านค้า หรือรถ ถ้าปลอดภัย</div>
        </li>
        <li class="flex items-start gap-4">
          <span class="bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold flex-shrink-0">3</span>
          <div><strong>โทรหาเคาน์เตอร์หน้าโรงแรม</strong> — พวกเขาสามารถช่วยอธิบายสถานการณ์ให้ตำรวจฟัง</div>
        </li>
        <li class="flex items-start gap-4">
          <span class="bg-red-500 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold flex-shrink-0">4</span>
          <div><strong>อย่าไล่ตามหรือเผชิญหน้า</strong> — คนเหล่านี้รู้พื้นที่ คุณไม่รู้ แจ้งความและเดินหน้าต่อ</div>
        </li>
      </ol>
    </div>

    <hr class="border-gray-200 my-12" />
  </div>

  <div class="border-t border-gray-100 pt-6 mt-8">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-xl p-5 not-prose">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <h3 class="text-sm font-bold text-gray-900">📚 อ่านต่อ</h3>
          <div class="flex flex-wrap gap-2">
            <a href="/th/life/is-china-safe/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              การเดินทางไปจีนปลอดภัยไหม?
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/th/life/emergency-numbers/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              เบอร์โทรฉุกเฉินและวิธีปฏิบัติ
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/th/payment/payment-guide/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              วิธีชำระเงินในจีน
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/th/transport/didi/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              วิธีใช้ DiDi ในจีน
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
</article>
</Layout>