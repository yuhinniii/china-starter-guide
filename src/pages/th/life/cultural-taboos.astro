---
import Layout from '@layouts/Layout.astro';
const title = "ข้อควรปฏิบัติและข้อห้ามทางวัฒนธรรมในจีน — คู่มือปฏิบัติ";
const description = "คู่มือมารยาททางวัฒนธรรมจีนสำหรับชาวต่างชาติ: กฎการใช้ตะเกียบ การให้ของขวัญ การรักษาหน้า กฎการถ่ายภาพ และสิ่งที่ไม่ควรทำในจีน";
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปชีวิตในจีน
      </a>
    </nav>
    <!-- Header -->
  <header class="mb-12">
    <p class="text-sm text-gray-500 mb-3">ชีวิตในจีน</p>
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
      ข้อควรปฏิบัติและข้อห้ามทางวัฒนธรรมในจีน— คู่มือปฏิบัติ
    </h1>
    <p class="text-xl text-gray-600 mb-6">รู้สิ่งสำคัญสักเล็กน้อย ทริปของคุณจะราบรื่นขึ้นมาก</p>
    <div class="flex items-center gap-4 text-sm text-gray-500">
      <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
      <span>⏱️ อ่าน 6 นาที</span>
    </div>
  </header>

  <!-- Quick Answer Box -->
  <div class="bg-gradient-to-r from-purple-50 to-pink-50 border-l-4 border-purple-500 rounded-r-2xl p-8 mb-12 not-prose">
    <h2 class="text-2xl font-bold text-purple-900 mb-4">🎯 คำตอบด่วน</h2>
    <p class="text-lg text-purple-800 leading-relaxed">
      คนจีน <strong>เข้าใจอย่างยิ่ง</strong> ต่อนักท่องเที่ยวต่างชาติที่ไม่รู้ขนบธรรมเนียมท้องถิ่น ไม่มีใครคาดหวังให้คุณสมบูรณ์แบบ แต่การรู้สิ่งสำคัญสักเล็กน้อยจะทำให้ทริปของคุณราบรื่นขึ้นและช่วยให้คุณเชื่อมต่อกับคนท้องถิ่นได้ดีขึ้น
    </p>
  </div>

  <!-- Table of Contents -->
  <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
    <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
    <ul class="space-y-3">
      <li><a href="#the-basics" class="text-blue-600 hover:underline">✅ พื้นฐาน</a></li>
      <li><a href="#impress-locals" class="text-blue-600 hover:underline">⭐ สิ่งที่สร้างความประทับใจให้คนท้องถิ่น</a></li>
      <li><a href="#things-that-matter" class="text-blue-600 hover:underline">⚠️ สิ่งที่สำคัญจริง ๆ</a></li>
      <li><a href="#smoking" class="text-blue-600 hover:underline">🚬 แล้วเรื่องสูบบุหรี่ล่ะ?</a></li>
      <li><a href="#golden-rule" class="text-blue-600 hover:underline">💎 กฎทอง</a></li>
    </ul>
  </nav>

  <!-- Main Content -->
  <div class="prose prose-lg max-w-none">
    <p class="text-lg leading-relaxed text-gray-700 mb-6">
      คนจีนเข้าใจอย่างยิ่งต่อนักท่องเที่ยวต่างชาติที่ไม่รู้ขนบธรรมเนียมท้องถิ่น ไม่มีใครคาดหวังให้คุณสมบูรณ์แบบ แต่การรู้สิ่งสำคัญสักเล็กน้อยจะทำให้ทริปของคุณราบรื่นขึ้นและช่วยให้คุณเชื่อมต่อกับคนท้องถิ่นได้ดีขึ้น
    </p>

    <p class="text-lg leading-relaxed text-gray-700 mb-12">
      ฉันได้จัดหมวดหมู่ออกเป็นสามระดับ: สิ่งที่คนส่วนใหญ่รู้อยู่แล้ว สิ่งที่จะสร้างความประทับใจให้คนท้องถิ่นอย่างแท้จริง และสิ่งที่สำคัญจริง ๆ
    </p>

    <hr class="border-gray-200 my-12" />

    <!-- Section 1 -->
    <h2 id="the-basics" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">✅</span> พื้นฐาน
    </h2>

    <div class="space-y-6 mb-12">
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-amber-900 mb-3">🥢 กฎการใช้ตะเกียบ</h3>
        <ul class="space-y-2 text-gray-800">
          <li>อย่าปักตะเกียบตั้งตรงในถ้วยข้าว (คล้ายกับธูปในงานศพ)</li>
          <li>อย่าเคาะตะเกียบบนถ้วยข้าว (นั่นคือสิ่งที่ขอทานทำ)</li>
          <li>วางตะเกียบบนที่วางตะเกียบหรือพาดบนจาน</li>
        </ul>
      </div>

      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-blue-900 mb-3">🍵 รินเครื่องดื่มให้คนอื่น</h3>
        <p class="text-gray-800 leading-relaxed">
          ในจีน คุณรินเครื่องดื่มให้คนรอบข้าง และพวกเขาก็รินให้คุณ การรินเครื่องดื่มให้ตัวเองถือเป็นการเห็นแก่ตัวเล็กน้อย
        </p>
      </div>

      <div class="bg-red-50 border border-red-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-red-900 mb-3">🎁 การให้ของขวัญ</h3>
        <ul class="space-y-2 text-gray-800">
          <li>อย่าให้นาฬิกา (พ้องเสียงกับ "ไปร่วมงานศพ" ในภาษาจีน)</li>
          <li>ห่อของขวัญด้วยกระดาษสีแดงหรือสีทอง ไม่ใช่สีขาวหรือสีดำ (สีแห่งงานศพ)</li>
          <li>อย่าเปิดของขวัญต่อหน้าผู้ให้ — เป็นมารยาทที่จะเปิดทีหลัง</li>
        </ul>
      </div>

      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-gray-900 mb-3">🚫 อย่าชี้หรือแตะหัว</h3>
        <ul class="space-y-2 text-gray-800">
          <li>การชี้คนด้วยนิ้วถือเป็นการหยาบคาย ให้ใช้ฝ่ามือที่แบออกหรือใช้คางชี้แทน</li>
          <li>ศีรษะถือเป็นสิ่งส่วนตัว/ศักดิ์สิทธิ์ในวัฒนธรรมจีน แม้แต่การลูบหัวเด็กก็อาจทำให้รู้สึกไม่เหมาะสม</li>
          <li>เลข 4 ออกเสียงคล้าย "ความตาย" ในภาษาจีน อาคารมักข้ามชั้นที่ 4 หลีกเลี่ยงการให้ของขวัญเป็นชุดละ 4 ชิ้น</li>
        </ul>
      </div>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 2 -->
    <h2 id="impress-locals" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">⭐</span> สิ่งที่สร้างความประทับใจให้คนท้องถิ่น
    </h2>

    <p class="text-lg leading-relaxed text-gray-700 mb-8">สิ่งเหล่านี้เป็นท่าทางเล็กน้อยที่แสดงว่าคุณได้พยายาม คนจีนจะซาบซึ้งใจอย่างแท้จริง:</p>

    <div class="space-y-6 mb-12">
      <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-green-900 mb-3">🍽️ มารยาทบนโต๊ะอาหาร</h3>
        <ul class="space-y-2 text-gray-800">
          <li><strong>รอเจ้าภาพเริ่มกิน</strong> ก่อนที่คุณจะเริ่ม</li>
          <li><strong>ลองทุกอย่าง</strong> ที่เสนอให้คุณ — แม้คุณจะไม่แน่ใจว่ามันคืออะไร แสดงถึงความเคารพต่อเจ้าภาพ</li>
          <li><strong>พูดว่า "ฉันอิ่มแล้ว"</strong> (我饱了 / wǒ bǎo le) เมื่อคุณกินเสร็จ</li>
          <li><strong>เมื่อรับของขวัญหรือนามบัตร</strong> ให้ใช้สองมือ</li>
          <li><strong>ถ้ามีใครเสนอชาให้คุณ</strong> ให้รับไว้ การปฏิเสธอาจรู้สึกเหมือนปฏิเสธน้ำใจ</li>
        </ul>
      </div>

      <div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-indigo-900 mb-3">🍶 พิธีกรรมเหล้าขาว</h3>
        <p class="text-gray-800 leading-relaxed mb-3">
          ถ้าเจ้าภาพจีนเสนอเหล้าขาว (baijiu) ให้คุณ แสดงว่าพวกเขากำลังให้เกียรติคุณ คุณไม่จำเป็นต้องดื่มหมด — จิบเล็กน้อยก็ได้ แต่การปฏิเสธทั้งหมดอาจรู้สึกเหมือนไม่ใส่ใจ
        </p>
        <p class="text-gray-800 leading-relaxed">
          เวลาชนแก้ว ให้ถือแก้วของคุณต่ำกว่าคนที่คุณชนแก้วด้วยเล็กน้อย — เป็นสัญลักษณ์แสดงความเคารพตามประเพณี
        </p>
      </div>

      <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-yellow-900 mb-3">👤 การรักษาหน้า</h3>
        <p class="text-gray-800 leading-relaxed">
          นี่คือแนวคิดที่สำคัญที่สุดในการปฏิสัมพันธ์ทางสังคมของจีน "หน้า" หมายถึงศักดิ์ศรี ชื่อเสียง และสถานะทางสังคม <strong>อย่าวิพากษ์วิจารณ์ ทำให้น่าอาย หรือเผชิญหน้าใครโดยตรงต่อหน้าผู้อื่น</strong> ถ้าคุณมีเรื่องร้องเรียนหรือไม่เห็นด้วย ให้พูดคุยเป็นการส่วนตัว
        </p>
      </div>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 3 -->
    <h2 id="things-that-matter" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">⚠️</span> สิ่งที่สำคัญจริง ๆ
    </h2>

    <div class="space-y-6 mb-12">
      <div class="bg-red-50 border-l-4 border-red-400 p-6 rounded-r-xl not-prose">
        <h3 class="text-xl font-bold text-red-900 mb-3">📸 กฎการถ่ายภาพ — นี่สำคัญ</h3>
        <ul class="space-y-2 text-gray-800">
          <li><strong>ห้ามถ่ายภาพสถานที่ทางทหาร จุดตรวจของตำรวจ หรืออาคารรัฐบาล</strong> — คุณอาจถูกควบคุมตัว</li>
          <li>ขออนุญาตก่อนถ่ายภาพผู้คน โดยเฉพาะในพื้นที่ชนบทหรือพื้นที่ชนกลุ่มน้อย</li>
          <li>การบินโดรนถูกจำกัดในเมืองส่วนใหญ่และต้องลงทะเบียน</li>
        </ul>
      </div>

      <div class="bg-orange-50 border-l-4 border-orange-400 p-6 rounded-r-xl not-prose">
        <h3 class="text-xl font-bold text-orange-900 mb-3">📄 การจัดการเอกสารทางการให้ถูกต้อง</h3>
        <ul class="space-y-2 text-gray-800">
          <li>ถ้าคุณเข้าจาก 中国香港, 中国澳门 หรือ 中国台湾 ให้ใช้ช่องทางข้ามพรมแดนพิเศษ</li>
          <li><strong>พกพาสปอร์ตหรือรูปถ่ายที่ชัดเจนติดตัวเสมอ</strong> — ตำรวจอาจตรวจสอบแบบสุ่ม</li>
        </ul>
      </div>

      <div class="bg-purple-50 border-l-4 border-purple-400 p-6 rounded-r-xl not-prose">
        <h3 class="text-xl font-bold text-purple-900 mb-3">⚖️ การเคารพกฎหมายท้องถิ่น</h3>
        <ul class="space-y-2 text-gray-800">
          <li>จีนมีกฎหมายที่เข้มงวดเกี่ยวกับการพูด เนื้อหาออนไลน์ และการอภิปรายทางการเมือง</li>
          <li>ในฐานะนักท่องเที่ยว วิธีที่ปลอดภัยที่สุดคือ <strong>หลีกเลี่ยงหัวข้อการเมือง</strong> — คุณมาในฐานะนักท่องเที่ยว ไม่ใช่นักวิจารณ์</li>
          <li>การเซ็นเซอร์ออนไลน์มีอยู่จริง อย่าพยายามเข้าถึงเว็บไซต์ที่ถูกบล็อกโดยใช้ WiFi ของโรงแรมหรือเครือข่ายสาธารณะหากไม่เข้าใจความเสี่ยง</li>
          <li>กฎเหล่านี้ใช้กับทุกคน รวมถึงพลเมืองจีน</li>
        </ul>
      </div>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 4 -->
    <h2 id="smoking" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🚬</span> แล้วเรื่องสูบบุหรี่ล่ะ?
    </h2>

    <div class="bg-gray-100 border border-gray-200 rounded-2xl p-6 mb-12 not-prose">
      <ul class="space-y-2 text-gray-800">
        <li>🚭 สถานที่สาธารณะในร่มเป็นเขตปลอดบุหรี่</li>
        <li>🚬 คุณจะเห็นการสูบบุหรี่กลางแจ้งมากมาย — มันเป็นส่วนหนึ่งของชีวิตประจำวัน</li>
        <li>📍 ถ้าคุณสูบบุหรี่ ให้มองหาพื้นที่สูบบุหรี่ที่จัดไว้</li>
      </ul>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 5 -->
    <h2 id="golden-rule" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">💎</span> กฎทอง
    </h2>

    <div class="bg-gradient-to-r from-blue-50 to-purple-50 border border-blue-200 rounded-2xl p-8 mb-12 not-prose">
      <p class="text-xl text-gray-900 leading-relaxed mb-4">
        ประเด็นคือ: <strong>คนจีนไม่ได้คาดหวังให้คุณสมบูรณ์แบบ</strong> สิ่งที่สำคัญที่สุดคือทัศนคติของคุณ
      </p>
      <p class="text-lg text-gray-800 leading-relaxed mb-4">
        <strong>ยิ้ม. พูดว่า 谢谢 (xièxie / ขอบคุณ). พูดว่า 对不起 (duìbuqǐ / ขอโทษ) เมื่อคุณทำผิด.</strong>
      </p>
      <p class="text-lg text-gray-800 leading-relaxed">
        สามสิ่งนี้จะช่วยให้คุณผ่านพ้นสถานการณ์ที่น่าอึดอัดไปได้ 95% ฉันเคยเห็นชาวต่างชาติทำผิดมารยาททุกข้อในคู่มือนี้ แต่ก็ยังมีช่วงเวลาที่ยอดเยี่ยมในจีน เพียงเพราะพวกเขาเป็นมิตรและให้เกียรติ
      </p>
      <p class="text-lg text-gray-800 leading-relaxed mt-4 font-semibold">
        จีนเป็นประเทศที่มีประชากร 1.4 พันล้านคน เราคุ้นเคยกับความหลากหลาย เราดีใจอย่างยิ่งที่ได้เห็นนักท่องเที่ยวที่อยากรู้อยากเห็นเกี่ยวกับวัฒนธรรมของเรา ถ้าคุณมาด้วยใจที่เปิดกว้าง ผู้คนจะตอบรับคุณด้วยความอบอุ่น
      </p>
    </div>

    <hr class="border-gray-200 my-12" />
  </div>

  <!-- Related Guides -->
  <div class="bg-gray-50 rounded-2xl p-8 not-prose">
    <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 คู่มือที่เกี่ยวข้อง</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/th/life/is-china-safe/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
        <p class="font-bold text-gray-900 mb-1">เดินทางไปจีนปลอดภัยไหม?</p>
        <p class="text-sm text-gray-600">คำตอบที่ตรงไปตรงมาจากคนท้องถิ่น</p>
      </a>
      <a href="/th/life/common-scams/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
        <p class="font-bold text-gray-900 mb-1">กลโกงทั่วไปในจีน & วิธีหลีกเลี่ยง</p>
        <p class="text-sm text-gray-600">อย่าให้มิจฉาชีพทำลายทริปของคุณ</p>
      </a>
