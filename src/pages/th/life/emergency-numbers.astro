---
import Layout from '@layouts/Layout.astro';
const title = "เบอร์โทรฉุกเฉินและวิธีปฏิบัติเมื่อต้องการความช่วยเหลือในจีน";
const description = "เบอร์โทรฉุกเฉินในจีน: 110 (ตำรวจ), 120 (รถพยาบาล), 119 (ไฟไหม้) พร้อมข้อมูลติดต่อสถานทูต ขั้นตอนทำพาสปอร์ตหาย และวลีฉุกเฉิน";
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปเคล็ดลับ
      </a>
    </nav>
    <!-- Header -->
  <header class="mb-12">
    <p class="text-sm text-gray-500 mb-3">🛡️ เคล็ดลับเที่ยวจีน</p>
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
      เบอร์โทรฉุกเฉินในจีน<br class="hidden md:block" /> และวิธีปฏิบัติเมื่อต้องการความช่วยเหลือ
    </h1>
    <p class="text-xl text-gray-600 mb-6">ถ้ามีอะไรผิดพลาดระหว่างที่คุณมาเที่ยว นี่คือสิ่งที่ต้องทำ</p>
    <div class="flex items-center gap-4 text-sm text-gray-500">
      <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
      <span>⏱️ 7 นาที</span>
    </div>
  </header>

  <!-- Quick Answer Box -->
  <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
    <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 คำตอบด่วน</h2>
    <p class="text-lg text-blue-800 leading-relaxed">
      <strong>สามหมายเลขช่วยชีวิตคุณในจีน:</strong> <strong class="text-red-600">110</strong> (ตำรวจ), <strong class="text-red-600">120</strong> (รถพยาบาล), <strong class="text-red-600">119</strong> (ไฟไหม้) ทุกหมายเลขมีพนักงานที่พูดภาษาอังกฤษ บันทึกเบอร์สถานทูตของคุณก่อนเดินทาง
    </p>
  </div>

  <!-- Table of Contents -->
  <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
    <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
    <ul class="space-y-3">
      <li><a href="#three-numbers" class="text-blue-600 hover:underline">📞 สามหมายเลขที่คุณต้องรู้</a></li>
      <li><a href="#language-barrier" class="text-blue-600 hover:underline">🗣️ วิธีปฏิบัติถ้าพูดภาษาจีนไม่ได้</a></li>
      <li><a href="#embassy" class="text-blue-600 hover:underline">🏛️ สถานทูตหรือสถานกงสุลของคุณ</a></li>
      <li><a href="#common-emergencies" class="text-blue-600 hover:underline">🆘 ขั้นตอนสำหรับเหตุฉุกเฉินทั่วไป</a></li>
      <li><a href="#emergency-phrases" class="text-blue-600 hover:underline">📝 วลีฉุกเฉินที่ควรเก็บไว้ในโทรศัพท์</a></li>
    </ul>
  </nav>

  <!-- Main Content -->
  <div class="prose prose-lg max-w-none">
    <hr class="border-gray-200 my-12" />

    <!-- Section 1 -->
    <h2 id="three-numbers" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">📞</span> สามหมายเลขที่คุณต้องรู้
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12 not-prose">
      <div class="bg-red-50 border border-red-200 rounded-2xl p-6 text-center">
        <div class="text-6xl font-extrabold text-red-600 mb-2">110</div>
        <h3 class="text-xl font-bold text-red-900 mb-3">🚔 ตำรวจ</h3>
        <p class="text-gray-700">สำหรับทุกเหตุฉุกเฉิน — แม้ถ้าคุณต้องการความช่วยเหลือทางการแพทย์ พวกเขาสามารถเชื่อมต่อคุณกับเจ้าหน้าที่ที่พูดภาษาอังกฤษได้</p>
      </div>

      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 text-center">
        <div class="text-6xl font-extrabold text-blue-600 mb-2">120</div>
        <h3 class="text-xl font-bold text-blue-900 mb-3">🚑 รถพยาบาล</h3>
        <p class="text-gray-700">สายด่วนเหตุฉุกเฉินทางการแพทย์ พนักงานสามารถจัดหาผู้ช่วยที่พูดภาษาอังกฤษได้</p>
      </div>

      <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6 text-center">
        <div class="text-6xl font-extrabold text-orange-600 mb-2">119</div>
        <h3 class="text-xl font-bold text-orange-900 mb-3">🚒 ไฟไหม้</h3>
        <p class="text-gray-700">เหตุฉุกเฉินไฟไหม้ ใช้สำหรับสถานการณ์ที่เกี่ยวกับไฟ</p>
      </div>
    </div>

    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-12 not-prose">
      <p class="text-yellow-900 font-semibold">💡 <strong>เคล็ดลับฉุกเฉิน:</strong> ถ้าคุณพูดไม่ได้ ให้ส่งข้อความตำแหน่งของคุณไปที่ <strong>12110</strong> (บริการ SMS ฉุกเฉิน) พนักงานติดตามข้อความนี้สำหรับคนที่ไม่สามารถโทรออกได้</p>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 2 -->
    <h2 id="language-barrier" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🗣️</span> วิธีปฏิบัติถ้าพูดภาษาจีนไม่ได้
    </h2>

    <p class="text-lg leading-relaxed text-gray-700 mb-6">นี่คือความท้าทายใหญ่ที่สุดในเหตุฉุกเฉิน ก่อนที่คุณจะต้องใช้ บันทึกวลีนี้ไว้ในโทรศัพท์:</p>

    <div class="bg-gray-900 text-white rounded-2xl p-8 mb-12 not-prose">
      <p class="text-2xl text-center mb-4">📱 <strong>บันทึกสิ่งนี้ในโทรศัพท์ของคุณ:</strong></p>
      <div class="bg-white text-gray-900 rounded-xl p-6 text-center">
        <p class="text-2xl font-bold text-red-600 mb-3">请帮我报警，我是外国人，需要翻译。</p>
        <p class="text-lg text-gray-600 mb-2"><em>(Qǐng bāng wǒ bào jǐng, wǒ shì wàiguó rén, xūyào fānyì.)</em></p>
        <p class="text-lg text-gray-800 font-semibold">"กรุณาช่วยฉันแจ้งตำรวจ ฉันเป็นชาวต่างชาติและต้องการล่าม"</p>
      </div>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 3 -->
    <h2 id="embassy" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🏛️</span> สถานทูตหรือสถานกงสุลของคุณ
    </h2>

    <p class="text-lg leading-relaxed text-gray-700 mb-6">ถ้าคุณทำพาสปอร์ตหาย มีปัญหาทางกฎหมาย หรือมีเหตุฉุกเฉินร้ายแรง ติดต่อสถานทูตหรือสถานกงสุลของประเทศคุณ</p>

    <div class="overflow-x-auto mb-12 not-prose">
      <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
        <thead>
          <tr class="bg-gray-900 text-white">
            <th class="px-6 py-4 font-bold">ประเทศ</th>
            <th class="px-6 py-4 font-bold text-center">ติดต่อปักกิ่ง</th>
            <th class="px-6 py-4 font-bold text-center">ติดต่อเซี่ยงไฮ้</th>
            <th class="px-6 py-4 font-bold text-center">ติดต่อกวางโจว</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">🇺🇸 สหรัฐอเมริกา</td>
            <td class="px-6 py-4 text-center">010-8531-3000</td>
            <td class="px-6 py-4 text-center">021-8011-2200</td>
            <td class="px-6 py-4 text-center">020-3814-5000</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">🇬🇧 สหราชอาณาจักร</td>
            <td class="px-6 py-4 text-center">010-5192-4000</td>
            <td class="px-6 py-4 text-center">021-3279-2000</td>
            <td class="px-6 py-4 text-center">020-8314-3000</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">🇨🇦 แคนาดา</td>
            <td class="px-6 py-4 text-center">010-5139-4000</td>
            <td class="px-6 py-4 text-center">021-3279-2800</td>
            <td class="px-6 py-4 text-center">020-8611-6100</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">🇦🇺 ออสเตรเลีย</td>
            <td class="px-6 py-4 text-center">010-5140-4111</td>
            <td class="px-6 py-4 text-center">021-2215-5200</td>
            <td class="px-6 py-4 text-center">020-3814-0111</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">🇩🇪 เยอรมนี</td>
            <td class="px-6 py-4 text-center">010-8532-9000</td>
            <td class="px-6 py-4 text-center">021-3401-0106</td>
            <td class="px-6 py-4 text-center">020-8313-0121</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">🇫🇷 ฝรั่งเศส</td>
            <td class="px-6 py-4 text-center">010-8531-2000</td>
            <td class="px-6 py-4 text-center">021-6103-6300</td>
            <td class="px-6 py-4 text-center">020-2829-2000</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">🇯🇵 ญี่ปุ่น</td>
            <td class="px-6 py-4 text-center">010-8531-9800</td>
            <td class="px-6 py-4 text-center">021-5257-4766</td>
            <td class="px-6 py-4 text-center">020-8334-3009</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">🇰🇷 เกาหลีใต้</td>
            <td class="px-6 py-4 text-center">010-8531-0700</td>
            <td class="px-6 py-4 text-center">021-6295-5000</td>
            <td class="px-6 py-4 text-center">020-2919-2999</td>
          </tr>
          <tr>
            <td class="px-6 py-4 font-semibold">🇸🇬 สิงคโปร์</td>
            <td class="px-6 py-4 text-center">010-6505-9393</td>
            <td class="px-6 py-4 text-center">021-6278-5566</td>
            <td class="px-6 py-4 text-center">020-3891-2345</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="text-sm text-gray-500 mb-12"><em>⚠️ รายละเอียดการติดต่อสถานทูตอาจเปลี่ยนแปลงได้และประเทศของคุณอาจไม่ได้อยู่ในตาราง <strong>กรุณาตรวจสอบเว็บไซต์ทางการของสถานทูตประเทศคุณก่อนเดินทาง</strong></em></p>

    <hr class="border-gray-200 my-12" />

    <!-- Section 4 -->
    <h2 id="common-emergencies" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">🆘</span> ขั้นตอนสำหรับเหตุฉุกเฉินทั่วไป
    </h2>

    <div class="space-y-8 mb-12 not-prose">
      <div class="bg-red-50 border border-red-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-red-900 mb-4">📘 พาสปอร์ตหายหรือถูกขโมย</h3>
        <ol class="space-y-2 text-gray-800">
          <li><strong>1.</strong> โทร <strong>110</strong> หรือไปสถานีตำรวจที่ใกล้ที่สุด</li>
          <li><strong>2.</strong> ขอ <strong>ใบแจ้งความ</strong> (报警回执 / bào jǐng huí zhí) — คุณต้องใช้สำหรับสถานทูต</li>
          <li><strong>3.</strong> ติดต่อสถานทูตของคุณเพื่อขอเอกสารการเดินทางฉุกเฉิน</li>
          <li><strong>4.</strong> ไปสถานทูตด้วยตัวเองพร้อมใบแจ้งความและรูปถ่ายพาสปอร์ต</li>
          <li><strong>5.</strong> สถานทูตส่วนใหญ่ออกพาสปอร์ตฉุกเฉินภายใน 1-5 วันทำการ</li>
        </ol>
      </div>

      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-blue-900 mb-4">🏥 เหตุฉุกเฉินทางการแพทย์</h3>
        <ol class="space-y-2 text-gray-800">
          <li><strong>1.</strong> โทร <strong>120</strong> เรียกรถพยาบาล หรือไปห้องฉุกเฉินของโรงพยาบาลโดยตรง</li>
          <li><strong>2.</strong> โรงพยาบาลรัฐใหญ่มี <strong>แผนกนานาชาติ</strong> ที่มีเจ้าหน้าที่พูดภาษาอังกฤษ</li>
          <li><strong>3.</strong> โทรหาผู้ให้บริการประกันการเดินทางของคุณ — พวกเขาสามารถช่วยประสานงานการชำระเงินและหาแพทย์ที่พูดภาษาอังกฤษ</li>
          <li><strong>4.</strong> ถ้าคุณสื่อสารไม่ได้ ให้แสดงพาสปอร์ตและบัตรประกันแก่เจ้าหน้าที่โรงพยาบาล</li>
        </ol>
      </div>

      <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-orange-900 mb-4">💰 กระเป๋าสตางค์หาย / เงินหมด</h3>
        <ol class="space-y-2 text-gray-800">
          <li><strong>1.</strong> ไป <strong>สถานีตำรวจ</strong> ที่ใกล้ที่สุด — พวกเขาสามารถช่วยคุณติดต่อสถานทูต</li>
          <li><strong>2.</strong> ไป <strong>โรงแรม</strong> ใดก็ได้ — เคาน์เตอร์หน้าสามารถช่วยคุณโทรหาสถานทูต</li>
          <li><strong>3.</strong> ใช้ WeChat/Alipay — แทบทุกที่รับ แม้กระเป๋าสตางค์จะหาย</li>
        </ol>
      </div>

      <div class="bg-purple-50 border border-purple-200 rounded-2xl p-6">
        <h3 class="text-xl font-bold text-purple-900 mb-4">📡 ไม่มีอินเทอร์เน็ต</h3>
        <ol class="space-y-2 text-gray-800">
          <li><strong>1.</strong> หา <strong> lobby โรงแรม</strong> — โรงแรมไหนก็ให้คุณใช้ WiFi ได้</li>
          <li><strong>2.</strong> <strong>Starbucks หรือ McDonald's</strong> — มี WiFi ฟรี (ถามพนักงานหารหัสผ่าน)</li>
          <li><strong>3.</strong> ไปร้าน <strong>China Unicom, China Mobile หรือ China Telecom</strong> — พวกเขาสามารถช่วยเรื่องปัญหา SIM</li>
        </ol>
      </div>
    </div>

    <hr class="border-gray-200 my-12" />

    <!-- Section 5 -->
    <h2 id="emergency-phrases" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
      <span class="text-4xl">📝</span> วลีฉุกเฉินที่ควรเก็บไว้ในโทรศัพท์
    </h2>

    <div class="overflow-x-auto mb-12 not-prose">
      <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
        <thead>
          <tr class="bg-gray-900 text-white">
            <th class="px-6 py-4 font-bold">สถานการณ์</th>
            <th class="px-6 py-4 font-bold">ภาษาจีน</th>
            <th class="px-6 py-4 font-bold">การออกเสียง</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">ช่วยด้วย!</td>
            <td class="px-6 py-4 text-red-600 font-bold text-lg">救命！</td>
            <td class="px-6 py-4"><em>Jiù mìng!</em></td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">เรียกตำรวจ</td>
            <td class="px-6 py-4 text-red-600 font-bold text-lg">报警</td>
            <td class="px-6 py-4"><em>Bào jǐng</em></td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">ฉันต้องการรถพยาบาล</td>
            <td class="px-6 py-4 text-blue-600 font-bold text-lg">我需要救护车</td>
            <td class="px-6 py-4"><em>Wǒ xūyào jiùhù chē</em></td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">ฉันหลงทาง</td>
            <td class="px-6 py-4 text-orange-600 font-bold text-lg">我迷路了</td>
            <td class="px-6 py-4"><em>Wǒ mílù le</em></td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">ฉันรู้สึกไม่สบาย</td>
            <td class="px-6 py-4 text-purple-600 font-bold text-lg">我感觉不舒服</td>
            <td class="px-6 py-4"><em>Wǒ gǎnjué bù shūfu</em></td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">พาสปอร์ตฉันถูกขโมย</td>
            <td class="px-6 py-4 text-red-600 font-bold text-lg">我的护照被偷了</td>
            <td class="px-6 py-4"><em>Wǒ de hùzhào bèi tōu le</em></td>
          </tr>
