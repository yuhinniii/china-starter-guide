---
import Layout from '@layouts/Layout.astro';
const title = "10 แอปที่ต้องดาวน์โหลดก่อนเดินทางไปจีน";
const description = "แอปที่คุณต้องใช้เพื่อเอาตัวรอดและใช้ชีวิตในจีน — การชำระเงิน การเดินทาง การแปล และอื่น ๆ";
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปชีวิตในจีน
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">📱 ชีวิตในจีน</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        10 แอปที่ต้องดาวน์โหลด<br class="hidden md:block" /> ก่อนเดินทางไปจีน
      </h1>
      <p class="text-xl text-gray-600 mb-6">ลืม Google และ Facebook ไปได้เลย — นี่คือสิ่งที่คุณต้องการจริง ๆ</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 5 นาที</span>
      </div>
    </header>

        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 คำตอบด่วน</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        จีนขับเคลื่อนด้วยแอป ลืม Google และ Facebook ไปได้เลย — คุณต้องมี <strong>WeChat</strong> สำหรับแชทและจ่ายเงิน <strong>Alipay</strong> สำหรับช้อปปิ้ง <strong>DiDi</strong> สำหรับเรียกรถ และ <strong>Amap</strong> สำหรับการนำทาง ดาวน์โหลด这些东西 <strong>ก่อน</strong> คุณมาถึง เพราะบางอย่าง (เช่น บริการ Google) เข้าถึงยากกว่าเมื่อคุณอยู่ในจีนแล้ว
      </p>
    </div>

        <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#payment" class="text-blue-600 hover:underline">💳 แอปชำระเงิน</a></li>
        <li><a href="#messaging" class="text-blue-600 hover:underline">💬 แชทและโซเชียล</a></li>
        <li><a href="#transport" class="text-blue-600 hover:underline">🚗 การเดินทางและนำทาง</a></li>
        <li><a href="#travel" class="text-blue-600 hover:underline">🏨 จองการเดินทาง</a></li>
        <li><a href="#translation" class="text-blue-600 hover:underline">🔤 การแปลและภาษา</a></li>
        <li><a href="#food" class="text-blue-600 hover:underline">🍜 อาหารและการค้นพบ</a></li>
      </ul>
    </nav>

    <div class="prose prose-lg max-w-none">
      <hr class="border-gray-200 my-12" />

            <h2 id="payment" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">💳</span> แอปชำระเงิน
      </h2>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-6">
        <h3 class="text-xl font-bold text-blue-900 mb-3">💬 WeChat (微信)</h3>
        <p class="text-gray-700 leading-relaxed">ซุปเปอร์แอปของจีน คุณจะใช้มันเพื่อส่งข้อความ จ่ายเงินตามร้าน แบ่งบิล สั่งอาหาร จองนัดหมาย และอื่น ๆ อีกมาก ธุรกิจแทบทุกแห่งในจีนรับ WeChat Pay — ตั้งแต่ร้านอาหารหรูไปจนถึงแผงขายอาหารข้างทาง ตั้งค่าด้วยบัตรเครดิต (Visa/Mastercard) ก็พร้อมใช้งาน</p>
      </div>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-12">
        <h3 class="text-xl font-bold text-blue-900 mb-3">💳 Alipay (支付宝)</h3>
        <p class="text-gray-700 leading-relaxed">อีกครึ่งหนึ่งของการผูกขาดการชำระเงินของจีน Alipay แข็งแกร่งเป็นพิเศษสำหรับการช้อปปิ้งออนไลน์ (Taobao, Tmall) เช่นเดียวกับ WeChat สามารถใช้ในสถานการณ์การชำระเงินต่าง ๆ รวมถึงมินิโปรแกรมที่ใช้งานได้จริงเช่นระบบขนส่งสาธารณะและจักรยาน共享</p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="messaging" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">💬</span> แชทและโซเชียล
      </h2>

      <div class="bg-green-50 border border-green-100 rounded-2xl p-6 mb-12">
        <h3 class="text-xl font-bold text-green-900 mb-3">💬 WeChat</h3>
        <p class="text-gray-700 leading-relaxed">ใช่แล้ว WeChat ก็เป็นแอปแชทของคุณด้วย ทุกคนสื่อสารผ่าน WeChat — ไกด์นำเที่ยวจะประสานงานผ่านกลุ่ม WeChat และคนท้องถิ่นคาดหวังให้คุณมีแอปนี้ ลืม WhatsApp ไปได้เลย ไม่มีใครใช้ในประเทศ</p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="transport" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🚗</span> การเดินทางและนำทาง
      </h2>

      <div class="bg-purple-50 border border-purple-100 rounded-2xl p-6 mb-6">
        <h3 class="text-xl font-bold text-purple-900 mb-3">🚗 DiDi (滴滴出行)</h3>
        <p class="text-gray-700 leading-relaxed">แอปเรียกรถของจีน คุณสามารถป้อนปลายทางเป็นภาษาอังกฤษ ดูค่าโดยสารล่วงหน้า และจ่ายด้วย Alipay หรือ WeChat ใช้ได้ทุกเมืองใหญ่ ใช้แทนการโบกแท็กซี่ — คุณจะหลีกเลี่ยงปัญหาการสื่อสาร และถูกกว่าด้วย</p>
      </div>

      <div class="bg-orange-50 border border-orange-100 rounded-2xl p-6 mb-6">
        <h3 class="text-xl font-bold text-orange-900 mb-3">🗺️ Amap (高德地图) หรือ Baidu Maps (百度地图)</h3>
        <p class="text-gray-700 leading-relaxed">Google Maps ไม่ให้บริการนำทางแบบเลี้ยวต่อเลี้ยวในจีน สองแอปนี้เป็นตัวเลือกท้องถิ่น ใช้ได้กับการขับขี่ ขนส่งสาธารณะ การเดิน และแม้แต่หาร้านอาหารใกล้เคียง ทั้งสองรองรับภาษาอังกฤษบ้าง แต่ Baidu Maps เป็นมิตรกับชาวต่างชาติมากกว่าเล็กน้อย</p>
      </div>

      <div class="bg-indigo-50 border border-indigo-100 rounded-2xl p-6 mb-12">
        <h3 class="text-xl font-bold text-indigo-900 mb-3">🏨 Trip.com (携程)</h3>
        <p class="text-gray-700 leading-relaxed">เวอร์ชันภาษาอังกฤษของ Ctrip — แพลตฟอร์มจองการเดินทางที่ใหญ่ที่สุดของจีน จองเที่ยวบิน รถไฟ โรงแรม และสถานที่ท่องเที่ยว รองรับภาษาอังกฤษเต็มรูปแบบและรับบัตรเครดิตต่างประเทศ</p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="translation" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🔤</span> การแปลและภาษา
      </h2>

      <div class="bg-yellow-50 border border-yellow-100 rounded-2xl p-6 mb-6">
        <h3 class="text-xl font-bold text-yellow-900 mb-3">🌐 Google Translate</h3>
        <p class="text-gray-700 leading-relaxed">ตัวเลือกที่เชื่อถือได้มากที่สุด ดาวน์โหลดชุดภาษาจีนสำหรับใช้งานแบบออฟไลน์ ฟีเจอร์แปลด้วยกล้องมีค่าอย่างยิ่งสำหรับเมนู ป้าย และบรรจุภัณฑ์</p>
      </div>

      <div class="bg-yellow-50 border border-yellow-100 rounded-2xl p-6 mb-12">
        <h3 class="text-xl font-bold text-yellow-900 mb-3">📖 Pleco</h3>
        <p class="text-gray-700 leading-relaxed">มาตรฐานทองคำสำหรับพจนานุกรมจีน-อังกฤษ รองรับการแปลด้วยรูปภาพและเสียง จึงมีประโยชน์มากในหลายสถานการณ์</p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="food" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🍜</span> อาหารและการค้นพบ
      </h2>

      <div class="bg-red-50 border border-red-100 rounded-2xl p-6 mb-6">
        <h3 class="text-xl font-bold text-red-900 mb-3">⭐ Dianping (大众点评)</h3>
        <p class="text-gray-700 leading-relaxed">Yelp ของจีน หาร้านอาหารตามประเภทอาหาร ราคา ที่ตั้ง และคะแนน อินเทอร์เฟซเป็นภาษาจีนล้วน แต่รูปภาพและแผนที่ใช้งานง่าย ใช้ค้นพบร้านเด็ดท้องถิ่นที่ซ่อนอยู่</p>
      </div>

      <div class="bg-red-50 border border-red-100 rounded-2xl p-6 mb-12">
        <h3 class="text-xl font-bold text-red-900 mb-3">🍜 Amap Street Food Ranking (高德扫街榜)</h3>
        <p class="text-gray-700 leading-relaxed">อัญมณีที่ซ่อนอยู่ใน Amap ฟีเจอร์นี้จัดอันดับร้านอาหารตามพฤติกรรมของผู้ใช้จริง — มีคนนำทางไปที่นั่นกี่คน กลับมาซ้ำกี่ครั้ง และเดินทางไกลแค่ไหนเพื่อมากินที่นั่น ต่างจาก Dianping (ที่รีวิวอาจซื้อได้) 扫街榜 基于 <strong>รอยเท้าจริง</strong> และ Amap ประกาศว่า <strong>จะไม่รับรายการที่เสียเงิน</strong></p>
        <p class="text-gray-700 leading-relaxed mt-4">เพียงเปิด Amap → ค้นหา "扫街榜" → และดูว่าคนท้องถิ่นกำลังกินอะไรใกล้คุณ เหมาะสำหรับนักเดินทางที่ต้องการหลีกเลี่ยงกับดักนักท่องเที่ยวและค้นหาของจริง</p>
      </div>
    </div>

        <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/th/life/survival-kit/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🎒 ชุดเอาตัวรอดสำหรับทริปจีน</p>
          <p class="text-sm text-gray-600">เช็คลิสต์หลักสำหรับทริปของคุณ</p>
        </a>
        <a href="/th/life/sim-card-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">📶 SIM Card และ eSIM ที่ดีที่สุดสำหรับนักท่องเที่ยว</p>
          <p class="text-sm text-gray-600">เชื่อมต่อกับแพ็กเกจข้อมูล</p>
        </a>
        <a href="/th/payment/setup-alipay/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">💳 วิธีตั้งค่า Alipay</p>
          <p class="text-sm text-gray-600">เชื่อมต่อบัตรภายในไม่กี่นาที</p>
        </a>
        <a href="/th/payment/setup-wechat/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">💬 วิธีตั้งค่า WeChat Pay</p>
          <p class="text-sm text-gray-600">WeChat เป็นสิ่งจำเป็นสำหรับจีน</p>
        </a>
      </div>
    </div>
  
    <!-- Sources -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <h3 class="text-xl font-bold text-gray-900 mb-4">แหล่งข้อมูล</h3>
      <ul class="space-y-2 text-sm text-gray-600">
        <li>คำแนะนำแอปอ้างอิงจากประสบการณ์การเดินทางจริง</li>
      </ul>
    </div>
  </article>
</Layout>