---
import Layout from '@layouts/Layout.astro';
const title = "สิ่งที่ต้องแพ็คไปจีน — คู่มือฤดูกาลและสภาพอากาศ";
const description = "สิ่งที่ต้องแพ็คไปจีนตามฤดูกาลและเมือง — จากหน้าหนาวปักกิ่งถึงหน้าร้อนกวางโจว";
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปชีวิตในจีน
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🎒 ชีวิตในจีน</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        สิ่งที่ต้องแพ็คไปจีน: คู่มือฤดูกาลและสภาพอากาศ
      </h1>
      <p class="text-xl text-gray-600 mb-6">การแพ็คของไปจีนแตกต่าง — นี่คือสิ่งที่คุณต้องการจริง ๆ</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 6 นาที</span>
      </div>
    </header>

        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 คำตอบด่วน</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        <strong>จีนมีความผันผวนของฤดูกาลสุดขั้ว</strong> ปักกิ่งในฤดูหนาวหนาวเยือกแข็ง (-10°C) ขณะที่กวางโจวในฤดูร้อนร้อนอบอ้าว (35°C+ พร้อมความชื้น) กุญแจสำคัญคือการแพ็คแบบเป็นชั้น ๆ และเตรียมตัวสำหรับเมืองและฤดูกาลเฉพาะที่คุณจะไปเยือน ตลอดทั้งปี: รองเท้าเดินสบาย พาวเวอร์แบงก์ กระดาษชำระ และขวดน้ำใช้ซ้ำเป็นสิ่งจำเป็นไม่ว่าฤดูกาลไหน
      </p>
    </div>

        <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#year-round" class="text-blue-600 hover:underline">🎒 ของจำเป็นตลอดปี</a></li>
        <li><a href="#spring" class="text-blue-600 hover:underline">🌸 ฤดูใบไม้ผลิ (มี.ค.–พ.ค.)</a></li>
        <li><a href="#summer" class="text-blue-600 hover:underline">☀️ ฤดูร้อน (มิ.ย.–ส.ค.)</a></li>
        <li><a href="#autumn" class="text-blue-600 hover:underline">🍂 ฤดูใบไม้ร่วง (ก.ย.–พ.ย.)</a></li>
        <li><a href="#winter" class="text-blue-600 hover:underline">❄️ ฤดูหนาว (ธ.ค.–ก.พ.)</a></li>
        <li><a href="#city-guide" class="text-blue-600 hover:underline">🏙️ คู่มือด่วนแยกตามเมือง</a></li>
      </ul>
    </nav>

    <div class="prose prose-lg max-w-none">
      <hr class="border-gray-200 my-12" />

            <h2 id="year-round" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🎒</span> ของจำเป็นตลอดปี
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-8">สิ่งเหล่านี้ควรอยู่ในกระเป๋าของคุณไม่ว่าจะไปเมื่อไรหรือที่ไหน:</p>

      <div class="overflow-x-auto mb-6 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">รายการของจำเป็นสำหรับเดินทางจีน</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">ของ</th>
              <th class="px-6 py-4 font-bold">ทำไม</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4"><strong>พาวเวอร์แบงก์</strong></td><td class="px-6 py-4">แบตโทรศัพท์หมดเร็วเพราะใช้งานนำทาง + แปล + จ่ายเงิน</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4"><strong>อะแดปเตอร์เดินทางสากล</strong></td><td class="px-6 py-4">จีนใช้เต้าเสียบ Type A/I (220V)</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4"><strong>กระดาษชำระ/ทิชชู่พกพา</strong></td><td class="px-6 py-4">ห้องน้ำสาธารณะหลายแห่งไม่มีกระดาษให้</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4"><strong>เจลล้างมือ</strong></td><td class="px-6 py-4">ไม่ใช่ทุกที่มีสบู่</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4"><strong>ขวดน้ำใช้ซ้ำ</strong></td><td class="px-6 py-4">โรงแรมและสถานีมีเครื่องจ่ายน้ำร้อน</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4"><strong>รองเท้าเดินสบาย</strong></td><td class="px-6 py-4">คุณจะเดินเฉลี่ย 15,000+ ก้าวต่อวัน</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4"><strong>กระเป๋าเป้เล็ก/วันแพ็ค</strong></td><td class="px-6 py-4">ไม่ใช่ทุกสถานที่ที่อนุญาตให้กระเป๋าใหญ่</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4"><strong>สำเนาพาสปอร์ตและวีซ่า</strong></td><td class="px-6 py-4">เก็บสำเนาดิจิทัลด้วย</td></tr>
          </tbody>
        </table>
      </div>

      <div class="bg-yellow-50 border border-yellow-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>สำคัญ:</strong> สำหรับเที่ยวบินภายในประเทศและการตรวจสอบความปลอดภัยของรถไฟความเร็วสูง พาวเวอร์แบงก์ต้องมีเครื่องหมายรับรอง 3C และมีความจุไม่เกิน 20,000 mAh ถ้าคุณวางแผนจะไปหลายเมืองในจีน แนะนำให้ซื้อพาวเวอร์แบงก์ที่ได้มาตรฐานในเมืองแรกที่คุณไปถึง</p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="spring" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🌸</span> ฤดูใบไม้ผลิ (มี.ค.–พ.ค.)
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>อุณหภูมิ:</strong> 10°C–25°C (ปักกิ่งเย็นกว่า กวางโจวอุ่นกว่า)</p>
      <p class="text-lg leading-relaxed text-gray-700 mb-8"><strong>สภาพอากาศ:</strong> อบอุ่นแต่คาดเดาไม่ได้ มีฝนตกในเดือนเมษายน–พฤษภาคม โดยเฉพาะทางใต้</p>

      <p class="text-lg font-bold text-gray-900 mb-4">แพ็ค:</p>
      <ul class="space-y-3 mb-12">
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> เสื้อแจ็คเก็ตหรือฮู้ดดี้บาง (จำเป็น — ตอนเย็นฤดูใบไม้ผลิอาจหนาว)</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> กางเกงขายาวและเสื้อแขนยาว</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> ร่มหรือเสื้อกันฝนบาง</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> ผ้าพันคอ (มีประโยชน์สำหรับลมและฝุ่น)</li>
      </ul>

      <hr class="border-gray-200 my-12" />

            <h2 id="summer" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">☀️</span> ฤดูร้อน (มิ.ย.–ส.ค.)
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>อุณหภูมิ:</strong> 25°C–40°C (ปักกิ่งร้อนแห้ง กวางโจว/เซี่ยงไฮ้ชื้น)</p>
      <p class="text-lg leading-relaxed text-gray-700 mb-8"><strong>สภาพอากาศ:</strong> ร้อนทุกที่ เมืองทางใต้ชื้นเป็นพิเศษ ฝนมรสุมพบได้ทั่วไป</p>

      <p class="text-lg font-bold text-gray-900 mb-4">แพ็ค:</p>
      <ul class="space-y-3 mb-12">
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> เสื้อผ้าบางระบายอากาศดี (ผ้าฝ้าย ลินิน)</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> ครีมกันแดด (SPF 50+)</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> แว่นกันแดดและหมวก</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> ร่ม (สำหรับทั้งแดดและฝน)</li>
        <li class="flex items-start gap-3"><span class="text-red-500">⚠️</span> หลายสถานที่ (พระราชวังต้องห้าม กำแพงเมืองจีน) มีร่มเงาน้อย — วางแผนให้ดี</li>
      </ul>

      <hr class="border-gray-200 my-12" />

            <h2 id="autumn" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🍂</span> ฤดูใบไม้ร่วง (ก.ย.–พ.ย.)
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>อุณหภูมิ:</strong> 5°C–22°C (เริ่มเย็น สบาย)</p>
      <p class="text-lg leading-relaxed text-gray-700 mb-8"><strong>สภาพอากาศ:</strong> ฤดูกาลที่น่าพอใจที่สุด ฟ้าใส อากาศเย็น ความชื้นต่ำ</p>

      <p class="text-lg font-bold text-gray-900 mb-4">แพ็ค:</p>
      <ul class="space-y-3 mb-12">
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> ใส่เป็นชั้น ๆ: เสื้อยืด + แจ็คเก็ตบางหรือเสื้อสเวตเตอร์</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> ยีนส์หรือกางเกงสบาย ๆ</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> แจ็คเก็ตน้ำหนักปานกลางสำหรับตอนเย็น</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> นี่คือฤดูกาลเหมาะสำหรับกิจกรรมกลางแจ้ง</li>
      </ul>

      <hr class="border-gray-200 my-12" />

            <h2 id="winter" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">❄️</span> ฤดูหนาว (ธ.ค.–ก.พ.)
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>อุณหภูมิ:</strong> -15°C (ปักกิ่ง/ฮาร์บิน) ถึง 15°C (กวางโจว/เซินเจิ้น)</p>
      <p class="text-lg leading-relaxed text-gray-700 mb-8"><strong>สภาพอากาศ:</strong> หนาวเยือกแข็งทางเหนือ อุ่นทางใต้ อากาศแห้ง ความชื้นต่ำ</p>

      <p class="text-lg font-bold text-gray-900 mb-4">แพ็ค (สำหรับเหนือ; ใต้เหมือนฤดูใบไม้ร่วง):</p>
      <ul class="space-y-3 mb-12">
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> เสื้อโค้ทกันหนาวหนัก / เสื้อดาวน์ (จำเป็นสำหรับปักกิ่ง ซีอาน หรือที่ไหนก็ตามทางเหนือ)</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> ชุดชั้นในกันหนาว (ถ้าไปเหนือ)</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> หมวก ถุงมือ ผ้าพันคอ — ไม่สามารถต่อรองได้ในฤดูหนาว</li>
        <li class="flex items-start gap-3"><span class="text-green-500">✅</span> ลิปบาล์มและมอยส์เจอไรเซอร์ (เครื่องทำความร้อนส่วนกลางทำให้ผิวแห้ง)</li>
        <li class="flex items-start gap-3"><span class="text-red-500">⚠️</span> ฮาร์บินอาจถึง -30°C — เตรียมอุปกรณ์กันหนาวจัดถ้าไปไกลถึงนั้น</li>
      </ul>

      <hr class="border-gray-200 my-12" />

            <h2 id="city-guide" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🏙️</span> คู่มือด่วนแยกตามเมือง
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">รายการของจำเป็นสำหรับเดินทางจีน</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">เมือง</th>
              <th class="px-6 py-4 font-bold">ร้อน (°C)</th>
              <th class="px-6 py-4 font-bold">หนาว (°C)</th>
              <th class="px-6 py-4 font-bold">คำแนะนำการแพ็คหลัก</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">ปักกิ่ง</td><td class="px-6 py-4">25–35</td><td class="px-6 py-4">-10 ถึง 5</td><td class="px-6 py-4">เสื้อโค้ทหนาในหน้าหนาว ป้องกันแดดในหน้าร้อน</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">เซี่ยงไฮ้</td><td class="px-6 py-4">25–37</td><td class="px-6 py-4">0–10</td><td class="px-6 py-4">ชื้นตลอดปี เสื้อกันฝนจำเป็น</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">กวางโจว</td><td class="px-6 py-4">28–38</td><td class="px-6 py-4">10–18</td><td class="px-6 py-4">อบอุ่นตลอดปี เสื้อผ้าบาง + อุปกรณ์กันฝน</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">เซินเจิ้น</td><td class="px-6 py-4">28–35</td><td class="px-6 py-4">12–20</td><td class="px-6 py-4">คล้ายกวางโจว ชุดว่ายน้ำในหน้าร้อน</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">เฉิงตู</td><td class="px-6 py-4">22–32</td><td class="px-6 py-4">2–10</td><td class="px-6 py-4">มักมีเมฆมาก ใส่เป็นชั้น ๆ สบายตลอดปี</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">ซีอาน</td><td class="px-6 py-4">23–35</td><td class="px-6 py-4">-5 ถึง 8</td><td class="px-6 py-4">คล้ายปักกิ่งแต่อุ่นกว่าเล็กน้อย</td></tr>
          </tbody>
        </table>
      </div>
    </div>

        <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/th/life/essential-apps/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">📱 10 แอปที่ต้องใช้ในจีน</p>
          <p class="text-sm text-gray-600">แอป essentials สำหรับการนำทางและอื่น ๆ</p>
        </a>
        <a href="/th/transport/transport-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🚄 วิธีเดินทางในจีน</p>
          <p class="text-sm text-gray-600">เดินทางระหว่างเมืองอย่างสะดวก</p>
        </a>
      </div>
    </div>
  
  </article>
</Layout>