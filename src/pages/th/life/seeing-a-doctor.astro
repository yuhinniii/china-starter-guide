---
import Layout from '@layouts/Layout.astro';
const title = "การพบแพทย์ในจีน: คลินิก โรงพยาบาล และประกันภัย";
const description = "สิ่งที่นักเดินทางทุกคนต้องรู้เกี่ยวกับการพบแพทย์ในจีน: คลินิก vs โรงพยาบาล ค่าใช้จ่าย แผนกนานาชาติ และประกันการเดินทาง";
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปชีวิตในจีน
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🏥 การดูแลทางการแพทย์</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        การพบแพทย์ในจีน<br class="hidden md:block" />: สิ่งที่นักเดินทางทุกคนต้องรู้
      </h1>
      <p class="text-xl text-gray-600 mb-6">ถ้าคุณป่วยหรือบาดเจ็บในจีน คุณจะอยู่ในมือที่ดี — ถ้าคุณรู้ว่าจะไปที่ไหน</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 6 นาที</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 คำตอบด่วน</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        <strong>ใช่ จีนมีการดูแลทางการแพทย์ระดับโลก — แต่มันทำงานต่างออกไป</strong> สำหรับปัญหาเล็กน้อย ไปร้านขายยา สำหรับไม่ฉุกเฉิน ลองคลินิก สำหรับปัญหาร้ายแรง ไปโรงพยาบาลรัฐที่มีแผนกนานาชาติ ค่าใช้จ่ายถูกกว่าสหรัฐฯ หรือยุโรปมาก แต่ <strong>ซื้อประกันการเดินทางเสมอ</strong> ก่อนการเดินทางของคุณ
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#levels" class="text-blue-600 hover:underline">🏥 การดูแลทางการแพทย์สามระดับ</a></li>
        <li><a href="#cost" class="text-blue-600 hover:underline">💰 ค่าใช้จ่ายเท่าไหร่</a></li>
        <li><a href="#emergency" class="text-blue-600 hover:underline">🚑 วิธีปฏิบัติในเหตุฉุกเฉินทางการแพทย์</a></li>
      </ul>
    </nav>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">
      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        ถ้าคุณป่วยหรือบาดเจ็บในจีน นี่คือความจริง: <strong>คุณจะอยู่ในมือที่ดี — ถ้าคุณรู้ว่าจะไปที่ไหน</strong>
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        จีนมีโรงพยาบาลชั้นนำ โดยเฉพาะในเมืองใหญ่ แต่ระบบทำงานต่างจากที่คุณคุ้นเคย และการรู้ว่าควรไปที่ไหนสามารถประหยัดเวลา เงิน และความเครียดของคุณได้
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-12">
        คู่มือนี้ครอบคลุมสามเรื่อง: ไปที่ไหน ค่าใช้จ่ายเท่าไหร่ และวิธีเตรียมตัวก่อนออกเดินทาง
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 id="levels" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🏥</span> การดูแลทางการแพทย์สามระดับ
      </h2>

      <div class="space-y-8 mb-12 not-prose">
        <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-green-900 mb-3">💊 1. ร้านขายยา (药店 / yào diàn)</h3>
          <p class="text-gray-700 leading-relaxed mb-4">สำหรับปัญหาเล็กน้อย — หวัด ปวดหัว ปวดท้อง ภูมิแพ้ — ไปร้านขายยา คุณจะพบมันได้เกือบทุกถนนในเมืองจีน</p>
          <ul class="list-disc pl-5 space-y-1 text-gray-700">
            <li>ยาทั่วไปหาซื้อได้โดยไม่ต้องมีใบสั่งยา</li>
            <li>เภสัชกรส่วนใหญ่ไม่ค่อยพูดภาษาอังกฤษ ดังนั้นให้แสดงคำแปลหรือรูปถ่ายของสิ่งที่คุณต้องการ</li>
            <li>ร้านขายยาเครือใหญ่: <strong>Dahododo (大参林)</strong>, <strong>Guoda (国大药房)</strong>, <strong>Lens (老百姓大药房)</strong></li>
          </ul>
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-blue-900 mb-3">🩺 2. คลินิก</h3>
          <p class="text-gray-700 leading-relaxed mb-4">สำหรับปัญหาที่ไม่ฉุกเฉินแต่ต้องพบแพทย์ — ไข้ ติดเชื้อ บาดเจ็บเล็กน้อย — คลินิกคือตัวเลือกที่ดีที่สุด</p>
          <ul class="list-disc pl-5 space-y-1 text-gray-700">
            <li><strong>คลินิกนานาชาติ</strong> (เช่น Parkway, United Family Healthcare) มีแพทย์ที่พูดภาษาอังกฤษและเจ้าหน้าที่ที่ผ่านการฝึกฝนแบบตะวันตก แต่แพง</li>
            <li><strong>ศูนย์สุขภาพชุมชน</strong> มีในทุกชุมชนเพื่อการเข้าถึงง่าย ให้บริการทางการแพทย์ราคาถูก แต่เจ้าหน้าที่ rarely พูดภาษาอังกฤษ</li>
            <li>โรงแรมส่วนใหญ่สามารถแนะนำคลินิกใกล้เคียงที่มีประสบการณ์กับชาวต่างชาติ</li>
          </ul>
        </div>

        <div class="bg-purple-50 border border-purple-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-purple-900 mb-3">🏥 3. โรงพยาบาล (医院 / yī yuàn)</h3>
          <p class="text-gray-700 leading-relaxed mb-4">สำหรับปัญหาร้ายแรง — เจ็บหน้าอก บาดเจ็บสาหัส ไข้สูงที่ไม่ลด — ไปโรงพยาบาลโดยตรง</p>
          <ul class="list-disc pl-5 space-y-1 text-gray-700">
            <li><strong>โรงพยาบาลรัฐที่มีแผนกนานาชาติ</strong> — ตัวเลือกที่ดีที่สุดสำหรับนักเดินทางส่วนใหญ่</li>
            <li>ห้องฉุกเฉินที่โรงพยาบาลชั้นนำพร้อมรับมือทุกสถานการณ์</li>
            <li><strong>โทร 120</strong> เรียกรถพยาบาล หรือใช้ DiDi/แท็กซี่ไปโรงพยาบาล — บ่อยครั้งเร็วกว่า</li>
          </ul>
        </div>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="cost" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">💰</span> ค่าใช้จ่ายเท่าไหร่
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">นี่คือส่วนที่ทำให้นักเดินทางตะวันตกส่วนใหญ่ประหลาดใจ: <strong>ค่ารักษาพยาบาลในจีนถูกกว่าสหรัฐฯ หรือยุโรปมาก</strong></p>

      <div class="overflow-x-auto mb-8 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">บริการ</th>
              <th class="px-6 py-4 font-bold text-center">CNY (หยวน)</th>
              <th class="px-6 py-4 font-bold text-center">USD (โดยประมาณ)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">ไปร้านขายยา (ยาทั่วไป)</td><td class="px-6 py-4 text-center">¥20–100</td><td class="px-6 py-4 text-center">$3–15</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">ปรึกษาคลินิก</td><td class="px-6 py-4 text-center">¥200–800</td><td class="px-6 py-4 text-center">$30–118</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">ปรึกษาคลินิกนานาชาติ</td><td class="px-6 py-4 text-center">¥800–2,000</td><td class="px-6 py-4 text-center">$118–295</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">ไปห้องฉุกเฉินโรงพยาบาลรัฐ</td><td class="px-6 py-4 text-center">¥300–500</td><td class="px-6 py-4 text-center">$44–74</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4 font-semibold">แผนกนานาชาติของโรงพยาบาลรัฐ</td><td class="px-6 py-4 text-center">¥600–1,500</td><td class="px-6 py-4 text-center">$80–220</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4 font-semibold">นอนโรงพยาบาล (ต่อวัน)</td><td class="px-6 py-4 text-center">¥500–3,000</td><td class="px-6 py-4 text-center">$74–443</td></tr>
            <tr><td class="px-6 py-4 font-semibold">ผ่าตัดใหญ่</td><td class="px-6 py-4 text-center">¥20,000–100,000</td><td class="px-6 py-4 text-center">$2,954–14,771</td></tr>
          </tbody>
        </table>
      </div>

      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-8 not-prose">
        <p class="text-yellow-900"><strong>สำคัญ:</strong> ซื้อประกันการเดินทางก่อนการเดินทางเสมอ ถึงแม้ค่าใช้จ่ายจะต่ำกว่าตะวันตก ปัญหาทางการแพทย์ร้ายแรงยังอาจสูงถึงหลายหมื่นหยวน ประกันภัยที่ครอบคลุมจีนเป็นสิ่งจำเป็น</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="emergency" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🚑</span> วิธีปฏิบัติในเหตุฉุกเฉินทางการแพทย์
      </h2>

      <div class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
        <ol class="space-y-4">
          <li class="flex items-start gap-4">
            <span class="bg-blue-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold flex-shrink-0">1</span>
            <div><strong>โทร 120</strong> — บริการรถพยาบาล พนักงานสามารถเชื่อมต่อคุณกับผู้ช่วยที่พูดภาษาอังกฤษได้</div>
          </li>
          <li class="flex items-start gap-4">
            <span class="bg-blue-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold flex-shrink-0">2</span>
            <div><strong>หรือไปโรงพยาบาลรัฐใหญ่ที่ใกล้ที่สุดโดยตรง</strong> — ใช้ DiDi (การเดินทางถูกติดตามและรวดเร็ว)</div>
          </li>
          <li class="flex items-start gap-4">
            <span class="bg-blue-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold flex-shrink-0">3</span>
            <div><strong>นำพาสปอร์ตของคุณ</strong> — โรงพยาบาลจะต้องใช้สำหรับลงทะเบียน</div>
          </li>
          <li class="flex items-start gap-4">
            <span class="bg-blue-600 text-white w-8 h-8 rounded-full flex items-center justify-center font-bold flex-shrink-0">4</span>
            <div><strong>แสดงบัตรประกันของคุณ</strong> — ถ้าคุณมีประกันการเดินทาง โทรหาพวกเขาทันทีเพื่อประสานงานการชำระเงิน</div>
          </li>
        </ol>
      </div>

      <div class="bg-gray-900 text-white rounded-2xl p-8 mb-12 not-prose">
        <p class="text-lg text-center mb-4">📱 <strong>บันทึกสิ่งนี้ในโทรศัพท์ของคุณ:</strong></p>
        <div class="bg-white text-gray-900 rounded-xl p-6 text-center">
          <p class="text-xl font-bold text-red-600 mb-3">我是外国人，需要帮助。请带我去国际部或能找到英语翻译的地方。</p>
          <p class="text-lg text-gray-600 mb-2"><em>(Wǒ shì wàiguó rén, xūyào bāngzhù. Qǐng dài wǒ qù guójì bù huò néng zhǎodào yīngyǔ fānyì de dìfāng.)</em></p>
          <p class="text-lg text-gray-800 font-semibold">"ฉันเป็นชาวต่างชาติและต้องการความช่วยเหลือ กรุณาพาฉันไปแผนกนานาชาติหรือที่ที่มีล่ามภาษาอังกฤษ"</p>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose mt-12">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/th/life/top-hospitals/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">โรงพยาบาลชั้นนำที่มีแผนกนานาชาติ</p>
          <p class="text-sm text-gray-600">โรงพยาบาลที่ดีที่สุดสำหรับชาวต่างชาติในจีน</p>
        </a>
        <a href="/th/life/travel-insurance/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">ประกันการเดินทางสำหรับจีน</p>
          <p class="text-sm text-gray-600">สิ่งที่คุณต้องมีก่อนไป</p>
        </a>
        <a href="/th/life/emergency-numbers/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">เบอร์โทรฉุกเฉินและวิธีปฏิบัติ</p>
          <p class="text-sm text-gray-600">บันทึกก่อนที่คุณจะต้องการ</p>
        </a>
      </div>
    </div>
  </article>
</Layout>