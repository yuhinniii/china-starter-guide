---
import Layout from '@layouts/Layout.astro';
const title = "ชุดเอาตัวรอดสำหรับทริปจีน: ทุกสิ่งที่คุณต้องมีก่อนเดินทาง";
const description = "ตั้งแต่แอปและ SIM Card ไปจนถึง VPN และการแพ็คของ — นี่คือเช็คลิสต์ก่อนเดินทางจีนแบบครบถ้วนของคุณ";
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปชีวิตในจีน
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🎒 ชีวิตในจีน</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        ชุดเอาตัวรอดสำหรับทริปจีน<br class="hidden md:block" />: ทุกสิ่งที่คุณต้องมีก่อนเดินทาง
      </h1>
      <p class="text-xl text-gray-600 mb-6">ห้าสิ่งที่ต้องจัดการก่อนการเดินทาง — ไม่มีอะไรยาก แต่ทุกอย่างสำคัญ</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 6 นาที</span>
      </div>
    </header>

        <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 คำตอบด่วน</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        <strong>มีห้าสิ่งที่คุณต้องจัดการก่อนทริปจีน: โทรศัพท์ การเชื่อมต่ออินเทอร์เน็ต VPN วลีภาษาจีนพื้นฐานสองสามประโยค และกระเป๋าเดินทางของคุณ</strong> ไม่มีอะไรยากเลย แต่แต่ละอย่างสามารถทำให้ทริปของคุณราบรื่นหรือพังได้หากมองข้าม นี่คือคู่มือสั้น ๆ เพื่อดูว่าคุณต้องการอะไรจริง ๆ — จากนั้นลงลึกในบทความรายละเอียดของแต่ละหัวข้อ
      </p>
    </div>

        <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#phone-apps" class="text-blue-600 hover:underline">📱 โทรศัพท์ของคุณ: มีแอปที่ใช่หรือยัง?</a></li>
        <li><a href="#connection" class="text-blue-600 hover:underline">📶 การเชื่อมต่อ: eSIM, SIM Card หรือโรมมิ่ง?</a></li>
        <li><a href="#vpn" class="text-blue-600 hover:underline">🔒 VPN: การเข้าถึงอินเทอร์เน็ตอย่างอิสระในจีน</a></li>
        <li><a href="#language" class="text-blue-600 hover:underline">🗣️ ทักษะภาษา: ต้องใช้ภาษาจีนมากแค่ไหน?</a></li>
        <li><a href="#luggage" class="text-blue-600 hover:underline">🎒 กระเป๋าเดินทาง: อะไรที่แตกต่างเมื่อเดินทางในจีน?</a></li>
        <li><a href="#checklist" class="text-blue-600 hover:underline">✅ เช็คลิสต์สุดยอดก่อนออกเดินทาง</a></li>
      </ul>
    </nav>

    <div class="prose prose-lg max-w-none">
      <hr class="border-gray-200 my-12" />

            <h2 id="phone-apps" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">📱</span> โทรศัพท์ของคุณ: มีแอปที่ใช่หรือยัง?
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">นี่คือเรื่องเกี่ยวกับจีน: <strong>แอปที่คุณใช้ทุกวันที่บ้านคงใช้ไม่ได้ที่นี่</strong> Google Maps แสดงทางผิด WhatsApp ส่งข้อความไม่ได้ Uber ไม่มีอยู่จริง และคุณไม่สามารถจ่ายด้วยบัตรเครดิตต่างประเทศได้ในร้านส่วนใหญ่</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">คุณจะต้องดาวน์โหลดแอปชุดใหม่ก่อนเดินทาง — WeChat และ Alipay สำหรับการชำระเงิน DiDi สำหรับเรียกรถ Amap สำหรับนำทาง และอื่น ๆ อีกสองสามแอป</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-12">ไม่แน่ใจว่าต้องการแอปไหนจริง ๆ? คู่มือฉบับเต็มแยกตามหมวดหมู่และบอกว่าแต่ละแอปทำอะไรได้บ้าง</p>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>📖 คู่มือฉบับเต็ม:</strong> <a href="/th/life/essential-apps/" class="text-blue-600 hover:underline">10 แอปที่ต้องมีก่อนเดินทางไปจีน</a></p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="connection" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">📶</span> การเชื่อมต่อ: eSIM, SIM Card หรือโรมมิ่ง?
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">คุณจะต้องใช้อินเทอร์เน็ตทันทีที่ถึง — สำหรับแผนที่ การแปล การเรียกรถ และการส่งข้อความ คำถามคือตัวเลือกไหนเหมาะกับโทรศัพท์และระยะเวลาทริปของคุณ</p>

      <p class="text-lg font-bold text-gray-900 mb-4">สามวิธีในการออนไลน์ในจีน:</p>

      <ul class="space-y-4 mb-12">
        <li class="flex items-start gap-3 bg-gray-50 rounded-xl p-4">
          <span class="text-blue-500 text-xl mt-0.5">📱</span>
          <div>
            <strong class="text-gray-900">eSIM</strong>
            <p class="text-gray-700 mt-1">ซื้อออนไลน์ก่อนเดินทาง เปิดใช้งานเมื่อถึง ไม่ต้องใช้ซิมการ์ดจริง เหมาะที่สุดถ้าโทรศัพท์ของคุณรองรับและอยากได้ความสะดวกสบาย ซิมประเภทนี้ปกติให้เฉพาะข้อมูลและอนุญาตให้ใช้แอปต่างประเทศเช่น WhatsApp และ YouTube แต่ไม่มีเบอร์โทรศัพท์จีน หากคุณวางแผนจะใช้ DiDi หรือสั่งอาหารเดลิเวอรี่และบริการอื่น ๆ ที่ต้องรับสาย ขอแนะนำให้ซื้อ SIM Card แบบกายภาพ</p>
          </div>
        </li>
        <li class="flex items-start gap-3 bg-gray-50 rounded-xl p-4">
          <span class="text-green-500 text-xl mt-0.5">🆔</span>
          <div>
            <strong class="text-gray-900">Tourist SIM</strong>
            <p class="text-gray-700 mt-1">ซื้อที่เคาน์เตอร์สนามบินหลังจากถึง ต้องใช้พาสปอร์ต ให้เบอร์โทรศัพท์จีน อย่างไรก็ตาม เนื่องจากข้อจำกัดของเครือข่ายในประเทศ แอปต่างประเทศหลายตัวจะใช้งานไม่ได้ — คุณควรตั้งค่า VPN <strong>ก่อน</strong>ออกเดินทาง</p>
          </div>
        </li>
        <li class="flex items-start gap-3 bg-gray-50 rounded-xl p-4">
          <span class="text-purple-500 text-xl mt-0.5">🌍</span>
          <div>
            <strong class="text-gray-900">โรมมิ่งระหว่างประเทศ</strong>
            <p class="text-gray-700 mt-1">แพงที่สุด แต่ไม่ต้องตั้งค่าอะไร ตรวจสอบกับผู้ให้บริการของคุณก่อน</p>
          </div>
        </li>
      </ul>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>📖 คู่มือฉบับเต็ม:</strong> <a href="/th/life/sim-card-guide/" class="text-blue-600 hover:underline">SIM Card และ eSIM ที่ดีที่สุดสำหรับนักท่องเที่ยวในจีน</a></p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="vpn" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🔒</span> VPN: การเข้าถึงอินเทอร์เน็ตอย่างอิสระในจีน
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">นี่คือความจริง: <strong>Google, Instagram, WhatsApp, Facebook, YouTube — ไม่มีอะไรทำงานบนอินเทอร์เน็ตภายในประเทศจีน</strong> ถ้าคุณพึ่งพาบริการเหล่านี้ในการสื่อสาร ทำงาน หรือความบันเทิง คุณต้องตั้งค่า VPN ก่อนเดินทาง</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-12">คำสำคัญคือ <strong>ก่อน</strong> — เว็บไซต์และแอป VPN ถูกบล็อกในจีน ดังนั้นคุณไม่สามารถดาวน์โหลดได้หลังจากถึง</p>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>📖 คู่มือฉบับเต็ม:</strong> <a href="/th/life/vpn-guide/" class="text-blue-600 hover:underline">VPN ที่ดีที่สุดสำหรับการเดินทางในจีน</a></p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="language" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🗣️</span> ทักษะภาษา: ต้องใช้ภาษาจีนมากแค่ไหน?
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">คุณสามารถเที่ยวจีนได้โดยไม่ต้องพูดภาษาจีนเลย แต่คุณจะมีประสบการณ์ที่ดีกว่ามาก — บริการดีกว่า ราคาดีกว่า ปฏิสัมพันธ์ดีกว่า — ถ้าคุณเรียนรู้สักสิบกว่าประโยค</p>

      <p class="text-lg font-bold text-gray-900 mb-4">การแบ่งระดับตามความเป็นจริง:</p>

      <ul class="space-y-4 mb-12">
        <li class="flex items-start gap-3 p-4 bg-orange-50 rounded-xl">
          <span class="text-orange-500 text-xl">😅</span>
          <div>
            <strong>ไม่รู้ภาษาจีนเลย:</strong> คุณรอดได้ ภาษาอังกฤษพบได้ทั่วไปในโรงแรมและแหล่งท่องเที่ยว แต่คาดหวังความยุ่งยากที่ร้านอาหารและร้านค้าท้องถิ่น
          </div>
        </li>
        <li class="flex items-start gap-3 p-4 bg-green-50 rounded-xl">
          <span class="text-green-500 text-xl">👍</span>
          <div>
            <strong>10–15 วลี:</strong> คุณสบายมาก การพูด "ขอบคุณ" "เท่าไหร่" และ "เช็คบิล" เปลี่ยนวิธีที่คนปฏิบัติต่อคุณ
          </div>
        </li>
        <li class="flex items-start gap-3 p-4 bg-blue-50 rounded-xl">
          <span class="text-blue-500 text-xl">🚀</span>
          <div>
            <strong>50+ วลี:</strong> คุณนำหน้านักท่องเที่ยวส่วนใหญ่และสามารถเดินทางได้อย่างอิสระ
          </div>
        </li>
      </ul>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>📖 คู่มือฉบับเต็ม:</strong> <a href="/th/life/chinese-phrases/" class="text-blue-600 hover:underline">วลีภาษาจีนที่จำเป็นสำหรับนักเดินทาง</a></p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="luggage" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🎒</span> กระเป๋าเดินทาง: อะไรที่แตกต่างเมื่อเดินทางในจีน?
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">การแพ็คของไปจีนไม่ต่างจากการเดินทางอื่นมากนัก — แต่มีบางอย่างที่ทำให้นักท่องเที่ยวครั้งแรกตกใจ:</p>

      <ul class="space-y-3 mb-12">
        <li class="flex items-start gap-3">
          <span class="text-red-500 text-xl">🚻</span>
          <span class="text-gray-700">ห้องน้ำสาธารณะมักไม่มีกระดาษชำระ (พกมาเอง)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-500 text-xl">🗺️</span>
          <span class="text-gray-700">Google Maps จะไม่ทำงานในจีน (ดาวน์โหลดแผนที่ท้องถิ่น)</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-500 text-xl">🌡️</span>
          <span class="text-gray-700">สภาพอากาศแตกต่างกันมากระหว่างเหนือและใต้</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-red-500 text-xl">👟</span>
          <span class="text-gray-700">คุณจะเดินมากกว่าที่คาดไว้มาก</span>
        </li>
      </ul>

      <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 mb-12 not-prose">
        <p class="text-gray-700"><strong>📖 คู่มือฉบับเต็ม:</strong> <a href="/th/life/packing-guide/" class="text-blue-600 hover:underline">สิ่งที่ต้องแพ็คไปจีน — คู่มือฤดูกาลและสภาพอากาศ</a></p>
      </div>

      <hr class="border-gray-200 my-12" />

            <h2 id="checklist" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">✅</span> เช็คลิสต์สุดยอดก่อนออกเดินทาง
      </h2>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold">เรียบร้อย?</th>
              <th class="px-6 py-4 font-bold">รายการ</th>
              <th class="px-6 py-4 font-bold">ช่วยเรื่อง</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">☐</td><td class="px-6 py-4">ดาวน์โหลด WeChat และ Alipay ตั้งค่าการชำระเงิน</td><td class="px-6 py-4">จ่ายทุกอย่าง</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">☐</td><td class="px-6 py-4">ติดตั้ง DiDi, Amap, Trip.com</td><td class="px-6 py-4">การเดินทาง</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">☐</td><td class="px-6 py-4">ซื้อ eSIM หรือตรวจสอบแผนโรมมิ่ง</td><td class="px-6 py-4">เชื่อมต่ออยู่เสมอ</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">☐</td><td class="px-6 py-4"><a href="/th/life/vpn-guide/" class="text-blue-600 hover:underline">ตั้งค่า VPN</a></td><td class="px-6 py-4">เข้าถึงเว็บไซต์ที่ถูกบล็อก</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">☐</td><td class="px-6 py-4">ดาวน์โหลด Google Translate แบบออฟไลน์หรือ Pleco</td><td class="px-6 py-4">การสื่อสาร</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">☐</td><td class="px-6 py-4">เรียนรู้วลีภาษาจีนพื้นฐาน 10 ประโยค</td><td class="px-6 py-4">การโต้ตอบประจำวัน</td></tr>
            <tr class="border-b border-gray-100"><td class="px-6 py-4">☐</td><td class="px-6 py-4">แพ็คพาวเวอร์แบงก์ ทิชชู่ อะแดปเตอร์</td><td class="px-6 py-4">หลีกเลี่ยงปัญหาทั่วไป</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-6 py-4">☐</td><td class="px-6 py-4">เก็บสำเนาดิจิทัลพาสปอร์ต + วีซ่า</td><td class="px-6 py-4">สำรองข้อมูลฉุกเฉิน</td></tr>
          </tbody>
        </table>
      </div>
    </div>

        <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/th/life/essential-apps/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">📱 10 แอปที่ต้องมีก่อนเดินทางไปจีน</p>
          <p class="text-sm text-gray-600">ชุดเครื่องมือแอป essentials สำหรับเที่ยวจีน</p>
