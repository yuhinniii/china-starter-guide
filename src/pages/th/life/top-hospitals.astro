---
import Layout from '@layouts/Layout.astro';
const title = "โรงพยาบาลชั้นนำที่มีแผนกนานาชาติในจีน";
const description = "โรงพยาบาลระดับ A++++ ที่ดีที่สุดของจีนที่มีแผนกนานาชาติ (国际部) สำหรับนักท่องเที่ยวต่างชาติ — แยกตามเมือง";
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/life/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปชีวิตในจีน
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🏥 การดูแลทางการแพทย์</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        โรงพยาบาลชั้นนำที่มีแผนกนานาชาติในจีน
      </h1>
      <p class="text-xl text-gray-600 mb-6">ทั้งหมดได้รับการจัดอันดับ A++++ (ระดับสูงสุด) โดยการจัดอันดับโรงพยาบาลรวมของมหาวิทยาลัยฟู่ต้าน</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 5 นาที</span>
      </div>
    </header>

    <div class="bg-gray-50 rounded-2xl p-6 mb-12 not-prose">
      <p class="text-gray-700 text-sm">โรงพยาบาลทั้งหมดที่ระบุไว้ได้รับการจัดอันดับ <strong>A++++</strong> ในการจัดอันดับโรงพยาบาลรวมของมหาวิทยาลัยฟู่ต้านปี 2024 การจัดอันดับเฉพาะทางมาจากการจัดอันดับเฉพาะทางของฟู่ต้านเดียวกัน ครอบคลุมมากกว่า 40 สาขาทางคลินิกตามการประเมินโดยผู้เชี่ยวชาญ</p>
      <p class="text-gray-500 text-xs mt-2">ที่มา: https://rank.cn-healthcare.com/fudan/national-general/year/2024</p>
    </div>

    <div class="prose prose-lg max-w-none">

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🏥</span> ปักกิ่ง (5 โรงพยาบาล)
      </h2>

      <div class="space-y-6 mb-12 not-prose">
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-blue-900 mb-2">Peking Union Medical College Hospital (北京协和医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> #1 ในจีนโดยรวม โรคข้อ โรคสตรี ต่อมไร้ท่อ รังสีวิทยา และเวชศาสตร์นิวเคลียร์ ติดอันดับท็อป 2 ของประเทศอย่างต่อเนื่อง</p>
        </div>
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-blue-900 mb-2">PLA General Hospital (中国人民解放军总医院 / 301)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> โรงพยาบาลทหารที่ใหญ่ที่สุดในจีน หูคอจมูก ศัลยกรรมกระดูก และโรคไต ติดอันดับท็อป 3 ของประเทศ</p>
        </div>
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-blue-900 mb-2">Beijing Tiantan Hospital (首都医科大学附属北京天坛医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> ศัลยกรรมประสาทและประสาทวิทยา อันดับ #1 ของประเทศ — ศูนย์สมองที่ใหญ่ที่สุดในจีน</p>
        </div>
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-blue-900 mb-2">Beijing Anzhen Hospital (首都医科大学附属北京安贞医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> โรคหัวใจและศัลยกรรมหัวใจและหลอดเลือด ติดอันดับท็อป 3 ของประเทศ ทำผ่าตัดหัวใจมากกว่า 20,000 ครั้งต่อปี</p>
        </div>
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-blue-900 mb-2">Cancer Hospital Chinese Academy of Medical Sciences (中国医学科学院肿瘤医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> มะเร็งวิทยา อันดับ #1 ของประเทศ ที่ตั้งของศูนย์มะเร็งแห่งชาติจีน</p>
        </div>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🏥</span> เซี่ยงไฮ้ (6 โรงพยาบาล)
      </h2>

      <div class="space-y-6 mb-12 not-prose">
        <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-green-900 mb-2">Zhongshan Hospital, Fudan University (复旦大学附属中山医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> #1 ในเซี่ยงไฮ้โดยรวม โรคหัวใจและศัลยกรรมตับ ติดอันดับท็อป 3 ของประเทศ</p>
        </div>
        <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-green-900 mb-2">Ruijin Hospital, Shanghai Jiao Tong University (上海交通大学医学院附属瑞金医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> ต่อมไร้ท่อ อันดับ #1 ของประเทศ โลหิตวิทยา อันดับ #1 ของประเทศ โรคไหม้และเวชศาสตร์ระบบหายใจก็อยู่ในท็อป 3 ของประเทศ</p>
        </div>
        <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-green-900 mb-2">Huashan Hospital, Fudan University (复旦大学附属华山医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> โรคผิวหนัง อันดับ #1 ของประเทศ ศัลยกรรมประสาท อันดับ #2 ของประเทศ โรงพยาบาลที่ได้รับความนิยมมากที่สุดในหมู่ชาวต่างชาติในเซี่ยงไฮ้</p>
        </div>
        <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-green-900 mb-2">Fudan University Shanghai Cancer Center (复旦大学附属肿瘤医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> มะเร็งวิทยา ในท็อป 3 ของประเทศ โรงพยาบาลมะเร็งที่ใหญ่ที่สุดในจีนตะวันออก</p>
        </div>
        <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-green-900 mb-2">Shanghai Ninth People's Hospital (上海交通大学医学院附属第九人民医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> ศัลยกรรมพลาสติก อันดับ #1 ของประเทศ ทันตกรรม ในท็อป 2 ศัลยกรรมกระดูก ในท็อป 10</p>
        </div>
        <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-green-900 mb-2">Children's Hospital of Fudan University (复旦大学附属儿科医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> กุมารเวชศาสตร์ อันดับ #1 ของประเทศ คลินิกนานาชาติที่มีแพทย์พูดภาษาอังกฤษ</p>
        </div>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🏥</span> กวางโจว (2 โรงพยาบาล)
      </h2>

      <div class="space-y-6 mb-12 not-prose">
        <div class="bg-purple-50 border border-purple-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-purple-900 mb-2">The First Affiliated Hospital, Sun Yat-sen University (中山大学附属第一医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> #1 ในจีนตอนใต้ โรคไตและระบบทางเดินอาหาร ติดอันดับท็อป 3 ของประเทศ</p>
        </div>
        <div class="bg-purple-50 border border-purple-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-purple-900 mb-2">Sun Yat-sen University Cancer Center (中山大学附属肿瘤医院)</h3>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> มะเร็งวิทยา ในท็อป 5 ของประเทศ เป็นผู้นำระดับโลกในการรักษามะเร็งโพรงหลังจมูก</p>
        </div>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🏥</span> เมืองใหญ่อื่น ๆ
      </h2>

      <div class="space-y-6 mb-12 not-prose">
        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-orange-900 mb-1">West China Hospital, Sichuan University</h3>
          <p class="text-sm text-gray-500 mb-2">เฉิงตู</p>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> #1 ในจีนตะวันตกเฉียงใต้ ท็อป 5 ของประเทศ วิสัญญีวิทยา #1 เวชศาสตร์ระบบหายใจ ท็อป 3</p>
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-orange-900 mb-1">Tongji Hospital, Tongji Medical College</h3>
          <p class="text-sm text-gray-500 mb-2">อู่ฮั่น</p>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> สูติศาสตร์-นรีเวชวิทยา ในท็อป 3 ของประเทศ ระบบทางเดินปัสสาวะ ในท็อป 5</p>
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-orange-900 mb-1">Union Hospital, Tongji Medical College</h3>
          <p class="text-sm text-gray-500 mb-2">อู่ฮั่น</p>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> โลหิตวิทยา ในท็อป 3 ของประเทศ ศัลยกรรมหัวใจและหลอดเลือด ในท็อป 5</p>
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-orange-900 mb-1">The First Affiliated Hospital of Zhejiang University</h3>
          <p class="text-sm text-gray-500 mb-2">หังโจว</p>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> ท็อป 5 ในจีนตะวันออก โรคติดเชื้อ #1 ของประเทศ</p>
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-orange-900 mb-1">Xijing Hospital, Air Force Medical University</h3>
          <p class="text-sm text-gray-500 mb-2">ซีอาน</p>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> ระบบทางเดินอาหาร #1 ของประเทศ โรคไหม้ ในท็อป 3</p>
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-orange-900 mb-1">The First Hospital of China Medical University</h3>
          <p class="text-sm text-gray-500 mb-2">เฉิ่นหยาง</p>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> #1 ในจีนตะวันออกเฉียงเหนือ โรคผิวหนังและศัลยกรรมกระดูก ในท็อป 10 ของประเทศ</p>
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-orange-900 mb-1">Nanjing Drum Tower Hospital (南京鼓楼医院)</h3>
          <p class="text-sm text-gray-500 mb-2">หนานจิง</p>
          <p class="text-gray-700"><strong>สาขาเด่น:</strong> โรคข้อ ในท็อป 5 ของประเทศ ศูนย์เวชศาสตร์การเจริญพันธุ์ชั้นนำ</p>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose mt-12">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/th/life/seeing-a-doctor/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">การพบแพทย์ในจีน</p>
          <p class="text-sm text-gray-600">คลินิก โรงพยาบาล และสิ่งที่คาดหวัง</p>
        </a>
        <a href="/th/life/travel-insurance/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">ประกันการเดินทางสำหรับจีน</p>
          <p class="text-sm text-gray-600">สิ่งที่คุณต้องมีก่อนไป</p>
        </a>
        <a href="/th/life/emergency-numbers/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">เบอร์โทรฉุกเฉินและวิธีปฏิบัติ</p>
          <p class="text-sm text-gray-600">บันทึกก่อนที่คุณจะต้องการ</p>
        </a>
      </div>
    </div>
  </article>
</Layout>