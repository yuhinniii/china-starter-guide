---
import Layout from '@layouts/Layout.astro';
const title = 'คู่มือการชำระเงิน — วิธีจ่ายเงินในจีน';
const description = 'ติดตั้ง Alipay ก่อนบิน — แค่นี้ครอบคลุม 95% ของการชำระเงินแล้ว';
---

<Layout title={title} description={description} lang="th">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">การชำระเงินในจีน</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">ติดตั้ง Alipay ก่อนบิน — แค่นี้ครอบคลุม 95% ของการชำระเงินแล้ว</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">2</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">แอปจ่ายเงินมือถือ</p>
      </div>
      <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-indigo-800">2</p>
        <p class="text-xs font-semibold text-indigo-800 uppercase tracking-wide mt-1">บทช่วยสอนตั้งค่า</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">คู่มือบัตรเครดิต</p>
      </div>
      <div class="bg-pink-50 border border-pink-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-pink-800">1</p>
        <p class="text-xs font-semibold text-pink-800 uppercase tracking-wide mt-1">คู่มือทิป</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">เริ่มต้นใช้งาน</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/payment/setup-alipay/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💰 บทช่วยสอน</span>
            <p class="text-base font-bold text-gray-900 mt-1">วิธีตั้งค่า Alipay สำหรับชาวต่างชาติ</p>
            <p class="text-sm text-gray-600 mt-0.5">ดาวน์โหลด สมัครด้วยเบอร์ต่างชาติ และเชื่อมต่อบัตรเครดิตต่างประเทศ</p>
          </a>
          <a href="/th/payment/setup-wechat/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💬 บทช่วยสอน</span>
            <p class="text-base font-bold text-gray-900 mt-1">วิธีตั้งค่า WeChat Pay สำหรับชาวต่างชาติ</p>
            <p class="text-sm text-gray-600 mt-0.5">ดาวน์โหลด WeChat สมัคร ยืนยันตัวตน และผูกบัตรต่างประเทศ</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-indigo-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-indigo-800">การใช้บัตรต่างประเทศ</h2>
          <span class="text-xs font-medium text-indigo-800 opacity-60">1 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/payment/foreign-cards/" class="block bg-indigo-50 border border-indigo-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-indigo-800">💳 คู่มือ</span>
            <p class="text-base font-bold text-gray-900 mt-1">ใช้บัตรเครดิตต่างประเทศในจีนได้หรือไม่?</p>
            <p class="text-sm text-gray-600 mt-0.5">ที่ Visa หรือ Mastercard ของคุณใช้ได้จริง ค่าใช้จ่ายถอนจากตู้ ATM</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">ปัญหาที่พบบ่อย</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/payment/payment-fails/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🔧 แก้ปัญหา</span>
            <p class="text-base font-bold text-gray-900 mt-1">เมื่อการชำระเงินล้มเหลวต้องทำยังไง?</p>
            <p class="text-sm text-gray-600 mt-0.5">สาเหตุทั่วไปที่จ่ายเงินไม่ได้และวิธีแก้ไขทีละขั้นตอน</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-pink-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-pink-800">ทิปและวัฒนธรรม</h2>
          <span class="text-xs font-medium text-pink-800 opacity-60">1 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/payment/tipping/" class="block bg-pink-50 border border-pink-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-pink-800">🎭 วัฒนธรรม</span>
            <p class="text-base font-bold text-gray-900 mt-1">วัฒนธรรมการให้ทิปในจีน: จำเป็นไหม?</p>
            <p class="text-sm text-gray-600 mt-0.5">ไม่ต้องให้ทิป ไม่ใช่ธรรมเนียมในจีน คู่มือฉบับย่อว่าควรทำยังไง</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">คู่มือฉบับสมบูรณ์</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/payment/payment-guide/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">📖 ภาพรวม</span>
            <p class="text-base font-bold text-gray-900 mt-1">วิธีจ่ายเงินในจีน: คู่มือฉบับสมบูรณ์</p>
            <p class="text-sm text-gray-600 mt-0.5">Alipay, WeChat Pay, เงินสด หรือบัตรเครดิต — ภาพรวมทั้งหมด</p>
          </a>
        </div>
      </div>
    </div>

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">ขั้นตอนถัดไป</p>
            <h3 class="text-xl font-bold text-gray-900">เชื่อมต่อและเดินทาง</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">ตั้งค่าการชำระเงินแล้ว ต่อไป: ซื้อ eSIM สำหรับข้อมูลและเรียนรู้วิธีเดินทาง</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/th/life/sim-card-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              📶 ซื้อ eSIM
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/th/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 คู่มือการเดินทาง
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>