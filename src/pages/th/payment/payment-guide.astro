---
import Layout from '@layouts/Layout.astro';
const title = 'วิธีจ่ายเงินในจีน: คู่มือฉบับสมบูรณ์สำหรับนักท่องเที่ยวต่างชาติ';
const description = 'Alipay, WeChat Pay, เงินสด หรือบัตรเครดิต — ภาพรวมตัวเลือกการชำระเงินในจีนสำหรับนักท่องเที่ยวต่างชาติ ปี 2026';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/payment/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าการชำระเงิน
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">💳 การชำระเงิน</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        วิธีจ่ายเงินในจีน: คู่มือฉบับสมบูรณ์สำหรับนักท่องเที่ยวต่างชาติ
      </h1>
      <p class="text-xl text-gray-600 mb-6">สิ่งแรกที่นักเดินทางส่วนใหญ่อยากรู้: เราจะจ่ายค่าสินค้าในจีนยังไง?</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 5 นาที</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 คำตอบสั้นๆ</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        <strong>ติดตั้ง Alipay ก่อนบิน</strong> เชื่อมต่อ Visa หรือ Mastercard ของคุณ — แค่นี้ครอบคลุม 95% ของการชำระเงินในจีน พกเงินสด ¥500–1000 ไว้เป็นตัวสำรอง WeChat Pay เป็นตัวเลือกเสริมที่ดี บัตรเครดิตจริงใช้ได้ในที่จำกัดเท่านั้น
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#short-answer" class="text-blue-600 hover:underline">💡 คำตอบสั้นๆ</a></li>
        <li><a href="#what-most-do" class="text-blue-600 hover:underline">👍 สิ่งที่นักเดินทางส่วนใหญ่ทำ</a></li>
        <li><a href="#one-thing" class="text-blue-600 hover:underline">🔑 เรื่องหนึ่งที่ควรรู้ก่อนลงรายละเอียด</a></li>
        <li><a href="#which-method" class="text-blue-600 hover:underline">🤔 วิธีไหนที่คุณควรใช้?</a></li>
      </ul>
    </nav>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">
      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        สิ่งแรกที่นักเดินทางส่วนใหญ่ถามฉันเกี่ยวกับจีนคือ <strong>"เราจะจ่ายค่าของที่นั่นยังไง?"</strong>
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        เป็นคำถามที่สมเหตุสมผล เดินเข้าร้านในจีนแล้วไม่มีใครหยิบกระเป๋าสตางค์ ทุกคนสแกน QR Code มันอาจดูน่ากลัวถ้าคุณมาจากประเทศที่แค่แตะจ่ายก็หมายถึง Apple Pay และยังใช้บัตรในการซื้อของครึ่งหนึ่ง
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        แต่ข่าวดีคือ <strong>การจ่ายเงินในจีนนั้นตรงไปตรงมาสำหรับชาวต่างชาติ</strong> ระบบเปิดกว้างมากขึ้นอย่างมากในช่วงสองสามปีที่ผ่านมา
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 id="short-answer" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">💡</span> คำตอบสั้นๆ
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        คุณมีสี่ตัวเลือก:
      </p>

      <ol class="list-decimal pl-6 space-y-4 text-gray-700 mb-6">
        <li><strong>Alipay (支付宝)</strong> — แอปชำระเงินมือถือที่ได้รับความนิยมมากที่สุดในจีน ตั้งค่าด้วยพาสปอร์ตต่างชาติและบัตรเครดิตระหว่างประเทศใช้เวลาประมาณ 15 นาที นี่คือสิ่งที่ฉันแนะนำสำหรับนักเดินทางส่วนใหญ่</li>
        <li><strong>WeChat Pay (微信支付)</strong> — อยู่ใน WeChat (แอปอเนกประสงค์ของจีน) คล้ายกับ Alipay มาก แต่คุณต้องติดตั้ง WeChat อยู่แล้ว anyway (เชื่อฉันสิ คุณต้องใช้มัน)</li>
        <li><strong>เงินสด (现金)</strong> — ใช่ เงินสดยังใช้ได้ แต่ร้านค้าจะมีปัญหาในการทอนเงิน และร้านค้าเล็กๆ บางแห่งอาจไม่มีเงินทอน</li>
        <li><strong>บัตรเครดิตจริง</strong> — ใช้ได้ที่โรงแรมนานาชาติ ห้างสรรพสินค้าระดับสูง และสนามบิน อย่าพึ่งพาวิธีนี้เป็นหลัก</li>
      </ol>

      <div class="overflow-x-auto mb-12 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-6 py-4 font-bold"></th>
              <th class="px-6 py-4 font-bold text-center bg-blue-600">Alipay</th>
              <th class="px-6 py-4 font-bold text-center bg-green-600">WeChat Pay</th>
              <th class="px-6 py-4 font-bold text-center bg-orange-600">เงินสด</th>
              <th class="px-6 py-4 font-bold text-center bg-purple-600">บัตรเครดิต</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-6 py-4 font-semibold">รับทุกที่?</td>
              <td class="px-6 py-4 text-center">เกือบทุกที่</td>
              <td class="px-6 py-4 text-center">เกือบทุกที่</td>
              <td class="px-6 py-4 text-center">ส่วนใหญ่</td>
              <td class="px-6 py-4 text-center">จำกัด</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-6 py-4 font-semibold">ต้องมีบัญชีธนาคารจีน?</td>
              <td class="px-6 py-4 text-center">ไม่</td>
              <td class="px-6 py-4 text-center">ไม่</td>
              <td class="px-6 py-4 text-center">ไม่</td>
              <td class="px-6 py-4 text-center">ไม่</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-6 py-4 font-semibold">ต้องมีเบอร์โทรศัพท์จีน?</td>
              <td class="px-6 py-4 text-center">ไม่</td>
              <td class="px-6 py-4 text-center">ไม่</td>
              <td class="px-6 py-4 text-center">ไม่</td>
              <td class="px-6 py-4 text-center">ไม่</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-6 py-4 font-semibold">ค่าธรรมเนียม</td>
              <td class="px-6 py-4 text-center">ฟรีต่ำกว่า 200 หยวน<br/>3% เกินกว่านั้น</td>
              <td class="px-6 py-4 text-center">ฟรีต่ำกว่า 200 หยวน<br/>3% เกินกว่านั้น</td>
              <td class="px-6 py-4 text-center">แลกเปลี่ยนเงิน + ค่าธนาคาร</td>
              <td class="px-6 py-4 text-center">DCC + ค่าธนาคาร</td>
            </tr>
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="what-most-do" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">👍</span> สิ่งที่นักเดินทางส่วนใหญ่ทำ
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        จริงๆนะ แค่ติดตั้ง Alipay ก่อนบิน เชื่อมต่อ Visa หรือ Mastercard ของคุณ แค่นี้ครอบคลุม 95% ของการชำระเงินในจีน — ตั้งแต่แผงขายอาหารริมทางไปจนถึงตั๋วรถไฟ
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        พกเงินสดสำรองไว้บ้าง (¥500–1000 ก็เพียงพอ) แล้วคุณก็พร้อมแล้ว
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        การมี WeChat Pay ก็มีประโยชน์ถ้าคุณวางแผนจะใช้ WeChat สำหรับแชท (ซึ่งคุณคงจะใช้) แต่ถ้าตั้งค่าแค่แอปเดียว ให้เลือก Alipay
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 id="one-thing" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🔑</span> เรื่องหนึ่งที่ควรรู้ก่อนลงรายละเอียด
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        ระบบการชำระเงินของจีนใช้ QR Code พ่อค้าทุกราย — ตั้งแต่คนขายมันหวานอบที่หัวมุมไปจนถึงเคาน์เตอร์ขายตั๋วที่เซี่ยงไฮ้ดิสนีย์แลนด์ — มี QR Code บนเคาน์เตอร์ คุณสแกนด้วยแอป ใส่จำนวนเงิน (หรือร้านค้าใส่ให้) แล้วแตะจ่าย เท่านั้นเอง
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        บัตรเครดิตต่างประเทศของคุณอยู่เบื้องหลัง คุณเชื่อมต่อครั้งเดียว แล้วใช้แอปสำหรับทุกอย่าง แทบไม่ต้องหยิบบัตรจริงออกมาเลย ดู <a href="/th/payment/foreign-cards/" class="text-brand-600 hover:underline">คู่มือการใช้บัตรเครดิตต่างประเทศในจีน</a> สำหรับข้อมูลที่สมจริงว่าบัตรของคุณใช้ได้ที่ไหนบ้าง
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 id="which-method" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🤔</span> วิธีไหนที่คุณควรใช้?
      </h2>

      <div class="space-y-4 mb-8 not-prose">
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-blue-900 mb-2">คำตอบสั้นๆ: ใช้ Alipay</h3>
          <p class="text-gray-700 mb-3">ติดตั้งภายใน 15 นาทีด้วยพาสปอร์ตและบัตรต่างประเทศ ใช้ได้ที่ 95% ของร้านค้า ไม่ต้องมีบัญชีธนาคารจีน</p>
          <a href="/th/payment/setup-alipay/" class="inline-flex items-center gap-1 text-sm text-brand-600 font-medium hover:underline">วิธีตั้งค่า Alipay สำหรับชาวต่างชาติ →</a>
        </div>

        <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-green-900 mb-2">ตัวสำรองที่แนะนำ: WeChat Pay</h3>
          <p class="text-gray-700 mb-3">มีไว้เป็นตัวสำรองก็ดี นอกจากนี้ WeChat ก็เป็นวิธีสื่อสารของคนจีน — การมีทั้งสองแอปทำให้คุณครอบคลุมทุกสถานการณ์</p>
          <a href="/th/payment/setup-wechat/" class="inline-flex items-center gap-1 text-sm text-brand-600 font-medium hover:underline">วิธีตั้งค่า WeChat Pay สำหรับชาวต่างชาติ →</a>
        </div>

        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6">
          <h3 class="text-xl font-bold text-orange-900 mb-2">กรณีฉุกเฉิน: เงินสด</h3>
          <p class="text-gray-700 mb-3">พก ¥500–1000 ในแบงก์เล็กไว้เสมอ สำหรับร้านค้าเล็กๆ เหตุฉุกเฉิน หรือตอนที่แอปมีปัญหา</p>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose mt-12">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/th/payment/setup-alipay/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">วิธีตั้งค่า Alipay สำหรับชาวต่างชาติ</p>
          <p class="text-sm text-gray-600">คู่มือการติดตั้งทีละขั้นตอน</p>
        </a>
        <a href="/th/payment/setup-wechat/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">วิธีตั้งค่า WeChat Pay สำหรับชาวต่างชาติ</p>
          <p class="text-sm text-gray-600">คำแนะนำ WeChat Pay</p>
        </a>
        <a href="/th/payment/foreign-cards/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">ใช้บัตรเครดิตต่างประเทศในจีนได้ไหม?</p>
          <p class="text-sm text-gray-600">ที่ที่ใช้ได้ ที่ที่ใช้ไม่ได้</p>
        </a>
        <a href="/th/payment/payment-fails/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">เมื่อการชำระเงินล้มเหลวต้องทำยังไง?</p>
          <p class="text-sm text-gray-600">คู่มือแก้ปัญหา</p>
        </a>
      </div>
    </div>

    <!-- Sources -->
    <div class="mt-8 pt-6 border-t border-gray-200 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-3">แหล่งอ้างอิง</h3>
      <ul class="space-y-2">
        <li><a href="https://www.alipayplus.com/consumer/" target="_blank" rel="noopener" class="text-blue-600 underline text-sm">Alipay - ศูนย์ผู้บริโภค</a></li>
        <li><a href="https://cs.help.wechat.com/hc/en-us" target="_blank" rel="noopener" class="text-blue-600 underline text-sm">WeChat - ศูนย์ช่วยเหลือ</a></li>
      </ul>
    </div>
  </article>
</Layout>