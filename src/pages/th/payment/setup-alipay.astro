---
import Layout from '@layouts/Layout.astro';
const title = 'วิธีตั้งค่า Alipay สำหรับชาวต่างชาติ (2026): คู่มือทีละขั้นตอน';
const description = 'คู่มือการตั้งค่า Alipay สำหรับชาวต่างชาติในจีนแบบทีละขั้นตอน ดาวน์โหลด สมัครด้วยเบอร์ต่างประเทศ ยืนยันตัวตน และเชื่อมต่อบัตรเครดิตต่างประเทศ';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/payment/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าการชำระเงิน
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">💳 การชำระเงิน</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        วิธีตั้งค่า Alipay สำหรับชาวต่างชาติ (2026)
      </h1>
      <p class="text-xl text-gray-600 mb-6">ใช้เวลาประมาณ 15 นาที — วิธีทำมีดังนี้</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 5 นาที</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 คำตอบสั้นๆ</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        <strong>ดาวน์โหลด Alipay สมัครด้วยเบอร์โทรศัพท์ต่างประเทศ ยืนยันตัวตนด้วยพาสปอร์ต และเชื่อมต่อ Visa/Mastercard ต่างประเทศ</strong> ไม่ต้องมีบัญชีธนาคารจีนหรือเบอร์โทรศัพท์จีน ใช้เวลาประมาณ 15 นาที
      </p>
    </div>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">
      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        ให้ฉันแนะนำคุณทีละขั้นตอน ฉันเคยทำด้วยตัวเองและช่วยเพื่อนๆ อีกหลายคน <strong>ใช้เวลาประมาณ 15 นาที</strong> และคุณสามารถทำทุกอย่างก่อนขึ้นเครื่องบินได้เลย
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">📱</span> ขั้นตอนที่ 1: ดาวน์โหลดแอป
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        ไปที่ App Store ของคุณแล้วค้นหา <strong>"Alipay"</strong> ผู้พัฒนาคือ "Alipay (Hangzhou) Technology Co., Ltd." — นั่นคือของจริง มีของปลอมอยู่บ้าง ดังนั้นตรวจสอบให้ดี
      </p>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-6">
        <li><strong>iOS:</strong> App Store</li>
        <li><strong>Android:</strong> Google Play</li>
      </ul>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        โทรศัพท์ของคุณต้องใช้ iOS 12+ หรือ Android 8+ ถ้าโทรศัพท์ของคุณอายุมากกว่า 5-6 ปี คุณอาจเจอปัญหา
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">📞</span> ขั้นตอนที่ 2: สมัครด้วยเบอร์โทรศัพท์
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        เปิดแอปแล้วแตะ "สมัครสมาชิก" คุณจะถูกขอให้ใส่เบอร์โทรศัพท์ ข่าวดีคือ <strong>คุณสามารถใช้เบอร์โทรศัพท์ต่างประเทศของคุณได้</strong> เลือกรหัสประเทศจากเมนูแบบเลื่อนลง (สหรัฐอเมริกาคือ +1, UK คือ +44 ฯลฯ) ใส่เบอร์ของคุณ แล้วพวกเขาจะส่งรหัสยืนยันทาง SMS
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🛂</span> ขั้นตอนที่ 3: ยืนยันตัวตน
      </h2>

      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-6 not-prose">
        <p class="text-yellow-900"><strong>นี่คือขั้นตอนที่สำคัญที่สุด</strong> ถ้าไม่ยืนยันตัวตน คุณจะใช้ Alipay ชำระเงินไม่ได้</p>
      </div>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        วิธีทำ:
      </p>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-6">
        <li>ไปที่ <strong>บัญชี → ยืนยันตัวตน</strong></li>
        <li>เลือก <strong>"พาสปอร์ตต่างประเทศ"</strong> เป็นประเภทบัตร</li>
        <li>ถ่ายรูปหน้าที่มีข้อมูลพาสปอร์ตให้ชัดเจน</li>
        <li>ถ่ายเซลฟี่ (ระบบจะเปรียบเทียบกับรูปในพาสปอร์ต)</li>
        <li>การยืนยันมักใช้เวลาไม่กี่นาทีหรือสูงสุด 24 ชั่วโมง</li>
      </ul>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        ตรวจสอบให้แน่ใจว่าหน้าพาสปอร์ตมีแสงเพียงพอและข้อความอ่านได้ชัดเจน รูปเบลอเป็นสาเหตุที่พบบ่อยที่สุดที่ทำให้การยืนยันล้มเหลว
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">💳</span> ขั้นตอนที่ 4: เชื่อมต่อบัตรเครดิตต่างประเทศ
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        ไปที่ <strong>บัตร → เพิ่มบัตร</strong> คุณสามารถเชื่อมต่อบัตรดังต่อไปนี้:
      </p>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-6">
        <li><strong>Visa</strong> — รับทั่วไป</li>
        <li><strong>Mastercard</strong> — รับทั่วไป</li>
      </ul>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        ใส่หมายเลขบัตร วันหมดอายุ และ CVV โดยปกติ Alipay จะทำการทดสอบการเรียกเก็บเงินเล็กน้อย (¥0.01–¥1.00) เพื่อยืนยันบัตร เงินจำนวนนี้จะถูกคืนโดยอัตโนมัติ
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">✅</span> เสร็จเรียบร้อย!
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        เท่านี้ก็เรียบร้อย ตอนนี้คุณสามารถใช้ Alipay จ่ายเงินที่ร้านค้าหลายล้านแห่งทั่วจีน เมื่ออยู่ที่ร้าน ให้เปิดแอป แตะ <strong>"จ่ายเงิน"</strong> แล้วสแกน QR Code ของร้าน
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        สำหรับการเดินทางรถไฟฟ้าและรถบัส คุณสามารถตั้งค่า <strong>QR Code การเดินทาง</strong> ใน Alipay ได้โดยตรง ต้องการความช่วยเหลือ? ดูภาพรวมการชำระเงินทั้งหมดสำหรับรายละเอียดเพิ่มเติม
      </p>
    </div>

    <div class="border-t border-gray-100 pt-6 mt-8">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-xl p-5 not-prose">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <h3 class="text-sm font-bold text-gray-900">📚 อ่านต่อ</h3>
          <div class="flex flex-wrap gap-2">
            <a href="/th/payment/payment-guide/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              วิธีจ่ายเงินในจีน
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/th/payment/setup-wechat/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              วิธีตั้งค่า WeChat Pay สำหรับชาวต่างชาติ
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/th/payment/payment-fails/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              เมื่อการชำระเงินล้มเหลวต้องทำยังไง?
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="not-prose mt-12 pt-8 border-t border-gray-200">
  <h3 class="text-base font-bold text-gray-900 mb-4 flex items-center gap-2">📚 แหล่งอ้างอิง</h3>
  <ul class="space-y-2">
    <li>
      <a href="https://www.alipayplus.com/consumer/" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
        <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        Alipay - ศูนย์ผู้บริโภค
        <svg class="w-3 h-3 text-gray-300 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </li>
  </ul>
</div>
  </article>
</Layout>