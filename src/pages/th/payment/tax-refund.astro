---
import Layout from '@layouts/Layout.astro';
import FAQPage from '../../../components/FAQPage.astro';

const title = "คืนภาษีตอนออกเดินทางจีนปี 2026: วิธีรับคืน 9%";
const description = "คืนภาษีตอนออกเดินทางจีนปี 2026: เกณฑ์ ¥200 เอกสารสามฉบับที่คุณต้องมี กำหนด 90 วัน และการตรวจศุลกากรสนามบินทำงานอย่างไรจริงๆ";

const faqs = [
  {
    question: "ฉันต้องใช้จ่ายเท่าไหร่ถึงจะเคลมคืนภาษีในจีนได้?",
    answer: "อย่างน้อย ¥200 ที่ร้านคืนภาษีร้านเดียวในหนึ่งวัน ขอใบสมัครคืนภาษี (离境退税申请单) และใบกำกับภาษี VAT ทั่วไป (增值税普通发票) ที่แคชเชียร์ และเก็บทั้งสองไว้ — ไม่มีมันการคืนภาษีทำไม่ได้"
  },
  {
    question: "ฉันต้องใช้พาสปอร์ตเพื่อเคลมคืนภาษีไหม?",
    answer: "ต้อง และต้องเป็นพาสปอร์ตตัวจริงที่คุณใช้เข้าจีน ใบสมัครคืนภาษีเขียนขึ้นด้วยประเภทและเลขที่พาสปอร์ตของคุณ และศุลกากรตรวจเอกสารกับตัวบุคคลที่ยืนอยู่ รูปถ่ายในโทรศัพท์และสำเนาไม่รับ"
  },
  {
    question: "เงินของฉันกลับคืนจริงๆ เท่าไหร่?",
    answer: "ประมาณ 9% สำหรับสินค้าส่วนใหญ่และประมาณ 6% สำหรับรายการอัตราลด อัตราตามข้อกฎหมายคือ 11% และ 8% หักประมาณ 2% ที่หน่วยงานคืนภาษีเรียกเก็บ สำหรับการซื้อ ¥10,000 จะได้ประมาณ ¥900 ไม่ใช่ ¥1,100"
  },
  {
    question: "ฉันรับคืนภาษีเป็นเงินสดที่สนามบินได้ไหม?",
    answer: "ได้ สูงสุด ¥20,000 ต่อการเคลมที่เคาน์เตอร์คืนภาษีภายในเขตออกเดินทาง ส่วนที่เกินกว่านั้นจ่ายด้วยการโอนเงินผ่านธนาคาร ร้านค้าและจุดคืนภาษีระดับเมืองบางแห่งก็จ่ายทันทีภายใต้โครงการคืนภาษีทันทีตอนซื้อ (即买即退)"
  },
  {
    question: "ฉันต้องนำสินค้ามาด้วยที่สนามบินไหม?",
    answer: "สำหรับการเคลมที่ถูกตรวจแบบสุ่ม ต้อง การเคลมที่มียอดขายต่ำกว่า ¥10,000 ถูกสุ่มตั้งแต่กรกฎาคม 2026; ถ้าอันของคุณไม่ถูกสุ่มคุณข้ามการตรวจได้ เก็บสินค้าที่เข้าเงื่อนไขคืนภาษีไว้ในกระเป๋าถือหรือบนสุดของกระเป๋าโหลดจนกว่าคุณจะผ่านศุลกากร"
  }
];
---

<Layout title={title} description={description} lang="th" type="Article">
  <nav class="mb-8 not-prose">
    <a href="/th/payment/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
      <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      กลับไปหน้าการชำระเงิน
    </a>
  </nav>

  <article class="max-w-4xl mx-auto px-6 py-12">
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">💳 การชำระเงิน</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">คืนภาษีตอนออกเดินทางจีน: วิธีรับคืน ~9% ตอนออกเดินทาง</h1>
      <p class="text-xl text-gray-600 mb-6">เกณฑ์ ¥200 เอกสารสามฉบับที่คุณต้องมี และวิธีผ่านการคืนภาษีในสนามบินโดยไม่เสียบ่ายทั้งหมด</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: ตุลาคม 2026</span>
        <span>⏱️ 8 นาที</span>
      </div>
    </header>

    <img
      src="/images/tax-refund/tax-refund-flow.webp"
      alt="แผนภาพการคืนภาษีตอนออกเดินทางจีน: ซื้อที่ร้าน tax-free รับใบสมัครคืนภาษีและใบกำกับภาษี VAT การตรวจสอบศุลกากร แล้วรับภาษีคืน"
      width="1080"
      height="606"
      class="w-full rounded-2xl mb-10 not-prose"
    />

    <div class="bg-gradient-to-r from-red-50 to-orange-50 border-l-4 border-red-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-red-900 mb-4">⚡ นักท่องเที่ยวรับคืนภาษีในจีนได้ไหม?</h2>
      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>คำตอบสั้นๆ:</strong> ได้ จ่ายอย่างน้อย <strong>¥200</strong> ที่ร้านเดียวที่แสดงป้าย <strong>Tax Free (退税商店)</strong> และคุณสามารถเคลมประมาณ <strong>9% กลับ</strong> สำหรับสินค้าส่วนใหญ่ตอนออกจีน หรือประมาณ <strong>6%</strong> สำหรับรายการอัตราลด คุณต้องการสามอย่าง: <strong>ใบสมัครคืนภาษี</strong> (离境退税申请单), <strong>ใบกำกับภาษีมูลค่าเพิ่มแบบทั่วไป</strong> (增值税普通发票), และ<strong>พาสปอร์ต</strong>ของคุณ — ตัวจริงที่คุณใช้เข้า เคลมที่สนามบินตอนออก หรือทันทีที่เคาน์เตอร์คืนภาษีทันทีตอนซื้อ (即买即退) ในเมือง สินค้าต้องออกจีนภายใน <strong>90 วัน</strong> ของการซื้อ ดู <a href="/th/payment/china-shopping/" class="text-red-700 underline">คู่มือช้อปปิ้งจีน</a> ของเราสำหรับสิ่งที่คุ้มค่าซื้อจริงๆ</p>
      <p class="text-lg leading-relaxed text-gray-700">การคืนภาษีนำไปใช้กับสิ่งของส่วนตัวที่คุณนำกลับบ้าน: เครื่องสำอาง อิเล็กทรอนิกส์ เสื้อผ้า ชา ไหม เครื่องปั้นดินเผา หยก งานคราฟต์ ไม่นำไปใช้กับสิ่งที่คุณบริโภคในจีน กับบริการ หรือกับสินค้าในรายการห้ามและจำกัด</p>
    </div>

    <div class="bg-yellow-50 border-l-4 border-yellow-400 rounded-r-2xl p-6 mb-12 not-prose">
      <p class="text-lg leading-relaxed text-yellow-900"><strong>ความจริงที่แท้จริง:</strong> นี่คือการคืนภาษี ไม่ใช่ส่วนลด — คุณจ่ายราคารวมภาษีเต็มที่แคชเชียร์และได้ส่วนหนึ่งคืนทีหลัง สำหรับเสื้อตัวและแม่เหล็กติดตู้เย็นมันไม่คุ้มค่าคิว: คุณต้องมี ¥200 ที่ร้านเดียวในหนึ่งวันก่อนที่จะเคลมได้ นาฬิกา 90 วันเริ่มนับตอนซื้อ และหน่วยงานเก็บประมาณ 2% ของที่คุณควรได้ สำหรับโน้ตบุ๊ก นาฬิกา รองเท้าหรือกระเป๋า มันคือ 9% ที่ง่ายที่สุดในการเดินทาง — ตราบใดที่คุณไม่โหลดกระเป๋าก่อนที่ศุลกากรจะดูสินค้า</p>
    </div>

    <h2 id="rules" class="text-3xl font-bold text-gray-900 mb-6 mt-14">กฎคืนภาษีตอนออกเดินทางของจีนคืออะไร?</h2>
    <p class="text-lg leading-relaxed text-gray-700 mb-4">โครงการนี้เรียกว่า <em>lí jìng tuì shuì</em> (离境退税) — แปลตรงตัวว่า "คืนภาษีตอนออกจากประเทศ" มันคืน VAT ที่คุณจ่ายสำหรับสินค้าที่ซื้อที่ร้าน tax-free ที่จดทะเบียน เมื่อสินค้านั้นออกจีนพร้อมคุณ อัตราหลักดูผูกใจกว้าง; สิ่งที่คุณเก็บจริงๆ ต่ำกว่านั้นเล็กน้อย</p>
    <p class="text-base text-gray-500 mb-4">กฎคืนภาษีตอนออกเดินทางของจีนในภาพรวม 2026</p>
    <div class="overflow-x-auto mb-8 not-prose">
      <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
        <caption class="sr-only">กฎคืนภาษีตอนออกเดินทางของจีนในปี 2026 — การใช้จ่ายขั้นต่ำ อัตราคืนภาษี คุณสมบัติ เอกสารประจำตัว กำหนดเวลา วงเงินเงินสด การดำเนินการไร้กระดาษ และคืนภาษีทันทีตอนซื้อ</caption>
        <thead>
          <tr class="bg-gray-900 text-white">
            <th class="px-6 py-4 font-bold">กฎ</th>
            <th class="px-6 py-4 font-bold">รายละเอียด</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">การใช้จ่ายขั้นต่ำ</td>
            <td class="px-6 py-4">¥200 ที่ร้านเดียว ในหนึ่งวัน ไม่ใช่ ¥200 ตลอดทริปช้อปปิ้ง — ร้านเดียว</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">อัตราคืนภาษี</td>
            <td class="px-6 py-4">11% สำหรับสินค้าในช่วง VAT 13% 8% สำหรับช่วง 9% หลังหักค่าธรรมเนียม ~2% ของหน่วยงาน คุณเก็บประมาณ <strong>9%</strong> หรือ <strong>6%</strong></td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">ใครมีสิทธิ์</td>
            <td class="px-6 py-4">ผู้ไม่มีถิ่นที่อยู่ที่อยู่ในจีนแผ่นดินใหญ่ 183 วันหรือน้อยกว่า: ผู้ถือพาสปอร์ตต่างชาติ รวมถึงผู้พักอาศัยฮ่องกง มาเก๊า และไต้หวัน</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">เอกสารประจำตัว</td>
            <td class="px-6 py-4"><strong>พาสปอร์ตของคุณ</strong> — เล่มเดียวที่คุณใช้เข้า ใบคืนภาษีเขียนขึ้นด้วยประเภทและเลขที่ และถูกตรวจที่ทุกเคาน์เตอร์</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">กำหนดเวลา</td>
            <td class="px-6 py-4">ออกจีนภายใน <strong>90 วัน</strong> นับจากวันซื้อ ถ้าคุณรับเงินล่วงหน้าด้วยคืนภาษีทันทีตอนซื้อ (即买即退) คุณมี 28 วัน</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">วงเงินเงินสด</td>
            <td class="px-6 py-4">เงินสดสูงสุด ¥20,000 ต่อการเคลมที่สนามบิน ส่วนที่เกินกว่านั้น โอนผ่านธนาคาร</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">เอกสารตั้งแต่กรกฎาคม 2026</td>
            <td class="px-6 py-4">ดิจิทัลเต็มรูปแบบ ศุลกากรและหน่วยงานคืนภาษีดึงใบสมัครและใบกำกับของคุณจากระบบ — แต่เก็บกระดาษไว้ดีกว่า เพราะเคาน์เตอร์ยังขออยู่</td>
          </tr>
          <tr class="border-b border-gray-100 bg-gray-50">
            <td class="px-6 py-4 font-semibold">การตรวจแบบสุ่มตั้งแต่กรกฎาคม 2026</td>
            <td class="px-6 py-4">การเคลมที่มียอดขายต่ำกว่า ¥10,000 ถูกสุ่มสำหรับการตรวจสินค้าตัวจริง ถ้าอันของคุณไม่ถูกสุ่ม คุณข้ามการตรวจสินค้าที่สนามบินไปเลย</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="px-6 py-4 font-semibold">คืนภาษีทันทีตอนซื้อ</td>
            <td class="px-6 py-4">"即买即退" — รับที่ร้านหรือจุดคืนภาษีระดับเมืองโดยใช้การอนุมัติบัตรเครดิต การเคลมข้ามเมือง (ซื้อเมืองหนึ่ง บินออกอีกเมือง) ใช้ได้ทั่วประเทศตั้งแต่ 1 กันยายน 2026</td>
          </tr>
        </tbody>
      </table>
    </div>

    <img
      src="/images/tax-refund/refund-application-form.webp"
      alt="ใบสมัครคืนภาษีสำหรับนักท่องเที่ยวต่างชาติ แสดงช่องประเภทและเลขที่พาสปอร์ต เลขที่ใบกำกับ สินค้า อัตราคืนภาษี 11% และช่องการตรวจสอบศุลกากร"
      width="1080"
      height="607"
      loading="lazy"
      class="w-full rounded-2xl mb-4 not-prose"
    />
    <p class="text-sm text-gray-500 mb-8">ใบสมัครคืนภาษีคือที่ที่เลขที่พาสปอร์ตของคุณไป ทุกอย่างหลังจุดนี้ — ศุลกากร หน่วยงาน ธนาคาร — อ้างอิงเลขที่นั้น</p>

    <hr class="border-gray-200 my-12" />

    <h2 id="how-much" class="text-3xl font-bold text-gray-900 mb-6 mt-14">เงินของคุณกลับคืนจริงๆ เท่าไหร่?</h2>

    <img
      src="/images/tax-refund/vat-invoice.webp"
      alt="ใบกำกับภาษีมูลค่าเพิ่มแบบทั่วไปจีนแสดงบรรทัดรายการ คอลัมน์อัตราภาษี 13% และจำนวนรวมพร้อมภาษีด้านล่าง"
      width="1000"
      height="635"
      loading="lazy"
      class="w-full mb-6 md:float-left md:mr-6 md:mb-4 md:w-2/5 h-72 object-cover rounded-2xl"
    />

    <p class="text-lg leading-relaxed text-gray-700 mb-6">11% และ 8% ในกฎคืออัตราตามข้อกฎหมาย <em>nominal</em> ที่กำหนดโดยนโยบาย ไม่ใช่สิ่งที่เข้าบัญชีคุณ หน่วยงานคืนภาษีหักค่าธรรมเนียมจัดการประมาณ 2% ของจำนวนใบกำกับจากยอดบน ซึ่งเป็นเหตุว่าทำไมทุกคู่มือจึงบอก "ประมาณ 9%"</p>
    <p class="text-lg leading-relaxed text-gray-700 mb-6">คำนวณในบรรทัดเดียว โน้ตบุ๊ก ¥10,000 ที่ซื้อที่ร้าน tax-free อยู่ในช่วง VAT 13%: ภาษีคืนตามชื่อ 11% คือ ¥1,100 หักค่าธรรมเนียมหน่วยงานประมาณ ¥200 — คุณได้ประมาณ <strong>¥900</strong> กลับ สินค้า ¥1,000 คืนประมาณ ¥90 ต่ำกว่าเกณฑ์ ¥200 ต่อร้านต่อวัน คำตอบคือ ¥0</p>
    <p class="text-lg leading-relaxed text-gray-700 mb-6">สินค้าอัตราลดทำงานต่างกัน ชาเช่น เป็นตัวอย่าง อยู่ในช่วง VAT 9%: อัตราตามชื่อคือ 8% และคุณเก็บประมาณ 6% ถ้าของที่คุณซื้อหนักไปทางชาและเบาไปทางอิเล็กทรอนิกส์ วางงบคืนภาษีที่ 6% ไม่ใช่ 9%</p>
    <p class="text-lg leading-relaxed text-gray-700 mb-6">ขีดจำกัดเชิงโครงสร้างหนึ่งที่ควรรู้ก่อนวางแผนทริปช้อปปิ้งรอบนี้: การคืนภาษีคืน VAT และ VAT ไม่เคยเป็นเหตุผลหลักที่สินค้าหรูนำเข้าราคาแพงในจีน ถ้ากระเป๋าแพงกว่าที่นี่กว่าปารีส 9% กลับแทบไม่ปิดช่องว่าง ที่การคืนภาษีเปลี่ยนคณิตศาสตร์จริงๆ คือสินค้าทำในจีนและสิ่งที่คุณจะซื้ออยู่แล้ว — ดู <a href="/th/payment/china-shopping/" class="text-brand-600 hover:underline">คู่มือช้อปปิ้ง</a> สำหรับหมวดไหนที่เป็นเช่นนั้น</p>

    <p class="text-lg leading-relaxed text-gray-700 mb-6 clear-both"><strong>ใบกำกับคือส่วนที่คนทำผิด</strong> คุณต้องการ<em>ใบกำกับภาษีมูลค่าเพิ่มแบบทั่วไป</em> (增值税普通发票) ที่ออกด้วยรายละเอียดของคุณ ไม่ใช่ใบเสร็จแคชเชียร์ ไม่ใช่โน้ตเขียนมือ และไม่ใช่รูปถ่ายใบหนึ่ง แผงเล็กๆ มักออกให้ไม่ได้เลย ซึ่งเป็นเหตุผลที่แท้จริงที่ของราคาถูกในตลาดไม่เคยเข้าเงื่อนไขคืนภาษี</p>

