---
import Layout from '@layouts/Layout.astro';
const title = 'วัฒนธรรมการให้ทิปในจีน: จำเป็นต้องให้ทิปไหม?';
const description = 'ไม่ต้องให้ทิป ไม่ใช่ธรรมเนียมในจีน คู่มือฉบับย่อสำหรับนักท่องเที่ยวต่างชาติว่าควรทำอะไร (และไม่ควรทำอะไร) เกี่ยวกับการให้ทิป';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/payment/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าการชำระเงิน
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">💳 การชำระเงิน</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        วัฒนธรรมการให้ทิปในจีน: จำเป็นต้องให้ทิปไหม?
      </h1>
      <p class="text-xl text-gray-600 mb-6">คำตอบสั้นๆ: ไม่ อย่าให้ทิป ไม่มีใครคาดหวัง</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 3 นาที</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-purple-50 to-pink-50 border-l-4 border-purple-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-purple-900 mb-4">🎯 คำตอบสั้นๆ</h2>
      <p class="text-lg text-purple-800 leading-relaxed">
        <strong>ไม่ อย่าให้ทิป</strong> การให้ทิปไม่ใช่ส่วนหนึ่งของวัฒนธรรมจีน ค่าบริการรวมอยู่ในราคาแล้ว การให้ทิปอาจสร้างความ awkward — พนักงานอาจวิ่งตามคืนเงินให้คุณ
      </p>
    </div>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">
      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        คำตอบสั้นๆ: <strong>ไม่ อย่าให้ทิป ไม่มีใครคาดหวัง และมันอาจสร้างความ awkward ได้</strong>
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        นี่เป็นหนึ่งในเรื่องที่รู้สึกผิดถ้าคุณมาจากสหรัฐอเมริกาหรือแคนาดา ที่การให้ทิปแทบจะเป็นเงินเดือนที่สอง แต่ในจีน วัฒนธรรมแตกต่างกันโดยสิ้นเชิง
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🤷</span> ความเป็นจริง
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        การให้ทิปไม่ใช่ส่วนหนึ่งของวัฒนธรรมการบริการของจีน เมื่อคุณพยายามให้ทิป ปฏิกิริยามักจะเป็นการสับสนหรือปฏิเสธ ฉันเคยเห็นพนักงานเสิร์ฟวิ่งตามลูกค้าออกร้านเพื่อคืนทิปที่ลูกค้าวางไว้บนโต๊ะ
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        เหตุผลนั้นง่าย: ค่าบริการรวมอยู่ในราคาแล้ว ไม่มีความคาดหวังว่าคุณจะต้องเพิ่มอะไรอีก
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🤔</span> มีใครให้ทิปในจีนไหม?
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">มีกรณีพิเศษบางกรณี:</p>

      <ul class="list-disc pl-6 space-y-3 text-gray-700 mb-6">
        <li><strong>โรงแรมระดับสูงและร้านอาหารชั้นเลิศ:</strong> สถานประกอบการระดับไฮเอนด์บางแห่งคุ้นเคยกับแขกต่างชาติที่ให้ทิป แต่ก็ไม่ได้คาดหวัง</li>
        <li><strong>ไกด์นำเที่ยว:</strong> ทิปเล็กน้อยเมื่อจบทัวร์เป็นที่ชื่นชม แต่ไม่จำเป็นอย่างยิ่ง</li>
        <li><strong>พนักงานยกกระเป๋าโรงแรม:</strong> ¥10–20 สำหรับการช่วยยกกระเป๋าก็ดี แต่ไม่บังคับ</li>
      </ul>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        แม้ในกรณีเหล่านั้น มันก็เป็นท่าทางที่ "นักท่องเที่ยวดูดี" มากกว่าสถานการณ์ที่ "ฉันต้องการเงินนี้เพื่อเลี้ยงชีพ"
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🚫</span> สิ่งที่ไม่ควรทำ
      </h2>

      <div class="bg-red-50 border border-red-200 rounded-2xl p-6 mb-8 not-prose">
        <ul class="space-y-3 text-gray-700">
          <li>🚫 อย่าให้ทิป 15–20% อย่างที่ทำที่บ้าน มันมากเกินไป</li>
          <li>🚫 อย่าให้ทิปคนขับแท็กซี่ พวกเขาจะสับสน</li>
          <li>🚫 อย่าให้ทิปที่ร้านอาหารทั่วไป คาเฟ่ หรือบาร์</li>
          <li>🚫 อย่ายืนกรานเมื่อมีคนปฏิเสธ พวกเขาไม่ต้องการจริงๆ</li>
        </ul>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">💡</span> สิ่งที่ควรทำแทนการให้ทิป
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        ถ้าคุณต้องการแสดงความชื่นชมสำหรับบริการที่ดี การพูด "ขอบคุณ" (<em>谢谢 — xièxie</em>) อย่างอบอุ่นก็เพียงพอแล้ว หรือเขียนรีวิวดีๆ บน Dianping (Yelp ของจีน) ถ้าคุณมีแอป
      </p>

      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-8 not-prose">
        <p class="text-yellow-900">เงินที่คุณประหยัดได้จากการไม่ให้ทิป? ใช้มันกับมื้ออาหารดีๆ อีกมื้อสิ คุณจะมีอาหารอร่อยๆ ให้ลองอีกมากมาย</p>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose mt-12">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/th/payment/payment-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">วิธีจ่ายเงินในจีน</p>
          <p class="text-sm text-gray-600">ภาพรวมการชำระเงินทั้งหมด</p>
        </a>
        <a href="/th/payment/payment-fails/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">เมื่อการชำระเงินล้มเหลว</p>
          <p class="text-sm text-gray-600">คู่มือแก้ปัญหา</p>
        </a>
      </div>
    </div>

    <!-- Sources -->
    <div class="mt-8 pt-6 border-t border-gray-200 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-3">แหล่งอ้างอิง</h3>
      <ul class="space-y-2">
        <li><a href="https://www.travelchinaguide.com/essential/tipping.htm" target="_blank" rel="noopener" class="text-blue-600 underline text-sm">การให้ทิปไม่ใช่ธรรมเนียมในจีน รวบรวมจากแหล่งข้อมูลมารยาทการเดินทางทั่วไป</a></li>
      </ul>
    </div>
  </article>
</Layout>