---
import Layout from '@layouts/Layout.astro';
const title = 'จากสนามบินเข้าเมืองในจีน: วิธีไหนดีที่สุด?';
const description = 'รถไฟฟ้า DiDi แท็กซี่ หรือรถบัสสนามบิน — วิธีเลือกและสิ่งที่คาดหวังที่สนามบินหลักของจีน';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/transport/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าการเดินทาง
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🛬 การเดินทาง</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        จากสนามบินเข้าเมืองในจีน: วิธีไหนดีที่สุด?
      </h1>
      <p class="text-xl text-gray-600 mb-6">รถไฟฟ้า DiDi แท็กซี่ หรือรถบัสสนามบิน — วิธีเลือกและสิ่งที่คาดหวังที่สนามบินหลักของจีน</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 5 นาที</span>
      </div>
    </header>

    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 คำตอบสั้นๆ</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        <strong>นั่งรถไฟฟ้าใต้ดิน</strong> ถ้าเที่ยวบินของคุณถึงตอนกลางวันและมีกระเป๋าเบา — ราคาถูก (¥5–10) และหลีกเลี่ยงรถติด <strong>ใช้ DiDi</strong> ถ้าคุณเหนื่อย มีกระเป๋าหนัก หรือถึงดึก (¥80–200) หลีกเลี่ยงแท็กซี่ไม่มีใบอนุญาต ใช้คิวแท็กซี่ทางการเท่านั้น
      </p>
    </div>

    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#metro" class="text-blue-600 hover:underline">🚇 ทางเลือกที่ 1: รถไฟฟ้า (ดีที่สุดสำหรับนักเดินทางส่วนใหญ่)</a></li>
        <li><a href="#didi" class="text-blue-600 hover:underline">🚗 ทางเลือกที่ 2: DiDi (ดีที่สุดสำหรับถึงที่หมาย)</a></li>
        <li><a href="#taxi" class="text-blue-600 hover:underline">🚕 ทางเลือกที่ 3: แท็กซี่</a></li>
        <li><a href="#bus" class="text-blue-600 hover:underline">🚌 ทางเลือกที่ 4: รถบัสสนามบิน</a></li>
        <li><a href="#reference" class="text-blue-600 hover:underline">📊 ตารางเทียบด่วนตามสนามบิน</a></li>
      </ul>
    </nav>

    <div class="prose prose-gray max-w-none">

      <h2 id="metro" class="text-2xl font-bold text-gray-900 mb-4">🚇 ทางเลือกที่ 1: รถไฟฟ้า (ดีที่สุดสำหรับนักเดินทางส่วนใหญ่)</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">สนามบินหลักทั่วเมืองสำคัญของจีนมีสายรถไฟฟ้าใต้ดินตรงสู่ใจกลางเมือง ค่าโดยสารเพียง ¥5 ถึง ¥10 บริการหลีกเลี่ยงรถติด และป้ายสถานีทุกแห่งมีภาษาอังกฤษ</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>เหมาะถ้า:</strong> คุณมีกระเป๋าเบา ถึงในช่วงเวลาให้บริการ (ปกติ 6:00–23:00) และโรงแรมของคุณอยู่ใกล้สถานีรถไฟฟ้า</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>ข้ามไปถ้า:</strong> คุณมีกระเป๋าหนัก ถึงดึก หรือคุณเหนื่อยและอยากถึงโรงแรมแบบถึงที่หมาย</p>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">🚗 ทางเลือกที่ 2: DiDi (ดีที่สุดสำหรับถึงที่หมาย)</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">ถ้าคุณตั้งค่า DiDi ไว้แล้ว (ดู <a href="/th/transport/didi/" class="text-blue-600 hover:underline">คู่มือ DiDi</a>) คุณสามารถจองรถจากจุดรับผู้โดยสารสนามบิน แอปแสดงค่าโดยสารประมาณการล่วงหน้า รองรับ Alipay/WeChat Pay และคุณสามารถติดตามคนขับแบบเรียลไทม์</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>ค่าใช้จ่ายทั่วไป:</strong> ¥80–200 ขึ้นอยู่กับระยะทางและเมือง</p>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">🚕 ทางเลือกที่ 3: แท็กซี่</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">แท็กซี่สามารถพบได้ที่จุดจอดแท็กซี่ทางการด้านนอกอาคารผู้โดยสารขาเข้า เตรียมชื่อและที่อยู่โรงแรมที่แปลเป็นภาษาจีนแล้วแสดงให้คนขับดู ตรวจสอบให้แน่ใจว่าใช้มิเตอร์</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>ค่าใช้จ่าย:</strong> แพงกว่า DiDi เล็กน้อย และอาจสูงกว่าถ้ารถติด</p>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">🚌 ทางเลือกที่ 4: รถบัสสนามบิน</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">สนามบินใหญ่ส่วนใหญ่มีเส้นทางรถบัสไปยังพื้นที่สำคัญของเมือง ราคาถูกกว่าแท็กซี่ (¥20–40) แต่ช้ากว่าและสะดวกน้อยกว่า ไม่ทั้งหมดที่มีป้ายภาษาอังกฤษ</p>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">📊 ตารางเทียบด่วนตามสนามบิน</h2>

      <div class="bg-white border border-gray-200 rounded-2xl overflow-x-auto mb-8 not-prose">
        <table class="w-full text-left">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-4 text-sm font-semibold text-gray-900">สนามบิน</th>
              <th class="px-6 py-4 text-sm font-semibold text-gray-900">รถไฟฟ้าเข้าเมือง</th>
              <th class="px-6 py-4 text-sm font-semibold text-gray-900">DiDi เข้าเมือง</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr class="hover:bg-gray-50"><td class="px-6 py-4 text-gray-700">ปักกิ่ง แคปิตอล (PEK)</td><td class="px-6 py-4 text-gray-700">¥30, 60 นาที</td><td class="px-6 py-4 text-gray-700">¥120, 45 นาที</td></tr>
            <tr class="hover:bg-gray-50"><td class="px-6 py-4 text-gray-700">ปักกิ่ง ต้าซิง (PKX)</td><td class="px-6 py-4 text-gray-700">¥35, 50 นาที</td><td class="px-6 py-4 text-gray-700">¥180, 60 นาที</td></tr>
            <tr class="hover:bg-gray-50"><td class="px-6 py-4 text-gray-700">เซี่ยงไฮ้ ผู่ตง (PVG)</td><td class="px-6 py-4 text-gray-700">¥8, 50 นาที</td><td class="px-6 py-4 text-gray-700">¥180, 50 นาที</td></tr>
            <tr class="hover:bg-gray-50"><td class="px-6 py-4 text-gray-700">กวางโจว ไป๋หยุน (CAN)</td><td class="px-6 py-4 text-gray-700">¥8, 40 นาที</td><td class="px-6 py-4 text-gray-700">¥100, 40 นาที</td></tr>
            <tr class="hover:bg-gray-50"><td class="px-6 py-4 text-gray-700">เซินเจิ้น เป๋าอาน (SZX)</td><td class="px-6 py-4 text-gray-700">¥8, 40 นาที</td><td class="px-6 py-4 text-gray-700">¥80, 35 นาที</td></tr>
          </tbody>
        </table>
      </div>

      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 not-prose">
        <p class="text-gray-700"><strong>คำแนะนำของฉัน:</strong> นั่งรถไฟฟ้าถ้าเที่ยวบินของคุณถึงตอนกลางวันและคุณมีกระเป๋าไม่มาก ใช้ DiDi ถ้าคุณเหนื่อย มีกระเป๋าเยอะ หรือถึงดึก อย่านั่งแท็กซี่ไม่มีใบอนุญาต — ใช้คิวแท็กซี่ทางการเท่านั้น</p>
      </div>

      <hr class="my-10 border-gray-200" />

      <h2 id="related" class="text-2xl font-bold text-gray-900 mb-6 mt-12">📚 คู่มือที่เกี่ยวข้อง</h2>

      <div class="space-y-4 not-prose">
        <a href="/th/transport/transport-guide/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🚄 <strong>วิธีเดินทางในจีน</strong> — คู่มือการเดินทางฉบับสมบูรณ์</a>
        <a href="/th/transport/high-speed-rail/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🚄 <strong>วิธีจองและนั่งรถไฟความเร็วสูงในจีน</strong> — เคล็ดลับการจองและการนั่ง</a>
        <a href="/th/transport/didi/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🚗 <strong>วิธีใช้ DiDi ในจีนสำหรับชาวต่างชาติ</strong> — ตั้งค่าเรียกรถ</a>
        <a href="/th/payment/setup-alipay/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">💳 <strong>วิธีตั้งค่า Alipay สำหรับชาวต่างชาติ</strong> — จ่ายค่าโดยสารของคุณ</a>
      </div>

    </div>

    <!-- Sources -->
    <div class="mt-8 pt-6 border-t border-gray-200 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-3">แหล่งอ้างอิง</h3>
      <ul class="space-y-2">
        <li><a href="https://en.bcia.com.cn/wljc.html" target="_blank" rel="noopener" class="text-blue-600 underline text-sm">สนามบินปักกิ่ง แคปิตอล - คู่มือการเดินทาง</a></li>
        <li><a href="https://www.shanghaiairport.com/ensh/gdjt/index.html" target="_blank" rel="noopener" class="text-blue-600 underline text-sm">สนามบินเซี่ยงไฮ้ - การเดินทาง</a></li>
        <li><a href="https://www.gbiac.net/traffic/tfa?urlKey=to-from-airport_en" target="_blank" rel="noopener" class="text-blue-600 underline text-sm">สนามบินกวางโจว ไป๋หยุน - การจราจรสนามบิน</a></li>
      </ul>
    </div>
  </article>
</Layout>