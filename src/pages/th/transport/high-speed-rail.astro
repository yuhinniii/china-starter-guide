---
import Layout from '@layouts/Layout.astro';
const title = 'วิธีจองและนั่งรถไฟความเร็วสูงในจีน: คู่มือทีละขั้นตอน';
const description = 'คู่มือการจองตั๋ว การเดินทางในสถานี และการนั่งรถไฟความเร็วสูงในจีนแบบทีละขั้นตอน';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/transport/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าการเดินทาง
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🚄 รถไฟ</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        วิธีจองและนั่งรถไฟความเร็วสูงในจีน
      </h1>
      <p class="text-xl text-gray-600 mb-6">คู่มือการจองตั๋ว การเดินทางในสถานี และการนั่งรถไฟความเร็วสูงในจีนแบบทีละขั้นตอน</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 6 นาที</span>
      </div>
    </header>

    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 คำตอบสั้นๆ</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        จองตั๋วบน <strong>Trip.com</strong> (ง่ายที่สุดสำหรับชาวต่างชาติ) หรือ <strong>12306</strong> (ทางการ) ชั้นสองสบายพอใช้ได้ ถึงสถานีก่อนออกเดินทาง 30–40 นาที — <strong>พาสปอร์ตคือตั๋วของคุณ</strong> ดังนั้นเก็บไว้ให้พร้อม การขึ้นรถไฟราบรื่น: ตรวจความปลอดภัย → ห้องรอ → ประตูขึ้นรถ → ชานชาลา สถานีมีป้ายภาษาอังกฤษตลอด
      </p>
    </div>

    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#booking" class="text-blue-600 hover:underline">🎫 การจองตั๋ว</a></li>
        <li><a href="#classes" class="text-blue-600 hover:underline">💺 ประเภทที่นั่ง</a></li>
        <li><a href="#station" class="text-blue-600 hover:underline">🚉 ที่สถานี</a></li>
        <li><a href="#onboard" class="text-blue-600 hover:underline">🚄 เคล็ดลับบนรถไฟ</a></li>
      </ul>
    </nav>

    <div class="prose prose-gray max-w-none">

      <h2 id="booking" class="text-2xl font-bold text-gray-900 mb-4">🎫 การจองตั๋ว</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">คุณมีสามตัวเลือก:</p>

      <ul class="space-y-2 text-gray-700 mb-8">
        <li><strong>Trip.com (แนะนำ):</strong> ดึงข้อมูลตั๋วจาก 12306 โดยตรง ไม่ต้องมีบัญชี 12306 แยกต่างหาก หลังจากจอง คุณสามารถขึ้นรถไฟด้วยพาสปอร์ตเพียงอย่างเดียว</li>
        <li><strong>12306 (ทางการ):</strong> ช่องทางการขายอย่างเป็นทางการที่มีการปกป้องข้อมูลส่วนตัวที่ดีกว่า ชาวต่างชาติสามารถลงทะเบียนด้วยหมายเลขพาสปอร์ต</li>
        <li><strong>เคาน์เตอร์ขายตั๋วที่สถานี:</strong> คุณสามารถซื้อตั๋วด้วยตนเองได้ แต่ไม่รับประกันว่ามีภาษาอังกฤษ</li>
      </ul>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">สำหรับนักเดินทางส่วนใหญ่ Trip.com เป็นตัวเลือกที่ง่ายที่สุด ค่าธรรมเนียมการจองเล็กน้อยก็คุ้มค่ากับความสะดวกสบาย</p>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">💺 ประเภทที่นั่ง</h2>

      <ul class="space-y-2 text-gray-700 mb-8">
        <li><strong>ชั้นสอง (二等座):</strong> ตัวเลือกมาตรฐาน ที่นั่งสบาย จัดแบบ 3+2 นี่คือสิ่งที่คนส่วนใหญ่เลือก</li>
        <li><strong>ชั้นหนึ่ง (一等座):</strong> ที่นั่งกว้างขึ้น จัดแบบ 2+2 มีพื้นที่วางขามากกว่า คุ้มค่าที่จะอัปเกรดสำหรับการเดินทางเกิน 3 ชั่วโมง</li>
        <li><strong>ชั้นธุรกิจ (商务座):</strong> ที่นั่งเอนได้เต็มที่ ความเป็นส่วนตัว มีอาหารฟรีในเส้นทางไกล แพงแต่เป็นประสบการณ์</li>
      </ul>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">🚉 ที่สถานี</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">ถึงก่อนออกเดินทาง 30–40 นาที นี่คือขั้นตอน:</p>

      <ol class="list-decimal pl-6 space-y-4 text-gray-700 mb-8">
        <li><strong>ตรวจความปลอดภัย:</strong> กระเป๋าผ่านเครื่องเอ็กซ์เรย์ (เหมือนสนามบิน แต่เร็วกว่า)</li>
        <li><strong>ห้องรอ:</strong> ตรวจสอบจอใหญ่เพื่อหาหมายเลขประตูขึ้นรถของขบวนคุณ เดินตามป้าย</li>
        <li><strong>ขึ้นรถไฟ:</strong> แสดงพาสปอร์ตที่ประตูตั๋ว ใช้ช่องเคาน์เตอร์ manual ด้านไกล แล้วเดินลงไปที่ชานชาลา</li>
        <li><strong>หาตู้โดยสารของคุณ:</strong> ตรวจสอบจอใกล้บันไดชานชาลาเพื่อหารหัสสีที่กำหนดให้กับขบวนรถของคุณ จับคู่สีนี้กับเครื่องหมายสีบนพื้นชานชาลาเพื่อหาตู้โดยสารที่ถูกต้อง</li>
      </ol>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">🚄 เคล็ดลับบนรถไฟ</h2>

      <ul class="space-y-2 text-gray-700 mb-8">
        <li>มีอาหารและเครื่องดื่มขายบนรถเข็น</li>
        <li>ปลั๊กไฟมีใต้ที่นั่งในบางขบวน (เต้ารับจีน — นำอะแดปเตอร์มาด้วย)</li>
        <li>ม่านบังตาดึงลงได้เพื่อความสะดวกสบาย</li>
        <li>ประกาศสถานีและบนรถไฟมีทั้งภาษาจีนและภาษาอังกฤษ</li>
      </ul>

      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 not-prose">
        <p class="text-gray-700"><strong>สำคัญ:</strong> พาสปอร์ตคือตั๋วของคุณ เก็บไว้ให้พร้อมสำหรับการตรวจที่ทางเข้าสถานี ประตูขึ้นรถ และบางครั้งบนรถไฟ อย่าใส่ไว้ในกระเป๋าที่โหลดใต้รถ</p>
      </div>

      <hr class="my-10 border-gray-200" />

      <h2 id="related" class="text-2xl font-bold text-gray-900 mb-6 mt-12">📚 คู่มือที่เกี่ยวข้อง</h2>

      <div class="space-y-4 not-prose">
        <a href="/th/transport/transport-guide/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🚄 <strong>วิธีเดินทางในจีน</strong> — คู่มือการเดินทางฉบับสมบูรณ์</a>
        <a href="/th/transport/airport-to-city/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🛬 <strong>จากสนามบินเข้าเมือง</strong> — สิ่งที่ต้องทำเมื่อคุณลงเครื่อง</a>
        <a href="/th/transport/didi/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🚗 <strong>วิธีใช้ DiDi ในจีนสำหรับชาวต่างชาติ</strong> — ตั้งค่าเรียกรถ</a>
        <a href="/th/transport/metro-bus/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🚇 <strong>คู่มือรถไฟฟ้าและรถบัสในเมืองใหญ่ของจีน</strong> — การเดินทางด้วยระบบขนส่งในเมือง</a>
      </div>

    </div>

    <!-- Sources -->
    <div class="mt-8 pt-6 border-t border-gray-200 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-3">แหล่งอ้างอิง</h3>
      <ul class="space-y-2">
        <li><a href="https://www.12306.cn/en/index.html" target="_blank" rel="noopener" class="text-blue-600 underline text-sm">China Railway Official - 12306 EN</a></li>
      </ul>
    </div>
  </article>
</Layout>