---
import Layout from '@layouts/Layout.astro';
const title = 'คู่มือการเดินทาง — เที่ยวจีนอย่างไร';
const description = 'รถไฟ เครื่องบิน รถไฟฟ้าใต้ดิน และเรียกรถ — ทุกสิ่งที่คุณต้องรู้';
---

<Layout title={title} description={description} lang="th">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🚄 การเดินทาง</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">การเดินทางในจีน</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">รถไฟ เครื่องบิน รถไฟฟ้าใต้ดิน และเรียกรถ — ทุกสิ่งที่คุณต้องรู้</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-sky-50 border border-sky-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-sky-800">1</p>
        <p class="text-xs font-semibold text-sky-800 uppercase tracking-wide mt-1">คู่มือรถไฟความเร็วสูง</p>
      </div>
      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-emerald-800">1</p>
        <p class="text-xs font-semibold text-emerald-800 uppercase tracking-wide mt-1">การเดินทางจากสนามบิน</p>
      </div>
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">2</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">การเดินทางในเมือง</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-gray-800">1</p>
        <p class="text-xs font-semibold text-gray-800 uppercase tracking-wide mt-1">คู่มือเรียกรถ</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-sky-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-sky-800">การเดินทางทั่วจีน</h2>
          <span class="text-xs font-medium text-sky-800 opacity-60">1 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/transport/transport-guide/" class="block bg-sky-50 border border-sky-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-sky-800">📖 ภาพรวม</span>
            <p class="text-base font-bold text-gray-900 mt-1">วิธีเดินทางในจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">ภาพรวมตัวเลือกการเดินทางทั้งหมด — รถไฟ เครื่องบิน รถไฟฟ้าใต้ดิน และอื่นๆ</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">การมาถึงจีน</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/transport/airport-to-city/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🛬 คู่มือ</span>
            <p class="text-base font-bold text-gray-900 mt-1">จากสนามบินเข้าเมือง</p>
            <p class="text-sm text-gray-600 mt-0.5">ตัวเลือกการเดินทางที่สนามบินหลัก — ปักกิ่ง เซี่ยงไฮ้ กวางโจว และอื่นๆ</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">การเดินทางในเมือง</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">2 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/transport/high-speed-rail/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚄 คู่มือ</span>
            <p class="text-base font-bold text-gray-900 mt-1">วิธีจองและนั่งรถไฟความเร็วสูงในจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">ทุกเรื่องเกี่ยวกับการจองและนั่งรถไฟเครือข่าย HSR ที่ใหญ่ที่สุดในโลก</p>
          </a>
          <a href="/th/transport/metro-bus/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚇 คู่มือ</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือรถไฟฟ้าและรถบัสในเมืองหลัก</p>
            <p class="text-sm text-gray-600 mt-0.5">เดินทางด้วยระบบขนส่งสาธารณะในปักกิ่ง เซี่ยงไฮ้ กวางโจว และเซินเจิ้น</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">เรียกรถ</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/transport/didi/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">🚕 บทช่วยสอน</span>
            <p class="text-base font-bold text-gray-900 mt-1">วิธีใช้ DiDi ในจีนสำหรับชาวต่างชาติ</p>
            <p class="text-sm text-gray-600 mt-0.5">คู่มือการใช้ DiDi, Uber ของจีน — พร้อมภาพประกอบ</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/th/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">การชำระเงินในจีน</p>
          <p class="text-sm text-gray-500">วิธีชำระค่าเดินทาง</p>
        </a>
        <a href="/th/visa/visa-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">วีซ่าและการเข้าประเทศ</p>
          <p class="text-sm text-gray-500">การเดินทางเข้าจีน</p>
        </a>
      </div>
    </div>
  </section>
</Layout>