---
import Layout from '@layouts/Layout.astro';
const title = 'คู่มือรถไฟฟ้าและรถบัสในเมืองใหญ่ของจีน';
const description = 'วิธีใช้ระบบขนส่งสาธารณะในเมืองจีน การชำระเงินมือถือ บัตรโดยสาร เคล็ดลับรถบัส และคำแนะนำการเดินทางทั่วไป';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/transport/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าการเดินทาง
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🚇 ขนส่งสาธารณะ</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        คู่มือรถไฟฟ้าและรถบัสในเมืองใหญ่ของจีน
      </h1>
      <p class="text-xl text-gray-600 mb-6">วิธีใช้ระบบขนส่งสาธารณะในเมืองจีน — การชำระเงินมือถือ บัตรโดยสาร เคล็ดลับรถบัส และคำแนะนำการเดินทาง</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 4 นาที</span>
      </div>
    </header>

    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 คำตอบสั้นๆ</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        ระบบรถไฟฟ้าของจีน <strong>ระดับโลก ราคาถูก และมีภาษาอังกฤษ</strong> ใช้ Alipay หรือ WeChat Pay สแกน QR Code ที่ประตูอัตโนมัติ — ไม่ต้องใช้ตั๋ว รถบัสเป็นตัวเลือกสำรองที่ดีสำหรับพื้นที่ที่ไม่มีรถไฟฟ้า ชื่อสถานีและประกาศเป็นสองภาษาตลอด
      </p>
    </div>

    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#general" class="text-blue-600 hover:underline">💡 เคล็ดลับทั่วไปสำหรับทุกเมือง</a></li>
        <li><a href="#buses" class="text-blue-600 hover:underline">🚌 รถบัส</a></li>
        <li><a href="#cards" class="text-blue-600 hover:underline">💳 บัตรโดยสาร</a></li>
        <li><a href="#mobile" class="text-blue-600 hover:underline">📱 การชำระเงินมือถือสำหรับระบบขนส่ง</a></li>
      </ul>
    </nav>

    <div class="prose prose-gray max-w-none">

      <h2 id="general" class="text-2xl font-bold text-gray-900 mb-4">💡 เคล็ดลับทั่วไปสำหรับทุกเมือง</h2>

      <ul class="space-y-3 text-gray-700 mb-8">
        <li><strong>การชำระเงิน:</strong> คุณสามารถซื้อตั๋วเที่ยวเดียวที่เครื่องจำหน่ายตั๋ว (ส่วนใหญ่รับเงินสดและ Alipay/WeChat Pay) หรือสแกน QR Code ที่ประตูผ่านทางส่วนการเดินทางของ Alipay หรือมินิโปรแกรมขนส่งของ WeChat</li>
        <li><strong>ป้าย:</strong> ชื่อสถานีเป็นภาษาจีนและอังกฤษ ประกาศเป็นสองภาษา</li>
        <li><strong>การเปลี่ยนสาย:</strong> เดินตามเส้นสีและป้ายอังกฤษ การเปลี่ยนสายระหว่างเส้นมีป้ายชัดเจน</li>
        <li><strong>แอปนำทาง:</strong> ใช้แอปท้องถิ่นอย่าง Gaode Maps หรือ Baidu Maps สำหรับคำแนะนำเส้นทางรถไฟฟ้าที่แม่นยำ</li>
      </ul>

      <hr class="my-10 border-gray-200" />

      <h2 id="buses" class="text-2xl font-bold text-gray-900 mb-4">🚌 รถบัส</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">รถบัสเป็นตัวเลือกสำรองที่ดีถ้ารถไฟฟ้าไม่ตรงไปยังที่หมายของคุณ เพราะครอบคลุมพื้นที่ที่ห่างไกลกว่า ราคาถูกกว่ารถไฟฟ้าแต่ช้ากว่าและมักติดในช่วงชั่วโมงเร่งด่วน</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">ในเมืองท่องเที่ยว รถบัสส่วนใหญ่ประกาศป้ายเป็นภาษาจีนและอังกฤษ ถึงอย่างนั้นก็ควรตั้งใจฟังการแจ้งเตือนป้ายจอด รถบัสหลายสายต้องสแกน QR Code การเดินทางทั้งตอนขึ้นและลง ดังนั้นอย่าลืมสแกนอีกครั้งก่อนลง</p>

      <hr class="my-10 border-gray-200" />

      <h2 id="cards" class="text-2xl font-bold text-gray-900 mb-4">💳 บัตรโดยสาร</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">แต่ละเมืองมีบัตรโดยสารของตัวเอง (ปักกิ่ง: Yikatong, เซินเจิ้น: Shenzhentong) ซื้อได้ที่สถานีรถไฟฟ้าและเติมเงินด้วยการชำระเงินมือถือ ใช้ได้ทั้งรถไฟฟ้าและรถบัส และมีส่วนลดเล็กน้อย แต่ไม่จำเป็นสำหรับนักท่องเที่ยวระยะสั้น หลายใบมีดีไซน์ไม่เหมือนใคร คุณอาจซื้อเก็บไว้เป็นที่ระลึก</p>

      <hr class="my-10 border-gray-200" />

      <h2 id="mobile" class="text-2xl font-bold text-gray-900 mb-4">📱 การชำระเงินมือถือสำหรับระบบขนส่ง</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">นี่คือวิธีที่คนท้องถิ่นใช้มากที่สุด — ไม่ต้องซื้อตั๋วหรือพกบัตรแยกต่างหาก</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">ทั้ง Alipay และ WeChat Pay สามารถสร้าง QR Code การเดินทางสำหรับรถไฟฟ้าและรถบัส เปิด Alipay แตะ "การเดินทาง" บนหน้าจอหลัก เลือกเมืองของคุณ แล้วสแกนที่ประตูอัตโนมัติ การชำระเงินจะถูกหักจากบัตรที่เชื่อมต่อไว้ WeChat ก็ทำงานคล้ายกันผ่านมินิโปรแกรม "Ride Code"</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>เคล็ดลับ:</strong> มี QR Code แยกสำหรับรถบัสและรถไฟฟ้า ดังนั้นตรวจสอบให้แน่ใจว่าคุณเลือกอันที่ถูกต้องก่อนขึ้น</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8 not-prose">
        <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
          <img src="/images/alipay-transit.jpg" alt="การตั้งค่า QR Code การเดินทางของ Alipay" class="w-full" />
          <div class="p-4">
            <p class="text-sm font-semibold text-gray-900">QR Code การเดินทาง Alipay</p>
            <p class="text-xs text-gray-500">เปิด Alipay → การเดินทาง → เลือกเมือง → สแกนที่ประตู</p>
          </div>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
          <img src="/images/wechat-transit.jpg" alt="การตั้งค่า QR Code การเดินทางของ WeChat" class="w-full" />
          <div class="p-4">
            <p class="text-sm font-semibold text-gray-900">QR Code การเดินทาง WeChat</p>
            <p class="text-xs text-gray-500">เปิด WeChat → มินิโปรแกรม Ride Code → สแกนที่ประตู</p>
          </div>
        </div>
      </div>

    </div>

    <div class="not-prose mt-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-8">📚 คู่มือที่เกี่ยวข้อง</h2>
      <div class="space-y-4">
        <a href="/th/transport/transport-guide/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🚄 <strong>วิธีเดินทางในจีน</strong> — คู่มือการเดินทางฉบับสมบูรณ์</a>
        <a href="/th/transport/didi/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🚗 <strong>วิธีใช้ DiDi ในจีนสำหรับชาวต่างชาติ</strong> — ตั้งค่าเรียกรถ</a>
        <a href="/th/payment/setup-alipay/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">💳 <strong>วิธีตั้งค่า Alipay สำหรับชาวต่างชาติ</strong> — จ่ายค่าเดินทางด้วยมือถือ</a>
      </div>
    </div>

    <div class="not-prose mt-12 pt-8 border-t border-gray-200">
  <h3 class="text-base font-bold text-gray-900 mb-4 flex items-center gap-2">📚 แหล่งอ้างอิง</h3>
  <ul class="space-y-2">
    <li>
      <a href="https://www.travelchinaguide.com/cityguides/" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
        <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        เว็บไซต์รถไฟฟ้าส่วนใหญ่เป็นภาษาจีน แผนที่และข้อมูลเส้นทางรถไฟฟ้าทั่วไปมีให้บนเว็บไซต์ทางการของแต่ละเมืองพร้อมการแปลด้วยเบราว์เซอร์
        <svg class="w-3 h-3 text-gray-300 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </li>
  </ul>
</div>
  </article>
</Layout>