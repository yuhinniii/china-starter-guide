---
import Layout from '@layouts/Layout.astro';
const title = 'วิธีเดินทางในจีน: คู่มือการเดินทางฉบับสมบูรณ์';
const description = 'รถไฟความเร็วสูง รถไฟฟ้าใต้ดิน DiDi แท็กซี่ และจักรยานแชร์ — วิธีการเลือกการเดินทางที่เหมาะสมสำหรับทุกสถานการณ์ในจีน';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/transport/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าการเดินทาง
      </a>
    </nav>
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🚄 การเดินทาง</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        วิธีเดินทางในจีน: คู่มือการเดินทางฉบับสมบูรณ์
      </h1>
      <p class="text-xl text-gray-600 mb-6">รถไฟความเร็วสูง รถไฟฟ้าใต้ดิน DiDi แท็กซี่ และจักรยานแชร์ — วิธีการเลือกการเดินทางที่เหมาะสมสำหรับทุกสถานการณ์</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 5 นาที</span>
      </div>
    </header>

    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 คำตอบสั้นๆ</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        ระบบขนส่งของจีนเป็นหนึ่งในระบบที่มีประสิทธิภาพมากที่สุดในโลก <strong>รถไฟความเร็วสูง</strong> เป็นตัวเลือกที่ดีที่สุดระหว่างเมือง <strong>รถไฟฟ้าใต้ดิน</strong> เร็วที่สุดในเมือง <strong>DiDi</strong> สะดวกที่สุดสำหรับการเดินทางแบบถึงที่หมาย ทุกอย่างจ่ายด้วย Alipay หรือ WeChat Pay ได้ — ไม่ต้องใช้เงินสด
      </p>
    </div>

    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#high-speed-rail" class="text-blue-600 hover:underline">🚄 รถไฟความเร็วสูง</a></li>
        <li><a href="#metro" class="text-blue-600 hover:underline">🚇 รถไฟฟ้าใต้ดิน</a></li>
        <li><a href="#didi" class="text-blue-600 hover:underline">🚗 DiDi</a></li>
        <li><a href="#taxis" class="text-blue-600 hover:underline">🚕 แท็กซี่</a></li>
        <li><a href="#flights" class="text-blue-600 hover:underline">✈️ เที่ยวบินในประเทศ</a></li>
        <li><a href="#bikes" class="text-blue-600 hover:underline">🚲 จักรยานแชร์</a></li>
        <li><a href="#payment" class="text-blue-600 hover:underline">💳 การชำระเงินค่าเดินทาง</a></li>
      </ul>
    </nav>

    <div class="prose prose-gray max-w-none">

      <h2 id="high-speed-rail" class="text-2xl font-bold text-gray-900 mb-4">🚄 รถไฟความเร็วสูง</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">เครือข่ายรถไฟความเร็วสูงของจีนเชื่อมต่อทุกเมืองใหญ่ รถไฟสะอาด ตรงต่อเวลา และเรียบเนียน ที่นั่งชั้นสองสบายพอๆ กับพรีเมียมอีโคโนมีของสายการบิน เลือกรถไฟความเร็วสูงถ้าคุณอยากชมวิวข้างทางและสัมผัสการนั่งรถไฟที่เสถียรและรวดเร็ว</p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6"><strong>เคล็ดลับ:</strong> ค่าโดยสารรถไฟคงที่ตลอดปี ในขณะที่ราคาตั๋วเครื่องบินผันผวนมาก รถไฟถูกกว่าในช่วงฤดูกาลท่องเที่ยว ส่วนตั๋วเครื่องบินราคาถูกกว่าช่วงนอกฤดูกาล</p>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">🚇 รถไฟฟ้าใต้ดิน</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">ทุกเมืองใหญ่ของจีนมีระบบรถไฟฟ้าใต้ดินที่ยอดเยี่ยม ปักกิ่งและเซี่ยงไฮ้มีเครือข่ายรถไฟฟ้าใต้ดินที่ยาวที่สุดในโลก ป้ายและประกาศเป็นสองภาษา (จีน + อังกฤษ) และสถานีมีแผนที่ชัดเจน โดยปกติเป็นวิธีที่เร็วที่สุดในการเดินทางในเมือง และค่าโดยสารก็ถูก — โดยทั่วไป ¥3-10 (ประมาณ 15-50 บาท)</p>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">🚗 DiDi</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">DiDi คือ Uber ของจีน และมีการใช้อย่างแพร่หลาย คุณสามารถจองรถผ่านแอป DiDi หรือผ่านมินิโปรแกรมใน Alipay และ WeChat ใช้งานได้กับบัตรเครดิตต่างประเทศที่เชื่อมต่อกับ Alipay/WeChat Pay นี่คือตัวเลือกที่ดีที่สุดสำหรับการเดินทางแบบถึงที่หมาย โดยเฉพาะที่มีกระเป๋าเยอะหรืออากาศไม่ดี ดู <a href="/th/transport/didi/" class="text-blue-600 hover:underline">คู่มือการติดตั้ง DiDi ฉบับเต็ม</a> สำหรับคำแนะนำทีละขั้นตอน</p>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">🚕 แท็กซี่</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">แท็กซี่มีอยู่ทุกที่ในเมืองจีน มีค่าใช้จ่ายมากกว่าแอปเรียกรถอย่าง DiDi แต่คุณสามารถโบกได้ทันทีบนถนน ความท้าทายคือการสื่อสาร — พนักงานขับรถไม่ทุกคนที่พูดภาษาอังกฤษได้ ควรมีปลายทางเขียนเป็นภาษาจีนและแสดงให้คนขับดู แอปแปลภาษาก็ช่วยได้ แท็กซี่รับเงินสดและชำระเงินมือถือ (Alipay และ WeChat) แต่ไม่รับบัตรเครดิตต่างประเทศ</p>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">✈️ เที่ยวบินในประเทศ</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">สำหรับระยะทางไกลมาก (ปักกิ่งไปกวางโจว เซี่ยงไฮ้ไปเฉิงตู) การบินช่วยประหยัดเวลา สายการบินหลัก ได้แก่ Air China, China Southern, China Eastern และ Hainan Airlines จองผ่าน Trip.com (มีภาษาอังกฤษ) หรือแอปของสายการบิน ข้อควรทราบ: คุณต้องถึงสนามบิน 1.5-2 ชั่วโมงก่อนออกเดินทางสำหรับเที่ยวบินในประเทศ และสนามบินส่วนใหญ่อยู่ไกลจากใจกลางเมือง — คุณจะใช้เวลา 45-60 นาทีในการเดินทางไปสนามบิน</p>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">🚲 จักรยานแชร์</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">สำหรับการเดินทางระยะสั้นมาก จักรยานแชร์ (Meituan Bike, DiDi Bike) มีอยู่ทุกที่ สแกน QR Code ด้วย Alipay หรือ WeChat Pay ขี่ไม่กี่หยวน แล้วจอดที่ไหนก็ได้ เหมาะสำหรับกิโลเมตรสุดท้ายถึงที่หมาย</p>

      <hr class="my-10 border-gray-200" />

      <h2 class="text-2xl font-bold text-gray-900 mb-4">💳 การชำระเงินค่าเดินทาง</h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">ข่าวดี: การเดินทางเกือบทั้งหมดในจีนสามารถชำระด้วย Alipay หรือ WeChat Pay คุณสามารถเปิดใช้งาน QR Code การเดินทางใน Alipay หรือ WeChat Pay สำหรับรถไฟฟ้าใต้ดินและรถบัสได้โดยตรง ค่าโดยสารจะถูกหักอัตโนมัติหลังจากออก DiDi คิดเงินผ่านแอป ตั๋วรถไฟสามารถจองออนไลน์ได้ โดยทั่วไปคุณไม่ต้องใช้เงินสดสำหรับการเดินทาง แต่พกเหรียญเล็กๆ ไว้บ้างเผื่อจำเป็น</p>

      <hr class="my-10 border-gray-200" />

      <h2 id="related" class="text-2xl font-bold text-gray-900 mb-6 mt-12">📚 คู่มือที่เกี่ยวข้อง</h2>

      <div class="space-y-4 not-prose">
        <a href="/th/transport/airport-to-city/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🛬 <strong>จากสนามบินเข้าเมือง</strong> — สิ่งที่ต้องทำเมื่อคุณลงเครื่อง</a>
        <a href="/th/transport/high-speed-rail/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🚄 <strong>วิธีจองและนั่งรถไฟความเร็วสูงในจีน</strong> — คู่มือการจองทีละขั้นตอน</a>
        <a href="/th/transport/didi/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🚗 <strong>วิธีใช้ DiDi ในจีนสำหรับชาวต่างชาติ</strong> — ตั้งค่าเรียกรถโดยไม่ต้องมีเบอร์จีน</a>
        <a href="/th/transport/metro-bus/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">🚇 <strong>คู่มือรถไฟฟ้าและรถบัสในเมืองใหญ่ของจีน</strong> — การเดินทางด้วยระบบขนส่งในเมือง</a>
        <a href="/th/payment/setup-alipay/" class="block bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-lg hover:border-blue-300 transition">💳 <strong>วิธีตั้งค่า Alipay สำหรับชาวต่างชาติ</strong> — จ่ายค่าเดินทางทั้งหมดด้วยแอปเดียว</a>
      </div>

    </div>

    <div class="not-prose mt-12 pt-8 border-t border-gray-200">
  <h3 class="text-base font-bold text-gray-900 mb-4 flex items-center gap-2">📚 แหล่งอ้างอิง</h3>
  <ul class="space-y-2">
    <li>
      <a href="https://www.12306.cn/en/index.html" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
        <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        China Railway Official - 12306 EN
        <svg class="w-3 h-3 text-gray-300 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </li>
    <li>
      <a href="https://web.didiglobal.com/" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
        <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        Didi Global - Ride-Hailing
        <svg class="w-3 h-3 text-gray-300 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </li>
  </ul>
</div>
  </article>
</Layout>