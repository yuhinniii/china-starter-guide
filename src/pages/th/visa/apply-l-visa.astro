---
import Layout from '@layouts/Layout.astro';
const title = 'วิธีขอวีซ่าท่องเที่ยวจีน (ประเภท L) 2026: คู่มือทีละขั้นตอน';
const description = 'คู่มือทีละขั้นตอนครบถ้วนสำหรับการยื่นขอวีซ่าท่องเที่ยวจีนประเภท L ในปี 2026 เอกสารทางการ แบบฟอร์มออนไลน์ COVA การนัดหมาย ค่าธรรมเนียม และคำถามที่พบบ่อย';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าเตรียมการ
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">📋 วีซ่าท่องเที่ยว</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        วิธีขอวีซ่าท่องเที่ยวจีน (ประเภท L) 2026
      </h1>
      <p class="text-xl text-gray-600 mb-6">คู่มือทีละขั้นตอนครบถ้วนสำหรับการขอวีซ่าท่องเที่ยวจีน</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 8 นาที</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 คำตอบด่วน</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        <strong>ยื่นขอออนไลน์ผ่าน <a href="http://cova.mfa.gov.cn/" class="text-blue-700 underline">COVA</a> จากนั้นไปที่ศูนย์บริการยื่นขอวีซ่าในพื้นที่ด้วยตนเอง</strong> คุณจะต้องมีพาสปอร์ตที่ยังมีอายุ แบบฟอร์มที่กรอกเรียบร้อย รูปถ่าย แผนการเดินทาง และค่าธรรมเนียมวีซ่า โดยทั่วไปการดำเนินการใช้เวลา 4-5 วันทำการ
      </p>
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-8 not-prose">
      <p class="text-sm text-gray-700 mb-1 font-semibold">พอร์ทัลทางการ:</p>
      <ul class="text-sm text-gray-600 space-y-1">
        <li>📋 <a href="http://cova.mfa.gov.cn/" class="text-brand-600 hover:underline" target="_blank" rel="noopener">แบบฟอร์มออนไลน์ COVA</a> — กรอกใบสมัครวีซ่าของคุณ</li>
        <li>📖 <a href="https://consular.mfa.gov.cn/VISA/" class="text-brand-600 hover:underline" target="_blank" rel="noopener">คู่มือวีซ่ากรมกงสุล</a> — คำแนะนำทีละขั้นตอนอย่างเป็นทางการ</li>
        <li>📍 <a href="https://www.visaforchina.cn" class="text-brand-600 hover:underline" target="_blank" rel="noopener">ศูนย์บริการยื่นขอวีซ่า</a> — ค้นหาศูนย์ในพื้นที่ของคุณและนัดหมาย</li>
      </ul>
    </div>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">
      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        หากคุณได้อ่าน <a href="/th/visa/visa-guide/" class="text-brand-600 hover:underline">คู่มือประเภทวีซ่าจีนครบถ้วน</a> และยืนยันว่าคุณต้องใช้วีซ่าท่องเที่ยวประเภท L — นี่คือวิธีการยื่นขอทีละขั้นตอน โดยใช้ระบบออนไลน์ทางการ
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🛂</span> คุณต้องการวีซ่าประเภท L หรือไม่?
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-4">
        <strong>คุณต้องใช้วีซ่าท่องเที่ยวประเภท L หาก:</strong>
      </p>

      <ul class="list-disc pl-5 space-y-2 text-gray-700 mb-6">
        <li>พาสปอร์ตของคุณไม่ได้มาจาก <a href="/th/visa/visa-free/" class="text-brand-600 hover:underline">ประเทศที่ยกเว้นวีซ่า</a></li>
        <li>คุณไม่มีแผนการเดินทางไปประเทศที่สามที่มีสิทธิ์สำหรับ <a href="/th/visa/transit-240/" class="text-brand-600 hover:underline">การต่อเครื่อง 240 ชั่วโมง</a></li>
        <li>คุณวางแผนจะเยือนจีนเพื่อการท่องเที่ยว (ไม่ใช่ทำงาน เรียน หรือธุรกิจ)</li>
      </ul>

      <p class="text-gray-700 mb-6">
        โดยทั่วไปวีซ่าประเภท L จะออกให้ครั้งละ 30, 60 หรือ 90 วัน มีตัวเลือกการเข้าหลายครั้งขึ้นอยู่กับสัญชาติและประวัติวีซ่าของคุณ
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">📄</span> คุณต้องเตรียมเอกสารอะไรบ้าง?
      </h2>

      <p class="text-gray-700 mb-6">
        ตาม <a href="https://cs.mfa.gov.cn/wgrlh/lhqz/cjwdn_660600/201407/t20140717_961493.shtml" class="text-brand-600 hover:underline" target="_blank" rel="noopener">เว็บไซต์กรมกงสุลจีนอย่างเป็นทางการ</a> นี่คือสิ่งที่คุณต้องเตรียม:
      </p>

      <div class="bg-gray-50 rounded-2xl p-6 mb-8 not-prose">
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <span class="text-lg">✅</span>
            <div><strong class="text-gray-900">พาสปอร์ตที่ยังมีอายุ</strong><br/><span class="text-sm text-gray-600">อายุเหลืออย่างน้อย 6 เดือน + หน้าเปล่าสำหรับวีซ่า 2 หน้า</span></div>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-lg">✅</span>
            <div><strong class="text-gray-900">แบบฟอร์มสมัครออนไลน์ COVA</strong><br/><span class="text-sm text-gray-600">กรอกและพิมพ์พร้อมบาร์โค้ดที่ใช้งานได้</span></div>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-lg">✅</span>
            <div><strong class="text-gray-900">รูปถ่ายพาสปอร์ต</strong><br/><span class="text-sm text-gray-600">48mm × 33mm พื้นหลังสีขาว ถ่ายภายใน 6 เดือน</span></div>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-lg">✅</span>
            <div><strong class="text-gray-900">การจองตั๋วเครื่องบินไป-กลับ</strong><br/><span class="text-sm text-gray-600">แผนการเดินทางยืนยันแล้วแสดงวันเข้าและออก</span></div>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-lg">✅</span>
            <div><strong class="text-gray-900">การจองโรงแรม</strong><br/><span class="text-sm text-gray-600">สำหรับการพักทั้งหมดของคุณ หรือจดหมายเชิญจากเจ้าของบ้าน</span></div>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-lg">✅</span>
            <div><strong class="text-gray-900">หลักฐานเงินทุนเพียงพอ</strong><br/><span class="text-sm text-gray-600">รายการเดินบัญชีธนาคาร 3 เดือนล่าสุด</span></div>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-lg">✅</span>
            <div><strong class="text-gray-900">สำเนาวีซ่าจีนครั้งก่อน</strong><br/><span class="text-sm text-gray-600">หากเคยมาเยือนมาก่อน</span></div>
          </li>
        </ul>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">📝</span> กระบวนการยื่นขอทีละขั้นตอน
      </h2>

      <div class="space-y-6 mb-8 not-prose">
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
          <div class="flex items-center gap-4 mb-3">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-blue-600 text-white text-lg font-bold flex items-center justify-center">1</span>
            <h3 class="text-xl font-bold text-gray-900">กรอกแบบฟอร์มออนไลน์ COVA</h3>
          </div>
          <p class="text-gray-700 mb-3">ไปที่ <a href="http://cova.mfa.gov.cn/" class="text-brand-600 hover:underline" target="_blank">cova.mfa.gov.cn</a> และกรอกใบสมัครวีซ่าออนไลน์ แบบฟอร์มถามข้อมูลส่วนตัว ประวัติการเดินทาง ข้อมูลพาสปอร์ต และแผนการเดินทาง</p>
          <div class="bg-white rounded-xl p-4">
            <p class="text-sm text-gray-600 font-semibold mb-1">💡 เคล็ดลับสำหรับ COVA:</p>
            <ul class="text-sm text-gray-600 space-y-1">
              <li>• เก็บรหัสใบสมัครของคุณ — คุณจะต้องใช้เพื่อเรียกดูแบบฟอร์ม</li>
              <li>• พิมพ์แบบฟอร์มสุดท้ายที่มีบาร์โค้ดปรากฏในหน้าสุดท้าย</li>
              <li>• บางสถานกงสุลต้องการให้คุณกรอก COVA เท่านั้น ในขณะที่บางแห่งต้องนัดหมายด้วย — ตรวจสอบคำแนะนำของศูนย์ในพื้นที่ของคุณ</li>
            </ul>
          </div>
        </div>

        <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
          <div class="flex items-center gap-4 mb-3">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-green-600 text-white text-lg font-bold flex items-center justify-center">2</span>
            <h3 class="text-xl font-bold text-gray-900">นัดหมาย</h3>
          </div>
          <p class="text-gray-700 mb-3">ไปที่ <a href="https://www.visaforchina.cn" class="text-brand-600 hover:underline" target="_blank">visaforchina.cn</a> เพื่อนัดหมายที่ศูนย์บริการยื่นขอวีซ่าที่ใกล้ที่สุด หลายศูนย์ต้องนัดหมาย และอาจไม่รับผู้เดินเข้าโดยไม่ได้นัดหมาย</p>
        </div>

        <div class="bg-purple-50 border border-purple-200 rounded-2xl p-6">
          <div class="flex items-center gap-4 mb-3">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-purple-600 text-white text-lg font-bold flex items-center justify-center">3</span>
            <h3 class="text-xl font-bold text-gray-900">เตรียมเอกสารของคุณ</h3>
          </div>
          <p class="text-gray-700">รวบรวมเอกสารที่จำเป็นทั้งหมดที่ระบุไว้ข้างต้น ทำสำเนาทุกอย่าง — ศูนย์อาจเก็บต้นฉบับและคืนเฉพาะพาสปอร์ตของคุณพร้อมวีซ่า</p>
        </div>

        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6">
          <div class="flex items-center gap-4 mb-3">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-orange-600 text-white text-lg font-bold flex items-center justify-center">4</span>
            <h3 class="text-xl font-bold text-gray-900">ไปที่ศูนย์บริการยื่นขอวีซ่า</h3>
          </div>
          <p class="text-gray-700 mb-3">นำเอกสารมาด้วยตนเอง คุณจะยื่นเอกสาร รับการพิมพ์ลายนิ้วมือ (สำหรับผู้สมัครส่วนใหญ่) และชำระค่าธรรมเนียม</p>
          <div class="bg-white rounded-xl p-4">
            <p class="text-sm text-gray-600"><strong>ค่าธรรมเนียม:</strong> โดยทั่วไป $30–$100 USD ขึ้นอยู่กับสัญชาติ จำนวนครั้งที่เข้าประเทศ และความเร็วในการดำเนินการ</p>
          </div>
        </div>

        <div class="bg-teal-50 border border-teal-200 rounded-2xl p-6">
          <div class="flex items-center gap-4 mb-3">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-teal-600 text-white text-lg font-bold flex items-center justify-center">5</span>
            <h3 class="text-xl font-bold text-gray-900">รอการดำเนินการ</h3>
          </div>
          <p class="text-gray-700">การดำเนินการมาตรฐานใช้เวลา 4–5 วันทำการ บริการเร่งด่วน (2–3 วัน) อาจมีให้โดยมีค่าธรรมเนียมเพิ่มเติม คุณสามารถติดตามสถานะใบสมัครของคุณออนไลน์ได้</p>
        </div>

        <div class="bg-red-50 border border-red-200 rounded-2xl p-6">
          <div class="flex items-center gap-4 mb-3">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-red-600 text-white text-lg font-bold flex items-center justify-center">6</span>
            <h3 class="text-xl font-bold text-gray-900">รับพาสปอร์ตคืน</h3>
          </div>
          <p class="text-gray-700">กลับไปที่ศูนย์พร้อมใบเสร็จเพื่อรับพาสปอร์ตของคุณที่มีวีซ่า บางศูนย์มีบริการจัดส่งทางไปรษณีย์</p>
        </div>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">💡</span> เคล็ดลับสำหรับการยื่นขอที่ราบรื่น
      </h2>

      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-6 not-prose">
        <p class="text-yellow-900"><strong>ยื่นขอล่วงหน้า:</strong> เริ่มอย่างน้อย 4-6 สัปดาห์ก่อนเดินทาง การดำเนินการล่าช้าเกิดขึ้นได้ และคุณไม่ต้องการเครียด</p>
      </div>

      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-6 not-prose">
        <p class="text-yellow-900"><strong>ตรวจสอบทุกอย่างอีกครั้ง:</strong> แบบฟอร์มที่ไม่สมบูรณ์เป็นสาเหตุอันดับ 1 ของความล่าช้า ลายเซ็นที่ขาดหายไปหรือวันที่ผิดหนึ่งครั้งอาจทำให้คุณเสียเวลาเป็นสัปดาห์</p>
      </div>

      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-6 not-prose">
        <p class="text-yellow-900"><strong>ซื่อสัตย์:</strong> ข้อมูลที่ไม่ถูกต้องในใบสมัครของคุณอาจนำไปสู่การปฏิเสธหรือปัญหาวีซ่าในอนาคต</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">❓</span> คำถามที่พบบ่อย
      </h2>

      <div class="space-y-6 mb-8 not-prose">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">ฉันสามารถยื่นขอทางไปรษณีย์ได้หรือไม่?</h3>
          <p class="text-gray-700">ผู้สมัครส่วนใหญ่ต้องยื่นด้วยตนเองที่ศูนย์บริการยื่นขอวีซ่า บางประเทศอนุญาตให้บุคคลที่สามยื่นแทนได้ แต่โดยทั่วไปคุณต้องไปที่ศูนย์อย่างน้อยหนึ่งครั้ง ตรวจสอบเว็บไซต์ของศูนย์ในพื้นที่ของคุณสำหรับกฎเฉพาะ</p>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">วีซ่ามีอายุใช้งานนานแค่ไหน?</h3>
          <p class="text-gray-700">โดยทั่วไป 3 เดือนนับจากวันที่ออก คุณต้องเข้าจีนภายในกรอบเวลานี้ ระยะเวลาพัก (เช่น 30 วัน) เริ่มนับตั้งแต่วันที่คุณเข้าจีน</p>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">ฉันสามารถต่ออายุวีซ่าในจีนได้หรือไม่?</h3>
          <p class="text-gray-700">ได้ คุณสามารถยื่นขอต่ออายุวีซ่าได้ที่สำนักงานตรวจคนเข้าเมือง (PSB) ในพื้นที่ในจีน โดยทั่วไปการต่ออายุจะได้รับสูงสุด 30 วันเพิ่มเติม</p>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">จะเกิดอะไรขึ้นหากวีซ่าของฉันถูกปฏิเสธ?</h3>
          <p class="text-gray-700">การปฏิเสธวีซ่าค่อนข้างหายากสำหรับการสมัครท่องเที่ยวทั่วไป หากถูกปฏิเสธ โดยทั่วไปคุณจะได้รับเหตุผล คุณสามารถยื่นใหม่ได้หลังจากแก้ไขปัญหา เหตุผลทั่วไปรวมถึงเอกสารไม่ครบถ้วนหรือเงินทุนไม่เพียงพอ</p>
        </div>
