---
import Layout from '@layouts/Layout.astro';
const title = 'ข้อบังคับศุลกากรจีน: สิ่งที่นำเข้าและนำเข้าจีนไม่ได้';
const description = 'คู่มือศุลกากรจีนครบถ้วนสำหรับนักท่องเที่ยว — วงเงินปลอดภาษี สิ่งของต้องห้าม สิ่งที่ต้องสำแดง และช่องทางที่ต้องเลือก';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าวีซ่าและการเข้าเมือง
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🛂 การเข้าเมืองและวีซ่า</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        ข้อบังคับศุลกากรจีน: สิ่งที่นำเข้าและนำเข้าจีนไม่ได้
      </h1>
      <p class="text-xl text-gray-600 mb-6">คู่มือปฏิบัติเกี่ยวกับกฎศุลกากรสำหรับนักท่องเที่ยวที่เข้าจีน</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 5 นาที</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 คำตอบด่วน</h2>
      <p class="text-lg text-blue-800 leading-relaxed mb-4">
        นี่คือฉบับย่อสำหรับนักท่องเที่ยวทั่วไป:
      </p>
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm bg-white rounded-xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">วงเงินปลอดภาษีศุลกากรจีนและสินค้าต้องห้าม</caption>
          <thead>
            <tr class="bg-blue-600 text-white">
              <th class="px-4 py-2 text-left">✅ นำเข้าได้</th>
              <th class="px-4 py-2 text-left">⚠️ ตรวจสอบรายละเอียดด้านล่าง</th>
              <th class="px-4 py-2 text-left">❌ ห้ามนำเข้า</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-4 py-2">เสื้อผ้า ของใช้ส่วนตัว โทรศัพท์ โน้ตบุ๊ก กล้อง</td>
              <td class="px-4 py-2">แอลกอฮอล์ บุหรี่ ของขวัญมูลค่า &gt; 2,000 หยวน เงินสด &gt; $5,000</td>
              <td class="px-4 py-2">เนื้อสัตว์ ผลไม้ ผัก ยาเสพติด อาวุธ</td>
            </tr>
          </tbody>
        </table>
      </div>
      <ul class="list-disc pl-5 text-blue-800 text-sm space-y-1">
        <li><strong>ของขวัญ/ของบริโภคที่ทิ้งไว้ในจีน:</strong> ไม่เกิน <strong>2,000 หยวน</strong></li>
        <li><strong>บุหรี่:</strong> สูงสุด <strong>400</strong> มวน (200 หากมาจากฮ่องกง/มาเก๊า)</li>
        <li><strong>แอลกอฮอล์:</strong> สูงสุด <strong>1.5 ลิตร</strong> (0.75 ลิตรหากมาจากฮ่องกง/มาเก๊า)</li>
        <li><strong>เงินสดต่างประเทศ:</strong> ต้องสำแดงหากเกิน <strong>$5,000 USD</strong></li>
        <li><strong>เงินสดหยวน:</strong> สูงสุด <strong>20,000 หยวน</strong> (ไม่มีข้อยกเว้น)</li>
      </ul>
    </div>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">

      <h2 class="text-3xl font-bold text-gray-900 mb-6">❌ ห้ามนำสิ่งเหล่านี้เข้าจีน</h2>

      <div class="bg-red-50 border border-red-200 rounded-2xl p-6 mb-6 not-prose">
        <p class="font-bold text-gray-900 mb-2">สิ่งที่ห้ามเด็ดขาด (จะถูกยึด):</p>
        <ul class="list-disc pl-5 text-gray-700 space-y-1">
          <li>🚫 ยาเสพติด อาวุธ สินค้าปลอม</li>
          <li>🚫 ผลไม้สด ผัก เนื้อดิบ ไข่ นม พืชมีชีวิต</li>
          <li>🚫 ผลิตภัณฑ์จากสัตว์ใกล้สูญพันธุ์ (งาช้าง กระดูกเสือ นอแรด)</li>
        </ul>
      </div>

      <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-6 mb-8 not-prose">
        <p class="font-bold text-gray-900 mb-2">ระวังสิ่งเหล่านี้ที่อาจทำให้คุณตกใจ:</p>
        <ul class="list-disc pl-5 text-gray-700 space-y-1">
          <li><strong>ขนมเนื้อสัตว์</strong> (เนื้ออบแห้ง ไส้กรอก เบคอน) — ถูกห้ามเช่นกัน แม้จะบรรจุหีบห่อ</li>
          <li><strong>ผลไม้ที่คุณลืมไว้ในกระเป๋า</strong> — สุนัขตรวจสอบกักกันจะค้นพบ</li>
          <li><strong>ยาจีนโบราณ</strong> — บางชนิดมีส่วนผสมของสัตว์ใกล้สูญพันธุ์ เลือกแบบบรรจุหีบห่อที่มีฉลากชัดเจน</li>
          <li><strong>Power Bank</strong> — ต้องมีเครื่องหมาย 3C พกในกระเป๋าถือขึ้นเครื่องเท่านั้น สูงสุด 160Wh</li>
        </ul>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-6">💰 สิ่งที่นักท่องเที่ยวส่วนใหญ่ต้องรู้</h2>

      <h3 class="text-xl font-bold text-gray-800 mb-4">ของขวัญและสิ่งของที่คุณทิ้งไว้</h3>
      <p class="text-gray-700 mb-4">
        วงเงิน 2,000 หยวนใช้กับสิ่งของที่คุณให้หรือบริโภคในจีน (ของขวัญ ของที่ระลึกที่คุณให้เพื่อน ช็อคโกแลตที่คุณกินระหว่างพัก) สิ่งของที่คุณนำมาสำหรับตัวเองและนำกลับบ้านไม่นับรวม
      </p>

      <div class="overflow-x-auto mb-8 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">วงเงินปลอดภาษีศุลกากรจีนและสินค้าต้องห้าม</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-5 py-3 font-bold">คุณคือ...</th>
              <th class="px-5 py-3 font-bold">วงเงินปลอดภาษีสำหรับสิ่งของที่ทิ้งไว้ในจีน</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 font-semibold">นักท่องเที่ยวต่างชาติ</td>
              <td class="px-5 py-3"><strong>2,000 หยวน</strong></td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3 font-semibold">ผู้มีถิ่นพำนักจีนเดินทางกลับ</td>
              <td class="px-5 py-3">5,000 หยวน</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">บุหรี่และแอลกอฮอล์</h3>
      <p class="text-gray-700 mb-4">
        แบบฟอร์มสำแดงศุลกากรกำหนดวงเงินปลอดภาษีเหล่านี้ หากคุณเกิน ให้ทำเครื่องหมายและใช้ช่องทางแดง
      </p>

      <div class="overflow-x-auto mb-4 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">วงเงินปลอดภาษีศุลกากรจีนและสินค้าต้องห้าม</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-5 py-3 font-bold">รายการ</th>
              <th class="px-5 py-3 font-bold text-center">ผู้เดินทางขาเข้า</th>
              <th class="px-5 py-3 font-bold text-center">ผู้เดินทางจากฮ่องกง/มาเก๊า</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3">บุหรี่ (รวมบุหรี่ไฟฟ้าแบบใช้ความร้อน)</td>
              <td class="px-5 py-3 text-center"><strong>400</strong></td>
              <td class="px-5 py-3 text-center">200</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3">ซิการ์</td>
              <td class="px-5 py-3 text-center"><strong>20</strong></td>
              <td class="px-5 py-3 text-center">10</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3">ยาเส้น</td>
              <td class="px-5 py-3 text-center"><strong>500 กรัม</strong></td>
              <td class="px-5 py-3 text-center">250 กรัม</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3">อุปกรณ์บุหรี่ไฟฟ้า</td>
              <td class="px-5 py-3 text-center"><strong>2</strong></td>
              <td class="px-5 py-3 text-center">1</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3">ตลับบุหรี่ไฟฟ้า</td>
              <td class="px-5 py-3 text-center"><strong>6</strong> (≤ 12 มล. รวม)</td>
              <td class="px-5 py-3 text-center">3 (≤ 6 มล.)</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3">แอลกอฮอล์ (≥12%)</td>
              <td class="px-5 py-3 text-center"><strong>1,500 มล.</strong></td>
              <td class="px-5 py-3 text-center">750 มล.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm text-gray-500 mb-8">หมายเหตุ: สำหรับผู้เดินทางบ่อย (ข้ามแดนทุกวัน/รายสัปดาห์) จะมีข้อจำกัดที่เข้มงวดกว่ามาก — บุหรี่ 40 มวน, ซิการ์ 2, ยาเส้น 40 กรัม, อุปกรณ์บุหรี่ไฟฟ้า 1 ชิ้น นักท่องเที่ยวส่วนใหญ่ไม่ตกอยู่ในหมวดนี้</p>

      <h3 class="text-xl font-bold text-gray-800 mb-4">เงินสด</h3>
      <div class="overflow-x-auto mb-8 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">วงเงินปลอดภาษีศุลกากรจีนและสินค้าต้องห้าม</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-5 py-3 font-bold">สกุลเงิน</th>
              <th class="px-5 py-3 font-bold text-center">วงเงิน</th>
              <th class="px-5 py-3 font-bold">สิ่งที่ต้องทำ</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3">หยวน</td>
              <td class="px-5 py-3 text-center">สูงสุด <strong>20,000 หยวน</strong></td>
              <td class="px-5 py-3">เกินนี้ = ต้องห้าม</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3">USD หรือเงินตราต่างประเทศอื่น</td>
              <td class="px-5 py-3 text-center">สำแดงหาก <strong>เกิน $5,000</strong></td>
              <td class="px-5 py-3">รับแบบฟอร์มประทับตรา เก็บไว้ตอนออก</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">ยา</h3>
      <p class="text-gray-700 mb-4">
        <strong>ยาตามใบสั่งแพทย์:</strong> ปริมาณ 7 วัน ไม่ต้องใช้เอกสาร สำหรับการพักนานขึ้น ให้นำใบรับรองแพทย์มา เก็บยาในขวดเดิม — เจ้าหน้าที่ศุลกากรไม่ไว้ใจกล่องจัดยา
      </p>
      <p class="text-gray-700 mb-8">
        <strong>คำเตือนยาแก้หวัด:</strong> ยาที่มีส่วนผสมของ <strong>pseudoephedrine</strong> (Sudafed, NyQuil, ยาเม็ดแก้หวัดทั่วไปหลายชนิด) ถูกจำกัดในจีน หนึ่งกล่องไม่เป็นไร การนำหลายกล่องอาจถูกถือว่าพกพาสารตั้งต้นยาเสพติด อย่าใส่ยาแก้หวัดมากเกินไป
      </p>

      <h3 class="text-xl font-bold text-gray-800 mb-4">อุปกรณ์อิเล็กทรอนิกส์ที่จะนำกลับบ้าน</h3>
      <p class="text-gray-700 mb-8">
        โน้ตบุ๊ก โทรศัพท์ กล้อง และแท็บเล็ตของคุณใช้ช่องทางเขียวได้ — เป็นสิ่งของส่วนตัวที่คุณนำมาและจะนำกลับบ้าน หากคุณพกอุปกรณ์ที่มีมูลค่าสูงมาก (กล้องโปร อุปกรณ์ถ่ายทำ, โน้ตบุ๊กหลายเครื่อง) คุณสามารถสำแดงเป็น "นำเข้าชั่วคราว" ที่ช่องทางแดงเพื่อหลีกเลี่ยงคำถามตอนออก แต่ส่วนใหญ่นักท่องเที่ยวไม่สนใจและไม่มีปัญหา
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-6">🚦 เลือกช่องทางไหน</h2>
      <p class="text-gray-700 mb-4">
        แบบฟอร์มสำแดงศุลกากรมี 7 ข้อ <strong>หากข้อใดใช้กับคุณ → ช่องทางแดง หากไม่มีข้อใดใช้ → ช่องทางเขียว</strong>
      </p>

      <div class="overflow-x-auto mb-8 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">วงเงินปลอดภาษีศุลกากรจีนและสินค้าต้องห้าม</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-5 py-3 font-bold text-center">#</th>
              <th class="px-5 py-3 font-bold">ทำเครื่องหมายหากคุณพก...</th>
              <th class="px-5 py-3 font-bold text-center">ไปที่</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 text-center font-bold">1</td>
              <td class="px-5 py-3">สัตว์ พืช อาหารสด เนื้อสัตว์ จุลินทรีย์ ผลิตภัณฑ์ชีวภาพ</td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3 text-center font-bold">2</td>
              <td class="px-5 py-3">(ผู้มีถิ่นพำนักจีนเดินทางกลับ) สิ่งของเกิน 5,000 หยวน</td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 text-center font-bold">3</td>
              <td class="px-5 py-3">(นักท่องเที่ยวต่างชาติ) ของขวัญหรือสิ่งของ<strong>มูลค่าเกิน 2,000 หยวน</strong> ที่<strong>ทิ้งไว้ในจีน</strong></td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3 text-center font-bold">4</td>
              <td class="px-5 py-3">แอลกอฮอล์เกิน <strong>1,500 มล.</strong> / บุหรี่เกิน <strong>400</strong> มวน / ซิการ์เกิน <strong>20</strong> / ยาเส้นเกิน <strong>500 กรัม</strong> / อุปกรณ์บุหรี่ไฟฟ้าเกิน 2 ชิ้นหรือตลับเกิน 6 ตลับ</td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 text-center font-bold">5</td>
              <td class="px-5 py-3">เงินสดเกิน <strong>20,000 หยวน</strong> หรือเงินต่างประเทศเกิน <strong>$5,000 USD</strong></td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3 text-center font-bold">6</td>
              <td class="px-5 py-3">กระเป๋าเดินทางที่จัดส่งแยกต่างหาก สินค้าสำหรับธุรกิจ</td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 text-center font-bold">7</td>
              <td class="px-5 py-3">สิ่งอื่นใดที่คุณไม่แน่ใจ</td>
              <td class="px-5 py-3 text-center">🔴</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-gray-700 font-semibold mb-8">ไม่มีข้อที่ต้องทำเครื่องหมาย? → 🟢 ช่องทางเขียว แค่เดินผ่าน</p>

      <h2 class="text-3xl font-bold text-gray-900 mb-6">สถานการณ์จริงของนักท่องเที่ยว</h2>

      <!-- Scenario 1 -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-4 not-prose">
        <p class="font-bold text-gray-900 mb-2">สถานการณ์ที่ 1: คุณนำของขวัญมาให้เพื่อนชาวจีน</p>
        <p class="text-gray-700 text-sm mb-3">คุณแพ็ควิสกี้ซิงเกิลมอลต์หนึ่งขวด ($150), ช็อคโกแลตศิลปะหนึ่งกล่อง ($40), และกระเป๋าสตางค์หนังแบรนด์ ($120) — ทั้งหมดเป็นของขวัญให้เพื่อนในเซี่ยงไฮ้ มูลค่ารวม: ~$310 USD (~2,200 หยวน)</p>
        <div class="bg-yellow-50 rounded-xl p-4">
          <p class="text-sm text-yellow-900"><strong>วิเคราะห์:</strong> สิ่งเหล่านี้จะอยู่ที่จีน (ของขวัญ) และเกิน 2,000 หยวนรวม ในแบบฟอร์ม ทำเครื่องหมายข้อ 3</p>
          <p class="text-sm text-red-700 font-semibold mt-1">→ 🔴 ช่องทางแดง สำแดงเป็น "ของขวัญที่ทิ้งไว้ในจีน" และเตรียมชำระภาษีสำหรับส่วนที่เกิน 200 หยวน</p>
        </div>
      </div>

      <!-- Scenario 2 -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-4 not-prose">
        <p class="font-bold text-gray-900 mb-2">สถานการณ์ที่ 2: คุณนำเงินสด $5,500 USD</p>
        <p class="text-gray-700 text-sm mb-3">คุณแลกเงินสดก่อนเดินทางและมี $5,500 USD ในกระเป๋าเงินเพื่อใช้ระหว่างทริป</p>
        <div class="bg-yellow-50 rounded-xl p-4">
          <p class="text-sm text-yellow-900"><strong>วิเคราะห์:</strong> เงินสดต่างประเทศเกิน $5,000 USD ทำให้ต้องทำเครื่องหมายข้อ 5</p>
          <p class="text-sm text-red-700 font-semibold mt-1">→ 🔴 ช่องทางแดง สำแดง $5,500 USD กรอกแบบฟอร์มสำแดงเงินสด และรับสำเนาประทับตรา เก็บแบบฟอร์มนั้นเพื่อนำเงินสดที่เหลือกลับออกไปเมื่อออก</p>
        </div>
      </div>

      <!-- Scenario 3 -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-4 not-prose">
        <p class="font-bold text-gray-900 mb-2">สถานการณ์ที่ 3: แค่กระเป๋าเดินทางปกติ</p>
        <p class="text-gray-700 text-sm mb-3">คุณแพ็คเสื้อผ้า ของใช้ส่วนตัว โน้ตบุ๊ก โทรศัพท์ Kindle และกล้อง — ทั้งหมดเป็นของส่วนตัวที่คุณจะนำกลับบ้าน มูลค่ารวมเป็นพันแต่ไม่มีสิ่งใดที่ทิ้งไว้ในจีน</p>
        <div class="bg-green-50 rounded-xl p-4">
          <p class="text-sm text-green-800"><strong>วิเคราะห์:</strong> ไม่มีข้อใดในแบบฟอร์มที่ใช้ได้ สิ่งเหล่านี้เป็น "การนำเข้าชั่วคราว" — ของใช้ส่วนตัวที่คุณจะนำกลับบ้าน</p>
          <p class="text-sm text-green-700 font-semibold mt-1">→ 🟢 ช่องทางเขียว นี่คือความจริงของนักท่องเที่ยว 95% เดินผ่านไป</p>
        </div>
      </div>

      <!-- Scenario 4 -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-4 not-prose">
        <p class="font-bold text-gray-900 mb-2">สถานการณ์ที่ 4: คุณแพ็คยาแก้หวัดมา</p>
        <p class="text-gray-700 text-sm mb-3">คุณมียาเม็ดแก้หวัดและไข้หวัดใหญ่หนึ่งกล่อง (ที่มี pseudoephedrine), ยาแก้แพ้บางชนิด และครีมยาปฏิชีวนะหลอดเล็ก — ของมาตรฐานสำหรับนักเดินทาง</p>
        <div class="bg-yellow-50 rounded-xl p-4">
          <p class="text-sm text-yellow-900"><strong>วิเคราะห์:</strong> ยาที่ไม่ต้องมีใบสั่งแพทย์สำหรับใช้ส่วนตัวปกติไม่เป็นไร Pseudoephedrine ถูกจำกัดในจีน แต่หนึ่งกล่อง (7 วัน) โดยทั่วไปไม่มีปัญหา</p>
          <p class="text-sm text-green-700 font-semibold mt-1">→ 🟢 ช่องทางเขียวสำหรับปริมาณปกติ แต่ถ้าคุณนำหลายกล่อง นั่นเป็นอีกเรื่อง</p>
        </div>
      </div>

      <!-- Scenario 5 -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-4 not-prose">
        <p class="font-bold text-gray-900 mb-2">สถานการณ์ที่ 5: แอปเปิลและแซนด์วิชไก่จากเที่ยวบิน</p>
        <p class="text-gray-700 text-sm mb-3">คุณหยิบแอปเปิลสดและแซนด์วิชจากบริการอาหารเช้าและลืมว่ามันอยู่ในกระเป๋าเป้</p>
        <div class="bg-red-50 rounded-xl p-4">
          <p class="text-sm text-red-800"><strong>วิเคราะห์:</strong> ผลไม้สด = ข้อ 1 ผลิตภัณฑ์เนื้อสัตว์ = ข้อ 1</p>
          <p class="text-sm text-red-700 font-semibold mt-1">→ 🔴 ช่องทางแดง สำแดง — พวกมันจะถูกยึดและทำลาย ตรวจสอบกระเป๋าของคุณก่อนเลือกช่องทางเสมอ</p>
        </div>
      </div>

      <div class="bg-red-50 border-l-4 border-red-400 p-5 rounded-r-xl mb-8 not-prose">
        <p class="text-red-900 text-sm"><strong>เมื่อไม่แน่ใจ ให้เลือกช่องทางแดง</strong> การสำแดงโดยสมัครใจเป็นเรื่องเล็กน้อย การซ่อนของทำให้ถูกยึดและถูกปรับ</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-6">📝 วิธีสำแดง</h2>
      <p class="text-gray-700 mb-4">
        <strong>หยิบแบบฟอร์มกระดาษที่ศุลกากร</strong> — หยิบ "แบบฟอร์มสำแดงสัมภาระ" (中英文对照, มีที่เคาน์เตอร์ก่อนช่องตรวจสอบ) และกรอกทันที ทำเครื่องหมายข้อที่เกี่ยวข้อง จากนั้นยื่นให้เจ้าหน้าที่ที่ช่องทางแดง
      </p>
      <p class="text-gray-700 mb-8">
        <strong>บทลงโทษสำหรับการซ่อนของ:</strong> ยึด + ปรับสูงถึง 100,000 หยวน การเลี่ยงภาษีเกิน 10,000 หยวนอาจนำไปสู่การดำเนินคดีอาญา
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-6">💡 เคล็ดลับด่วน</h2>
      <ol class="list-decimal pl-6 space-y-2 text-gray-700 mb-8">
        <li><strong>ใส่ยาในขวดเดิม</strong> — เจ้าหน้าที่ศุลกากรไม่ไว้ใจกล่องจัดยา</li>
        <li><strong>ไม่มีผลไม้ เนื้อสัตว์ หรือนมในกระเป๋า</strong> — สุนัขตรวจสอบกักกันทำงานเก่งมาก</li>
        <li><strong>ห้ามถ่ายรูปที่ศุลกากร</strong> — ห้ามบันทึกวิดีโอในพื้นที่ตรวจสอบ</li>
        <li><strong>ตรวจสอบกระเป๋าก่อนเลือกช่องทาง</strong> — แอปเปิลจากเที่ยวบินนั้นนับด้วย</li>
        <li><strong>เก็บใบเสร็จ</strong> สำหรับสินค้าแบรนด์และของขวัญ</li>
      </ol>

    </div>

