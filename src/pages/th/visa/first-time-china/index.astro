---
import Layout from '@layouts/Layout.astro';
const title = 'ครั้งแรกในจีน: คู่มือเตรียมการทีละขั้นตอน';
const description = 'ไทม์ไลน์ครบถ้วนสำหรับนักเดินทางครั้งแรกในจีน — วีซ่า การตั้งค่าดิจิทัล การแพ็คกระเป๋า การเดินทางถึง และ 24 ชั่วโมงแรก';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าวีซ่าและการเข้าเมือง
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">🛂 การเข้าเมืองและวีซ่า</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        ครั้งแรกในจีน: คู่มือเตรียมการทีละขั้นตอน
      </h1>
      <p class="text-xl text-gray-600 mb-6">ทุกสิ่งที่คุณต้องทำก่อนเดินทางครั้งแรกไปจีน จัดเรียงตามไทม์ไลน์</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 8 นาที</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 คำตอบด่วน</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        <strong>เริ่มเตรียมตัว 2-3 เดือนก่อนเดินทาง</strong> <a href="/th/visa/visa-guide/" class="text-brand-600 underline">ตรวจสอบว่าคุณต้องการวีซ่าหรือไม่</a> ก่อน ซื้อประกันการเดินทาง ตั้งค่า VPN, Alipay และ WeChat Pay อย่างน้อยหนึ่งสัปดาห์ก่อนออกเดินทาง แพ็คอะแดปเตอร์ไฟ เงินสด (เผื่อไว้) และยาตามใบสั่งแพทย์ เมื่อถึงแล้ว เปิดใช้งานซิม เชื่อมต่อ WiFi สนามบิน และคุณก็พร้อมแล้ว
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#visa-documents" class="text-blue-600 hover:underline">🛂 2-3 เดือนก่อน: วีซ่าและเอกสาร</a></li>
        <li><a href="#insurance" class="text-blue-600 hover:underline">🏥 1 เดือนก่อน: ประกันและที่พัก</a></li>
        <li><a href="#digital-setup" class="text-blue-600 hover:underline">📱 2 สัปดาห์ก่อน: การตั้งค่าดิจิทัล</a></li>
        <li><a href="#packing" class="text-blue-600 hover:underline">🧳 1 สัปดาห์ก่อน: การแพ็คและการตรวจสอบครั้งสุดท้าย</a></li>
        <li><a href="#arrival" class="text-blue-600 hover:underline">🛬 วันเดินทางถึง: ขั้นตอนแรก</a></li>
        <li><a href="#first-24" class="text-blue-600 hover:underline">⏱️ 24 ชั่วโมงแรกในจีน</a></li>
      </ul>
    </nav>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">

      <h2 id="visa-documents" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🛂</span> 2-3 เดือนก่อน: วีซ่าและเอกสาร
      </h2>

      <p class="text-gray-700 mb-4"><strong>ขั้นแรก <a href="/th/visa/visa-guide/" class="text-brand-600 underline">ตรวจสอบว่าคุณต้องการวีซ่าหรือไม่</a>:</strong></p>
      <ul class="list-disc pl-6 space-y-1 text-gray-700 mb-4">
        <li><strong>50 ประเทศ</strong> ได้รับ <a href="/th/visa/visa-free/" class="text-brand-600 underline">ยกเว้นวีซ่า 30 วัน</a></li>
        <li><strong>~27 ประเทศ</strong> มี <a href="/th/visa/mutual-agreement/" class="text-brand-600 underline">ข้อตกลงยกเว้นวีซ่าร่วม</a> กับจีน</li>
        <li><strong>55 ประเทศ</strong> มีสิทธิ์สำหรับ <a href="/th/visa/transit-240/" class="text-brand-600 underline">การต่อเครื่องปลอดวีซ่า 240 ชั่วโมง (10 วัน)</a></li>
        <li>ประเทศอื่น ๆ ทั้งหมดต้องใช้ <a href="/th/visa/apply-l-visa/" class="text-brand-600 underline">วีซ่าท่องเที่ยว L</a></li>
      </ul>

      <div class="bg-white border border-gray-200 rounded-2xl p-5 mb-8 not-prose">
        <p class="font-semibold text-gray-900 mb-2">สิ่งที่คุณต้องมี:</p>
        <ul class="list-disc pl-5 text-gray-700 text-sm space-y-1">
          <li>✅ พาสปอร์ตอายุเหลืออย่างน้อย 6 เดือน (มีหน้าเปล่า 2+ หน้า)</li>
          <li>✅ วีซ่า (ถ้าต้องการ) — ยื่นขอ 4-6 สัปดาห์ก่อนเดินทาง</li>
          <li>✅ การจองโรงแรมและแผนการเดินทางเครื่องบิน</li>
        </ul>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="insurance" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🏥</span> 1 เดือนก่อน: ประกันและที่พัก
      </h2>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-8">
        <li><strong>ซื้อประกันการเดินทาง</strong> — แนะนำอย่างยิ่งให้มีความคุ้มครองทางการแพทย์ (โรงพยาบาลในจีนอาจต้องชำระเงินล่วงหน้า)</li>
        <li><strong>จองโรงแรม</strong> — ใช้ Trip.com, Booking.com หรือ Agoda</li>
        <li><strong>จองตั๋วเครื่องบิน</strong> — ใช้ Skyscanner, Trip.com หรือสายการบินโดยตรง</li>
      </ul>

      <hr class="border-gray-200 my-12" />

      <h2 id="digital-setup" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">📱</span> 2 สัปดาห์ก่อน: การตั้งค่าดิจิทัล (ขั้นตอนสำคัญที่สุด)
      </h2>

      <!-- VPN -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">🔒 VPN</h3>
        <p class="text-sm text-gray-600 mb-2"><strong>ทำสิ่งนี้ก่อนไปถึง</strong> — ไม่สามารถทำได้ง่ายในจีน</p>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li>ติดตั้งและทดสอบ <a href="/th/life/best-vpns/" class="text-brand-600 underline">VPN</a> บนอุปกรณ์ทั้งหมด (โทรศัพท์ โน้ตบุ๊ก แท็บเล็ต)</li>
          <li>ตัวเลือกแนะนำ: NordVPN, ExpressVPN, Surfshark เป็นต้น</li>
          <li>ดาวน์โหลดแอปและสมัครสมาชิกก่อนออกเดินทาง</li>
          <li>ทดสอบว่า Google, WhatsApp, Instagram และ YouTube ทำงานผ่าน VPN</li>
        </ul>
      </div>

      <!-- Payment Apps -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">💳 แอปชำระเงิน</h3>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li><a href="/th/payment/setup-alipay/" class="text-brand-600 underline"><strong>Alipay</strong></a> (จำเป็น): ดาวน์โหลด ลงทะเบียนด้วยเบอร์ต่างประเทศ เชื่อมบัตร Visa/Mastercard</li>
          <li><a href="/th/payment/setup-wechat/" class="text-brand-600 underline"><strong>WeChat Pay</strong></a> (แนะนำ): ดาวน์โหลด WeChat ลงทะเบียน ยืนยันตัวตน ผูกบัตร</li>
        </ul>
      </div>

      <!-- SIM Card -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">📶 ซิมการ์ด / eSIM</h3>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li>จอง <a href="/th/life/best-sim-esim/" class="text-brand-600 underline">eSIM</a> ออนไลน์ (airalo, Holafly) — เปิดใช้งานเมื่อถึง</li>
          <li>หรือวางแผนซื้อซิมแบบกายภาพที่สนามบินเมื่อเดินทางถึง</li>
        </ul>
      </div>

      <!-- Essential Apps -->
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <h3 class="font-bold text-gray-900 mb-3">📲 แอปพลิเคชันจำเป็น</h3>
        <ul class="list-disc pl-5 text-sm text-gray-700 space-y-1">
          <li><strong>แผนที่:</strong> Apple Maps ใช้งานได้, Google Maps ไม่น่าเชื่อถือ — Amap (高德地图) เป็นมาตรฐานท้องถิ่น</li>
          <li><strong>แปลภาษา:</strong> Google Translate (ดาวน์โหลดภาษาจีนออฟไลน์), หรือ Pleco (พจนานุกรมจีนยอดนิยม)</li>
          <li><strong>การเดินทาง:</strong> <a href="/th/transport/didi/" class="text-brand-600 underline">Didi</a> (Uber ของจีน) — ดาวน์โหลดและตั้งค่าโปรไฟล์</li>
          <li><strong>การสื่อสาร:</strong> WeChat (จำเป็นสำหรับหลายอย่าง — เมนูร้านอาหาร สั่ง QR code ชำระเงิน)</li>
        </ul>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="packing" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🧳</span> 1 สัปดาห์ก่อน: การแพ็คและการตรวจสอบครั้งสุดท้าย
      </h2>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-4">
        <li>เตรียมอะแดปเตอร์แปลงปลั๊ก: จีนใช้ปลั๊ก <strong>Type A, I และ C</strong> (220V, 50Hz)</li>
        <li>ทำสำเนาดิจิทัลของพาสปอร์ต วีซ่า และเอกสารประกัน</li>
        <li>ตรวจสอบสิ่งจำเป็นในการแพ็ค — ดูคู่มือ <a href="/th/life/what-to-pack/" class="text-brand-600 underline">สิ่งที่ต้องแพ็คไปจีน</a> สำหรับรายการตรวจสอบครบถ้วน</li>
      </ul>

      <hr class="border-gray-200 my-12" />

      <h2 id="arrival" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">🛬</span> วันเดินทางถึง: ขั้นตอนแรก
      </h2>

      <ol class="list-decimal pl-6 space-y-2 text-gray-700 mb-8">
        <li><strong>เชื่อมต่อ WiFi สนามบิน</strong> — สนามบินใหญ่ส่วนใหญ่มี WiFi ฟรีผ่านการยืนยันด้วย SMS</li>
        <li><strong>เปิดใช้งาน eSIM หรือซื้อซิมกายภาพ</strong> ที่เคาน์เตอร์โทรคมนาคมในสนามบิน</li>
        <li><strong>แลกเงินสดเล็กน้อย</strong> — 500–1,000 หยวนสำหรับแท็กซี่และอาหารข้างทาง</li>
        <li><strong>นั่งรถไฟ express สนามบิน รถไฟใต้ดิน หรือเรียก Didi</strong> (หลีกเลี่ยงแท็กซี่นอกระบบ)</li>
        <li><strong>เช็คอินเข้าโรงแรม</strong> — พวกเขาจะสแกนพาสปอร์ตของคุณเพื่อลงทะเบียน</li>
      </ol>

      <hr class="border-gray-200 my-12" />

      <h2 id="first-24" class="text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
        <span class="text-4xl">⏱️</span> 24 ชั่วโมงแรกในจีน
      </h2>

      <ul class="list-disc pl-6 space-y-2 text-gray-700 mb-8">
        <li><strong>จ่ายเงินด้วยโทรศัพท์</strong> — สแกน QR Code ได้ทุกที่ ร้านค้าส่วนใหญ่ชอบวิธีนี้ ดูคู่มือ <a href="/th/payment/payment-guide/" class="text-brand-600 underline">วิธีชำระเงินในจีน</a></li>
        <li><strong>ทดสอบ VPN</strong> — เชื่อมต่อทันทีที่ออกจาก WiFi สนามบินไปยังเครือข่ายที่เชื่อถือได้</li>
        <li><strong>สำรวจละแวกของคุณ</strong> — หาร้านสะดวกซื้อที่ใกล้ที่สุด (7-11, FamilyMart หรือ Lawson)</li>
        <li><strong>ดาวน์โหลด Amap</strong> หากยังไม่ได้ — มันจะช่วยคุณในการนำทาง</li>
        <li><strong>กิน</strong> — อาหารข้างทาง ร้านอาหารท้องถิ่น ไม่ต้องให้ทิปในจีน</li>
      </ul>

    </div>

    <!-- Sources -->
    <div class="bg-gray-50 rounded-2xl p-6 not-prose mt-12">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📚 แหล่งอ้างอิง</h3>
      <ul class="space-y-2">
        <li><a href="https://en.nia.gov.cn/n147418/n147463/c183390/content.html" class="text-brand-600 hover:underline text-sm" target="_blank" rel="noopener">สำนักงานตรวจคนเข้าเมืองแห่งชาติ — รายชื่อประเทศที่ได้รับยกเว้นวีซ่าฝ่ายเดียว</a></li>
        <li><a href="https://www.gov.uk/foreign-travel-advice/china/entry-requirements" class="text-brand-600 hover:underline text-sm" target="_blank" rel="noopener">รัฐบาลสหราชอาณาจักร — คำแนะนำการเดินทางจีน: ข้อกำหนดการเข้าเมือง</a></li>
      </ul>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose mt-6">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/th/visa/customs-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">ข้อบังคับศุลกากรจีน</p>
          <p class="text-sm text-gray-600">สิ่งที่นำเข้าและนำเข้าจีนไม่ได้</p>
        </a>
        <a href="/th/visa/arrival-card/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">วิธีกรอกบัตรขาเข้าจีนออนไลน์</p>
          <p class="text-sm text-gray-600">คู่มือทีละขั้นตอนพร้อมภาพประกอบ</p>
        </a>
        <a href="/th/payment/payment-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">วิธีชำระเงินในจีน</p>
          <p class="text-sm text-gray-600">ภาพรวมการชำระเงินครบถ้วน</p>
        </a>
        <a href="/th/transport/airport-to-city/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">จากสนามบินสู่เมือง</p>
          <p class="text-sm text-gray-600">ตัวเลือกการเดินทางที่สนามบินหลัก</p>
        </a>
      </div>
    </div>
  </article>
</Layout>
