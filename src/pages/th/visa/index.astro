---
import Layout from '@layouts/Layout.astro';
const title = 'เตรียมตัวก่อนเดินทางจีน — คู่มือการเข้าเมืองและการตั้งค่า';
const description = 'ทุกอย่างที่ต้องเตรียมก่อนเดินทางไปจีน';
---

<Layout title={title} description={description} lang="th">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">✅ เตรียมการ</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">เตรียมตัวก่อนเดินทางจีน</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">ทุกอย่างที่ต้องเตรียมก่อนเดินทางไปจีน</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">5</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">วีซ่าและการเข้าเมือง</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">การตั้งค่าดิจิทัล</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">4</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">ก่อนออกเดินทาง</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">วีซ่าและการเข้าเมือง</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">5 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/visa/visa-guide/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📖 ภาพรวม</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือประเภทวีซ่าจีนครบถ้วน</p>
            <p class="text-sm text-gray-600 mt-0.5">อธิบายตัวเลือกวีซ่าทั้งหมด — เปรียบเทียบการยกเว้นวีซ่า การต่อเครื่อง และวีซ่า L</p>
          </a>
          <a href="/th/visa/visa-free/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📋 รายชื่อ</span>
            <p class="text-base font-bold text-gray-900 mt-1">รายชื่อประเทศที่ยกเว้นวีซ่าจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">50 ประเทศสามารถเข้าจีนโดยไม่ต้องใช้วีซ่าสูงสุด 30 วัน</p>
          </a>
          <a href="/th/visa/transit-240/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">✈️ การต่อเครื่อง</span>
            <p class="text-base font-bold text-gray-900 mt-1">การต่อเครื่องปลอดวีซ่า 240 ชั่วโมง</p>
            <p class="text-sm text-gray-600 mt-0.5">55 ประเทศที่มีสิทธิ์ — พักได้สูงสุด 10 วันโดยไม่ต้องใช้วีซ่า</p>
          </a>
          <a href="/th/visa/mutual-agreement/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🤝 ข้อตกลงร่วม</span>
            <p class="text-base font-bold text-gray-900 mt-1">ข้อตกลงยกเว้นวีซ่าร่วม</p>
            <p class="text-sm text-gray-600 mt-0.5">29 ประเทศมีข้อตกลงยกเว้นวีซ่าร่วมกับจีน</p>
          </a>
          <a href="/th/visa/apply-l-visa/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📝 การยื่นขอ</span>
            <p class="text-base font-bold text-gray-900 mt-1">วิธีขอวีซ่าท่องเที่ยวจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">คู่มือทีละขั้นตอน — เอกสาร แบบฟอร์ม COVA ค่าธรรมเนียม และเคล็ดลับ</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">การตั้งค่าดิจิทัล</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/life/sim-card-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">📶 อินเทอร์เน็ต</span>
            <p class="text-base font-bold text-gray-900 mt-1">ซิมการ์ดและ eSIM ที่ดีที่สุดสำหรับนักท่องเที่ยว</p>
            <p class="text-sm text-gray-600 mt-0.5">เปรียบเทียบผู้ให้บริการ eSIM ซิมสนามบิน และแพ็กเกจข้อมูล</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">ก่อนออกเดินทาง</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">4 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/visa/customs-guide/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🛃 ข้อบังคับ</span>
            <p class="text-base font-bold text-gray-900 mt-1">ข้อบังคับศุลกากรจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">วงเงินปลอดภาษี สิ่งของต้องห้าม และสิ่งที่ต้องสำแดง</p>
          </a>
          <a href="/th/visa/arrival-card/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">📄 บัตรขาเข้า</span>
            <p class="text-base font-bold text-gray-900 mt-1">กรอกบัตรขาเข้าจีนออนไลน์</p>
            <p class="text-sm text-gray-600 mt-0.5">กรอกบัตรขาเข้า NIA ก่อนบิน — ทีละขั้นตอนพร้อมภาพประกอบ</p>
          </a>
          <a href="/th/life/survival-kit/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🎒 รายการตรวจสอบ</span>
            <p class="text-base font-bold text-gray-900 mt-1">ชุดเตรียมพร้อมเดินทางจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">รายการตรวจสอบก่อนออกเดินทางครบถ้วน — เอกสาร แอป และสิ่งที่ต้องแพ็ค</p>
          </a>
          <a href="/th/visa/first-time-china/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🌟 ครั้งแรก</span>
            <p class="text-base font-bold text-gray-900 mt-1">ครั้งแรกในจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">ไทม์ไลน์ครบถ้วน — วีซ่า การตั้งค่าดิจิทัล การแพ็คกระเป๋า การเดินทางถึง 24 ชั่วโมงแรก</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">คู่มือที่เกี่ยวข้อง</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/th/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">การชำระเงินในจีน</p>
          <p class="text-sm text-gray-500">ตั้งค่า Alipay และอื่น ๆ</p>
        </a>
        <a href="/th/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">การเดินทางในจีน</p>
          <p class="text-sm text-gray-500">การเดินทางภายใน</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
