      {code:'IE',name:'Ireland',flag:'🇮🇪'},{code:'IL',name:'Israel',flag:'🇮🇱'},{code:'IT',name:'Italy',flag:'🇮🇹'},{code:'JM',name:'Jamaica',flag:'🇯🇲'},
      {code:'JP',name:'Japan',flag:'🇯🇵'},{code:'JO',name:'Jordan',flag:'🇯🇴'},{code:'KZ',name:'Kazakhstan',flag:'🇰🇿'},{code:'KE',name:'Kenya',flag:'🇰🇪'},
      {code:'KI',name:'Kiribati',flag:'🇰🇮'},{code:'KP',name:"Korea, Democratic People's Republic of",flag:'🇰🇵'},{code:'KW',name:'Kuwait',flag:'🇰🇼'},{code:'KG',name:'Kyrgyzstan',flag:'🇰🇬'},
      {code:'LA',name:'Laos',flag:'🇱🇦'},{code:'LV',name:'Latvia',flag:'🇱🇻'},{code:'LB',name:'Lebanon',flag:'🇱🇧'},{code:'LS',name:'Lesotho',flag:'🇱🇸'},
      {code:'LR',name:'Liberia',flag:'🇱🇷'},{code:'LY',name:'Libya',flag:'🇱🇾'},{code:'LI',name:'Liechtenstein',flag:'🇱🇮'},{code:'LT',name:'Lithuania',flag:'🇱🇹'},
      {code:'LU',name:'Luxembourg',flag:'🇱🇺'},{code:'MG',name:'Madagascar',flag:'🇲🇬'},{code:'MW',name:'Malawi',flag:'🇲🇼'},{code:'MY',name:'Malaysia',flag:'🇲🇾'},
      {code:'MV',name:'Maldives',flag:'🇲🇻'},{code:'ML',name:'Mali',flag:'🇲🇱'},{code:'MT',name:'Malta',flag:'🇲🇹'},{code:'MH',name:'Marshall Islands',flag:'🇲🇭'},
      {code:'MR',name:'Mauritania',flag:'🇲🇷'},{code:'MU',name:'Mauritius',flag:'🇲🇺'},{code:'MX',name:'Mexico',flag:'🇲🇽'},{code:'FM',name:'Micronesia',flag:'🇫🇲'},
      {code:'MD',name:'Moldova',flag:'🇲🇩'},{code:'MC',name:'Monaco',flag:'🇲🇨'},{code:'MN',name:'Mongolia',flag:'🇲🇳'},{code:'ME',name:'Montenegro',flag:'🇲🇪'},
      {code:'MA',name:'Morocco',flag:'🇲🇦'},{code:'MZ',name:'Mozambique',flag:'🇲🇿'},{code:'MM',name:'Myanmar',flag:'🇲🇲'},{code:'NA',name:'Namibia',flag:'🇳🇦'},
      {code:'NR',name:'Nauru',flag:'🇳🇷'},{code:'NP',name:'Nepal',flag:'🇳🇵'},{code:'NL',name:'Netherlands',flag:'🇳🇱'},{code:'NZ',name:'New Zealand',flag:'🇳🇿'},
      {code:'NI',name:'Nicaragua',flag:'🇳🇮'},{code:'NE',name:'Niger',flag:'🇳🇪'},{code:'NG',name:'Nigeria',flag:'🇳🇬'},{code:'MK',name:'North Macedonia',flag:'🇲🇰'},
      {code:'NO',name:'Norway',flag:'🇳🇴'},{code:'OM',name:'Oman',flag:'🇴🇲'},{code:'PK',name:'Pakistan',flag:'🇵🇰'},{code:'PW',name:'Palau',flag:'🇵🇼'},
      {code:'PA',name:'Panama',flag:'🇵🇦'},{code:'PG',name:'Papua New Guinea',flag:'🇵🇬'},{code:'PY',name:'Paraguay',flag:'🇵🇾'},{code:'PE',name:'Peru',flag:'🇵🇪'},
      {code:'PH',name:'Philippines',flag:'🇵🇭'},{code:'PL',name:'Poland',flag:'🇵🇱'},{code:'PT',name:'Portugal',flag:'🇵🇹'},{code:'QA',name:'Qatar',flag:'🇶🇦'},
      {code:'RO',name:'Romania',flag:'🇷🇴'},{code:'RU',name:'Russia',flag:'🇷🇺'},{code:'RW',name:'Rwanda',flag:'🇷🇼'},{code:'KN',name:'Saint Kitts and Nevis',flag:'🇰🇳'},
      {code:'LC',name:'Saint Lucia',flag:'🇱🇨'},{code:'VC',name:'Saint Vincent and the Grenadines',flag:'🇻🇨'},{code:'WS',name:'Samoa',flag:'🇼🇸'},{code:'SM',name:'San Marino',flag:'🇸🇲'},
      {code:'ST',name:'Sao Tome and Principe',flag:'🇸🇹'},{code:'SA',name:'Saudi Arabia',flag:'🇸🇦'},{code:'SN',name:'Senegal',flag:'🇸🇳'},{code:'RS',name:'Serbia',flag:'🇷🇸'},
      {code:'SC',name:'Seychelles',flag:'🇸🇨'},{code:'SL',name:'Sierra Leone',flag:'🇸🇱'},{code:'SG',name:'Singapore',flag:'🇸🇬'},{code:'SK',name:'Slovakia',flag:'🇸🇰'},
      {code:'SI',name:'Slovenia',flag:'🇸🇮'},{code:'SB',name:'Solomon Islands',flag:'🇸🇧'},{code:'SO',name:'Somalia',flag:'🇸🇴'},{code:'ZA',name:'South Africa',flag:'🇿🇦'},
      {code:'KR',name:'South Korea',flag:'🇰🇷'},{code:'SS',name:'South Sudan',flag:'🇸🇸'},{code:'ES',name:'Spain',flag:'🇪🇸'},{code:'LK',name:'Sri Lanka',flag:'🇱🇰'},
      {code:'SD',name:'Sudan',flag:'🇸🇩'},{code:'SR',name:'Suriname',flag:'🇸🇷'},{code:'SE',name:'Sweden',flag:'🇸🇪'},{code:'CH',name:'Switzerland',flag:'🇨🇭'},
      {code:'SY',name:'Syria',flag:'🇸🇾'},{code:'TJ',name:'Tajikistan',flag:'🇹🇯'},{code:'TH',name:'Thailand',flag:'🇹🇭'},{code:'TL',name:'Timor-Leste',flag:'🇹🇱'},
      {code:'TG',name:'Togo',flag:'🇹🇬'},{code:'TO',name:'Tonga',flag:'🇹🇴'},{code:'TT',name:'Trinidad and Tobago',flag:'🇹🇹'},{code:'TN',name:'Tunisia',flag:'🇹🇳'},
      {code:'TR',name:'Turkey',flag:'🇹🇷'},{code:'TM',name:'Turkmenistan',flag:'🇹🇲'},{code:'TV',name:'Tuvalu',flag:'🇹🇻'},{code:'UG',name:'Uganda',flag:'🇺🇬'},
      {code:'UA',name:'Ukraine',flag:'🇺🇦'},{code:'AE',name:'United Arab Emirates',flag:'🇦🇪'},{code:'GB',name:'United Kingdom',flag:'🇬🇧'},{code:'US',name:'United States',flag:'🇺🇸'},
      {code:'UY',name:'Uruguay',flag:'🇺🇾'},{code:'UZ',name:'Uzbekistan',flag:'🇺🇿'},{code:'VU',name:'Vanuatu',flag:'🇻🇺'},{code:'VE',name:'Venezuela',flag:'🇻🇪'},
      {code:'VN',name:'Vietnam',flag:'🇻🇳'},{code:'YE',name:'Yemen',flag:'🇾🇪'},{code:'ZM',name:'Zambia',flag:'🇿🇲'},{code:'ZW',name:'Zimbabwe',flag:'🇿🇼'}
    ];

    let state = { country: null, purpose: null };
    const countryInput = document.getElementById('country-input');
    const countryDropdown = document.getElementById('country-dropdown');
    const countrySelected = document.getElementById('country-selected');
    const stepPurpose = document.getElementById('step-purpose');
    const resultDiv = document.getElementById('visa-result');
    const resetBtn = document.getElementById('reset-checker');
    const purposeBtns = document.querySelectorAll('.purpose-btn');

    function getVisaStatus(code) {
      if (visaFree30.includes(code)) return 'visa-free-30';
      if (mutualFree.includes(code)) return 'mutual-free';
      if (transit240.includes(code)) return 'transit';
      return 'need-visa';
    }

    countryInput.addEventListener('input', function() {
      renderDropdown(this.value.toLowerCase().trim());
    });
    countryInput.addEventListener('focus', function() {
      renderDropdown(this.value);
    });

    function renderDropdown(q) {
      const matches = q ? countryData.filter(c => c.name.toLowerCase().includes(q) || c.code.toLowerCase() === q) : countryData;
      if (matches.length === 0) { countryDropdown.classList.add('hidden'); return; }
      countryDropdown.innerHTML = matches.map(c =>
        '<div class="px-4 py-2.5 hover:bg-brand-50 cursor-pointer flex items-center gap-3 text-base border-b border-gray-100 last:border-0 ' + (state.country === c.code ? 'bg-brand-50 font-semibold' : '') + '" data-code="' + c.code + '"><span>' + c.flag + '</span><span>' + c.name + '</span></div>'
      ).join('');
      countryDropdown.classList.remove('hidden');
    }

    countryDropdown.addEventListener('click', function(e) {
      var item = e.target.closest('[data-code]');
      if (item) selectCountry(item.dataset.code);
    });
    document.querySelectorAll('.quick-country').forEach(function(btn) {
      btn.addEventListener('click', function() { selectCountry(this.dataset.code); });
    });

    function selectCountry(code) {
      var c = countryData.find(function(x) { return x.code === code; });
      if (!c) return;
      state.country = code;
      countryInput.value = '';
      countryDropdown.classList.add('hidden');
      countrySelected.classList.remove('hidden');
      countrySelected.innerHTML = c.flag + ' <span class="font-semibold">' + c.name + '</span>';
      document.querySelectorAll('.quick-country').forEach(function(btn) {
        if (btn.dataset.code === code) { btn.classList.add('bg-brand-500','text-white','border-brand-500'); btn.classList.remove('bg-white','border-gray-200'); }
        else { btn.classList.remove('bg-brand-500','text-white','border-brand-500'); btn.classList.add('bg-white','border-gray-200'); }
      });
      stepPurpose.classList.remove('hidden');
      resultDiv.classList.add('hidden');
      state.purpose = null;
      purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
    }

    purposeBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        state.purpose = this.dataset.purpose;
        purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
        this.classList.remove('bg-white','text-gray-700','border-gray-200');
        this.classList.add('bg-brand-500','text-white','border-brand-500');
        resetBtn.classList.remove('hidden');
        showResult();
      });
    });

    function detailRow(label, value) {
      return '<div class="flex gap-x-3 text-sm leading-relaxed mb-2 pb-2 border-b border-gray-100"><span class="w-28 shrink-0 text-right font-medium text-gray-500">' + label + '</span><span class="text-gray-700">' + value + '</span></div>';
    }

    function showResult() {
      var country = countryData.find(function(c) { return c.code === state.country; });
      var name = country ? country.name : 'ประเทศของคุณ';
      var status = getVisaStatus(state.country);
      var purpose = state.purpose;

      if (purpose === 'work') {
        resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">ต้องขอวีซ่า</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — การทํางานต้องใช้วีซ่า Z</h3><p class="text-sm text-gray-600 leading-relaxed">การทำงานในจีนต้องใช้วีซ่า Z ที่ได้รับการอนุมัติล่วงหน้าเสมอ ไม่ว่าคุณจะถือหนังสือเดินทางใบใดหรือเดินทางมาอย่างไร</p></div><div class="bg-white px-5 py-4">' + detailRow('ประเภทวีซ่า', 'วีซ่า Z (ใบอนุญาตทำงาน)') + detailRow('ผู้สนับสนุน', 'นายจ้างต้องยื่นคำขอแทน') + detailRow('การดำเนินการ', 'โดยปกติ 4-8 สัปดาห์') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">เว็บไซต์ทางการของ NIA →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/th/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">ประเภทวีซ่าจีน →</a></div></div></div>';
      } else if (purpose === 'study') {
        resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">ต้องขอวีซ่า</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — การเรียนต้องใช้วีซ่า X</h3><p class="text-sm text-gray-600 leading-relaxed">การศึกษาในจีนต้องใช้วีซ่า X ที่ได้รับการอนุมัติล่วงหน้าเสมอ ไม่ว่าคุณจะถือหนังสือเดินทางใบใดหรือเดินทางมาอย่างไร</p></div><div class="bg-white px-5 py-4">' + detailRow('ประเภทวีซ่า', 'X1 (มากกว่า 180 วัน) หรือ X2 (ไม่เกิน 180 วัน)') + detailRow('เอกสาร', 'แบบฟอร์ม JW202, จดหมายตอบรับ, ตรวจสุขภาพ') + detailRow('การดำเนินการ', '5-10 วันทำการ') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">เว็บไซต์ทางการของ NIA →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/th/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">ประเภทวีซ่าจีน →</a></div></div></div>';
      } else if (purpose === 'tourism-business') {
        if (status === 'visa-free-30' || status === 'mutual-free') {
          var policyText = status === 'visa-free-30' ? 'ปลอดวีซ่า 30 วัน' : 'ข้อตกลงทวิภาคี';
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-green-500 overflow-hidden"><div class="bg-green-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-green-700 uppercase mb-1.5">ปลอดวีซ่า</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — 30 วัน ไม่ต้องใช้วีซ่า</h3><p class="text-sm text-gray-600 leading-relaxed">คุณสามารถเข้าจีนโดยไม่ต้องใช้วีซ่าสูงสุด 30 วัน</p></div><div class="bg-white px-5 py-4">' + detailRow('นโยบาย', policyText) + detailRow('มีผลถึง', 'ถึง 31 ธันวาคม 2026') + detailRow('การเข้าเมือง', 'ท่าใดก็ได้ — ทางอากาศ ชายแดนทางบกฮ่องกง หรือทางทะเล') + detailRow('อนุญาตสำหรับ', 'ท่องเที่ยว ธุรกิจ เยี่ยมครอบครัว ต่อเครื่อง') + detailRow('ไม่อนุญาต', 'ทำงาน, เรียน สื่อ') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-green-600 hover:underline">เว็บไซต์ทางการของ NIA →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/th/visa/visa-free/" class="text-sm font-medium text-brand-600 hover:underline">รายชื่อปลอดวีซ่าเต็ม →</a><a href="/th/visa/first-time-china/" class="text-sm font-medium text-brand-600 hover:underline">ครั้งแรกในจีน →</a></div></div></div>';
        } else if (transit240.includes(state.country)) {
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-gray-400 overflow-hidden"><div class="bg-gray-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-gray-500 uppercase mb-1.5">ตัวเลือกวีซ่า</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — วีซ่า L หรือต่อเครื่อง 240 ชม.</h3><p class="text-sm text-gray-600 leading-relaxed">มีสองตัวเลือก เลือกแบบที่เหมาะกับแผนการเดินทางของคุณ</p></div><div class="bg-white px-5 py-4 space-y-6"><div class="rounded-lg border-l-4 border-orange-400 overflow-hidden"><div class="bg-orange-50 px-3 py-2"><p class="text-base font-semibold text-orange-700 mb-0.5">📄 ตัวเลือก A: ขอวีซ่า</p><p class="text-sm text-gray-600 leading-relaxed">สำหรับการเดินทางไปกลับระหว่าง ' + name + ' และจีน คุณยื่นคำขอที่สถานทูตจีนก่อนเดินทาง</p></div><div class="bg-white px-3 py-2">' + detailRow('ประเภทวีซ่า', 'โดยปกติวีซ่า L (ท่องเที่ยว) หรือ M (ธุรกิจ)') + detailRow('เอกสาร', 'หนังสือเดินทาง รูปถ่าย กำหนดการ หลักฐานการเงิน แบบฟอร์ม') + detailRow('การดำเนินการ', '4-10 วันทำการ') + '<a href="/th/visa/apply-l-visa/" class="text-base text-orange-600 font-medium hover:underline">วิธีขอวีซ่า L →</a></div></div><div class="rounded-lg border-l-4 border-blue-400 overflow-hidden"><div class="bg-blue-50 px-3 py-2"><p class="text-base font-semibold text-blue-700 mb-0.5">🔄 ตัวเลือก B: ต่อเครื่อง 240 ชม. (ไม่ต้องใช้วีซ่า)</p><p class="text-sm text-gray-600 leading-relaxed">สำหรับการเดินทางที่รวมฮ่องกง มาเก๊า หรือประเทศอื่น พำนักสูงสุด 10 วันโดยไม่ต้องใช้วีซ่า</p></div><div class="bg-white px-3 py-2">' + detailRow('เงื่อนไข', 'ตัวกเผียเขียนที่ยันยันประประภาดหรือนครวามที่สาม') + detailRow('พำนักสูงสุด', '240 ชั่วโมง (10 วัน)') + '<a href="/th/visa/transit-240/" class="text-base text-blue-600 font-medium hover:underline">รายละเอียดการต่อเครื่อง 240 ชม. →</a></div></div><div class="pt-2 border-t border-gray-100"><a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-gray-500 hover:text-gray-700">เว็บไซต์ทางการของ NIA →</a></div></div></div>';
        } else {
          resultDiv.innerHTML = '<div class="rounded-xl border border-gray-200 border-l-4 border-l-orange-500 overflow-hidden"><div class="bg-orange-50 px-5 py-4"><p class="text-xs font-bold tracking-widest text-orange-600 uppercase mb-1.5">ต้องขอวีซ่า</p><h3 class="text-base font-semibold text-gray-900 leading-snug mb-1">' + name + ' — ยื่นคำขอก่อนเดินทาง</h3><p class="text-sm text-gray-600 leading-relaxed">' + name + ' ต้องยื่นขอวีซ่าจีนก่อนเดินทางมาถึง</p></div><div class="bg-white px-5 py-4">' + detailRow('ประเภทวีซ่า', 'โดยปกติวีซ่า L (ท่องเที่ยว) หรือ M (ธุรกิจ)') + detailRow('ยื่นที่ไหน', 'สถานทูตหรือสถานกงสุลจีนในประเทศ') + detailRow('เอกสาร', 'หนังสือเดินทาง รูปถ่าย กำหนดการ หลักฐานการเงิน แบบฟอร์ม') + detailRow('การดำเนินการ', 'โดยปกติ 4-10 วันทำการ') + '<a href="https://en.nia.gov.cn/" target="_blank" class="inline-block text-base font-medium text-orange-600 hover:underline">เว็บไซต์ทางการของ NIA →</a><div class="bg-gray-50 rounded-xl p-3 mt-4 flex flex-wrap gap-x-6 gap-y-1"><a href="/th/visa/apply-l-visa/" class="text-sm font-medium text-brand-600 hover:underline">คู่มือการขอวีซ่า L →</a><a href="/th/visa/visa-guide/" class="text-sm font-medium text-brand-600 hover:underline">ภาพรวมประเภทวีซ่าจีน →</a></div></div></div>';
        }
      }
      resultDiv.classList.remove('hidden');
    }

    resetBtn.addEventListener('click', function() {
      state = { country: null, purpose: null };
      countryInput.value = '';
      countryDropdown.classList.add('hidden');
      countrySelected.classList.add('hidden');
      stepPurpose.classList.add('hidden');
      resultDiv.classList.add('hidden');
      resetBtn.classList.add('hidden');
      purposeBtns.forEach(function(b) { b.classList.remove('bg-brand-500','text-white','border-brand-500'); b.classList.add('bg-white','text-gray-700','border-gray-200'); });
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('#step-country')) countryDropdown.classList.add('hidden');
    });
  </script>

</Layout>
