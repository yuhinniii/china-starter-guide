---
import Layout from '@layouts/Layout.astro';
const title = 'เตรียมตัวก่อนเดินทางจีน — คู่มือการเข้าเมืองและการตั้งค่า';
const description = 'ทุกอย่างที่ต้องเตรียมก่อนเดินทางไปจีน';
---

<Layout title={title} description={description} lang="th">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">เตรียมตัวก่อนเดินทางจีน</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">ทุกอย่างที่ต้องเตรียมก่อนเดินทางไปจีน</p>
    </header>

    <!-- ตรวจสอบวีซ่า -->
    <div id="visa-checker" class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8 mb-12 not-prose shadow-sm">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-2xl">🛂</span>
        <div>
          <h2 class="text-lg font-bold text-gray-900">ตรวจสอบวีซ่า</h2>
          <p class="text-sm text-gray-500">ไม่แน่ใจว่าต้องใช้วีซ่าไหม? ตอบคำถาม 3 ข้อ เราจะบอกคุณ</p>
        </div>
      </div>

      <!-- Step 1: Country -->
      <div id="step-country" class="mb-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-brand-500 text-white text-xs font-bold flex items-center justify-center">1</span>
          <span class="text-base font-semibold text-gray-700">พาสปอร์ตของคุณ</span>
        </div>
        <div class="flex flex-wrap gap-2 mb-3 sm:justify-between">
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="US"><span class="mr-1">🇺🇸</span>United States</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="GB"><span class="mr-1">🇬🇧</span>United Kingdom</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="CA"><span class="mr-1">🇨🇦</span>Canada</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="AU"><span class="mr-1">🇦🇺</span>Australia</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="SG"><span class="mr-1">🇸🇬</span>Singapore</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="TH"><span class="mr-1">🇹🇭</span>Thailand</button>
          <button class="quick-country px-3 py-2 rounded-full border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-xs font-medium text-gray-700 cursor-pointer" data-code="KR"><span class="mr-1">🇰🇷</span>South Korea</button>
        </div>
        <div class="relative">
          <input id="country-input" type="text" placeholder="หรือค้นหาประเทศ..." class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-base">
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          <div id="country-dropdown" class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-xl shadow-lg max-h-60 overflow-y-auto"></div>
        </div>
        <p id="country-selected" class="hidden mt-2 text-base text-green-700 font-medium"></p>
      </div>

      <!-- Step 2: Purpose -->
      <div id="step-purpose" class="hidden mb-6">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-6 h-6 rounded-full bg-brand-500 text-white text-xs font-bold flex items-center justify-center">2</span>
          <span class="text-base font-semibold text-gray-700">วัตถุประสงค์ของการเยี่ยมชมคืออะไร?</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <button data-purpose="tourism-business" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">🏖️ ท่องเที่ยว / ธุรกิจ / ครอบครัว</div>
            <div class="text-xs text-gray-500 mt-0.5">การเยี่ยมชมทั่วไป</div>
          </button>
          <button data-purpose="work" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">💼 ทำงาน</div>
            <div class="text-xs text-gray-500 mt-0.5">ต้องมีผู้สนับสนุนนายจ้าง</div>
          </button>
          <button data-purpose="study" class="purpose-btn px-4 py-3 rounded-xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-200 transition text-left cursor-pointer">
            <div class="font-semibold text-gray-900 text-base">📚 เรียน</div>
            <div class="text-xs text-gray-500 mt-0.5">ต้องมีใบตอบรับจากมหาวิทยาลัย</div>
          </button>
        </div>
      </div>

      <!-- Result -->
      <div id="visa-result" class="hidden"></div>

      <!-- Reset -->
      <button id="reset-checker" class="hidden mt-4 text-base text-gray-400 hover:text-gray-600 underline cursor-pointer">เริ่มใหม่</button>

      <p class="text-xs text-gray-400 mt-4">อ้างอิงจากนโยบายทางการของ NIA อัปเดตล่าสุด: กรกฎาคม 2026 <span class="underline">ตรวจสอบกับสถานทูตก่อนจอง</span></p>
    </div>

    

<!-- Quick Stats -->
    <div class="grid grid-cols-2 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">5</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">วีซ่าและการเข้าเมือง</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">4</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">ก่อนออกเดินทาง</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">วีซ่าและการเข้าเมือง</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">5 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/visa/visa-guide/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📖 ภาพรวม</span>
            <p class="text-base font-bold text-gray-900 mt-1">คู่มือประเภทวีซ่าจีนครบถ้วน</p>
            <p class="text-sm text-gray-600 mt-0.5">อธิบายตัวเลือกวีซ่าทั้งหมด — เปรียบเทียบการยกเว้นวีซ่า การต่อเครื่อง และวีซ่า L</p>
          </a>
          <a href="/th/visa/visa-free/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📋 รายชื่อ</span>
            <p class="text-base font-bold text-gray-900 mt-1">รายชื่อประเทศที่ยกเว้นวีซ่าจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">50 ประเทศสามารถเข้าจีนโดยไม่ต้องใช้วีซ่าสูงสุด 30 วัน</p>
          </a>
          <a href="/th/visa/transit-240/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">✈️ การต่อเครื่อง</span>
            <p class="text-base font-bold text-gray-900 mt-1">การต่อเครื่องปลอดวีซ่า 240 ชั่วโมง</p>
            <p class="text-sm text-gray-600 mt-0.5">55 ประเทศที่มีสิทธิ์ — พักได้สูงสุด 10 วันโดยไม่ต้องใช้วีซ่า</p>
          </a>
          <a href="/th/visa/mutual-agreement/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🤝 ข้อตกลงร่วม</span>
            <p class="text-base font-bold text-gray-900 mt-1">ข้อตกลงยกเว้นวีซ่าร่วม</p>
            <p class="text-sm text-gray-600 mt-0.5">29 ประเทศมีข้อตกลงยกเว้นวีซ่าร่วมกับจีน</p>
          </a>
          <a href="/th/visa/apply-l-visa/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📝 การยื่นขอ</span>
            <p class="text-base font-bold text-gray-900 mt-1">วิธีขอวีซ่าท่องเที่ยวจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">คู่มือทีละขั้นตอน — เอกสาร แบบฟอร์ม COVA ค่าธรรมเนียม และเคล็ดลับ</p>
          </a>
        </div>
      </div>
      
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">ก่อนออกเดินทาง</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">4 บทความ</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/th/visa/customs-guide/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🛃 ข้อบังคับ</span>
            <p class="text-base font-bold text-gray-900 mt-1">ข้อบังคับศุลกากรจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">วงเงินปลอดภาษี สิ่งของต้องห้าม และสิ่งที่ต้องสำแดง</p>
          </a>
          <a href="/th/visa/arrival-card/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">📄 บัตรขาเข้า</span>
            <p class="text-base font-bold text-gray-900 mt-1">กรอกบัตรขาเข้าจีนออนไลน์</p>
            <p class="text-sm text-gray-600 mt-0.5">กรอกบัตรขาเข้า NIA ก่อนบิน — ทีละขั้นตอนพร้อมภาพประกอบ</p>
          </a>
          <a href="/th/life/survival-kit/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🎒 รายการตรวจสอบ</span>
            <p class="text-base font-bold text-gray-900 mt-1">ชุดเตรียมพร้อมเดินทางจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">รายการตรวจสอบก่อนออกเดินทางครบถ้วน — เอกสาร แอป และสิ่งที่ต้องแพ็ค</p>
          </a>
          <a href="/th/visa/first-time-china/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🌟 ครั้งแรก</span>
            <p class="text-base font-bold text-gray-900 mt-1">ครั้งแรกในจีน</p>
            <p class="text-sm text-gray-600 mt-0.5">ไทม์ไลน์ครบถ้วน — วีซ่า การตั้งค่าดิจิทัล การแพ็คกระเป๋า การเดินทางถึง 24 ชั่วโมงแรก</p>
          </a>
        </div>
      </div>
    </div>

    <!-- ขั้นตอนถัดไป -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">ขั้นตอนถัดไป</p>
            <h3 class="text-xl font-bold text-gray-900">ตั้งค่าการชำระเงินและเรียนรู้การเดินทาง</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">วีซ่าของคุณเรียบร้อยแล้ว ตั้งค่า Alipay และเรียนรู้วิธีใช้ระบบขนส่งของจีน</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/th/payment/payment-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              💳 คู่มือการชำระเงิน
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/th/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 คู่มือการเดินทาง
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
</section>

<script is:inline>
    const visaFree30 = ['BN','FR','DE','IT','ES','NL','CH','IE','HU','AT','BE','LU','NZ','AU','PL','PT','GR','CY','SI','SK','NO','FI','DK','IS','AD','MC','LI','KR','BG','RO','HR','ME','MK','MT','EE','LV','JP','BR','AR','CL','PE','UY','SA','OM','KW','BH','CA','RU','GB','SE'];
    const mutualFree = ['AL','AE','AG','BB','BS','BY','BA','DM','EC','FJ','GD','GE','KZ','QA','MV','MU','WS','RS','SC','SM','SR','SB','TH','TO','UZ','SG','AM','AZ','MY'];
    const transit240 = ['AL','AT','BE','BG','BA','BR','CA','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LT','LU','MT','MC','ME','NL','MK','NO','PL','PT','RO','RU','RS','SK','SI','KR','ES','SE','CH','UA','GB','US','AU','NZ','JP','SG','BN','AE','QA','MX','AR','CL','ID','BY'];

    const countryData = [
      {code:'AF',name:'Afghanistan',flag:'🇦🇫'},{code:'AL',name:'Albania',flag:'🇦🇱'},{code:'DZ',name:'Algeria',flag:'🇩🇿'},{code:'AD',name:'Andorra',flag:'🇦🇩'},
      {code:'AO',name:'Angola',flag:'🇦🇴'},{code:'AG',name:'Antigua and Barbuda',flag:'🇦🇬'},{code:'AR',name:'Argentina',flag:'🇦🇷'},{code:'AM',name:'Armenia',flag:'🇦🇲'},
      {code:'AU',name:'Australia',flag:'🇦🇺'},{code:'AT',name:'Austria',flag:'🇦🇹'},{code:'AZ',name:'Azerbaijan',flag:'🇦🇿'},{code:'BS',name:'Bahamas',flag:'🇧🇸'},
