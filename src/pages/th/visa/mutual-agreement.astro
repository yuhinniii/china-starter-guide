---
import Layout from '@layouts/Layout.astro';
const title = 'ข้อตกลงยกเว้นวีซ่าร่วม (29 ประเทศ) — China Starter Hub';
const description = 'คู่มือครบถ้วนเกี่ยวกับข้อตกลงยกเว้นวีซ่าร่วมของจีนกับ 29 ประเทศ — ระยะเวลาพัก ข้อกำหนดพาสปอร์ต และรายชื่อประเทศทั้งหมด';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าเตรียมการ
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">📋 การเข้าเมืองและวีซ่า</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        ข้อตกลงยกเว้นวีซ่าร่วม (29 ประเทศ)
      </h1>
      <p class="text-xl text-gray-600 mb-6">จีนได้ลงนามข้อตกลงยกเว้นวีซ่ากับ 29 ประเทศ — นี่คือความหมายสำหรับการเดินทางของคุณ</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 5 นาที</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-teal-50 to-emerald-50 border-l-4 border-teal-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-teal-900 mb-4">🎯 คำตอบด่วน</h2>
      <p class="text-lg text-teal-800 leading-relaxed">
        <strong>ใช่ — พลเมืองของ 29 ประเทศสามารถเข้าจีนโดยไม่ต้องใช้วีซ่าภายใต้ข้อตกลงร่วม</strong> แตกต่างจากนโยบายยกเว้นวีซ่าฝ่ายเดียวของจีน (ที่จีนเสนอเพียงฝ่ายเดียว) สิ่งเหล่านี้เป็นข้อตกลงทวิภาคีที่ทั้งสองประเทศตกลงยกเว้นข้อกำหนดวีซ่าสำหรับพลเมืองของกันและกัน ระยะเวลาพักตั้งแต่ <strong>30 ถึง 90 วัน</strong> ขึ้นอยู่กับข้อตกลง
      </p>
    </div>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        ด้านล่างคือ 29 ประเทศที่ได้ลงนามข้อตกลงยกเว้นวีซ่าร่วมกับจีน ที่มา: <a href="http://big5.www.gov.cn/gate/big5/www.gov.cn/yaowen/liebiao/202508/content_7035244.htm" class="text-brand-600 underline" target="_blank" rel="noopener">中国政府网</a>
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🌍</span> รายชื่อ 29 ประเทศทั้งหมด
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-4">
        พลเมืองที่ถือ<strong>พาสปอร์ตสามัญ</strong>จากประเทศเหล่านี้สามารถเข้าจีนโดยไม่ต้องใช้วีซ่าสำหรับการพักระยะสั้น:
      </p>

      <div class="bg-teal-50 border border-teal-200 rounded-2xl p-6 mb-8 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>🇦🇱 แอลเบเนีย</span>
          <span>🇦🇪 สหรัฐอาหรับเอมิเรตส์</span>
          <span>🇦🇬 แอนติกาและบาร์บูดา</span>
          <span>🇦🇲 อาร์เมเนีย</span>
          <span>🇦🇿 อาเซอร์ไบจาน</span>
          <span>🇧🇸 บาฮามาส</span>
          <span>🇧🇧 บาร์เบโดส</span>
          <span>🇧🇾 เบลารุส</span>
          <span>🇧🇦 บอสเนียและเฮอร์เซโกวีนา</span>
          <span>🇩🇲 โดมินิกา</span>
          <span>🇪🇨 เอกวาดอร์</span>
          <span>🇫🇯 ฟิจิ</span>
          <span>🇬🇪 จอร์เจีย</span>
          <span>🇬🇩 เกรเนดา</span>
          <span>🇰🇿 คาซัคสถาน</span>
          <span>🇲🇾 มาเลเซีย</span>
          <span>🇲🇻 มัลดีฟส์</span>
          <span>🇲🇺 มอริเชียส</span>
          <span>🇶🇦 กาตาร์</span>
          <span>🇼🇸 ซามัว</span>
          <span>🇸🇲 ซานมารีโน</span>
          <span>🇷🇸 เซอร์เบีย</span>
          <span>🇸🇨 เซเชลส์</span>
          <span>🇸🇬 สิงคโปร์</span>
          <span>🇸🇧 หมู่เกาะโซโลมอน</span>
          <span>🇸🇷 ซูรินาม</span>
          <span>🇹🇭 ไทย</span>
          <span>🇹🇴 ตองกา</span>
          <span>🇺🇿 อุซเบกิสถาน</span>
        </div>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">⏱️</span> คุณสามารถพักได้นานแค่ไหน?
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-4">
        ระยะเวลาพักแตกต่างกันไปตามข้อตกลง ข้อตกลงยกเว้นวีซ่าร่วมส่วนใหญ่อนุญาต <strong>30 วันต่อครั้ง</strong> แต่บางประเทศมีเงื่อนไขที่มากกว่า:
      </p>

      <div class="space-y-4 mb-8 not-prose">
        <div class="bg-white border border-gray-200 rounded-2xl p-5">
          <p class="font-semibold text-gray-900 mb-1">🇸🇬 สิงคโปร์ — สูงสุด 90 วันต่อครั้ง</p>
          <p class="text-sm text-gray-600">โดยมีเงื่อนไขว่าระยะเวลาพักสะสมในจีนต้องไม่เกิน 90 วันในระยะเวลา 180 วันใด ๆ นี่เป็นข้อตกลงยกเว้นวีซ่าร่วมที่มีเงื่อนไขมากที่สุดที่จีนมีอยู่ในปัจจุบัน</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-5">
          <p class="font-semibold text-gray-900 mb-1">🇦🇪 สหรัฐอาหรับเอมิเรตส์, 🇶🇦 กาตาร์, 🇧🇾 เบลารุส — สูงสุด 30 วันต่อครั้ง</p>
          <p class="text-sm text-gray-600">การพักปลอดวีซ่ามาตรฐาน 30 วัน สามารถต่ออายุได้ภายใต้เงื่อนไขบางประการ</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-5">
          <p class="font-semibold text-gray-900 mb-1">🇹🇭 ไทย, 🇲🇾 มาเลเซีย และส่วนใหญ่ — สูงสุด 30 วันต่อครั้ง</p>
          <p class="text-sm text-gray-600">การเข้าแบบไม่ต้องใช้วีซ่ามาตรฐาน 30 วันสำหรับการท่องเที่ยวและการเยี่ยมเยือนทางธุรกิจ</p>
        </div>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🛂</span> ฝ่ายเดียว vs ร่วม: ต่างกันอย่างไร?
      </h2>

      <div class="overflow-x-auto mb-8 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">การเปรียบเทียบประเทศที่มีข้อตกลงยกเว้นวีซาภาคเอกเทศ</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-5 py-3 font-bold"></th>
              <th class="px-5 py-3 font-bold text-center bg-green-600">ฝ่ายเดียว (50 ประเทศ)</th>
              <th class="px-5 py-3 font-bold text-center bg-teal-600">ร่วม (29 ประเทศ)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 font-semibold">ลักษณะ</td>
              <td class="px-5 py-3 text-center">จีนเสนอเพียงฝ่ายเดียว</td>
              <td class="px-5 py-3 text-center">ข้อตกลงทวิภาคี</td>
            </tr>
            <tr class="border-b border-gray-100 bg-gray-50">
              <td class="px-5 py-3 font-semibold">พักสูงสุด</td>
              <td class="px-5 py-3 text-center">30 วัน</td>
              <td class="px-5 py-3 text-center">30–90 วัน (แตกต่าง)</td>
            </tr>
            <tr class="border-b border-gray-100">
              <td class="px-5 py-3 font-semibold">ตอบแทน?</td>
              <td class="px-5 py-3 text-center">ไม่ — จีนเท่านั้น</td>
              <td class="px-5 py-3 text-center">ใช่ — ทั้งสองฝ่าย</td>
            </tr>
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">❓</span> คำถามที่พบบ่อย
      </h2>

      <div class="space-y-6 mb-8 not-prose">
        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">ฉันสามารถต่ออายุการพักเกินระยะเวลายกเว้นวีซ่าได้หรือไม่?</h3>
          <p class="text-gray-700 leading-relaxed">ในกรณีส่วนใหญ่ ไม่ได้ คุณต้องออกจากจีนก่อนที่ระยะเวลาพักที่อนุญาตจะหมดอายุ หากต้องการเวลามากขึ้น ทางเลือกที่ดีที่สุดคือออกและเข้าใหม่ (เช่น การเดินทางระยะสั้นไปฮ่องกงหรือมาเก๊า)</p>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">กฎ 90/180 ใช้กับประเทศที่มีข้อตกลงร่วมทั้งหมดหรือไม่?</h3>
          <p class="text-gray-700 leading-relaxed">ไม่ "90 วันในระยะเวลา 180 วัน" ใช้กับสิงคโปร์โดยเฉพาะ ประเทศอื่นมีเงื่อนไขของตนเอง — ส่วนใหญ่อนุญาต 30 วันต่อครั้ง ตรวจสอบข้อตกลงเฉพาะของประเทศคุณเสมอ</p>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">ประเทศของฉันอยู่ในทั้งสองรายการ — ใช้กฎไหน?</h3>
          <p class="text-gray-700 leading-relaxed">หากประเทศของคุณอยู่ในทั้งรายชื่อยกเว้นวีซ่าฝ่ายเดียว (50 ประเทศ) และรายชื่อข้อตกลงร่วม (29 ประเทศ) ให้ใช้เงื่อนไขที่ได้เปรียบกว่า ตัวอย่างเช่น สิงคโปร์อยู่ในทั้งสองรายการ แต่ข้อตกลงร่วมให้การพักที่ยาวกว่า — ดังนั้นคุณควรใช้เงื่อนไขของข้อตกลงร่วม</p>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">ฉันต้องใช้เอกสารอะไรบ้างที่ด่านตรวจคนเข้าเมือง?</h3>
          <p class="text-gray-700 leading-relaxed">พาสปอร์ตสามัญที่ยังมีอายุ (อายุเหลืออย่างน้อย 6 เดือน) ตั๋วไปกลับหรือตั๋วเดินทางต่อไป และหลักฐานที่พัก เจ้าหน้าที่ตรวจคนเข้าเมืองอาจถามเกี่ยวกับแผนการเดินทางของคุณ ดังนั้นการมีแผนการเดินทางคร่าว ๆ จะเป็นประโยชน์</p>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-100 pt-6 mt-8">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-xl p-5 not-prose">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <h3 class="text-sm font-bold text-gray-900">📚 อ่านต่อ</h3>
          <div class="flex flex-wrap gap-2">
            <a href="/th/visa/visa-guide/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              คู่มือประเภทวีซ่าจีนครบถ้วน
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/th/visa/visa-free/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              รายชื่อประเทศที่ยกเว้นวีซ่าจีน
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/th/visa/transit-240/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              อธิบายการต่อเครื่องปลอดวีซ่า 240 ชั่วโมง
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/th/visa/apply-l-visa/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              วิธีขอวีซ่าท่องเที่ยวจีน (ประเภท L)
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  
<!-- FAQPage Schema -->
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is a mutual visa-free agreement?", "acceptedAnswer": {"@type": "Answer", "text": "A mutual visa-free agreement is a bilateral deal between China and another country. Citizens of both countries can enter the other without a visa for short stays, typically 30-90 days depending on the agreement."}}, {"@type": "Question", "name": "How is mutual agreement different from 30-day visa-free?", "acceptedAnswer": {"@type": "Answer", "text": "The 30-day visa-free policy is unilateral (China grants it to 50 countries on its own). Mutual agreements are reciprocal and may have different duration limits. Some mutual agreements allow up to 90 days."}}, {"@type": "Question", "name": "Do I need to register with police if entering under mutual agreement?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. All foreigners entering China under any visa-free policy must register with local police within 24 hours. Hotels do this automatically; private accommodation hosts must do it."}}, {"@type": "Question", "name": "Can I work or study under a mutual visa-free agreement?", "acceptedAnswer": {"@type": "Answer", "text": "No. Mutual visa-free agreements only cover tourism, business visits, and short-term family visits. Work and study always require the appropriate visa (Z or X)."}}]}
</script>
</article>
</Layout>
