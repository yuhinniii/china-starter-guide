---
import Layout from '@layouts/Layout.astro';
const title = 'อธิบายการต่อเครื่องปลอดวีซ่า 240 ชั่วโมงของจีน (2026) — China Starter Hub';
const description = 'ทุกสิ่งที่คุณต้องรู้เกี่ยวกับนโยบายการต่อเครื่องปลอดวีซ่า 240 ชั่วโมงของจีน';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าเตรียมการ
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">📋 การเข้าเมืองและวีซ่า</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        อธิบายการต่อเครื่องปลอดวีซ่า 240 ชั่วโมงของจีน
      </h1>
      <p class="text-xl text-gray-600 mb-6">คุณสามารถเยือนจีนได้สูงสุด 10 วันโดยไม่ต้องใช้วีซ่าหรือไม่?</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 7 นาที</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 คำตอบด่วน</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        <strong>ได้ — ในหลายกรณี</strong> นโยบายการต่อเครื่องปลอดวีซ่า 240 ชั่วโมงของจีนช่วยให้นักเดินทางที่มีสิทธิ์พักในภูมิภาคที่กำหนดได้สูงสุด 10 วันขณะเดินทางต่อไปยังประเทศหรือภูมิภาคที่สาม คุณต้องมีพาสปอร์ตจาก 55 ประเทศที่มีสิทธิ์และตั๋วเดินทางต่อไปที่ยืนยันแล้ว
      </p>
    </div>

    <!-- Table of Contents -->
    <nav class="bg-gray-50 rounded-2xl p-8 mb-12 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-4">📋 ในคู่มือนี้</h3>
      <ul class="space-y-3">
        <li><a href="#requirements" class="text-blue-600 hover:underline">✅ คุณต้องปฏิบัติตามข้อกำหนดทั้งหมดนี้</a></li>
        <li><a href="#routes" class="text-blue-600 hover:underline">🔄 เส้นทางที่เข้าเงื่อนไข vs ไม่เข้าเงื่อนไข</a></li>
        <li><a href="#countries" class="text-blue-600 hover:underline">🌍 ประเทศใดบ้างที่มีสิทธิ์?</a></li>
        <li><a href="#ports" class="text-blue-600 hover:underline">✈️ คุณสามารถเข้าและออกจากจีนที่ไหนได้บ้าง?</a></li>
        <li><a href="#documents" class="text-blue-600 hover:underline">📄 คุณต้องใช้เอกสารอะไรบ้าง?</a></li>
      </ul>
    </nav>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">
      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        <strong>ได้ — ในหลายกรณี</strong>
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        นโยบายการต่อเครื่องปลอดวีซ่า 240 ชั่วโมงของจีนช่วยให้นักเดินทางที่มีสิทธิ์พักในภูมิภาคที่กำหนดของจีนได้สูงสุด 10 วันขณะเดินทางต่อไปยังประเทศหรือภูมิภาคที่สาม สำหรับผู้มาเยือนหลายคน นี่เป็นวิธีที่ง่ายที่สุดวิธีหนึ่งในการเยือนจีนโดยไม่ต้องยื่นขอวีซ่าแบบดั้งเดิม
      </p>

      <hr class="border-gray-200 my-12" />

      <h2 id="requirements" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">✅</span> คุณต้องปฏิบัติตามข้อกำหนดทั้งหมดนี้
      </h2>

      <div class="space-y-4 mb-8 not-prose">
        <div class="flex items-start gap-3 p-5 bg-green-50 border border-green-200 rounded-xl">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-green-200 text-green-700 text-sm flex items-center justify-center font-bold">✓</span>
          <div>
            <p class="font-medium text-gray-900">พาสปอร์ตสามัญที่ยังมีอายุ</p>
            <p class="text-sm text-gray-600">จาก 55 ประเทศที่มีสิทธิ์ พาสปอร์ตต้องมีอายุเหลืออย่างน้อย 3 เดือนนับจากวันเดินทางถึง</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-5 bg-blue-50 border border-blue-200 rounded-xl">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-200 text-blue-700 text-sm flex items-center justify-center font-bold">✓</span>
          <div>
            <p class="font-medium text-gray-900">แผนการเดินทางที่เข้าเงื่อนไข</p>
            <p class="text-sm text-gray-600">ประเทศ A → จีนแผ่นดินใหญ่ → ประเทศ/ภูมิภาคที่แตกต่าง (คุณไม่สามารถบินกลับประเทศต้นทางโดยตรง)</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-5 bg-purple-50 border border-purple-200 rounded-xl">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-purple-200 text-purple-700 text-sm flex items-center justify-center font-bold">✓</span>
          <div>
            <p class="font-medium text-gray-900">ตั๋วเดินทางต่อไปที่ยืนยันแล้ว</p>
            <p class="text-sm text-gray-600">วันที่ออกเดินทางและที่นั่งที่แน่นอน ออกเดินทางภายใน 240 ชั่วโมง</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-5 bg-orange-50 border border-orange-200 rounded-xl">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-orange-200 text-orange-700 text-sm flex items-center justify-center font-bold">✓</span>
          <div>
            <p class="font-medium text-gray-900">ด่านเข้า/ออกที่ได้รับการอนุมัติ</p>
            <p class="text-sm text-gray-600">เข้าและออกผ่านด่านต่อเครื่องที่ได้รับการอนุมัติอย่างเป็นทางการภายในเวลาที่กำหนด</p>
          </div>
        </div>
      </div>

      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-8 not-prose">
        <p class="text-yellow-900 m-0"><strong>สำคัญ:</strong> นี่เป็นนโยบายการต่อเครื่องอย่างเคร่งครัด ไม่ใช่การเข้าแบบไม่ต้องใช้วีซ่าสำหรับนักท่องเที่ยวทั่วไป</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="routes" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🔄</span> เส้นทางที่เข้าเงื่อนไข vs ไม่เข้าเงื่อนไข
      </h2>

      <div class="grid md:grid-cols-2 gap-4 mb-8 not-prose">
        <div class="bg-green-50 border border-green-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-green-700 mb-3">✅ เข้าเงื่อนไข (การต่อเครื่องที่ถูกต้อง)</p>
          <ul class="space-y-1 text-sm text-gray-700 pl-4 list-disc">
            <li>สหราชอาณาจักร → เซี่ยงไฮ้ → ญี่ปุ่น</li>
            <li>สหรัฐอเมริกา → ปักกิ่ง → เกาหลีใต้</li>
            <li>ออสเตรเลีย → กวางโจว → ไทย</li>
          </ul>
        </div>
        <div class="bg-red-50 border border-red-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-red-600 mb-3">❌ ไม่เข้าเงื่อนไข (ไป-กลับ)</p>
          <ul class="space-y-1 text-sm text-gray-700 pl-4 list-disc">
            <li>สหราชอาณาจักร → เซี่ยงไฮ้ → สหราชอาณาจักร</li>
            <li>สหรัฐอเมริกา → ปักกิ่ง → สหรัฐอเมริกา</li>
            <li>ญี่ปุ่น → เซี่ยงไฮ้ → ญี่ปุ่น</li>
          </ul>
        </div>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🏛️</span> ฮ่องกง/มาเก๊า/ไต้หวันนับเป็นภูมิภาคที่สามหรือไม่?
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        <strong>ได้</strong> ตามกฎการตรวจคนเข้าเมืองอย่างเป็นทางการ ฮ่องกง มาเก๊า และไต้หวัน ถือเป็นจุดหมายปลายทางที่สามที่แยกต่างหากสำหรับการเข้าเงื่อนไขการต่อเครื่อง
      </p>

      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-5 mb-8 not-prose">
        <p class="text-gray-700"><strong>ตัวอย่าง:</strong> สหราชอาณาจักร → เซี่ยงไฮ้ → ฮ่องกง = แผนการต่อเครื่องที่ถูกต้อง</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">⏱️</span> คุณสามารถพักได้นานแค่ไหน?
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-2">
        <strong>พักสูงสุด:</strong> 240 ชั่วโมง (10 วัน)
      </p>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        <strong>เวลาเริ่มนับเมื่อไหร่?</strong> การนับเริ่มเวลา 00:00 น. เที่ยงคืนของวันตามปฏิทินหลังจากวันที่คุณเข้า (เวลาจีน GMT+8) — ไม่ใช่เวลาที่เครื่องบินของคุณลงจอดจริง
      </p>

      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-8 not-prose">
        <p class="text-yellow-900"><strong>เคล็ดลับ:</strong> หากคุณมาถึงช่วงค่ำ คุณจะได้เวลาเพิ่มเติมนอกเหนือจาก 10 วันตามปฏิทินเต็ม</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="countries" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🌍</span> ประเทศใดบ้างที่มีสิทธิ์?
      </h2>

      <p class="text-gray-700 mb-6">ทั้งหมด: <strong>55 ประเทศ</strong></p>

      <div class="space-y-4 mb-8 not-prose">
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-blue-800 mb-2">ยุโรป (40 ประเทศ)</p>
          <p class="text-sm text-gray-600">แอลเบเนีย, ออสเตรีย, เบลารุส, เบลเยียม, บอสเนียและเฮอร์เซโกวีนา, บัลแกเรีย, โครเอเชีย, ไซปรัส, สาธารณรัฐเช็ก, เดนมาร์ก, เอสโตเนีย, ฟินแลนด์, ฝรั่งเศส, เยอรมนี, กรีซ, ฮังการี, ไอซ์แลนด์, ไอร์แลนด์, อิตาลี, ลัตเวีย, ลิทัวเนีย, ลักเซมเบิร์ก, มอลตา, โมนาโก, มอนเตเนโกร, เนเธอร์แลนด์, นอร์ทมาซิโดเนีย, นอร์เวย์, โปแลนด์, โปรตุเกส, โรมาเนีย, รัสเซีย, เซอร์เบีย, สโลวาเกีย, สโลวีเนีย, สเปน, สวีเดน, สวิตเซอร์แลนด์, ยูเครน, สหราชอาณาจักร</p>
        </div>
        <div class="bg-green-50 border border-green-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-green-800 mb-2">อเมริกาเหนือ (3 ประเทศ)</p>
          <p class="text-sm text-gray-600">แคนาดา, เม็กซิโก, สหรัฐอเมริกา</p>
        </div>
        <div class="bg-orange-50 border border-orange-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-orange-800 mb-2">อเมริกาใต้ (3 ประเทศ)</p>
          <p class="text-sm text-gray-600">อาร์เจนตินา, บราซิล, ชิลี</p>
        </div>
        <div class="bg-purple-50 border border-purple-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-purple-800 mb-2">โอเชียเนีย (2 ประเทศ)</p>
          <p class="text-sm text-gray-600">ออสเตรเลีย, นิวซีแลนด์</p>
        </div>
        <div class="bg-teal-50 border border-teal-200 rounded-2xl p-5">
          <p class="text-sm font-semibold text-teal-800 mb-2">เอเชีย (7 ประเทศ)</p>
          <p class="text-sm text-gray-600">บรูไน, อินโดนีเซีย, ญี่ปุ่น, กาตาร์, สิงคโปร์, เกาหลีใต้, สหรัฐอาหรับเอมิเรตส์</p>
        </div>
      </div>

      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-8 not-prose">
        <p class="text-yellow-900"><strong>หมายเหตุ:</strong> รายชื่อประเทศมีการอัปเดตเป็นครั้งคราว ตรวจสอบข้อมูลล่าสุดจากแหล่งข้อมูลทางการของรัฐบาลก่อนจองตั๋วเครื่องบินเสมอ</p>
      </div>

      <hr class="border-gray-200 my-12" />

      <h2 id="ports" class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">✈️</span> คุณสามารถเข้าและออกจากจีนที่ไหนได้บ้าง?
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        คุณสามารถเข้าและออกผ่าน <strong>65 ด่านที่กำหนด</strong> ใน <strong>24 จังหวัด (รวมถึงเทศบาลและเขตปกครองตนเอง)</strong> การเดินทางข้ามจังหวัด <strong>อนุญาต</strong> — คุณสามารถเข้าผ่านเซี่ยงไฮ้ นั่งรถไฟความเร็วสูงไปปักกิ่ง และบินกลับบ้านจากปักกิ่ง แผนการเดินทางทั้งหมดต้องอยู่ใน 24 จังหวัด/ภูมิภาคที่กำหนด
      </p>

      <div class="overflow-x-auto mb-8 not-prose">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-sm text-sm">
<caption class="text-sm text-gray-500 italic mb-2 text-center">การเปรียบเทียบนโยบายการผ่านทางโดยไม่ต้องใช้วีซ่า (TWOV)</caption>
          <thead>
            <tr class="bg-gray-900 text-white">
              <th class="px-4 py-3 font-bold">จังหวัด/เมือง</th>
              <th class="px-4 py-3 font-bold">ด่านสำคัญ</th>
              <th class="px-4 py-3 font-bold">พื้นที่พัก</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">ปักกิ่ง</td><td class="px-4 py-2">首都国际机场(PEK), 大兴国际机场(PKX)</td><td class="px-4 py-2">ปักกิ่ง</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">เซี่ยงไฮ้</td><td class="px-4 py-2">浦东(PVG), 虹桥(SHA), 海港口岸</td><td class="px-4 py-2">เซี่ยงไฮ้</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">กวางตุ้ง</td><td class="px-4 py-2">广州(CAN), 深圳(SZX), 揭阳(SWA) + 海港</td><td class="px-4 py-2">มณฑลกวางตุ้ง</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">เจียงซู</td><td class="px-4 py-2">南京(NKG), 无锡(WUX), 扬州(YTY), 连云港海港</td><td class="px-4 py-2">เจียงซู</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">เจ้อเจียง</td><td class="px-4 py-2">杭州(HGH), 宁波(NGB), 温州(WNZ) ฯลฯ</td><td class="px-4 py-2">เจ้อเจียง</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">เสฉวน</td><td class="px-4 py-2">成都双流(CTU), 成都天府(TFU)</td><td class="px-4 py-2">เฉิงตู + 10 เมืองอื่น ๆ</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">ยูนนาน</td><td class="px-4 py-2">昆明(KMG)</td><td class="px-4 py-2">คุนหมิง + 8 เมือง/จังหวัด</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">กวางสี</td><td class="px-4 py-2">南宁(NNG), 桂林(KWL), 北海(BHY)</td><td class="px-4 py-2">หนานหนิง + 11 เมืองอื่น ๆ</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">ฝูเจี้ยน</td><td class="px-4 py-2">福州(FOC), 厦门(XMN), 泉州(JJN)</td><td class="px-4 py-2">ฝูเจี้ยน</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">ไหหลำ</td><td class="px-4 py-2">海口(HAK), 三亚(SYX)</td><td class="px-4 py-2">เกาะไหหลำ</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">ส่านซี</td><td class="px-4 py-2">西安(XIY)</td><td class="px-4 py-2">ส่านซี</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">ฉงชิ่ง</td><td class="px-4 py-2">重庆(CKG)</td><td class="px-4 py-2">ฉงชิ่ง</td></tr>
            <tr class="border-b border-gray-100"><td class="px-4 py-2 font-semibold">เทียนจิน</td><td class="px-4 py-2">天津(TSN), 天津海港</td><td class="px-4 py-2">เทียนจิน</td></tr>
            <tr class="border-b border-gray-100 bg-gray-50"><td class="px-4 py-2 font-semibold">+ อีก 11 จังหวัด</td><td class="px-4 py-2" colspan="2">เหอเป่ย, เหลียวหนิง, ซานตง, เหอหนาน, หูเป่ย, หูหนาน, อานฮุย, กุ้ยโจว, ซานซี, เฮยหลงเจียง, เจียงซี — แต่ละแห่งมีสนามบิน/ท่าเรือที่กำหนด</td></tr>
          </tbody>
        </table>
      </div>

      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-5 rounded-r-xl mb-8 not-prose">
        <p class="text-yellow-900"><strong>สำคัญ:</strong> คุณสามารถเดินทางได้อย่างอิสระภายใน 24 จังหวัด/ภูมิภาคที่กำหนดระหว่างการพัก 240 ชั่วโมง ตัวอย่างเช่น บินเข้าเซี่ยงไฮ้ นั่งรถไฟความเร็วสูงไปปักกิ่ง และบินกลับบ้านจากปักกิ่ง — ทั้งหมดนี้ทำได้ตราบใดที่คุณออกจากจีนภายใน 10 วัน กฎสำคัญคือคุณต้องออกจากจีนภายใน 240 ชั่วโมง สถานที่เข้าและออกสามารถเป็นด่านต่างกันได้</p>
