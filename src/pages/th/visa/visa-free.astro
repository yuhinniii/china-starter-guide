---
import Layout from '@layouts/Layout.astro';
const title = 'รายชื่อประเทศที่ยกเว้นวีซ่าจีน (2026) — China Starter Hub';
const description = 'รายชื่อประเทศที่มีสิทธิ์เข้าเมืองจีนโดยไม่ต้องใช้วีซ่าอย่างเป็นทางการ — ฝ่ายเดียว (50 ประเทศ) และข้อตกลงร่วม (29 ประเทศ)';
---

<Layout title={title} description={description} lang="th">
  <article class="max-w-4xl mx-auto px-6 py-12">
    <nav class="mb-8 not-prose">
      <a href="/th/visa/" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition no-underline group">
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        กลับไปหน้าเตรียมการ
      </a>
    </nav>
    <!-- Header -->
    <header class="mb-12">
      <p class="text-sm text-gray-500 mb-3">📋 การเข้าเมืองและวีซ่า</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4 leading-tight">
        รายชื่อประเทศที่ยกเว้นวีซ่าจีน (2026)
      </h1>
      <p class="text-xl text-gray-600 mb-6">ตรวจสอบว่าประเทศของคุณมีสิทธิ์เข้าเมืองจีนโดยไม่ต้องใช้วีซ่าหรือไม่</p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>📅 อัปเดตล่าสุด: มิถุนายน 2026</span>
        <span>⏱️ 5 นาที</span>
      </div>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 rounded-r-2xl p-8 mb-12 not-prose">
      <h2 class="text-2xl font-bold text-green-900 mb-4">🎯 คำตอบด่วน</h2>
      <p class="text-lg text-green-800 leading-relaxed">
        <strong>มีสองวิธีในการเข้าจีนโดยไม่ต้องใช้วีซ่า:</strong> จีนเสนอการยกเว้นวีซ่าฝ่ายเดียวแก่พลเมืองของ <strong>50 ประเทศ</strong> (สูงสุด 30 วัน) และมีข้อตกลงยกเว้นวีซ่าร่วมกับ <strong>29 ประเทศ</strong> หากประเทศของคุณไม่อยู่ในรายชื่อใด ให้ตรวจสอบนโยบายการต่อเครื่อง 240 ชั่วโมงหรือยื่นขอวีซ่า L
      </p>
    </div>

    <!-- Main Content -->
    <div class="prose prose-lg max-w-none">

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        ด้านล่างนี้คือรายชื่อทั้งหมดตามข้อมูลล่าสุดจากรัฐบาลจีน (2025) ที่มา: <a href="http://big5.www.gov.cn/gate/big5/www.gov.cn/yaowen/liebiao/202508/content_7035244.htm" class="text-brand-600 underline" target="_blank" rel="noopener">中国政府网</a>
      </p>

      <hr class="border-gray-200 my-12" />

      <!-- Section 1: Unilateral -->
      <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
        <span class="text-4xl">🟢</span> ยกเว้นวีซ่าฝ่ายเดียว (50 ประเทศ)
      </h2>

      <p class="text-lg leading-relaxed text-gray-700 mb-6">
        พลเมืองของประเทศเหล่านี้สามารถเข้าจีน<strong>โดยไม่ต้องใช้วีซ่า</strong>สูงสุด <strong>30 วัน</strong> ไม่ต้องยื่นขอล่วงหน้า
      </p>

      <div class="bg-green-50 border border-green-200 rounded-2xl p-6 mb-8 not-prose">
        <p class="text-gray-700 mb-4 font-medium">ใช้สำหรับ: ท่องเที่ยว ธุรกิจ เยี่ยมครอบครัว ต่อเครื่อง แลกเปลี่ยนวัฒนธรรม สูงสุด 30 วัน</p>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">ยุโรป (35)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>ฝรั่งเศส</span><span>เยอรมนี</span><span>อิตาลี</span>
          <span>เนเธอร์แลนด์</span><span>สเปน</span><span>สวิตเซอร์แลนด์</span>
          <span>ไอร์แลนด์</span><span>ฮังการี</span><span>ออสเตรีย</span>
          <span>เบลเยียม</span><span>ลักเซมเบิร์ก</span><span>โปแลนด์</span>
          <span>โปรตุเกส</span><span>กรีซ</span><span>ไซปรัส</span>
          <span>สโลวีเนีย</span><span>สโลวาเกีย</span><span>นอร์เวย์</span>
          <span>ฟินแลนด์</span><span>เดนมาร์ก</span><span>ไอซ์แลนด์</span>
          <span>อันดอร์รา</span><span>โมนาโก</span><span>ลิกเตนสไตน์</span>
          <span>บัลแกเรีย</span><span>โรมาเนีย</span><span>โครเอเชีย</span>
          <span>มอนเตเนโกร</span><span>นอร์ทมาซิโดเนีย</span><span>มอลตา</span>
          <span>เอสโตเนีย</span><span>ลัตเวีย</span><span>รัสเซีย</span>
          <span>สวีเดน</span><span>สหราชอาณาจักร</span>
        </div>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">เอเชีย (7)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>บรูไน</span><span>เกาหลีใต้</span><span>ญี่ปุ่น</span>
          <span>ซาอุดีอาระเบีย</span><span>โอมาน</span><span>คูเวต</span>
          <span>บาห์เรน</span>
        </div>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">อเมริกา (6)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-6 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>บราซิล</span><span>อาร์เจนตินา</span><span>ชิลี</span>
          <span>เปรู</span><span>อุรุกวัย</span><span>แคนาดา</span>
        </div>
      </div>

      <h3 class="text-xl font-bold text-gray-800 mb-4">โอเชียเนีย (2)</h3>
      <div class="bg-white border border-gray-200 rounded-2xl p-6 mb-8 not-prose">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-gray-700">
          <span>ออสเตรเลีย</span><span>นิวซีแลนด์</span>
        </div>
      </div>

    </div>

    <!-- Not sure which one applies to you? -->
    <div class="bg-gray-50 rounded-2xl p-6 not-prose mt-8 mb-12">
      <h3 class="text-lg font-bold text-gray-900 mb-4">🤔 ไม่แน่ใจว่านโยบายใดใช้กับประเทศของคุณ?</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/th/visa/transit-240/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">✈️ การต่อเครื่องปลอดวีซ่า 240 ชั่วโมง</p>
          <p class="text-sm text-gray-500">สูงสุด 10 วันในภูมิภาคที่กำหนด — ครอบคลุม 55 ประเทศรวมถึงสหรัฐอเมริกา</p>
        </a>
        <a href="/th/visa/mutual-agreement/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">🤝 ข้อตกลงยกเว้นวีซ่าร่วม</p>
          <p class="text-sm text-gray-500">29 ประเทศที่มีข้อตกลงยกเว้นวีซ่าทวิภาคี — ระยะเวลาพักแตกต่างกัน</p>
        </a>
        <a href="/th/visa/apply-l-visa/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">📝 ยื่นขอวีซ่าท่องเที่ยว L</p>
          <p class="text-sm text-gray-500">หากประเทศของคุณไม่อยู่ในรายชื่อยกเว้นวีซ่า ให้ยื่นขอวีซ่าท่องเที่ยวมาตรฐาน</p>
        </a>
        <a href="/th/cities/hainan-visa-free/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">🏝️ ไหหลำยกเว้นวีซ่า 30 วัน</p>
          <p class="text-sm text-gray-500">59 ประเทศมีสิทธิ์ — รวมถึงสหรัฐอเมริกา เม็กซิโก ฟิลิปปินส์ และอื่น ๆ ที่ไม่อยู่ในรายชื่อแผ่นดินใหญ่</p>
        </a>
      </div>
    </div>

    <div class="not-prose mt-12 pt-8 border-t border-gray-200">
  <h3 class="text-base font-bold text-gray-900 mb-4 flex items-center gap-2">📚 แหล่งอ้างอิง</h3>
  <ul class="space-y-2">
    <li>
      <a href="https://en.nia.gov.cn/n147418/n147463/c183390/content.html" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
        <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        สำนักงานตรวจคนเข้าเมืองแห่งชาติ — รายชื่อประเทศที่ได้รับยกเว้นวีซ่าฝ่ายเดียว
        <svg class="w-3 h-3 text-gray-300 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </li>
    <li>
      <a href="https://www.gov.cn/yaowen/liebiao/202508/content_7035244.htm" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
        <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        gov.cn — ประเทศใดบ้างที่สามารถเยือนจีนโดยไม่ต้องใช้วีซ่า? รายชื่อครบถ้วน!
        <svg class="w-3 h-3 text-gray-300 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </li>
    <li>
      <a href="https://cs.mfa.gov.cn/wgrlh/lhqz/lhqzjjs/202510/t20251023_11739051.shtml" target="_blank" rel="noopener" class="group flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline">
        <svg class="w-3 h-3 text-gray-400 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        กระทรวงการต่างประเทศ — ข้อตกลงยกเว้นวีซ่าร่วม
        <svg class="w-3 h-3 text-gray-300 group-hover:text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </li>
  </ul>
</div>

    <div class="border-t border-gray-100 pt-6 mt-8">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-xl p-5 not-prose">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <h3 class="text-sm font-bold text-gray-900">📚 อ่านต่อ</h3>
          <div class="flex flex-wrap gap-2">
            <a href="/th/visa/visa-guide/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              คู่มือประเภทวีซ่าจีนครบถ้วน
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/th/visa/transit-240/" class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              อธิบายการต่อเครื่องปลอดวีซ่า 240 ชั่วโมง
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>
