---
import Layout from '@layouts/Layout.astro';
const title = '来中国必备 App';
const description = '在中国真正用得上的 App 清单，附非中文用户设置指南。';
---

<Layout title={title} description={description} lang="zh">
  <article class="max-w-3xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">实用工具</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">必备 App</h1>
      <p class="text-gray-500  ">在中国真正用得上的 App。</p>
    </header>
    <div class="prose prose-gray  ">
      <div class="bg-amber-50  :border-amber-900 rounded-xl p-4 mb-8">
        <p class="text-amber-800  ">
          <strong>说明：</strong>详细 App 使用指南即将上线。
        </p>
      </div>
      <h2>必备 App 清单</h2>
      <ul>
        <li><strong>微信</strong> — 聊天、支付、啥都能干</li>
        <li><strong>支付宝</strong> — 支付和各种生活服务</li>
        <li><strong>滴滴</strong> — 打车</li>
        <li><strong>高德地图 / 百度地图</strong> — 导航（Google Maps 在国内不好用）</li>
        <li><strong>美团</strong> — 点外卖</li>
        <li><strong>大众点评</strong> — 找餐馆</li>
      </ul>
    </div>
  </article>
</Layout>
