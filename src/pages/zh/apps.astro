---
import Layout from '../../layouts/Layout.astro';
const title = '必备APP — 在华实用软件';
const description = '在中国真正需要的APP，附非中文用户设置教程。';
---

<Layout title={title} description={description} lang="zh">
  <article class="max-w-3xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">分类</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">必备APP</h1>
      <p class="text-gray-500 dark:text-gray-400">在中国真正需要的APP。</p>
    </header>
    <div class="prose prose-gray dark:prose-invert max-w-none">
      <div class="bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900 rounded-xl p-4 mb-8">
        <p class="text-amber-800 dark:text-amber-200 text-sm m-0">
          <strong>提示：</strong>详细APP指南即将上线。
        </p>
      </div>
      <h2>必装软件</h2>
      <ul>
        <li><strong>微信</strong> — 聊天、支付、一切</li>
        <li><strong>支付宝</strong> — 支付和服务</li>
        <li><strong>滴滴</strong> — 打车</li>
        <li><strong>高德/百度地图</strong> — 导航（Google 地图不好用）</li>
        <li><strong>美团</strong> — 外卖</li>
        <li><strong>大众点评</strong> — 餐厅评价</li>
      </ul>
    </div>
  </article>
</Layout>
