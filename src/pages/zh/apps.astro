---
import Layout from '@layouts/Layout.astro';
const title = '中国必备应用';
const description = '你在中国实际需要的应用程序——为非中文使用者提供设置指南。';
---

<Layout title={title} description={description} lang="zh">
  <article class="max-w-3xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">类别</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900">必备应用</h1>
      <p class="text-gray-500">你在中国实际需要的应用程序。</p>
    </header>
    <div class="prose prose-gray">
      <div class="bg-amber-50 rounded-xl p-4 mb-8">
        <p class="text-amber-800">
          <strong>注：</strong>详细的应用指南即将推出。
        </p>
      </div>
      <h2>必备应用清单</h2>
      <ul>
        <li><strong>微信 (WeChat)</strong> — 通讯、支付、一站式服务</li>
        <li><strong>支付宝 (Alipay)</strong> — 支付和生活服务</li>
        <li><strong>滴滴 (Didi)</strong> — 叫车出行</li>
        <li><strong>高德地图 / 百度地图</strong> — 导航（谷歌地图不太好用）</li>
        <li><strong>美团</strong> — 外卖和本地生活</li>
        <li><strong>大众点评</strong> — 餐厅评价和推荐</li>
      </ul>
    </div>
  </article>
</Layout>
