---
import Layout from '@layouts/Layout.astro';
const title = '字体中等纹理-900m-0';
const description = '你在中国实际需要的应用程序——为非中文使用者提供设置指南。';
---

<Layout title={title} description={description} lang="zh">
  <article class="max-w-3xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">类别</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">基本应用程序</h1>
      <p class="text-gray-500  ">你在中国真正需要的应用程序。</p>
    </header>
    <div class="prose prose-gray  ">
      <div class="bg-amber-50  :border-amber-900 rounded-xl p-4 mb-8">
        <p class="text-amber-800  ">
          <strong>注：</strong> Detailed app guides coming soon.
        </p>
      </div>
      <h2>必备应用程序</h2>
      <ul>
        <li><strong>微信</strong> — Messaging, payments, everything</li>
        <li><strong>支付宝</strong> — Payments and services</li>
        <li><strong>滴滴</strong> — Ride hailing</li>
        <li><strong>Amap/百度地图</strong> — Navigation (Google Maps doesn't work well)</li>
        <li><strong>Meituan</strong> — Food delivery</li>
        <li><strong>Dianping</strong> — Restaurant reviews</li>
      </ul>
    </div>
  </article>
</Layout>
