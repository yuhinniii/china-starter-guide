---
import Layout from '@layouts/Layout.astro';
const title = 'Contact — China Starter Guide';
const description = 'Get in touch with us for questions, feedback, or collaboration.';
---

<Layout title={title} description={description} lang="zh">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">联系</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">联系我们</h1>
      <p class="text-gray-500  ">有问题或反馈吗？我们很乐意收到你的来信。</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4">
        <p class="text-sm text-gray-500  ">电子邮件即将到来。现在，请在社交媒体上关注我们的更新。</p>
      </div>
    </div>
  </article>
</Layout>
