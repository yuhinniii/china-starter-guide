---
import Layout from '../../layouts/Layout.astro';
const title = '联系我们 — 中国入门指南';
const description = '有问题或建议？欢迎联系我们。';
---

<Layout title={title} description={description} lang="zh">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">联系</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">联系我们</h1>
      <p class="text-gray-500 dark:text-gray-400">有问题或建议？欢迎联系我们。</p>
    </header>
    <div class="bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-8">
      <div class="space-y-4">
        <p class="text-sm text-gray-500 dark:text-gray-400">邮箱即将上线。请关注我们的社交媒体更新。</p>
      </div>
    </div>
  </article>
</Layout>
