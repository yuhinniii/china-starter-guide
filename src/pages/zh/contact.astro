---
import Layout from '@layouts/Layout.astro';
const title = '联系我们 — China Starter Hub';
const description = '准备去中国旅行，或已经落地遇到问题？自由行每个环节——行程、酒店等，我们都能帮上忙。';
---

<Layout title={title} description={description} lang="zh">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">💬 联系</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">联系我们</h1>
      <p class="text-lg text-gray-500">准备去中国旅行，或者已经落地卡住了？我们是自由行的一站式帮手。</p>
    </header>

    <div class="space-y-8 pb-16">
      <section class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">我们能帮你做什么</h2>
        <ul class="space-y-3 text-lg text-gray-700">
          <li>✅ 规划行程路线，筛选适合预算的酒店</li>
          <li>✅ 解决签证、支付、交通和景点门票的问题</li>
          <li>✅ 落地后遇到问题，也能远程搭把手</li>
          <li>✅ 回答任何中国旅行问题——美食、网络、安全、礼仪等等</li>
        </ul>
      </section>

      <section class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-2">🎁 免费酒店对比</h2>
        <p class="text-lg text-gray-700 mb-3">告诉我们你的区域和每晚预算——我们免费为你对比 <strong>2 家酒店</strong>。</p>
        <ol class="text-sm text-gray-700 list-decimal pl-5 mb-4 space-y-1">
          <li>城市或区域</li>
          <li>每晚预算</li>
          <li>入住日期</li>
          <li>同行人数</li>
        </ol>
        <a href="mailto:hello@chinastarterhub.com?subject=Hotel%20help&amp;body=%E4%BD%A0%E5%A5%BD%EF%BC%8CChina%20Starter%20Hub%EF%BC%9A%0A%0A%E6%88%91%E6%83%B3%E8%A6%81%E5%85%8D%E8%B4%B9%E9%85%92%E5%BA%97%E5%AF%B9%E6%AF%94%EF%BC%8C%E8%BF%99%E6%98%AF%E6%88%91%E7%9A%84%E4%BF%A1%E6%81%AF%EF%BC%9A%0A%0A1.%20%E5%9F%8E%E5%B8%82%E6%88%96%E5%8C%BA%E5%9F%9F%EF%BC%9A%0A2.%20%E6%AF%8F%E6%99%9A%E9%A2%84%E7%AE%97%EF%BC%9A%0A3.%20%E5%85%A5%E4%BD%8F%E6%97%A5%E6%9C%9F%EF%BC%9A%0A4.%20%E5%90%8C%E8%A1%8C%E4%BA%BA%E6%95%B0%EF%BC%9A%0A%0A%E8%B0%A2%E8%B0%A2%EF%BC%81" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-brand-600 text-white rounded-xl text-base font-semibold hover:opacity-90 transition no-underline">
          📧 发邮件（主题已填 "Hotel help"）
        </a>
      </section>

      <section class="bg-gray-50 border border-gray-100 rounded-2xl p-6 md:p-8 text-center">
        <h2 class="text-xl font-bold text-gray-900 mb-4">联系我们</h2>
        <p class="text-lg text-gray-700">发邮件到 <a href="mailto:hello@chinastarterhub.com" class="text-brand-600 font-medium hover:underline">hello@chinastarterhub.com</a></p>
        <p class="text-sm text-gray-500 mt-2">一般 1–2 个工作日内回复。</p>
      </section>

      <section class="bg-white border border-gray-200 rounded-2xl p-6 md:p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4">常见问题</h2>
        <div class="space-y-4">
          <details class="group border border-gray-200 rounded-xl p-4">
            <summary class="font-semibold text-gray-900 cursor-pointer">能帮我规划路线、筛选酒店吗？</summary>
            <p class="text-gray-700 mt-2">可以——告诉我们日期、目的地和预算，我们来出方案。</p>
          </details>
          <details class="group border border-gray-200 rounded-xl p-4">
            <summary class="font-semibold text-gray-900 cursor-pointer">你们是旅行社吗？</summary>
            <p class="text-gray-700 mt-2">不是。我们是自由行助手，按具体需求帮忙，不卖打包跟团。</p>
          </details>
          <details class="group border border-gray-200 rounded-xl p-4">
            <summary class="font-semibold text-gray-900 cursor-pointer">你们在哪里？</summary>
            <p class="text-gray-700 mt-2">我们远程协作，所以在中国任何地方都能帮你。</p>
          </details>
        </div>
      </section>
    </div>
  </article>
</Layout>
