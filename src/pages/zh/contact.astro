---
import Layout from '@layouts/Layout.astro';
const title = '联系我们 — China Starter Hub';
const description = '有问题或建议？我们很乐意听听你的想法。';
---

<Layout title={title} description={description} lang="zh">
  <article class="max-w-2xl mx-auto">
    <header class="py-12 text-center">
      <div class="text-sm text-brand-600 font-medium mb-2">联系我们</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900  ">联系我们</h1>
      <p class="text-gray-500  ">有问题或建议？我们很乐意听听你的想法。</p>
    </header>
    <div class="bg-gray-50  :border-gray-800 rounded-2xl p-8">
      <div class="space-y-4 text-center">
        <p class="text-gray-700 text-lg">发送邮件至 <a href="mailto:hello@chinastarterhub.com" class="text-brand-600 font-medium hover:underline">hello@chinastarterhub.com</a>，我们会在 24 小时内回复。</p>
      </div>
    </div>
  </article>
</Layout>
