---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Hub — 来中国旅行，这一站就够了';
const description = '签证、支付、交通、生活贴士，来中国前需要知道的一切。';
---

<Layout title={title} description={description} lang="zh">
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900">
      自信游中国 —<br/><span class="text-brand-600">从签证到支付，一步步出行指南</span>
    </h1>
    <div class="flex flex-wrap justify-center gap-4 mt-10">
      <a href="/zh/visa/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">开始准备</a>
      <a href="/zh/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">关于本站</a>
    </div>
  </section>

  <!-- 四大分类入口 -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/zh/visa/', title: '签证', desc: '签证类型、免签国家、过境政策，出门前先搞清楚这个' },
        { href: '/zh/payment/', title: '支付', desc: '支付宝、微信支付、银行卡、现金，在国内怎么花钱' },
        { href: '/zh/transport/', title: '交通', desc: '高铁、地铁、打车、从机场到市区，怎么走都安排上' },
        { href: '/zh/life/', title: '生活', desc: '常用App、看病、安全贴士、日常必备' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50 border border-gray-100 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900 group-hover:text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Interactive Pre-Departure Checklist -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">你的中国旅行清单</h2>
    <p class="text-gray-500 mb-4">从出发前一个月到抵达第一天——每完成一项就打个勾。</p>

    <!-- Time Filter -->
    <div id="checklist-filter" class="flex flex-wrap gap-2 mb-5">
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-brand-50 text-brand-700 text-sm font-medium cursor-pointer transition hover:border-brand-300 active" data-show="all">全部阶段</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="1">出发前1个月</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="2">出发前2周</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="3">出发前1周</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="4,5">落地当天</button>
      <button class="filter-chip px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-600 text-sm font-medium cursor-pointer transition hover:border-brand-300 hover:text-brand-600" data-show="6">第一天</button>
    </div>

    <!-- Overall Progress -->
    <div id="checklist-progress" class="bg-gray-50 rounded-2xl p-5 mb-10">
      <div class="flex items-center justify-between mb-1.5">
        <span class="text-sm font-semibold text-gray-700">总体进度</span>
        <span id="progress-text" data-suffix="已完成" class="text-base font-bold text-brand-600">已完成 0 / 23</span>
      </div>
      <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width:0%"></div>
      </div>
    </div>

    <div class="space-y-8">

      <!-- Stage 1: T-30 Days · 出发前一个月 -->
      <div class="relative pl-12 stage-group" data-stage="1">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-xs font-bold text-green-700">1</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-green-700">T-30 Days</span> · 出发前一个月
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="1">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="1">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-passport">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">01</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">检查护照有效期</p>
              <p class="text-sm text-gray-500 mt-0.5">很多国家办中国签证要求护照有效期超过旅行日期至少6个月。出发前确认一下。</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-visa">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">02</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">确认签证类型或免签资格</p>
              <p class="text-sm text-gray-500 mt-0.5">不确定要不要签证？用签证筛选器30秒查清。</p>
            </div>
            <a href="/zh/visa/visa-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">查看指南 →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="travel-insurance">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">03</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">购买含医疗保险的旅行保险</p>
              <p class="text-sm text-gray-500 mt-0.5">中国医院先交钱再看病。建议买至少10万美元医疗保额、含紧急救援的旅行保险。</p>
            </div>
            <a href="/zh/life/travel-insurance/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">查看指南 →</a>
          </div>
        </div>
      </div>

      <!-- Stage 2: T-15 Days · 出发前两周 -->
      <div class="relative pl-12 stage-group" data-stage="2">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-xs font-bold text-blue-700">2</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-blue-700">T-15 Days</span> · 出发前两周
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="2">0/6 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="2">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="buy-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">04</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">购买 VPN 并安装</p>
              <p class="text-sm text-gray-500 mt-0.5">在中国境内下不了 VPN。出发前买好装到所有设备上，在家测试连通。</p>
            </div>
            <a href="/zh/life/vpn-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">查看指南 →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="buy-esim">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">05</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">购买 eSIM</p>
              <p class="text-sm text-gray-500 mt-0.5">选一个支持中国的 eSIM，最好经香港路由能绕过防火墙。出发前装好。</p>
            </div>
            <a href="/zh/life/sim-card-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">查看指南 →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="setup-alipay">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">06</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">设置支付宝并绑定银行卡</p>
              <p class="text-sm text-gray-500 mt-0.5">建议绑一张信用卡加一张储蓄卡。小店个人收款码刷不了信用卡，但储蓄卡能付。</p>
            </div>
            <a href="/zh/payment/payment-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">查看指南 →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="setup-wechat">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">07</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">设置微信支付（备用）</p>
              <p class="text-sm text-gray-500 mt-0.5">Alipay 能搞定95%支付，但有的小餐馆只能用微信。当备用装了也不亏。</p>
            </div>
            <a href="/zh/payment/setup-wechat/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">查看指南 →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="book-hotel">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">08</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">预订能接待外宾的酒店</p>
              <p class="text-sm text-gray-500 mt-0.5">不是所有酒店都能接待外宾。用 Trip.com 订房筛选有外国人好评的酒店。</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="notify-bank">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">09</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">通知银行你要去中国</p>
              <p class="text-sm text-gray-500 mt-0.5">有些银行会自动拦截中国交易。出发前去 App 设旅行通知，5分钟省心。</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 3: T-7 Days · 临行前 -->
      <div class="relative pl-12 stage-group" data-stage="3">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-xs font-bold text-indigo-700">3</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-indigo-700">T-7 Days</span> · 临行前
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="3">0/4 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="3">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="test-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">10</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">在所有设备上测试 VPN</p>
              <p class="text-sm text-gray-500 mt-0.5">确认手机、笔记本、平板都能连。在家测好，到了中国 VPN 官网也打不开。</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="install-apps">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">11</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">安装中国旅行必备 App</p>
              <p class="text-sm text-gray-500 mt-0.5">Baidu Maps、Didi、Trip.com。趁 App Store 还能下先装好。</p>
            </div>
            <a href="/zh/life/essential-apps/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">查看指南 →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="learn-chinese">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">12</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">学10句基础中文</p>
              <p class="text-sm text-gray-500 mt-0.5">会说"谢谢"和"多少钱"，别人对你的态度会不一样。从最常用的开始学。</p>
            </div>
            <a href="/zh/life/chinese-phrases/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">查看指南 →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="backup-docs">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">13</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">备份护照、签证、保险的电子版</p>
              <p class="text-sm text-gray-500 mt-0.5">在手机和云盘各存一份扫描件。原件丢了，备份是最后的救命稻草。</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 4: T-24h · 最后准备 -->
      <div class="relative pl-12 stage-group" data-stage="4">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-xs font-bold text-amber-700">4</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-amber-700">T-24h</span> · 最后准备
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="4">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="4">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="check-in">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">16</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">在线值机并确认航班</p>
              <p class="text-sm text-gray-500 mt-0.5">早点选座，顺便看看有没有换登机口。别拖到最后。</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="withdraw-cash">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">15</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">取 500-1000 元现金</p>
              <p class="text-sm text-gray-500 mt-0.5">中国95%无现金，但支付 App 至少崩一次。现金是出租车、小摊扫码失败时的救命钱。</p>
            </div>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="power-bank">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">16</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">充电宝和转换插头放随身行李</p>
              <p class="text-sm text-gray-500 mt-0.5">手机管一切：地图、付钱、翻译。飞行途中和落地后保持电量充足。</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stage 5: 落地当天 · 落地头两小时 -->
      <div class="relative pl-12 stage-group" data-stage="5">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-xs font-bold text-teal-700">5</div>
        <div class="absolute left-[14px] top-8 bottom-0 w-px bg-gray-200"></div>
        <h3 class="text-base font-bold text-gray-900 mb-3">
          <span class="text-teal-700">落地当天</span> · 落地头两小时
          <span class="stage-progress text-sm font-normal text-gray-400 ml-1" data-stage="5">0/3 ✓</span>
        </h3>
        <div class="space-y-1.5 checklist-stage" data-stage="5">
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="activate-esim">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">17</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">激活 eSIM 打开数据</p>
              <p class="text-sm text-gray-500 mt-0.5">过海关后第一件事：开网。之后的地图、打车、翻译、付钱全都要靠网络。</p>
            </div>
            <a href="/zh/life/sim-card-guide/" class="text-sm text-brand-600 hover:underline whitespace-nowrap mt-0.5 shrink-0">查看指南 →</a>
          </div>
          <div class="checklist-item flex items-start gap-2.5 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition" data-key="connect-vpn">
            <span class="text-sm font-mono text-gray-300 w-5 shrink-0 text-right mt-0.5">18</span>
            <input type="checkbox" class="mt-0.5 w-4 h-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500 cursor-pointer shrink-0">
            <div class="flex-1 min-w-0">
              <p class="text-base font-semibold text-gray-900">连接 VPN</p>
              <p class="text-sm text-gray-500 mt-0.5">打开任何 App 前先连 VPN。不连的话 WhatsApp 收不到，Google Maps 空白。</p>
            </div>
          </div>
