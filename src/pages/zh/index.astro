---
import Layout from '@layouts/Layout.astro';
const title = '中国入门指南——中国终极指南';
const description = '来中国之前你需要知道的一切：支付、交通、应用程序、城市和旅行提示。';
---

<Layout title={title} description={description} lang="zh">
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900  ">
      清晰、最新的指南，专为<br/><span class="text-brand-600">首次来中国的外国人</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-500  ">
      从基础开始，然后跟随适合您行程的指南。
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/zh/prepare/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">开始准备</a>
      <a href="/zh/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">关于本网站</a>
    </div>
  </section>

  <!-- Section: Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/zh/visa/', title: '签证', desc: '签证类型、免签国家、过境政策。' },
        { href: '/zh/payment/', title: '支付', desc: '电子钱包、银行卡、现金备用。' },
        { href: '/zh/transport/', title: '交通', desc: '高铁、地铁、叫车服务、从机场到市区。' },
        { href: '/zh/life/', title: '中国生活', desc: '应用程序、医疗、安全提示、日常生活。' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  :text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Your Trip: Step by Step -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">你的旅程，逐步指南</h2>
    <p class="text-gray-500 mb-10">跟随你的阶段——每个阶段都会链接到你实际需要的指南。</p>

    <div class="space-y-8">
      <!-- Stage 1 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-green-100 flex items-center justify-center text-sm font-bold text-green-700">1</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">出发前</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/zh/visa/visa-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">行前准备</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">你需要哪种签证？</p>
          </a>
          <a href="/zh/payment/payment-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">支付</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">如何在中国支付</p>
          </a>
          <a href="/zh/life/survival-kit/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">出发前检查清单</p>
          </a>
        </div>
      </div>

      <!-- Stage 2 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-sm font-bold text-blue-700">2</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">刚抵达</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/zh/transport/airport-to-city/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">交通</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">从机场到市区</p>
          </a>
          <a href="/zh/life/sim-card-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">SIM卡与网络设置</p>
          </a>
          <a href="/zh/life/vpn-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">设置VPN</p>
          </a>
        </div>
      </div>

      <!-- Stage 3 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-purple-100 flex items-center justify-center text-sm font-bold text-purple-700">3</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">旅行中</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/zh/transport/transport-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">交通</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">环游中国</p>
          </a>
          <a href="/zh/life/essential-apps/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">10个必备应用</p>
          </a>
          <a href="/zh/life/chinese-phrases/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">基本中文短语</p>
          </a>
        </div>
      </div>

      <!-- Stage 4 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-red-100 flex items-center justify-center text-sm font-bold text-red-700">4</div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">需要帮助？</h3>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <a href="/zh/medical/seeing-a-doctor/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">看医生</p>
          </a>
          <a href="/zh/tips/common-scams/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">防范常见骗局</p>
          </a>
          <a href="/zh/tips/emergency-numbers/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">紧急联系方式</p>
          </a>
          <a href="/zh/payment/payment-fails/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">支付</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">支付失败怎么办</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visa Checker Tool -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="border-t border-gray-100 pt-12">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">签证查询</h2>
        <p class="text-gray-500 text-center mb-8">不确定是否需要签证？选择您的国籍——我们会告诉您。</p>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <label for="visa-country" class="block text-sm font-medium text-gray-700 mb-2">您的国籍</label>
          <select id="visa-country" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 text-base appearance-none cursor-pointer">
            <option value="">— 选择您的国家 —</option>
            <option value="AL">Albania</option>
            <option value="AD">Andorra</option>
            <option value="AG">Antigua and Barbuda</option>
            <option value="AR">Argentina</option>
            <option value="AM">Armenia</option>
            <option value="AU">Australia</option>
            <option value="AT">Austria</option>
            <option value="AZ">Azerbaijan</option>
            <option value="BS">Bahamas</option>
            <option value="BH">Bahrain</option>
            <option value="BD">Bangladesh</option>
            <option value="BB">Barbados</option>
            <option value="BY">Belarus</option>
            <option value="BE">Belgium</option>
            <option value="BA">Bosnia and Herzegovina</option>
            <option value="BR">Brazil</option>
            <option value="BN">Brunei</option>
            <option value="BG">Bulgaria</option>
            <option value="CA">Canada</option>
            <option value="CL">Chile</option>
            <option value="HR">Croatia</option>
            <option value="CY">Cyprus</option>
            <option value="CZ">Czech Republic</option>
            <option value="DK">Denmark</option>
            <option value="DM">Dominica</option>
            <option value="EC">Ecuador</option>
            <option value="EG">Egypt</option>
            <option value="EE">Estonia</option>
            <option value="FJ">Fiji</option>
            <option value="FI">Finland</option>
            <option value="FR">France</option>
            <option value="GE">Georgia</option>
            <option value="DE">Germany</option>
            <option value="GR">Greece</option>
            <option value="GD">Grenada</option>
            <option value="HU">Hungary</option>
            <option value="IS">Iceland</option>
            <option value="IN">India</option>
            <option value="ID">Indonesia</option>
            <option value="IE">Ireland</option>
            <option value="IT">Italy</option>
            <option value="JP">Japan</option>
            <option value="KZ">Kazakhstan</option>
            <option value="KE">Kenya</option>
            <option value="KW">Kuwait</option>
            <option value="LV">Latvia</option>
            <option value="LI">Liechtenstein</option>
            <option value="LT">Lithuania</option>
            <option value="LU">Luxembourg</option>
            <option value="MY">Malaysia</option>
            <option value="MV">Maldives</option>
            <option value="MT">Malta</option>
            <option value="MU">Mauritius</option>
            <option value="MC">Monaco</option>
            <option value="ME">Montenegro</option>
            <option value="NL">Netherlands</option>
            <option value="NZ">New Zealand</option>
            <option value="NG">Nigeria</option>
            <option value="MK">North Macedonia</option>
            <option value="NO">Norway</option>
            <option value="OM">Oman</option>
            <option value="PK">Pakistan</option>
            <option value="PE">Peru</option>
            <option value="PH">Philippines</option>
            <option value="PL">Poland</option>
            <option value="PT">Portugal</option>
            <option value="QA">Qatar</option>
            <option value="RO">Romania</option>
            <option value="RU">Russia</option>
            <option value="WS">Samoa</option>
            <option value="SM">San Marino</option>
            <option value="SA">Saudi Arabia</option>
            <option value="RS">Serbia</option>
            <option value="SC">Seychelles</option>
            <option value="SG">Singapore</option>
            <option value="SK">Slovakia</option>
            <option value="SI">Slovenia</option>
            <option value="SB">Solomon Islands</option>
            <option value="ZA">South Africa</option>
            <option value="KR">South Korea</option>
            <option value="ES">Spain</option>
            <option value="SR">Suriname</option>
            <option value="SE">Sweden</option>
            <option value="CH">Switzerland</option>
            <option value="TH">Thailand</option>
            <option value="TO">Tonga</option>
            <option value="TR">Turkey</option>
            <option value="AE">United Arab Emirates</option>
            <option value="GB">United Kingdom</option>
            <option value="US">United States</option>
            <option value="UY">Uruguay</option>
            <option value="UZ">Uzbekistan</option>
            <option value="VN">Vietnam</option>
            <option value="OTHER">其他国家</option>
          </select>

          <div id="visa-result" class="mt-6"></div>
        </div>

        <p class="text-xs text-gray-400 text-center mt-4">签证政策随时可能变化。预订前请务必与当地中国大使馆核实。</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const countrySelect = document.getElementById('visa-country');
    const resultDiv = document.getElementById('visa-result');

    // Source: China gov.cn official list (2025)
    // Category 1: Unilateral visa-free (30 days) - 50 countries
    const visaFree = ['BN','FR','DE','IT','ES','NL','CH','IE','HU','AT','BE','LU','NZ','AU','PL','PT','GR','CY','SI','SK','NO','FI','DK','IS','AD','MC','LI','KR','BG','RO','HR','ME','MK','MT','EE','LV','JP','BR','AR','CL','PE','UY','SA','OM','KW','BH','CA','RU','GB','SE'];

    // Category 2: Mutual visa agreement (ordinary passport) - 29 countries
    const mutualFree = ['AL','AE','AG','BB','BS','BY','BA','DM','EC','FJ','GD','GE','KZ','QA','MV','MU','WS','RS','SC','SM','SR','SB','TH','TO','UZ','SG','AM','AZ','MY'];

    // Category 3: 240-hour transit - 55 countries
    const transit240 = ['AL','AT','BE','BG','BA','BR','CA','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LT','LU','MT','MC','ME','NL','MK','NO','PL','PT','RO','RU','RS','SK','SI','KR','ES','SE','CH','UA','GB','US','AU','NZ','JP','SG','BN','AE','QA','MX','AR','CL','ID','BY'];

    // Determine best visa status for each country
    function getVisaStatus(code) {
      if (visaFree.includes(code)) return 'visa-free-30';
      if (mutualFree.includes(code)) return 'mutual-free';
      if (transit240.includes(code)) return 'transit';
      return 'need-visa';
    }

    const countryNames = {
      'AL':'Albania','AD':'Andorra','AG':'Antigua and Barbuda','AR':'Argentina','AM':'Armenia',
      'AU':'Australia','AT':'Austria','AZ':'Azerbaijan','BS':'Bahamas','BH':'Bahrain','BB':'Barbados',
      'BY':'Belarus','BE':'Belgium','BA':'Bosnia and Herzegovina','BR':'Brazil','BN':'Brunei','BG':'Bulgaria',
      'CA':'Canada','CL':'Chile','HR':'Croatia','CY':'Cyprus','CZ':'Czech Republic','DK':'Denmark',
      'DM':'Dominica','EC':'Ecuador','EG':'Egypt','EE':'Estonia','FJ':'Fiji','FI':'Finland','FR':'France',
      'GE':'Georgia','DE':'Germany','GR':'Greece','GD':'Grenada','HU':'Hungary',      'IS':'Iceland','IE':'Ireland','IN':'India','ID':'Indonesia','IT':'Italy',
      'JP':'Japan','KZ':'Kazakhstan','KE':'Kenya','KW':'Kuwait','LV':'Latvia','LI':'Liechtenstein',
      'LT':'Lithuania','LU':'Luxembourg','MY':'Malaysia','MV':'Maldives','MT':'Malta','MU':'Mauritius',
      'MC':'Monaco','ME':'Montenegro',      'NL':'Netherlands','NZ':'New Zealand','NG':'Nigeria','MK':'North Macedonia',
      'NO':'Norway','OM':'Oman','PK':'Pakistan','PE':'Peru','PH':'Philippines','PL':'Poland','PT':'Portugal','QA':'Qatar','RO':'Romania',
      'RU':'Russia','WS':'Samoa','SM':'San Marino','SA':'Saudi Arabia','RS':'Serbia','SC':'Seychelles',
      'SG':'Singapore','SK':'Slovakia','SI':'Slovenia','SB':'Solomon Islands','ZA':'South Africa','KR':'South Korea',
      'ES':'Spain','SR':'Suriname','SE':'Sweden','CH':'Switzerland','TH':'Thailand','TO':'Tonga','TR':'Turkey',
      'AE':'the United Arab Emirates','GB':'the United Kingdom','US':'the United States','UY':'Uruguay','UZ':'Uzbekistan','VN':'Vietnam'
    };

    countrySelect.addEventListener('change', function() {
      const val = this.value;
      if (!val) {
        resultDiv.innerHTML = '';
        return;
      }

      const name = countryNames[val] || 'your country';
      const status = getVisaStatus(val);

      if (status === 'visa-free-30') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">好消息！' + name + ' 的公民可以<span class="underline">免签证</span>进入中国，最多停留30天。</p><p class="text-green-700 text-sm mb-3">旅游、商务或30天以内的过境无需签证。</p><a href="/zh/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">查看完整免签国家列表 →</a></div>';
      } else if (status === 'mutual-free') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">' + name + ' 的公民可根据<span class="underline">互免签证协议</span>免签证进入中国。</p><p class="text-green-700 text-sm mb-3">旅行前请检查您的护照类型和允许停留时间。</p><a href="/zh/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">查看免签国家列表 →</a></div>';
      } else if (status === 'transit') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-blue-50 border border-blue-200"><p class="text-blue-800 font-semibold mb-1">您可以使用<span class="underline">240小时过境免签</span>政策。</p><p class="text-blue-700 text-sm mb-3">' + name + ' 的公民可以在中国过境最多10天无需签证。如需更长时间停留，需要申请L签证。</p><div class="flex flex-wrap gap-3"><a href="/zh/visa/transit-240/" class="text-sm font-medium text-blue-700 underline hover:no-underline">了解过境政策 →</a><a href="/zh/visa/apply-l-visa/" class="text-sm font-medium text-blue-700 underline hover:no-underline">申请L签证 →</a></div></div>';
      } else {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-orange-50 border border-orange-200"><p class="text-orange-800 font-semibold mb-1">您需要申请签证。</p><p class="text-orange-700 text-sm mb-3">' + name + ' 的公民在前往中国前需要申请旅游签证（L型）。</p><a href="/zh/visa/apply-l-visa/" class="inline-block text-sm font-medium text-orange-700 underline hover:no-underline">如何申请L签证 →</a></div>';
      }
    });
  </script>
</Layout>
