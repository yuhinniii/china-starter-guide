---
import Layout from '@layouts/Layout.astro';
const title = '中国入门指南——中国终极指南';
const description = '来中国之前你需要知道的一切：支付、交通、应用程序、城市和旅行提示。';
---

<Layout title={title} description={description} lang="zh">
  <!-- Hero -->
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900  ">
      Clear, Current Guidance for<br/><span class="text-brand-600">首次来中国的外国人</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-500  ">
      Start with the essentials, then follow the guides that match your trip.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/zh/prepare/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">开始使用</a>
      <a href="/zh/about/" class="border border-gray-300  :border-brand-600 hover:text-brand-600 transition no-underline">关于本网站</a>
    </div>
  </section>

  <!-- Core Category Cards -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/zh/prepare/', title: 'Prepare', desc: 'Visa, documents, essential setup before you fly.' },
        { href: '/zh/payment/', title: 'Payment', desc: 'Wallets, bank cards, cash backup.' },
        { href: '/zh/transport/', title: 'Transport', desc: 'High-speed rail, metro, local travel basics.' },
        { href: '/zh/medical/', title: 'Medical', desc: 'Clinics, hospitals, emergency care.' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  :border-brand-200 dark:hover:border-brand-800 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900  :text-brand-600 dark:group-hover:text-brand-400 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500  ">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Top 5 Guides for First-Timers -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900  ">五大新手指南</h2>
    <p class="text-gray-500  ">如果这是你第一次来中国，就从这里开始吧。</p>
    <div class="space-y-4">
      {[
        { title: 'First Time in China: A Step-by-Step Guide', desc: 'What to prepare before you fly, how to reduce stress, and what to expect on arrival.', href: '#', tag: 'Prepare' },
        { title: 'How to Pay in China: The Complete Payment Guide', desc: 'Mobile wallets, foreign cards, cash backup, QR codes, transport payment, and what to do if payment fails.', href: '#', tag: 'Payment' },
        { title: 'Is China Safe? Usually Safer Than First-Time Visitors Expect', desc: 'What the actual safety situation is, common misconceptions, and what to watch out for.', href: '#', tag: 'Tips' },
        { title: 'From Airport to City in China: What Usually Works Best', desc: 'Metro, taxi, and ride-hailing — how to choose and avoid bad decisions on arrival.', href: '#', tag: 'Transport' },
        { title: 'Seeing a Doctor in China as a Foreigner', desc: 'Pharmacy, clinic, or hospital — how to choose and what to expect.', href: '#', tag: 'Medical' },
      ].map((g, i) => (
        <a href={g.href} class="group flex items-start gap-4 p-4 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-900 transition no-underline">
          <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-brand-100  :text-brand-300 text-sm font-bold flex items-center justify-center">{i + 1}</span>
          <div>
            <span class="text-xs font-medium text-brand-600  ">{g.tag}</span>
            <h3 class="text-base font-semibold text-gray-900  :text-brand-600 dark:group-hover:text-brand-400">{g.title}</h3>
            <p class="text-sm text-gray-500  ">{g.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Scenario-Based Quick Links -->
  <section class="max-w-5xl mx-auto px-4 py-12 border-t border-gray-100  ">
    <h2 class="text-2xl font-bold text-gray-900  ">选择你的情况</h2>
    <p class="text-gray-500  ">跳转到与您现在所在位置匹配的指南。</p>
    <div class="flex flex-wrap gap-3">
      {[
        'Check visa & entry rules', '，href：', '设置电话和互联网', '设置运输', '准备酒店住宿', '规划你的前72小时', '准备安全和应急步骤', '处理食物和日常生存', '计划火车旅行', '选择正确的医疗路径',
      ].map(label => (
        <span class="text-sm px-4 py-2 rounded-full bg-gray-100  :text-gray-300 border border-gray-200  ">即将推出</span>
      ))}
    </div>
  </section>

  <!-- Latest Verified Guides -->
  <section class="max-w-5xl mx-auto px-4 py-12 border-t border-gray-100  ">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-gray-900  ">最近更新的指南</h2>
        <p class="text-gray-500  ">最后验证日期：2026年6月</p>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {[
        { title: '首次到访北京的游客', tag: 'City' },
        { title: '首次到访中国的最佳城市', tag: 'City' },
        { title: '广州和深圳首次接待游客', tag: 'City' },
        { title: '你在中国应该参观多少个城市？', tag: 'Planning' },
      ].map(g => (
        <a href="#" class="block p-5 rounded-2xl bg-gray-50  :bg-brand-50 dark:hover:bg-brand-950 border border-gray-100  ">
          <span class="text-xs font-medium text-brand-600  ">{g.tag}</span>
          <h3 class="text-base font-semibold text-gray-900  ">{g.title}</h3>
          <p class="text-xs text-gray-400 mt-2">Coming soon</p>
        </a>
      ))}
    </div>
  </section>
</Layout>