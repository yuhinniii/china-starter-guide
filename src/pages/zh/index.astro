---
import Layout from '@layouts/Layout.astro';
const title = 'China Starter Hub — 来中国旅行，这一站就够了';
const description = '签证、支付、交通、生活贴士，来中国前需要知道的一切。';
---

<Layout title={title} description={description} lang="zh">
  <section class="text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900">
      来中国旅行前，<br/><span class="text-brand-600">你需要的一切指南</span>
    </h1>
    <p class="text-lg md:text-xl text-gray-500">
      从必备知识开始，再根据你的行程找到对应的攻略。
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/zh/visa/" class="bg-brand-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-700 transition no-underline">开始准备</a>
      <a href="/zh/about/" class="border border-brand-600 text-brand-600 px-6 py-3 rounded-lg font-medium hover:bg-brand-50 transition no-underline">关于本站</a>
    </div>
  </section>

  <!-- 四大分类入口 -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        { href: '/zh/visa/', title: '签证', desc: '签证类型、免签国家、过境政策，出门前先搞清楚这个' },
        { href: '/zh/payment/', title: '支付', desc: '支付宝、微信支付、银行卡、现金，在国内怎么花钱' },
        { href: '/zh/transport/', title: '交通', desc: '高铁、地铁、打车、从机场到市区，怎么走都安排上' },
        { href: '/zh/life/', title: '生活', desc: '常用App、看病、安全贴士、日常必备' },
      ].map(card => (
        <a href={card.href} class="group block p-5 rounded-2xl bg-gray-50 border border-gray-100 transition-all duration-200 no-underline">
          <h3 class="text-lg font-semibold text-gray-900 group-hover:text-brand-600 mb-1">{card.title}</h3>
          <p class="text-sm text-gray-500">{card.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- 行程阶段指引 -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">你的行程，分步搞定</h2>
    <p class="text-gray-500 mb-10">按你的阶段点进去——每条链接都指向你真正需要的那篇攻略。</p>

    <div class="space-y-8">
      <!-- 阶段 1 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-green-100 flex items-center justify-center text-sm font-bold text-green-700">1</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">出发之前</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/zh/visa/visa-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">准备</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">你需要哪种签证？</p>
          </a>
          <a href="/zh/payment/payment-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">支付</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">在中国怎么付钱</p>
          </a>
          <a href="/zh/life/survival-kit/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-green-200 transition no-underline">
            <span class="text-xs font-medium text-green-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">出发前 checklist</p>
          </a>
        </div>
      </div>

      <!-- 阶段 2 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-sm font-bold text-blue-700">2</div>
        <div class="absolute left-[17px] top-9 bottom-0 w-0.5 bg-gray-100"></div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">刚落地</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/zh/transport/airport-to-city/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">交通</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">从机场怎么进城</p>
          </a>
          <a href="/zh/life/sim-card-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">手机卡和上网</p>
          </a>
          <a href="/zh/life/vpn-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-blue-200 transition no-underline">
            <span class="text-xs font-medium text-blue-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">VPN 怎么设置</p>
          </a>
        </div>
      </div>

      <!-- 阶段 3 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-purple-100 flex items-center justify-center text-sm font-bold text-purple-700">3</div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">旅途中</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/zh/transport/transport-guide/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">交通</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">在中国怎么出行</p>
          </a>
          <a href="/zh/life/essential-apps/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">10 个必备 App</p>
          </a>
          <a href="/zh/life/chinese-phrases/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-purple-200 transition no-underline">
            <span class="text-xs font-medium text-purple-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">基础中文用语</p>
          </a>
        </div>
      </div>

      <!-- 阶段 4 -->
      <div class="relative pl-14">
        <div class="absolute left-0 top-0 w-9 h-9 rounded-full bg-red-100 flex items-center justify-center text-sm font-bold text-red-700">4</div>
        <h3 class="text-lg font-bold text-gray-900 mb-3">需要帮助？</h3>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
          <a href="/zh/life/seeing-a-doctor/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">看病怎么办</p>
          </a>
          <a href="/zh/life/common-scams/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">常见骗局避坑</p>
          </a>
          <a href="/zh/life/emergency-numbers/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">生活</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">紧急电话</p>
          </a>
          <a href="/zh/payment/payment-fails/" class="block p-4 rounded-xl bg-white border border-gray-100 hover:shadow-md hover:border-red-200 transition no-underline">
            <span class="text-xs font-medium text-red-600">支付</span>
            <p class="text-sm font-semibold text-gray-900 mt-1">付款失败怎么办</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 签证查询工具 -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="border-t border-gray-100 pt-12">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">签证查询</h2>
        <p class="text-gray-500 text-center mb-8">不确定自己要不要签证？选你的国籍，我们告诉你。</p>

        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <label for="visa-country" class="block text-sm font-medium text-gray-700 mb-2">你的国籍</label>
          <select id="visa-country" class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-brand-500 text-base appearance-none cursor-pointer">
            <option value="">— 选择你的国家 —</option>
            <option value="AL">阿尔巴尼亚</option>
            <option value="AD">安道尔</option>
            <option value="AG">安提瓜和巴布达</option>
            <option value="AR">阿根廷</option>
            <option value="AM">亚美尼亚</option>
            <option value="AU">澳大利亚</option>
            <option value="AT">奥地利</option>
            <option value="AZ">阿塞拜疆</option>
            <option value="BS">巴哈马</option>
            <option value="BH">巴林</option>
            <option value="BD">孟加拉国</option>
            <option value="BB">巴巴多斯</option>
            <option value="BY">白俄罗斯</option>
            <option value="BE">比利时</option>
            <option value="BA">波斯尼亚和黑塞哥维那</option>
            <option value="BR">巴西</option>
            <option value="BN">文莱</option>
            <option value="BG">保加利亚</option>
            <option value="CA">加拿大</option>
            <option value="CL">智利</option>
            <option value="HR">克罗地亚</option>
            <option value="CY">塞浦路斯</option>
            <option value="CZ">捷克</option>
            <option value="DK">丹麦</option>
            <option value="DM">多米尼克</option>
            <option value="EC">厄瓜多尔</option>
            <option value="EG">埃及</option>
            <option value="EE">爱沙尼亚</option>
            <option value="FJ">斐济</option>
            <option value="FI">芬兰</option>
            <option value="FR">法国</option>
            <option value="GE">格鲁吉亚</option>
            <option value="DE">德国</option>
            <option value="GR">希腊</option>
            <option value="GD">格林纳达</option>
            <option value="HU">匈牙利</option>
            <option value="IS">冰岛</option>
            <option value="IN">印度</option>
            <option value="ID">印度尼西亚</option>
            <option value="IE">爱尔兰</option>
            <option value="IT">意大利</option>
            <option value="JP">日本</option>
            <option value="KZ">哈萨克斯坦</option>
            <option value="KE">肯尼亚</option>
            <option value="KW">科威特</option>
            <option value="LV">拉脱维亚</option>
            <option value="LI">列支敦士登</option>
            <option value="LT">立陶宛</option>
            <option value="LU">卢森堡</option>
            <option value="MY">马来西亚</option>
            <option value="MV">马尔代夫</option>
            <option value="MT">马耳他</option>
            <option value="MU">毛里求斯</option>
            <option value="MX">墨西哥</option>
            <option value="MC">摩纳哥</option>
            <option value="ME">黑山</option>
            <option value="NL">荷兰</option>
            <option value="NZ">新西兰</option>
            <option value="NG">尼日利亚</option>
            <option value="MK">北马其顿</option>
            <option value="NO">挪威</option>
            <option value="OM">阿曼</option>
            <option value="PK">巴基斯坦</option>
            <option value="PE">秘鲁</option>
            <option value="PH">菲律宾</option>
            <option value="PL">波兰</option>
            <option value="PT">葡萄牙</option>
            <option value="QA">卡塔尔</option>
            <option value="RO">罗马尼亚</option>
            <option value="RU">俄罗斯</option>
            <option value="WS">萨摩亚</option>
            <option value="SM">圣马力诺</option>
            <option value="SA">沙特阿拉伯</option>
            <option value="RS">塞尔维亚</option>
            <option value="SC">塞舌尔</option>
            <option value="SG">新加坡</option>
            <option value="SK">斯洛伐克</option>
            <option value="SI">斯洛文尼亚</option>
            <option value="SB">所罗门群岛</option>
            <option value="ZA">南非</option>
            <option value="KR">韩国</option>
            <option value="ES">西班牙</option>
            <option value="SR">苏里南</option>
            <option value="SE">瑞典</option>
            <option value="CH">瑞士</option>
            <option value="TH">泰国</option>
            <option value="TO">汤加</option>
            <option value="TR">土耳其</option>
            <option value="UA">乌克兰</option>
            <option value="AE">阿拉伯联合酋长国</option>
            <option value="GB">英国</option>
            <option value="US">美国</option>
            <option value="UY">乌拉圭</option>
            <option value="UZ">乌兹别克斯坦</option>
            <option value="VN">越南</option>
            <option value="OTHER">其他国家</option>
          </select>

          <div id="visa-result" class="mt-6"></div>
        </div>

        <p class="text-xs text-gray-400 text-center mt-4">签证政策随时可能调整。订票前请务必向当地中国使领馆核实最新信息。</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const countrySelect = document.getElementById('visa-country');
    const resultDiv = document.getElementById('visa-result');

    // 资料来源：中国政府网官方名单（2025）
    // 类别 1：单方面免签（30天）- 50国
    const visaFree = ['BN','FR','DE','IT','ES','NL','CH','IE','HU','AT','BE','LU','NZ','AU','PL','PT','GR','CY','SI','SK','NO','FI','DK','IS','AD','MC','LI','KR','BG','RO','HR','ME','MK','MT','EE','LV','JP','BR','AR','CL','PE','UY','SA','OM','KW','BH','CA','RU','GB','SE'];

    // 类别 2：互免签证协议（普通护照）- 29国
    const mutualFree = ['AL','AE','AG','BB','BS','BY','BA','DM','EC','FJ','GD','GE','KZ','QA','MV','MU','WS','RS','SC','SM','SR','SB','TH','TO','UZ','SG','AM','AZ','MY'];

    // 类别 3：240小时过境免签 - 55国
    const transit240 = ['AL','AT','BE','BG','BA','BR','CA','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LT','LU','MT','MC','ME','NL','MK','NO','PL','PT','RO','RU','RS','SK','SI','KR','ES','SE','CH','UA','GB','US','AU','NZ','JP','SG','BN','AE','QA','MX','AR','CL','ID','BY'];

    function getVisaStatus(code) {
      if (visaFree.includes(code)) return 'visa-free-30';
      if (mutualFree.includes(code)) return 'mutual-free';
      if (transit240.includes(code)) return 'transit';
      return 'need-visa';
    }

    const countryNames = {
      'AL':'阿尔巴尼亚','AD':'安道尔','AG':'安提瓜和巴布达','AR':'阿根廷','AM':'亚美尼亚',
      'AU':'澳大利亚','AT':'奥地利','AZ':'阿塞拜疆','BS':'巴哈马','BH':'巴林','BB':'巴巴多斯',
      'BY':'白俄罗斯','BE':'比利时','BA':'波斯尼亚和黑塞哥维那','BR':'巴西','BN':'文莱','BG':'保加利亚',
      'CA':'加拿大','CL':'智利','HR':'克罗地亚','CY':'塞浦路斯','CZ':'捷克','DK':'丹麦',
      'DM':'多米尼克','EC':'厄瓜多尔','EG':'埃及','EE':'爱沙尼亚','FJ':'斐济','FI':'芬兰','FR':'法国',
      'GE':'格鲁吉亚','DE':'德国','GR':'希腊','GD':'格林纳达','HU':'匈牙利','IS':'冰岛','IE':'爱尔兰',
      'IN':'印度','ID':'印度尼西亚','IT':'意大利','JP':'日本','KZ':'哈萨克斯坦','KE':'肯尼亚','KW':'科威特',
      'LV':'拉脱维亚','LI':'列支敦士登','LT':'立陶宛','LU':'卢森堡','MY':'马来西亚','MV':'马尔代夫',
      'MT':'马耳他','MU':'毛里求斯','MX':'墨西哥','MC':'摩纳哥','ME':'黑山','NL':'荷兰','NZ':'新西兰','NG':'尼日利亚',
      'MK':'北马其顿','NO':'挪威','OM':'阿曼','PK':'巴基斯坦','PE':'秘鲁','PH':'菲律宾','PL':'波兰',
      'PT':'葡萄牙','QA':'卡塔尔','RO':'罗马尼亚','RU':'俄罗斯','WS':'萨摩亚','SM':'圣马力诺',
      'SA':'沙特阿拉伯','RS':'塞尔维亚','SC':'塞舌尔','SG':'新加坡','SK':'斯洛伐克','SI':'斯洛文尼亚',
      'SB':'所罗门群岛','ZA':'南非','KR':'韩国','ES':'西班牙','SR':'苏里南','SE':'瑞典','CH':'瑞士',
      'TH':'泰国','TO':'汤加','TR':'土耳其','UA':'乌克兰','AE':'阿拉伯联合酋长国','GB':'英国','US':'美国',
      'UY':'乌拉圭','UZ':'乌兹别克斯坦','VN':'越南'
    };

    countrySelect.addEventListener('change', function() {
      const val = this.value;
      if (!val) {
        resultDiv.innerHTML = '';
        return;
      }

      const name = countryNames[val] || '您的国家';
      const status = getVisaStatus(val);

      if (status === 'visa-free-30') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1">好消息！<span class="underline">' + name + '</span> 公民可以 <span class="underline">免签</span> 入境中国，最长停留 30 天。</p><p class="text-green-700 text-sm mb-3">旅游、商务或过境，30 天内都不需要办签证。</p><a href="/zh/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">查看完整免签名单 →</a></div>';
      } else if (status === 'mutual-free') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-green-50 border border-green-200"><p class="text-green-800 font-semibold mb-1"><span class="underline">' + name + '</span> 公民可根据互免协议 <span class="underline">免签</span> 入境中国。</p><p class="text-green-700 text-sm mb-3">出行前请确认护照类型和允许停留时长。</p><a href="/zh/visa/visa-free/" class="inline-block text-sm font-medium text-green-700 underline hover:no-underline">查看免签国家列表 →</a></div>';
      } else if (status === 'transit') {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-blue-50 border border-blue-200"><p class="text-blue-800 font-semibold mb-1">你可以使用 <span class="underline">240 小时过境免签</span> 政策。</p><p class="text-blue-700 text-sm mb-3"><span class="underline">' + name + '</span> 公民过境中国可停留最长 10 天无需签证。如果停留更久，需要申请 L 签证。</p><div class="flex flex-wrap gap-3"><a href="/zh/visa/transit-240/" class="text-sm font-medium text-blue-700 underline hover:no-underline">了解过境政策 →</a><a href="/zh/visa/apply-l-visa/" class="text-sm font-medium text-blue-700 underline hover:no-underline">申请 L 签证 →</a></div></div>';
      } else {
        resultDiv.innerHTML = '<div class="p-5 rounded-xl bg-orange-50 border border-orange-200"><p class="text-orange-800 font-semibold mb-1">你需要办理签证。</p><p class="text-orange-700 text-sm mb-3"><span class="underline">' + name + '</span> 公民需要在出发前申请旅游签证（L 类）。</p><a href="/zh/visa/apply-l-visa/" class="inline-block text-sm font-medium text-orange-700 underline hover:no-underline">如何申请 L 签证 →</a></div>';
      }
    });
  </script>
    <p class="text-xs text-gray-400 text-center mt-8">最后更新：2026年7月</p>
</Layout>
