---
import Layout from '@layouts/Layout.astro';
const title = '中国生活指南 — 旅行贴士与攻略';
const description = '来中国旅行必备的生活指南：看病就医、SIM 卡和网络、安全贴士、常用 App 和紧急联系方式，让你的旅途更安心。';
import SectionStats from '../../../components/SectionStats.astro';
import ArticleGroups from '../../../components/ArticleGroups.astro';
import { STATS, GROUPS, ITEMS, COUNT, COUNT_SINGULAR, type Lang } from '../../../data/life';

const lang: Lang = 'zh';

const stats = STATS.map((s) => ({ value: s.value, color: s.color, label: s.label[lang] }));

const groups = GROUPS.map((g, gi) => {
  const items = ITEMS.filter((i) => i.group === gi);
  return {
    color: g.color,
    title: g.name[lang],
    countText: (items.length === 1 ? COUNT_SINGULAR[lang] : COUNT[lang]).replace('{n}', String(items.length)),
    items: items.map((i) => ({
      href: `/${lang}/life/${i.slug}/`,
      tag: i.tag[lang],
      title: i.title[lang],
      desc: i.desc[lang],
    })),
  };
});

---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">中国生活指南</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">保持联络、安全出行，让旅途更轻松。</p>
    </header>

    <!-- Quick Stats -->
    <SectionStats stats={stats} />

    <!-- Category Sections -->
    <ArticleGroups groups={groups} />

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">下一步</p>
            <h3 class="text-xl font-bold text-gray-900">规划你的行程</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">你已准备好在中国的日常生活。接下来：办好签证并学会出行方式。</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/zh/visa/visa-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🛂 签证指南
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/zh/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 交通指南
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>