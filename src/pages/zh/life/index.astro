---
import Layout from '@layouts/Layout.astro';
const title = 'space-y-2文本sm纹理-600';
const description = '中国生活——旅游小贴士与指南';
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">保持联系，保持安全，充分利用您的旅行。</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">🌏 生命</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Stay connected, stay safe, and make the most of your trip.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">3</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">中国生活</p>
      </div>
      <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-cyan-800">3</p>
        <p class="text-xs font-semibold text-cyan-800 uppercase tracking-wide mt-1">健康医疗</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">3</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">安全和紧急情况</p>
      </div>
      <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-yellow-800">2</p>
        <p class="text-xs font-semibold text-yellow-800 uppercase tracking-wide mt-1">文化与要素</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">通信和互联网</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">3篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/life/sim-card-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📶 互联网</span>
            <p class="text-base font-bold text-gray-900 mt-1">游客最佳SIM卡和eSIM</p>
            <p class="text-sm text-gray-600 mt-0.5">比较eSIM提供商、机场SIM卡和数据套餐。</p>
          </a>
          <a href="/zh/life/vpn-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🔒 虚拟专用网络</span>
            <p class="text-base font-bold text-gray-900 mt-1">在中国旅行的最佳VPN</p>
            <p class="text-sm text-gray-600 mt-0.5">什么有效，如何设置，为什么在你到达之前。</p>
          </a>
          <a href="/zh/life/essential-apps/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📱 应用</span>
            <p class="text-base font-bold text-gray-900 mt-1">在中国旅行的10个必备应用程序</p>
            <p class="text-sm text-gray-600 mt-0.5">付款、运输、翻译和发现。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-cyan-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-cyan-800">Health & Medical</h2>
          <span class="text-xs font-medium text-cyan-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/life/seeing-a-doctor/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">⚕️ 医学的</span>
            <p class="text-base font-bold text-gray-900 mt-1">在中国看医生</p>
            <p class="text-sm text-gray-600 mt-0.5">药房、诊所或医院——如何选择。</p>
          </a>
          <a href="/zh/life/top-hospitals/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🏥 医院</span>
            <p class="text-base font-bold text-gray-900 mt-1">拥有国际科室的顶级医院</p>
            <p class="text-sm text-gray-600 mt-0.5">按城市分列的拥有英语工作人员的最佳医院。</p>
          </a>
          <a href="/zh/life/travel-insurance/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🛡️ 保险</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅游保险</p>
            <p class="text-sm text-gray-600 mt-0.5">关于旅行保险，你需要了解的内容。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Safety & Emergencies</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/life/is-china-safe/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🛡️ 安全</span>
            <p class="text-base font-bold text-gray-900 mt-1">去中国旅行安全吗？</p>
            <p class="text-sm text-gray-600 mt-0.5">诚实地对待安全、犯罪和要注意的事情。</p>
          </a>
          <a href="/zh/life/common-scams/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">⚠️ 骗局</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国常见的骗局以及如何避免</p>
            <p class="text-sm text-gray-600 mt-0.5">发现并避开最常见的旅游陷阱。</p>
          </a>
          <a href="/zh/life/emergency-numbers/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🆘 紧急情况</span>
            <p class="text-base font-bold text-gray-900 mt-1">紧急电话号码和该怎么办</p>
            <p class="text-sm text-gray-600 mt-0.5">基本联系人和逐步应急响应。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-yellow-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-yellow-800">Culture & Essentials</h2>
          <span class="text-xs font-medium text-yellow-800 opacity-60">3 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/life/survival-kit/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🎒 清单</span>
            <p class="text-base font-bold text-gray-900 mt-1">您的中国之旅生存工具包</p>
            <p class="text-sm text-gray-600 mt-0.5">完整的出发前检查表。</p>
          </a>
          <a href="/zh/life/packing-guide/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🧳 包装</span>
            <p class="text-base font-bold text-gray-900 mt-1">为中国打包什么</p>
            <p class="text-sm text-gray-600 mt-0.5">每个季节的实用装箱单。</p>
          </a>
          <a href="/zh/life/chinese-phrases/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🈶 语言</span>
            <p class="text-base font-bold text-gray-900 mt-1">游客必备汉语短语</p>
            <p class="text-sm text-gray-600 mt-0.5">旅行者的生存中文。</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">相关指南</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/zh/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">在中国付款</p>
          <p class="text-sm text-gray-500">设置支付宝和微信支付</p>
        </a>
        <a href="/zh/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">中国的交通</p>
          <p class="text-sm text-gray-500">周游全国</p>
        </a>
      </div>
    </div>
  </section>
</Layout>