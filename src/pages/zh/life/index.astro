---
import Layout from '@layouts/Layout.astro';
const title = '中国生活指南 — 旅行贴士与攻略';
const description = '保持联络、安全出行，让旅途更轻松。';
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🌏 生活指南</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">中国生活指南</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">保持联络、安全出行，让旅途更轻松。</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">3</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">网络与 App</p>
      </div>
      <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-cyan-800">3</p>
        <p class="text-xs font-semibold text-cyan-800 uppercase tracking-wide mt-1">健康与医疗</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">3</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">安全与应急</p>
      </div>
      <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-yellow-800">2</p>
        <p class="text-xs font-semibold text-yellow-800 uppercase tracking-wide mt-1">文化与必备</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">通信与网络</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">3 篇</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/life/sim-card-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📶 上网</span>
            <p class="text-base font-bold text-gray-900 mt-1">SIM 卡与 eSIM 选卡攻略</p>
            <p class="text-sm text-gray-600 mt-0.5">对比 eSIM 运营商、机场购卡和数据套餐。</p>
          </a>
          <a href="/zh/life/vpn-guide/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🔒 VPN</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅行 VPN 推荐</p>
            <p class="text-sm text-gray-600 mt-0.5">哪些能用、怎么设置、为什么出发前就要准备好。</p>
          </a>
          <a href="/zh/life/essential-apps/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">📱 App</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅行必备 10 个 App</p>
            <p class="text-sm text-gray-600 mt-0.5">支付、出行、翻译、探索一应俱全。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-cyan-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-cyan-800">健康与医疗</h2>
          <span class="text-xs font-medium text-cyan-800 opacity-60">3 篇</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/life/seeing-a-doctor/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">⚕️ 就医</span>
            <p class="text-base font-bold text-gray-900 mt-1">在中国看病指南</p>
            <p class="text-sm text-gray-600 mt-0.5">药店、诊所还是医院？教你如何选择。</p>
          </a>
          <a href="/zh/life/top-hospitals/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🏥 医院</span>
            <p class="text-base font-bold text-gray-900 mt-1">优质国际部医院推荐</p>
            <p class="text-sm text-gray-600 mt-0.5">配备英文医护人员的优质医院，按城市分类。</p>
          </a>
          <a href="/zh/life/travel-insurance/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🛡️ 保险</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅行保险须知</p>
            <p class="text-sm text-gray-600 mt-0.5">关于旅行保险你需要知道的事。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">安全与应急</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">3 篇</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/life/is-china-safe/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🛡️ 安全</span>
            <p class="text-base font-bold text-gray-900 mt-1">去中国旅行安全吗？</p>
            <p class="text-sm text-gray-600 mt-0.5">关于安全、犯罪率和注意事项的实话实说。</p>
          </a>
          <a href="/zh/life/common-scams/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">⚠️ 骗局</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国常见骗局与防范</p>
            <p class="text-sm text-gray-600 mt-0.5">识别并避开最常见的旅游陷阱。</p>
          </a>
          <a href="/zh/life/emergency-numbers/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🆘 紧急</span>
            <p class="text-base font-bold text-gray-900 mt-1">紧急联系电话与应对指南</p>
            <p class="text-sm text-gray-600 mt-0.5">必备联系方式和分步应急处理指南。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-yellow-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-yellow-800">文化与必备</h2>
          <span class="text-xs font-medium text-yellow-800 opacity-60">3 篇</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/life/survival-kit/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🎒 清单</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国行前准备清单</p>
            <p class="text-sm text-gray-600 mt-0.5">出发前的完整准备工作对照表。</p>
          </a>
          <a href="/zh/life/packing-guide/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🧳 打包</span>
            <p class="text-base font-bold text-gray-900 mt-1">去中国该带什么</p>
            <p class="text-sm text-gray-600 mt-0.5">适合四季的实用打包清单。</p>
          </a>
          <a href="/zh/life/chinese-phrases/" class="block bg-yellow-50 border border-yellow-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-yellow-800">🈶 语言</span>
            <p class="text-base font-bold text-gray-900 mt-1">旅行必备中文用语</p>
            <p class="text-sm text-gray-600 mt-0.5">游客实用中文短语。</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">相关攻略</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/zh/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">中国支付方式</p>
          <p class="text-sm text-gray-500">支付宝与微信支付设置指南</p>
        </a>
        <a href="/zh/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">中国交通出行</p>
          <p class="text-sm text-gray-500">走遍中国的交通攻略</p>
        </a>
      </div>
    </div>
  </section>
</Layout>