---
import Layout from '@layouts/Layout.astro';
const title = "中国看病指南 — 诊所、医院与保险";
const description = "来华旅行者医疗指南：看病流程、顶尖国际部医院和旅行保险推荐。";
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <!-- Header -->
    <header class="mb-16 text-center">
      <p class="text-sm text-gray-500 mb-3">🏥 医疗保障</p>
      <h1 class="text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
        中国看病指南
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        在外生病或受伤了怎么办——从买药到找顶尖国际部医院，这篇全讲清楚。
      </p>
    </header>

    <!-- Quick Overview -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-16 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 快速概览</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        中国有<strong>世界级的医院</strong>，大城市都有国际部。费用比欧美低得多。小病去药店，大病去公立医院国际部。<strong>出发前一定买好旅行保险。</strong>
      </p>
    </div>

    <!-- Article Directory -->
    <div class="space-y-6 mb-16 not-prose">
      <!-- Article 1 -->
      <a href="/zh/medical/seeing-a-doctor/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-blue-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl">🏥</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-blue-600">看病</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition">在中国看病：旅行者必知</h2>
          <p class="text-gray-600 mt-1">药店、诊所、医院、国际部、费用和紧急情况处理。</p>
        </div>
      </a>

      <!-- Article 2 -->
      <a href="/zh/medical/top-hospitals/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-green-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-2xl">📋</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-green-600">医院</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-green-600 transition">中国顶尖国际部医院推荐</h2>
          <p class="text-gray-600 mt-1">按城市整理的 A++++ 级医院清单——北京、上海、广州等。</p>
        </div>
      </a>

      <!-- Article 3 -->
      <a href="/zh/medical/travel-insurance/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-purple-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-2xl">🛡️</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-purple-600">保险</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-purple-600 transition">中国旅行保险怎么买</h2>
          <p class="text-gray-600 mt-1">保险该保什么，以及实测覆盖中国的靠谱供应商。</p>
        </div>
      </a>
    </div>

    <!-- Related Links -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 相关指南</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/zh/life/emergency-numbers/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">📞 紧急电话与应对指南</p>
          <p class="text-sm text-gray-600">需要之前先存好</p>
        </a>
        <a href="/zh/life/is-china-safe/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🛡️ 去中国旅行安全吗？</p>
          <p class="text-sm text-gray-600">本地人的实话实说</p>
        </a>
      </div>
    </div>
  </section>
</Layout>