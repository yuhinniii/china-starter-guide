---
import Layout from '@layouts/Layout.astro';
const title = "Medical Care in China — Clinics, Hospitals & Insurance";
const description = "Guide to medical care in China for foreign visitors: seeing a doctor, top hospitals with international departments, and travel insurance.";
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <!-- Header -->
    <header class="mb-16 text-center">
      <p class="text-sm text-gray-500 mb-3">🏥 Medical Care</p>
      <h1 class="text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
        Medical Care in China
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        What to do if you get sick or injured in China — from pharmacies to top hospitals with international departments.
      </p>
    </header>

    <!-- Quick Overview -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-16 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 Quick Overview</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        China has <strong>world-class hospitals</strong> with international departments, especially in major cities. Costs are much lower than in the US or Europe. For minor issues, visit a pharmacy. For serious issues, go to a public hospital with an International Department. <strong>Always get travel insurance before your trip.</strong>
      </p>
    </div>

    <!-- Article Directory -->
    <div class="space-y-6 mb-16 not-prose">
      <!-- Article 1 -->
      <a href="/zh/medical/seeing-a-doctor/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-blue-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl">🏥</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-blue-600">Medical Care</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition">Seeing a Doctor in China: What Every Traveler Needs to Know</h2>
          <p class="text-gray-600 mt-1">Pharmacies, clinics, hospitals, international departments, costs, and what to do in an emergency.</p>
        </div>
      </a>

      <!-- Article 2 -->
      <a href="/zh/medical/top-hospitals/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-green-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-2xl">📋</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-green-600">Hospitals</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-green-600 transition">Top Hospitals with International Departments in China</h2>
          <p class="text-gray-600 mt-1">A++++ ranked hospitals with international departments, sorted by city — Beijing, Shanghai, Guangzhou, and more.</p>
        </div>
      </a>

      <!-- Article 3 -->
      <a href="/zh/medical/travel-insurance/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-purple-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-2xl">🛡️</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-purple-600">Insurance</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-purple-600 transition">Travel Insurance for China: What to Look For</h2>
          <p class="text-gray-600 mt-1">What your insurance should cover for China, and recommended providers verified for China coverage.</p>
        </div>
      </a>
    </div>

    <!-- Related Links -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/zh/tips/emergency-numbers/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">📞 Emergency Numbers & What to Do</p>
          <p class="text-sm text-gray-600">Save these before you need them</p>
        </a>
        <a href="/zh/tips/is-china-safe/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🛡️ Is it safe to travel to China?</p>
          <p class="text-sm text-gray-600">Honest take from a local</p>
        </a>
      </div>
    </div>
  </section>
</Layout>