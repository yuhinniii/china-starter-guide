---
import Layout from '@layouts/Layout.astro';
const title = "中国旅游小贴士——安全、骗局、紧急情况、文化";
const description = "Practical tips for traveling in China: safety guide, common scams, emergency numbers, and cultural etiquette.";
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <!-- Header -->
    <header class="mb-16 text-center">
      <p class="text-sm text-gray-500 mb-3">🛡️ 旅游攻略</p>
      <h1 class="text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
        China Travel Tips
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Practical advice from a local — safety, scams, emergency contacts, and cultural etiquette.
      </p>
    </header>

    <!-- Quick Overview -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-16 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 快速概览</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        China is <strong>非常安全</strong> for tourists, but like anywhere, you should know the common scams, emergency numbers, and a few cultural dos and don'ts. This section covers everything you need to know.
      </p>
    </div>

    <!-- Article Directory -->
    <div class="space-y-6 mb-16 not-prose">
      <!-- Article 1 -->
      <a href="/zh/tips/is-china-safe/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-green-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-2xl">🛡️</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-green-600">安全</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-green-600 transition">不要让骗子毁了你的旅行</h2>
          <p class="text-gray-600 mt-1">从当地人那里得到的诚实。暴力犯罪极为罕见。为什么中国感觉如此安全，你应该注意什么。</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 阅读8分钟</p>
        </div>
      </a>

      <!-- Article 2 -->
      <a href="/zh/tips/common-scams/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-red-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center text-2xl">⚠️</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-red-600">骗局</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-red-600 transition">中国常见的骗局以及如何避免</h2>
          <p class="text-gray-600 mt-1">不要让骗子毁了你的旅行。以下是如何发现和避免中国最常见的旅游诈骗。</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 阅读6分钟</p>
        </div>
      </a>

      <!-- Article 3 -->
      <a href="/zh/tips/emergency-numbers/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-blue-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl">📞</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-blue-600">紧急情况</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition">支付宝、微信支付以及一切与金钱有关的东西</h2>
          <p class="text-gray-600 mt-1">110（警察）、120（救护车）、119（火灾）——加上大使馆联系人、护照丢失步骤和紧急短语。</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 阅读7分钟</p>
        </div>
      </a>

      <!-- Article 4 -->
      <a href="/zh/tips/cultural-taboos/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-purple-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-2xl">🏮</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-purple-600">文化</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-purple-600 transition">中国的文化禁忌</h2>
          <p class="text-gray-600 mt-1">筷子规则、送礼、面子、摄影规则——实用的文化技巧，让你的旅行更顺利。</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 阅读6分钟</p>
        </div>
      </a>
    </div>

    <!-- Related Links -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">紧急电话号码以及需要帮助时该怎么办</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/zh/payment/payment-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">💳 如何在中国付款</p>
          <p class="text-sm text-gray-600">支付宝、微信支付以及一切与金钱有关的东西</p>
        </a>
        <a href="/zh/transport/didi/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🚗 如何在中国使用滴滴</p>
          <p class="text-sm text-gray-600">中国的优步——安全又便宜</p>
        </a>
      </div>
    </div>
  </section>
</Layout>