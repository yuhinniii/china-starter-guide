---
import Layout from '@layouts/Layout.astro';
const title = "中国旅行贴士 — 安全、骗局、紧急电话、文化礼仪";
const description = "实用的中国旅行建议：安全指南、常见骗局、紧急联系电话和风俗礼仪。";
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <!-- Header -->
    <header class="mb-16 text-center">
      <p class="text-sm text-gray-500 mb-3">🛡️ 旅行贴士</p>
      <h1 class="text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
        中国旅行贴士
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        本地人的实用建议——安全、骗局、紧急联系方式和风俗礼仪。
      </p>
    </header>

    <!-- Quick Overview -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-2xl p-8 mb-16 not-prose">
      <h2 class="text-2xl font-bold text-blue-900 mb-4">🎯 快速概览</h2>
      <p class="text-lg text-blue-800 leading-relaxed">
        中国<strong>非常安全</strong>，但和任何地方一样，最好了解一下常见骗局、紧急电话和当地风俗习惯。这个板块覆盖了你需要知道的一切。
      </p>
    </div>

    <!-- Article Directory -->
    <div class="space-y-6 mb-16 not-prose">
      <!-- Article 1 -->
      <a href="/zh/life/is-china-safe/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-green-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-green-100 flex items-center justify-center text-2xl">🛡️</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-green-600">安全</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-green-600 transition">去中国旅行安全吗？</h2>
          <p class="text-gray-600 mt-1">本地人的大实话。暴力犯罪极少。为什么中国让人感觉这么安全——真正该留意的是什么。</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 阅读时间：8 分钟</p>
        </div>
      </a>

      <!-- Article 2 -->
      <a href="/zh/life/common-scams/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-red-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center text-2xl">⚠️</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-red-600">骗局</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-red-600 transition">中国常见骗局与防范</h2>
          <p class="text-gray-600 mt-1">别让骗子毁掉你的旅行。教你识别和避开中国最常见的旅游骗局。</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 阅读时间：6 分钟</p>
        </div>
      </a>

      <!-- Article 3 -->
      <a href="/zh/life/emergency-numbers/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-blue-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center text-2xl">📞</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-blue-600">紧急</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition">紧急电话与应对指南</h2>
          <p class="text-gray-600 mt-1">110（报警）、120（急救）、119（火警）——还有大使馆联系方式、护照丢失处理步骤、应急用语。</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 阅读时间：7 分钟</p>
        </div>
      </a>

      <!-- Article 4 -->
      <a href="/zh/life/cultural-taboos/" class="group flex items-start gap-4 p-6 rounded-xl bg-white border border-gray-200 hover:shadow-lg hover:border-purple-300 transition no-underline">
        <span class="flex-shrink-0 w-12 h-12 rounded-xl bg-purple-100 flex items-center justify-center text-2xl">🏮</span>
        <div class="flex-1">
          <span class="text-xs font-medium text-purple-600">文化</span>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-purple-600 transition">中国文化礼仪指南——该做与不该做</h2>
          <p class="text-gray-600 mt-1">筷子用法、送礼禁忌、面子文化、拍照规则——让你的中国之旅更顺畅的实用贴士。</p>
          <p class="text-xs text-gray-400 mt-2">⏱️ 阅读时间：6 分钟</p>
        </div>
      </a>
    </div>

    <!-- Related Links -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-2xl font-bold text-gray-900 mb-6">📚 相关指南</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/zh/payment/payment-guide/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">💳 在中国怎么付钱</p>
          <p class="text-sm text-gray-600">支付宝、微信支付和关于钱的一切</p>
        </a>
        <a href="/zh/transport/didi/" class="block bg-white rounded-xl p-5 hover:shadow-md transition border border-gray-100">
          <p class="font-bold text-gray-900 mb-1">🚗 在中国怎么用滴滴</p>
          <p class="text-sm text-gray-600">中国的 Uber——安全又便宜</p>
        </a>
      </div>
    </div>
  </section>
</Layout>