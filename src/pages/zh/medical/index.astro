---
import Layout from '@layouts/Layout.astro';
const title = '中国就医指南 — 医院与保险';
const description = '外国游客在中国看病怎么办。';
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🏥 医疗</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">中国就医指南</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">外国游客在中国看病怎么办。</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-cyan-50 border border-cyan-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-cyan-800">1</p>
        <p class="text-xs font-semibold text-cyan-800 uppercase tracking-wide mt-1">医院推荐</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">保险指南</p>
      </div>
      <div class="bg-teal-50 border border-teal-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-teal-800">1</p>
        <p class="text-xs font-semibold text-teal-800 uppercase tracking-wide mt-1">看病流程</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-cyan-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-cyan-800">医疗服务</h2>
          <span class="text-xs font-medium text-cyan-800 opacity-60">2 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/medical/top-hospitals/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">🏥 指南</span>
            <p class="text-base font-bold text-gray-900 mt-1">有国际部的医院推荐</p>
            <p class="text-sm text-gray-600 mt-0.5">中国主要城市里，哪些医院提供英语服务</p>
          </a>
          <a href="/zh/medical/seeing-a-doctor/" class="block bg-cyan-50 border border-cyan-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-cyan-800">⚕️ 指南</span>
            <p class="text-base font-bold text-gray-900 mt-1">外国人在中国看病</p>
            <p class="text-sm text-gray-600 mt-0.5">诊所和医院怎么运作——预约、费用、语言协助</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">保险</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/medical/travel-insurance/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🛡️ 指南</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅行保险</p>
            <p class="text-sm text-gray-600 mt-0.5">要不要买？怎么选？简单说清楚</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">相关指南</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/zh/life/survival-kit/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">行前清单</p>
          <p class="text-sm text-gray-500">出发前 check 一下</p>
        </a>
        <a href="/zh/tips/emergency-numbers/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">紧急电话</p>
          <p class="text-sm text-gray-500">遇到麻烦怎么办</p>
        </a>
      </div>
    </div>
  </section>
</Layout>
