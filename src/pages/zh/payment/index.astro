---
import Layout from '@layouts/Layout.astro';
const title = '支付指南 — 在中国怎么付钱';
const description = '来中国怎么付钱？支付宝和微信支付设置教程、外国信用卡使用情况、现金应急方案，一篇搞懂中国支付。';
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-5xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">在中国怎么付钱</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">出发前搞定支付宝，95%的场合都能用。</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">2</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">移动支付</p>
      </div>
      <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-indigo-800">2</p>
        <p class="text-xs font-semibold text-indigo-800 uppercase tracking-wide mt-1">设置教程</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">信用卡指南</p>
      </div>
      <div class="bg-pink-50 border border-pink-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-pink-800">1</p>
        <p class="text-xs font-semibold text-pink-800 uppercase tracking-wide mt-1">小费指南</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">入门准备</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">2 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/payment/setup-alipay/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💰 教程</span>
            <p class="text-base font-bold text-gray-900 mt-1">外国人如何开通支付宝</p>
            <p class="text-sm text-gray-600 mt-0.5">下载、用境外手机号注册、绑定外国信用卡。</p>
          </a>
          <a href="/zh/payment/setup-wechat/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">💬 教程</span>
            <p class="text-base font-bold text-gray-900 mt-1">外国人如何开通微信支付</p>
            <p class="text-sm text-gray-600 mt-0.5">下载微信、注册、实名认证、绑定境外卡。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-indigo-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-indigo-800">使用境外卡</h2>
          <span class="text-xs font-medium text-indigo-800 opacity-60">1 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/payment/foreign-cards/" class="block bg-indigo-50 border border-indigo-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-indigo-800">💳 指南</span>
            <p class="text-base font-bold text-gray-900 mt-1">外国信用卡在中国能用吗？</p>
            <p class="text-sm text-gray-600 mt-0.5">Visa 和 Mastercard 哪些地方能用，ATM 手续费多少。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">常见问题</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/payment/payment-fails/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🔧 排查</span>
            <p class="text-base font-bold text-gray-900 mt-1">付款失败怎么办</p>
            <p class="text-sm text-gray-600 mt-0.5">常见付款失败原因及逐步排查方法。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-pink-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-pink-800">小费与文化</h2>
          <span class="text-xs font-medium text-pink-800 opacity-60">1 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/payment/tipping/" class="block bg-pink-50 border border-pink-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-pink-800">🎭 文化</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国小费文化：需要给小费吗？</p>
            <p class="text-sm text-gray-600 mt-0.5">不需要，中国没有小费习惯。快速了解该怎么做。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">完整指南</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/payment/payment-guide/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">📖 概览</span>
            <p class="text-base font-bold text-gray-900 mt-1">在中国怎么付钱：完整指南</p>
            <p class="text-sm text-gray-600 mt-0.5">支付宝、微信支付、现金还是信用卡——全面对比。</p>
          </a>
        </div>
      </div>
    </div>

        <!-- Next Step -->
    <div class="border-t border-gray-100 pt-8 mb-4">
      <div class="bg-gradient-to-r from-brand-50 to-blue-50 border border-brand-100 rounded-2xl p-6 md:p-8 not-prose">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-600 uppercase mb-1">下一步</p>
            <h3 class="text-xl font-bold text-gray-900">保持联网并出行</h3>
            <p class="text-sm text-gray-600 mt-1 max-w-md">支付已设置好。接下来：买个 eSIM 上网并学会出行方式。</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/zh/life/sim-card-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              📶 获取 eSIM
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
            <a href="/zh/transport/transport-guide/" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-white border border-gray-200 rounded-xl text-sm font-semibold text-gray-900 hover:border-brand-300 hover:shadow-sm transition no-underline">
              🚗 交通指南
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>