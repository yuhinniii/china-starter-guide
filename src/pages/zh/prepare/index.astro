---
import Layout from '@layouts/Layout.astro';
const title = '>';
const description = '去中国之前要做好一切准备。';
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">✅ 准备</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">为您的中国之旅做好准备</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Everything to prepare before your trip to China.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">2</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">签证和入境</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">数字设置</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">2</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">飞行前</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">Visa & Entry</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">2篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/visa/visa-guide/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📖 概述</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国签证类型完整指南</p>
            <p class="text-sm text-gray-600 mt-0.5">解释所有签证选项——比较免签证、过境和L签证。</p>
          </a>
          <a href="/zh/visa/visa-free/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📋 列表</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国免签证国家名单</p>
            <p class="text-sm text-gray-600 mt-0.5">50个国家可以免签证入境长达30天。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Digital Setup</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1条</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/life/sim-card-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">📶 互联网</span>
            <p class="text-base font-bold text-gray-900 mt-1">游客最佳SIM卡和eSIM</p>
            <p class="text-sm text-gray-600 mt-0.5">比较eSIM提供商、机场SIM卡和数据套餐。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">Before You Fly</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/visa/customs-guide/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🛃 法规</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国海关条例</p>
            <p class="text-sm text-gray-600 mt-0.5">免税限额、违禁物品和申报内容。</p>
          </a>
          <a href="/zh/life/survival-kit/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🎒 清单</span>
            <p class="text-base font-bold text-gray-900 mt-1">您的中国之旅生存工具包</p>
            <p class="text-sm text-gray-600 mt-0.5">完整的出发前清单——文件、应用程序和要打包的东西。</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">相关指南</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/zh/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">在中国付款</p>
          <p class="text-sm text-gray-500">设置支付宝等</p>
        </a>
        <a href="/zh/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">中国的交通</p>
          <p class="text-sm text-gray-500">四处走走</p>
        </a>
      </div>
    </div>
  </section>
</Layout>