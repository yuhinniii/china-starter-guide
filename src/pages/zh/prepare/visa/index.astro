---
import Layout from '../../../../layouts/Layout.astro';
const title = '签证与入境规则 — China Starter Guide';
const description = '2026年入境中国的免签政策、240小时过境及旅游签证指南。';
---

<Layout title={title} description={description} lang="zh">
  <div class="max-w-3xl mx-auto py-12">
    <!-- Header -->
    <header class="mb-12">
      <a href="/zh/prepare/" class="text-sm text-brand-600 hover:underline inline-flex items-center gap-1 mb-4">← 行前准备</a>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 leading-tight mb-4">
        签证与入境规则
      </h1>
      <p class="text-lg text-gray-500">
        2026年入境中国所需了解的一切签证与入境信息。
      </p>
    </header>

    <!-- Article List -->
    <div class="space-y-6">
      <!-- Article 1 -->
      <a href="/zh/prepare/visa/visa-guide/" class="block group">
        <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:border-brand-200 hover:shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded">指南</span>
            <span class="text-xs text-gray-400">6 分钟阅读</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
            2026年办理中国签证有多容易？
          </h2>
          <p class="text-gray-600 leading-relaxed mb-3">
            如今入境中国比几年前要容易得多。对比免签入境、240小时过境和旅游签证，找到适合您行程的选项。
          </p>
          <p class="text-sm text-brand-600 font-medium">阅读更多 →</p>
        </div>
      </a>

      <!-- Article 2 -->
      <a href="/zh/prepare/visa/visa-free/" class="block group">
        <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:border-brand-200 hover:shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded">参考</span>
            <span class="text-xs text-gray-400">5 分钟阅读</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
            中国免签国家名单（2026年）
          </h2>
          <p class="text-gray-600 leading-relaxed mb-3">
            查看您的国家是否符合中国免签政策。包含全部55+个国家、停留期限和入境要求。
          </p>
          <p class="text-sm text-brand-600 font-medium">阅读更多 →</p>
        </div>
      </a>

      <!-- Article 3 -->
      <a href="/zh/prepare/visa/transit-240/" class="block group">
        <div class="bg-white border border-gray-100 rounded-2xl p-6 hover:border-brand-200 hover:shadow-sm transition-all">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-medium text-brand-600 bg-brand-50 px-2 py-0.5 rounded">指南</span>
            <span class="text-xs text-gray-400">7 分钟阅读</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
            中国240小时过境免签政策详解
          </h2>
          <p class="text-gray-600 leading-relaxed mb-3">
            过境前往第三国时可在中国停留最长10天而无需签证。资格要求、口岸信息及允许活动范围。
          </p>
          <p class="text-sm text-brand-600 font-medium">阅读更多 →</p>
        </div>
      </a>
    </div>

    <!-- Quick Answer Box -->
    <div class="mt-12 bg-brand-50 border border-brand-100 rounded-2xl p-6 not-prose">
      <h3 class="font-bold text-gray-900 mb-3">快速回答</h3>
      <p class="text-gray-700 mb-4">
        大多数旅行者现在可以免签入境中国（30天）、利用240小时过境政策，或申请普通旅游签证。查看上面的文章，找到适合您情况的选项。
      </p>
      <a href="/zh/prepare/visa/visa-guide/" class="inline-flex items-center gap-1 text-sm text-brand-600 font-medium hover:underline">
        从签证指南开始 →
      </a>
    </div>
  </div>
</Layout>
