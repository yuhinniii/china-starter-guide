---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="搜索 - 中国入门指南" lang="zh">
  <div class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">搜索</h1>
    <div class="mb-8">
      <input
        type="text"
        id="search-input"
        placeholder="搜索指南、贴士、城市信息..."
        class="w-full px-5 py-3 rounded-2xl border border-gray-200  :bg-gray-900 text-gray-900  :outline-none focus:ring-2 focus:ring-brand-500 text-base"
      />
    </div>
    <div id="search-results" class="space-y-4">
      <p class="text-gray-500  ">在上方输入关键词搜索我们的指南。</p>
    </div>
  </div>

  <script is:inline>
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const pages = [
      { title: '支付指南', url: '/zh/payment/', desc: '如何在中国支付 — 支付宝、微信支付、现金和银行卡。' },
      { title: '交通指南', url: '/zh/transport/', desc: '火车、地铁、出租车和网约车应用。' },
      { title: '必备应用', url: '/zh/apps/', desc: '在中国生活和旅行必备的 App。' },
      { title: '城市指南', url: '/zh/cities/', desc: '北京、上海、广州、深圳等。' },
      { title: '旅游贴士', url: '/zh/tips/', desc: '让旅途更顺畅的实用建议。' },
      { title: '行前准备', url: '/zh/prepare/', desc: '签证、证件和落地72小时规划。' },
      { title: '医疗指南', url: '/zh/medical/', desc: '如何看医生以及费用说明。' },
      { title: '关于', url: '/zh/about/', desc: '关于本网站和联系信息。' },
    ];

    input.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      if (!q) {
        results.innerHTML = '<p class="text-gray-500  ">在上方输入关键词搜索我们的指南。</p>';
        return;
      }
      const matched = pages.filter(p =>
        p.title.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q)
      );
      if (matched.length === 0) {
        results.innerHTML = '<p class="text-gray-500  ">未找到结果。请尝试其他关键词。</p>';
        return;
      }
      results.innerHTML = matched.map(p =>
        `<a href="${p.url}" class="block p-5 rounded-2xl bg-gray-50  :bg-gray-100 dark:hover:bg-gray-800 no-underline transition-colors">
          <h3 class="text-lg font-semibold text-brand-600  ">${p.title}</h3>
          <p class="text-gray-600  ">${p.desc}</p>
        </a>`
      ).join('');
    });
  </script>
</Layout>