---
import Layout from '@layouts/Layout.astro';
const title = '中国旅游小贴士——安全、骗局与文化';
const description = 'Stay safe, avoid scams, and understand local customs.';
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">💡 提示</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">中国旅游小贴士</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">保持安全、避免骗局、了解当地习俗。</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">1</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">安全指南</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">诈骗警报</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">紧急信息</p>
      </div>
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">1</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">文化提示</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">安全与安保</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">2篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/tips/is-china-safe/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🛡️ 指南</span>
            <p class="text-base font-bold text-gray-900 mt-1">去中国旅行安全吗？</p>
            <p class="text-sm text-gray-600 mt-0.5">诚实的安全概述——犯罪、食品安全、常见风险和旅行提示。</p>
          </a>
          <a href="/zh/tips/common-scams/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">⚠️ 指南</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国常见的骗局以及如何避免</p>
            <p class="text-sm text-gray-600 mt-0.5">茶骗局、出租车骗局、假警察——要注意什么。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">紧急情况</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1条</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/tips/emergency-numbers/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🆘 指南</span>
            <p class="text-base font-bold text-gray-900 mt-1">支付宝、微信支付以及一切与金钱有关的东西</p>
            <p class="text-sm text-gray-600 mt-0.5">110、120、12308——基本数字和逐步应急响应。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">文化</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1条</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/tips/cultural-taboos/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🎭 指南</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国的文化禁忌</p>
            <p class="text-sm text-gray-600 mt-0.5">避免尴尬时刻和表示尊重的关键礼仪规则。</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">相关指南</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/zh/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">中国的交通</p>
          <p class="text-sm text-gray-500">火车、地铁和叫车</p>
        </a>
        <a href="/zh/life/essential-apps/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">基本应用程序</p>
          <p class="text-sm text-gray-500">必须有适用于中国的应用程序</p>
        </a>
      </div>
    </div>
  </section>
</Layout>