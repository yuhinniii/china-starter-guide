---
import Layout from '@layouts/Layout.astro';
const title = 'Travel Tips for China — Safety, Scams & Culture';
const description = 'Stay safe, avoid scams, and understand local customs.';
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">💡 Tips</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">Travel Tips for China</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">Stay safe, avoid scams, and understand local customs.</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">1</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">Safety Guide</p>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-red-800">1</p>
        <p class="text-xs font-semibold text-red-800 uppercase tracking-wide mt-1">Scam Alerts</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">Emergency Info</p>
      </div>
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">1</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">Cultural Tips</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">Safety & Security</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">2 articles</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/tips/is-china-safe/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">🛡️ Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Is It Safe to Travel to China?</p>
            <p class="text-sm text-gray-600 mt-0.5">Honest safety overview — crime, food safety, common risks, and travel tips.</p>
          </a>
          <a href="/zh/tips/common-scams/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">⚠️ Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Common Scams in China & How to Avoid Them</p>
            <p class="text-sm text-gray-600 mt-0.5">Tea scam, taxi scams, fake police — what to watch out for.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-red-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-red-800">Emergency</h2>
          <span class="text-xs font-medium text-red-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/tips/emergency-numbers/" class="block bg-red-50 border border-red-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-red-800">🆘 Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Emergency Numbers & What to Do If You Need Help</p>
            <p class="text-sm text-gray-600 mt-0.5">110, 120, 12308 — essential numbers and step-by-step emergency response.</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">Culture</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1 article</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/tips/cultural-taboos/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">🎭 Guide</span>
            <p class="text-base font-bold text-gray-900 mt-1">Cultural Dos and Don'ts in China</p>
            <p class="text-sm text-gray-600 mt-0.5">Key etiquette rules to avoid awkward moments and show respect.</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Related Guides</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/zh/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Transport in China</p>
          <p class="text-sm text-gray-500">Trains, metro, and ride-hailing</p>
        </a>
        <a href="/zh/life/essential-apps/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">Essential Apps</p>
          <p class="text-sm text-gray-500">Must-have apps for China</p>
        </a>
      </div>
    </div>
  </section>
</Layout>