<script type="application/ld+json">{"@context": "https://schema.org", "@type": "HowTo", "name": "中国高铁订票与乘车指南：一步步教你", "step": [{"@type": "HowToStep", "name": "订票", "text": "在 Trip.com（支持外国银行卡）或 12306 官方英文网站用护照订票。不需要中国身份证或手机号。"}, {"@type": "HowToStep", "name": "核验护照（仅 12306）", "text": "在 12306 注册、添加乘客，并完成一次性身份核验——自动核验、上传护照照片或到车站窗口办理。"}, {"@type": "HowToStep", "name": "提前到站", "text": "发车前 30–40 分钟到达车站。"}, {"@type": "HowToStep", "name": "通过安检", "text": "行李过 X 光机。无需取出液体或笔记本电脑。"}, {"@type": "HowToStep", "name": "在检票口出示护照", "text": "走人工通道（检票闸机群最左或最右侧）。把护照交给工作人员——自动闸机只读中国身份证。"}, {"@type": "HowToStep", "name": "找到车厢并上车", "text": "将站台屏幕上的颜色代码与地面地标对应，上车后随身携带护照以备车上查验。"}]}</script>
