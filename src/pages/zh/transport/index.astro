---
import Layout from '@layouts/Layout.astro';
const title = '中国交通指南 —— 出行攻略';
const description = '火车、飞机、地铁和网约车——你需要的一切都在这里。';
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">🚄 交通</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">中国交通指南</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">火车、飞机、地铁和网约车——你需要的一切都在这里。</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 not-prose">
      <div class="bg-sky-50 border border-sky-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-sky-800">1</p>
        <p class="text-xs font-semibold text-sky-800 uppercase tracking-wide mt-1">高铁指南</p>
      </div>
      <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-emerald-800">1</p>
        <p class="text-xs font-semibold text-emerald-800 uppercase tracking-wide mt-1">机场交通</p>
      </div>
      <div class="bg-purple-50 border border-purple-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-purple-800">2</p>
        <p class="text-xs font-semibold text-purple-800 uppercase tracking-wide mt-1">市内交通</p>
      </div>
      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-gray-800">1</p>
        <p class="text-xs font-semibold text-gray-800 uppercase tracking-wide mt-1">网约车指南</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-sky-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-sky-800">出行概览</h2>
          <span class="text-xs font-medium text-sky-800 opacity-60">1 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/transport/transport-guide/" class="block bg-sky-50 border border-sky-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-sky-800">📖 概览</span>
            <p class="text-base font-bold text-gray-900 mt-1">在中国怎么出行</p>
            <p class="text-sm text-gray-600 mt-0.5">所有交通方式的完整介绍——高铁、飞机、地铁等。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-emerald-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-emerald-800">抵达中国</h2>
          <span class="text-xs font-medium text-emerald-800 opacity-60">1 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/transport/airport-to-city/" class="block bg-emerald-50 border border-emerald-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-emerald-800">🛬 指南</span>
            <p class="text-base font-bold text-gray-900 mt-1">从机场到市区</p>
            <p class="text-sm text-gray-600 mt-0.5">各大机场的交通选择——北京、上海、广州等。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-purple-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-purple-800">市内交通</h2>
          <span class="text-xs font-medium text-purple-800 opacity-60">2 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/transport/high-speed-rail/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚄 指南</span>
            <p class="text-base font-bold text-gray-900 mt-1">如何购票和乘坐中国高铁</p>
            <p class="text-sm text-gray-600 mt-0.5">关于订票和乘坐全球最大高铁网络的所有信息。</p>
          </a>
          <a href="/zh/transport/metro-bus/" class="block bg-purple-50 border border-purple-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-purple-800">🚇 指南</span>
            <p class="text-base font-bold text-gray-900 mt-1">主要城市地铁和公交指南</p>
            <p class="text-sm text-gray-600 mt-0.5">在北京、上海、广州、深圳乘坐公共交通。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-gray-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-gray-800">网约车</h2>
          <span class="text-xs font-medium text-gray-800 opacity-60">1 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/transport/didi/" class="block bg-gray-50 border border-gray-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-gray-800">🚕 教程</span>
            <p class="text-base font-bold text-gray-900 mt-1">外国人如何使用滴滴</p>
            <p class="text-sm text-gray-600 mt-0.5">使用滴滴（中国版 Uber）的详细指南——含截图。</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">相关攻略</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/zh/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">中国支付指南</p>
          <p class="text-sm text-gray-500">怎么付交通费</p>
        </a>
        <a href="/zh/visa/visa-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">签证与入境</p>
          <p class="text-sm text-gray-500">如何入境中国</p>
        </a>
      </div>
    </div>
  </section>
</Layout>