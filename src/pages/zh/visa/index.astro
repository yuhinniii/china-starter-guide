---
import Layout from '@layouts/Layout.astro';
const title = '行前准备——入境与安顿指南';
const description = '去中国旅行前需要准备的一切。';
---

<Layout title={title} description={description} lang="zh">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <!-- Header -->
    <header class="mb-10 text-center">
      <p class="text-sm text-gray-500 mb-2">✅ 行前准备</p>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-3 leading-tight">中国行前准备</h1>
      <p class="text-base text-gray-500 max-w-2xl mx-auto">出发前需要了解的一切。</p>
    </header>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-12 not-prose">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-green-800">2</p>
        <p class="text-xs font-semibold text-green-800 uppercase tracking-wide mt-1">签证与入境</p>
      </div>
      <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-blue-800">1</p>
        <p class="text-xs font-semibold text-blue-800 uppercase tracking-wide mt-1">数字准备</p>
      </div>
      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center">
        <p class="text-2xl font-extrabold text-amber-800">2</p>
        <p class="text-xs font-semibold text-amber-800 uppercase tracking-wide mt-1">出发之前</p>
      </div>
    </div>

    <!-- Category Sections -->
    <div class="space-y-8 mb-16 not-prose">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-green-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-green-800">签证与入境</h2>
          <span class="text-xs font-medium text-green-800 opacity-60">2 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/visa/visa-guide/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📖 概览</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国签证类型完全指南</p>
            <p class="text-sm text-gray-600 mt-0.5">了解所有签证方案——对比免签、过境签和 L 旅游签。</p>
          </a>
          <a href="/zh/visa/visa-free/" class="block bg-green-50 border border-green-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-green-800">📋 列表</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国免签国家名单</p>
            <p class="text-sm text-gray-600 mt-0.5">50 个国家可免签入境，最长停留 30 天。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-blue-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-blue-800">数字准备</h2>
          <span class="text-xs font-medium text-blue-800 opacity-60">1 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/life/sim-card-guide/" class="block bg-blue-50 border border-blue-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-blue-800">📶 上网</span>
            <p class="text-base font-bold text-gray-900 mt-1">游客首选 SIM 卡和 eSIM</p>
            <p class="text-sm text-gray-600 mt-0.5">对比 eSIM 供应商、机场 SIM 卡和流量套餐。</p>
          </a>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <h2 class="text-lg font-bold text-amber-800">出发之前</h2>
          <span class="text-xs font-medium text-amber-800 opacity-60">2 篇文章</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <a href="/zh/visa/customs-guide/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🛃 海关</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国海关规定</p>
            <p class="text-sm text-gray-600 mt-0.5">免税额度、禁带物品和申报要求。</p>
          </a>
          <a href="/zh/life/survival-kit/" class="block bg-amber-50 border border-amber-200 rounded-xl p-4 hover:shadow-md transition no-underline">
            <span class="text-xs font-semibold text-amber-800">🎒 清单</span>
            <p class="text-base font-bold text-gray-900 mt-1">中国旅行生存包</p>
            <p class="text-sm text-gray-600 mt-0.5">出发前完整清单——证件、App 和打包建议。</p>
          </a>
        </div>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="bg-gray-50 rounded-2xl p-8 not-prose">
      <h3 class="text-lg font-bold text-gray-900 mb-5">相关指南</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <a href="/zh/payment/payment-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">中国支付指南</p>
          <p class="text-sm text-gray-500">开通支付宝等</p>
        </a>
        <a href="/zh/transport/transport-guide/" class="block bg-white rounded-xl p-4 hover:shadow-md transition border border-gray-100 no-underline">
          <p class="font-bold text-gray-900 mb-0.5">中国交通指南</p>
          <p class="text-sm text-gray-500">出行方式</p>
        </a>
      </div>
    </div>
  </section>
</Layout>